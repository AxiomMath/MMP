section AlgSec

open TensorProduct

/-- Base change along a quotient. -/
private theorem bijective_of_tmul {A A' B C : Type} [CommRing A] [CommRing A'] [CommRing B]
    [CommRing C]
    (ρ : A →+* A') (hρ : Function.Surjective ρ) (ψ : A →+* B) (τ : B →+* C)
    (hτ : Function.Surjective τ) (hker : RingHom.ker τ ≤ (RingHom.ker ρ).map ψ) (χ : A' →+* C)
    (hsq : ∀ a, τ (ψ a) = χ (ρ a)) (M' : Type) [AddCommGroup M'] [Module A M']
    (M : Type) [AddCommGroup M] [Module A' M] (e : M' ≃+ M)
    (he : ∀ (a : A) (m : M'), e (a • m) = ρ a • e m) :
    letI : Module A B := Module.compHom B ψ
    letI : Module A' C := Module.compHom C χ
    ∀ (Φ : TensorProduct A B M' →+ TensorProduct A' C M),
      (∀ (b : B) (m : M'), Φ (b ⊗ₜ m) = τ b ⊗ₜ e m) → Function.Bijective Φ := by
  letI : Module A B := Module.compHom B ψ
  letI : Module A' C := Module.compHom C χ
  intro Φ hΦ
  have hsmulB : ∀ (a : A) (b : B), a • b = ψ a * b := fun _ _ => rfl
  have hsmulC : ∀ (a : A') (c : C), a • c = χ a * c := fun _ _ => rfl
  have he' : ∀ (a : A) (m : M), e.symm (ρ a • m) = a • e.symm m := fun a m => by
    apply e.injective
    rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
  refine ⟨?_, ?_⟩
  · let f₀ : B →+ M →+ TensorProduct A B M' :=
      { toFun := fun b =>
          { toFun := fun m => b ⊗ₜ e.symm m
            map_zero' := by rw [map_zero, TensorProduct.tmul_zero]
            map_add' := fun m m' => by rw [map_add, TensorProduct.tmul_add] }
        map_zero' := by ext m; exact TensorProduct.zero_tmul _ _
        map_add' := fun b b' => by ext m; exact TensorProduct.add_tmul _ _ _ }
    have hkill : ∀ b ∈ (RingHom.ker ρ).map ψ, ∀ (r : B) (m : M'),
        ((r * b) ⊗ₜ m : TensorProduct A B M') = 0 := by
      intro b hb
      induction hb using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨k, hk, rfl⟩ := hx
        intro r m
        have hkm : k • m = 0 := by
          apply e.injective
          rw [he, (RingHom.mem_ker).1 hk, zero_smul, map_zero]
        rw [mul_comm, ← hsmulB, TensorProduct.smul_tmul, hkm, TensorProduct.tmul_zero]
      | zero =>
        intro r m
        rw [mul_zero, TensorProduct.zero_tmul]
      | add x y _ _ hx hy =>
        intro r m
        rw [mul_add, TensorProduct.add_tmul, hx, hy, add_zero]
      | smul s x _ hx =>
        intro r m
        rw [smul_eq_mul, ← mul_assoc]
        exact hx _ m
    have hf₀ : τ.toAddMonoidHom.ker ≤ f₀.ker := by
      intro b hb
      rw [AddMonoidHom.mem_ker]
      ext m
      have := hkill b (hker hb) 1 (e.symm m)
      rw [one_mul] at this
      exact this
    let f : C →+ M →+ TensorProduct A B M' :=
      (AddMonoidHom.liftOfRightInverse τ.toAddMonoidHom (Function.surjInv hτ)
        (Function.rightInverse_surjInv hτ)) ⟨f₀, hf₀⟩
    have hf : ∀ b m, f (τ b) m = b ⊗ₜ e.symm m := fun b m =>
      congrArg (fun g => g m) (AddMonoidHom.liftOfRightInverse_comp_apply τ.toAddMonoidHom
        (Function.surjInv hτ) (Function.rightInverse_surjInv hτ) ⟨f₀, hf₀⟩ b)
    let L : TensorProduct A' C M →+ TensorProduct A B M' :=
      TensorProduct.liftAddHom f (fun r c m => by
        obtain ⟨a, rfl⟩ := hρ r
        obtain ⟨b, rfl⟩ := hτ c
        have h1 : ρ a • τ b = τ (ψ a * b) := by rw [hsmulC, map_mul, hsq]
        rw [h1, hf, hf, he', ← TensorProduct.smul_tmul, hsmulB])
    have hL : ∀ z, L (Φ z) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul b m =>
        rw [hΦ]
        change f (τ b) (e m) = _
        rw [hf, AddEquiv.symm_apply_apply]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    exact Function.LeftInverse.injective hL
  · intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero Φ⟩
    | tmul c m =>
      obtain ⟨b, rfl⟩ := hτ c
      exact ⟨b ⊗ₜ e.symm m, by rw [hΦ, AddEquiv.apply_symm_apply]⟩
    | add x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, map_add Φ a b⟩

end AlgSec

section Smul

open Limits

open MMP.ModuleSkyscraper

variable {T T' : TopCat.{0}} (g : T ⟶ T') {R : TopCat.Sheaf CommRingCat.{0} T}
  {R' : TopCat.Sheaf CommRingCat.{0} T'}
  [(Opens.map g).IsContinuous (Opens.grothendieckTopology T') (Opens.grothendieckTopology T)]
  (φ : ringSheaf R' ⟶ ((Opens.map g).sheafPushforwardContinuous RingCat.{0}
    (Opens.grothendieckTopology T') (Opens.grothendieckTopology T)).obj (ringSheaf R))
  (x : T) (ψ : TopCat.Presheaf.stalk (C := CommRingCat.{0}) R'.obj (g x) →+*
    TopCat.Presheaf.stalk (C := CommRingCat.{0}) R.obj x)
  (hψ : ∀ (V : Opens T') (hx : g x ∈ V) (r : R'.obj.obj (op V)),
    ψ (TopCat.Presheaf.germ (C := CommRingCat.{0}) R'.obj V (g x) hx r) =
      TopCat.Presheaf.germ (C := CommRingCat.{0}) R.obj ((Opens.map g).obj V) x hx
        (φ.hom.app (op V) r))

include hψ in
/-- The stalk map of a pushforward of sheaves of modules is semilinear along the stalk map of
rings. -/
private theorem stalkPushforward_smul (N : SheafOfModules.{0} (ringSheaf R))
    (r : TopCat.Presheaf.stalk (C := CommRingCat.{0}) R'.obj (g x))
    (m : TopCat.Presheaf.stalk (C := AddCommGrpCat.{0})
      ((SheafOfModules.pushforward.{0} φ).obj N).val.presheaf (g x)) :
    letI : Module (TopCat.Presheaf.stalk (C := CommRingCat.{0}) R'.obj (g x))
        (TopCat.Presheaf.stalk (C := AddCommGrpCat.{0})
          ((SheafOfModules.pushforward.{0} φ).obj N).val.presheaf (g x)) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
        ((SheafOfModules.pushforward.{0} φ).obj N).val (g x)
    letI : Module (TopCat.Presheaf.stalk (C := CommRingCat.{0}) R.obj x)
        (TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) N.val.presheaf x) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier N.val x
    TopCat.Presheaf.stalkPushforward AddCommGrpCat.{0} g N.val.presheaf x (r • m) =
      ψ r • TopCat.Presheaf.stalkPushforward AddCommGrpCat.{0} g N.val.presheaf x m := by
  obtain ⟨W, hW, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq _ m
  obtain ⟨W', hW', r₀, rfl⟩ := TopCat.Presheaf.exists_germ_eq _ r
  let U := W ⊓ W'
  have hU : g x ∈ U := ⟨hW, hW'⟩
  rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE (inf_le_left : U ≤ W)) (g x) hU t,
    ← TopCat.Presheaf.germ_res_apply _ (homOfLE (inf_le_right : U ≤ W')) (g x) hU r₀]
  erw [← PresheafOfModules.germ_smul (R := R'.obj) ((SheafOfModules.pushforward.{0} φ).obj N).val
    (g x) U hU]
  erw [TopCat.Presheaf.stalkPushforward_germ_apply, TopCat.Presheaf.stalkPushforward_germ_apply]
  rw [hψ U hU]
  exact PresheafOfModules.germ_smul N.val x ((Opens.map g).obj U) hU _ _

end Smul

section Sub

variable {T T' : TopCat.{0}} (j : T' ⟶ T)

/-- Off the image of a closed embedding, the stalks of a pushforward vanish. -/
private theorem subsingleton_stalk_pushforward (hj : IsClosed (Set.range j))
    (B : TopCat.Sheaf AddCommGrpCat.{0} T') (x : T) (hx : x ∉ Set.range j) :
    Subsingleton (((TopCat.Sheaf.pushforward AddCommGrpCat.{0} j).obj B).presheaf.stalk x) := by
  refine ⟨fun a b => ?_⟩
  suffices h :
      ∀ c : ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} j).obj B).presheaf.stalk x, c = 0 by
    rw [h a, h b]
  intro c
  obtain ⟨U, hxU, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq _ c
  let V : Opens T := U ⊓ ⟨(Set.range j)ᶜ, hj.isOpen_compl⟩
  have hxV : x ∈ V := ⟨hxU, hx⟩
  have hV : (Opens.map j).obj V = ⊥ := by
    ext y
    simp only [Opens.map_coe, Set.mem_preimage, Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
    exact fun h => h.2 ⟨y, rfl⟩
  have hz : Subsingleton (B.obj.obj (op ((Opens.map j).obj V))) :=
    (AddCommGrpCat.isZero_iff_subsingleton).1 ((B.isTerminalOfEqEmpty hV).isZero)
  rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE (inf_le_left : V ≤ U)) x hxV,
    @Subsingleton.elim _ hz (((TopCat.Sheaf.pushforward AddCommGrpCat.{0} j).obj B).presheaf.map
      (homOfLE (inf_le_left : V ≤ U)).op s) 0]
  exact map_zero _

end Sub

section ResolutionComparison

open Limits

variable {T T'' : TopCat.{0}} (k : T'' ⟶ T)

/-- The adjunction `k⁻¹ ⊣ k_*` on cochain complexes of abelian sheaves. -/
private noncomputable abbrev pullbackAdjComplex :=
  (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} k).mapHomologicalComplex
    (ComplexShape.up ℕ)

/-- The adjoint `k⁻¹ J ⟶ J'` of a map `J ⟶ k_* J'` over `ψ : F ⟶ k_* B` lies over the adjoint
`k⁻¹ F ⟶ B` of `ψ`. -/
private theorem ι_comp_homEquiv_symm {F : TopCat.Sheaf AddCommGrpCat.{0} T}
    {B : TopCat.Sheaf AddCommGrpCat.{0} T''}
    (ψ : F ⟶ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).obj B) (J : InjectiveResolution F)
    (J' : InjectiveResolution B)
    (g : J.cocomplex ⟶
      ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).mapHomologicalComplex _).obj J'.cocomplex)
    (hg : J.ι.f 0 ≫ g.f 0 = ψ ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).map (J'.ι.f 0)) :
    ((HomologicalComplex.singleMapHomologicalComplex
      (TopCat.Sheaf.pullback AddCommGrpCat.{0} k) (ComplexShape.up ℕ) 0).inv.app F ≫
      ((TopCat.Sheaf.pullback AddCommGrpCat.{0} k).mapHomologicalComplex _).map J.ι) ≫
        ((pullbackAdjComplex k).homEquiv _ _).symm g =
    (CochainComplex.single₀ _).map
      (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} k).homEquiv _ _).symm ψ) ≫
        J'.ι := by
  apply HomologicalComplex.from_single_hom_ext
  have h1 := congrArg (fun φ => (TopCat.Sheaf.pullback AddCommGrpCat.{0} k).map φ ≫
    (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} k).counit.app
      (J'.cocomplex.X 0)) hg
  simp only [Functor.map_comp, Category.assoc] at h1
  have h2 :=
    (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} k).homEquiv_naturality_right_symm
    ψ (J'.ι.f 0)
  rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_counit] at h2
  simp only [CochainComplex.single₀_obj_zero, Functor.comp_obj, Adjunction.homEquiv_counit,
    Category.assoc, HomologicalComplex.comp_f, Functor.mapHomologicalComplex_obj_X,
    HomologicalComplex.singleMapHomologicalComplex_inv_app_self, CochainComplex.single₀ObjXSelf,
    Iso.refl_hom, Iso.refl_inv, CategoryTheory.Functor.map_id, Category.comp_id,
    Functor.mapHomologicalComplex_map_f, Category.id_comp, Functor.map_comp,
    CochainComplex.single₀_map_f_zero]
  exact h1.trans (h2.trans (Category.assoc _ _ _))

/-- The inverse image `k⁻¹ J` of a resolution of `F` is a resolution of `k⁻¹ F`. -/
private theorem quasiIso_pullback_ι {F : TopCat.Sheaf AddCommGrpCat.{0} T}
    (J : InjectiveResolution F) :
    QuasiIso ((HomologicalComplex.singleMapHomologicalComplex
      (TopCat.Sheaf.pullback AddCommGrpCat.{0} k) (ComplexShape.up ℕ) 0).inv.app F ≫
      ((TopCat.Sheaf.pullback AddCommGrpCat.{0} k).mapHomologicalComplex _).map J.ι) := by
  have := HomologicalComplex.quasiIso_map_of_preservesHomology J.ι
    (TopCat.Sheaf.pullback AddCommGrpCat.{0} k)
  infer_instance

/-- A map `ψ : F ⟶ k_* B` lifts to a map of injective resolutions `J ⟶ k_* J'`. -/
private theorem exists_hom_pushforward {F : TopCat.Sheaf AddCommGrpCat.{0} T}
    {B : TopCat.Sheaf AddCommGrpCat.{0} T''}
    (ψ : F ⟶ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).obj B) (J : InjectiveResolution F)
    (J' : InjectiveResolution B) :
    ∃ g : J.cocomplex ⟶
      ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).mapHomologicalComplex _).obj J'.cocomplex,
      J.ι.f 0 ≫ g.f 0 = ψ ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).map (J'.ι.f 0) := by
  let adj := TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} k
  obtain ⟨-, ⟨hex, -, -, -⟩, -, -⟩ := sheafCohomology_toolkit.{0, 0, 0, 0, 0} T''
  obtain ⟨ĝ, hĝ⟩ := hex ((adj.homEquiv _ _).symm ψ) _ _ (quasiIso_pullback_ι k J) J'
  refine ⟨(pullbackAdjComplex k).homEquiv _ _ ĝ, ?_⟩
  have h0 : (TopCat.Sheaf.pullback AddCommGrpCat.{0} k).map (J.ι.f 0) ≫ ĝ.f 0 =
      (adj.homEquiv _ _).symm ψ ≫ J'.ι.f 0 := by
    simpa using congrArg (fun φ => φ.f 0) hĝ
  have h3 := adj.homEquiv_naturality_left (J.ι.f 0) (ĝ.f 0)
  rw [h0] at h3
  have h4 := adj.homEquiv_naturality_right ((adj.homEquiv F B).symm ψ) (J'.ι.f 0)
  rw [Equiv.apply_symm_apply] at h4
  exact h3.symm.trans h4

attribute [local instance] globalSections_additive in
/-- Two lifts `J ⟶ k_* J'` of the same `ψ : F ⟶ k_* B` induce the same map on the cohomology of
global sections: their adjoints `k⁻¹ J ⟶ J'` are homotopic. -/
private theorem homologyMap_eq_of_ι_comp_eq {F : TopCat.Sheaf AddCommGrpCat.{0} T}
    {B : TopCat.Sheaf AddCommGrpCat.{0} T''}
    (ψ : F ⟶ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).obj B) (J : InjectiveResolution F)
    (J' : InjectiveResolution B)
    (g g' : J.cocomplex ⟶
      ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).mapHomologicalComplex _).obj J'.cocomplex)
    (hg : J.ι.f 0 ≫ g.f 0 = ψ ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).map (J'.ι.f 0))
    (hg' : J.ι.f 0 ≫ g'.f 0 = ψ ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).map (J'.ι.f 0))
    (n : ℕ) :
    HomologicalComplex.homologyMap (((globalSections T).mapHomologicalComplex _).map g) n =
      HomologicalComplex.homologyMap (((globalSections T).mapHomologicalComplex _).map g') n := by
  obtain ⟨-, ⟨-, huniq, -, -⟩, -, -⟩ := sheafCohomology_toolkit.{0, 0, 0, 0, 0} T''
  obtain ⟨h⟩ := huniq _ _ _ (quasiIso_pullback_ι k J) J' _ _ (ι_comp_homEquiv_symm k ψ J J' g hg)
    (ι_comp_homEquiv_symm k ψ J J' g' hg')
  have e : ∀ g : J.cocomplex ⟶
      ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).mapHomologicalComplex _).obj J'.cocomplex,
      g = (pullbackAdjComplex k).unit.app J.cocomplex ≫
        ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).mapHomologicalComplex _).map
          (((pullbackAdjComplex k).homEquiv _ _).symm g) := fun g =>
    (Equiv.apply_symm_apply _ g).symm.trans (Adjunction.homEquiv_unit _ _ _ _)
  rw [e g, e g', Functor.map_comp, Functor.map_comp, HomologicalComplex.homologyMap_comp,
    HomologicalComplex.homologyMap_comp]
  congr 1
  exact ((globalSections T).mapHomotopy
    ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} k).mapHomotopy h)).homologyMap_eq n

attribute [local instance] globalSections_additive in
/-- A composite of two pullbacks on sheaf cohomology, read through injective resolutions: it is
induced by any lift `J ⟶ (f' ≫ f)_* J'` of the composite adjoint map. -/
private theorem sheafCohomologyPullback_comp_eq {T T₁ T₂ : TopCat.{0}} (f : T₁ ⟶ T) (f' : T₂ ⟶ T₁)
    {F : TopCat.Sheaf AddCommGrpCat.{0} T} {A : TopCat.Sheaf AddCommGrpCat.{0} T₁}
    {B : TopCat.Sheaf AddCommGrpCat.{0} T₂}
    (θ : (TopCat.Sheaf.pullback AddCommGrpCat.{0} f).obj F ⟶ A)
    (θ' : (TopCat.Sheaf.pullback AddCommGrpCat.{0} f').obj A ⟶ B)
    (J : InjectiveResolution F) (J' : InjectiveResolution B)
    (g : J.cocomplex ⟶ ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} (f' ≫ f)).mapHomologicalComplex
      _).obj J'.cocomplex)
    (hg : J.ι.f 0 ≫ g.f 0 =
      ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} f).unit.app F ≫
        (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f).map (θ ≫
          (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} f').unit.app A ≫
            (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f').map θ')) ≫
        (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (f' ≫ f)).map (J'.ι.f 0)) (n : ℕ) :
    (sheafCohomologyPullback f F n ≫ (sheafCohomology T₁ n).map θ) ≫
      (sheafCohomologyPullback f' A n ≫ (sheafCohomology T₂ n).map θ') ≫
        (sheafCohomologyIso T₂ n).hom.app B =
    (sheafCohomologyIso T n).hom.app F ≫ (J.isoRightDerivedObj (globalSections T) n).hom ≫
      HomologicalComplex.homologyMap (((globalSections T).mapHomologicalComplex _).map g) n ≫
      (J'.isoRightDerivedObj (globalSections T₂) n).inv := by
  let JA := injectiveResolution A
  obtain ⟨g₁, hg₁⟩ := exists_hom_pushforward f
    ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} f).unit.app F ≫
      (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f).map θ) J JA
  obtain ⟨g₂, hg₂⟩ := exists_hom_pushforward f'
    ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} f').unit.app A ≫
      (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f').map θ') JA J'
  have h₁ := sheafCohomologyIso_pullback f F A θ J JA g₁ hg₁ n
  have h₂ := sheafCohomologyIso_pullback f' A B θ' JA J' g₂ hg₂ n
  let g₁₂ : J.cocomplex ⟶
      ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} (f' ≫ f)).mapHomologicalComplex _).obj
        J'.cocomplex :=
    g₁ ≫ ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} f).mapHomologicalComplex _).map g₂
  have hg₁₂ : J.ι.f 0 ≫ g₁₂.f 0 =
      ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} f).unit.app F ≫
        (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f).map (θ ≫
          (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} f').unit.app A ≫
            (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f').map θ')) ≫
        (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (f' ≫ f)).map (J'.ι.f 0) := by
    change J.ι.f 0 ≫ g₁.f 0 ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f).map (g₂.f 0) = _
    have h1 := congrArg (· ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f).map (g₂.f 0)) hg₁
    have h2 := congrArg (TopCat.Sheaf.pushforward AddCommGrpCat.{0} f).map hg₂
    refine h1.trans (((Category.assoc _ _ _).trans (congrArg (_ ≫ ·)
      ((Category.assoc _ _ _).trans (congrArg (_ ≫ ·)
        ((Functor.map_comp _ _ _).symm.trans h2))))).trans ?_)
    simp only [Functor.map_comp, Category.assoc]
    rfl
  rw [homologyMap_eq_of_ι_comp_eq (f' ≫ f) _ J J' g g₁₂ hg hg₁₂ n]
  have h₁' := h₁ =≫ ((JA.isoRightDerivedObj (globalSections T₁) n).hom ≫
    HomologicalComplex.homologyMap (((globalSections T₁).mapHomologicalComplex _).map g₂) n ≫
      (J'.isoRightDerivedObj (globalSections T₂) n).inv)
  simp only [Category.assoc, Iso.inv_hom_id_assoc] at h₁' h₂ ⊢
  rw [h₂, h₁']
  congr 2
  change _ = HomologicalComplex.homologyMap (((globalSections T).mapHomologicalComplex _).map g₁ ≫
    ((globalSections T₁).mapHomologicalComplex _).map g₂) n ≫ _
  refine (Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) (Iso.inv_hom_id_assoc _ _)).trans ?_)
  exact ((HomologicalComplex.homologyMap_comp _ _ n =≫ _).trans (Category.assoc _ _ _)).symm

attribute [local instance] globalSections_additive in
/-- Along a closed embedding `j`, `H^n(T, j_* G) → H^n(T', j⁻¹ j_* G) → H^n(T', G)` is an
isomorphism: `j_*` is exact and preserves injectives, so it carries an injective resolution of
`G` to one of `j_* G`. -/
private theorem isIso_sheafCohomologyPullback_comp_counit {T T' : TopCat.{0}} (j : T' ⟶ T)
    (hj : Topology.IsClosedEmbedding j)
    (G : TopCat.Sheaf AddCommGrpCat.{0} T') (n : ℕ) :
    IsIso (sheafCohomologyPullback j ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} j).obj G) n ≫
      (sheafCohomology T' n).map
        ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} j).counit.app G)) := by
  have hex := Stacks.ClosedImmersion.exactFunctor_closedInclusionPushforward j hj
  haveI : PreservesFiniteLimits (TopCat.Sheaf.pushforward AddCommGrpCat.{0} j) := hex.1
  haveI : PreservesFiniteColimits (TopCat.Sheaf.pushforward AddCommGrpCat.{0} j) := hex.2
  haveI : (TopCat.Sheaf.pushforward AddCommGrpCat.{0} j).PreservesInjectiveObjects :=
    Functor.preservesInjectiveObjects_of_adjunction_of_preservesMonomorphisms
      (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} j)
  let J' := injectiveResolution G
  let J := (TopCat.Sheaf.pushforward AddCommGrpCat.{0} j).mapInjectiveResolution J'
  have h := sheafCohomologyIso_pullback j _ G
    ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} j).counit.app G) J J'
    (𝟙 _) ?_ n
  · have : IsIso (HomologicalComplex.homologyMap
        (((globalSections T).mapHomologicalComplex _).map (𝟙 J.cocomplex)) n) := by
      rw [CategoryTheory.Functor.map_id, HomologicalComplex.homologyMap_id]
      infer_instance
    have hR : IsIso ((sheafCohomologyPullback j _ n ≫ (sheafCohomology T' n).map
        ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} j).counit.app G)) ≫
        (sheafCohomologyIso T' n).hom.app G) := by
      rw [Category.assoc, h]
      exact IsIso.comp_isIso' inferInstance (IsIso.comp_isIso' inferInstance
        (IsIso.comp_isIso' this (Iso.isIso_inv _)))
    exact IsIso.of_isIso_comp_right _ ((sheafCohomologyIso T' n).hom.app G)
  · rw [(TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} j).right_triangle_components]
    refine Eq.trans (Category.comp_id (J.ι.f 0)) (Eq.trans ?_ (Category.id_comp _).symm)
    simp [J, Functor.mapInjectiveResolution]

end ResolutionComparison

/-- Sheaf cohomology vanishes in negative degrees. -/
private lemma isZero_sheafCohomology_of_neg (T : TopCat.{0}) (F : TopCat.Sheaf AddCommGrpCat.{0} T)
    {q : ℤ} (hq : q < 0) : Limits.IsZero ((sheafCohomology T q).obj F) := by
  let D := godementSectionsDoubleComplex T
    ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj F)
  have hX : Limits.IsZero ((D.total (ComplexShape.up ℤ)).X q) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    refine HomologicalComplex₂.total.hom_ext _ fun i j hij => ?_
    have : Limits.IsZero ((D.X i).X j) := by
      by_cases hi : i = 0
      · subst hi
        obtain rfl : j = q := by simpa using hij
        exact HomologicalComplex.isZero_extend_X _ ComplexShape.embeddingUpNat _
          (fun k => by simp only [ComplexShape.embeddingUpNat_f]; omega)
      · have h0 : Limits.IsZero
            (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj F).X i) :=
          HomologicalComplex.isZero_single_obj_X _ _ _ _ hi
        exact (HomologicalComplex.eval _ _ j).map_isZero ((godementSections T).map_isZero h0)
    exact this.eq_of_src _ _
  exact ((D.total _).sc q).isZero_homology_of_isZero_X₂ hX

section ClosedImmersionPushforward

open Filter MMP.Analytic.ComplexPoints

section Transport

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX]

/-- To identify a transport it suffices to compare after transitions to one common chart. -/
private theorem eq_transport_of_transition_eq {c d e : Chart sX} {z : ComplexPoints sX}
    {hc : z ∈ chart (sX := sX) c.U} {hd : z ∈ chart (sX := sX) d.U}
    (he : z ∈ chart (sX := sX) e.U) (m₁ : ChartHom c e) (m₂ : ChartHom d e)
    {x : c.StalkRing (c.coords ⟨z, hc⟩)} {t : d.StalkRing (d.coords ⟨z, hd⟩)}
    (h : m₂.transition ⟨z, he⟩ t = m₁.transition ⟨z, he⟩ x) :
    t = Chart.transport c d z hc hd x :=
  (m₂.bijective_transition ⟨z, he⟩).1
    (h.trans (Chart.isTransport_transport c d z hc hd x e he m₁ m₂).symm)

/-- Transport between charts is a ring homomorphism. -/
private noncomputable def transportHom (c d : Chart sX) (z : ComplexPoints sX)
    (hc : z ∈ chart (sX := sX) c.U) (hd : z ∈ chart (sX := sX) d.U) :
    c.StalkRing (c.coords ⟨z, hc⟩) →+* d.StalkRing (d.coords ⟨z, hd⟩) :=
  let r := Chart.exists_refinement c d z (mem_chart_iff.1 hc) (mem_chart_iff.1 hd)
  let e := r.choose_spec.choose
  have hz : z ∈ chart (sX := sX) e.U := mem_chart_iff.2 r.choose_spec.choose_spec.2.2
  have hce : e.U ≤ c.U := r.choose_spec.choose_spec.1.trans_le (X.basicOpen_le _)
  (RingEquiv.ofBijective _ ((ChartHom.ofLE d e r.choose_spec.choose_spec.2.1).bijective_transition
    ⟨z, hz⟩)).symm.toRingHom.comp ((ChartHom.ofLE c e hce).transition ⟨z, hz⟩)

private theorem transportHom_apply (c d : Chart sX) (z : ComplexPoints sX)
    (hc : z ∈ chart (sX := sX) c.U) (hd : z ∈ chart (sX := sX) d.U)
    (x : c.StalkRing (c.coords ⟨z, hc⟩)) :
    transportHom c d z hc hd x = Chart.transport c d z hc hd x := by
  let r := Chart.exists_refinement c d z (mem_chart_iff.1 hc) (mem_chart_iff.1 hd)
  have hz : z ∈ chart (sX := sX) r.choose_spec.choose.U :=
    mem_chart_iff.2 r.choose_spec.choose_spec.2.2
  have hce : r.choose_spec.choose.U ≤ c.U := r.choose_spec.choose_spec.1.trans_le (X.basicOpen_le _)
  refine eq_transport_of_transition_eq hz (ChartHom.ofLE c _ hce)
    (ChartHom.ofLE d _ r.choose_spec.choose_spec.2.1) ?_
  exact (RingEquiv.ofBijective _
    ((ChartHom.ofLE d _ r.choose_spec.choose_spec.2.1).bijective_transition
      ⟨z, hz⟩)).apply_symm_apply _

/-- Transport along a transition map is that transition map. -/
private theorem transportHom_eq_transition {c d : Chart sX} (m : ChartHom c d)
    (z : ComplexPoints sX)
    (hd : z ∈ chart (sX := sX) d.U) (x : c.StalkRing (c.coords ⟨z, chart_mono m.le hd⟩)) :
    transportHom c d z (chart_mono m.le hd) hd x = m.transition ⟨z, hd⟩ x := by
  rw [transportHom_apply, Chart.transport_transition]

private theorem transition_transportHom {c d d' : Chart sX} (m : ChartHom d d')
    (z : ComplexPoints sX)
    (hc : z ∈ chart (sX := sX) c.U) (hd' : z ∈ chart (sX := sX) d'.U)
    (x : c.StalkRing (c.coords ⟨z, hc⟩)) :
    m.transition ⟨z, hd'⟩ (transportHom c d z hc (chart_mono m.le hd') x) =
      transportHom c d' z hc hd' x := by
  rw [transportHom_apply, transportHom_apply, Chart.transition_transport]

/-- Transports compose. -/
private theorem transportHom_transportHom (c c' c'' : Chart sX) (z : ComplexPoints sX)
    (hc : z ∈ chart (sX := sX) c.U) (hc' : z ∈ chart (sX := sX) c'.U)
    (hc'' : z ∈ chart (sX := sX) c''.U) (x : c.StalkRing (c.coords ⟨z, hc⟩)) :
    transportHom c' c'' z hc' hc'' (transportHom c c' z hc hc' x) =
      transportHom c c'' z hc hc'' x := by
  obtain ⟨f, e₀, he₀, hle₀, hz₀⟩ := Chart.exists_refinement c c' z (mem_chart_iff.1 hc)
    (mem_chart_iff.1 hc')
  obtain ⟨f', e, he, hle, hz⟩ := Chart.exists_refinement e₀ c'' z hz₀ (mem_chart_iff.1 hc'')
  have hz' : z ∈ chart (sX := sX) e.U := mem_chart_iff.2 hz
  have h₀ : e.U ≤ e₀.U := he ▸ X.basicOpen_le f'
  have hc₀ : e₀.U ≤ c.U := he₀ ▸ X.basicOpen_le f
  rw [transportHom_apply, transportHom_apply, transportHom_apply]
  refine eq_transport_of_transition_eq hz' (ChartHom.ofLE c e (h₀.trans hc₀))
    (ChartHom.ofLE c'' e hle) ?_
  rw [Chart.isTransport_transport c' c'' z hc' hc'' _ e hz' (ChartHom.ofLE c' e (h₀.trans hle₀))
      (ChartHom.ofLE c'' e hle),
    Chart.isTransport_transport c c' z hc hc' x e hz' (ChartHom.ofLE c e (h₀.trans hc₀))
      (ChartHom.ofLE c' e (h₀.trans hle₀))]

/-- Transport commutes with the homomorphisms from the local ring of `X`. -/
private theorem transportHom_stalkHom (c d : Chart sX) (z : ComplexPoints sX)
    (hc : z ∈ chart (sX := sX) c.U) (hd : z ∈ chart (sX := sX) d.U)
    (γ : X.presheaf.stalk z.toScheme) :
    transportHom c d z hc hd (c.stalkHom ⟨z, hc⟩ γ) = d.stalkHom ⟨z, hd⟩ γ := by
  obtain ⟨f, e, he, hle, hz⟩ := Chart.exists_refinement c d z (mem_chart_iff.1 hc)
    (mem_chart_iff.1 hd)
  have hz' : z ∈ chart (sX := sX) e.U := mem_chart_iff.2 hz
  have hce : e.U ≤ c.U := he ▸ X.basicOpen_le f
  rw [transportHom_apply]
  refine (eq_transport_of_transition_eq hz' (ChartHom.ofLE c e hce) (ChartHom.ofLE d e hle) ?_).symm
  exact ((ChartHom.ofLE d e hle).transition_stalkHom ⟨z, hz'⟩ γ).trans
    ((ChartHom.ofLE c e hce).transition_stalkHom ⟨z, hz'⟩ γ).symm

/-- Transporting the classes of the germs of one holomorphic function of the coordinates of a
chart `c` to another chart `d` gives, near every point, the classes of the germs of one
function of the coordinates of `d`. -/
private theorem exists_eq_mk_transportHom (c d : Chart sX) (x : ComplexPoints sX)
    (hxc : x ∈ chart (sX := sX) c.U) (hxd : x ∈ chart (sX := sX) d.U)
    (h : (Fin c.n → ℂ) → ℂ) (T : Set (Fin c.n → ℂ)) (hTo : IsOpen T)
    (hT : ∀ q ∈ T, ∀ᶠ z in 𝓝 q, DifferentiableAt ℂ h z) (hxT : c.coords ⟨x, hxc⟩ ∈ T) :
    ∃ O : Set (chart (sX := sX) d.U), IsOpen[chartTopology d.U] O ∧ ⟨x, hxd⟩ ∈ O ∧
      ∃ h' : (Fin d.n → ℂ) → ℂ, ∀ w ∈ O, ∃ (hwc : w.1 ∈ chart (sX := sX) c.U)
        (hwT : c.coords ⟨w.1, hwc⟩ ∈ T), ∃ g : holGerms (d.coords w),
          (g : Germ (𝓝 (d.coords w)) ℂ) = h' ∧
          transportHom c d w.1 hwc w.2 (Chart.StalkRing.mk c _
            ⟨(h : Germ (𝓝 (c.coords ⟨w.1, hwc⟩)) ℂ), coe_mem_holGerms (hT _ hwT)⟩) =
            Chart.StalkRing.mk d _ g := by
  have hO : IsOpen[chartTopology c.U] (c.coords ⁻¹' T) :=
    @Continuous.isOpen_preimage _ _ (chartTopology c.U) _ _ c.continuous_coords _ hTo
  let W : Opens (space sX) := ⟨_, c.isOpen_image_val hO⟩
  have hWc : ∀ y : W, y.1 ∈ chart (sX := sX) c.U := fun y => by
    obtain ⟨o, -, ho⟩ := y.2
    exact ho ▸ o.2
  have hWT : ∀ y : W, c.coords ⟨y.1, hWc y⟩ ∈ T := fun y => by
    obtain ⟨o, hoT, ho⟩ := y.2
    have : (⟨y.1, hWc y⟩ : chart (sX := sX) c.U) = o := Subtype.ext ho.symm
    rw [this]
    exact hoT
  have hxW : x ∈ W := ⟨⟨x, hxc⟩, hxT, rfl⟩
  obtain ⟨f, e, he, hle, hz⟩ := Chart.exists_refinement d c x (mem_chart_iff.1 hxd)
    (mem_chart_iff.1 hxc)
  have hde : e.U ≤ d.U := he.trans_le (X.basicOpen_le f)
  obtain ⟨G, Q, hGw, hQd, hQw, hinv⟩ := (ChartHom.ofLE d e hde).exists_inverse_of_eq_basicOpen he
  refine ⟨{w | w.1 ∈ W ∧ w.1.toScheme ∈ e.U},
    (chartTopology d.U).isOpen_inter _ _ (isOpen_chart_inter ⟨d.U, d.isAffineOpen⟩ W)
      (isOpen_toScheme_mem ⟨d.U, d.isAffineOpen⟩ e.U), ⟨hxW, hz⟩,
    h ∘ (ChartHom.ofLE c e hle).polyMap ∘ Q, fun w hw => ?_⟩
  obtain ⟨hwW, hwe⟩ := hw
  let w' : chart (sX := sX) e.U := ⟨w.1, mem_chart_iff.2 hwe⟩
  have hQd' : ∀ᶠ x in 𝓝 (d.coords ((ChartHom.ofLE d e hde).incl w')),
      DifferentiableAt ℂ Q x :=
    ((differentiable_eval_mvPolynomial G).continuous.continuousAt.eventually_ne
      (hGw w')).mono fun x hx => hQd x hx
  have hQ : Tendsto Q (𝓝 (d.coords ((ChartHom.ofLE d e hde).incl w'))) (𝓝 (e.coords w')) := by
    have := (hQd _ (hGw w')).continuousAt.tendsto
    rwa [hQw] at this
  let g₁ : holGerms (c.coords ((ChartHom.ofLE c e hle).incl w')) :=
    ⟨(h : Germ _ ℂ), coe_mem_holGerms (hT _ (hWT ⟨w.1, hwW⟩))⟩
  obtain ⟨-, hright, -⟩ := hinv w' hQd' hQ
  refine ⟨hWc ⟨w.1, hwW⟩, hWT ⟨w.1, hwW⟩, holPullbackAt Q hQd' hQ
    (holPullback (ChartHom.ofLE c e hle).polyMap (ChartHom.ofLE c e hle).differentiable_polyMap
      ((ChartHom.ofLE c e hle).tendsto_polyMap w') g₁), rfl, ?_⟩
  apply ((ChartHom.ofLE d e hde).bijective_transition w').1
  refine (transition_transportHom (ChartHom.ofLE d e hde) w.1 (hWc ⟨w.1, hwW⟩) w'.2 _).trans ?_
  refine (transportHom_eq_transition (ChartHom.ofLE c e hle) w.1 w'.2 _).trans ?_
  refine ((ChartHom.ofLE c e hle).transition_mk w' g₁).trans ?_
  exact (hright _).symm

end Transport

section ClosedImm

variable {X P : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {sP : P ⟶ Spec (.of ℂ)}
  (i : X ⟶ P) [IsClosedImmersion i] (hi : i ≫ sP = sX)

/-- The quotient map from the local ring of a chart of `P` to that of the induced chart of `X`. -/
private noncomputable def restrictStalkRing (d : Chart sP) (p : Fin d.n → ℂ) :
    d.StalkRing p →+* (Chart.comapClosedImmersion i hi d).StalkRing p :=
  Ideal.Quotient.factor (Ideal.map_mono (Chart.ideal_le_comapClosedImmersion_ideal i hi d))

/-- The chart morphism of `X` induced by a chart morphism of `P`. -/
private def comapChartHom {d d' : Chart sP} (m : ChartHom d d') :
    ChartHom (Chart.comapClosedImmersion i hi d) (Chart.comapClosedImmersion i hi d') where
  le := (Opens.map i.base).monotone m.le
  P := m.P
  spec j := by
    change X.presheaf.map _ (i.app d.U (d.gen j)) =
      (Chart.comapClosedImmersion i hi d').pres (m.P j)
    rw [Chart.comapClosedImmersion_pres, RingHom.comp_apply, ← m.spec j,
      ← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.naturality]
    rfl

private theorem restrictStalkRing_stalkHom (d : Chart sP)
    (x : chart (sX := sX) (Chart.comapClosedImmersion i hi d).U)
    (γ : P.presheaf.stalk (i x.1.toScheme)) :
    restrictStalkRing i hi d _
        (d.stalkHom ⟨realize i hi x.1, (mem_chart_preimage_iff i hi).1 x.2⟩ γ) =
      (Chart.comapClosedImmersion i hi d).stalkHom x (i.stalkMap x.1.toScheme γ) := by
  have hx : i x.1.toScheme ∈ d.U := mem_chart_iff.1 x.2
  let _ := TopCat.Presheaf.algebra_section_stalk P.presheaf (U := d.U) ⟨i x.1.toScheme, hx⟩
  have := d.isAffineOpen.isLocalization_stalk ⟨i x.1.toScheme, hx⟩
  let φ : P.presheaf.stalk (i x.1.toScheme) →+* d.StalkRing _ :=
    d.stalkHom ⟨realize i hi x.1, (mem_chart_preimage_iff i hi).1 x.2⟩
  have key : (restrictStalkRing i hi d _).comp φ =
      ((Chart.comapClosedImmersion i hi d).stalkHom x).comp (i.stalkMap x.1.toScheme).hom := by
    refine IsLocalization.ringHom_ext
      (d.isAffineOpen.primeIdealOf ⟨i x.1.toScheme, hx⟩).asIdeal.primeCompl ?_
    ext f
    obtain ⟨q, rfl⟩ := d.surjective f
    change restrictStalkRing i hi d _ (φ (P.presheaf.germ d.U _ hx (d.pres q))) =
      (Chart.comapClosedImmersion i hi d).stalkHom x
        (i.stalkMap x.1.toScheme (P.presheaf.germ d.U _ hx (d.pres q)))
    rw [Scheme.Hom.germ_stalkMap_apply]
    have h1 : φ (P.presheaf.germ d.U _ hx (d.pres q)) = d.toStalkRing _ (d.pres q) :=
      d.stalkHom_germ _ _
    have h2 := (Chart.comapClosedImmersion i hi d).stalkHom_germ x (i.app d.U (d.pres q))
    rw [h1]
    refine Eq.trans ?_ h2.symm
    have h4 : i.app d.U (d.pres q) = (Chart.comapClosedImmersion i hi d).pres q :=
      (RingHom.congr_fun (Chart.comapClosedImmersion_pres i hi d) q).symm
    rw [h4, Chart.toStalkRing_pres, Chart.toStalkRing_pres]
    rfl
  exact RingHom.congr_fun key γ

variable [LocallyOfFiniteType sX] [LocallyOfFiniteType sP]

/-- `restrictStalkRing` at a `ℂ`-point of `X`, with the coordinates of the induced chart. -/
private noncomputable def restrictAt (d : Chart sP) (x : ComplexPoints sX)
    (hx : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U) :
    d.StalkRing (d.coords ⟨realize i hi x, (mem_chart_preimage_iff i hi).1 hx⟩) →+*
      (Chart.comapClosedImmersion i hi d).StalkRing
        ((Chart.comapClosedImmersion i hi d).coords ⟨x, hx⟩) :=
  restrictStalkRing i hi d _

private theorem restrictAt_stalkHom (d : Chart sP) (x : ComplexPoints sX)
    (hx : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U)
    (γ : P.presheaf.stalk (realize i hi x).toScheme) :
    restrictAt i hi d x hx (d.stalkHom ⟨realize i hi x, (mem_chart_preimage_iff i hi).1 hx⟩ γ) =
      (Chart.comapClosedImmersion i hi d).stalkHom ⟨x, hx⟩ (i.stalkMap x.toScheme γ) :=
  restrictStalkRing_stalkHom i hi d ⟨x, hx⟩ γ

private theorem restrictAt_mk_coe (d : Chart sP) (x : ComplexPoints sX)
    (hx : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U) (h : (Fin d.n → ℂ) → ℂ)
    (h₁ : (h : Germ (𝓝 (d.coords ⟨realize i hi x, (mem_chart_preimage_iff i hi).1 hx⟩)) ℂ) ∈
      holGerms _)
    (h₂ : (h : Germ (𝓝 ((Chart.comapClosedImmersion i hi d).coords ⟨x, hx⟩)) ℂ) ∈ holGerms _) :
    restrictAt i hi d x hx (Chart.StalkRing.mk d _ ⟨_, h₁⟩) =
      Chart.StalkRing.mk (Chart.comapClosedImmersion i hi d) _ ⟨_, h₂⟩ :=
  rfl

private theorem transition_restrictAt {d d' : Chart sP} (m : ChartHom d d') (x : ComplexPoints sX)
    (hx : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d').U)
    (a : d.StalkRing (d.coords ⟨realize i hi x,
      (mem_chart_preimage_iff i hi).1 (chart_mono (comapChartHom i hi m).le hx)⟩)) :
    (comapChartHom i hi m).transition ⟨x, hx⟩
        (restrictAt i hi d x (chart_mono (comapChartHom i hi m).le hx) a) =
      restrictAt i hi d' x hx
        (m.transition ⟨realize i hi x, (mem_chart_preimage_iff i hi).1 hx⟩ a) := by
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective a
  rfl

private theorem restrictAt_transportHom (d d' : Chart sP) (x : ComplexPoints sX)
    (hd : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U)
    (hd' : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d').U)
    (a : d.StalkRing (d.coords ⟨realize i hi x, (mem_chart_preimage_iff i hi).1 hd⟩)) :
    restrictAt i hi d' x hd' (transportHom d d' (realize i hi x)
        ((mem_chart_preimage_iff i hi).1 hd) ((mem_chart_preimage_iff i hi).1 hd') a) =
      transportHom (Chart.comapClosedImmersion i hi d) (Chart.comapClosedImmersion i hi d') x hd hd'
        (restrictAt i hi d x hd a) := by
  obtain ⟨g, f, hf, hle, hz⟩ := Chart.exists_refinement d d' (realize i hi x)
    (mem_chart_iff.1 ((mem_chart_preimage_iff i hi).1 hd))
    (mem_chart_iff.1 ((mem_chart_preimage_iff i hi).1 hd'))
  have hfd : f.U ≤ d.U := hf.trans_le (P.basicOpen_le g)
  have hz' : realize i hi x ∈ chart (sX := sP) f.U := mem_chart_iff.2 hz
  have hzx : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi f).U :=
    (mem_chart_preimage_iff i hi).2 hz'
  rw [transportHom_apply (Chart.comapClosedImmersion i hi d)]
  refine eq_transport_of_transition_eq hzx (comapChartHom i hi (ChartHom.ofLE d f hfd))
    (comapChartHom i hi (ChartHom.ofLE d' f hle)) ?_
  rw [transition_restrictAt, transition_restrictAt]
  refine congrArg (restrictAt i hi f x hzx) ?_
  rw [transportHom_apply]
  exact Chart.isTransport_transport d d' _ _ _ a f hz' _ _

/-- The components of a section of `𝒪_{P^an}` in two charts are transports of each other. -/
private theorem sections_apply_eq_transportHom {W : Opens (space sP)} (s : sections sP W) (p : W)
    (d d' : Chart sP) (hd : p.1 ∈ chart (sX := sP) d.U) (hd' : p.1 ∈ chart (sX := sP) d'.U) :
    s.1 p ⟨d', hd'⟩ = transportHom d d' p.1 hd hd' (s.1 p ⟨d, hd⟩) := by
  obtain ⟨g, e, he, hle, hz⟩ := Chart.exists_refinement d d' p.1 (mem_chart_iff.1 hd)
    (mem_chart_iff.1 hd')
  have hz' : p.1 ∈ chart (sX := sP) e.U := mem_chart_iff.2 hz
  have hde : e.U ≤ d.U := he.trans_le (P.basicOpen_le g)
  rw [transportHom_apply]
  refine eq_transport_of_transition_eq hz' (ChartHom.ofLE d e hde) (ChartHom.ofLE d' e hle) ?_
  exact (s.2.2 d' e _ p hz').trans (s.2.2 d e _ p hz').symm

end ClosedImm

section Theta

variable {X P : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {sP : P ⟶ Spec (.of ℂ)}
  (i : X ⟶ P) [IsClosedImmersion i] (hi : i ≫ sP = sX)
  [LocallyOfFiniteType sX] [LocallyOfFiniteType sP]

omit [LocallyOfFiniteType sX] in
/-- A chosen chart of `P` through a `ℂ`-point. -/
private noncomputable def chartAt (p : ComplexPoints sP) : Chart sP := (exists_chart sP p).choose

omit [LocallyOfFiniteType sX] in
private theorem mem_chartAt (p : ComplexPoints sP) : p ∈ chart (sX := sP) (chartAt p).U :=
  (exists_chart sP p).choose_spec

private theorem mem_comap_chartAt (x : ComplexPoints sX) :
    x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi (chartAt (realize i hi x))).U :=
  (mem_chart_preimage_iff i hi).2 (mem_chartAt _)

/-- The fibrewise map underlying `θ : 𝒪_{P^an} → i^an_* 𝒪_{X^an}`. -/
private noncomputable def thetaHom (W : Opens (space sP)) :
    sections sP W →+* ∀ x : (Opens.map (analyticMap i hi)).obj W, Fibre x.1 :=
  Pi.ringHom fun x => Pi.ringHom fun c =>
    (transportHom _ c.1 x.1 (mem_comap_chartAt i hi x.1) c.2).comp <|
      (restrictAt i hi _ x.1 (mem_comap_chartAt i hi x.1)).comp <|
        (Pi.evalRingHom (fun c' : {c : Chart sP // realize i hi x.1 ∈ chart (sX := sP) c.U} =>
          c'.1.StalkRing (c'.1.coords ⟨realize i hi x.1, c'.2⟩))
            ⟨chartAt (realize i hi x.1), mem_chartAt _⟩).comp <|
        (Pi.evalRingHom (fun y : W => Fibre y.1) ⟨realize i hi x.1, x.2⟩).comp
          (sections sP W).subtype

/-- The value of `θ` may be computed in any chart of `P`. -/
private theorem thetaHom_apply (W : Opens (space sP)) (s : sections sP W)
    (x : (Opens.map (analyticMap i hi)).obj W) (c : {c : Chart sX // x.1 ∈ chart (sX := sX) c.U})
    (d : Chart sP) (hd : x.1 ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U) :
    thetaHom i hi W s x c = transportHom _ c.1 x.1 hd c.2
      (restrictAt i hi d x.1 hd
        (s.1 ⟨realize i hi x.1, x.2⟩ ⟨d, (mem_chart_preimage_iff i hi).1 hd⟩)) := by
  rw [sections_apply_eq_transportHom s ⟨realize i hi x.1, x.2⟩ (chartAt (realize i hi x.1)) d
    (mem_chartAt _) ((mem_chart_preimage_iff i hi).1 hd), restrictAt_transportHom,
    transportHom_transportHom]
  rfl

private theorem isCompatible_thetaHom (W : Opens (space sP)) (s : sections sP W) :
    IsCompatible (thetaHom i hi W s) := fun _ _ m x hx =>
  transition_transportHom m x.1 _ hx _

private theorem isLocallyHolomorphic_thetaHom (W : Opens (space sP)) (s : sections sP W) :
    IsLocallyHolomorphic (thetaHom i hi W s) := by
  intro c x hx
  obtain ⟨d, hd⟩ : ∃ d : Chart sP, realize i hi x.1 ∈ chart (sX := sP) d.U :=
    ⟨_, mem_chartAt _⟩
  have hxd : x.1 ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U :=
    (mem_chart_preimage_iff i hi).2 hd
  obtain ⟨OP, hOP, hxOP, hP, hh⟩ := s.2.1 d ⟨realize i hi x.1, x.2⟩ hd
  obtain ⟨T, hTdef⟩ : ∃ T : Set (Fin d.n → ℂ), T = {q | ∀ᶠ z in 𝓝 q, DifferentiableAt ℂ hP z} :=
    ⟨_, rfl⟩
  have hTo : IsOpen T := hTdef ▸ isOpen_setOf_eventually_nhds
  have hT : ∀ q ∈ T, ∀ᶠ z in 𝓝 q, DifferentiableAt ℂ hP z := fun q hq => by
    rwa [hTdef] at hq
  have hOT : ∀ y ∈ OP, d.coords y ∈ T := by
    intro y hy
    obtain ⟨-, g, hg, -⟩ := hh y hy
    obtain ⟨f, hfg, hf⟩ := g.2
    have heq : f =ᶠ[𝓝 (d.coords y)] hP := Germ.coe_eq.1 (hfg.trans hg)
    rw [hTdef]
    exact (hf.and heq.eventuallyEq_nhds).mono fun z hz => hz.1.congr_of_eventuallyEq hz.2.symm
  obtain ⟨Oc, hOc, hxOc, h', hh'⟩ := exists_eq_mk_transportHom (Chart.comapClosedImmersion i hi d) c
    x.1 hxd hx hP T hTo hT
    ((Chart.coords_comapClosedImmersion i hi d ⟨x.1, hxd⟩).symm ▸ hOT _ hxOP)
  have hVo : IsOpen ((realize i hi) ⁻¹' (Subtype.val '' OP)) :=
    (d.isOpen_image_val hOP).preimage (continuous_realize i hi)
  refine ⟨Oc ∩ {w | realize i hi w.1 ∈ Subtype.val '' OP},
    (chartTopology c.U).isOpen_inter _ _ hOc (isOpen_chart_inter ⟨c.U, c.isAffineOpen⟩ ⟨_, hVo⟩),
    ⟨hxOc, ⟨_, hxOP, rfl⟩⟩, h', fun w hw => ?_⟩
  obtain ⟨hwOc, ⟨⟨o, ho⟩, hoOP, hoeq⟩⟩ := hw
  obtain ⟨hwc, hwT, g', hg', htr⟩ := hh' w hwOc
  obtain ⟨hoW, g, hg, hso⟩ := hh ⟨o, ho⟩ hoOP
  change o = realize i hi w.1 at hoeq
  subst hoeq
  refine ⟨hoW, g', hg', ?_⟩
  have hg₁ : (hP : Germ (𝓝 (d.coords ⟨realize i hi w.1, (mem_chart_preimage_iff i hi).1 hwc⟩)) ℂ) ∈
      holGerms _ := hg ▸ g.2
  have e1 : s.1 ⟨realize i hi w.1, hoW⟩ ⟨d, (mem_chart_preimage_iff i hi).1 hwc⟩ =
      Chart.StalkRing.mk d _ ⟨_, hg₁⟩ :=
    hso.trans (congrArg (Chart.StalkRing.mk d _) (Subtype.ext hg))
  rw [thetaHom_apply i hi W s ⟨w.1, hoW⟩ ⟨c, w.2⟩ d hwc, e1, restrictAt_mk_coe i hi d w.1 hwc hP hg₁
    (coe_mem_holGerms (hT _ hwT))]
  exact htr

/-- `θ` on sections over an open `W ⊆ P(ℂ)`. -/
private noncomputable def thetaSections (W : Opens (space sP)) :
    sections sP W →+* sections sX ((Opens.map (analyticMap i hi)).obj W) :=
  (thetaHom i hi W).codRestrict _ fun s =>
    ⟨isLocallyHolomorphic_thetaHom i hi W s, isCompatible_thetaHom i hi W s⟩

variable [(Opens.map (analyticMap i hi)).IsContinuous (Opens.grothendieckTopology (space sP))
  (Opens.grothendieckTopology (space sX))]

/-- **The comparison of structure sheaves along a closed immersion**,
`θ : 𝒪_{P^an} → i^an_* 𝒪_{X^an}`. -/
private noncomputable def theta : ringCatSheaf sP ⟶
    ((Opens.map (analyticMap i hi)).sheafPushforwardContinuous RingCat.{0}
      (Opens.grothendieckTopology (space sP)) (Opens.grothendieckTopology (space sX))).obj
      (ringCatSheaf sX) :=
  ObjectProperty.homMk
    { app := fun W =>
        (forget₂ CommRingCat RingCat).map (CommRingCat.ofHom (thetaSections i hi W.unop))
      naturality := fun W W' f => by
        ext s
        rfl }

private theorem theta_app_ringCatSheafHom (V : P.Opens) (f : Γ(P, V)) :
    (theta i hi).hom.app (op ((Opens.map (toSchemeHom sP)).obj V))
        ((ringCatSheafHom sP).hom.app (op V) f) =
      (ringCatSheafHom sX).hom.app (op (i ⁻¹ᵁ V)) (i.app V f) := by
  apply Subtype.ext
  funext x c
  change thetaHom i hi _ (sharpHom V f) x c = c.1.stalkHom ⟨x.1, c.2⟩
    (X.presheaf.germ (i ⁻¹ᵁ V) x.1.toScheme x.2 (i.app V f))
  rw [thetaHom_apply i hi _ _ x c (chartAt (realize i hi x.1)) (mem_comap_chartAt i hi x.1),
    sharpHom_apply]
  rw [restrictAt_stalkHom, transportHom_stalkHom]
  exact congrArg _ (Scheme.Hom.germ_stalkMap_apply i V x.1.toScheme x.2 f)

end Theta

section ModuleIso

variable {X P : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {sP : P ⟶ Spec (.of ℂ)}
  (i : X ⟶ P) [IsClosedImmersion i] (hi : i ≫ sP = sX)
  [LocallyOfFiniteType sX] [LocallyOfFiniteType sP]
  [(Opens.map (analyticMap i hi)).IsContinuous (Opens.grothendieckTopology (space sP))
    (Opens.grothendieckTopology (space sX))]

private theorem isContinuous_map_comp_map :
    (Opens.map i.base ⋙ Opens.map (toSchemeHom sX)).IsContinuous
    (Opens.grothendieckTopology P) (Opens.grothendieckTopology (space sX)) :=
  Functor.isContinuous_comp _ _ _ (Opens.grothendieckTopology X) _

attribute [local instance] isContinuous_map_comp_map

private theorem toRingCatSheafHom_comp_ringCatSheafHom :
    (i.toRingCatSheafHom ≫ ((Opens.map i.base).sheafPushforwardContinuous RingCat.{0} _ _).map
      (ringCatSheafHom sX) : P.ringCatSheaf ⟶
        ((Opens.map i.base ⋙ Opens.map (toSchemeHom sX)).sheafPushforwardContinuous
          RingCat.{0} _ (Opens.grothendieckTopology (space sX))).obj (ringCatSheaf sX)) =
    (ringCatSheafHom sP ≫
        ((Opens.map (toSchemeHom sP)).sheafPushforwardContinuous RingCat.{0} _ _).map
      (theta i hi) : P.ringCatSheaf ⟶
        ((Opens.map i.base ⋙ Opens.map (toSchemeHom sX)).sheafPushforwardContinuous
          RingCat.{0} _ (Opens.grothendieckTopology (space sX))).obj (ringCatSheaf sX)) := by
  refine Sheaf.hom_ext (NatTrans.ext (funext fun U => ?_))
  ext f
  exact (theta_app_ringCatSheafHom i hi U.unop f).symm

/-- The comparison `(i_* F)^an ⟶ i^an_* F^an`, adjoint to `i_*` of the unit `F ⟶ (α_X)_* F^an`. -/
private noncomputable def moduleHom (F : X.Modules) :
    (analytifyModule sP).obj ((Scheme.Modules.pushforward i).obj F) ⟶
      (SheafOfModules.pushforward.{0} (theta i hi)).obj ((analytifyModule sX).obj F) :=
  ((SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sP)).homEquiv _ _).symm
    ((Scheme.Modules.pushforward i).map (analytifyModuleUnit sX F) ≫
      (SheafOfModules.pushforwardCongr (toRingCatSheafHom_comp_ringCatSheafHom i hi)).hom.app
        ((analytifyModule sX).obj F))

private theorem moduleHom_app_unit (F : X.Modules) (V : P.Opens) (s : F.val.obj (op (i ⁻¹ᵁ V))) :
    (moduleHom i hi F).val.app (op ((Opens.map (toSchemeHom sP)).obj V))
        ((analytifyModuleUnit sP ((Scheme.Modules.pushforward i).obj F)).val.app (op V) s) =
      (analytifyModuleUnit sX F).val.app (op (i ⁻¹ᵁ V)) s := by
  have h₂ := (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sP)).homEquiv_unit
    _ _ (moduleHom i hi F)
  have h₁ : (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sP)).homEquiv _ _
      (moduleHom i hi F) = (Scheme.Modules.pushforward i).map (analytifyModuleUnit sX F) ≫
        (SheafOfModules.pushforwardCongr (toRingCatSheafHom_comp_ringCatSheafHom i hi)).hom.app
          ((analytifyModule sX).obj F) :=
    Equiv.apply_symm_apply _ _
  exact congrArg (fun φ => φ.val.app (op V) s) (h₂.symm.trans h₁)

/-- Read through the adjunctions, the two routes `i_* F ⟶ (i ∘ α_X)_* F^an` agree: the comparison
`(i_* F)^an ≅ i^an_* F^an` carries the unit of `i_* F` to that of `F`. -/
private theorem unit_comp_pushforward_moduleHom (F : X.Modules) :
    (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} (toSchemeHom sP)).unit.app
        ((SheafOfModules.toSheaf _).obj ((Scheme.Modules.pushforward i).obj F)) ≫
      (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (toSchemeHom sP)).map
        (analytifyModuleι sP ((Scheme.Modules.pushforward i).obj F) ≫
          (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
            (analyticMap i hi)).unit.app _ ≫
          (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (analyticMap i hi)).map
            (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
              (analyticMap i hi)).homEquiv _
                ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F))).symm
              ((SheafOfModules.toSheaf _).map (moduleHom i hi F)))) =
    (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} i.base).unit.app
        ((SheafOfModules.toSheaf _).obj ((Scheme.Modules.pushforward i).obj F)) ≫
      (TopCat.Sheaf.pushforward AddCommGrpCat.{0} i.base).map
        ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} i.base).counit.app
            ((SheafOfModules.toSheaf _).obj F) ≫
          (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
            (toSchemeHom sX)).unit.app _ ≫
          (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (toSchemeHom sX)).map
            (analytifyModuleι sX F)) := by
  let adjP := TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} (toSchemeHom sP)
  let adjA := TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} (analyticMap i hi)
  let adjI := TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} i.base
  let adjX := TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} (toSchemeHom sX)
  have a1 : adjP.unit.app _ ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (toSchemeHom sP)).map
      (analytifyModuleι sP ((Scheme.Modules.pushforward i).obj F)) =
      (SheafOfModules.toSheaf _).map
        (analytifyModuleUnit sP ((Scheme.Modules.pushforward i).obj F)) :=
    (adjP.homEquiv_unit _ _ _).symm.trans (Equiv.apply_symm_apply _ _)
  have a2 : adjA.unit.app _ ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (analyticMap i hi)).map
      ((adjA.homEquiv _ ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F))).symm
        ((SheafOfModules.toSheaf _).map (moduleHom i hi F))) =
      (SheafOfModules.toSheaf _).map (moduleHom i hi F) :=
    (adjA.homEquiv_unit _ _ _).symm.trans (Equiv.apply_symm_apply _ _)
  have a3 := adjI.right_triangle_components ((SheafOfModules.toSheaf _).obj F)
  have a4 : adjX.unit.app _ ≫ (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (toSchemeHom sX)).map
      (analytifyModuleι sX F) = (SheafOfModules.toSheaf _).map (analytifyModuleUnit sX F) :=
    (adjX.homEquiv_unit _ _ _).symm.trans (Equiv.apply_symm_apply _ _)
  have s2 : (SheafOfModules.toSheaf _).map
        (analytifyModuleUnit sP ((Scheme.Modules.pushforward i).obj F)) ≫
      (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (toSchemeHom sP)).map
        ((SheafOfModules.toSheaf _).map (moduleHom i hi F)) =
      (TopCat.Sheaf.pushforward AddCommGrpCat.{0} i.base).map
        ((SheafOfModules.toSheaf _).map (analytifyModuleUnit sX F)) := by
    ext V s
    exact moduleHom_app_unit i hi F V.unop s
  refine Eq.trans ?_ (s2.trans ?_)
  · refine (_ ≫= ((Functor.map_comp _ _ _).trans (_ ≫=
      congrArg (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (toSchemeHom sP)).map a2))).trans ?_
    exact (Category.assoc _ _ _).symm.trans (a1 =≫ _)
  · exact ((congrArg (_ ≫ ·) (Functor.map_comp _ _ _)).trans ((Category.assoc _ _ _).symm.trans
      ((a3 =≫ _).trans ((Category.id_comp _).trans
        (congrArg (TopCat.Sheaf.pushforward AddCommGrpCat.{0} i.base).map a4))))).symm

end ModuleIso

section Tau

variable {X P : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {sP : P ⟶ Spec (.of ℂ)}
  (i : X ⟶ P) [IsClosedImmersion i] (hi : i ≫ sP = sX)
  [LocallyOfFiniteType sX] [LocallyOfFiniteType sP]

private theorem transportHom_self (c : Chart sX) (z : ComplexPoints sX)
    (hc : z ∈ chart (sX := sX) c.U)
    (a : c.StalkRing (c.coords ⟨z, hc⟩)) : transportHom c c z hc hc a = a := by
  rw [transportHom_apply, Chart.transport_self]

/-- `θ` as a morphism of presheaves of commutative rings. -/
private noncomputable def thetaPresheaf : (structureSheaf sP).obj ⟶
    (TopCat.Presheaf.pushforward CommRingCat.{0} (analyticMap i hi)).obj
      (structureSheaf sX).obj where
  app W := CommRingCat.ofHom (thetaSections i hi W.unop)
  naturality _ _ _ := rfl

/-- The stalk map `τ : 𝒪_{P^an, i(x)} → 𝒪_{X^an, x}` of `θ`. -/
private noncomputable def tau (x : ComplexPoints sX) :
    (analytification sP).presheaf.stalk (realize i hi x) →+*
      (analytification sX).presheaf.stalk x :=
  ((TopCat.Presheaf.stalkFunctor CommRingCat.{0} (analyticMap i hi x)).map (thetaPresheaf i hi) ≫
    TopCat.Presheaf.stalkPushforward CommRingCat.{0} (analyticMap i hi)
      (structureSheaf sX).obj x).hom

private theorem tau_germ (x : ComplexPoints sX) (W : Opens (space sP)) (hx : realize i hi x ∈ W)
    (s : sections sP W) :
    tau i hi x ((analytification sP).presheaf.germ W (realize i hi x) hx s) =
      (analytification sX).presheaf.germ ((Opens.map (analyticMap i hi)).obj W) x hx
        (thetaSections i hi W s) := by
  change ((analytification sP).presheaf.germ W (realize i hi x) hx ≫
    (TopCat.Presheaf.stalkFunctor CommRingCat.{0} (analyticMap i hi x)).map (thetaPresheaf i hi) ≫
    TopCat.Presheaf.stalkPushforward CommRingCat.{0} (analyticMap i hi)
      (structureSheaf sX).obj x) s = _
  erw [TopCat.Presheaf.stalkFunctor_map_germ_assoc, TopCat.Presheaf.stalkPushforward_germ]
  rfl

private theorem tau_stalkToStalkRing (x : ComplexPoints sX) (d : Chart sP)
    (hx : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U)
    (b : (analytification sP).presheaf.stalk (realize i hi x)) :
    (Chart.comapClosedImmersion i hi d).stalkToStalkRing x hx (tau i hi x b) =
      restrictAt i hi d x hx (d.stalkToStalkRing (realize i hi x)
        ((mem_chart_preimage_iff i hi).1 hx) b) := by
  obtain ⟨W, hpW, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq _ b
  erw [tau_germ i hi x W hpW s, Chart.stalkToStalkRing_germ, Chart.stalkToStalkRing_germ]
  change thetaHom i hi W s ⟨x, hpW⟩ ⟨_, hx⟩ = _
  rw [thetaHom_apply i hi W s ⟨x, hpW⟩ ⟨_, hx⟩ d hx, transportHom_self]

private theorem tau_surjective (x : ComplexPoints sX) : Function.Surjective (tau i hi x) := by
  intro c
  obtain ⟨d, hd⟩ : ∃ d : Chart sP, realize i hi x ∈ chart (sX := sP) d.U := ⟨_, mem_chartAt _⟩
  have hx : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U :=
    (mem_chart_preimage_iff i hi).2 hd
  obtain ⟨a, ha⟩ := Ideal.Quotient.factor_surjective
    (Ideal.map_mono (Chart.ideal_le_comapClosedImmersion_ideal i hi d))
    ((Chart.comapClosedImmersion i hi d).stalkToStalkRing x hx c)
  obtain ⟨b, rfl⟩ := Chart.surjective_stalkToStalkRing d (realize i hi x) hd a
  refine ⟨b, Chart.injective_stalkToStalkRing _ x hx ?_⟩
  rw [tau_stalkToStalkRing i hi x d hx]
  exact ha

private theorem stalkToStalkRing_stalkMap (d : Chart sP) (p : ComplexPoints sP)
    (hd : p ∈ chart (sX := sP) d.U) (f : Γ(P, d.U)) :
    d.stalkToStalkRing p hd (((analytificationHom sP).hom.stalkMap p).hom
        (P.presheaf.germ d.U p.toScheme (mem_chart_iff.1 hd) f)) =
      d.toStalkRing (d.coords ⟨p, hd⟩) f := by
  rw [stalkMap_germ_apply]
  erw [Chart.stalkToStalkRing_germ]
  exact d.stalkHom_germ ⟨p, hd⟩ f

private theorem ker_tau_le (x : ComplexPoints sX) :
    RingHom.ker (tau i hi x) ≤ (RingHom.ker (i.stalkMap x.toScheme).hom).map
      ((analytificationHom sP).hom.stalkMap (realize i hi x)).hom := by
  intro b hb
  obtain ⟨d, hd⟩ : ∃ d : Chart sP, realize i hi x ∈ chart (sX := sP) d.U := ⟨_, mem_chartAt _⟩
  have hx : x ∈ chart (sX := sX) (Chart.comapClosedImmersion i hi d).U :=
    (mem_chart_preimage_iff i hi).2 hd
  let eP := RingEquiv.ofBijective (d.stalkToStalkRing (realize i hi x) hd).hom
    ⟨Chart.injective_stalkToStalkRing d _ hd, Chart.surjective_stalkToStalkRing d _ hd⟩
  have hx0 : i x.toScheme ∈ d.U := mem_chart_iff.1 hd
  have hK := ker_stalkMap_eq_map_ker_app i d.isAffineOpen x.toScheme hx0
  have h1 : eP b ∈ RingHom.ker (restrictStalkRing i hi d (d.coords ⟨realize i hi x, hd⟩)) := by
    rw [RingHom.mem_ker]
    have := tau_stalkToStalkRing i hi x d hx b
    rw [(RingHom.mem_ker).1 hb, map_zero] at this
    exact this.symm
  have hmk : (Ideal.Quotient.mk (d.ideal.map (polyGermHom (d.coords ⟨realize i hi x, hd⟩)))).comp
      (polyGermHom _) = (d.toStalkRing _).comp d.pres :=
    RingHom.ext fun q => (d.toStalkRing_pres _ q).symm
  have hker : RingHom.ker (restrictStalkRing i hi d (d.coords ⟨realize i hi x, hd⟩)) =
      ((Chart.comapClosedImmersion i hi d).ideal.map (polyGermHom _)).map
        (Ideal.Quotient.mk (d.ideal.map (polyGermHom (d.coords ⟨realize i hi x, hd⟩)))) :=
    Ideal.Quotient.factor_ker _
  rw [hker, Chart.comapClosedImmersion_ideal, Ideal.map_map, hmk] at h1
  have hI : Ideal.map ((d.toStalkRing (d.coords ⟨realize i hi x, hd⟩)).comp d.pres)
      ((RingHom.ker (i.app d.U).hom).comap d.pres) =
      (RingHom.ker (i.app d.U).hom).map (d.toStalkRing (d.coords ⟨realize i hi x, hd⟩)) := by
    rw [← Ideal.map_map, Ideal.map_comap_of_surjective d.pres d.surjective]
  replace h1 := hI ▸ h1
  let φP : P.presheaf.stalk (i x.toScheme) →+* (analytification sP).presheaf.stalk
      (realize i hi x) := ((analytificationHom sP).hom.stalkMap (realize i hi x)).hom
  let germP : Γ(P, d.U) →+* P.presheaf.stalk (i x.toScheme) :=
    (P.presheaf.germ d.U (i x.toScheme) hx0).hom
  let eP' : (analytification sP).presheaf.stalk (realize i hi x) →+*
      d.StalkRing (d.coords ⟨realize i hi x, hd⟩) := eP
  have hcomp : d.toStalkRing (d.coords ⟨realize i hi x, hd⟩) = (eP'.comp φP).comp germP :=
    RingHom.ext fun f => (stalkToStalkRing_stalkMap d (realize i hi x) hd f).symm
  have h2 : (RingHom.ker (i.app d.U).hom).map (d.toStalkRing (d.coords ⟨realize i hi x, hd⟩)) =
      ((RingHom.ker (i.stalkMap x.toScheme).hom).map φP).map eP' := by
    rw [hK, Ideal.map_map, Ideal.map_map, ← hcomp]
  rw [h2] at h1
  have h3 : b ∈ (RingHom.ker (i.stalkMap x.toScheme).hom).map φP := by
    rw [← Ideal.comap_map_of_bijective (f := eP') eP.bijective
      (I := (RingHom.ker (i.stalkMap x.toScheme).hom).map φP)]
    exact h1
  exact h3

private theorem tau_stalkMap (x : ComplexPoints sX) (a : P.presheaf.stalk (i x.toScheme)) :
    tau i hi x (((analytificationHom sP).hom.stalkMap (realize i hi x)).hom a) =
      ((analytificationHom sX).hom.stalkMap x).hom ((i.stalkMap x.toScheme).hom a) := by
  obtain ⟨V, hV, f, rfl⟩ := P.presheaf.exists_germ_eq a
  have e1 : ((analytificationHom sP).hom.stalkMap (realize i hi x)).hom
      (P.presheaf.germ V (i x.toScheme) hV f) =
      (analytification sP).presheaf.germ ((Opens.map (toSchemeHom sP)).obj V) (realize i hi x) hV
        (sharpHom V f) :=
    stalkMap_germ_apply (realize i hi x) V hV f
  rw [e1, Scheme.Hom.germ_stalkMap_apply, stalkMap_germ_apply x (i ⁻¹ᵁ V) hV]
  refine (tau_germ i hi x ((Opens.map (toSchemeHom sP)).obj V) hV (sharpHom V f)).trans ?_
  haveI : (Opens.map (analyticMap i hi)).IsContinuous (Opens.grothendieckTopology (space sP))
      (Opens.grothendieckTopology (space sX)) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreserving_opens_map _)
      (coverPreserving_opens_map _)
  exact congrArg _ (theta_app_ringCatSheafHom i hi V f)

end Tau

section IsoStalk

open scoped ChangeOfRings

variable {X P : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {sP : P ⟶ Spec (.of ℂ)}
  (i : X ⟶ P) [IsClosedImmersion i] (hi : i ≫ sP = sX)
  [LocallyOfFiniteType sX] [LocallyOfFiniteType sP]

/-- A `ℂ`-point of `P` lying over a point of `X` is the image of a `ℂ`-point of `X`. -/
private theorem mem_range_realize_of (p : ComplexPoints sP) (z : X) (h : p.toScheme = i z) :
    p ∈ Set.range (realize i hi) := by
  have hcl : IsClosed ({z} : Set X) := by
    have : ({z} : Set X) = i.base ⁻¹' {p.toScheme} := by
      ext w
      simp only [Set.mem_singleton_iff, Set.mem_preimage, h]
      exact ⟨fun hw => hw ▸ rfl, fun hw => i.isClosedEmbedding.injective hw⟩
    rw [this]
    exact (ComplexPoints.isClosed_singleton_toScheme p).preimage i.base.hom.continuous
  obtain ⟨x, hx⟩ : z ∈ Set.range (ComplexPoints.toScheme (sX := sX)) := by
    rwa [ComplexPoints.range_toScheme]
  refine ⟨x, ComplexPoints.toScheme_injective (sX := sP) ?_⟩
  change i x.toScheme = p.toScheme
  rw [hx, h]

variable [(Opens.map (analyticMap i hi)).IsContinuous (Opens.grothendieckTopology (space sP))
    (Opens.grothendieckTopology (space sX))] [QuasiCompact sX] [QuasiCompact sP]

open MMP.ModuleSkyscraper in
private theorem bijective_stalk_moduleHom (F : X.Modules) (x : ComplexPoints sX) :
    Function.Bijective ((sheafStalkFunctor (structureSheaf sP) (realize i hi x)).map
      (moduleHom i hi F)) := by
  let A := TopCat.Presheaf.stalk (C := CommRingCat.{0}) P.sheaf.obj
    (toSchemeHom sP (realize i hi x))
  let A' := TopCat.Presheaf.stalk (C := CommRingCat.{0}) X.sheaf.obj (toSchemeHom sX x)
  let ψP : A →+* (analytification sP).presheaf.stalk
      (realize i hi x) := ((analytificationHom sP).hom.stalkMap (realize i hi x)).hom
  let ψX : A' →+* (analytification sX).presheaf.stalk x :=
    ((analytificationHom sX).hom.stalkMap x).hom
  let ρ : A →+* A' := (i.stalkMap x.toScheme).hom
  let isoP := (stalkIso (toSchemeHom sP) (ringCatSheafHom sP) (realize i hi x) ψP
    (stalkMap_germ_ringCatSheafHom (realize i hi x))
    (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sP))).app
      ((Scheme.Modules.pushforward i).obj F)
  let isoX := (stalkIso (toSchemeHom sX) (ringCatSheafHom sX) x ψX
    (stalkMap_germ_ringCatSheafHom x)
    (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX))).app F
  let M' := (sheafStalkFunctor P.sheaf (toSchemeHom sP (realize i hi x))).obj
    ((Scheme.Modules.pushforward i).obj F)
  let M := (sheafStalkFunctor X.sheaf (toSchemeHom sX x)).obj F
  let eF := TopCat.Presheaf.stalkPushforward AddCommGrpCat.{0} i.base F.val.presheaf x.toScheme
  have heF : IsIso eF := TopCat.Presheaf.stalkPushforward.stalkPushforward_iso_of_isInducing _
    i.isClosedEmbedding.isInducing _ _
  let e : M' ≃+ M := AddEquiv.ofBijective eF.hom (ConcreteCategory.bijective_of_isIso eF)
  have he : ∀ (a : A) (m : M'), e (a • m) = ρ a • e m := fun a m =>
    stalkPushforward_smul i.base i.toRingCatSheafHom x.toScheme ρ
      (fun V hx r => Scheme.Hom.germ_stalkMap_apply i V x.toScheme hx r) F a m
  let SP := TopCat.Presheaf.stalkPushforward AddCommGrpCat.{0} (analyticMap i hi)
    ((analytifyModule sX).obj F).val.presheaf x
  have hSP : IsIso SP := TopCat.Presheaf.stalkPushforward.stalkPushforward_iso_of_isInducing _
    (ComplexPoints.isClosedEmbedding_realize i hi).isInducing _ _
  let f₁ := (sheafStalkFunctor (structureSheaf sP) (realize i hi x)).map (moduleHom i hi F)
  let SPX : (sheafStalkFunctor (structureSheaf sP) (realize i hi x)).obj
      ((SheafOfModules.pushforward.{0} (theta i hi)).obj ((analytifyModule sX).obj F)) →+
      (sheafStalkFunctor (structureSheaf sX) x).obj ((analytifyModule sX).obj F) := SP.hom
  let Φ : (ModuleCat.extendScalars ψP).obj M' →+ (ModuleCat.extendScalars ψX).obj M :=
    isoX.inv.hom.toAddMonoidHom.comp (SPX.comp (f₁.hom.toAddMonoidHom.comp
      isoP.hom.hom.toAddMonoidHom))
  have hSPsmul : ∀ (b : (analytification sP).presheaf.stalk (realize i hi x))
      (w : (sheafStalkFunctor (structureSheaf sP) (realize i hi x)).obj
        ((SheafOfModules.pushforward.{0} (theta i hi)).obj ((analytifyModule sX).obj F))),
      SPX (b • w) = tau i hi x b • SPX w := fun b w =>
    stalkPushforward_smul (analyticMap i hi) (theta i hi) x (tau i hi x)
      (fun W hx r => tau_germ i hi x W hx r) ((analytifyModule sX).obj F) b w
  have hone : ∀ m : M', Φ ((1 : (analytification sP).presheaf.stalk (realize i hi x)) ⊗ₜ[_, ψP] m) =
      (1 : (analytification sX).presheaf.stalk x) ⊗ₜ[_, ψX] e m := by
    intro m
    obtain ⟨V, hV, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq
      ((Scheme.Modules.pushforward i).obj F).val.presheaf m
    have k1 := stalkIso_hom_app_one_tmul_germ (toSchemeHom sP) (ringCatSheafHom sP) (realize i hi x)
      ψP (stalkMap_germ_ringCatSheafHom (realize i hi x))
      (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sP))
      ((Scheme.Modules.pushforward i).obj F) V hV s
    have k2 := stalkIso_hom_app_one_tmul_germ (toSchemeHom sX) (ringCatSheafHom sX) x
      ψX (stalkMap_germ_ringCatSheafHom x)
      (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX)) F (i ⁻¹ᵁ V) hV s
    have s1 := congrArg (fun z => isoX.inv.hom (SPX (f₁.hom z))) k1
    have s2 := congrArg (fun z => isoX.inv.hom (SPX z))
      (Stacks.Modules.stalkLinearMap_germ (moduleHom i hi F).val
        ((Opens.map (toSchemeHom sP)).obj V) hV
        ((analytifyModuleUnit sP ((Scheme.Modules.pushforward i).obj F)).val.app (op V) s))
    have s3 := congrArg (fun z => isoX.inv.hom (SPX (TopCat.Presheaf.germ
      ((SheafOfModules.pushforward.{0} (theta i hi)).obj ((analytifyModule sX).obj F)).val.presheaf
      ((Opens.map (toSchemeHom sP)).obj V) (realize i hi x) hV z))) (moduleHom_app_unit i hi F V s)
    have s4 := congrArg isoX.inv.hom (TopCat.Presheaf.stalkPushforward_germ_apply AddCommGrpCat.{0}
      (analyticMap i hi)
      ((analytifyModule sX).obj F).val.presheaf ((Opens.map (toSchemeHom sP)).obj V) x hV
      ((analytifyModuleUnit sX F).val.app (op (i ⁻¹ᵁ V)) s))
    have s5 := (congrArg isoX.inv.hom k2).symm.trans (isoX.hom_inv_id_apply _)
    have s6 := TopCat.Presheaf.stalkPushforward_germ_apply AddCommGrpCat.{0} i.base F.val.presheaf V
      x.toScheme hV s
    refine s1.trans (s2.trans (s3.trans (s4.trans (s5.trans ?_))))
    exact congrArg _ s6.symm
  have hΦ : ∀ (b : (analytification sP).presheaf.stalk (realize i hi x)) (m : M'),
      Φ (b ⊗ₜ[_, ψP] m) = tau i hi x b ⊗ₜ[_, ψX] e m := by
    have hlin : ∀ (b : (analytification sP).presheaf.stalk (realize i hi x))
        (z : (ModuleCat.extendScalars ψP).obj M'), Φ (b • z) = tau i hi x b • Φ z := by
      intro b z
      change isoX.inv.hom (SPX (f₁.hom (isoP.hom.hom (b • z)))) =
        tau i hi x b • isoX.inv.hom (SPX (f₁.hom (isoP.hom.hom z)))
      rw [LinearMap.map_smul]
      erw [(ModuleCat.Hom.hom f₁).map_smul]
      rw [hSPsmul]
      erw [(ModuleCat.Hom.hom isoX.inv).map_smul]
    intro b m
    have hb := ModuleCat.ExtendScalars.smul_tmul ψP (M := M') b 1 m
    rw [mul_one] at hb
    have hb' := ModuleCat.ExtendScalars.smul_tmul ψX (M := M) (tau i hi x b) 1 (e m)
    rw [mul_one] at hb'
    refine (congrArg Φ hb.symm).trans ((hlin b _).trans ?_)
    rw [hone]
    exact hb'
  have hbij : Function.Bijective Φ :=
    bijective_of_tmul ρ (i.stalkMap_surjective x.toScheme) ψP
      (tau i hi x) (tau_surjective i hi x) (ker_tau_le i hi x) ψX (tau_stalkMap i hi x) M' M e he
      Φ hΦ
  have hP : Function.Bijective isoP.hom.hom := ConcreteCategory.bijective_of_isIso isoP.hom
  have hX : Function.Bijective isoX.inv.hom := ConcreteCategory.bijective_of_isIso isoX.inv
  have hSP' : Function.Bijective SP.hom := ConcreteCategory.bijective_of_isIso SP
  have h1 : Function.Bijective (isoX.inv.hom ∘ SP.hom ∘ f₁.hom ∘ isoP.hom.hom) := hbij
  have h2 := (Function.Bijective.of_comp_iff (isoX.inv.hom ∘ SP.hom ∘ f₁.hom) hP).1 h1
  have h3 := (Function.Bijective.of_comp_iff' hX (SP.hom ∘ f₁.hom)).1 h2
  exact (Function.Bijective.of_comp_iff' hSP' f₁.hom).1 h3

open MMP.ModuleSkyscraper in
/-- The comparison `(i_* F)^an ⟶ i^an_* F^an` is an isomorphism: on the stalks at points of
`X(ℂ)` it is the base change of `F_x` along the quotient `𝒪_{P^an,i x} → 𝒪_{X^an,x}`, and off
`X(ℂ)` both stalks vanish. -/
private theorem isIso_moduleHom (F : X.Modules) : IsIso (moduleHom i hi F) := by
  have hx : ∀ p : ComplexPoints sP, IsIso ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{0} p).map
      ((SheafOfModules.toSheaf _).map (moduleHom i hi F)).hom) := by
    intro p
    rw [ConcreteCategory.isIso_iff_bijective]
    by_cases hp : p ∈ Set.range (realize i hi)
    · obtain ⟨x, rfl⟩ := hp
      exact bijective_stalk_moduleHom i hi F x
    · have hpX : p.toScheme ∉ Set.range i.base := by
        rintro ⟨z, hz⟩
        exact hp (mem_range_realize_of i hi p z hz.symm)
      have hM : Subsingleton ((sheafStalkFunctor P.sheaf (toSchemeHom sP p)).obj
          ((Scheme.Modules.pushforward i).obj F)) :=
        subsingleton_stalk_pushforward i.base i.isClosedEmbedding.isClosed_range
          ((SheafOfModules.toSheaf _).obj F) p.toScheme hpX
      let ψP := ((analytificationHom sP).hom.stalkMap p).hom
      let isoP := (stalkIso (toSchemeHom sP) (ringCatSheafHom sP) p ψP
        (stalkMap_germ_ringCatSheafHom p)
        (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sP))).app
          ((Scheme.Modules.pushforward i).obj F)
      have h₁ : Subsingleton ((sheafStalkFunctor P.sheaf (toSchemeHom sP p) ⋙
          ModuleCat.extendScalars ψP).obj ((Scheme.Modules.pushforward i).obj F)) :=
        show Subsingleton (TensorProduct _ _ _) from inferInstance
      have h₂ : Subsingleton ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{0} p).obj
          ((SheafOfModules.toSheaf _).obj
            ((analytifyModule sP).obj ((Scheme.Modules.pushforward i).obj F))).obj) :=
        (ConcreteCategory.bijective_of_isIso isoP.inv).1.subsingleton
      have h₃ : Subsingleton ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{0} p).obj
          ((SheafOfModules.toSheaf _).obj
            ((SheafOfModules.pushforward.{0} (theta i hi)).obj
              ((analytifyModule sX).obj F))).obj) :=
        subsingleton_stalk_pushforward (analyticMap i hi)
          (ComplexPoints.isClosedEmbedding_realize i hi).isClosed_range
          ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F)) p hp
      exact ⟨fun a b _ => Subsingleton.elim a b, fun b => ⟨0, Subsingleton.elim _ _⟩⟩
  have : IsIso ((SheafOfModules.toSheaf _).map (moduleHom i hi F)) :=
    TopCat.Presheaf.isIso_of_stalkFunctor_map_iso _
  exact isIso_of_reflects_iso _ (SheafOfModules.toSheaf _)

/-- **Cohomology along a closed immersion.** Under the identifications
`H^q(P, i_* F) ≅ H^q(X, F)` and `H^q(P^an, (i_* F)^an) ≅ H^q(X^an, F^an)` (the latter through the
comparison `(i_* F)^an ≅ i^an_* F^an`), the comparison maps of `i_* F` and of `F` agree. Both
composites are pullbacks along `α_P ∘ i^an = i ∘ α_X`, induced by the same map
`i_* F ⟶ (i ∘ α_X)_* F^an`. -/
private theorem comparisonMap_pushforward (F : X.Modules) (q : ℤ) :
    IsIso (sheafCohomologyPullback i.base
        ((SheafOfModules.toSheaf _).obj ((Scheme.Modules.pushforward i).obj F)) q ≫
      (sheafCohomology X.toTopCat q).map
        ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} i.base).counit.app
          ((SheafOfModules.toSheaf _).obj F))) ∧
    IsIso (sheafCohomologyPullback (analyticMap i hi)
        ((SheafOfModules.toSheaf _).obj
          ((analytifyModule sP).obj ((Scheme.Modules.pushforward i).obj F))) q ≫
      (sheafCohomology (space sX) q).map
        (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} (analyticMap i hi)).homEquiv
          _ ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F))).symm
          ((SheafOfModules.toSheaf _).map (moduleHom i hi F)))) ∧
    comparisonMap sP ((Scheme.Modules.pushforward i).obj F) q ≫
        (sheafCohomologyPullback (analyticMap i hi) _ q ≫
          (sheafCohomology (space sX) q).map
            (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
              (analyticMap i hi)).homEquiv _
                ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F))).symm
              ((SheafOfModules.toSheaf _).map (moduleHom i hi F)))) =
      (sheafCohomologyPullback i.base _ q ≫
        (sheafCohomology X.toTopCat q).map
          ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} i.base).counit.app
            ((SheafOfModules.toSheaf _).obj F))) ≫ comparisonMap sX F q := by
  rcases lt_or_ge q 0 with hq | hq
  · have z := fun (T : TopCat.{0}) (G : TopCat.Sheaf AddCommGrpCat.{0} T) =>
      isZero_sheafCohomology_of_neg T G hq
    exact ⟨(z _ _).isIso (z _ _) _, (z _ _).isIso (z _ _) _, (z _ _).eq_of_src _ _⟩
  obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hq
  let B := (SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F)
  have hAlg := isIso_sheafCohomologyPullback_comp_counit i.base i.isClosedEmbedding
    ((SheafOfModules.toSheaf _).obj F) n
  have hAn : IsIso (sheafCohomologyPullback (ComplexPoints.analyticMap i hi) _ n ≫
      (sheafCohomology (space sX) n).map
        (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
          (ComplexPoints.analyticMap i hi)).homEquiv _ B).symm
          ((SheafOfModules.toSheaf _).map (moduleHom i hi F)))) := by
    have e1 : sheafCohomologyPullback (ComplexPoints.analyticMap i hi) _ n ≫
        (sheafCohomology (space sX) n).map
          (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
            (ComplexPoints.analyticMap i hi)).homEquiv _ B).symm
            ((SheafOfModules.toSheaf _).map (moduleHom i hi F))) =
        (sheafCohomology (space sP) n).map
        ((SheafOfModules.toSheaf _).map (moduleHom i hi F)) ≫
        (sheafCohomologyPullback (ComplexPoints.analyticMap i hi) _ n ≫
          (sheafCohomology (space sX) n).map
            ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
              (ComplexPoints.analyticMap i hi)).counit.app B)) := by
      refine (sheafCohomologyPullback _ _ _ ≫= ((congrArg (sheafCohomology (space sX) n).map
        (Adjunction.homEquiv_counit _ _ _ _)).trans (Functor.map_comp _ _ _))).trans ?_
      exact (sheafCohomology_map_comp_sheafCohomologyPullback_assoc _ _ _ _).symm
    have hc := isIso_sheafCohomologyPullback_comp_counit (ComplexPoints.analyticMap i hi)
      (ComplexPoints.isClosedEmbedding_realize i hi) B n
    have h0 := isIso_moduleHom i hi F
    rw [e1]
    exact IsIso.comp_isIso' (Iso.isIso_hom ((sheafCohomology (space sP) n).mapIso
      ((SheafOfModules.toSheaf _).mapIso (asIso (moduleHom i hi F))))) hc
  refine ⟨hAlg, hAn, ?_⟩
  let JG := injectiveResolution
    ((SheafOfModules.toSheaf _).obj ((Scheme.Modules.pushforward i).obj F))
  let JB := injectiveResolution B
  obtain ⟨g, hg⟩ := exists_hom_pushforward (B := B)
    (ComplexPoints.analyticMap i hi ≫ toSchemeHom sP)
    ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} (toSchemeHom sP)).unit.app
        ((SheafOfModules.toSheaf _).obj ((Scheme.Modules.pushforward i).obj F)) ≫
      (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (toSchemeHom sP)).map
        (analytifyModuleι sP ((Scheme.Modules.pushforward i).obj F) ≫
          (TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
            (ComplexPoints.analyticMap i hi)).unit.app _ ≫
          (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (ComplexPoints.analyticMap i hi)).map
            (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
              (ComplexPoints.analyticMap i hi)).homEquiv _ B).symm
              ((SheafOfModules.toSheaf _).map (moduleHom i hi F))))) JG JB
  have hL := sheafCohomologyPullback_comp_eq (toSchemeHom sP) (ComplexPoints.analyticMap i hi)
    (analytifyModuleι sP ((Scheme.Modules.pushforward i).obj F))
    (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
      (ComplexPoints.analyticMap i hi)).homEquiv _ B).symm
      ((SheafOfModules.toSheaf _).map (moduleHom i hi F))) JG JB g hg n
  have hR := sheafCohomologyPullback_comp_eq i.base (toSchemeHom sX)
    ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} i.base).counit.app
      ((SheafOfModules.toSheaf _).obj F))
    (analytifyModuleι sX F) JG JB g (hg.trans (unit_comp_pushforward_moduleHom i hi F =≫ _)) n
  refine (Iso.cancel_iso_hom_right _ _ ((sheafCohomologyIso (space sX) n).app B)).1 ?_
  exact ((Category.assoc _ _ _).trans hL).trans ((Category.assoc _ _ _).trans hR).symm

end IsoStalk

end ClosedImmersionPushforward

/-- Conjunct (3) of `MMP.Analytic.analytification_stalks`: the stalks of `F^an`. -/
private theorem analytification_stalks_stalkTensor {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType sX] [QuasiCompact sX] :
    ∀ (F : X.Modules) (y : ComplexPoints sX),
      let MF : PresheafOfModules ((structureSheaf sX).obj ⋙ forget₂ CommRingCat RingCat) :=
        ((analytifyModule sX).obj F).val
      let F' : PresheafOfModules (X.presheaf ⋙ forget₂ CommRingCat RingCat) := F.val
      letI : Algebra (X.presheaf.stalk y.toScheme) ((analytification sX).presheaf.stalk y) :=
        ((analytificationHom sX).hom.stalkMap y).hom.toAlgebra
      letI : Module ((analytification sX).presheaf.stalk y)
          ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := space sX) MF.presheaf y) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier MF y
      letI : Module (X.presheaf.stalk y.toScheme)
          ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf
            y.toScheme) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F' _
      ∃ e : ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := space sX) MF.presheaf y) ≃ₗ[
          (analytification sX).presheaf.stalk y]
          TensorProduct (X.presheaf.stalk y.toScheme) ((analytification sX).presheaf.stalk y)
            ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf
              y.toScheme),
        ∀ (V : X.Opens) (hy : y.toScheme ∈ V) (s : F.val.obj (op V)),
          e (TopCat.Presheaf.germ MF.presheaf ((Opens.map (toSchemeHom sX)).obj V) y hy
              ((analytifyModuleUnit sX F).val.app (op V) s)) =
            (1 : (analytification sX).presheaf.stalk y) ⊗ₜ
              TopCat.Presheaf.germ F'.presheaf V y.toScheme hy s := by
  intro F y
  dsimp only
  have hψ := stalkMap_germ_ringCatSheafHom y
  let iso := (MMP.ModuleSkyscraper.stalkIso (toSchemeHom sX) (ringCatSheafHom sX) y
    ((analytificationHom sX).hom.stalkMap y).hom hψ
    (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX))).app F
  refine ⟨iso.symm.toLinearEquiv, fun V hy s => ?_⟩
  have h := MMP.ModuleSkyscraper.stalkIso_hom_app_one_tmul_germ (toSchemeHom sX)
    (ringCatSheafHom sX) y ((analytificationHom sX).hom.stalkMap y).hom hψ
    (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX)) F V hy s
  refine (congrArg iso.symm.toLinearEquiv h.symm).trans ?_
  exact iso.toLinearEquiv.symm_apply_apply _

/-- Conjunct (3) of `MMP.Analytic.analytification_stalks`: analytification commutes with
tensor products. -/
private theorem analytification_stalks_tensor {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType sX] [QuasiCompact sX] :
    ∀ F G : X.Modules, ∃ e : (analytifyModule sX).obj
        (((Stacks.SheafOfModules.Tensor.sheafTensor X.sheaf).obj F).obj G) ≅
      ((Stacks.SheafOfModules.Tensor.sheafTensor (structureSheaf sX)).obj
        ((analytifyModule sX).obj F)).obj ((analytifyModule sX).obj G),
      ∀ (V : X.Opens) (s : F.val.obj (op V)) (t : G.val.obj (op V)),
        PresheafOfModules.Hom.app e.hom.val (op ((Opens.map (toSchemeHom sX)).obj V))
          (PresheafOfModules.Hom.app (analytifyModuleUnit sX
              (((Stacks.SheafOfModules.Tensor.sheafTensor X.sheaf).obj F).obj G)).val (op V)
            (PresheafOfModules.Hom.app ((PresheafOfModules.sheafificationAdjunction
              (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)).unit.app
              (PresheafOfModules.tensorObj (O := X.presheaf) F.val G.val)) (op V) (s ⊗ₜ t))) =
        PresheafOfModules.Hom.app ((PresheafOfModules.sheafificationAdjunction
            (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf (structureSheaf sX)).obj)).unit.app
            (PresheafOfModules.tensorObj (O := (structureSheaf sX).obj)
              ((analytifyModule sX).obj F).val ((analytifyModule sX).obj G).val))
          (op ((Opens.map (toSchemeHom sX)).obj V))
          (PresheafOfModules.Hom.app (analytifyModuleUnit sX F).val (op V) s ⊗ₜ
            PresheafOfModules.Hom.app (analytifyModuleUnit sX G).val (op V) t) := by
  intro F G
  have hiso := Stacks.PullbackTensorIso.isIso_comparison (analytificationHom sX) F G
  refine ⟨@asIso _ _ _ _ (Stacks.RingedSpace.comparison (analytificationHom sX) F G) hiso,
    fun V s t => ?_⟩
  have h := Stacks.RingedSpace.comparison_homEquiv_unit_tmul (analytificationHom sX) F G (op V)
    s t
  refine Eq.trans ?_ h
  exact (Stacks.RingedSpace.homEquiv_val_app (analytificationHom sX) _ _ _ (op V) _).symm

/-- Conjunct (4) of `MMP.Analytic.analytification_stalks`: the comparison maps commute with
the connecting maps and are the unique morphism of δ-functors extending `c^0`. -/
private theorem analytification_stalks_delta {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType sX] [QuasiCompact sX] :
    haveI : (analytifyModule sX).IsLeftAdjoint :=
      (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX)).isLeftAdjoint
    let tot : ∀ {T : TopCat.{0}}, ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} T) →
        ShortComplex (CochainComplex AddCommGrpCat.{0} ℤ) := fun {T} S =>
      ShortComplex.mk
        ((HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
          (c₁₂ := ComplexShape.up ℤ)).map (((godementSections T).mapHomologicalComplex _).map
            ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map S.f)))
        ((HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
          (c₁₂ := ComplexShape.up ℤ)).map (((godementSections T).mapHomologicalComplex _).map
            ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map S.g)))
        (by
          rw [← Functor.map_comp, ← Functor.map_comp, ← Functor.map_comp, S.zero,
            Functor.map_zero, Functor.map_zero]
          ext n : 1
          exact HomologicalComplex₂.total.hom_ext _ fun _ _ _ => by
            simp <;> exact Limits.comp_zero.trans Limits.comp_zero.symm);
    let toAb : ∀ {T : TopCat.{0}} {R : Sheaf (Opens.grothendieckTopology T) RingCat.{0}},
        ShortComplex (SheafOfModules.{0} R) →
          ShortComplex (Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{0}) :=
      fun {T} {R} S => S.map (SheafOfModules.toSheaf R);
      (∀ S : ShortComplex X.Modules, S.ShortExact →
        ∃ (hS : (tot (toAb S)).ShortExact)
          (hS' : (tot (toAb (S.map (analytifyModule sX)))).ShortExact),
          ∀ q : ℤ, hS.δ q (q + 1) rfl ≫ comparisonMap sX S.X₁ (q + 1) =
            comparisonMap sX S.X₃ q ≫ hS'.δ q (q + 1) rfl) ∧
      ∀ η : ∀ q : ℕ, SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafCohomology _ q ⟶
          analytifyModule sX ⋙ SheafOfModules.toSheaf _ ⋙ sheafCohomology (space sX) q,
        (∀ (S : ShortComplex X.Modules), S.ShortExact → ∀ (q : ℕ)
          (hS : (tot (toAb S)).ShortExact)
          (hS' : (tot (toAb (S.map (analytifyModule sX)))).ShortExact),
          hS.δ (q : ℤ) ((q + 1 : ℕ) : ℤ) (by simp) ≫ (η (q + 1)).app S.X₁ =
            (η q).app S.X₃ ≫ hS'.δ (q : ℤ) ((q + 1 : ℕ) : ℤ) (by simp)) →
        (∀ F : X.Modules, (η 0).app F = comparisonMap sX F 0) →
        ∀ (q : ℕ) (F : X.Modules), (η q).app F = comparisonMap sX F q := by
  have := preservesFiniteLimits_analytifyModule (sX := sX)
  intro tot toAb
  exact ⟨fun S hS => comparisonMap_δ sX S hS, fun η hη h0 => comparisonMap_unique sX η hη h0⟩

/-- Conjunct (5) of `MMP.Analytic.analytification_stalks`: analytification along a closed
immersion. -/
private theorem analytification_stalks_closedImmersion {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType sX] [QuasiCompact sX] :
    ∀ {P : Scheme.{0}} (sP : P ⟶ Spec (.of ℂ)) [LocallyOfFiniteType sP] [QuasiCompact sP]
      (i : X ⟶ P) [IsClosedImmersion i]
      (hi : i ≫ sP = sX),
      IsClosedEmbedding (ComplexPoints.realize i hi) ∧
      (∀ y : ComplexPoints sX,
        ∃ e : (analytification sP).presheaf.stalk (ComplexPoints.realize i hi y) ⧸
            (RingHom.ker (i.stalkMap y.toScheme).hom).map
              ((analytificationHom sP).hom.stalkMap (ComplexPoints.realize i hi y)).hom ≃+*
            (analytification sX).presheaf.stalk y,
          ∀ a, e (Ideal.Quotient.mk _
              (((analytificationHom sP).hom.stalkMap (ComplexPoints.realize i hi y)).hom a)) =
            ((analytificationHom sX).hom.stalkMap y).hom ((i.stalkMap y.toScheme).hom a)) ∧
      haveI : (Opens.map (ComplexPoints.analyticMap i hi)).IsContinuous
          (Opens.grothendieckTopology (space sP)) (Opens.grothendieckTopology (space sX)) :=
        Functor.isContinuous_of_coverPreserving (compatiblePreserving_opens_map _)
          (coverPreserving_opens_map _)
      ∃ θ : ringCatSheaf sP ⟶
          ((Opens.map (ComplexPoints.analyticMap i hi)).sheafPushforwardContinuous
          RingCat.{0} (Opens.grothendieckTopology (space sP))
          (Opens.grothendieckTopology (space sX))).obj (ringCatSheaf sX),
        (∀ (V : P.Opens) (f : Γ(P, V)),
          θ.hom.app (op ((Opens.map (toSchemeHom sP)).obj V))
              ((ringCatSheafHom sP).hom.app (op V) f) =
            (ringCatSheafHom sX).hom.app (op (i ⁻¹ᵁ V)) (i.app V f)) ∧
        ∀ F : X.Modules,
          ∃ e : (analytifyModule sP).obj ((Scheme.Modules.pushforward i).obj F) ≅
              (SheafOfModules.pushforward.{0} θ).obj ((analytifyModule sX).obj F),
            (∀ (V : P.Opens) (s : F.val.obj (op (i ⁻¹ᵁ V))),
              e.hom.val.app (op ((Opens.map (toSchemeHom sP)).obj V))
                  ((analytifyModuleUnit sP ((Scheme.Modules.pushforward i).obj F)).val.app
                    (op V) s) =
                (analytifyModuleUnit sX F).val.app (op (i ⁻¹ᵁ V)) s) ∧
            ∀ q : ℤ,
              let resAlg : (sheafCohomology _ q).obj ((SheafOfModules.toSheaf _).obj
                  ((Scheme.Modules.pushforward i).obj F)) ⟶
                  (sheafCohomology _ q).obj ((SheafOfModules.toSheaf _).obj F) :=
                sheafCohomologyPullback i.base _ q ≫ (sheafCohomology _ q).map
                  ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} i.base).counit.app
                    ((SheafOfModules.toSheaf _).obj F))
              let resAn : (sheafCohomology (space sP) q).obj ((SheafOfModules.toSheaf _).obj
                  ((analytifyModule sP).obj ((Scheme.Modules.pushforward i).obj F))) ⟶
                  (sheafCohomology (space sX) q).obj
                    ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F)) :=
                sheafCohomologyPullback (ComplexPoints.analyticMap i hi) _ q ≫
                  (sheafCohomology (space sX) q).map
                    (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
                      (ComplexPoints.analyticMap i hi)).homEquiv _ _).symm
                      ((SheafOfModules.toSheaf _).map e.hom))
              IsIso resAlg ∧ IsIso resAn ∧
                comparisonMap sP ((Scheme.Modules.pushforward i).obj F) q ≫ resAn =
                  resAlg ≫ comparisonMap sX F q := by
  intro P sP _ _ i _ hi
  refine ⟨ComplexPoints.isClosedEmbedding_realize i hi, ?closedImmersionStalk,
    ?closedImmersionPushforward⟩
  case closedImmersionStalk => exact exists_stalk_ringEquiv_quotient_of_isClosedImmersion i hi
  case closedImmersionPushforward =>
    have : (Opens.map (ComplexPoints.analyticMap i hi)).IsContinuous
        (Opens.grothendieckTopology (space sP)) (Opens.grothendieckTopology (space sX)) :=
      Functor.isContinuous_of_coverPreserving (compatiblePreserving_opens_map _)
        (coverPreserving_opens_map _)
    refine ⟨theta i hi, theta_app_ringCatSheafHom i hi, fun F => ?_⟩
    have := isIso_moduleHom i hi F
    refine ⟨asIso (moduleHom i hi F), moduleHom_app_unit i hi F, fun q => ?_⟩
    exact comparisonMap_pushforward i hi F q

@[expose] public section

/-- **Stalks of the analytification.** Let `X` be of finite type over `ℂ`, `y ∈ X^an` and
`φ : 𝒪_{X,y} → 𝒪_{X^an,y}` the stalk map of `MMP.Analytic.analytificationHom`.
(1) `α_X` is continuous and identifies `X^an` with the closed points of `X`, and for every chart
`c` containing `y`, `𝒪_{X^an,y} ≅ ℂ{z - p}/I` compatibly with `MMP.Analytic.Chart.toStalkRing`;
(2) `φ` is local, faithfully flat and induces isomorphisms on all `𝔪^N`-jets;
(3) `(F^an)_y ≅ 𝒪_{X^an,y} ⊗_{𝒪_{X,y}} F_y` compatibly with `s ↦ 1 ⊗ s`;
`MMP.Analytic.analytifyModule` is exact, commutes with tensor products and preserves
invertible sheaves, and a finite type module `F` with `F^an = 0` is zero;
(4) `MMP.Analytic.comparisonMap` is natural for every compatible pair `(φ, ψ)`, commutes with
connecting maps, and is the unique morphism of δ-functors on `𝒪_X`-modules extending `c^0`;
(5) for a closed immersion `i : X → P` into `P` of finite type over `ℂ`, `i^an` is a closed
embedding, `𝒪_{X^an,y} ≅ 𝒪_{P^an,i y}/ℐ_{i y} 𝒪_{P^an, i y}`, `i^an` carries a comparison
`θ : 𝒪_{P^an} ⟶ i^an_* 𝒪_{X^an}` extending `i^#`, the adjunction map
`(i_* F)^an ⟶ i^an_* F^an` is an isomorphism, and the comparison maps of `i_* F` and `F` agree
under `H^q(P, i_* F) ≅ H^q(X, F)` and `H^q(P^an, (i_* F)^an) ≅ H^q(X^an, F^an)`. -/
@[mmp "lem_mmp_gaga_analytification_stalks"]
public theorem analytification_stalks {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType sX] [QuasiCompact sX] :
    -- (1)
    (Continuous (ComplexPoints.toScheme (sX := sX)) ∧
      Function.Injective (ComplexPoints.toScheme (sX := sX)) ∧
      Set.range (ComplexPoints.toScheme (sX := sX)) = {x : X | IsClosed {x}} ∧
      ∀ (y : ComplexPoints sX) (c : Chart sX) (hy : y ∈ ComplexPoints.chart (sX := sX) c.U),
        ∃ e : (analytification sX).presheaf.stalk y ≃+* c.StalkRing (c.coords ⟨y, hy⟩),
          ∀ f : Γ(X, c.U),
            e (((analytificationHom sX).hom.stalkMap y).hom
                (X.presheaf.germ c.U y.toScheme (ComplexPoints.mem_chart_iff.1 hy) f)) =
              c.toStalkRing (c.coords ⟨y, hy⟩) f) ∧
    -- (2)
    (∀ y : ComplexPoints sX,
      let φ : X.presheaf.stalk y.toScheme →+* (analytification sX).presheaf.stalk y :=
        ((analytificationHom sX).hom.stalkMap y).hom
      IsLocalHom φ ∧ φ.FaithfullyFlat ∧
        ∀ N : ℕ, ∃ e : X.presheaf.stalk y.toScheme ⧸ maximalIdeal _ ^ N ≃+*
            (analytification sX).presheaf.stalk y ⧸ maximalIdeal _ ^ N,
          ∀ a, e (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (φ a)) ∧
    -- (3)
    (∀ (F : X.Modules) (y : ComplexPoints sX),
      let MF : PresheafOfModules ((structureSheaf sX).obj ⋙ forget₂ CommRingCat RingCat) :=
        ((analytifyModule sX).obj F).val
      let F' : PresheafOfModules (X.presheaf ⋙ forget₂ CommRingCat RingCat) := F.val
      letI : Algebra (X.presheaf.stalk y.toScheme) ((analytification sX).presheaf.stalk y) :=
        ((analytificationHom sX).hom.stalkMap y).hom.toAlgebra
      letI : Module ((analytification sX).presheaf.stalk y)
          ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := space sX) MF.presheaf y) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier MF y
      letI : Module (X.presheaf.stalk y.toScheme)
          ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf
            y.toScheme) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F' _
      ∃ e : ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := space sX) MF.presheaf y) ≃ₗ[
          (analytification sX).presheaf.stalk y]
          TensorProduct (X.presheaf.stalk y.toScheme) ((analytification sX).presheaf.stalk y)
            ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf
              y.toScheme),
        ∀ (V : X.Opens) (hy : y.toScheme ∈ V) (s : F.val.obj (op V)),
          e (TopCat.Presheaf.germ MF.presheaf ((Opens.map (toSchemeHom sX)).obj V) y hy
              ((analytifyModuleUnit sX F).val.app (op V) s)) =
            (1 : (analytification sX).presheaf.stalk y) ⊗ₜ
              TopCat.Presheaf.germ F'.presheaf V y.toScheme hy s) ∧
    Limits.PreservesFiniteLimits (analytifyModule sX) ∧
    Limits.PreservesFiniteColimits (analytifyModule sX) ∧
    (∀ F G : X.Modules, ∃ e : (analytifyModule sX).obj
        (((Stacks.SheafOfModules.Tensor.sheafTensor X.sheaf).obj F).obj G) ≅
      ((Stacks.SheafOfModules.Tensor.sheafTensor (structureSheaf sX)).obj
        ((analytifyModule sX).obj F)).obj ((analytifyModule sX).obj G),
      ∀ (V : X.Opens) (s : F.val.obj (op V)) (t : G.val.obj (op V)),
        PresheafOfModules.Hom.app e.hom.val (op ((Opens.map (toSchemeHom sX)).obj V))
          (PresheafOfModules.Hom.app (analytifyModuleUnit sX
              (((Stacks.SheafOfModules.Tensor.sheafTensor X.sheaf).obj F).obj G)).val (op V)
            (PresheafOfModules.Hom.app ((PresheafOfModules.sheafificationAdjunction
              (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)).unit.app
              (PresheafOfModules.tensorObj (O := X.presheaf) F.val G.val)) (op V) (s ⊗ₜ t))) =
        PresheafOfModules.Hom.app ((PresheafOfModules.sheafificationAdjunction
            (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf (structureSheaf sX)).obj)).unit.app
            (PresheafOfModules.tensorObj (O := (structureSheaf sX).obj)
              ((analytifyModule sX).obj F).val ((analytifyModule sX).obj G).val))
          (op ((Opens.map (toSchemeHom sX)).obj V))
          (PresheafOfModules.Hom.app (analytifyModuleUnit sX F).val (op V) s ⊗ₜ
            PresheafOfModules.Hom.app (analytifyModuleUnit sX G).val (op V) t)) ∧
    (∀ L : X.Modules,
      (∀ x : X, ∃ U : X.Opens, x ∈ U ∧ Nonempty (L.over U ≅ SheafOfModules.unit _)) →
      ∀ y : ComplexPoints sX, ∃ W : Opens (space sX), y ∈ W ∧
        Nonempty (((analytifyModule sX).obj L).over W ≅ SheafOfModules.unit _)) ∧
    (∀ F : X.Modules, SheafOfModules.IsFiniteType.{0} F →
      Limits.IsZero ((analytifyModule sX).obj F) → Limits.IsZero F) ∧
    -- (4)
    (∀ (F G : X.Modules) (φ : (SheafOfModules.toSheaf _).obj F ⟶ (SheafOfModules.toSheaf _).obj G)
      (ψ : (SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F) ⟶
        (SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj G)),
      analytifyModuleι sX F ≫ ψ =
          (TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom sX)).map φ ≫ analytifyModuleι sX G →
        ∀ q : ℤ, comparisonMap sX F q ≫ (sheafCohomology (space sX) q).map ψ =
          (sheafCohomology _ q).map φ ≫ comparisonMap sX G q) ∧
    (haveI : (analytifyModule sX).IsLeftAdjoint :=
      (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX)).isLeftAdjoint
    let tot : ∀ {T : TopCat.{0}}, ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} T) →
        ShortComplex (CochainComplex AddCommGrpCat.{0} ℤ) := fun {T} S =>
      ShortComplex.mk
        ((HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
          (c₁₂ := ComplexShape.up ℤ)).map (((godementSections T).mapHomologicalComplex _).map
            ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map S.f)))
        ((HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
          (c₁₂ := ComplexShape.up ℤ)).map (((godementSections T).mapHomologicalComplex _).map
            ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map S.g)))
        (by
          rw [← Functor.map_comp, ← Functor.map_comp, ← Functor.map_comp, S.zero,
            Functor.map_zero, Functor.map_zero]
          ext n : 1
          exact HomologicalComplex₂.total.hom_ext _ fun _ _ _ => by
            simp <;> exact Limits.comp_zero.trans Limits.comp_zero.symm);
    let toAb : ∀ {T : TopCat.{0}} {R : Sheaf (Opens.grothendieckTopology T) RingCat.{0}},
        ShortComplex (SheafOfModules.{0} R) →
          ShortComplex (Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{0}) :=
      fun {T} {R} S => S.map (SheafOfModules.toSheaf R);
      (∀ S : ShortComplex X.Modules, S.ShortExact →
        ∃ (hS : (tot (toAb S)).ShortExact)
          (hS' : (tot (toAb (S.map (analytifyModule sX)))).ShortExact),
          ∀ q : ℤ, hS.δ q (q + 1) rfl ≫ comparisonMap sX S.X₁ (q + 1) =
            comparisonMap sX S.X₃ q ≫ hS'.δ q (q + 1) rfl) ∧
      ∀ η : ∀ q : ℕ, SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafCohomology _ q ⟶
          analytifyModule sX ⋙ SheafOfModules.toSheaf _ ⋙ sheafCohomology (space sX) q,
        (∀ (S : ShortComplex X.Modules), S.ShortExact → ∀ (q : ℕ)
          (hS : (tot (toAb S)).ShortExact)
          (hS' : (tot (toAb (S.map (analytifyModule sX)))).ShortExact),
          hS.δ (q : ℤ) ((q + 1 : ℕ) : ℤ) (by simp) ≫ (η (q + 1)).app S.X₁ =
            (η q).app S.X₃ ≫ hS'.δ (q : ℤ) ((q + 1 : ℕ) : ℤ) (by simp)) →
        (∀ F : X.Modules, (η 0).app F = comparisonMap sX F 0) →
        ∀ (q : ℕ) (F : X.Modules), (η q).app F = comparisonMap sX F q) ∧
    -- (5)
    ∀ {P : Scheme.{0}} (sP : P ⟶ Spec (.of ℂ)) [LocallyOfFiniteType sP] [QuasiCompact sP]
      (i : X ⟶ P) [IsClosedImmersion i]
      (hi : i ≫ sP = sX),
      IsClosedEmbedding (ComplexPoints.realize i hi) ∧
      (∀ y : ComplexPoints sX,
        ∃ e : (analytification sP).presheaf.stalk (ComplexPoints.realize i hi y) ⧸
            (RingHom.ker (i.stalkMap y.toScheme).hom).map
              ((analytificationHom sP).hom.stalkMap (ComplexPoints.realize i hi y)).hom ≃+*
            (analytification sX).presheaf.stalk y,
          ∀ a, e (Ideal.Quotient.mk _
              (((analytificationHom sP).hom.stalkMap (ComplexPoints.realize i hi y)).hom a)) =
            ((analytificationHom sX).hom.stalkMap y).hom ((i.stalkMap y.toScheme).hom a)) ∧
      haveI : (Opens.map (ComplexPoints.analyticMap i hi)).IsContinuous
          (Opens.grothendieckTopology (space sP)) (Opens.grothendieckTopology (space sX)) :=
        Functor.isContinuous_of_coverPreserving (compatiblePreserving_opens_map _)
          (coverPreserving_opens_map _)
      ∃ θ : ringCatSheaf sP ⟶
          ((Opens.map (ComplexPoints.analyticMap i hi)).sheafPushforwardContinuous
          RingCat.{0} (Opens.grothendieckTopology (space sP))
          (Opens.grothendieckTopology (space sX))).obj (ringCatSheaf sX),
        (∀ (V : P.Opens) (f : Γ(P, V)),
          θ.hom.app (op ((Opens.map (toSchemeHom sP)).obj V))
              ((ringCatSheafHom sP).hom.app (op V) f) =
            (ringCatSheafHom sX).hom.app (op (i ⁻¹ᵁ V)) (i.app V f)) ∧
        ∀ F : X.Modules,
          ∃ e : (analytifyModule sP).obj ((Scheme.Modules.pushforward i).obj F) ≅
              (SheafOfModules.pushforward.{0} θ).obj ((analytifyModule sX).obj F),
            (∀ (V : P.Opens) (s : F.val.obj (op (i ⁻¹ᵁ V))),
              e.hom.val.app (op ((Opens.map (toSchemeHom sP)).obj V))
                  ((analytifyModuleUnit sP ((Scheme.Modules.pushforward i).obj F)).val.app
                    (op V) s) =
                (analytifyModuleUnit sX F).val.app (op (i ⁻¹ᵁ V)) s) ∧
            ∀ q : ℤ,
              let resAlg : (sheafCohomology _ q).obj ((SheafOfModules.toSheaf _).obj
                  ((Scheme.Modules.pushforward i).obj F)) ⟶
                  (sheafCohomology _ q).obj ((SheafOfModules.toSheaf _).obj F) :=
                sheafCohomologyPullback i.base _ q ≫ (sheafCohomology _ q).map
                  ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} i.base).counit.app
                    ((SheafOfModules.toSheaf _).obj F))
              let resAn : (sheafCohomology (space sP) q).obj ((SheafOfModules.toSheaf _).obj
                  ((analytifyModule sP).obj ((Scheme.Modules.pushforward i).obj F))) ⟶
                  (sheafCohomology (space sX) q).obj
                    ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F)) :=
                sheafCohomologyPullback (ComplexPoints.analyticMap i hi) _ q ≫
                  (sheafCohomology (space sX) q).map
                    (((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
                      (ComplexPoints.analyticMap i hi)).homEquiv _ _).symm
                      ((SheafOfModules.toSheaf _).map e.hom))
              IsIso resAlg ∧ IsIso resAn ∧
                comparisonMap sP ((Scheme.Modules.pushforward i).obj F) q ≫ resAn =
                  resAlg ≫ comparisonMap sX F q := by
  refine ⟨⟨?continuous, ?injective, ?range, ?chartStalk⟩, ?flat, ?stalkTensor, ?finiteLimits,
    ?finiteColimits, ?tensor, ?invertible, ?vanishing, ?natural, ?delta, ?closedImmersion⟩
  case continuous => exact ComplexPoints.continuous_toScheme
  case injective => exact ComplexPoints.toScheme_injective
  case range => exact ComplexPoints.range_toScheme
  case closedImmersion => exact analytification_stalks_closedImmersion sX
  case chartStalk => exact fun y c hy => Chart.exists_stalk_ringEquiv y c hy
  case flat =>
    intro y
    have hloc := isLocalHom_stalkMap y
    have hff := faithfullyFlat_stalkMap y
    exact ⟨hloc, hff, fun N => MMP.exists_ringEquiv_quotient_maximalIdeal_pow _ hff
      (exists_sub_stalkMap_analytificationHom_mem y) N⟩
  case stalkTensor => exact analytification_stalks_stalkTensor sX
  case finiteLimits => exact preservesFiniteLimits_analytifyModule
  case finiteColimits =>
    have : (analytifyModule sX).IsLeftAdjoint :=
      (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX)).isLeftAdjoint
    infer_instance
  case tensor => exact analytification_stalks_tensor sX
  case invertible =>
    intro L hL y
    obtain ⟨U, hyU, ⟨eU⟩⟩ := hL y.toScheme
    obtain ⟨G, -, ⟨eUnit⟩, ⟨eL⟩⟩ :=
      AlgebraicGeometry.Grassmannian.exists_pullbackRestrictionData (toSchemeHom sX)
        (ringCatSheafHom sX) L U
    exact ⟨(Opens.map (toSchemeHom sX)).obj U, hyU, ⟨eL.symm ≪≫ G.mapIso eU ≪≫ eUnit.symm⟩⟩
  case vanishing =>
    intro F hF hZ
    have hy : ∀ y : ComplexPoints sX, Subsingleton (TopCat.Presheaf.stalk (C := AddCommGrpCat.{0})
        F.val.presheaf (toSchemeHom sX y)) := fun y =>
      MMP.ModuleSkyscraper.subsingleton_stalk_of_isZero_of_faithfullyFlat (toSchemeHom sX)
        (ringCatSheafHom sX) y _ (stalkMap_germ_ringCatSheafHom y)
        (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX))
        (faithfullyFlat_stalkMap y) F hZ
    refine MMP.ModuleSkyscraper.isZero_of_forall_subsingleton_stalk X.sheaf F fun x => ?_
    have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
    obtain ⟨z, hz, hzc⟩ := (isClosed_closure (s := {x})).exists_closed_singleton
      ⟨x, subset_closure rfl⟩
    obtain ⟨y, rfl⟩ : z ∈ Set.range (ComplexPoints.toScheme (sX := sX)) := by
      rwa [ComplexPoints.range_toScheme]
    have : F.IsFiniteType := hF
    have hxz : 𝓝 x ≤ 𝓝 y.toScheme := specializes_iff_mem_closure.2 hz
    exact ((MMP.ModuleSkyscraper.eventually_subsingleton_stalk_of_isFiniteType X.sheaf F _
      (hy y)).filter_mono hxz).self_of_nhds
  case natural =>
    exact fun F G φ ψ hψ q => comparisonMap_comp_map sX φ ψ hψ q
  case delta => exact analytification_stalks_delta sX

end

