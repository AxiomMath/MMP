variable (N : ℕ)

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The twisting sheaf `𝒪(k)` of `ℙᴺ_ℂ`. -/
local notation3 (prettyPrint := false) "𝒪ℙ[" N ", " k "]" =>
  (show (AlgebraicGeometry.Proj (polyGrading ℂ N)).Modules from
    ProjectiveSpectrum.Proj.twistingSheaf (polyGrading ℂ N) k)

/-- The structure morphism `projToSpecCoeff ℂ N` of `ℙᴺ_ℂ = Proj (polyGrading ℂ N)`. -/
private abbrev PP := MMP.Analytic.ProjectiveTwists.sP N

/-- The structure sheaf of `P^an`, as a sheaf of rings. -/
private abbrev RR : Sheaf (Opens.grothendieckTopology (space (PP N))) RingCat.{0} :=
  Sheaf.toRingCat _ (structureSheaf (PP N))

/-- Sheaves of modules over `𝒪_{P^an}`. -/
private abbrev Md := SheafOfModules.{0} (RR N)

/-- The monoidal structure on `Md N`. -/
@[instance_reducible] private def monMd : MonoidalCategory (Md N) :=
  Stacks.SheafOfModules.Strict.monoidalCategory (structureSheaf (PP N)).obj
    (Sheaf.toRingCat _ (structureSheaf (PP N))).property

attribute [local instance] monMd

/-- The symmetric structure on `Md N`. -/
@[instance_reducible] private def symMd : SymmetricCategory (Md N) :=
  Stacks.SheafOfModules.Strict.symmetricCategory (structureSheaf (PP N)).obj
    (Sheaf.toRingCat _ (structureSheaf (PP N))).property

attribute [local instance] symMd

/-- `𝒪(k)^an`. -/
private abbrev L (k : ℤ) : Md N :=
  (analytifyModule (PP N)).obj (𝒪ℙ[N, k])

/-- The twist `M(k) = M ⊗ 𝒪(k)^an`. -/
private abbrev tw (k : ℤ) (M : Md N) : Md N := M ⊗ L N k

/-- `H^q(P^an, M)`. -/
private abbrev Hq (q : ℕ) (M : Md N) : AddCommGrpCat.{0} :=
  (sheafCohomology _ (q : ℤ)).obj ((SheafOfModules.toSheaf _).obj M)

/-- `M` is generated by finitely many global sections. -/
private def Gen (M : Md N) : Prop :=
  ∃ σ : M.GeneratingSections, σ.IsFiniteType

/-- `M` has no cohomology in positive degrees. -/
private def Van (M : Md N) : Prop :=
  ∀ q : ℕ, 1 ≤ q → IsZero (Hq N q M)

/-- The conclusion of the theorem for `M`. -/
private def Good (M : Md N) : Prop :=
  ∃ k₀ : ℤ, ∀ k : ℤ, k₀ ≤ k → Gen N (tw N k M) ∧ Van N (tw N k M)

/-! ### Linear forms and the sheaves they annihilate -/

/-- Linear forms on `ℂ^{N+1}`, by their coefficients. -/
private abbrev Form := Fin (N + 1) → ℂ

/-! ### Division by independent linear functions -/

section AffineDivision

open Filter Topology

private lemma exists_dual_basis_of_linearIndependent {n r : ℕ}
    (φ : Fin r → Module.Dual ℂ (Fin n → ℂ)) (hφ : LinearIndependent ℂ φ) :
    ∃ u : Fin r → (Fin n → ℂ), ∀ j k, φ j (u k) = if j = k then 1 else 0 := by
  classical
  let Φ : (Fin n → ℂ) →ₗ[ℂ] (Fin r → ℂ) := LinearMap.pi φ
  have hs : Function.Surjective Φ := by
    rw [← LinearMap.range_eq_top]
    by_contra hne
    obtain ⟨ψ, hψ0, hψ⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.2 hne)
    apply hψ0
    have hsum : ∑ j, ψ (Pi.single j 1) • φ j = 0 := by
      refine LinearMap.ext fun y => ?_
      have h1 : ψ (Φ y) = 0 := hψ ⟨y, rfl⟩
      have h2 : Φ y = ∑ j, φ j y • Pi.single j 1 := by
        ext m
        simp [Φ, Pi.single_apply]
      rw [h2, map_sum] at h1
      simp only [map_smul, smul_eq_mul] at h1
      simp only [LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul, LinearMap.zero_apply]
      rw [← h1]
      exact Finset.sum_congr rfl fun j _ => mul_comm _ _
    have := Fintype.linearIndependent_iff.1 hφ _ hsum
    refine LinearMap.ext fun z => ?_
    have h2 : z = ∑ j, z j • Pi.single j 1 := by
      ext m
      simp [Pi.single_apply]
    rw [h2, map_sum]
    simp [this]
  choose u hu using fun k => hs (Pi.single k 1)
  refine ⟨u, fun j k => ?_⟩
  have := congrFun (hu k) j
  simp only [Φ, LinearMap.pi_apply] at this
  rw [this, Pi.single_apply]

/-- **Linear functions are non-zero-divisors modulo independent linear functions**, for germs of
holomorphic functions: if `φ₀, …, φ_r` are linearly independent linear forms and
`φ_r(y - b) f(y) = ∑_{k < r} φ_k(y - b) h_k(y)` near `b` with `f` holomorphic, then
`f = ∑_{k<r} φ_k(y - b) g_k` near `b` with `g_k` holomorphic. -/
private lemma exists_eq_sum_mul_of_mul_eq_sum_mul {n r : ℕ}
    (φ : Fin (r + 1) → Module.Dual ℂ (Fin n → ℂ)) (hφ : LinearIndependent ℂ φ)
    (b : Fin n → ℂ) (f : (Fin n → ℂ) → ℂ) (h : Fin r → (Fin n → ℂ) → ℂ)
    (hf : ∀ᶠ y in 𝓝 b, DifferentiableAt ℂ f y)
    (heq : ∀ᶠ y in 𝓝 b, φ (Fin.last r) (y - b) * f y = ∑ k, φ (Fin.castSucc k) (y - b) * h k y) :
    ∃ g : Fin r → (Fin n → ℂ) → ℂ, (∀ k, ∀ᶠ y in 𝓝 b, DifferentiableAt ℂ (g k) y) ∧
      ∀ᶠ y in 𝓝 b, f y = ∑ k, φ (Fin.castSucc k) (y - b) * g k y := by
  classical
  obtain ⟨u, hu⟩ := exists_dual_basis_of_linearIndependent φ hφ
  let L : Fin r → Module.Dual ℂ (Fin n → ℂ) := fun k => φ (Fin.castSucc k)
  let w : Fin r → (Fin n → ℂ) := fun k => u (Fin.castSucc k)
  let v : Fin n → ℂ := u (Fin.last r)
  have hw : ∀ m k, L m (w k) = if m = k then 1 else 0 := fun m k => by
    simpa only [Fin.castSucc_inj] using hu (Fin.castSucc m) (Fin.castSucc k)
  have hv : ∀ k, L k v = 0 := fun k => by
    simpa [L, v, Fin.castSucc_ne_last] using hu (Fin.castSucc k) (Fin.last r)
  have hcv : φ (Fin.last r) v = 1 := by simpa [v] using hu (Fin.last r) (Fin.last r)
  -- `f` vanishes on the slice `{φ_k(y - b) = 0, k < r}` near `b`
  have hslice : ∀ᶠ z in 𝓝 b, (∀ k, L k (z - b) = 0) → f z = 0 := by
    have hev : ∀ᶠ y in 𝓝 b, ContinuousAt f y ∧
        φ (Fin.last r) (y - b) * f y = ∑ k, L k (y - b) * h k y :=
      ((eventually_eventually_nhds.2 hf).and heq).mono fun y hy =>
        ⟨hy.1.self_of_nhds.continuousAt, hy.2⟩
    filter_upwards [eventually_eventually_nhds.2 hev] with z hz hzA
    have hcont : ContinuousAt f z := hz.self_of_nhds.1
    have hlin : Tendsto (fun t : ℂ => z + t • v) (𝓝 0) (𝓝 z) := by
      have : Continuous (fun t : ℂ => z + t • v) := by fun_prop
      simpa using this.tendsto 0
    have hT : Tendsto (fun t : ℂ => f (z + t • v)) (𝓝[≠] 0) (𝓝 (f z)) :=
      (hcont.tendsto.comp hlin).mono_left nhdsWithin_le_nhds
    have hne : ∀ᶠ t in 𝓝[≠] (0 : ℂ), t ≠ -φ (Fin.last r) (z - b) := by
      by_cases h0 : φ (Fin.last r) (z - b) = 0
      · rw [h0, neg_zero]; exact self_mem_nhdsWithin
      · have h1 : (0:ℂ) ≠ -φ (Fin.last r) (z - b) := fun e => h0 (neg_eq_zero.1 e.symm)
        exact Filter.Eventually.filter_mono nhdsWithin_le_nhds (isOpen_ne.mem_nhds h1)
    have hS : ∀ᶠ t in 𝓝[≠] (0 : ℂ), ContinuousAt f (z + t • v) ∧
        φ (Fin.last r) (z + t • v - b) * f (z + t • v) =
          ∑ k, L k (z + t • v - b) * h k (z + t • v) :=
      (hlin.eventually hz).filter_mono nhdsWithin_le_nhds
    have h0 : ∀ᶠ t in 𝓝[≠] (0 : ℂ), f (z + t • v) = 0 := by
      filter_upwards [hne, hS] with t ht hSt
      have e1 : ∀ k, L k (z + t • v - b) = 0 := fun k => by
        rw [add_sub_right_comm, map_add, map_smul, hv, smul_zero, add_zero, hzA k]
      have e2 : φ (Fin.last r) (z + t • v - b) = φ (Fin.last r) (z - b) + t := by
        rw [add_sub_right_comm, map_add, map_smul, hcv, smul_eq_mul, mul_one]
      have := hSt.2
      simp only [e1, zero_mul, Finset.sum_const_zero, e2] at this
      rcases mul_eq_zero.1 this with h | h
      · exact absurd (eq_neg_of_add_eq_zero_right h) ht
      · exact h
    exact tendsto_nhds_unique hT (tendsto_const_nhds.congr' (h0.mono fun t ht => ht.symm))
  -- Hadamard division along the projection onto the slice
  have hLd : ∀ k y, DifferentiableAt ℂ (fun y => L k (y - b)) y := fun k y =>
    (LinearMap.toContinuousLinearMap (L k)).differentiableAt.comp _
      (differentiableAt_id.sub_const b)
  let pr : (Fin n → ℂ) → (Fin n → ℂ) := fun y => y - ∑ k, L k (y - b) • w k
  have hprb : pr b = b := by simp [pr]
  have hprA : ∀ y m, L m (pr y - b) = 0 := fun y m => by
    simp only [pr, sub_right_comm y, map_sub, map_sum, map_smul, hw, smul_eq_mul, mul_ite, mul_one,
      mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    ring
  have hprd : ∀ y, DifferentiableAt ℂ pr y := fun y =>
    differentiableAt_id.sub (DifferentiableAt.fun_sum fun k _ => (hLd k y).smul_const (w k))
  have hprt : Tendsto pr (𝓝 b) (𝓝 b) := by
    simpa [hprb] using (hprd b).continuousAt.tendsto
  have hfpr : ∀ᶠ y in 𝓝 b, f (pr y) = 0 :=
    (hprt.eventually hslice).mono fun y hy => hy (hprA y)
  have hℓ : ∀ k, ((fun y => L k (y - b) : (Fin n → ℂ) → ℂ) : Germ (𝓝 b) ℂ) ∈ holGerms b :=
    fun k => coe_mem_holGerms (Eventually.of_forall (hLd k))
  let ℓ : Fin r → holGerms b := fun k => ⟨_, hℓ k⟩
  let I : Ideal (holGerms b) := Ideal.span (Set.range ℓ)
  have hconst : ∀ a : ℂ, ((fun _ => a : (Fin n → ℂ) → ℂ) : Germ (𝓝 b) ℂ) ∈ holGerms b :=
    fun a => coe_mem_holGerms (Eventually.of_forall fun y => differentiableAt_const _)
  have hI : ∀ i, ∃ g ∈ I, (g : Germ (𝓝 b) ℂ) = ↑(fun x => (id x : Fin n → ℂ) i - pr x i) := by
    intro i
    refine ⟨∑ k, ℓ k * ⟨_, hconst (w k i)⟩, Ideal.sum_mem _ fun k _ =>
      I.mul_mem_right _ (Ideal.subset_span ⟨k, rfl⟩), ?_⟩
    push_cast
    change ∑ k, Germ.coeRingHom (𝓝 b) ((fun y => L k (y - b)) * fun _ => w k i) = _
    rw [← map_sum]
    refine Germ.coe_eq.2 (Eventually.of_forall fun x => ?_)
    simp [pr]
  obtain ⟨g, hgI, hg⟩ := (exists_sub_eq_sum_sub_mul_and_comp_sub_comp_mem hf).2 b id pr
    (Eventually.of_forall fun y => differentiableAt_id) (Eventually.of_forall hprd) rfl hprb I hI
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).1 hgI
  choose F hF hFd using fun k => (c k).2
  refine ⟨F, hFd, ?_⟩
  have hgerm : ((fun x => f x - f (pr x) : (Fin n → ℂ) → ℂ) : Germ (𝓝 b) ℂ) =
      ↑(fun y => ∑ k, L k (y - b) * F k y) := by
    simp only [id] at hg
    rw [← hg, ← hc]
    push_cast
    change ∑ k, ((c k : Germ (𝓝 b) ℂ) * (ℓ k : Germ (𝓝 b) ℂ)) = _
    simp only [← hF]
    change ∑ k, Germ.coeRingHom (𝓝 b) (F k * fun y => L k (y - b)) = _
    rw [← map_sum]
    refine Germ.coe_eq.2 (Eventually.of_forall fun x => ?_)
    simp [mul_comm]
  filter_upwards [Germ.coe_eq.1 hgerm, hfpr] with y hy hy'
  rw [← hy, hy', sub_zero]

end AffineDivision

/-! ### Standard charts and the sections of `𝒪(1)^an` given by linear forms -/

section Charts

open MMP.Analytic.ProjectiveTwists Stacks.ProjectiveSpace.Cohomology

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The linear polynomial `∑ⱼ cⱼ xⱼ`. -/
private def formPoly (c : Form N) : MvPolynomial (Fin (N + 1)) ℂ :=
  ∑ j, MvPolynomial.C (c j) * MvPolynomial.X j

private lemma formPoly_mem (c : Form N) :
    formPoly N c ∈ polyGrading ℂ N 1 :=
  Submodule.sum_mem _ fun j _ => MvPolynomial.isHomogeneous_C_mul_X (c j) j

/-- The linear polynomial of `c`, as a degree-zero element of the shifted module `S(1)`. -/
private def formElt (c : Form N) : ProjectiveSpectrum.Proj.twistGrading
    (polyGrading ℂ N) 1 0 :=
  ⟨formPoly N c, by
    simpa using coe_mem_twistGrading_zero ℂ N 1 ⟨formPoly N c, formPoly_mem N c⟩⟩

/-- The global section of `𝒪(1)` of a linear form. -/
private def algSec (c : Form N) :
    (𝒪ℙ[N, 1]).val.obj (op ⊤) :=
  Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroToGlobalSections
    (polyGrading ℂ N)
    (ProjectiveSpectrum.Proj.twistGrading (polyGrading ℂ N) 1)
    (formElt N c)

/-- The global section of `𝒪(1)^an` of a linear form. -/
private def anSec (c : Form N) : (L N 1).val.obj (op ⊤) :=
  (analytifyModuleUnit (PP N) _).val.app (op ⊤) (algSec N c)

/-- The standard chart `Uᵢ = {xᵢ ≠ 0}` of `P^an`. -/
private abbrev U (i : Fin (N + 1)) : Opens (space (PP N)) := WS N {i}

private lemma U_le (i : Fin (N + 1)) :
    U N i ≤ (Opens.map (toSchemeHom (sP N))).obj (stdChart N i).U :=
  WS_le i (Finset.mem_singleton_self i)

private lemma mem_chart_of_U {i : Fin (N + 1)} (x : U N i) :
    x.1 ∈ ComplexPoints.chart (sX := sP N) (stdChart N i).U :=
  mem_chart_of_WS i (Finset.mem_singleton_self i) x

/-- The function `c / xᵢ` on `Uᵢ`: the coefficient of the section of `c` with respect to the
trivialization of `𝒪(1)^an` by `xᵢ`. -/
private def gF (c : Form N) (i : Fin (N + 1)) : (RR N).obj.obj (op (U N i)) :=
  secOf N 1 i (U N i) (U_le N i) ((L N 1).val.map (homOfLE le_top).op (anSec N c))

private lemma gF_smul (c : Form N) (i : Fin (N + 1)) :
    gF N c i • (L N 1).val.map (homOfLE (U_le N i)).op (uSec N 1 i) =
      (L N 1).val.map (homOfLE le_top).op (anSec N c) :=
  secOf_smul N 1 i (U N i) (U_le N i) _

/-- The value of `c / xᵢ` at a point of `Uᵢ` is `∑ⱼ cⱼ xⱼ / xᵢ`. -/
private lemma secVal_gF (c : Form N) (i : Fin (N + 1)) (x : U N i) :
    secVal (gF N c i) x (stdChart N i) (mem_chart_of_U N x) =
      ∑ j, c j * hcoord N i ⟨x.1, mem_chart_of_U N x⟩ j := by
  have hj := Finset.mem_singleton_self i
  have hw := coords_mem_lDom i hj x
  have e1 := gfun_apply 1 i hj ((L N 1).val.map (homOfLE le_top).op (anSec N c)) _ hw
  rw [ptW_coords] at e1
  refine e1.symm.trans ?_
  let V' := Proj.basicOpen (polyGrading ℂ N) (chartDenom ℂ N {i})
  have e2 : (L N 1).val.map (homOfLE le_top).op (anSec N c) =
      unitHom (sX := sP N) (L := 𝒪ℙ[N, 1]) V'
        ((𝒪ℙ[N, 1]).val.map
          (homOfLE (le_top : V' ≤ ⊤)).op (algSec N c)) :=
    (unitHom_naturality (sX := sP N) (L := 𝒪ℙ[N, 1])
      (le_top : V' ≤ ⊤) (algSec N c)).symm
  refine (congrArg (fun s => gfun N 1 i hj s
    ((stdChart N i).coords ⟨x.1, mem_chart_of_WS i hj x⟩)) e2).trans ?_
  refine (gfun_unitHom 1 i hj _ _ hw).trans ?_
  have e3 := Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroToGlobalSections_basicOpen
    (polyGrading ℂ N)
    (ProjectiveSpectrum.Proj.twistGrading (polyGrading ℂ N) 1)
    (chartDenom_mem_homogeneousSubmodule N {i}) (Finset.card_pos.2 ⟨i, hj⟩) (formElt N c)
  refine (congrArg (evQ {i} _ _) (congrArg Subtype.val e3)).trans ?_
  change evQ {i} _ _ (Localization.mk (formPoly N c) ⟨chartDenom ℂ N {i} ^ 0, ⟨0, rfl⟩⟩) = _
  rw [evQ_mk]
  have h1 : ∀ z : Fin (N + 1) → ℂ, MvPolynomial.eval z ((⟨chartDenom ℂ N {i} ^ 0, ⟨0, rfl⟩⟩ :
      Submonoid.powers (chartDenom ℂ N {i})) : MvPolynomial (Fin (N + 1)) ℂ) = 1 := fun z => by
    simp
  rw [h1, div_one]
  simp only [formPoly, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
  refine Finset.sum_congr rfl fun j _ => ?_
  exact congrArg (c j * ·) (congrFun (hcoord_eq_insertOne i ⟨x.1, mem_chart_of_WS i hj x⟩) j).symm

private lemma exists_mem_U (x : space (PP N)) : ∃ i, x ∈ U N i :=
  exists_mem_basicOpen_chartDenom_singleton ℂ N x.toScheme

/-- A chart containing `x`. -/
private def iOf (x : space (PP N)) : Fin (N + 1) := (exists_mem_U N x).choose

private lemma mem_U_iOf (x : space (PP N)) : x ∈ U N (iOf N x) := (exists_mem_U N x).choose_spec

/-- Homogeneous coordinates of `x`, normalized in the chart `iOf x`. -/
private def hpt (x : space (PP N)) : Form N :=
  hcoord N (iOf N x) ⟨x, mem_chart_of_U N (⟨x, mem_U_iOf N x⟩ : U N (iOf N x))⟩

/-- The value at `x` of a linear form, in normalized homogeneous coordinates. -/
private def ev (c : Form N) (x : space (PP N)) : ℂ := ∑ j, c j * hpt N x j

private lemma ev_add (c d : Form N) (x : space (PP N)) : ev N (c + d) x = ev N c x + ev N d x := by
  simp only [ev, Pi.add_apply, add_mul, Finset.sum_add_distrib]

private lemma ev_smul (a : ℂ) (c : Form N) (x : space (PP N)) : ev N (a • c) x = a * ev N c x := by
  simp only [ev, Pi.smul_apply, smul_eq_mul, mul_assoc, Finset.mul_sum]

private lemma mem_U_iff (i : Fin (N + 1)) (x : space (PP N)) (j : Fin (N + 1)) (hx : x ∈ U N i) :
    x ∈ U N j ↔ hcoord N i ⟨x, mem_chart_of_U N (⟨x, hx⟩ : U N i)⟩ j ≠ 0 := by
  have h := toScheme_mem_X_iff i ⟨x, mem_chart_of_U N (⟨x, hx⟩ : U N i)⟩ j
  rw [← h]
  change x.toScheme ∈ ProjectiveSpectrum.basicOpen _ (chartDenom ℂ N {j}) ↔ _
  rw [chartDenom_singleton]

/-- On `Uᵢ`, the value of `c / xᵢ` is a nonzero multiple of `ev c`. -/
private lemma secVal_gF_eq (c : Form N) (i : Fin (N + 1)) (x : U N i) :
    ∃ t : ℂ, t ≠ 0 ∧ secVal (gF N c i) x (stdChart N i) (mem_chart_of_U N x) = t * ev N c x.1 := by
  set i₀ := iOf N x.1
  have hx₀ := mem_U_iOf N x.1
  refine ⟨hcoord N i ⟨x.1, mem_chart_of_U N x⟩ i₀, (mem_U_iff N i x.1 i₀ x.2).1 hx₀, ?_⟩
  rw [secVal_gF, ev, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hcoord_change i₀ i x.1 (mem_chart_of_U N (⟨x.1, hx₀⟩ : U N i₀)) (mem_chart_of_U N x) j]
  simp only [hpt, i₀]
  ring

private lemma ev_eq_zero_iff (c : Form N) (i : Fin (N + 1)) (x : U N i) :
    ev N c x.1 = 0 ↔ secVal (gF N c i) x (stdChart N i) (mem_chart_of_U N x) = 0 := by
  obtain ⟨t, ht, he⟩ := secVal_gF_eq N c i x
  rw [he, mul_eq_zero, or_iff_right ht]

private lemma hpt_iOf (x : space (PP N)) : hpt N x (iOf N x) = 1 := hcoord_self N _ _

/-- Points of `Z(W)`: either a form vanishing at `x` is independent of `W`, or `Z(W) = {x}`. -/
private lemma exists_form_or_isolated (W : Finset (Form N)) (x : space (PP N)) :
    (∃ c : Form N, ev N c x = 0 ∧ c ∉ Submodule.span ℂ (W : Set (Form N))) ∨
      ∀ y : space (PP N), (∀ c ∈ W, ev N c y = 0) → y = x := by
  classical
  by_cases h : ∃ c : Form N, ev N c x = 0 ∧ c ∉ Submodule.span ℂ (W : Set (Form N))
  · exact Or.inl h
  refine Or.inr fun y hy => ?_
  push Not at h
  -- every form vanishing at `x` vanishes at `y`
  have hspanY : ∀ c ∈ Submodule.span ℂ (W : Set (Form N)), ev N c y = 0 := by
    intro c hc
    induction hc using Submodule.span_induction with
    | mem d hd => exact hy d hd
    | zero => simp [ev]
    | add d e _ _ hd he => rw [ev_add, hd, he, add_zero]
    | smul a d _ hd => rw [ev_smul, hd, mul_zero]
  have hxy : ∀ c : Form N, ev N c x = 0 → ev N c y = 0 := fun c hc => hspanY c (h c hc)
  set i₀ := iOf N x
  set v := hpt N x
  set v' := hpt N y
  have hv₀ : v i₀ = 1 := hpt_iOf N x
  -- `v' = v' i₀ • v`
  have hprop : ∀ k, v' k = v k * v' i₀ := by
    intro k
    let c : Form N := Pi.single k 1 - (v k) • Pi.single i₀ 1
    have hcx : ev N c x = 0 := by
      simp only [c, ev, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, sub_mul, Finset.sum_sub_distrib,
        Pi.single_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ,
        if_true, mul_assoc, ← Finset.mul_sum]
      change v k - v k * v i₀ = 0
      rw [hv₀, mul_one, sub_self]
    have hcy := hxy c hcx
    simp only [c, ev, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, sub_mul, Finset.sum_sub_distrib,
      Pi.single_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ,
      if_true, mul_assoc, ← Finset.mul_sum] at hcy
    exact sub_eq_zero.1 hcy
  have hne : v' i₀ ≠ 0 := by
    intro h0
    have h1 := hprop (iOf N y)
    have h2 : v' (iOf N y) = 1 := hpt_iOf N y
    rw [h2, h0, mul_zero] at h1
    exact one_ne_zero h1
  have hyU : y ∈ U N i₀ := (mem_U_iff N (iOf N y) y i₀ (mem_U_iOf N y)).2 hne
  -- the coordinates of `y` in the chart `i₀` are those of `x`
  have hco : hcoord N i₀ ⟨y, mem_chart_of_U N (⟨y, hyU⟩ : U N i₀)⟩ =
      hcoord N i₀ ⟨x, mem_chart_of_U N (⟨x, mem_U_iOf N x⟩ : U N i₀)⟩ := by
    funext m
    have e := hcoord_change i₀ (iOf N y) y (mem_chart_of_U N (⟨y, hyU⟩ : U N i₀))
      (mem_chart_of_U N (⟨y, mem_U_iOf N y⟩ : U N (iOf N y))) m
    change v' m = v' i₀ * _ at e
    rw [hprop m, mul_comm] at e
    exact (mul_left_cancel₀ hne e).symm
  have hcoords : (stdChart N i₀).coords ⟨y, mem_chart_of_U N (⟨y, hyU⟩ : U N i₀)⟩ =
      (stdChart N i₀).coords ⟨x, mem_chart_of_U N (⟨x, mem_U_iOf N x⟩ : U N i₀)⟩ := by
    funext m
    exact congrFun hco (i₀.succAbove m)
  exact congrArg Subtype.val (coords_injective (stdChart_ideal N i₀) hcoords)

end Charts

/-- `M` is annihilated by the linear form `c`: on every chart `Uᵢ` the function `c / xᵢ` acts on
the sections of `M` by zero. -/
private def Killed (c : Form N) (M : Md N) : Prop :=
  ∀ (i : Fin (N + 1)) (V : Opens (space (PP N))) (hV : V ≤ U N i) (m : M.val.obj (op V)),
    (RR N).obj.map (homOfLE hV).op (gF N c i) • m = 0

/-- `M` is annihilated by the linear forms of `W`. -/
private def KilledBy (W : Finset (Form N)) (M : Md N) : Prop := ∀ c ∈ W, Killed N c M

private lemma killedBy_empty (M : Md N) : KilledBy N ∅ M := fun _ h => absurd h (by simp)

/-! ### Generation by global sections near a point -/

section Generation

open CoherentAnalytic

/-- A global section, as a compatible family of sections. -/
private def topSection (M : Md N) (m : M.val.obj (op ⊤)) : M.sections :=
  PresheafOfModules.sectionsMk (fun U => M.val.map (homOfLE (le_top : U.unop ≤ ⊤)).op m)
    fun {U U'} f => (PresheafOfModules.map_comp_apply M.val _ f m).symm

/-- The global sections `t` generate `M` over the open `V`. -/
private def GenOn (M : Md N) {n : ℕ} (t : Fin n → M.val.obj (op ⊤)) (V : Opens (space (PP N))) :
    Prop :=
  LocallyGenerates M (fun k => resM M (le_top : V ≤ ⊤) (t k))

/-- Finitely many global sections of `M` generate `M` on a neighbourhood of `x`. -/
private def GenAt (M : Md N) (x : space (PP N)) : Prop :=
  ∃ V : Opens (space (PP N)), x ∈ V ∧ ∃ (n : ℕ) (t : Fin n → M.val.obj (op ⊤)), GenOn N M t V

private lemma GenOn.exists_nhds {M : Md N} {n : ℕ} {t : Fin n → M.val.obj (op ⊤)}
    {V : Opens (space (PP N))} (h : GenOn N M t V) {Y : Opens (space (PP N))} (hY : Y ≤ V)
    (q : M.val.obj (op Y)) {y : space (PP N)} (hy : y ∈ Y) :
    ∃ (Y' : Opens (space (PP N))) (hY' : Y' ≤ Y), y ∈ Y' ∧
      ∃ c : Fin n → (RR N).obj.obj (op Y'),
        resM M hY' q = ∑ k, c k • resM M (le_top : Y' ≤ ⊤) (t k) := by
  obtain ⟨Y', hY', hyY', c, hc⟩ := LocallyGenerates.exists_nhds h hY q hy
  exact ⟨Y', hY', hyY', c, hc.trans (Finset.sum_congr rfl fun k _ =>
    congrArg (c k • ·) (resM_resM M le_top (hY'.trans hY) (t k)))⟩

private lemma app_sum_smul_freeElt (P : Md N) {I : Type} (σ : I → P.sections)
    (Y : Opens (space (PP N))) {n : ℕ} (c : Fin n → (RR N).obj.obj (op Y))
    (j : Fin n → I) :
    (P.freeHomEquiv.symm σ).val.app (op Y)
        (∑ k, c k • OkaCoherence.freeElt (R := RR N) (j k) (op Y)) =
      ∑ k, c k • (show P.val.obj (op Y) from (σ (j k)).1 (op Y)) := by
  simp only [map_sum, map_smul]
  exact Finset.sum_congr rfl fun k _ => congrArg _
    (OkaCoherence.freeHomEquiv_symm_app_freeSection _ _ _)

/-- `P^an` is compact. -/
private lemma compactSpace_space : CompactSpace (space (PP N)) := by
  letI : (AlgebraicGeometry.Proj (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading ℂ N)).Over
    (Spec (.of ℂ)) := ⟨PP N⟩
  have := MMP.UnderlyingSpace.compactSpace_projectiveSpace (K := ℂ) N rfl
  exact (MMP.Analytic.ComplexPoints.homeomorphUnderlyingSpace
    (X := AlgebraicGeometry.Proj
      (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading ℂ N))).symm.compactSpace

/-- Generation near every point by global sections gives global generation by finitely many. -/
private lemma gen_of_forall_genAt {M : Md N} (h : ∀ x, GenAt N M x) : Gen N M := by
  classical
  haveI := compactSpace_space N
  choose V hxV n t ht using h
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover (fun x => (V x : Set (space (PP N))))
    (fun x => (V x).isOpen) (fun y _ => Set.mem_iUnion.2 ⟨y, hxV y⟩)
  let I := Σ x : s, Fin (n x.1)
  let T : I → M.val.obj (op ⊤) := fun p => t p.1.1 p.2
  refine ⟨⟨I, fun p => topSection N M (T p), ?_⟩, ⟨inferInstance⟩⟩
  refine OkaCoherence.epi_of_locally_surjective _ fun X q => ?_
  let S : Sieve X :=
    { arrows := fun Y f => ∃ p : (SheafOfModules.free (R := RR N) I).val.obj (op Y),
        (M.freeHomEquiv.symm fun p => topSection N M (T p)).val.app (op Y) p = M.val.map f.op q
      downward_closed := by
        rintro Y Z f ⟨p, hp⟩ g
        refine ⟨(SheafOfModules.free (R := RR N) I).val.map g.op p, ?_⟩
        refine (PresheafOfModules.naturality_apply _ g.op p).trans ?_
        refine (congrArg (M.val.map g.op) hp).trans ?_
        exact (PresheafOfModules.map_comp_apply M.val f.op g.op q).symm }
  refine ⟨S, (Opens.mem_grothendieckTopology _).2 fun y hy => ?_, fun Y f hf => hf⟩
  obtain ⟨x, hxs, hyx⟩ := Set.mem_iUnion₂.1 (hs (Set.mem_univ y))
  obtain ⟨Y', hY', hyY', c, hc⟩ := GenOn.exists_nhds N (ht x) (inf_le_right : X ⊓ V x ≤ V x)
    (resM M (inf_le_left : X ⊓ V x ≤ X) q) ⟨hy, hyx⟩
  let p : (SheafOfModules.free (R := RR N) I).val.obj (op Y') :=
    ∑ k, c k • OkaCoherence.freeElt (R := RR N) (⟨⟨x, hxs⟩, k⟩ : I) (op Y')
  refine ⟨Y', homOfLE (hY'.trans inf_le_left), ⟨p, ?_⟩, hyY'⟩
  refine (app_sum_smul_freeElt N M _ Y' c (fun k => (⟨⟨x, hxs⟩, k⟩ : I))).trans ?_
  exact hc.symm.trans (resM_resM M (inf_le_left : X ⊓ V x ≤ X) hY' q)

/-- A sheaf vanishing near `x` is generated near `x`, by no sections. -/
private lemma genAt_of_zero {M : Md N} {x : space (PP N)} {V : Opens (space (PP N))} (hx : x ∈ V)
    (hV : ∀ (Y : Opens (space (PP N))) (_ : Y ≤ V) (m : M.val.obj (op Y)), m = 0) :
    GenAt N M x := by
  refine ⟨V, hx, 0, Fin.elim0, fun Z z t => ⟨⊤, (Opens.grothendieckTopology _).top_mem _,
    fun W f _ => ⟨Fin.elim0, ?_⟩⟩⟩
  rw [Finset.univ_eq_empty, Finset.sum_empty]
  exact hV W (f.le.trans z.le) _

/-- A morphism which is surjective on sections, locally on `W`. -/
private def LocSurjOn {A B : Md N} (f : A ⟶ B) (W : Opens (space (PP N))) : Prop :=
  ∀ (Y : Opens (space (PP N))) (_ : Y ≤ W) (b : B.val.obj (op Y)) (y : space (PP N)), y ∈ Y →
    ∃ (Y' : Opens (space (PP N))) (h : Y' ≤ Y), y ∈ Y' ∧ ∃ a : A.val.obj (op Y'),
      f.val.app (op Y') a = resM B h b

private lemma locSurjOn_of_isIso {A B : Md N} (f : A ⟶ B) [IsIso f] (W : Opens (space (PP N))) :
    LocSurjOn N f W := by
  intro Y _ b y hy
  refine ⟨Y, le_rfl, hy, (inv f).val.app (op Y) b, ?_⟩
  change (inv f ≫ f).val.app (op Y) b = _
  rw [IsIso.inv_hom_id]
  exact (resM_refl B b).symm

private lemma LocSurjOn.comp {A B C : Md N} {f : A ⟶ B} {g : B ⟶ C} {W : Opens (space (PP N))}
    (hf : LocSurjOn N f W) (hg : LocSurjOn N g W) : LocSurjOn N (f ≫ g) W := by
  intro Y hY c y hy
  obtain ⟨Y₁, h₁, hy₁, b, hb⟩ := hg Y hY c y hy
  obtain ⟨Y₂, h₂, hy₂, a, ha⟩ := hf Y₁ (h₁.trans hY) b y hy₁
  refine ⟨Y₂, h₂.trans h₁, hy₂, a, ?_⟩
  change g.val.app (op Y₂) (f.val.app (op Y₂) a) = _
  rw [ha]
  change g.val.app (op Y₂) (B.val.map (homOfLE h₂).op b) = _
  rw [PresheafOfModules.naturality_apply, hb]
  exact resM_resM C h₁ h₂ c

/-- Images of generating sections under a locally surjective morphism generate. -/
private lemma GenOn.map {A B : Md N} (f : A ⟶ B) {n : ℕ} {t : Fin n → A.val.obj (op ⊤)}
    {V W : Opens (space (PP N))} (ht : GenOn N A t V) (hf : LocSurjOn N f W) :
    GenOn N B (fun k => f.val.app (op ⊤) (t k)) (V ⊓ W) := by
  refine locallyGenerates_of_nhds _ fun Y hY b y hy => ?_
  obtain ⟨Y₁, h₁, hy₁, a, ha⟩ := hf Y (hY.trans inf_le_right) b y hy
  obtain ⟨Y₂, h₂, hy₂, c, hc⟩ := GenOn.exists_nhds N ht (h₁.trans (hY.trans inf_le_left)) a hy₁
  refine ⟨Y₂, h₂.trans h₁, hy₂, c, ?_⟩
  have e1 : resM B (h₂.trans h₁) b = f.val.app (op Y₂) (resM A h₂ a) := by
    rw [← resM_resM B h₁ h₂ b, ← ha]
    exact (PresheafOfModules.naturality_apply f.val (homOfLE h₂).op a).symm
  rw [e1, hc, map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_smul, resM_resM]
  congr 1
  exact PresheafOfModules.naturality_apply f.val _ (t k)

end Generation

/-! ### Holomorphic functions on a chart: values and units -/

section Units

open MMP.Analytic.ProjectiveTwists

attribute [local instance] locallyOfFiniteType_sP

private lemma hW_of_le {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i) :
    ∀ x : V, x.1 ∈ ComplexPoints.chart (sX := sP N) (stdChart N i).U :=
  fun x => mem_chart_of_U N ⟨x.1, hV x.2⟩

/-- The value of a function on an open of the chart `Uᵢ` at a point. -/
private abbrev val {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i)
    (f : (RR N).obj.obj (op V)) (x : V) : ℂ :=
  secVal (sX := sP N) f x (stdChart N i) (hW_of_le N hV x)

private lemma val_one {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i) (x : V) :
    val N hV 1 x = 1 :=
  map_one (stalkRingValue (stdChart N i) ⟨x.1, hW_of_le N hV x⟩)

private lemma val_mul {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i)
    (f g : (RR N).obj.obj (op V)) (x : V) :
    val N hV (f * g) x = val N hV f x * val N hV g x :=
  secVal_mul _ _ _ _ _

/-- A function on part of a chart without zeros is a unit. -/
private lemma isUnit_of_val_ne_zero {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i)
    (f : (RR N).obj.obj (op V)) (hf : ∀ x : V, val N hV f x ≠ 0) : IsUnit f := by
  have hc := stdChart_ideal N i
  have hW := hW_of_le N hV
  let T : Set (Fin N → ℂ) := (stdChart N i).coords '' {y | y.1 ∈ V}
  have hT : IsOpen T := (isOpenEmbedding_coords (stdChart N i) hc).isOpenMap _
    (@Continuous.isOpen_preimage _ _ _ _ _ continuous_subtype_val _ V.isOpen)
  have hh : DifferentiableOn ℂ (fun p => (holFun hW f p)⁻¹) T := by
    rintro _ ⟨y, hy, rfl⟩
    have h1 := differentiableAt_holFun hc hW f ⟨y.1, hy⟩
    have h2 := holFun_coords hc hW f ⟨y.1, hy⟩
    exact (h1.inv (by rw [h2]; exact hf _)).differentiableWithinAt
  obtain ⟨g, hg⟩ := exists_sections_secVal_eq hW hT _ hh (fun x => ⟨⟨x.1, hW x⟩, x.2, rfl⟩)
  let f' : sections (sP N) V := f
  have h1 : f' * g = 1 := eq_of_secVal_eq hc hW _ _ fun x => by
    rw [secVal_mul, hg, holFun_coords hc hW f x, mul_inv_cancel₀ (hf x)]
    exact (val_one N hV x).symm
  exact ⟨⟨f, g, h1, (mul_comm g f').trans h1⟩, rfl⟩

/-- A function on part of a chart which does not vanish at `x` is a unit near `x`. -/
private lemma exists_isUnit_resA {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i)
    (f : (RR N).obj.obj (op V)) (x : V) (hx : val N hV f x ≠ 0) :
    ∃ (V' : Opens (space (PP N))) (hV' : V' ≤ V), x.1 ∈ V' ∧
      IsUnit ((RR N).obj.map (homOfLE hV').op f) := by
  have hc := stdChart_ideal N i
  have hW := hW_of_le N hV
  let C := ComplexPoints.chart (sX := sP N) (stdChart N i).U
  have hC : IsOpen C := (stdChart N i).isOpen_chart_and_isEmbedding_coords.1
  let φ : C → ℂ := fun y => holFun hW f ((stdChart N i).coords y)
  have hφ : ∀ y : C, y.1 ∈ V → ContinuousAt φ y := fun y hy =>
    (differentiableAt_holFun hc hW f ⟨y.1, hy⟩).continuousAt.comp
      (isOpenEmbedding_coords (stdChart N i) hc).continuous.continuousAt
  let O : Set C := {y | y.1 ∈ V ∧ φ y ≠ 0}
  have hO : IsOpen O := by
    refine isOpen_iff_mem_nhds.2 fun y hy => ?_
    have h1 : {z : C | z.1 ∈ V} ∈ nhds y :=
      (@Continuous.isOpen_preimage _ _ _ _ _ continuous_subtype_val _ V.isOpen).mem_nhds hy.1
    exact Filter.inter_mem h1 ((hφ y hy.1).eventually_ne hy.2)
  let V' : Opens (space (PP N)) := ⟨Subtype.val '' O, hC.isOpenMap_subtype_val _ hO⟩
  have hV'V : V' ≤ V := by rintro _ ⟨y, hy, rfl⟩; exact hy.1
  refine ⟨V', hV'V, ⟨⟨x.1, hW x⟩, ⟨x.2, ?_⟩, rfl⟩, ?_⟩
  · change holFun hW f ((stdChart N i).coords ⟨x.1, hW x⟩) ≠ 0
    rwa [holFun_coords hc hW f x]
  · refine isUnit_of_val_ne_zero N (hV'V.trans hV) _ fun y => ?_
    obtain ⟨z, hz, hzy⟩ := y.2
    change secVal f ⟨y.1, hV'V y.2⟩ _ _ ≠ 0
    have := holFun_coords hc hW f ⟨y.1, hV'V y.2⟩
    rw [← this]
    have hzy' : z = ⟨y.1, hW ⟨y.1, hV'V y.2⟩⟩ := Subtype.ext hzy
    subst hzy'
    exact hz.2

open CoherentAnalytic in
private lemma RR_mul_comm {V : Opens (space (PP N))} (a b : (RR N).obj.obj (op V)) :
    a * b = b * a :=
  mul_comm (a : sections (sP N) V) b

private lemma RR_mul_left_comm {V : Opens (space (PP N))} (a b c : (RR N).obj.obj (op V)) :
    a * (b * c) = b * (a * c) := by
  rw [← mul_assoc, RR_mul_comm N a b, mul_assoc]

/-- The function `c / xᵢ` in the affine coordinates of the chart `Uᵢ`. -/
private def aff (c : Form N) (i : Fin (N + 1)) (q : Fin N → ℂ) : ℂ :=
  c i + ∑ m, c (i.succAbove m) * q m

/-- The linear part of `aff N c i`. -/
private def linD (c : Form N) (i : Fin (N + 1)) : Module.Dual ℂ (Fin N → ℂ) :=
  ∑ m, c (i.succAbove m) • LinearMap.proj m

private lemma linD_apply (c : Form N) (i : Fin (N + 1)) (q : Fin N → ℂ) :
    linD N c i q = ∑ m, c (i.succAbove m) * q m := by
  simp [linD]

private lemma aff_eq (c : Form N) (i : Fin (N + 1)) (p q : Fin N → ℂ) :
    aff N c i q = aff N c i p + linD N c i (q - p) := by
  simp only [aff, linD_apply, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]
  ring

/-- Forms independent and vanishing at a point have independent linear parts. -/
private lemma linearIndependent_linD {n : ℕ} (ψ : Fin n → Form N) (hψ : LinearIndependent ℂ ψ)
    (i : Fin (N + 1)) (p : Fin N → ℂ) (hp : ∀ j, aff N (ψ j) i p = 0) :
    LinearIndependent ℂ fun j => linD N (ψ j) i := by
  refine Fintype.linearIndependent_iff.2 fun a ha => Fintype.linearIndependent_iff.1 hψ a ?_
  funext m
  have hlin : ∀ q : Fin N → ℂ, ∑ j, a j * ∑ m', ψ j (i.succAbove m') * q m' = 0 := fun q => by
    have := LinearMap.congr_fun ha q
    simpa [linD_apply] using this
  have haff : ∑ j, a j * aff N (ψ j) i p = 0 := by simp [hp]
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
  refine Fin.succAboveCases i ?_ (fun m' => ?_) m
  · have h0 := hlin p
    simp only [aff, mul_add, Finset.sum_add_distrib] at haff
    rw [h0, add_zero] at haff
    exact haff
  · have := hlin (Pi.single m' 1)
    simpa [Pi.single_apply, mul_ite] using this

private lemma val_gR {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i) (c : Form N)
    (y : V) : val N hV ((RR N).obj.map (homOfLE hV).op (gF N c i)) y =
      aff N c i (coordsN i ⟨y.1, hW_of_le N hV y⟩) := by
  refine (secVal_gF N c i ⟨y.1, hV y.2⟩).trans ?_
  rw [Fin.sum_univ_succAbove _ i, hcoord_self, mul_one]
  rfl

private lemma val_sum {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i) {n : ℕ}
    (f : Fin n → (RR N).obj.obj (op V)) (y : V) :
    val N hV (∑ k, f k) y = ∑ k, val N hV (f k) y := by
  classical
  have : ∀ s : Finset (Fin n), val N hV (∑ k ∈ s, f k) y = ∑ k ∈ s, val N hV (f k) y := by
    intro s
    induction s using Finset.induction_on with
    | empty => exact map_zero (stalkRingValue (stdChart N i) ⟨y.1, hW_of_le N hV y⟩)
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, ← ih]
      exact secVal_add _ _ _ _ _
  exact this Finset.univ

/-- A neighbourhood of `x` in `V` whose points have coordinates in a given open set. -/
private lemma exists_opens_coords_mem {i : Fin (N + 1)} {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (x : V) {T : Set (Fin N → ℂ)} (hT : IsOpen T)
    (hx : (stdChart N i).coords ⟨x.1, hW_of_le N hV x⟩ ∈ T) :
    ∃ (V' : Opens (space (PP N))) (h : V' ≤ V), x.1 ∈ V' ∧
      ∀ y : V', (stdChart N i).coords ⟨y.1, hW_of_le N (h.trans hV) y⟩ ∈ T := by
  let C := ComplexPoints.chart (sX := sP N) (stdChart N i).U
  have hC : IsOpen C := (stdChart N i).isOpen_chart_and_isEmbedding_coords.1
  let O : Set C := {y | y.1 ∈ V ∧ (stdChart N i).coords y ∈ T}
  have hO : IsOpen O :=
    (@Continuous.isOpen_preimage _ _ _ _ _ continuous_subtype_val _ V.isOpen).inter
      (hT.preimage (isOpenEmbedding_coords (stdChart N i) (stdChart_ideal N i)).continuous)
  let V' : Opens (space (PP N)) := ⟨Subtype.val '' O, hC.isOpenMap_subtype_val _ hO⟩
  have hV'V : V' ≤ V := by rintro _ ⟨y, hy, rfl⟩; exact hy.1
  refine ⟨V', hV'V, ⟨⟨x.1, hW_of_le N hV x⟩, ⟨x.2, hx⟩, rfl⟩, fun y => ?_⟩
  obtain ⟨z, hz, hzy⟩ := y.2
  have : z = ⟨y.1, hW_of_le N (hV'V.trans hV) y⟩ := Subtype.ext hzy
  subst this
  exact hz.2

open Filter Topology in
/-- **`c / xᵢ` is a non-zero-divisor modulo independent forms.** If `ψ₀, …, ψ_n` are linearly
independent and `(ψ_n / xᵢ) r` lies in the ideal of the `ψ_k / xᵢ`, `k < n`, then so does `r`,
near every point. -/
private lemma exists_eq_sum_gF_of_gF_mul {i : Fin (N + 1)} {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (x : V) {n : ℕ} (ψ : Fin (n + 1) → Form N) (hψ : LinearIndependent ℂ ψ)
    (r : (RR N).obj.obj (op V)) (b : Fin n → (RR N).obj.obj (op V))
    (h : (RR N).obj.map (homOfLE hV).op (gF N (ψ (Fin.last n)) i) * r =
      ∑ k, (RR N).obj.map (homOfLE hV).op (gF N (ψ (Fin.castSucc k)) i) * b k) :
    ∃ (V' : Opens (space (PP N))) (h' : V' ≤ V), x.1 ∈ V' ∧
      ∃ b' : Fin n → (RR N).obj.obj (op V'), (RR N).obj.map (homOfLE h').op r =
        ∑ k, (RR N).obj.map (homOfLE (h'.trans hV)).op (gF N (ψ (Fin.castSucc k)) i) * b' k := by
  classical
  set p : Fin N → ℂ := coordsN i ⟨x.1, hW_of_le N hV x⟩
  set gR : Form N → (RR N).obj.obj (op V) := fun c => (RR N).obj.map (homOfLE hV).op (gF N c i)
  have hres : ∀ {V' : Opens (space (PP N))} (h' : V' ≤ V) (c : Form N),
      (RR N).obj.map (homOfLE h').op (gR c) =
        (RR N).obj.map (homOfLE (h'.trans hV)).op (gF N c i) := fun h' c =>
    CoherentAnalytic.resA_resA hV h' (gF N c i)
  by_cases hA : ∃ k, aff N (ψ (Fin.castSucc k)) i p ≠ 0
  · obtain ⟨k, hk⟩ := hA
    obtain ⟨V', h', hx', u, hu⟩ := exists_isUnit_resA N hV (gR (ψ (Fin.castSucc k))) x
      (by rw [val_gR]; exact hk)
    refine ⟨V', h', hx', Pi.single k (↑u⁻¹ * (RR N).obj.map (homOfLE h').op r), ?_⟩
    rw [Fintype.sum_eq_single k fun k' hk' => by rw [Pi.single_eq_of_ne hk', mul_zero],
      Pi.single_eq_same, ← hres h', ← hu, ← mul_assoc, Units.mul_inv, one_mul]
  by_cases hB : aff N (ψ (Fin.last n)) i p ≠ 0
  · obtain ⟨V', h', hx', u, hu⟩ := exists_isUnit_resA N hV (gR (ψ (Fin.last n))) x
      (by rw [val_gR]; exact hB)
    refine ⟨V', h', hx', fun k => ↑u⁻¹ * (RR N).obj.map (homOfLE h').op (b k), ?_⟩
    have e2 : (RR N).obj.map (homOfLE h').op (∑ k, gR (ψ (Fin.castSucc k)) * b k) =
        ∑ k, (RR N).obj.map (homOfLE (h'.trans hV)).op (gF N (ψ (Fin.castSucc k)) i) *
          (RR N).obj.map (homOfLE h').op (b k) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul, hres]
    have e1 : (RR N).obj.map (homOfLE h').op (gR (ψ (Fin.last n)) * r) =
        (u : (RR N).obj.obj (op V')) * (RR N).obj.map (homOfLE h').op r := by
      rw [map_mul, hu]
    calc (RR N).obj.map (homOfLE h').op r
        = (↑u⁻¹ * ↑u : (RR N).obj.obj (op V')) * (RR N).obj.map (homOfLE h').op r := by
          rw [Units.inv_mul, one_mul]
      _ = ↑u⁻¹ * (RR N).obj.map (homOfLE h').op (∑ k, gR (ψ (Fin.castSucc k)) * b k) := by
          rw [mul_assoc, ← e1]
          exact congrArg _ (congrArg _ h)
      _ = _ := by
          rw [e2, Finset.mul_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          exact RR_mul_left_comm N _ _ _
  push Not at hA hB
  have hall : ∀ j, aff N (ψ j) i p = 0 := fun j => Fin.lastCases hB (fun k => hA k) j
  have hφ := linearIndependent_linD N ψ hψ i p hall
  have hc := stdChart_ideal N i
  have hW := hW_of_le N hV
  let f : (Fin N → ℂ) → ℂ := holFun hW r
  let hk : Fin n → (Fin N → ℂ) → ℂ := fun k => holFun hW (b k)
  let T0 : Set (Fin N → ℂ) := (stdChart N i).coords '' {y | y.1 ∈ V}
  have hT0 : IsOpen T0 := (isOpenEmbedding_coords (stdChart N i) hc).isOpenMap _
    (@Continuous.isOpen_preimage _ _ _ _ _ continuous_subtype_val _ V.isOpen)
  have hpT0 : T0 ∈ 𝓝 p := hT0.mem_nhds ⟨⟨x.1, hW x⟩, x.2, rfl⟩
  have hl : ∀ (j : Fin (n + 1)) (q : Fin N → ℂ), linD N (ψ j) i (q - p) = aff N (ψ j) i q :=
    fun j q => by rw [aff_eq N (ψ j) i p q, hall j, zero_add]
  have hlin : ∀ (j : Fin (n + 1)) (y : V), linD N (ψ j) i (coordsN i ⟨y.1, hW y⟩ - p) =
      val N hV ((RR N).obj.map (homOfLE hV).op (gF N (ψ j) i)) y := fun j y =>
    (hl j _).trans (val_gR N hV (ψ j) y).symm
  have hf : ∀ᶠ q in 𝓝 p, DifferentiableAt ℂ f q := by
    filter_upwards [hpT0] with q hq
    obtain ⟨y, hy, rfl⟩ := hq
    exact differentiableAt_holFun hc hW r ⟨y.1, hy⟩
  have heq : ∀ᶠ q in 𝓝 p, linD N (ψ (Fin.last n)) i (q - p) * f q =
      ∑ k, linD N (ψ (Fin.castSucc k)) i (q - p) * hk k q := by
    filter_upwards [hpT0] with q hq
    obtain ⟨y, hy, rfl⟩ := hq
    let x' : V := ⟨y.1, hy⟩
    have key := (val_mul N hV _ _ x').symm.trans
      ((congrArg (fun z => val N hV z x') h).trans (val_sum N hV _ x'))
    change linD N (ψ (Fin.last n)) i (coordsN i ⟨x'.1, hW x'⟩ - p) *
        holFun hW r (coordsN i ⟨x'.1, hW x'⟩) =
      ∑ k, linD N (ψ (Fin.castSucc k)) i (coordsN i ⟨x'.1, hW x'⟩ - p) *
        holFun hW (b k) (coordsN i ⟨x'.1, hW x'⟩)
    refine (congrArg₂ (· * ·) (hlin _ x') (holFun_coords hc hW r x')).trans
      (key.trans (Finset.sum_congr rfl fun k _ => ?_))
    exact (val_mul N hV _ _ x').trans
      (congrArg₂ (· * ·) (hlin _ x') (holFun_coords hc hW (b k) x')).symm
  obtain ⟨g, hgd, hgeq⟩ := exists_eq_sum_mul_of_mul_eq_sum_mul (fun j => linD N (ψ j) i) hφ p f hk
    hf heq
  have hP : ∀ᶠ q in 𝓝 p, q ∈ T0 ∧ (∀ k, DifferentiableAt ℂ (g k) q) ∧
      f q = ∑ k, linD N (ψ (Fin.castSucc k)) i (q - p) * g k q :=
    (show ∀ᶠ q in 𝓝 p, q ∈ T0 from hpT0).and ((eventually_all.2 hgd).and hgeq)
  obtain ⟨T, hTP, hTo, hpT⟩ := eventually_nhds_iff.1 hP
  obtain ⟨V', h', hx', hV'T⟩ := exists_opens_coords_mem N hV x hTo hpT
  have hW' := hW_of_le N (h'.trans hV)
  choose b' hb' using fun k => exists_sections_secVal_eq (c := stdChart N i) hW' hTo (g k)
    (fun q hq => ((hTP q hq).2.1 k).differentiableWithinAt) hV'T
  refine ⟨V', h', hx', b', ?_⟩
  refine eq_of_secVal_eq hc hW' _ _ fun y => ?_
  have e1 : secVal ((RR N).obj.map (homOfLE h').op r : sections (sP N) V') y (stdChart N i)
      (hW' y) = f ((stdChart N i).coords ⟨y.1, hW' y⟩) :=
    (holFun_coords hc hW r ⟨y.1, h' y.2⟩).symm
  refine e1.trans (((hTP _ (hV'T y)).2.2).trans ?_)
  refine Eq.trans ?_ (val_sum N (h'.trans hV) _ y).symm
  refine Finset.sum_congr rfl fun k _ => ?_
  refine Eq.trans (congrArg₂ (· * ·) (hl _ _) rfl) ?_
  refine Eq.trans ?_ (val_mul N (h'.trans hV) _ _ y).symm
  exact congrArg₂ (· * ·) (val_gR N (h'.trans hV) _ y).symm (hb' k y).symm

end Units

/-! ### Generation near a point modulo the maximal ideal -/

section Nakayama

open CoherentAnalytic MMP.Analytic.ProjectiveTwists

attribute [local instance] locallyOfFiniteType_sP

/-- Evaluation at a point of an open of a chart, as a ring homomorphism. -/
private def valHom {i : Fin (N + 1)} {V : Opens (space (PP N))} (hV : V ≤ U N i) (y : V) :
    (RR N).obj.obj (op V) →+* ℂ where
  toFun f := val N hV f y
  map_one' := val_one N hV y
  map_mul' f g := val_mul N hV f g y
  map_zero' := map_zero (stalkRingValue (stdChart N i) ⟨y.1, hW_of_le N hV y⟩)
  map_add' f g := secVal_add _ _ _ _ _

/-- The commutative ring of functions on an open of `P^an`. -/
@[instance_reducible] private def commRR (V : Opens (space (PP N))) :
    CommRing ((RR N).obj.obj (op V)) :=
  { (inferInstance : Ring ((RR N).obj.obj (op V))) with mul_comm := RR_mul_comm N }

/-- **Generation near a point.** If finitely many global sections of a sheaf of finite type
generate it near `x` modulo combinations with coefficients vanishing at `x`, they generate it on a
neighbourhood of `x`. -/
private lemma exists_genOn_of_generates_mod {S : Md N} (hS : SheafOfModules.IsFiniteType.{0} S)
    (i : Fin (N + 1)) {x : space (PP N)} (hxi : x ∈ U N i) {r : ℕ} (s : Fin r → S.val.obj (op ⊤))
    (H : ∀ (V : Opens (space (PP N))) (t : S.val.obj (op V)), x ∈ V →
      ∃ (V' : Opens (space (PP N))) (hV' : V' ≤ V ⊓ U N i) (hx : x ∈ V')
        (a : Fin r → (RR N).obj.obj (op V')) (m : ℕ) (b : Fin m → (RR N).obj.obj (op V'))
        (u : Fin m → S.val.obj (op V')),
        (∀ j, val N (hV'.trans inf_le_right) (b j) ⟨x, hx⟩ = 0) ∧
        resM S (hV'.trans inf_le_left) t =
          ∑ k, a k • resM S (le_top : V' ≤ ⊤) (s k) + ∑ j, b j • u j) :
    ∃ W : Opens (space (PP N)), x ∈ W ∧ GenOn N S s W := by
  obtain ⟨W0, hxW0, q, g, hg⟩ := (isFiniteType_iff_finGen S).1 hS x
  choose U' hU' hxU' a m b u hb hgl using fun l => H W0 (g l) hxW0
  have hU'W0 : ∀ l, U' l ≤ W0 := fun l => (hU' l).trans inf_le_left
  choose U'' hU'' hxU'' C hC using fun (p : Σ l, Fin (m l)) =>
    hg.exists_nhds (hU'W0 p.1) (u p.1 p.2) (hxU' p.1)
  obtain ⟨W1a, hxW1a, hW1a⟩ := exists_le_of_forall_mem (ι := Σ l, Fin (m l)) U'' hxU''
  obtain ⟨W1b, hxW1b, hW1b⟩ := exists_le_of_forall_mem (ι := Fin q) U' hxU'
  let W1 := W1a ⊓ W1b ⊓ (W0 ⊓ U N i)
  have hxW1 : x ∈ W1 := ⟨⟨hxW1a, hxW1b⟩, hxW0, hxi⟩
  have h1U' : ∀ l, W1 ≤ U' l := fun l => (inf_le_left.trans inf_le_right).trans (hW1b l)
  have h1U'' : ∀ p, W1 ≤ U'' p := fun p => (inf_le_left.trans inf_le_left).trans (hW1a p)
  have h1W0 : W1 ≤ W0 := inf_le_right.trans inf_le_left
  have h1i : W1 ≤ U N i := inf_le_right.trans inf_le_right
  let G : Fin q → S.val.obj (op W1) := fun l => resM S h1W0 (g l)
  let σ : Fin r → S.val.obj (op W1) := fun k => resM S (le_top : W1 ≤ ⊤) (s k)
  let α : Fin q → Fin r → (RR N).obj.obj (op W1) := fun l k => resA (h1U' l) (a l k)
  let β : Fin q → Fin q → (RR N).obj.obj (op W1) :=
    fun l k => ∑ j, resA (h1U' l) (b l j) * resA (h1U'' ⟨l, j⟩) (C ⟨l, j⟩ k)
  have hu : ∀ l j, resM S (h1U' l) (u l j) = ∑ k, resA (h1U'' ⟨l, j⟩) (C ⟨l, j⟩ k) • G k := by
    intro l j
    have e := congrArg (resM S (h1U'' ⟨l, j⟩)) (hC ⟨l, j⟩)
    rw [resM_resM, resM_sum_smul] at e
    simp only [resM_resM] at e
    exact e
  have hG : ∀ l, G l = ∑ k, α l k • σ k + ∑ k, β l k • G k := by
    intro l
    have e := congrArg (resM S (h1U' l)) (hgl l)
    rw [resM_resM, resM_add, resM_sum_smul, resM_sum_smul] at e
    simp only [resM_resM, hu] at e
    refine e.trans ?_
    congr 1
    exact sum_smul_sum_smul _ _ _
  have hβ : ∀ l k, valHom N h1i ⟨x, hxW1⟩ (β l k) = 0 := by
    intro l k
    simp only [β, map_sum, map_mul]
    refine Finset.sum_eq_zero fun j _ => ?_
    have e1 : valHom N h1i ⟨x, hxW1⟩ (resA (h1U' l) (b l j)) =
        val N ((hU' l).trans inf_le_right) (b l j) ⟨x, hxU' l⟩ := rfl
    rw [e1, hb, zero_mul]
  letI := commRR N W1
  let D : (RR N).obj.obj (op W1) := (1 - Matrix.of β).det
  have hD : val N h1i D ⟨x, hxW1⟩ = 1 := by
    change valHom N h1i ⟨x, hxW1⟩ D = 1
    rw [RingHom.map_det]
    have : (valHom N h1i ⟨x, hxW1⟩).mapMatrix (1 - Matrix.of β) = 1 := by
      ext l k
      simp [Matrix.one_apply, hβ]
    rw [this, Matrix.det_one]
  obtain ⟨W2, h21, hxW2, hD2⟩ :=
    exists_isUnit_resA N h1i D ⟨x, hxW1⟩ (by rw [hD]; exact one_ne_zero)
  let G' : Fin q → S.val.obj (op W2) := fun l => resM S h21 (G l)
  let σ' : Fin r → S.val.obj (op W2) := fun k => resM S h21 (σ k)
  let β' : Fin q → Fin q → (RR N).obj.obj (op W2) := fun l k => resA h21 (β l k)
  have hG' : ∀ l, G' l = ∑ k, resA h21 (α l k) • σ' k + ∑ k, β' l k • G' k := by
    intro l
    simp only [G', σ', β']
    conv_lhs => rw [hG l]
    rw [resM_add, resM_sum_smul, resM_sum_smul]
  letI := commRR N W2
  obtain ⟨Ninv, hN⟩ : ∃ Ninv : Matrix (Fin q) (Fin q) ((RR N).obj.obj (op W2)),
      Ninv * (1 - Matrix.of β') = 1 := by
    have hdet : IsUnit (1 - Matrix.of β').det := by
      have e : (1 - Matrix.of β') =
          (((RR N).obj.map (homOfLE h21).op).hom : (RR N).obj.obj (op W1) →+*
            (RR N).obj.obj (op W2)).mapMatrix (1 - Matrix.of β) := by
        ext l k
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.sub_apply, Matrix.one_apply,
          Matrix.of_apply, map_sub, β']
        split_ifs <;> simp only [map_one, map_zero] <;> rfl
      rw [e, ← RingHom.map_det]
      exact hD2
    exact ⟨_, Matrix.nonsing_inv_mul _ hdet⟩
  obtain ⟨γ, hγ⟩ := exists_eq_sum_smul_of_eq_add G' σ' _ β' hG' Ninv hN
  refine ⟨W2, hxW2, locallyGenerates_of_nhds _ fun V hV t y hy => ?_⟩
  obtain ⟨U3, h3, hy3, c, hc⟩ := hg.exists_nhds (hV.trans (h21.trans h1W0)) t hy
  refine ⟨U3, h3, hy3, fun k => ∑ l, c l * resA (h3.trans hV) (γ l k), ?_⟩
  rw [hc]
  have key : ∀ l, resM S (h3.trans (hV.trans (h21.trans h1W0))) (g l) =
      ∑ k, resA (h3.trans hV) (γ l k) • resM S (le_top : U3 ≤ ⊤) (s k) := by
    intro l
    have e := congrArg (resM S (h3.trans hV)) (hγ l)
    simp only [G', σ', G, σ, resM_resM] at e
    rw [resM_sum_smul] at e
    simp only [resM_resM] at e
    exact e
  simp only [key, resM_resM]
  exact sum_smul_sum_smul _ _ _

end Nakayama

/-! ### Sections of tensor products -/

section TensorLocal

open CoherentAnalytic

/-- The image in `A ⊗ B` of a pure tensor of local sections. -/
private abbrev tmul {A B : Md N} {V : Opens (space (PP N))} (a : A.val.obj (op V))
    (b : B.val.obj (op V)) : (A ⊗ B).val.obj (op V) :=
  (PresheafOfModules.tensorSheafUnit A B).app (op V) (a ⊗ₜ b)

private lemma tmul_smul_left {A B : Md N} {V : Opens (space (PP N))}
    (r : (RR N).obj.obj (op V)) (a : A.val.obj (op V)) (b : B.val.obj (op V)) :
    tmul N (r • a) b = r • tmul N a b := by
  refine Eq.trans ?_ (map_smul ((PresheafOfModules.tensorSheafUnit A B).app (op V)).hom r _)
  exact congrArg (fun z => ((PresheafOfModules.tensorSheafUnit A B).app (op V)) z)
    (TensorProduct.smul_tmul' r a b).symm

private lemma tmul_smul_right {A B : Md N} {V : Opens (space (PP N))}
    (r : (RR N).obj.obj (op V)) (a : A.val.obj (op V)) (b : B.val.obj (op V)) :
    tmul N a (r • b) = r • tmul N a b := by
  refine Eq.trans ?_ (map_smul ((PresheafOfModules.tensorSheafUnit A B).app (op V)).hom r _)
  exact congrArg (fun z => ((PresheafOfModules.tensorSheafUnit A B).app (op V)) z)
    (TensorProduct.tmul_smul r a b)

private lemma tmul_zero_left {A B : Md N} {V : Opens (space (PP N))} (b : B.val.obj (op V)) :
    tmul N (0 : A.val.obj (op V)) b = 0 :=
  (congrArg (fun z => ((PresheafOfModules.tensorSheafUnit A B).app (op V)) z)
    (TensorProduct.zero_tmul _ b)).trans (map_zero _)

private lemma res_tmul {A B : Md N} {V V' : Opens (space (PP N))} (h : V' ≤ V)
    (a : A.val.obj (op V)) (b : B.val.obj (op V)) :
    resM (A ⊗ B) h (tmul N a b) = tmul N (resM A h a) (resM B h b) :=
  (PresheafOfModules.naturality_apply (PresheafOfModules.tensorSheafUnit A B) (homOfLE h).op
    (a ⊗ₜ b)).symm

/-- The sections of `A ⊗ B` are locally finite sums of pure tensors. -/
private lemma exists_eq_sum_tmul {A B : Md N} {V : Opens (space (PP N))}
    (w : (A ⊗ B).val.obj (op V)) {y : space (PP N)} (hy : y ∈ V) :
    ∃ (V' : Opens (space (PP N))) (hV' : V' ≤ V), y ∈ V' ∧ ∃ (n : ℕ)
      (a : Fin n → A.val.obj (op V')) (b : Fin n → B.val.obj (op V')),
      resM (A ⊗ B) hV' w = ∑ l, tmul N (a l) (b l) := by
  have hls : Presheaf.IsLocallySurjective (Opens.grothendieckTopology (space (PP N)))
      ((PresheafOfModules.toPresheaf _).map (PresheafOfModules.tensorSheafUnit A B)) := by
    change Presheaf.IsLocallySurjective _ (CategoryTheory.toSheafify _
      ((PresheafOfModules.toPresheaf _).obj (A.val.tensorObj B.val)))
    infer_instance
  obtain ⟨V', f, ⟨u, hu⟩, hyV'⟩ := (Opens.mem_grothendieckTopology _).1
    (hls.imageSieve_mem w) y hy
  obtain ⟨n, a, b, hab⟩ := TensorProduct.exists_sum_tmul_eq u
  refine ⟨V', f.le, hyV', n, a, b, hu.symm.trans ?_⟩
  rw [hab]
  exact map_sum ((PresheafOfModules.tensorSheafUnit A B).app (op V')).hom _ Finset.univ

end TensorLocal

/-! ### Sheaves annihilated by linear forms -/

section KilledLemmas

open CoherentAnalytic

private lemma Killed.kernel {c : Form N} {M Q : Md N} (g : M ⟶ Q)
    (h : Killed N c M) : Killed N c (Limits.kernel g) := by
  intro j V hV m
  refine OkaCoherence.kernel_ι_app_injective g (op V) ?_
  refine (map_smul ((Limits.kernel.ι g).val.app (op V)).hom _ m).trans ?_
  exact (h j V hV _).trans (map_zero _).symm

private lemma Killed.of_epi {c : Form N} {M M' : Md N} (π : M ⟶ M') [Epi π]
    (h : Killed N c M) : Killed N c M' := by
  intro j V hV m
  refine eq_zero_of_locally_eq_zero M' _ fun y hy => ?_
  obtain ⟨S, hS, hlift⟩ := OkaCoherence.exists_local_lift π m
  obtain ⟨V', f, hf, hyV'⟩ := (Opens.mem_grothendieckTopology _).1 hS y hy
  obtain ⟨t, ht⟩ := hlift f hf
  refine ⟨V', f.le, hyV', ?_⟩
  rw [resM_smul, resA_resA]
  change _ • M'.val.map f.op m = 0
  rw [← ht]
  exact (map_smul (π.val.app (op V')).hom _ t).symm.trans
    ((congrArg _ (h j V' (f.le.trans hV) t)).trans (map_zero _))

private lemma Killed.tensor_left {c : Form N} {A : Md N} (h : Killed N c A) (B : Md N) :
    Killed N c (A ⊗ B) := by
  intro j V hV w
  refine eq_zero_of_locally_eq_zero (A ⊗ B) _ fun y hy => ?_
  obtain ⟨V', hV', hyV', n, a, b, hab⟩ := exists_eq_sum_tmul N w hy
  refine ⟨V', hV', hyV', ?_⟩
  rw [resM_smul, resA_resA, hab, Finset.smul_sum]
  refine Finset.sum_eq_zero fun l _ => ?_
  rw [← tmul_smul_left, h j V' (hV'.trans hV) (a l)]
  exact tmul_zero_left N (b l)

private lemma KilledBy.tensor_left {W : Finset (Form N)} {A : Md N} (h : KilledBy N W A)
    (B : Md N) : KilledBy N W (A ⊗ B) := fun c hc => (h c hc).tensor_left N B

/-- A sheaf annihilated by `c` vanishes near every point where `c` does not vanish. -/
private lemma Killed.exists_eq_zero {c : Form N} {M : Md N} (h : Killed N c M) {x : space (PP N)}
    (hx : ev N c x ≠ 0) : ∃ V : Opens (space (PP N)), x ∈ V ∧
      ∀ (Y : Opens (space (PP N))) (_ : Y ≤ V) (m : M.val.obj (op Y)), m = 0 := by
  set i := iOf N x
  have hxU := mem_U_iOf N x
  have hval : val N (le_refl (U N i)) (gF N c i) ⟨x, hxU⟩ ≠ 0 := by
    intro h0
    exact hx ((ev_eq_zero_iff N c i ⟨x, hxU⟩).2 h0)
  obtain ⟨V', hV', hxV', hu⟩ := exists_isUnit_resA N (le_refl (U N i)) (gF N c i) ⟨x, hxU⟩ hval
  refine ⟨V', hxV', fun Y hY m => ?_⟩
  have hm := h i Y (hY.trans hV') m
  have hu' : IsUnit ((RR N).obj.map (homOfLE hY).op ((RR N).obj.map (homOfLE hV').op (gF N c i))) :=
    hu.map _
  obtain ⟨u, hu''⟩ := hu'
  have : (RR N).obj.map (homOfLE (hY.trans hV')).op (gF N c i) = u :=
    (resA_resA hV' hY (gF N c i)).symm.trans hu''.symm
  rw [this] at hm
  calc m = (u⁻¹ * u : (RR N).obj.obj (op Y)) • m := by rw [Units.inv_mul, one_smul]
    _ = 0 := by rw [mul_smul, hm, smul_zero]

end KilledLemmas

/-! ### The twisting sheaves and the sections of linear forms -/

section Twists

open CoherentAnalytic MMP.Analytic.ProjectiveTwists

attribute [local instance] locallyOfFiniteType_sP

/-- `𝒪(a)^an ⊗ 𝒪(b)^an ≅ 𝒪(a + b)^an`. -/
private def tensorLIso (a b : ℤ) : L N a ⊗ L N b ≅ L N (a + b) :=
  ((analytification_stalks (PP N)).2.2.2.2.2.1 _ _).choose.symm ≪≫
    (analytifyModule (PP N)).mapIso
      (@asIso _ _ _ _ (Stacks.AlgebraicGeometry.ProjInvertibleLocus.twistMultiplicationMap
        (polyGrading ℂ N) a b)
        (Stacks.AlgebraicGeometry.ProjRepresentsF1.isIso_twistMultiplicationMap_of_adjoin
          (polyGrading ℂ N)
          (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin (N + 1)) ℂ) a b))

/-- The morphism `𝒪 ⟶ 𝒪(1)^an` of the linear form `c`. -/
private def sHom (c : Form N) : 𝟙_ (Md N) ⟶ L N 1 :=
  (L N 1).unitHomEquiv.symm (topSection N (L N 1) (anSec N c))

private lemma sHom_app (c : Form N) (Y : Opens (space (PP N))) (r : (RR N).obj.obj (op Y)) :
    (sHom N c).val.app (op Y) r = r • resM (L N 1) (le_top : Y ≤ ⊤) (anSec N c) := rfl

/-- On the chart `Uᵢ`, `𝒪(1)^an` is generated by the section `xᵢ`. -/
private lemma exists_eq_smul_anSec (i : Fin (N + 1)) {Y : Opens (space (PP N))} (hY : Y ≤ U N i)
    (l : (L N 1).val.obj (op Y)) :
    ∃ a : (RR N).obj.obj (op Y),
      l = a • resM (L N 1) (le_top : Y ≤ ⊤) (anSec N (Pi.single i 1)) := by
  set g := gF N (Pi.single i 1) i
  have hg : IsUnit g := isUnit_of_val_ne_zero N le_rfl g fun y => by
    change secVal (gF N (Pi.single i 1) i) y (stdChart N i) (mem_chart_of_U N y) ≠ 0
    rw [secVal_gF]
    simp only [Pi.single_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ,
      if_true]
    rw [hcoord_self]
    exact one_ne_zero
  obtain ⟨u, hu⟩ := hg
  obtain ⟨a₀, ha₀⟩ := (bijective_smul_uSec N 1 i Y (hY.trans (U_le N i))).2 l
  let a₀' : (RR N).obj.obj (op Y) := a₀
  have ha₀' : a₀' • resM (L N 1) (hY.trans (U_le N i)) (uSec N 1 i) = l := ha₀
  refine ⟨a₀' * resA hY (↑u⁻¹ : (RR N).obj.obj (op (U N i))), ?_⟩
  have e1 : resM (L N 1) (le_top : Y ≤ ⊤) (anSec N (Pi.single i 1)) =
      resA hY g • resM (L N 1) (hY.trans (U_le N i)) (uSec N 1 i) :=
    (resM_resM (L N 1) le_top hY _).symm.trans ((congrArg (resM (L N 1) hY)
      (gF_smul N (Pi.single i 1) i).symm).trans ((resM_smul _ hY _ _).trans
        (congrArg _ (resM_resM _ _ _ _))))
  have h1 : resA hY (1 : (RR N).obj.obj (op (U N i))) = 1 := map_one _
  rw [e1, smul_smul, mul_assoc, ← resA_mul, ← hu, Units.inv_mul, h1, mul_one]
  exact ha₀'.symm

/-- `𝒪(0)^an ≅ 𝒪`. -/
private def LzeroIso : L N 0 ≅ 𝟙_ (Md N) :=
  haveI := Stacks.Topology.final_opensMap (toSchemeHom (PP N))
  (analytifyModule (PP N)).mapIso
      (Stacks.AlgebraicGeometry.ProjEulerSequence.twistingSheafZeroIsoUnit _) ≪≫
    @asIso _ _ _ _ (SheafOfModules.pullbackObjUnitToUnit (ringCatSheafHom (PP N)))
      (SheafOfModules.instIsIsoPullbackObjUnitToUnitOfFinal (ringCatSheafHom (PP N)))

/-- `𝒪(k)^an ⊗ 𝒪(-k)^an ≅ 𝒪`. -/
private def LinvIso (k : ℤ) : L N k ⊗ L N (-k) ≅ 𝟙_ (Md N) :=
  tensorLIso N k (-k) ≪≫ eqToIso (congrArg (L N) (add_neg_cancel k)) ≪≫ LzeroIso N

/-- `𝒪(-k)^an ⊗ 𝒪(k)^an ≅ 𝒪`. -/
private def LinvIso' (k : ℤ) : L N (-k) ⊗ L N k ≅ 𝟙_ (Md N) :=
  tensorLIso N (-k) k ≪≫ eqToIso (congrArg (L N) (neg_add_cancel k)) ≪≫ LzeroIso N

/-- Twisting by `𝒪(k)^an` is an autoequivalence. -/
private def twEquiv (k : ℤ) : Md N ≌ Md N :=
  CategoryTheory.Equivalence.mk (tensorRight (L N k)) (tensorRight (L N (-k)))
    (NatIso.ofComponents (fun M => (ρ_ M).symm ≪≫ whiskerLeftIso M (LinvIso N k).symm ≪≫
      (α_ M (L N k) (L N (-k))).symm) (fun {M M'} f => by
        simp only [Functor.id_obj, Functor.comp_obj, Functor.id_map,
          Iso.trans_hom, Iso.symm_hom, whiskerLeftIso_hom, Category.assoc, Functor.comp_map]
        rw [rightUnitor_inv_naturality_assoc, ← whisker_exchange_assoc,
          associator_inv_naturality_left]
        rfl))
    (NatIso.ofComponents (fun M => α_ M (L N (-k)) (L N k) ≪≫ whiskerLeftIso M (LinvIso' N k) ≪≫
      ρ_ M) (fun {M M'} f => by
        simp only [Functor.comp_obj, Functor.id_obj, Functor.comp_map,
          Iso.trans_hom, whiskerLeftIso_hom, Category.assoc, Functor.id_map]
        change (f ▷ L N (-k)) ▷ L N k ≫ _ = _
        rw [associator_naturality_left_assoc, ← whisker_exchange_assoc, rightUnitor_naturality]))

private lemma preservesFiniteLimits_tw (k : ℤ) : PreservesFiniteLimits (tensorRight (L N k)) :=
  inferInstanceAs (PreservesFiniteLimits (twEquiv N k).functor)

private lemma preservesFiniteColimits_tw (k : ℤ) :
    PreservesFiniteColimits (tensorRight (L N k)) :=
  inferInstanceAs (PreservesFiniteColimits (twEquiv N k).functor)

/-- Twisting preserves short exact sequences. -/
private lemma preservesZeroMorphisms_tw (k : ℤ) :
    (tensorRight (L N k)).PreservesZeroMorphisms :=
  inferInstanceAs ((twEquiv N k).functor.PreservesZeroMorphisms)

private lemma ShortComplex.ShortExact.tw {S : ShortComplex (Md N)} (hS : S.ShortExact) (k : ℤ) :
    haveI := preservesZeroMorphisms_tw N k
    (S.map (tensorRight (L N k))).ShortExact :=
  haveI := preservesZeroMorphisms_tw N k
  haveI := preservesFiniteLimits_tw N k
  haveI := preservesFiniteColimits_tw N k
  hS.map_of_exact _

/-- Right multiplication by the section `xᵢ` is surjective on sections over `Uᵢ`. -/
private lemma locSurjOn_whiskerLeft (X : Md N) (i : Fin (N + 1)) :
    LocSurjOn N (X ◁ sHom N (Pi.single i 1)) (U N i) := by
  intro Y hY b y hy
  obtain ⟨Y', hY', hyY', n, a, l, hal⟩ := exists_eq_sum_tmul N b hy
  choose r hr using fun k => exists_eq_smul_anSec N i (hY'.trans hY) (l k)
  refine ⟨Y', hY', hyY', ∑ k, tmul N (r k • a k) (1 : (RR N).obj.obj (op Y')), ?_⟩
  rw [map_sum, hal]
  refine Finset.sum_congr rfl fun k _ => ?_
  refine (Stacks.TensorSheafWorld.whiskerLeft_val_app_tensorSheafUnit (structureSheaf (PP N))
    (Sheaf.toRingCat _ (structureSheaf (PP N))).property (op Y') X (sHom N (Pi.single i 1))
    (r k • a k) (1 : (RR N).obj.obj (op Y'))).trans ?_
  have e2 : (sHom N (Pi.single i 1)).val.app (op Y') (1 : (RR N).obj.obj (op Y')) =
      resM (L N 1) le_top (anSec N (Pi.single i 1)) := (sHom_app N _ Y' 1).trans (one_smul _ _)
  refine (congrArg (fun z => tmul N (r k • a k) z) e2).trans ?_
  refine (tmul_smul_left N _ _ _).trans ?_
  exact ((congrArg (tmul N (a k)) (hr k)).trans (tmul_smul_right N _ _ _)).symm

/-- Multiplication by `xᵢ`, `M(k) ⟶ M(k + 1)`. -/
private def twMul (M : Md N) (k : ℤ) (i : Fin (N + 1)) : tw N k M ⟶ tw N (k + 1) M :=
  (ρ_ (tw N k M)).inv ≫ (tw N k M ◁ sHom N (Pi.single i 1)) ≫ (α_ M (L N k) (L N 1)).hom ≫
    (M ◁ (tensorLIso N k 1).hom)

private lemma locSurjOn_twMul (M : Md N) (k : ℤ) (i : Fin (N + 1)) :
    LocSurjOn N (twMul N M k i) (U N i) :=
  (locSurjOn_of_isIso N _ _).comp N ((locSurjOn_whiskerLeft N _ i).comp N
    ((locSurjOn_of_isIso N _ _).comp N (locSurjOn_of_isIso N _ _)))

private lemma GenAt.tw_succ {M : Md N} {k : ℤ} {x : space (PP N)} (h : GenAt N (tw N k M) x) :
    GenAt N (tw N (k + 1) M) x := by
  obtain ⟨V, hx, n, t, ht⟩ := h
  exact ⟨V ⊓ U N (iOf N x), ⟨hx, mem_U_iOf N x⟩, n, _,
    ht.map N (twMul N M k (iOf N x)) (locSurjOn_twMul N M k (iOf N x))⟩

private lemma GenAt.tw_le {M : Md N} {k k' : ℤ} (hk : k ≤ k') {x : space (PP N)}
    (h : GenAt N (tw N k M) x) : GenAt N (tw N k' M) x := by
  obtain ⟨n, rfl⟩ := Int.le.dest hk
  induction n with
  | zero => simpa using h
  | succ n ih =>
    have := (ih (by omega)).tw_succ N
    rwa [Nat.cast_succ, ← add_assoc]

/-- Generation near every point for some twist gives generation for all large twists. -/
private lemma exists_forall_gen_of_forall_exists {M : Md N}
    (h : ∀ x, ∃ k₁ : ℤ, GenAt N (tw N k₁ M) x) :
    ∃ k₀ : ℤ, ∀ k, k₀ ≤ k → Gen N (tw N k M) := by
  classical
  haveI := compactSpace_space N
  choose k₁ hk₁ using h
  choose V hxV n t ht using hk₁
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover (fun x => (V x : Set (space (PP N))))
    (fun x => (V x).isOpen) (fun y _ => Set.mem_iUnion.2 ⟨y, hxV y⟩)
  refine ⟨∑ x ∈ s, |k₁ x|, fun k hk => gen_of_forall_genAt N fun y => ?_⟩
  obtain ⟨x, hxs, hyx⟩ := Set.mem_iUnion₂.1 (hs (Set.mem_univ y))
  have hle : k₁ x ≤ k := by
    have h1 : |k₁ x| ≤ ∑ x ∈ s, |k₁ x| :=
      Finset.single_le_sum (f := fun x => |k₁ x|) (fun _ _ => abs_nonneg _) hxs
    exact (le_abs_self _).trans (h1.trans hk)
  exact GenAt.tw_le N hle ⟨V x, hyx, n x, t x, ht x⟩

end Twists

/-! ### Long exact cohomology sequences -/

section Cohomology

open Limits

/-- The short complex of total complexes of Godement sections of a short complex of sheaves. -/
private noncomputable abbrev tot
    (S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} (space (PP N)))) :
    ShortComplex (CochainComplex AddCommGrpCat.{0} ℤ) :=
  ShortComplex.mk
    ((HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
      (c₁₂ := ComplexShape.up ℤ)).map
        (((godementSections (space (PP N))).mapHomologicalComplex _).map
          ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map S.f)))
    ((HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
      (c₁₂ := ComplexShape.up ℤ)).map
        (((godementSections (space (PP N))).mapHomologicalComplex _).map
          ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map S.g)))
    (by
      rw [← Functor.map_comp, ← Functor.map_comp, ← Functor.map_comp, S.zero,
        Functor.map_zero, Functor.map_zero]
      ext n : 1
      exact HomologicalComplex₂.total.hom_ext _ fun _ _ _ => by
        simp <;> exact Limits.comp_zero.trans Limits.comp_zero.symm)

private lemma single_map_shortExact
    (S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} (space (PP N))))
    (hS : S.ShortExact) (i : ℤ) :
    ((S.map (HomologicalComplex.single _ (ComplexShape.up ℤ) 0)).map
      (HomologicalComplex.eval _ _ i)).ShortExact := by
  by_cases hi : i = 0
  · subst hi
    exact ShortComplex.shortExact_of_iso
      (S.mapNatIso (HomologicalComplex.singleCompEvalIsoSelf _ (ComplexShape.up ℤ) 0)).symm hS
  · have h : ∀ A : TopCat.Sheaf AddCommGrpCat.{0} (space (PP N)),
        IsZero (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj A).X i) :=
      fun A => HomologicalComplex.isZero_single_obj_X _ _ _ _ hi
    exact { exact := ShortComplex.exact_of_isZero_X₂ _ (h _)
            mono_f := (h S.X₁).mono _
            epi_g := (h S.X₃).epi _ }

private lemma tot_shortExact (S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} (space (PP N))))
    (hS : S.ShortExact) : (tot N S).ShortExact := by
  obtain ⟨-, -, ⟨-, hles, -⟩, -⟩ := sheafCohomology_toolkit.{0, 0, 0, 0, 0} (space (PP N))
  have ge : ∀ A : TopCat.Sheaf AddCommGrpCat.{0} (space (PP N)),
      CochainComplex.IsStrictlyGE ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj A) 0 :=
    fun _ => inferInstance
  have le : ∀ A : TopCat.Sheaf AddCommGrpCat.{0} (space (PP N)),
      CochainComplex.IsStrictlyLE ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj A) 0 :=
    fun _ => inferInstance
  obtain ⟨h, -⟩ := hles (S.map (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))
    (single_map_shortExact N S hS) ⟨0, 0, ge S.X₁, le S.X₁, ge S.X₂, le S.X₂, ge S.X₃, le S.X₃⟩
  exact h

/-- `H^q` of a morphism of sheaves of modules. -/
private abbrev Hmap (q : ℕ) {A B : Md N} (f : A ⟶ B) : Hq N q A ⟶ Hq N q B :=
  (sheafCohomology _ (q : ℤ)).map ((SheafOfModules.toSheaf _).map f)

/-- The underlying short complex of abelian sheaves. -/
private noncomputable abbrev toAb (S : ShortComplex (Md N)) :
    ShortComplex (Sheaf (Opens.grothendieckTopology (space (PP N))) AddCommGrpCat.{0}) :=
  S.map (SheafOfModules.toSheaf (RR N))

private lemma toAb_shortExact {S : ShortComplex (Md N)} (hS : S.ShortExact) :
    (toAb N S).ShortExact :=
  hS.map_of_exact _

variable {N} in
private lemma tot_shortExact_of {S : ShortComplex (Md N)} (hS : S.ShortExact) :
    (tot N (toAb N S)).ShortExact :=
  tot_shortExact N _ (toAb_shortExact N hS)

omit N in
private lemma sheafCohomology_preservesZeroMorphisms (T : TopCat.{0}) (q : ℤ) :
    (sheafCohomology T q).PreservesZeroMorphisms := by
  unfold sheafCohomology hypercohomology
  infer_instance

private lemma sheafCohomology_map_comp_map
    (S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} (space (PP N)))) (q : ℤ) :
    (sheafCohomology _ q).map S.f ≫ (sheafCohomology _ q).map S.g = 0 := by
  haveI := sheafCohomology_preservesZeroMorphisms (space (PP N)) q
  rw [← Functor.map_comp, S.zero]
  exact (sheafCohomology _ q).map_zero _ _

private lemma les_exact₂ {S : ShortComplex (Md N)} (hS : S.ShortExact) (q : ℕ) :
    (ShortComplex.mk (Hmap N q S.f) (Hmap N q S.g)
      (sheafCohomology_map_comp_map N (toAb N S) q)).Exact :=
  (tot_shortExact_of hS).homology_exact₂ (q : ℤ)

private lemma les_exact₃ {S : ShortComplex (Md N)} (hS : S.ShortExact) (q : ℕ) :
    (ShortComplex.mk (Hmap N q S.g) ((tot_shortExact_of hS).δ (q : ℤ) ((q + 1 : ℕ) : ℤ)
      (by simp)) ((tot_shortExact_of hS).comp_δ _ _ _)).Exact :=
  (tot_shortExact_of hS).homology_exact₃ (q : ℤ) _ _

/-- `H^q(X₂) → H^q(X₃)` is surjective when `H^{q+1}(X₁) = 0`. -/
private lemma surjective_Hmap_g_of_isZero {S : ShortComplex (Md N)} (hS : S.ShortExact) (q : ℕ)
    (h : IsZero (Hq N (q + 1) S.X₁)) : Function.Surjective (Hmap N q S.g).hom := fun y =>
  (ShortComplex.ab_exact_iff _).1 (les_exact₃ N hS q) y
    (@Subsingleton.elim (Hq N (q + 1) S.X₁) (AddCommGrpCat.subsingleton_of_isZero h) _ _)

/-- `H^q(X₁) → H^q(X₂)` is surjective when `H^q(X₃) = 0`. -/
private lemma surjective_Hmap_f_of_isZero {S : ShortComplex (Md N)} (hS : S.ShortExact) (q : ℕ)
    (h : IsZero (Hq N q S.X₃)) : Function.Surjective (Hmap N q S.f).hom := fun y =>
  (ShortComplex.ab_exact_iff _).1 (les_exact₂ N hS q) y
    (@Subsingleton.elim (Hq N q S.X₃) (AddCommGrpCat.subsingleton_of_isZero h) _ _)

/-- `H^q(X₂) → H^q(X₃)` is surjective when `H^{q+1}(X₁) → H^{q+1}(X₂)` is injective. -/
private lemma surjective_Hmap_g_of_injective {S : ShortComplex (Md N)} (hS : S.ShortExact) (q : ℕ)
    (h : Function.Injective (Hmap N (q + 1) S.f).hom) : Function.Surjective (Hmap N q S.g).hom := by
  intro y
  refine (ShortComplex.ab_exact_iff _).1 (les_exact₃ N hS q) y (h ?_)
  exact (ConcreteCategory.congr_hom ((tot_shortExact_of hS).δ_comp (q : ℤ) ((q + 1 : ℕ) : ℤ)
    (by simp)) y).trans (map_zero _).symm

/-- `H^q(X₃) = 0` when `H^q(X₂) = 0` and `H^{q+1}(X₁) = 0`. -/
private lemma les_isZero {S : ShortComplex (Md N)} (hS : S.ShortExact) (q : ℕ)
    (h₂ : IsZero (Hq N q S.X₂)) (h₁ : IsZero (Hq N (q + 1) S.X₁)) : IsZero (Hq N q S.X₃) :=
  (les_exact₃ N hS q).isZero_of_both_isZero h₂ h₁

end Cohomology

/-! ### Cohomology as a complex vector space -/

section ComplexStructure

open CoherentAnalytic MMP.Analytic.ProjectiveTwists

/-- The restriction of a global function to an open. -/
private def rT (W : (Opens (space (PP N)))ᵒᵖ) (r : (RR N).obj.obj (op ⊤)) : (RR N).obj.obj W :=
  (RR N).obj.map (homOfLE (le_top : W.unop ≤ ⊤)).op r

private lemma rT_map {W W' : (Opens (space (PP N)))ᵒᵖ} (f : W ⟶ W') (r : (RR N).obj.obj (op ⊤)) :
    (RR N).obj.map f (rT N W r) = rT N W' r := by
  simp only [rT]
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- The constant functions on `P^an`. -/
private def cst : ℂ →+* (RR N).obj.obj (op ⊤) :=
  ((ringCatSheafHom (PP N)).hom.app (op ⊤)).hom.comp (ComplexPoints.baseRingHom (PP N) ⊤)

/-- Multiplication by a global function, as an endomorphism of a sheaf of modules. -/
private def smulEnd (M : Md N) (r : (RR N).obj.obj (op ⊤)) : M ⟶ M where
  val :=
    { app := fun W => ModuleCat.ofHom
        { toFun := fun x => rT N W r • x
          map_add' := fun x y => smul_add _ x y
          map_smul' := fun a x => by
            change rT N W r • (a • x) = a • (rT N W r • x)
            rw [smul_smul, smul_smul, RR_mul_comm] }
      naturality := fun {W W'} f => by
        ext x
        change rT N W' r • M.val.map f x = M.val.map f (rT N W r • x)
        rw [PresheafOfModules.map_smul, rT_map] }

private lemma smulEnd_comp {M M' : Md N} (f : M ⟶ M') (r : (RR N).obj.obj (op ⊤)) :
    smulEnd N M r ≫ f = f ≫ smulEnd N M' r := by
  ext W x
  change f.val.app W (rT N W r • x) = rT N W r • f.val.app W x
  exact map_smul (f.val.app W).hom _ _

private lemma smulEnd_one (M : Md N) : smulEnd N M 1 = 𝟙 M := by
  ext W x
  change rT N W 1 • x = x
  rw [rT, map_one, one_smul]

private lemma smulEnd_mul (M : Md N) (r s : (RR N).obj.obj (op ⊤)) :
    smulEnd N M (r * s) = smulEnd N M s ≫ smulEnd N M r := by
  ext W x
  change rT N W (r * s) • x = rT N W r • (rT N W s • x)
  rw [rT, rT, rT, map_mul, mul_smul]

private lemma smulEnd_add (M : Md N) (r s : (RR N).obj.obj (op ⊤)) :
    smulEnd N M (r + s) = smulEnd N M r + smulEnd N M s := by
  ext W x
  change rT N W (r + s) • x = rT N W r • x + rT N W s • x
  rw [rT, rT, rT, map_add, add_smul]

private lemma smulEnd_zero (M : Md N) : smulEnd N M 0 = 0 := by
  ext W x
  change rT N W 0 • x = 0
  rw [rT, map_zero, zero_smul]

omit N in
private lemma sheafCohomology_additive (T : TopCat.{0}) (q : ℕ) :
    (sheafCohomology T (q : ℤ)).Additive := by
  obtain ⟨-, -, ⟨⟨E, -⟩, -⟩, -⟩ := sheafCohomology_toolkit.{0, 0, 0, 0, 0} T
  haveI : (globalSections T).Additive := globalSections_additive T
  exact Functor.additive_of_iso (E T q).symm

private lemma Hmap_comp (q : ℕ) {A B C : Md N} (f : A ⟶ B) (g : B ⟶ C) :
    Hmap N q (f ≫ g) = Hmap N q f ≫ Hmap N q g := by
  simp only [Hmap, Functor.map_comp]
  exact (sheafCohomology _ _).map_comp _ _

private lemma Hmap_id (q : ℕ) (A : Md N) : Hmap N q (𝟙 A) = 𝟙 _ := by
  simp only [Hmap, Functor.map_id]
  exact (sheafCohomology _ _).map_id _

private lemma Hmap_add (q : ℕ) {A B : Md N} (f g : A ⟶ B) :
    Hmap N q (f + g) = Hmap N q f + Hmap N q g := by
  haveI := sheafCohomology_additive (space (PP N)) q
  simp only [Hmap, Functor.map_add]
  exact (sheafCohomology _ _).map_add

private lemma Hmap_zero (q : ℕ) (A B : Md N) : Hmap N q (0 : A ⟶ B) = 0 := by
  haveI := sheafCohomology_additive (space (PP N)) q
  simp only [Hmap, Functor.map_zero]
  exact (sheafCohomology _ _).map_zero _ _

/-- The action of `ℂ` on `H^q(P^an, M)`. -/
private def ρH (M : Md N) (q : ℕ) : ℂ →+* AddMonoid.End (Hq N q M) where
  toFun c := (Hmap N q (smulEnd N M (cst N c))).hom
  map_one' := by
    change (Hmap N q (smulEnd N M (cst N 1))).hom = AddMonoidHom.id _
    rw [map_one, smulEnd_one, Hmap_id]
    rfl
  map_mul' a b := by
    change (Hmap N q (smulEnd N M (cst N (a * b)))).hom =
      (Hmap N q (smulEnd N M (cst N a))).hom.comp (Hmap N q (smulEnd N M (cst N b))).hom
    rw [map_mul, smulEnd_mul, Hmap_comp]
    rfl
  map_zero' := by
    change (Hmap N q (smulEnd N M (cst N 0))).hom = 0
    rw [map_zero, smulEnd_zero, Hmap_zero]
    rfl
  map_add' a b := by
    change (Hmap N q (smulEnd N M (cst N (a + b)))).hom =
      (Hmap N q (smulEnd N M (cst N a))).hom + (Hmap N q (smulEnd N M (cst N b))).hom
    rw [map_add, smulEnd_add, Hmap_add]
    rfl

/-- `H^q(P^an, M)` as a complex vector space. -/
@[instance_reducible] private def moduleHq (M : Md N) (q : ℕ) : Module ℂ (Hq N q M) :=
  Module.compHom (Hq N q M) (ρH N M q)

attribute [local instance] moduleHq

private lemma smul_Hq_def (M : Md N) (q : ℕ) (c : ℂ) (y : Hq N q M) :
    c • y = (Hmap N q (smulEnd N M (cst N c))).hom y := rfl

/-- `H^q` of a morphism, as a linear map. -/
private def HmapL (q : ℕ) {A B : Md N} (f : A ⟶ B) : Hq N q A →ₗ[ℂ] Hq N q B where
  toFun := (Hmap N q f).hom
  map_add' := map_add _
  map_smul' c y := by
    rw [smul_Hq_def, smul_Hq_def, RingHom.id_apply]
    change (Hmap N q (smulEnd N A (cst N c)) ≫ Hmap N q f).hom y =
      (Hmap N q f ≫ Hmap N q (smulEnd N B (cst N c))).hom y
    rw [← Hmap_comp, ← Hmap_comp, smulEnd_comp]

/-- Cohomology of coherent sheaves on `P^an` is finite dimensional. -/
private lemma finiteDimensional_Hq {M : Md N} (hM : IsCoherentModule M) (q : ℕ) :
    FiniteDimensional ℂ (Hq N q M) := by
  classical
  have h := projectiveSpace_finiteDimensional_sheafCohomology N
  obtain ⟨m₀, hcard⟩ := h
  obtain ⟨n, t, ht⟩ := (hcard M hM).2 (fun c => (SheafOfModules.toSheaf _).map
    (smulEnd N M (cst N c))) (fun c W x => rfl) q
  refine ⟨⟨Finset.univ.image t, eq_top_iff.2 fun y _ => ?_⟩⟩
  obtain ⟨a, ha⟩ := ht y
  rw [ha]
  refine Submodule.sum_mem _ fun i _ => ?_
  exact Submodule.smul_mem _ (a i) (Submodule.subset_span
    (Finset.mem_coe.2 (Finset.mem_image_of_mem t (Finset.mem_univ i))))

end ComplexStructure

/-! ### Coherence of twists -/

section Coherence

open CoherentAnalytic MMP.Analytic.ProjectiveTwists

/-- The generator `xᵢᵏ` of `𝒪(k)^an` on an open of the chart `Uᵢ`. -/
private abbrev uS (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))} (hV : V ≤ U N i) :
    (L N k).val.obj (op V) :=
  resM (L N k) (hV.trans (U_le N i)) (uSec N k i)

private lemma res_uS (k : ℤ) (i : Fin (N + 1)) {V V' : Opens (space (PP N))} (hV : V ≤ U N i)
    (h : V' ≤ V) : resM (L N k) h (uS N k i hV) = uS N k i (h.trans hV) :=
  resM_resM _ _ _ _

/-- Every section of `𝒪(k)^an` over an open of `Uᵢ` is a multiple of `xᵢᵏ`. -/
private lemma exists_eq_smul_uS (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (l : (L N k).val.obj (op V)) :
    ∃ a : (RR N).obj.obj (op V), l = a • uS N k i hV := by
  obtain ⟨a, ha⟩ := (bijective_smul_uSec N k i V (hV.trans (U_le N i))).2 l
  exact ⟨a, ha.symm⟩

/-- The local trivialization `m ↦ m ⊗ xᵢᵏ` of `M(k)` over an open of `Uᵢ`. -/
private abbrev Φ (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))} (hV : V ≤ U N i)
    (m : M.val.obj (op V)) : (tw N k M).val.obj (op V) :=
  tmul N m (uS N k i hV)

private lemma Φ_add (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (m m' : M.val.obj (op V)) :
    Φ N M k i hV (m + m') = Φ N M k i hV m + Φ N M k i hV m' := by
  refine Eq.trans ?_ (map_add ((PresheafOfModules.tensorSheafUnit M (L N k)).app (op V)).hom _ _)
  exact congrArg (fun z => ((PresheafOfModules.tensorSheafUnit M (L N k)).app (op V)) z)
    (TensorProduct.add_tmul m m' _)

private lemma Φ_zero (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) : Φ N M k i hV 0 = 0 :=
  tmul_zero_left N _

private lemma Φ_smul (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (a : (RR N).obj.obj (op V)) (m : M.val.obj (op V)) :
    Φ N M k i hV (a • m) = a • Φ N M k i hV m :=
  tmul_smul_left N a m _

private lemma Φ_sum_smul (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) {n : ℕ} (a : Fin n → (RR N).obj.obj (op V)) (m : Fin n → M.val.obj (op V)) :
    Φ N M k i hV (∑ l, a l • m l) = ∑ l, a l • Φ N M k i hV (m l) := by
  induction n with
  | zero => simpa using Φ_zero N M k i hV
  | succ n ih =>
    rw [Fin.sum_univ_succ, Fin.sum_univ_succ, Φ_add, Φ_smul, ih]

private lemma res_Φ (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V V' : Opens (space (PP N))}
    (hV : V ≤ U N i) (h : V' ≤ V) (m : M.val.obj (op V)) :
    resM (tw N k M) h (Φ N M k i hV m) = Φ N M k i (h.trans hV) (resM M h m) := by
  refine (res_tmul N h m _).trans ?_
  exact congrArg (tmul N (resM M h m)) (res_uS N k i hV h)

/-- The local trivialization is locally surjective. -/
private lemma exists_eq_Φ (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (w : (tw N k M).val.obj (op V)) {y : space (PP N)} (hy : y ∈ V) :
    ∃ (V' : Opens (space (PP N))) (h : V' ≤ V), y ∈ V' ∧ ∃ m : M.val.obj (op V'),
      resM (tw N k M) h w = Φ N M k i (h.trans hV) m := by
  obtain ⟨V', h, hy', n, a, l, hal⟩ := exists_eq_sum_tmul N w hy
  choose r hr using fun j => exists_eq_smul_uS N k i (h.trans hV) (l j)
  refine ⟨V', h, hy', ∑ j, r j • a j, ?_⟩
  rw [hal, Φ_sum_smul]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hr j]
  exact (tmul_smul_right N _ _ _).trans (tmul_smul_left N _ _ _).symm |>.trans
    (tmul_smul_left N _ _ _)

/-- A section of the unit module, read as a function. -/
private abbrev ofUnit {V : Opens (space (PP N))} (r : (𝟙_ (Md N)).val.obj (op V)) :
    (RR N).obj.obj (op V) := r

/-- A function, read as a section of the unit module. -/
private abbrev toUnit {V : Opens (space (PP N))} (r : (RR N).obj.obj (op V)) :
    (𝟙_ (Md N)).val.obj (op V) := r

private lemma isUnit_of_mul_eq_one_RR {V : Opens (space (PP N))} (a b : (RR N).obj.obj (op V))
    (h : a * b = 1) : IsUnit b := by
  let a' : sections (sP N) V := a
  let b' : sections (sP N) V := b
  exact ⟨⟨b, a, (mul_comm b' a').trans h, h⟩, rfl⟩

/-- The contraction `M(k) ⊗ 𝒪(-k) ⟶ M`. -/
private def Θ (M : Md N) (k : ℤ) : tw N k M ⊗ L N (-k) ⟶ M :=
  (α_ M (L N k) (L N (-k))).hom ≫ M ◁ (LinvIso N k).hom ≫ (ρ_ M).hom

set_option maxRecDepth 20000 in
private lemma Θ_tmul (M : Md N) (k : ℤ) {V : Opens (space (PP N))} (m : M.val.obj (op V))
    (u : (L N k).val.obj (op V)) (v : (L N (-k)).val.obj (op V)) :
    (Θ N M k).val.app (op V) (tmul N (tmul N m u) v) =
      ofUnit N ((LinvIso N k).hom.val.app (op V) (tmul N u v)) • m := by
  have hO := (Sheaf.toRingCat _ (structureSheaf (PP N))).property
  have h1 := Stacks.TensorSheafWorld.associator_hom_val_app_tensorSheafUnit
    (structureSheaf (PP N)) hO M (L N k) (L N (-k)) (op V) m u v
  have h2 := Stacks.TensorSheafWorld.whiskerLeft_val_app_tensorSheafUnit
    (structureSheaf (PP N)) hO (op V) M (LinvIso N k).hom m (tmul N u v)
  have h3 := Stacks.TensorSheafWorld.rightUnitor_hom_val_app_tensorSheafUnit
    (structureSheaf (PP N)) hO M (op V) m ((LinvIso N k).hom.val.app (op V) (tmul N u v))
  have hΘ : (Θ N M k).val.app (op V) (tmul N (tmul N m u) v) = (ρ_ M).hom.val.app (op V)
      ((M ◁ (LinvIso N k).hom).val.app (op V)
        ((α_ M (L N k) (L N (-k))).hom.val.app (op V) (tmul N (tmul N m u) v))) := by
    simp only [Θ, SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
      LinearMap.comp_apply]
  rw [hΘ]
  have e1 := congrArg
    (fun z => (ρ_ M).hom.val.app (op V) ((M ◁ (LinvIso N k).hom).val.app (op V) z)) h1
  have e2 := congrArg (fun z => (ρ_ M).hom.val.app (op V) z) h2
  exact e1.trans (e2.trans h3)

/-- The contraction of the two generators is a unit, locally. -/
private lemma exists_isUnit_contraction (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) {y : space (PP N)} (hy : y ∈ V) :
    ∃ (V' : Opens (space (PP N))) (h : V' ≤ V), y ∈ V' ∧
      IsUnit (ofUnit N ((LinvIso N k).hom.val.app (op V')
        (tmul N (uS N k i (h.trans hV)) (uS N (-k) i (h.trans hV))))) := by
  let z := (LinvIso N k).inv.val.app (op V) (toUnit N 1)
  obtain ⟨V', h, hy', n, a, b, hab⟩ := exists_eq_sum_tmul N z hy
  choose α hα using fun j => exists_eq_smul_uS N k i (h.trans hV) (a j)
  choose β hβ using fun j => exists_eq_smul_uS N (-k) i (h.trans hV) (b j)
  refine ⟨V', h, hy', ?_⟩
  set w : (RR N).obj.obj (op V') := ofUnit N ((LinvIso N k).hom.val.app (op V')
    (tmul N (uS N k i (h.trans hV)) (uS N (-k) i (h.trans hV))))
  have e1 : ofUnit N ((LinvIso N k).hom.val.app (op V') (resM _ h z)) = 1 := by
    change ofUnit N ((LinvIso N k).hom.val.app (op V') ((L N k ⊗ L N (-k)).val.map (homOfLE h).op
      ((LinvIso N k).inv.val.app (op V) (toUnit N 1)))) = 1
    rw [← PresheafOfModules.naturality_apply]
    change ofUnit N (((LinvIso N k).inv ≫ (LinvIso N k).hom).val.app (op V')
      ((𝟙_ (Md N)).val.map (homOfLE h).op (toUnit N 1))) = 1
    rw [Iso.inv_hom_id]
    exact map_one ((RR N).obj.map (homOfLE h).op).hom
  have key : (∑ j, α j * β j) * w = 1 := by
    rw [hab] at e1
    rw [← e1, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hα j, hβ j, tmul_smul_left, tmul_smul_right, map_smul, map_smul, smul_smul]
    rfl
  exact isUnit_of_mul_eq_one_RR N _ _ key

/-- The local trivialization is injective. -/
private lemma Φ_injective (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) {m : M.val.obj (op V)} (hm : Φ N M k i hV m = 0) : m = 0 := by
  refine eq_zero_of_locally_eq_zero M m fun y hy => ?_
  obtain ⟨V', h, hy', u, hu⟩ := exists_isUnit_contraction N k i hV hy
  refine ⟨V', h, hy', ?_⟩
  have h0 : Φ N M k i (h.trans hV) (resM M h m) = 0 := by
    rw [← res_Φ N M k i hV h m, hm]
    exact map_zero _
  have h1 := Θ_tmul N M k (resM M h m) (uS N k i (h.trans hV)) (uS N (-k) i (h.trans hV))
  change (Θ N M k).val.app (op V') (tmul N (Φ N M k i (h.trans hV) (resM M h m)) _) = _ at h1
  rw [h0, tmul_zero_left, map_zero, ← hu] at h1
  have := congrArg (fun z => ((↑u⁻¹ : (RR N).obj.obj (op V')) • z)) h1.symm
  simpa [smul_smul] using this

/-- Sections of `M(-1)(k)` over an open of `Uᵢ` are locally `m ⊗ xᵢ⁻¹ ⊗ xᵢᵏ`. -/
private lemma exists_eq_Φ_Φ (M : Md N) (k : ℤ) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (σ : (tw N k (tw N (-1) M)).val.obj (op V)) {y : space (PP N)} (hy : y ∈ V) :
    ∃ (V' : Opens (space (PP N))) (h : V' ≤ V), y ∈ V' ∧ ∃ m : M.val.obj (op V'),
      resM (tw N k (tw N (-1) M)) h σ =
        Φ N (tw N (-1) M) k i (h.trans hV) (Φ N M (-1) i (h.trans hV) m) := by
  obtain ⟨V₁, h₁, hy₁, s, hs⟩ := exists_eq_Φ N (tw N (-1) M) k i hV σ hy
  obtain ⟨V₂, h₂, hy₂, m, hm⟩ := exists_eq_Φ N M (-1) i (h₁.trans hV) s hy₁
  refine ⟨V₂, h₂.trans h₁, hy₂, m, ?_⟩
  rw [← resM_resM _ h₁ h₂, hs, res_Φ, hm]

end Coherence

section Coherence2

open CoherentAnalytic MMP.Analytic.ProjectiveTwists

private lemma finGen_tw {M : Md N} (hM : FinGen M) (k : ℤ) : FinGen (tw N k M) := by
  intro x
  obtain ⟨W, hxW, m, g, hg⟩ := hM x
  set i := iOf N x
  refine ⟨W ⊓ U N i, ⟨hxW, mem_U_iOf N x⟩, m,
    fun j => Φ N M k i inf_le_right (resM M inf_le_left (g j)), ?_⟩
  refine locallyGenerates_of_nhds _ fun Y hY t y hy => ?_
  obtain ⟨Y₁, h₁, hy₁, n, hn⟩ := exists_eq_Φ N M k i (hY.trans inf_le_right) t hy
  obtain ⟨Y₂, h₂, hy₂, c, hc⟩ :=
    hg.exists_nhds ((h₁.trans hY).trans inf_le_left) n hy₁
  refine ⟨Y₂, h₂.trans h₁, hy₂, c, ?_⟩
  rw [← resM_resM _ h₁ h₂, hn, res_Φ, hc, Φ_sum_smul]
  refine Finset.sum_congr rfl fun j _ => congrArg _ ?_
  rw [res_Φ]
  exact congrArg _ (resM_resM _ _ _ _).symm

private lemma relFin_tw {M : Md N} (hM : RelFin M) (k : ℤ) : RelFin (tw N k M) := by
  intro V p f x hx
  set i := iOf N x
  have hxi : x ∈ V ⊓ U N i := ⟨hx, mem_U_iOf N x⟩
  choose Vj hVj hxVj a ha using fun j =>
    exists_eq_Φ N M k i (inf_le_right : V ⊓ U N i ≤ U N i)
      (resM (tw N k M) inf_le_left (f j)) hxi
  obtain ⟨V₀', hxV₀', hV₀'⟩ := exists_le_of_forall_mem (x := x) Vj hxVj
  set V₀ := V₀' ⊓ (V ⊓ U N i)
  have hxV₀ : x ∈ V₀ := ⟨hxV₀', hxi⟩
  have hV₀ : ∀ j, V₀ ≤ Vj j := fun j => inf_le_left.trans (hV₀' j)
  have hV₀V : V₀ ≤ V ⊓ U N i := inf_le_right
  let b : Fin p → M.val.obj (op V₀) := fun j => resM M (hV₀ j) (a j)
  -- the sections `f j` are trivialized on `V₀`
  have hfb : ∀ j (Y : Opens (space (PP N))) (hY : Y ≤ V₀),
      resM (tw N k M) ((hY.trans hV₀V).trans inf_le_left) (f j) =
        Φ N M k i ((hY.trans hV₀V).trans inf_le_right) (resM M hY (b j)) := by
    intro j Y hY
    have e := congrArg (resM (tw N k M) (hY.trans (hV₀ j))) (ha j)
    rw [resM_resM, resM_resM, res_Φ] at e
    refine e.trans ?_
    exact congrArg _ (resM_resM _ _ _ _).symm
  obtain ⟨W, hWV₀, hxW, s', r, hr, hgen⟩ := hM V₀ p b x hxV₀
  refine ⟨W, (hWV₀.trans hV₀V).trans inf_le_left, hxW, s', r, fun l => ?_,
    fun Y hYW c hc y hy => ?_⟩
  · have e : ∑ j, r l j • resM (tw N k M) ((hWV₀.trans hV₀V).trans inf_le_left) (f j) =
        Φ N M k i ((hWV₀.trans hV₀V).trans inf_le_right) (∑ j, r l j • resM M hWV₀ (b j)) := by
      rw [Φ_sum_smul]
      exact Finset.sum_congr rfl fun j _ => congrArg _ (hfb j W hWV₀)
    rw [e, hr l]
    exact Φ_zero N M k i _
  · refine hgen Y hYW c ?_ y hy
    refine Φ_injective N M k i (((hYW.trans hWV₀).trans hV₀V).trans inf_le_right) ?_
    rw [Φ_sum_smul]
    refine Eq.trans ?_ hc
    exact Finset.sum_congr rfl fun j _ => congrArg _ (hfb j Y (hYW.trans hWV₀)).symm

/-- Twists of coherent sheaves are coherent. -/
private lemma isCoherentModule_tw {M : Md N} (hM : IsCoherentModule M) (k : ℤ) :
    IsCoherentModule (tw N k M) :=
  isCoherentModule_of_finGen_of_relFin
    (finGen_tw N ((isFiniteType_iff_finGen M).1 hM.1) k)
    (relFin_tw N (relFin_of_isCoherentModule hM) k)

end Coherence2

/-! ### Multiplication by a linear form -/

section Multiplication

open CoherentAnalytic MMP.Analytic.ProjectiveTwists

/-- The section of the linear form `c` on an open `V ≤ Uᵢ` is `(c / xᵢ) xᵢ`. -/
private lemma resM_anSec (c : Form N) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) :
    resM (L N 1) (le_top : V ≤ ⊤) (anSec N c) =
      (RR N).obj.map (homOfLE hV).op (gF N c i) • uS N 1 i hV := by
  have e1 : resM (L N 1) (le_top : V ≤ ⊤) (anSec N c) =
      resM (L N 1) hV (resM (L N 1) (le_top : U N i ≤ ⊤) (anSec N c)) :=
    (resM_resM _ _ _ _).symm
  refine e1.trans ?_
  change resM (L N 1) hV ((L N 1).val.map (homOfLE le_top).op (anSec N c)) = _
  rw [← gF_smul]
  exact (resM_smul (L N 1) hV _ _).trans (congrArg _ (resM_resM _ _ _ _))

/-- Multiplication by the linear form `c`, as a morphism `X(-1) ⟶ X`. -/
private def μ (c : Form N) (X : Md N) : X ⊗ L N (-1) ⟶ X :=
  ((ρ_ X).inv ≫ X ◁ sHom N c) ▷ L N (-1) ≫ Θ N X 1

/-- The function by which `μ c` multiplies, on a pure tensor `x ⊗ v`. -/
private abbrev μS (c : Form N) {V : Opens (space (PP N))} (v : (L N (-1)).val.obj (op V)) :
    (RR N).obj.obj (op V) :=
  ofUnit N ((LinvIso N 1).hom.val.app (op V) (tmul N (resM (L N 1) le_top (anSec N c)) v))

private lemma rightUnitor_inv_tmul (X : Md N) {V : Opens (space (PP N))} (x : X.val.obj (op V)) :
    (ρ_ X).inv.val.app (op V) x = tmul N x (toUnit N 1) := by
  have hO := (Sheaf.toRingCat _ (structureSheaf (PP N))).property
  have h3 := Stacks.TensorSheafWorld.rightUnitor_hom_val_app_tensorSheafUnit
    (structureSheaf (PP N)) hO X (op V) x (1 : (RR N).obj.obj (op V))
  have e : (ρ_ X).hom.val.app (op V) (tmul N x (toUnit N 1)) = x := h3.trans (one_smul _ _)
  refine (congrArg (fun z => (ρ_ X).inv.val.app (op V) z) e.symm).trans ?_
  change ((ρ_ X).hom ≫ (ρ_ X).inv).val.app (op V) _ = _
  rw [Iso.hom_inv_id]
  rfl

set_option maxRecDepth 20000 in
private lemma μ_tmul (c : Form N) (X : Md N) {V : Opens (space (PP N))} (x : X.val.obj (op V))
    (v : (L N (-1)).val.obj (op V)) :
    (μ N c X).val.app (op V) (tmul N x v) = μS N c v • x := by
  have hO := (Sheaf.toRingCat _ (structureSheaf (PP N))).property
  have h1 := Stacks.TensorSheafWorld.whiskerRight_val_app_tensorSheafUnit
    (structureSheaf (PP N)) hO (op V) ((ρ_ X).inv ≫ X ◁ sHom N c) (L N (-1)) x v
  have h2 := Stacks.TensorSheafWorld.whiskerLeft_val_app_tensorSheafUnit
    (structureSheaf (PP N)) hO (op V) X (sHom N c) x (toUnit N 1)
  have hf : ((ρ_ X).inv ≫ X ◁ sHom N c).val.app (op V) x =
      tmul N x (resM (L N 1) le_top (anSec N c)) := by
    have : ((ρ_ X).inv ≫ X ◁ sHom N c).val.app (op V) x =
        (X ◁ sHom N c).val.app (op V) ((ρ_ X).inv.val.app (op V) x) := rfl
    rw [this, rightUnitor_inv_tmul]
    refine h2.trans ?_
    exact congrArg (tmul N x) ((sHom_app N c V _).trans (one_smul _ _))
  have hμ : (μ N c X).val.app (op V) (tmul N x v) = (Θ N X 1).val.app (op V)
      ((((ρ_ X).inv ≫ X ◁ sHom N c) ▷ L N (-1)).val.app (op V) (tmul N x v)) := rfl
  rw [hμ]
  have e1 := congrArg (fun z => (Θ N X 1).val.app (op V) z) h1
  refine e1.trans ?_
  have e2 := congrArg (fun z => (Θ N X 1).val.app (op V)
    ((PresheafOfModules.tensorSheafUnit (tw N 1 X) (L N (-1))).app (op V) (z ⊗ₜ v))) hf
  refine e2.trans ?_
  exact Θ_tmul N X 1 _ _ _

private lemma μS_res (c : Form N) {V V' : Opens (space (PP N))} (h : V' ≤ V)
    (v : (L N (-1)).val.obj (op V)) :
    (RR N).obj.map (homOfLE h).op (μS N c v) = μS N c (resM (L N (-1)) h v) := by
  have e := PresheafOfModules.naturality_apply (LinvIso N 1).hom.val (homOfLE h).op
    (tmul N (resM (L N 1) le_top (anSec N c)) v)
  refine e.symm.trans ?_
  change ofUnit N ((LinvIso N 1).hom.val.app (op V')
    (resM (L N 1 ⊗ L N (-1)) h (tmul N (resM (L N 1) le_top (anSec N c)) v))) = _
  rw [res_tmul, resM_resM]

/-- On an open of `Uᵢ`, `μ c` multiplies by `c / xᵢ` times the contraction of `xᵢ` and `v`. -/
private lemma μS_chart (c : Form N) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (v : (L N (-1)).val.obj (op V)) :
    μS N c v = (RR N).obj.map (homOfLE hV).op (gF N c i) *
      ofUnit N ((LinvIso N 1).hom.val.app (op V) (tmul N (uS N 1 i hV) v)) := by
  change ofUnit N ((LinvIso N 1).hom.val.app (op V)
    (tmul N (resM (L N 1) le_top (anSec N c)) v)) = _
  rw [resM_anSec N c i hV, tmul_smul_left]
  exact map_smul ((LinvIso N 1).hom.val.app (op V)).hom _ _

/-- Sheaves killed by `c` are killed by every `μS c v`. -/
private lemma Killed.μS_smul {c : Form N} {Y : Md N} (hY : Killed N c Y) {V : Opens (space (PP N))}
    (v : (L N (-1)).val.obj (op V)) (y : Y.val.obj (op V)) : μS N c v • y = 0 := by
  refine eq_zero_of_locally_eq_zero Y _ fun z hz => ?_
  set i := iOf N z
  refine ⟨V ⊓ U N i, inf_le_left, ⟨hz, mem_U_iOf N z⟩, ?_⟩
  rw [resM_smul]
  change (RR N).obj.map (homOfLE inf_le_left).op (μS N c v) • _ = 0
  rw [μS_res, μS_chart N c i (inf_le_right : V ⊓ U N i ≤ U N i), RR_mul_comm N, mul_smul,
    hY i _ inf_le_right, smul_zero]

/-- A morphism out of a tensor product vanishing on local pure tensors is zero. -/
private lemma hom_eq_zero_of_tmul {A B C : Md N} (f : A ⊗ B ⟶ C)
    (h : ∀ (V : Opens (space (PP N))) (a : A.val.obj (op V)) (b : B.val.obj (op V)),
      f.val.app (op V) (tmul N a b) = 0) : f = 0 := by
  ext V w
  change f.val.app V w = 0
  induction V using Opposite.rec with | op V => ?_
  refine eq_zero_of_locally_eq_zero C _ fun y hy => ?_
  obtain ⟨V', hV', hy', n, a, b, hab⟩ := exists_eq_sum_tmul N w hy
  refine ⟨V', hV', hy', ?_⟩
  refine (PresheafOfModules.naturality_apply f.val (homOfLE hV').op w).symm.trans ?_
  change f.val.app (op V') (resM (A ⊗ B) hV' w) = 0
  rw [hab, map_sum]
  exact Finset.sum_eq_zero fun l _ => h V' (a l) (b l)

/-- Multiplication by `c` followed by a map to a sheaf killed by `c` is zero. -/
private lemma μ_comp_eq_zero {c : Form N} {X Y : Md N} (hY : Killed N c Y) (s : X ⟶ Y) :
    μ N c X ≫ s = 0 :=
  hom_eq_zero_of_tmul N _ fun V x v => by
    change s.val.app (op V) ((μ N c X).val.app (op V) (tmul N x v)) = 0
    rw [μ_tmul, map_smul]
    exact hY.μS_smul N v _

/-- `μ c` on the local trivialization of `X(-1)` over an open of `Uᵢ`. -/
private lemma μ_Φ (c : Form N) (X : Md N) (i : Fin (N + 1)) {V : Opens (space (PP N))}
    (hV : V ≤ U N i) (x : X.val.obj (op V)) :
    (μ N c X).val.app (op V) (Φ N X (-1) i hV x) =
      ((RR N).obj.map (homOfLE hV).op (gF N c i) *
        ofUnit N ((LinvIso N 1).hom.val.app (op V)
          (tmul N (uS N 1 i hV) (uS N (-1) i hV)))) • x := by
  rw [μ_tmul, μS_chart N c i hV]

/-- Where the contraction of `xᵢ` with `xᵢ⁻¹` is a unit, `μ c` kills `x ⊗ xᵢ⁻¹` only if `c / xᵢ`
kills `x`. -/
private lemma gF_smul_eq_zero_of_μ_Φ_eq_zero {c : Form N} {X : Md N} {i : Fin (N + 1)}
    {V : Opens (space (PP N))} (hV : V ≤ U N i) {x : X.val.obj (op V)}
    (hu : IsUnit (ofUnit N ((LinvIso N 1).hom.val.app (op V)
      (tmul N (uS N 1 i hV) (uS N (-1) i hV)))))
    (h : (μ N c X).val.app (op V) (Φ N X (-1) i hV x) = 0) :
    (RR N).obj.map (homOfLE hV).op (gF N c i) • x = 0 := by
  obtain ⟨u, hu⟩ := hu
  rw [μ_Φ, ← hu] at h
  calc (RR N).obj.map (homOfLE hV).op (gF N c i) • x
      = (↑u⁻¹ * ((RR N).obj.map (homOfLE hV).op (gF N c i) * ↑u) : (RR N).obj.obj (op V)) • x := by
        rw [RR_mul_comm N _ (u : (RR N).obj.obj (op V)), ← mul_assoc, Units.inv_mul, one_mul]
    _ = 0 := by rw [mul_smul, h, smul_zero]

/-- The cokernel of multiplication by `c` is killed by `c`. -/
private lemma killed_cokernel_μ (c : Form N) (X : Md N) : Killed N c (cokernel (μ N c X)) := by
  intro i V hV m
  refine eq_zero_of_locally_eq_zero _ _ fun y hy => ?_
  obtain ⟨S, hS, hlift⟩ := OkaCoherence.exists_local_lift (cokernel.π (μ N c X)) m
  obtain ⟨V₁, f, hf, hyV₁⟩ := (Opens.mem_grothendieckTopology _).1 hS y hy
  obtain ⟨t, ht⟩ := hlift f hf
  have hV₁ : V₁ ≤ U N i := f.le.trans hV
  obtain ⟨V₂, h₂, hyV₂, u, hu⟩ := exists_isUnit_contraction N 1 i hV₁ hyV₁
  refine ⟨V₂, h₂.trans f.le, hyV₂, ?_⟩
  set v : (L N (-1)).val.obj (op V₂) := (↑u⁻¹ : (RR N).obj.obj (op V₂)) • uS N (-1) i (h₂.trans hV₁)
  have hμ : (μ N c X).val.app (op V₂) (tmul N (resM X h₂ t) v) =
      (RR N).obj.map (homOfLE (h₂.trans hV₁)).op (gF N c i) • resM X h₂ t := by
    rw [μ_tmul, μS_chart N c i (h₂.trans hV₁), tmul_smul_right, map_smul]
    have hw : ofUnit N ((↑u⁻¹ : (RR N).obj.obj (op V₂)) • (LinvIso N 1).hom.val.app (op V₂)
        (tmul N (uS N 1 i (h₂.trans hV₁)) (uS N (-1) i (h₂.trans hV₁)))) = ↑u⁻¹ * ↑u := by
      rw [hu]; rfl
    rw [hw, Units.inv_mul, mul_one]
  have hm : resM _ (h₂.trans f.le) m = (cokernel.π (μ N c X)).val.app (op V₂) (resM X h₂ t) := by
    rw [← resM_resM _ f.le h₂ m]
    change resM _ h₂ ((cokernel (μ N c X)).val.map f.op m) = _
    rw [← ht]
    exact (PresheafOfModules.naturality_apply (cokernel.π (μ N c X)).val (homOfLE h₂).op t).symm
  rw [resM_smul, resA_resA, hm, ← map_smul]
  have e := congrArg (fun φ => φ.val.app (op V₂) (tmul N (resM X h₂ t) v))
    (cokernel.condition (μ N c X))
  refine Eq.trans ?_ e
  change _ = (cokernel.π (μ N c X)).val.app (op V₂) ((μ N c X).val.app (op V₂) _)
  rw [hμ]

end Multiplication

/-! ### Cohomology on a point -/

section PointCohomology

open MMP.Analytic.ProjectiveTwists

omit N in
/-- An exact functor has no higher right derived functors. -/
private lemma isZero_rightDerived_succ_of_exact {C D : Type*} [Category C] [Category D] [Abelian C]
    [Abelian D] [HasInjectiveResolutions C] (F : C ⥤ D) [F.Additive] [PreservesFiniteLimits F]
    [PreservesFiniteColimits F] (n : ℕ) (X : C) : IsZero ((F.rightDerived (n + 1)).obj X) := by
  let I := injectiveResolution X
  refine IsZero.of_iso ?_ (I.isoRightDerivedObj F (n + 1))
  exact (ShortComplex.exact_iff_isZero_homology _).1 ((I.cocomplex_exactAt_succ n).map F)

omit N in
/-- On a space with one point, epimorphisms of sheaves are surjective on global sections. -/
private lemma surjective_app_top_of_epi (T : TopCat.{0}) (p : T) (hp : ∀ x : T, x = p)
    {F G : TopCat.Sheaf AddCommGrpCat.{0} T} (g : F ⟶ G) [Epi g] :
    Function.Surjective (g.hom.app (op ⊤)) := by
  have hls := (TopCat.Sheaf.isLocallySurjective_iff_epi g).2 inferInstance
  intro b
  obtain ⟨V, hV, ⟨s, hs⟩, hpV⟩ := (TopCat.Presheaf.isLocallySurjective_iff _).1 hls ⊤ b p trivial
  have hVt : V = ⊤ := top_le_iff.1 fun x _ => (hp x) ▸ hpV
  subst hVt
  refine ⟨s, hs.trans ?_⟩
  change G.obj.map (𝟙 _) b = b
  simp

omit N in
/-- On a space with one point, sheaf cohomology vanishes in positive degrees. -/
private lemma isZero_sheafCohomology_of_forall_eq (T : TopCat.{0}) (p : T) (hp : ∀ x : T, x = p)
    (F : TopCat.Sheaf AddCommGrpCat.{0} T) (n : ℕ) (hn : 1 ≤ n) :
    IsZero ((sheafCohomology T (n : ℤ)).obj F) := by
  obtain ⟨⟨hEI, -⟩, -, ⟨⟨E, -⟩, -⟩, -⟩ := sheafCohomology_toolkit.{0, 0, 0, 0, 0} T
  haveI := hEI
  haveI : (globalSections T).Additive := globalSections_additive T
  haveI := preservesFiniteLimits_globalSections T
  have hlex : ∀ S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} T), S.ShortExact →
      (S.map (globalSections T)).Exact ∧ Mono ((globalSections T).map S.f) :=
    ((Functor.preservesFiniteLimits_tfae (globalSections T)).out 4 1).1
      (preservesFiniteLimits_globalSections T)
  haveI : PreservesFiniteColimits (globalSections T) := by
    refine ((Functor.preservesFiniteColimits_tfae (globalSections T)).out 1 4).1 fun S hS => ?_
    refine ⟨(hlex S hS).1, ?_⟩
    haveI := hS.epi_g
    exact (AddCommGrpCat.epi_iff_surjective _).2 (surjective_app_top_of_epi T p hp S.g)
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  exact (isZero_rightDerived_succ_of_exact (globalSections T) m F).of_iso ((E T (m + 1)).app F)

/-- `ℙ⁰` has exactly one point. -/
private lemma eq_of_space_zero (x y : space (PP 0)) : x = y := by
  have hx : x ∈ U 0 0 := (Subsingleton.elim (α := Fin 1) (iOf 0 x) 0) ▸ mem_U_iOf 0 x
  have hy : y ∈ U 0 0 := (Subsingleton.elim (α := Fin 1) (iOf 0 y) 0) ▸ mem_U_iOf 0 y
  have hco : (stdChart 0 0).coords ⟨x, mem_chart_of_U 0 (⟨x, hx⟩ : U 0 0)⟩ =
      (stdChart 0 0).coords ⟨y, mem_chart_of_U 0 (⟨y, hy⟩ : U 0 0)⟩ := by
    funext m
    exact Fin.elim0 m
  exact congrArg Subtype.val (coords_injective (stdChart_ideal 0 0) hco)

end PointCohomology

/-! ### The structure sheaf of a linear subspace -/

section Resolvent

open CoherentAnalytic MMP.Analytic.ProjectiveTwists

/-- The functions killed by `π : 𝒪 ⟶ F` lie, locally on each chart `Uᵢ`, in the ideal generated
by the functions `eₖ / xᵢ`. -/
private def KerIn {n : ℕ} (e : Fin n → Form N) {F : Md N} (π : 𝟙_ (Md N) ⟶ F) : Prop :=
  ∀ (i : Fin (N + 1)) (V : Opens (space (PP N))) (hV : V ≤ U N i) (r : (RR N).obj.obj (op V)),
    π.val.app (op V) (toUnit N r) = 0 → ∀ y ∈ V, ∃ (V' : Opens (space (PP N))) (h : V' ≤ V),
      y ∈ V' ∧ ∃ b : Fin n → (RR N).obj.obj (op V'), (RR N).obj.map (homOfLE h).op r =
        ∑ k, (RR N).obj.map (homOfLE (h.trans hV)).op (gF N (e k) i) * b k

private lemma π_res {F : Md N} (π : 𝟙_ (Md N) ⟶ F) {V V' : Opens (space (PP N))} (h : V' ≤ V)
    (r : (RR N).obj.obj (op V)) :
    resM F h (π.val.app (op V) (toUnit N r)) =
      π.val.app (op V') (toUnit N ((RR N).obj.map (homOfLE h).op r)) :=
  (PresheafOfModules.naturality_apply π.val (homOfLE h).op _).symm

private lemma π_mul {F : Md N} (π : 𝟙_ (Md N) ⟶ F) {V : Opens (space (PP N))}
    (g r : (RR N).obj.obj (op V)) :
    π.val.app (op V) (toUnit N (g * r)) = g • π.val.app (op V) (toUnit N r) :=
  map_smul (π.val.app (op V)).hom g (toUnit N r)

set_option maxRecDepth 20000 in
private lemma kerIn_cokernel {n : ℕ} (e : Fin (n + 1) → Form N) {F : Md N}
    (π : 𝟙_ (Md N) ⟶ F) [Epi π] (hK : KerIn N (Fin.init e) π) :
    KerIn N e (π ≫ cokernel.π (μ N (e (Fin.last n)) F)) := by
  intro i V hV r hr y hy
  set c := e (Fin.last n)
  obtain ⟨V₁, h₁, hy₁, σ, hσ⟩ := exists_eq_of_cokernel_π_eq_zero (μ N c F)
    (π.val.app (op V) (toUnit N r)) hr hy
  obtain ⟨V₂, h₂, hy₂, x, hx⟩ := exists_eq_Φ N F (-1) i (h₁.trans hV) σ hy₁
  obtain ⟨S, hS, hlift⟩ := OkaCoherence.exists_local_lift π x
  obtain ⟨V₃, f₃, hf₃, hy₃⟩ := (Opens.mem_grothendieckTopology _).1 hS y hy₂
  obtain ⟨a, ha⟩ := hlift f₃ hf₃
  have h₃ : V₃ ≤ V₂ := f₃.le
  have hV₃ : V₃ ≤ U N i := h₃.trans (h₂.trans (h₁.trans hV))
  set w : (RR N).obj.obj (op V₂) := ofUnit N ((LinvIso N 1).hom.val.app (op V₂)
    (tmul N (uS N 1 i (h₂.trans (h₁.trans hV))) (uS N (-1) i (h₂.trans (h₁.trans hV)))))
  set g : (RR N).obj.obj (op V₂) := (RR N).obj.map (homOfLE (h₂.trans (h₁.trans hV))).op (gF N c i)
  -- on `V₃`, `π(r) = π(g w a)`
  have key : π.val.app (op V₃) (toUnit N ((RR N).obj.map (homOfLE (h₃.trans (h₂.trans h₁))).op r)) =
      π.val.app (op V₃) (toUnit N ((RR N).obj.map (homOfLE h₃).op (g * w) * ofUnit N a)) := by
    have s1 := (π_res N π (h₃.trans (h₂.trans h₁)) r).symm
    have s2 : resM F (h₃.trans (h₂.trans h₁)) (π.val.app (op V) (toUnit N r)) =
        resM F h₃ (resM F h₂ (resM F h₁ (π.val.app (op V) (toUnit N r)))) := by
      rw [resM_resM, resM_resM]
    have s3 : resM F h₂ ((μ N c F).val.app (op V₁) σ) =
        (μ N c F).val.app (op V₂) (resM _ h₂ σ) :=
      (PresheafOfModules.naturality_apply (μ N c F).val (homOfLE h₂).op σ).symm
    have s4 : (μ N c F).val.app (op V₂) (resM _ h₂ σ) = (g * w) • x := by
      rw [hx]; exact μ_Φ N c F i _ x
    have s5 : resM F h₃ ((g * w) • x) =
        (RR N).obj.map (homOfLE h₃).op (g * w) • π.val.app (op V₃) a := by
      rw [resM_smul]
      exact congrArg _ ha.symm
    rw [s1, s2, ← hσ, s3, s4, s5]
    exact (π_mul N π _ _).symm
  set hh : V₃ ≤ V := h₃.trans (h₂.trans h₁)
  have hz : π.val.app (op V₃) (toUnit N ((RR N).obj.map (homOfLE hh).op r -
      (RR N).obj.map (homOfLE h₃).op (g * w) * ofUnit N a)) = 0 := by
    have := map_sub (π.val.app (op V₃)).hom
      (toUnit N ((RR N).obj.map (homOfLE hh).op r))
      (toUnit N ((RR N).obj.map (homOfLE h₃).op (g * w) * ofUnit N a))
    rw [key, sub_self] at this
    exact this
  obtain ⟨V₄, h₄, hy₄, b, hb⟩ := hK i V₃ hV₃ _ hz y hy₃
  refine ⟨V₄, h₄.trans hh, hy₄,
    Fin.snoc b ((RR N).obj.map (homOfLE h₄).op ((RR N).obj.map (homOfLE h₃).op w * ofUnit N a)), ?_⟩
  have hX : (RR N).obj.map (homOfLE h₄).op ((RR N).obj.map (homOfLE hh).op r) =
      (RR N).obj.map (homOfLE (h₄.trans hh)).op r := resA_resA hh h₄ r
  have hG : (RR N).obj.map (homOfLE h₄).op ((RR N).obj.map (homOfLE h₃).op g) =
      (RR N).obj.map (homOfLE ((h₄.trans hh).trans hV)).op (gF N c i) := by
    refine (resA_resA h₃ h₄ g).trans ?_
    exact resA_resA (h₂.trans (h₁.trans hV)) (h₄.trans h₃) (gF N c i)
  rw [map_sub, map_mul, map_mul, map_mul, hX, hG, mul_assoc] at hb
  rw [Fin.sum_univ_castSucc, Fin.snoc_last]
  refine (sub_eq_iff_eq_add.1 hb).trans ?_
  congr 1
  exact Finset.sum_congr rfl fun k _ => by rw [Fin.snoc_castSucc]; rfl

set_option maxRecDepth 20000 in
/-- Multiplication by a form independent of `e` is injective on the quotient `F` of `𝒪` by the
ideal of `e`. -/
private lemma μ_app_injective {n : ℕ} (e : Fin (n + 1) → Form N) (he : LinearIndependent ℂ e)
    {F : Md N} (π : 𝟙_ (Md N) ⟶ F) [Epi π] (hkill : ∀ k, Killed N (Fin.init e k) F)
    (hK : KerIn N (Fin.init e) π) {V : Opens (space (PP N))} (w : (F ⊗ L N (-1)).val.obj (op V))
    (hw : (μ N (e (Fin.last n)) F).val.app (op V) w = 0) : w = 0 := by
  set c := e (Fin.last n)
  refine eq_zero_of_locally_eq_zero _ w fun y hy => ?_
  set i := iOf N y
  have hVi : V ⊓ U N i ≤ U N i := inf_le_right
  obtain ⟨V₁, h₁, hy₁, x, hx⟩ := exists_eq_Φ N F (-1) i hVi (resM _ inf_le_left w)
    ⟨hy, mem_U_iOf N y⟩
  have hV₁ : V₁ ≤ U N i := h₁.trans hVi
  obtain ⟨V₂, h₂, hy₂, hu⟩ := exists_isUnit_contraction N 1 i hV₁ hy₁
  have hV₂ : V₂ ≤ U N i := h₂.trans hV₁
  set x₂ := resM F h₂ x
  set gc : (RR N).obj.obj (op V₂) := (RR N).obj.map (homOfLE hV₂).op (gF N c i)
  -- `μ(x₂ ⊗ xᵢ⁻¹) = 0`
  have h0 : (μ N c F).val.app (op V₂) (Φ N F (-1) i hV₂ x₂) = 0 := by
    have e1 : Φ N F (-1) i hV₂ x₂ =
        resM _ (h₂.trans (h₁.trans inf_le_left)) w := by
      rw [← res_Φ N F (-1) i hV₁ h₂ x, ← hx, resM_resM, resM_resM]
    rw [e1]
    have e2 := PresheafOfModules.naturality_apply (μ N c F).val
      (homOfLE (h₂.trans (h₁.trans inf_le_left))).op w
    refine e2.trans ?_
    change resM F _ ((μ N c F).val.app (op V) w) = 0
    rw [hw]
    exact map_zero _
  have hgx : gc • x₂ = 0 := gF_smul_eq_zero_of_μ_Φ_eq_zero N hV₂ hu h0
  -- lift `x₂` to a function
  obtain ⟨S, hS, hlift⟩ := OkaCoherence.exists_local_lift π x₂
  obtain ⟨V₃, f₃, hf₃, hy₃⟩ := (Opens.mem_grothendieckTopology _).1 hS y hy₂
  obtain ⟨a, ha⟩ := hlift f₃ hf₃
  have h₃ : V₃ ≤ V₂ := f₃.le
  have hV₃ : V₃ ≤ U N i := h₃.trans hV₂
  have hz : π.val.app (op V₃) (toUnit N ((RR N).obj.map (homOfLE h₃).op gc * ofUnit N a)) = 0 := by
    rw [π_mul]
    change _ • π.val.app (op V₃) a = 0
    rw [ha]
    change _ • resM F h₃ x₂ = 0
    rw [← resM_smul, hgx]
    exact map_zero _
  obtain ⟨V₄, h₄, hy₄, b, hb⟩ := hK i V₃ hV₃ _ hz y hy₃
  have hV₄ : V₄ ≤ U N i := h₄.trans hV₃
  have hgc : (RR N).obj.map (homOfLE h₄).op ((RR N).obj.map (homOfLE h₃).op gc) =
      (RR N).obj.map (homOfLE hV₄).op (gF N c i) :=
    (resA_resA h₃ h₄ gc).trans (resA_resA hV₂ (h₄.trans h₃) (gF N c i))
  rw [map_mul, hgc] at hb
  obtain ⟨V₅, h₅, hy₅, b', hb'⟩ := exists_eq_sum_gF_of_gF_mul N hV₄ ⟨y, hy₄⟩ e he
    ((RR N).obj.map (homOfLE h₄).op (ofUnit N a)) b hb
  -- `a` vanishes in `F` near `y`
  have ha₅ : π.val.app (op V₅) (toUnit N ((RR N).obj.map (homOfLE h₅).op
      ((RR N).obj.map (homOfLE h₄).op (ofUnit N a)))) = 0 := by
    rw [hb']
    change π.val.app (op V₅) (∑ k, toUnit N (_ * b' k)) = 0
    rw [map_sum]
    refine Finset.sum_eq_zero fun k _ => ?_
    rw [π_mul]
    exact hkill k i V₅ (h₅.trans hV₄) _
  have hx₅ : resM F (h₅.trans (h₄.trans h₃)) x₂ = 0 := by
    rw [← resM_resM _ h₃ (h₅.trans h₄), ← resM_resM _ h₄ h₅]
    change resM F h₅ (resM F h₄ (F.val.map f₃.op x₂)) = 0
    rw [← ha]
    change resM F h₅ (resM F h₄ (π.val.app (op V₃) (toUnit N (ofUnit N a)))) = 0
    rw [π_res, π_res]
    exact ha₅
  refine ⟨V₅, h₅.trans (h₄.trans (h₃.trans (h₂.trans (h₁.trans inf_le_left)))), hy₅, ?_⟩
  have e3 : resM _ (h₅.trans (h₄.trans (h₃.trans (h₂.trans (h₁.trans inf_le_left))))) w =
      resM (tw N (-1) F) (h₅.trans (h₄.trans h₃)) (Φ N F (-1) i hV₂ x₂) := by
    rw [← res_Φ N F (-1) i hV₁ h₂ x, ← hx, resM_resM, resM_resM, resM_resM]
  rw [e3, res_Φ, hx₅]
  exact Φ_zero N F (-1) i _

set_option maxRecDepth 20000 in
/-- Multiplication by a form independent of `e` is a monomorphism on `F`. -/
private lemma mono_μ {n : ℕ} (e : Fin (n + 1) → Form N) (he : LinearIndependent ℂ e)
    {F : Md N} (π : 𝟙_ (Md N) ⟶ F) [Epi π] (hkill : ∀ k, Killed N (Fin.init e k) F)
    (hK : KerIn N (Fin.init e) π) : Mono (μ N (e (Fin.last n)) F) := by
  refine Preadditive.mono_of_cancel_zero _ fun {P} g hg => ?_
  ext V z
  change g.val.app V z = 0
  induction V using Opposite.rec with | op V => ?_
  refine μ_app_injective N e he π hkill hK _ ?_
  have := congrArg (fun φ => φ.val.app (op V) z) hg
  exact this

/-- The twists `𝒪(j)^an`, `j ≥ 0`, have no higher cohomology. -/
private lemma isZero_Hq_L (q : ℕ) (hq : 1 ≤ q) (j : ℤ) (hj : 0 ≤ j) : IsZero (Hq N q (L N j)) := by
  rcases Nat.eq_zero_or_pos N with hN | hN
  · subst hN
    obtain ⟨p⟩ : Nonempty (space (PP 0)) :=
      ⟨((MMP.Analytic.ProjectiveTwists.coordsEquiv (N := 0) 0).symm Fin.elim0).1⟩
    exact isZero_sheafCohomology_of_forall_eq _ p (fun x => eq_of_space_zero x p) _ q hq
  have h := (isIso_comparisonMap_projectiveSpace_twistingSheaf N hN j).2.2.2 q (by
    rcases lt_trichotomy q N with h | h | h
    · exact Or.inl ⟨hq, h⟩
    · exact Or.inr (Or.inr ⟨h, by omega⟩)
    · exact Or.inr (Or.inl h))
  exact h.2

private lemma van_cokernel {F : Md N} (c : Form N) (hmono : Mono (μ N c F))
    (hv : ∃ j₀ : ℤ, ∀ j, j₀ ≤ j → ∀ q : ℕ, 1 ≤ q → IsZero (Hq N q (tw N j F))) :
    ∃ j₀ : ℤ, ∀ j, j₀ ≤ j → ∀ q : ℕ, 1 ≤ q → IsZero (Hq N q (tw N j (cokernel (μ N c F)))) := by
  obtain ⟨j₀, h⟩ := hv
  refine ⟨j₀ + 1, fun j hj q hq => ?_⟩
  let S : ShortComplex (Md N) :=
    ShortComplex.mk (μ N c F) (cokernel.π _) (cokernel.condition _)
  have hS : S.ShortExact :=
    { exact := ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel _)
      mono_f := hmono
      epi_g := inferInstanceAs (Epi (cokernel.π _)) }
  have hSj := ShortComplex.ShortExact.tw N hS j
  let iso : (F ⊗ L N (-1)) ⊗ L N j ≅ tw N (j - 1) F :=
    α_ _ _ _ ≪≫ whiskerLeftIso F (tensorLIso N (-1) j ≪≫
      eqToIso (congrArg (L N) (by ring)))
  have h₁ : IsZero (Hq N (q + 1) ((F ⊗ L N (-1)) ⊗ L N j)) :=
    (h (j - 1) (by omega) (q + 1) (by omega)).of_iso
      ((sheafCohomology _ _).mapIso ((SheafOfModules.toSheaf _).mapIso iso))
  exact les_isZero N hSj q (h j (by omega) q hq) h₁

attribute [local instance] locallyOfFiniteType_sP in
private lemma isCoherentModule_unit : IsCoherentModule (𝟙_ (Md N)) :=
  (isCoherentRing_holomorphic_and_analytification.2 _ (PP N)).1

/-- **The structure sheaf of the linear subspace `{e = 0}`.** For linearly independent forms
`e₀, …, e_{n-1}` there is a coherent quotient `π : 𝒪 ⟶ F` killed by every `eₖ`, through which
every map from `𝒪` to a sheaf killed by the `eₖ` factors, whose kernel is locally the ideal of
the `eₖ / xᵢ`, and whose large twists have no higher cohomology. -/
private lemma exists_resolvent : ∀ (n : ℕ) (e : Fin n → Form N), LinearIndependent ℂ e →
    ∃ (F : Md N) (π : 𝟙_ (Md N) ⟶ F), Epi π ∧ IsCoherentModule F ∧ (∀ k, Killed N (e k) F) ∧
      (∀ Y : Md N, (∀ k, Killed N (e k) Y) → ∀ s : 𝟙_ (Md N) ⟶ Y, ∃ s' : F ⟶ Y, π ≫ s' = s) ∧
      KerIn N e π ∧
      ∃ j₀ : ℤ, ∀ j, j₀ ≤ j → ∀ q : ℕ, 1 ≤ q → IsZero (Hq N q (tw N j F))
  | 0, e, _ => by
    refine ⟨𝟙_ (Md N), 𝟙 _, inferInstance, isCoherentModule_unit N, fun k => k.elim0,
      fun Y _ s => ⟨s, Category.id_comp s⟩, ?_, ⟨0, fun j hj q hq => ?_⟩⟩
    · intro i V hV r hr y hy
      refine ⟨V, le_rfl, hy, Fin.elim0, ?_⟩
      rw [show r = 0 from hr, map_zero]
      simp
    · exact (isZero_Hq_L N q hq j hj).of_iso
        ((sheafCohomology _ _).mapIso ((SheafOfModules.toSheaf _).mapIso (λ_ (L N j))))
  | n + 1, e, he => by
    obtain ⟨F, π, hπ, hF, hk, hfac, hK, hv⟩ :=
      exists_resolvent n (Fin.init e) (he.comp _ (Fin.castSucc_injective _))
    haveI := hπ
    refine ⟨cokernel (μ N (e (Fin.last n)) F), π ≫ cokernel.π _, epi_comp _ _,
      isCoherentModule_cokernel _ (isCoherentModule_tw N hF (-1)).1 hF, fun k => ?_,
      fun Y hY s => ?_, kerIn_cokernel N e π hK,
      van_cokernel N _ (mono_μ N e he π hk hK) hv⟩
    · refine Fin.lastCases ?_ (fun k => ?_) k
      · exact killed_cokernel_μ N _ F
      · exact Killed.of_epi N (cokernel.π _) (hk k)
    · obtain ⟨s₀, hs₀⟩ := hfac Y (fun k => hY (Fin.castSucc k)) s
      refine ⟨cokernel.desc _ s₀ (μ_comp_eq_zero N (hY (Fin.last n)) s₀), ?_⟩
      rw [Category.assoc, cokernel.π_desc, hs₀]

end Resolvent

