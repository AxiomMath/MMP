attribute [local instance] moduleHq

set_option maxRecDepth 20000 in
/-- The kernel of multiplication by `c` is killed by `c`. -/
private lemma killed_kernel_μ (c : Form N) (X : Md N) : Killed N c (kernel (μ N c X)) := by
  intro i V hV m
  refine OkaCoherence.kernel_ι_app_injective _ (op V) ?_
  rw [map_smul, map_zero]
  set w := (kernel.ι (μ N c X)).val.app (op V) m
  have hw : (μ N c X).val.app (op V) w = 0 :=
    congrArg (fun φ => φ.val.app (op V) m) (kernel.condition (μ N c X))
  refine eq_zero_of_locally_eq_zero _ _ fun y hy => ?_
  obtain ⟨V₁, h₁, hy₁, x, hx⟩ := exists_eq_Φ N X (-1) i hV w hy
  obtain ⟨V₂, h₂, hy₂, hu⟩ := exists_isUnit_contraction N 1 i (h₁.trans hV) hy₁
  refine ⟨V₂, h₂.trans h₁, hy₂, ?_⟩
  set x₂ := resM X h₂ x
  have hΦ : resM _ (h₂.trans h₁) w = Φ N X (-1) i ((h₂.trans h₁).trans hV) x₂ := by
    rw [← res_Φ N X (-1) i (h₁.trans hV) h₂ x, ← hx, resM_resM]
  have h0 : (μ N c X).val.app (op V₂) (Φ N X (-1) i ((h₂.trans h₁).trans hV) x₂) = 0 := by
    rw [← hΦ]
    refine (PresheafOfModules.naturality_apply (μ N c X).val (homOfLE (h₂.trans h₁)).op w).trans ?_
    change resM X _ ((μ N c X).val.app (op V) w) = 0
    rw [hw]
    exact map_zero _
  set gc : (RR N).obj.obj (op V₂) :=
    (RR N).obj.map (homOfLE ((h₂.trans h₁).trans hV)).op (gF N c i)
  have hgx : gc • x₂ = 0 := gF_smul_eq_zero_of_μ_Φ_eq_zero N _ hu h0
  rw [resM_smul, resA_resA, hΦ]
  change gc • _ = 0
  rw [← Φ_smul, hgx, Φ_zero]

/-- A map surjective on `H⁰` is surjective on global sections. -/
private lemma surjective_app_top_of_surjective_Hmap {A B : Md N} (f : A ⟶ B)
    (h : Function.Surjective (Hmap N 0 f).hom) : Function.Surjective (f.val.app (op ⊤)) := by
  obtain ⟨⟨hEI, -⟩, -, ⟨⟨E, -⟩, -⟩, -⟩ := sheafCohomology_toolkit.{0, 0, 0, 0, 0} (space (PP N))
  haveI := hEI
  haveI : (globalSections (space (PP N))).Additive := globalSections_additive _
  haveI := preservesFiniteLimits_globalSections (space (PP N))
  let η := E (space (PP N)) 0 ≪≫ (globalSections (space (PP N))).rightDerivedZeroIsoSelf
  have key := η.hom.naturality ((SheafOfModules.toSheaf _).map f)
  intro b
  obtain ⟨a', ha'⟩ := h ((η.inv.app _) b)
  refine ⟨(η.hom.app ((SheafOfModules.toSheaf _).obj A)) a', ?_⟩
  have e1 := ConcreteCategory.congr_hom key a'
  change ((η.hom.app _) ((Hmap N 0 f).hom a')) = _ at e1
  have e2 : (η.hom.app ((SheafOfModules.toSheaf _).obj B)) ((η.inv.app _) b) = b :=
    ConcreteCategory.congr_hom (η.inv_hom_id_app
      (show TopCat.Sheaf AddCommGrpCat.{0} (space (PP N)) from (SheafOfModules.toSheaf _).obj B)) b
  rw [ha', e2] at e1
  exact e1.symm

private lemma whiskerRight_tmul {A A' : Md N} (f : A ⟶ A') (Z : Md N) {V : Opens (space (PP N))}
    (a : A.val.obj (op V)) (z : Z.val.obj (op V)) :
    (f ▷ Z).val.app (op V) (tmul N a z) = tmul N (f.val.app (op V) a) z := by
  have hO := (Sheaf.toRingCat _ (structureSheaf (PP N))).property
  exact Stacks.TensorSheafWorld.whiskerRight_val_app_tensorSheafUnit
    (structureSheaf (PP N)) hO (op V) f Z a z

/-- Isomorphic sheaves have cohomology of the same dimension. -/
private lemma finrank_Hq_eq {X Y : Md N} (e : X ≅ Y) (q : ℕ) :
    Module.finrank ℂ (Hq N q X) = Module.finrank ℂ (Hq N q Y) := by
  refine (LinearEquiv.ofLinear (HmapL N q e.hom) (HmapL N q e.inv) ?_ ?_).finrank_eq
  · refine LinearMap.ext fun y => ?_
    change (Hmap N q e.inv ≫ Hmap N q e.hom).hom y = y
    rw [← Hmap_comp, e.inv_hom_id, Hmap_id]
    rfl
  · refine LinearMap.ext fun y => ?_
    change (Hmap N q e.hom ≫ Hmap N q e.inv).hom y = y
    rw [← Hmap_comp, e.hom_inv_id, Hmap_id]
    rfl

omit N in
/-- A sequence of natural numbers which is eventually non-increasing is eventually constant. -/
private lemma exists_forall_eq_of_le_pred (a : ℤ → ℕ) (k₁ : ℤ)
    (h : ∀ k, k₁ < k → a k ≤ a (k - 1)) : ∃ k₂, k₁ ≤ k₂ ∧ ∀ k, k₂ ≤ k → a k = a k₂ := by
  classical
  have hex : ∃ n, ∃ k, k₁ ≤ k ∧ a k = n := ⟨a k₁, k₁, le_rfl, rfl⟩
  obtain ⟨k₂, hk₂, hk₂e⟩ := Nat.find_spec hex
  refine ⟨k₂, hk₂, fun k hk => le_antisymm ?_ ?_⟩
  · induction k, hk using Int.leInduction with
    | base => exact le_rfl
    | succ k hk ih =>
      have := h (k + 1) (by omega)
      rw [add_sub_cancel_right] at this
      exact this.trans ih
  · rw [hk₂e]
    exact Nat.find_min' hex ⟨k, hk₂.trans hk, rfl⟩

/-- **Global sections along the hyperplane.** If the kernel and cokernel of multiplication by `c`
on `M` satisfy the theorem, then for large `k` every global section of the cokernel twisted by
`k` lifts to `M(k)`. -/
private lemma exists_surjective_app_top {M : Md N} (hcoh : IsCoherentModule M) (c : Form N)
    (hK : Good N (kernel (μ N c M))) (hC : Good N (cokernel (μ N c M))) :
    ∃ k₂ : ℤ, ∀ k, k₂ ≤ k →
      Function.Surjective ((cokernel.π (μ N c M) ▷ L N k).val.app (op ⊤)) := by
  set μ' := μ N c M
  obtain ⟨kK, hkK⟩ := hK
  obtain ⟨kC, hkC⟩ := hC
  have hM₁ : IsCoherentModule (M ⊗ L N (-1)) := isCoherentModule_tw N hcoh (-1)
  have hCo : IsCoherentModule (cokernel μ') := isCoherentModule_cokernel μ' hM₁.1 hcoh
  have hI₀ : IsCoherentModule (Abelian.image μ') := isCoherentModule_kernel (cokernel.π μ') hcoh hCo
  have hz1 : kernel.ι μ' ≫ Abelian.factorThruImage μ' = 0 := by
    rw [← cancel_mono (Abelian.image.ι μ'), Category.assoc, Abelian.image.fac, kernel.condition,
      zero_comp]
  let S1 : ShortComplex (Md N) := ShortComplex.mk (kernel.ι μ') (Abelian.factorThruImage μ') hz1
  have hS1 : S1.ShortExact :=
    { exact := ShortComplex.exact_of_f_is_kernel _
        (isKernelOfComp (Abelian.image.ι μ') μ' (kernelIsKernel μ') hz1 (Abelian.image.fac μ'))
      mono_f := inferInstanceAs (Mono (kernel.ι _))
      epi_g := inferInstanceAs (Epi (Abelian.factorThruImage _)) }
  let S2 : ShortComplex (Md N) :=
    ShortComplex.mk (Abelian.image.ι μ') (cokernel.π μ') (kernel.condition (cokernel.π μ'))
  have hS2 : S2.ShortExact :=
    { exact := ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel (cokernel.π μ'))
      mono_f := inferInstanceAs (Mono (kernel.ι _))
      epi_g := inferInstance }
  let a : ℤ → ℕ := fun k => Module.finrank ℂ (Hq N 1 (tw N k M))
  let b : ℤ → ℕ := fun k => Module.finrank ℂ (Hq N 1 (tw N k (Abelian.image μ')))
  have hfin : ∀ k, FiniteDimensional ℂ (Hq N 1 (tw N k (Abelian.image μ'))) := fun k =>
    finiteDimensional_Hq N (isCoherentModule_tw N hI₀ k) 1
  have hfinM : ∀ k, FiniteDimensional ℂ (Hq N 1 (tw N k M)) := fun k =>
    finiteDimensional_Hq N (isCoherentModule_tw N hcoh k) 1
  have hfin₁ : ∀ k, FiniteDimensional ℂ (Hq N 1 ((M ⊗ L N (-1)) ⊗ L N k)) := fun k =>
    finiteDimensional_Hq N (isCoherentModule_tw N hM₁ k) 1
  -- the two surjections in degree one
  have surj2 : ∀ k, max kK kC ≤ k →
      Function.Surjective (HmapL N 1 (Abelian.image.ι μ' ▷ L N k)) := fun k hk =>
    surjective_Hmap_f_of_isZero N (ShortComplex.ShortExact.tw N hS2 k) 1
      ((hkC k ((le_max_right _ _).trans hk)).2 1 le_rfl)
  have surj1 : ∀ k, max kK kC ≤ k →
      Function.Surjective (HmapL N 1 (Abelian.factorThruImage μ' ▷ L N k)) := fun k hk =>
    surjective_Hmap_g_of_isZero N (ShortComplex.ShortExact.tw N hS1 k) 1
      ((hkK k ((le_max_left _ _).trans hk)).2 2 (by norm_num))
  have hiso : ∀ k, Module.finrank ℂ (Hq N 1 ((M ⊗ L N (-1)) ⊗ L N k)) = a (k - 1) := fun k =>
    finrank_Hq_eq N (α_ _ _ _ ≪≫ whiskerLeftIso M (tensorLIso N (-1) k ≪≫
      eqToIso (congrArg (L N) (by ring)))) 1
  have hb_le : ∀ k, max kK kC ≤ k → b k ≤ a (k - 1) := fun k hk =>
    (LinearMap.finrank_le_finrank_of_surjective (surj1 k hk)).trans (hiso k).le
  have ha_le : ∀ k, max kK kC ≤ k → a k ≤ b k := fun k hk =>
    LinearMap.finrank_le_finrank_of_surjective (surj2 k hk)
  obtain ⟨k₂, hk₂, hconst⟩ := exists_forall_eq_of_le_pred a (max kK kC) fun k hk =>
    (ha_le k hk.le).trans (hb_le k hk.le)
  refine ⟨k₂ + 1, fun k hk => ?_⟩
  have hk' : max kK kC ≤ k := by omega
  have hab : a k = b k := le_antisymm (ha_le k hk') ((hb_le k hk').trans
    (by rw [hconst (k - 1) (by omega), hconst k (by omega)]))
  have hinj : Function.Injective (HmapL N 1 (Abelian.image.ι μ' ▷ L N k)) :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hab.symm).2 (surj2 k hk')
  exact surjective_app_top_of_surjective_Hmap N _
    (surjective_Hmap_g_of_injective N (ShortComplex.ShortExact.tw N hS2 k) 0 hinj)

end HyperplaneTools

/-! ### The three cases of the generation step -/

/-- Off `Z(W)` a sheaf annihilated by `W` vanishes near the point. -/
private lemma genAt_of_ev_ne_zero {W : Finset (Form N)} {M : Md N} (hM : KilledBy N W M)
    {c : Form N} (hc : c ∈ W) {x : space (PP N)} (hx : ev N c x ≠ 0) (k : ℤ) :
    GenAt N (tw N k M) x := by
  obtain ⟨V, hxV, hV⟩ := ((hM c hc).tensor_left N (L N k)).exists_eq_zero N hx
  exact genAt_of_zero N hxV hV

/-- If `Z(W) = {x}`, every twist of a coherent sheaf annihilated by `W` is generated near `x`. -/
private lemma genAt_of_isolated {W : Finset (Form N)} {M : Md N} (hcoh : IsCoherentModule M)
    (hM : KilledBy N W M) {x : space (PP N)}
    (hx : ∀ y : space (PP N), (∀ c ∈ W, ev N c y = 0) → y = x) (k : ℤ) :
    GenAt N (tw N k M) x := by
  classical
  have hX : KilledBy N W (tw N k M) := hM.tensor_left N (L N k)
  -- `M(k)` vanishes near every point other than `x`
  have hzero : ∀ y, y ≠ x → ∃ V : Opens (space (PP N)), y ∈ V ∧
      ∀ (Y : Opens (space (PP N))) (_ : Y ≤ V) (m : (tw N k M).val.obj (op Y)), m = 0 := by
    intro y hy
    have : ∃ c ∈ W, ev N c y ≠ 0 := by
      by_contra h
      push Not at h
      exact hy (hx y h)
    obtain ⟨c, hc, hcy⟩ := this
    exact (hX c hc).exists_eq_zero N hcy
  have hft : SheafOfModules.IsFiniteType.{0} (tw N k M) := (isCoherentModule_tw N hcoh k).1
  obtain ⟨W₀, hxW₀, m, g, hg⟩ := (CoherentAnalytic.isFiniteType_iff_finGen _).1 hft x
  haveI := MMP.Analytic.ProjectiveTwists.locallyOfFiniteType_sP N
  haveI : IsSeparated (PP N) := by
    haveI := Stacks.ProjCoherentCohomologyFinite.isProper_projToSpecCoeff ℂ N
    infer_instance
  haveI : T2Space (space (PP N)) := MMP.Analytic.ComplexPoints.t2Space_of_locallyOfFiniteType
    (sX := PP N)
  let O : Opens (space (PP N)) := ⟨{x}ᶜ, isOpen_compl_singleton⟩
  -- every local generator near `x` extends by zero to a global section
  have hext : ∀ j, ∃ σ : (tw N k M).val.obj (op ⊤),
      CoherentAnalytic.resM _ (le_top : W₀ ≤ ⊤) σ = g j := by
    intro j
    let F : TopCat.Sheaf AddCommGrpCat.{0} (space (PP N)) :=
      ⟨(tw N k M).val.presheaf, (tw N k M).isSheaf⟩
    let Uc : Bool → Opens (space (PP N)) := fun b => bif b then W₀ else O
    let sf : ∀ b, ToType (F.1.obj (op (Uc b))) := fun b => match b with
      | true => g j
      | false => 0
    have hz : ∀ (Y : Opens (space (PP N))) (hY : Y ≤ W₀), Y ≤ O →
        CoherentAnalytic.resM _ hY (g j) = 0 := by
      intro Y hY hYO
      refine CoherentAnalytic.eq_zero_of_locally_eq_zero _ _ fun y hy => ?_
      obtain ⟨V, hyV, hV⟩ := hzero y (hYO hy)
      exact ⟨Y ⊓ V, inf_le_left, ⟨hy, hyV⟩, hV _ inf_le_right _⟩
    have hcompat : TopCat.Presheaf.IsCompatible F.1 Uc sf := by
      intro a b
      cases a <;> cases b
      · exact (map_zero _).trans (map_zero _).symm
      · exact (map_zero _).trans (hz _ inf_le_right inf_le_left).symm
      · exact (hz _ inf_le_left inf_le_right).trans (map_zero _).symm
      · rfl
    have hcover : (⊤ : Opens (space (PP N))) ≤ iSup Uc := by
      intro y _
      by_cases hy : y = x
      · exact Opens.mem_iSup.2 ⟨true, hy ▸ hxW₀⟩
      · exact Opens.mem_iSup.2 ⟨false, hy⟩
    obtain ⟨σ, hσ, -⟩ := F.existsUnique_gluing' Uc ⊤ (fun b => homOfLE le_top) hcover sf hcompat
    exact ⟨σ, hσ true⟩
  choose σ hσ using hext
  refine ⟨W₀, hxW₀, m, σ, ?_⟩
  have : (fun j => CoherentAnalytic.resM _ (le_top : W₀ ≤ ⊤) (σ j)) = g := funext hσ
  unfold GenOn
  rw [this]
  exact hg

/-! ### Vanishing from generation -/

section Vanishing

open CoherentAnalytic MMP.Analytic.ProjectiveTwists

/-- A sheaf generated by no sections has no cohomology, in any twist. -/
private lemma isZero_Hq_of_genOn_zero {X : Md N} {t : Fin 0 → X.val.obj (op ⊤)}
    (ht : GenOn N X t ⊤) (q : ℕ) (k : ℤ) : IsZero (Hq N q (tw N k X)) := by
  have h0 : ∀ (U : Opens (space (PP N))) (z : X.val.obj (op U)), z = 0 := fun U z =>
    eq_zero_of_locally_eq_zero X z fun y hy => by
      obtain ⟨U', h, hy', c, hc⟩ := GenOn.exists_nhds N ht (le_top : U ≤ ⊤) z hy
      exact ⟨U', h, hy', hc.trans (by simp)⟩
  have hX : IsZero X := (IsZero.iff_id_eq_zero X).2 (by
    ext U z
    exact h0 _ _)
  haveI := preservesZeroMorphisms_tw N k
  haveI := sheafCohomology_preservesZeroMorphisms (space (PP N)) (q : ℤ)
  exact (sheafCohomology _ _).map_isZero ((SheafOfModules.toSheaf _).map_isZero
    ((tensorRight (L N k)).map_isZero hX))

/-- Generation by finitely many generating sections gives generation by global sections. -/
private lemma genOn_top_of_gen {M : Md N} (h : Gen N M) :
    ∃ (p : ℕ) (t : Fin p → M.val.obj (op ⊤)), GenOn N M t ⊤ := by
  classical
  obtain ⟨σ, hσ⟩ := h
  haveI := σ.epi
  haveI : Fintype σ.I := Fintype.ofFinite _
  let e := Fintype.equivFin σ.I
  refine ⟨Fintype.card σ.I, fun k => (σ.s (e.symm k)).1 (op ⊤),
    locallyGenerates_of_nhds _ fun U hU q y hy => ?_⟩
  obtain ⟨S, hS, hlift⟩ := OkaCoherence.exists_local_lift (M.freeHomEquiv.symm σ.s) q
  obtain ⟨V', f, hf, hy'⟩ := (Opens.mem_grothendieckTopology _).1 hS y hy
  obtain ⟨ξ, hξ⟩ := hlift f hf
  obtain ⟨a, ha⟩ := exists_eq_sum_smul_freeSection' (R := RR N) (op V') ξ
  refine ⟨V', f.le, hy', fun k => a (e.symm k), ?_⟩
  change M.val.map f.op q = _
  rw [← hξ, ha, map_sum]
  rw [← e.symm.sum_comp]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_smul, OkaCoherence.freeHomEquiv_symm_app_freeSection]
  exact congrArg (a (e.symm k) • ·)
    (((σ.s (e.symm k)).2 (homOfLE (le_top : V' ≤ ⊤)).op).symm.trans (resM_resM M _ _ _).symm)

/-- **One step of the descending induction.** Let `π : 𝒪 ⟶ F` be the quotient of
`exists_resolvent` for `e`. If vanishing holds in degree `q + 1` for all coherent sheaves killed by
`e`, then it holds in degree `q ≥ 1` for every coherent sheaf killed by `e` and generated by global
sections; the proof is by induction on the number of generators. -/
private lemma van_genOn {n : ℕ} {e : Fin n → Form N} {F : Md N} (π : 𝟙_ (Md N) ⟶ F) [Epi π]
    (hFcoh : IsCoherentModule F) (hFkill : ∀ k, Killed N (e k) F)
    (hfac : ∀ Y : Md N, (∀ k, Killed N (e k) Y) → ∀ s : 𝟙_ (Md N) ⟶ Y, ∃ s' : F ⟶ Y, π ≫ s' = s)
    (hFvan : ∃ j₀ : ℤ, ∀ j, j₀ ≤ j → ∀ q : ℕ, 1 ≤ q → IsZero (Hq N q (tw N j F)))
    (q : ℕ) (hq : 1 ≤ q)
    (IH : ∀ R : Md N, IsCoherentModule R → (∀ k, Killed N (e k) R) →
      ∃ k₀ : ℤ, ∀ k, k₀ ≤ k → IsZero (Hq N (q + 1) (tw N k R))) :
    ∀ (p : ℕ) (X : Md N), IsCoherentModule X → (∀ k, Killed N (e k) X) →
      ∀ t : Fin p → X.val.obj (op ⊤), GenOn N X t ⊤ →
        ∃ k₀ : ℤ, ∀ k, k₀ ≤ k → IsZero (Hq N q (tw N k X))
  | 0, X, _, _, t, ht => ⟨0, fun k _ => isZero_Hq_of_genOn_zero N ht q k⟩
  | p + 1, X, hX, hXk, t, ht => by
    let s₀ : 𝟙_ (Md N) ⟶ X := X.unitHomEquiv.symm (topSection N X (t 0))
    have hs₀ : ∀ (V : Opens (space (PP N))) (r : (RR N).obj.obj (op V)),
        s₀.val.app (op V) (toUnit N r) = r • resM X (le_top : V ≤ ⊤) (t 0) := fun V r => rfl
    have hC : IsCoherentModule (cokernel s₀) :=
      isCoherentModule_cokernel s₀ (isCoherentModule_unit N).1 hX
    have hY : IsCoherentModule (Abelian.image s₀) := isCoherentModule_kernel (cokernel.π s₀) hX hC
    have hYk : ∀ k, Killed N (e k) (Abelian.image s₀) := fun k =>
      Killed.kernel N (cokernel.π s₀) (hXk k)
    have hCk : ∀ k, Killed N (e k) (cokernel s₀) := fun k => Killed.of_epi N (cokernel.π s₀) (hXk k)
    -- the quotient `C = X / 𝒪 t₀` is generated by the images of the other sections
    let tC : Fin p → (cokernel s₀).val.obj (op ⊤) := fun k =>
      (cokernel.π s₀).val.app (op ⊤) (t k.succ)
    have htC : GenOn N (cokernel s₀) tC ⊤ := by
      refine locallyGenerates_of_nhds _ fun U hU z y hy => ?_
      obtain ⟨S, hS, hlift⟩ := OkaCoherence.exists_local_lift (cokernel.π s₀) z
      obtain ⟨V₁, f₁, hf₁, hy₁⟩ := (Opens.mem_grothendieckTopology _).1 hS y hy
      obtain ⟨x, hx⟩ := hlift f₁ hf₁
      obtain ⟨V₂, h₂, hy₂, c, hc⟩ := GenOn.exists_nhds N ht (le_top : V₁ ≤ ⊤) x hy₁
      refine ⟨V₂, h₂.trans f₁.le, hy₂, fun k => c k.succ, ?_⟩
      have e1 : resM _ (h₂.trans f₁.le) z = (cokernel.π s₀).val.app (op V₂) (resM X h₂ x) := by
        rw [← resM_resM _ f₁.le h₂]
        change resM _ h₂ ((cokernel s₀).val.map f₁.op z) = _
        rw [← hx]
        exact (PresheafOfModules.naturality_apply (cokernel.π s₀).val (homOfLE h₂).op x).symm
      have e0 : (cokernel.π s₀).val.app (op V₂) (c 0 • resM X (le_top : V₂ ≤ ⊤) (t 0)) = 0 := by
        rw [map_smul]
        have h1 : resM X (le_top : V₂ ≤ ⊤) (t 0) = s₀.val.app (op V₂) (toUnit N 1) := by
          rw [hs₀, one_smul]
        rw [h1]
        have h2 : (cokernel.π s₀).val.app (op V₂) (s₀.val.app (op V₂) (toUnit N 1)) = 0 :=
          congrArg (fun φ => φ.val.app (op V₂) (toUnit N 1)) (cokernel.condition s₀)
        rw [h2, smul_zero]
      rw [e1, hc, map_sum, Fin.sum_univ_succ, e0, zero_add]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_smul, resM_resM]
      refine congrArg (c k.succ • ·) ?_
      change (cokernel.π s₀).val.app (op V₂) (X.val.map (homOfLE (le_top : V₂ ≤ ⊤)).op (t k.succ)) =
        (cokernel s₀).val.map (homOfLE (le_top : V₂ ≤ ⊤)).op
          ((cokernel.π s₀).val.app (op ⊤) (t k.succ))
      exact PresheafOfModules.naturality_apply (cokernel.π s₀).val
        (homOfLE (le_top : V₂ ≤ ⊤)).op (t k.succ)
    obtain ⟨kC, hkC⟩ := van_genOn π hFcoh hFkill hfac hFvan q hq IH p (cokernel s₀) hC hCk tC htC
    -- the cyclic part `𝒪 t₀` is a quotient of `F`
    obtain ⟨s', hs'⟩ := hfac _ hYk (Abelian.factorThruImage s₀)
    haveI : Epi s' := epi_of_epi_fac hs'
    have hR : IsCoherentModule (kernel s') := isCoherentModule_kernel s' hFcoh hY
    have hRk : ∀ k, Killed N (e k) (kernel s') := fun k => Killed.kernel N s' (hFkill k)
    obtain ⟨kR, hkR⟩ := IH _ hR hRk
    obtain ⟨j₀, hj₀⟩ := hFvan
    refine ⟨max (max j₀ kR) kC, fun k hk => ?_⟩
    have S2 : (ShortComplex.mk (kernel.ι s') s' (kernel.condition s')).ShortExact :=
      { exact := ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel s')
        mono_f := inferInstance
        epi_g := inferInstance }
    have hYv : IsZero (Hq N q (tw N k (Abelian.image s₀))) :=
      les_isZero N (ShortComplex.ShortExact.tw N S2 k) q
        (hj₀ k ((le_max_left _ _).trans ((le_max_left _ _).trans hk)) q hq)
        (hkR k ((le_max_right _ _).trans ((le_max_left _ _).trans hk)))
    have S1 : (ShortComplex.mk (Abelian.image.ι s₀) (cokernel.π s₀)
        (kernel.condition (cokernel.π s₀))).ShortExact :=
      { exact := ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel (cokernel.π s₀))
        mono_f := inferInstanceAs (Mono (kernel.ι _))
        epi_g := inferInstance }
    exact (les_exact₂ N (ShortComplex.ShortExact.tw N S1 k) q).isZero_of_both_isZero hYv
      (hkC k ((le_max_right _ _).trans hk))

end Vanishing

/-! ### Vanishing -/

/-- `M(a)(b) ≅ M(a + b)`. -/
private def twTwIso (M : Md N) (a b : ℤ) : tw N b (tw N a M) ≅ tw N (a + b) M :=
  α_ _ _ _ ≪≫ whiskerLeftIso M (tensorLIso N a b)

/-- **Vanishing for sheaves annihilated by `W`, from generation for them**, by descending
induction on the degree, starting above the uniform bound of the finiteness theorem. -/
private lemma van_of_gen (W : Finset (Form N))
    (hW : LinearIndependent ℂ (Subtype.val : ↥(W : Set (Form N)) → Form N))
    (hA : ∀ M : Md N, IsCoherentModule M → KilledBy N W M → ∃ k₀ : ℤ, ∀ k, k₀ ≤ k →
      Gen N (tw N k M)) :
    ∀ M : Md N, IsCoherentModule M → KilledBy N W M → ∃ k₀ : ℤ, ∀ k, k₀ ≤ k →
      Van N (tw N k M) := by
  classical
  let e : Fin W.card → Form N := fun k => (W.equivFin.symm k).1
  have he : LinearIndependent ℂ e :=
    hW.comp (fun k => (⟨(W.equivFin.symm k).1, (W.equivFin.symm k).2⟩ : ↥(W : Set (Form N))))
      fun a b hab => W.equivFin.symm.injective (Subtype.ext (congrArg Subtype.val hab))
  have hKe : ∀ M : Md N, KilledBy N W M ↔ ∀ k, Killed N (e k) M := fun M =>
    ⟨fun h k => h _ (W.equivFin.symm k).2, fun h c hc => by
      have := h (W.equivFin ⟨c, hc⟩)
      simpa [e] using this⟩
  obtain ⟨F, π, hπ, hF, hk, hfac, -, hv⟩ := exists_resolvent N W.card e he
  haveI := hπ
  have hfin := projectiveSpace_finiteDimensional_sheafCohomology N
  obtain ⟨m, hm⟩ := hfin
  let P : ℕ → Prop := fun q => ∀ M : Md N, IsCoherentModule M → (∀ k, Killed N (e k) M) →
    ∃ k₀ : ℤ, ∀ k, k₀ ≤ k → ∀ q' : ℕ, q ≤ q' → IsZero (Hq N q' (tw N k M))
  have hP : ∀ d q : ℕ, 1 ≤ q → m ≤ q + d → P q := by
    intro d
    induction d with
    | zero =>
      intro q _ hq M hM _
      exact ⟨0, fun k _ q' hq' => (hm _ (isCoherentModule_tw N hM k)).1 q' (by omega)⟩
    | succ d ih =>
      intro q hq hmq M hM hMk
      have hP1 := ih (q + 1) (by omega) (by omega)
      obtain ⟨k₁, hk₁⟩ := hP1 M hM hMk
      obtain ⟨k₂, hk₂⟩ := hA M hM ((hKe M).2 hMk)
      obtain ⟨p, t, ht⟩ := genOn_top_of_gen N (hk₂ k₂ le_rfl)
      obtain ⟨kX, hkX⟩ := van_genOn N π hF hk hfac hv q hq
        (fun R hR hRk => by
          obtain ⟨k₀, hk₀⟩ := hP1 R hR hRk
          exact ⟨k₀, fun k hk => hk₀ k hk (q + 1) le_rfl⟩)
        p (tw N k₂ M) (isCoherentModule_tw N hM k₂)
        (fun k => (hMk k).tensor_left N (L N k₂)) t ht
      refine ⟨max k₁ (k₂ + kX), fun k hk q' hq' => ?_⟩
      rcases eq_or_lt_of_le hq' with rfl | hlt
      · have h1 := hkX (k - k₂) (by have := le_max_right k₁ (k₂ + kX); omega)
        refine h1.of_iso ((sheafCohomology _ _).mapIso ((SheafOfModules.toSheaf _).mapIso
          (twTwIso N M k₂ (k - k₂) ≪≫ eqToIso (congrArg (fun j => tw N j M) (by ring))))).symm
      · exact hk₁ k ((le_max_left _ _).trans hk) q' hlt
  intro M hM hMk
  obtain ⟨k₀, hk₀⟩ := hP m 1 le_rfl (by omega) M hM ((hKe M).1 hMk)
  exact ⟨k₀, fun k hk q hq => hk₀ k hk q hq⟩

open CoherentAnalytic in
/-- The hyperplane step: if Serre's theorem holds for coherent sheaves annihilated by
`insert c W`, then large twists of a coherent sheaf annihilated by `W` are generated near every
point of the hyperplane `c = 0`. -/
private lemma exists_genAt_of_hyperplane {W : Finset (Form N)} {M : Md N}
    (hcoh : IsCoherentModule M) (hM : KilledBy N W M) (c : Form N)
    (IH : ∀ M' : Md N, IsCoherentModule M' → KilledBy N (insert c W) M' → Good N M') :
    ∃ k₁ : ℤ, ∀ x : space (PP N), ev N c x = 0 → GenAt N (tw N k₁ M) x := by
  classical
  let μ' := μ N c M
  have hM₁ : IsCoherentModule (M ⊗ L N (-1)) := isCoherentModule_tw N hcoh (-1)
  have hKcoh : IsCoherentModule (kernel μ') := isCoherentModule_kernel μ' hM₁ hcoh
  have hCcoh : IsCoherentModule (cokernel μ') := isCoherentModule_cokernel μ' hM₁.1 hcoh
  have hKk : KilledBy N (insert c W) (kernel μ') := fun d hd => by
    rcases Finset.mem_insert.1 hd with rfl | hd
    · exact killed_kernel_μ N d M
    · exact Killed.kernel N μ' ((hM d hd).tensor_left N (L N (-1)))
  have hCk : KilledBy N (insert c W) (cokernel μ') := fun d hd => by
    rcases Finset.mem_insert.1 hd with rfl | hd
    · exact killed_cokernel_μ N d M
    · exact Killed.of_epi N (cokernel.π μ') (hM d hd)
  have hK := IH _ hKcoh hKk
  have hC := IH _ hCcoh hCk
  obtain ⟨k₂, hsurj⟩ := exists_surjective_app_top N hcoh c hK hC
  obtain ⟨kC, hkC⟩ := hC
  obtain ⟨k, hk₂, hkC'⟩ : ∃ k, k₂ ≤ k ∧ kC ≤ k := ⟨max k₂ kC, le_max_left _ _, le_max_right _ _⟩
  refine ⟨k, fun x hx => ?_⟩
  let g : tw N k M ⟶ tw N k (cokernel μ') := cokernel.π μ' ▷ L N k
  obtain ⟨p, u, hu⟩ := genOn_top_of_gen N (hkC k hkC').1
  choose t ht using fun j => hsurj k hk₂ (u j)
  obtain ⟨i, hxi⟩ : ∃ i, x ∈ U N i := ⟨iOf N x, mem_U_iOf N x⟩
  haveI := preservesFiniteColimits_tw N k
  let ψ := (tensorRight (L N k)).map μ'
  have hψg : cokernel.π ψ ≫ cokernelComparison μ' (tensorRight (L N k)) = g :=
    π_comp_cokernelComparison _ _
  suffices H : ∀ (V : Opens (space (PP N))) (z : (tw N k M).val.obj (op V)), x ∈ V →
      ∃ (V' : Opens (space (PP N))) (hV' : V' ≤ V ⊓ U N i) (hx : x ∈ V')
        (a : Fin p → (RR N).obj.obj (op V')) (m : ℕ) (b : Fin m → (RR N).obj.obj (op V'))
        (u : Fin m → (tw N k M).val.obj (op V')),
        (∀ j, val N (hV'.trans inf_le_right) (b j) ⟨x, hx⟩ = 0) ∧
        resM _ (hV'.trans inf_le_left) z =
          ∑ j, a j • resM _ (le_top : V' ≤ ⊤) (t j) + ∑ j, b j • u j by
    obtain ⟨W', hxW', hgen⟩ :=
      exists_genOn_of_generates_mod N (isCoherentModule_tw N hcoh k).1 i hxi t H
    exact ⟨W', hxW', p, t, hgen⟩
  intro V z hxV
  obtain ⟨V₁, h₁, hx₁, a, ha⟩ := GenOn.exists_nhds N hu (le_top : V ≤ ⊤) (g.val.app (op V) z) hxV
  let y : (tw N k M).val.obj (op V₁) :=
    resM _ h₁ z - ∑ j, a j • resM _ (le_top : V₁ ≤ ⊤) (t j)
  have hy : g.val.app (op V₁) y = 0 := by
    change g.val.app (op V₁) (resM _ h₁ z - ∑ j, a j • resM _ (le_top : V₁ ≤ ⊤) (t j)) = 0
    rw [map_sub, hom_resM, ha, map_sum, sub_eq_zero]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, hom_resM, ht j]
  have hy' : (cokernel.π ψ).val.app (op V₁) y = 0 := by
    have e2 : (cokernel.π ψ).val.app (op V₁) y =
        (inv (cokernelComparison μ' (tensorRight (L N k)))).val.app (op V₁)
          (g.val.app (op V₁) y) := by
      rw [← hψg]
      change _ = (cokernel.π ψ ≫ cokernelComparison _ _ ≫
        inv (cokernelComparison μ' (tensorRight (L N k)))).val.app (op V₁) y
      rw [IsIso.hom_inv_id, Category.comp_id]
    rw [e2, hy, map_zero]
  obtain ⟨V₂, h₂, hx₂, σ, hσ⟩ := exists_eq_of_cokernel_π_eq_zero ψ y hy' hx₁
  let σ₁ : ((M ⊗ L N (-1)) ⊗ L N k).val.obj (op V₂) := σ
  let σ₂ : (tw N k (tw N (-1) M)).val.obj (op V₂) := σ₁
  have hxm : x ∈ V₂ ⊓ U N i := ⟨hx₂, hxi⟩
  obtain ⟨V₅, h₅, hx₅, m, hm⟩ := exists_eq_Φ_Φ N M k i (inf_le_right : V₂ ⊓ U N i ≤ U N i)
    (resM (tw N k (tw N (-1) M)) (inf_le_left : V₂ ⊓ U N i ≤ V₂) σ₂) hxm
  have hV₅i : V₅ ≤ U N i := h₅.trans inf_le_right
  have hV₅₂ : V₅ ≤ V₂ := h₅.trans inf_le_left
  have hV₅₁ : V₅ ≤ V₁ := hV₅₂.trans h₂
  have hV₅ : V₅ ≤ V := hV₅₁.trans h₁
  let gc : (RR N).obj.obj (op V₅) := (RR N).obj.map (homOfLE hV₅i).op (gF N c i)
  let w : (RR N).obj.obj (op V₅) := ofUnit N ((LinvIso N 1).hom.val.app (op V₅)
    (tmul N (uS N 1 i hV₅i) (uS N (-1) i hV₅i)))
  let u0 : (tw N k M).val.obj (op V₅) := w • tmul N m (uS N k i hV₅i)
  have E1 : resM (tw N k (tw N (-1) M)) hV₅₂ σ₂ =
      Φ N (tw N (-1) M) k i hV₅i (Φ N M (-1) i hV₅i m) := by
    rw [← resM_resM _ (inf_le_left : V₂ ⊓ U N i ≤ V₂) h₅, hm]
  have E2 : (μ' ▷ L N k).val.app (op V₅) (resM (tw N k (tw N (-1) M)) hV₅₂ σ₂) =
      resM _ hV₅₁ y := by
    have e := hom_resM ψ hV₅₂ σ
    rw [hσ, resM_resM] at e
    exact e
  have E3 : (μ' ▷ L N k).val.app (op V₅) (Φ N (tw N (-1) M) k i hV₅i (Φ N M (-1) i hV₅i m)) =
      gc • u0 := by
    refine (whiskerRight_tmul N μ' (L N k) _ _).trans ?_
    rw [μ_Φ, tmul_smul_left, mul_smul]
  have E4 : resM _ hV₅₁ y = resM _ hV₅ z -
      ∑ j, (RR N).obj.map (homOfLE hV₅₁).op (a j) • resM _ (le_top : V₅ ≤ ⊤) (t j) := by
    change (tw N k M).val.map (homOfLE hV₅₁).op
      (resM _ h₁ z - ∑ j, a j • resM _ (le_top : V₁ ≤ ⊤) (t j)) = _
    rw [map_sub]
    change resM _ hV₅₁ (resM _ h₁ z) - resM _ hV₅₁ (∑ j, a j • resM _ (le_top : V₁ ≤ ⊤) (t j)) = _
    rw [resM_resM, resM_sum_smul]
    simp only [resM_resM]
  refine ⟨V₅, le_inf hV₅ hV₅i, hx₅, fun j => (RR N).obj.map (homOfLE hV₅₁).op (a j), 1, ![gc],
    ![u0], fun j => ?_, ?_⟩
  · fin_cases j
    exact (ev_eq_zero_iff N c i ⟨x, hxi⟩).1 hx
  · rw [Fin.sum_univ_one]
    have key := E2.symm.trans ((congrArg _ E1).trans E3)
    rw [E4] at key
    exact sub_eq_iff_eq_add'.1 key

/-! ### The induction -/

private lemma good_of_killedBy :
    ∀ (r : ℕ) (W : Finset (Form N)),
      LinearIndependent ℂ (Subtype.val : ↥(W : Set (Form N)) → Form N) →
      N + 1 - Module.finrank ℂ (Submodule.span ℂ (W : Set (Form N))) = r →
      ∀ M : Md N, IsCoherentModule M → KilledBy N W M → Good N M := by
  intro r
  induction r using Nat.strong_induction_on with
  | _ r IH =>
  intro W hWli hW
  -- generation for sheaves annihilated by `W`
  have hA : ∀ M : Md N, IsCoherentModule M → KilledBy N W M → ∃ k₀ : ℤ, ∀ k, k₀ ≤ k →
      Gen N (tw N k M) := by
    intro M hcoh hM
    refine exists_forall_gen_of_forall_exists N fun x => ?_
    by_cases hZ : ∀ c ∈ W, ev N c x = 0
    · rcases exists_form_or_isolated N W x with ⟨c, hcx, hcW⟩ | hiso
      · have hlt : Module.finrank ℂ (Submodule.span ℂ (W : Set (Form N))) <
            Module.finrank ℂ
              (Submodule.span ℂ ((insert c W : Finset (Form N)) : Set (Form N))) := by
          classical
          refine Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne
            (Submodule.span_mono (by simp)) fun h => hcW ?_)
          rw [h]
          exact Submodule.subset_span (by simp)
        have hle : Module.finrank ℂ
            (Submodule.span ℂ ((insert c W : Finset (Form N)) : Set (Form N))) ≤ N + 1 := by
          have := Submodule.finrank_le
            (Submodule.span ℂ ((insert c W : Finset (Form N)) : Set (Form N)))
          simpa using this
        have hcW' : c ∉ (W : Set (Form N)) := fun h => hcW (Submodule.subset_span h)
        have hli : LinearIndependent ℂ
            (Subtype.val : ↥((insert c W : Finset (Form N)) : Set (Form N)) → Form N) := by
          rw [Finset.coe_insert]
          exact (linearIndepOn_id_insert hcW').2 ⟨hWli, hcW⟩
        obtain ⟨k₁, hk₁⟩ := exists_genAt_of_hyperplane N hcoh hM c
          (IH _ (by omega) (insert c W) hli rfl)
        exact ⟨k₁, hk₁ x hcx⟩
      · exact ⟨0, genAt_of_isolated N hcoh hM hiso 0⟩
    · push Not at hZ
      obtain ⟨c, hc, hcx⟩ := hZ
      exact ⟨0, genAt_of_ev_ne_zero N hM hc hcx 0⟩
  have hB := van_of_gen N W hWli hA
  intro M hcoh hM
  obtain ⟨k₁, hk₁⟩ := hA M hcoh hM
  obtain ⟨k₂, hk₂⟩ := hB M hcoh hM
  exact ⟨max k₁ k₂, fun k hk => ⟨hk₁ k (le_of_max_le_left hk), hk₂ k (le_of_max_le_right hk)⟩⟩

private theorem good (M : Md N) (hM : IsCoherentModule M) : Good N M :=
  haveI : IsEmpty ↥((∅ : Finset (Form N)) : Set (Form N)) := ⟨fun x => by simpa using x.2⟩
  good_of_killedBy N _ ∅ linearIndependent_empty_type rfl M hM (killedBy_empty N M)

end

end ProjectiveSerre

open Stacks.AlgebraicGeometry.ProjPolyChart (projToSpecCoeff)

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **Serre's theorem on `(ℙᴺ_ℂ)^an`.** For a coherent sheaf of modules `𝒮` over the structure
sheaf of `(ℙᴺ_ℂ)^an` there is `k₀` such that for all `k ≥ k₀` the twist
`𝒮(k) = 𝒮 ⊗ 𝒪(k)^an` is generated by finitely many global sections and
`H^q((ℙᴺ_ℂ)^an, 𝒮(k)) = 0` for all `q ≥ 1`. -/
@[mmp "thm_mmp_gaga_projective_analytic_serre"]
public theorem exists_isFiniteType_generatingSections_isZero_sheafCohomology_twist (N : ℕ)
    (S : SheafOfModules.{0} (ringCatSheaf (projToSpecCoeff ℂ N)))
    (hS : IsCoherentModule S) :
    ∃ k₀ : ℤ, ∀ k : ℤ, k₀ ≤ k →
      (∃ σ : (((Stacks.SheafOfModules.Tensor.sheafTensor.{0, 0, 0, 0, 0}
          (structureSheaf (projToSpecCoeff ℂ N))).obj S).obj
          ((analytifyModule (projToSpecCoeff ℂ N)).obj
            (ProjectiveSpectrum.Proj.twistingSheaf
              (polyGrading ℂ N) k))).GeneratingSections,
        σ.IsFiniteType) ∧
      ∀ q : ℕ, 1 ≤ q →
        IsZero ((sheafCohomology _ (q : ℤ)).obj ((SheafOfModules.toSheaf _).obj
          (((Stacks.SheafOfModules.Tensor.sheafTensor.{0, 0, 0, 0, 0}
            (structureSheaf (projToSpecCoeff ℂ N))).obj S).obj
            ((analytifyModule (projToSpecCoeff ℂ N)).obj
              (ProjectiveSpectrum.Proj.twistingSheaf
                (polyGrading ℂ N) k))))) :=
  ProjectiveSerre.good N S hS

end MMP.Analytic

