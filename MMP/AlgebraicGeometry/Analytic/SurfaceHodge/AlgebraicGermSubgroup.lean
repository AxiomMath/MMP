/-!
# The subgroup of a complex torus generated by an algebraic germ

Let `X` be a scheme locally of finite type over `ℂ` and `Φ : ℂⁿ → X(ℂ)` a continuous map,
holomorphic in charts, biholomorphic near `0` and periodic for a subgroup `Λ ⊆ ℂⁿ`: for instance
the uniformisation `ℂⁿ → ℂⁿ / Λ ≅ J(ℂ)` of the Jacobian of a curve. Let `V ⊆ ℂⁿ` be a complex
subspace with `Φ(V)` contained in a Zariski-closed subset `T ⊆ X` of dimension `≤ dim V`. Then the
closure `G` of `V + Λ` is an additive subgroup of `ℂⁿ` containing `V` and `Λ` which coincides with
`V` near `0`. This is the step "the Zariski closure of `exp(V)` is a subtorus with tangent space
`V`" in the proof that the image of `H¹(S, 𝒪_S)` in the Jacobian of an ample curve on a smooth
projective surface `S` is rational.

The proof avoids the theory of algebraic groups:

* `Φ` maps `G` into `T`, since `T` is closed and `Φ(v + μ) = Φ(v)` for `μ ∈ Λ`;
* a closed subgroup of a finite-dimensional real vector space which contains `V` and has points
  outside `V` arbitrarily close to `0` contains a line `ℝ u` with `u ∉ V`;
* then `Φ(V + ℝ u) ⊆ T`. In an affine chart, `dim V + 1` linear combinations of the coordinates
  of `Φ` restrict to a local biholomorphism `h` of `V × ℂ` at `0`. If `dim T ≤ dim V`, the
  residue fields at the generic points of `T` have transcendence degree `≤ dim V`, so these
  functions satisfy a nontrivial polynomial relation `Q` on `T`. Thus `Q ∘ h` vanishes on
  `V × ℝ` near `0`, hence, by the identity theorem in the `ℂ` variable, near `0`, so `Q` vanishes
  on an open set, a contradiction.

## Main results

* `MMP.Analytic.SurfaceHodge.exists_forall_smul_mem_of_forall_exists_norm_lt`: a closed subgroup
  which is not locally the subspace `V ⊆ G` contains a line outside `V`.
* `MMP.Analytic.SurfaceHodge.exists_ne_zero_forall_eval_eq_zero`: `dim T + 1` polynomial
  functions in the coordinates of a chart are algebraically dependent on a closed set `T`.
* `MMP.Analytic.SurfaceHodge.exists_chart_analyticAt_injective_fderiv`: the chart coordinates of
  a local biholomorphism `ℂⁿ → X(ℂ)` are analytic near `0` with injective derivative.
* `MMP.Analytic.SurfaceHodge.not_topologicalKrullDim_le_of_forall_add_smul_mem`: `Φ(V + ℝ u)`
  with `u ∉ V` does not lie in a closed set of dimension `≤ dim V`.
* `MMP.Analytic.SurfaceHodge.map_add_eq_of_mem`: periodicity of a uniformisation.
* `MMP.Analytic.SurfaceHodge.exists_addSubgroup_of_subset_isClosed_of_periodic`: the subgroup
  generated by `V` and `Λ` coincides with `V` near `0`.

## Implementation notes

The map `Φ` is described by the hypotheses that
`MMP.Conductor.exists_isZLattice_exponential_of_isProjective` provides: continuity, holomorphy in
the affine charts `MMP.Analytic.Chart` of `X(ℂ)`, and a left inverse near `Φ 0` that is
holomorphic in charts. Dimension is `topologicalKrullDim` of the closed subset of the scheme, and
is compared with transcendence degrees of residue fields through
`topologicalKrullDim_closure_singleton_eq_trdeg` (Stacks 0A21).

## References

* [D. Mumford, *Abelian varieties*], §1, §4.
* [Stacks Project, Tag 0A21](https://stacks.math.columbia.edu/tag/0A21)
-/

@[expose] public section

open Set Filter Topology Metric

namespace MMP.Analytic.SurfaceHodge

section ClosedSubgroup

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- **A closed subgroup that is not locally a subspace contains a line.** If a closed additive
subgroup `G` of a finite-dimensional real normed space contains the subspace `V`, and `G` has
points outside `V` arbitrarily close to `0`, then `G` contains a whole line `ℝ u` with
`u ∉ V`. -/
theorem exists_forall_smul_mem_of_forall_exists_norm_lt {G : AddSubgroup E}
    (hG : IsClosed (G : Set E)) {V : Submodule ℝ E} (hV : (V : Set E) ⊆ G)
    (h : ∀ ε > 0, ∃ x ∈ G, ‖x‖ < ε ∧ x ∉ V) :
    ∃ u ∉ V, ∀ t : ℝ, t • u ∈ G := by
  obtain ⟨K, hK⟩ := V.exists_isCompl
  have hKV : IsCompl K V := hK.symm
  set π := K.projection V hKV
  have hπc : Continuous π := LinearMap.continuous_of_finiteDimensional π
  have hπG : ∀ x ∈ G, π x ∈ G := fun x hx => by
    rw [show π x = x - (x - π x) by abel]
    exact G.sub_mem hx (hV (Submodule.sub_projection_mem hKV x))
  choose x hxG hxn hxV using fun k : ℕ => h (1 / (k + 1)) Nat.one_div_pos_of_nat
  set w : ℕ → E := fun k => π (x k)
  have hw0 : ∀ k, w k ≠ 0 := fun k hk => hxV k ((Submodule.projection_apply_eq_zero_iff hKV).1 hk)
  have hxt : Tendsto x atTop (𝓝 0) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    exact squeeze_zero (fun _ => norm_nonneg _) (fun k => (hxn k).le)
      tendsto_one_div_add_atTop_nhds_zero_nat
  have hwt : Tendsto w atTop (𝓝 0) := (hπc.tendsto' 0 0 (map_zero π)).comp hxt
  have hwn : Tendsto (fun k => ‖w k‖) atTop (𝓝 0) :=
    (continuous_norm.tendsto' 0 0 norm_zero).comp hwt
  set s : ℕ → E := fun k => ‖w k‖⁻¹ • w k
  have hS : IsCompact (sphere (0 : E) 1 ∩ K) :=
    (isCompact_sphere 0 1).inter_right K.closed_of_finiteDimensional
  have hs : ∀ k, s k ∈ sphere (0 : E) 1 ∩ K := fun k => by
    refine ⟨?_, K.smul_mem _ (Submodule.projection_apply_mem hKV _)⟩
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.2 (hw0 k))]
  obtain ⟨u, ⟨hu1, huK⟩, φ, hφ, hsu⟩ := hS.tendsto_subseq hs
  refine ⟨u, fun huV => ?_, fun t => ?_⟩
  · obtain rfl : u = 0 := (Submodule.disjoint_def.1 hKV.disjoint) u huK huV
    simp at hu1
  · set m : ℕ → ℤ := fun k => ⌊t / ‖w (φ k)‖⌋
    have hmG : ∀ k, (m k) • w (φ k) ∈ G := fun k => G.zsmul_mem (hπG _ (hxG _)) _
    have hmeq : ∀ k, (m k) • w (φ k) = ((m k : ℝ) * ‖w (φ k)‖) • s (φ k) := fun k => by
      simp only [s, smul_smul, mul_assoc,
        mul_inv_cancel₀ (norm_ne_zero_iff.2 (hw0 (φ k))), mul_one, Int.cast_smul_eq_zsmul]
    have hwn' : Tendsto (fun k => ‖w (φ k)‖) atTop (𝓝 0) := hwn.comp hφ.tendsto_atTop
    have hmt : Tendsto (fun k => (m k : ℝ) * ‖w (φ k)‖) atTop (𝓝 t) := by
      have hb : ∀ k, |(m k : ℝ) * ‖w (φ k)‖ - t| ≤ ‖w (φ k)‖ := fun k => by
        have hpos : 0 < ‖w (φ k)‖ := norm_pos_iff.2 (hw0 _)
        have h1 := Int.floor_le (t / ‖w (φ k)‖)
        have h2 := Int.lt_floor_add_one (t / ‖w (φ k)‖)
        have e : t / ‖w (φ k)‖ * ‖w (φ k)‖ = t := div_mul_cancel₀ t hpos.ne'
        rw [abs_le]
        constructor <;> nlinarith
      rw [tendsto_iff_norm_sub_tendsto_zero]
      exact squeeze_zero (fun _ => norm_nonneg _) hb hwn'
    have hlim : Tendsto (fun k => (m k) • w (φ k)) atTop (𝓝 (t • u)) := by
      simp_rw [hmeq]
      exact hmt.smul hsu
    exact hG.mem_of_tendsto hlim (Eventually.of_forall hmG)

end ClosedSubgroup

section Algebraic

open CategoryTheory AlgebraicGeometry MMP.Analytic.ComplexPoints TopologicalSpace

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

/-- Evaluation at a point of the presentation of a chart is the `ℂ`-algebra evaluation at the
values of the generators, for the `ℂ`-algebra structure of the residue field coming from `sX`. -/
private lemma evaluation_comp_pres (c : Chart sX) (x : X) (hx : x ∈ c.U) :
    letI : Algebra ℂ (X.residueField x) :=
      ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ sX.appTop ≫ X.Γevaluation x).hom.toAlgebra
    (X.evaluation c.U x hx).hom.comp c.pres =
      (MvPolynomial.aeval (fun j => X.evaluation c.U x hx (c.gen j))).toRingHom := by
  let _ : Algebra ℂ (X.residueField x) :=
    ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ sX.appTop ≫ X.Γevaluation x).hom.toAlgebra
  apply MvPolynomial.ringHom_ext
  · intro a
    simp only [RingHom.comp_apply, Chart.pres, MvPolynomial.eval₂Hom_C, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, MvPolynomial.aeval_C, RingHom.algebraMap_toAlgebra]
    simp only [baseRingHom, RingHom.comp_apply]
    rw [← CommRingCat.comp_apply (X.presheaf.map _), ← Scheme.germ_residue,
      ← Category.assoc, TopCat.Presheaf.germ_res]
    rfl
  · intro j
    simp [Chart.pres]

/-- **Algebraic dependence at a point of a closed set of small dimension.** If `T` is a closed
subset of dimension at most `d` and `x ∈ T` lies in the chart `c`, then any `d + 1` polynomials
`q i` in the coordinates of `c` satisfy a nontrivial relation `Q` at `x`, since
`trdeg κ(x) ≤ d`. -/
theorem exists_ne_zero_notMem_basicOpen [LocallyOfFiniteType sX] (c : Chart sX) {T : Set X}
    (hT : IsClosed T) {d : ℕ} (hTd : topologicalKrullDim T ≤ d)
    (q : Fin (d + 1) → MvPolynomial (Fin c.n) ℂ) {x : X} (hxT : x ∈ T) (hx : x ∈ c.U) :
    ∃ Q : MvPolynomial (Fin (d + 1)) ℂ, Q ≠ 0 ∧
      x ∉ X.basicOpen (c.pres (MvPolynomial.bind₁ q Q)) := by
  let _ : Algebra ℂ (X.residueField x) :=
    ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ sX.appTop ≫ X.Γevaluation x).hom.toAlgebra
  have htr := topologicalKrullDim_closure_singleton_eq_trdeg ℂ X sX x
  have hle : topologicalKrullDim (closure ({x} : Set X)) ≤ topologicalKrullDim T :=
    (Topology.IsEmbedding.inclusion
      (closure_minimal (singleton_subset_iff.2 hxT) hT)).isInducing.topologicalKrullDim_le
  by_contra hcon
  push Not at hcon
  have hev := evaluation_comp_pres c x hx
  have hind : AlgebraicIndependent ℂ (fun i => X.evaluation c.U x hx (c.pres (q i))) := by
    rw [algebraicIndependent_iff]
    intro p hp
    by_contra hp0
    apply (X.evaluation_ne_zero_iff_mem_basicOpen x hx _).2 (hcon p hp0)
    rw [← hp]
    have e1 : ∀ r, X.evaluation c.U x hx (c.pres r) =
        MvPolynomial.aeval (fun j => X.evaluation c.U x hx (c.gen j)) r := fun r =>
      congrArg (fun φ : MvPolynomial (Fin c.n) ℂ →+* X.residueField x => φ r) hev
    rw [e1, MvPolynomial.aeval_bind₁]
    simp only [e1]
  have hcard := OrderHomClass.mono Cardinal.toENat hind.cardinalMk_le_trdeg
  rw [Cardinal.mk_fin, Cardinal.toENat_nat] at hcard
  have h2 := htr ▸ hle.trans hTd
  have h3 : ((d + 1 : ℕ) : WithBot ℕ∞) ≤ (d : WithBot ℕ∞) :=
    (WithBot.coe_le_coe.2 hcard).trans h2
  norm_cast at h3
  omega

/-- **Algebraic dependence on a closed set of small dimension.** Let `T` be a closed subset of
dimension at most `d` of a scheme locally of finite type over `ℂ`, and `c` an affine chart. Any
`d + 1` polynomials `q i` in the coordinates of `c` satisfy, on the points of `T` in the chart, a
nontrivial polynomial relation `Q`. -/
theorem exists_ne_zero_forall_eval_eq_zero [LocallyOfFiniteType sX] (c : Chart sX) {T : Set X}
    (hT : IsClosed T) {d : ℕ} (hTd : topologicalKrullDim T ≤ d)
    (q : Fin (d + 1) → MvPolynomial (Fin c.n) ℂ) :
    ∃ Q : MvPolynomial (Fin (d + 1)) ℂ, Q ≠ 0 ∧ ∀ y : chart (sX := sX) c.U, y.1.toScheme ∈ T →
      MvPolynomial.eval (fun i => MvPolynomial.eval (c.coords y) (q i)) Q = 0 := by
  classical
  have : IsNoetherianRing Γ(X, c.U) := isNoetherianRing_of_surjective _ _ _ c.surjective
  have : NoetherianSpace c.U := noetherianSpace_of_isAffineOpen c.U c.isAffineOpen
  let Z : Set c.U := {z | z.1 ∈ T}
  have hfin : (irreducibleComponents Z).Finite := NoetherianSpace.finite_irreducibleComponents
  have hcomp : ∀ K : irreducibleComponents Z, ∃ Q : MvPolynomial (Fin (d + 1)) ℂ, Q ≠ 0 ∧
      ∀ z ∈ (K : Set Z), z.1.1 ∉ X.basicOpen (c.pres (MvPolynomial.bind₁ q Q)) := by
    intro ⟨K, hK⟩
    have hcont : Continuous fun z : Z => z.1.1 :=
      continuous_subtype_val.comp continuous_subtype_val
    have hS : IsIrreducible ((fun z : Z => z.1.1) '' K) :=
      hK.1.image _ hcont.continuousOn
    have hgen := hS.isGenericPoint_genericPoint_closure
    have hST : (fun z : Z => z.1.1) '' K ⊆ T := image_subset_iff.2 fun z _ => z.2
    obtain ⟨z₀, hz₀⟩ := hK.1.nonempty
    have hxT : hS.genericPoint ∈ T := closure_minimal hST hT hgen.mem
    have hxU : hS.genericPoint ∈ c.U :=
      (hgen.mem_open_set_iff c.U.2).2 ⟨_, subset_closure ⟨z₀, hz₀, rfl⟩, z₀.1.2⟩
    obtain ⟨Q, hQ, hQx⟩ := exists_ne_zero_notMem_basicOpen c hT hTd q hxT hxU
    exact ⟨Q, hQ, fun z hz hzb => hQx ((hgen.specializes (subset_closure ⟨z, hz, rfl⟩)).mem_open
      (X.basicOpen _).2 hzb)⟩
  choose Qf hQf0 hQf using hcomp
  have : Fintype (irreducibleComponents Z) := hfin.fintype
  refine ⟨∏ K, Qf K, Finset.prod_ne_zero_iff.2 fun K _ => hQf0 K, fun y hyT => ?_⟩
  let z : Z := ⟨⟨y.1.toScheme, mem_chart_iff.1 y.2⟩, hyT⟩
  let K : irreducibleComponents Z :=
    ⟨irreducibleComponent z, irreducibleComponent_mem_irreducibleComponents z⟩
  have hK := hQf K z mem_irreducibleComponent
  rw [toScheme_mem_basicOpen_iff y, not_not] at hK
  have e : MvPolynomial.eval (fun i => MvPolynomial.eval (c.coords y) (q i)) (∏ K, Qf K) =
      MvPolynomial.eval (c.coords y) (MvPolynomial.bind₁ q (∏ K, Qf K)) :=
    (MvPolynomial.eval₂Hom_bind₁ (RingHom.id ℂ) (c.coords y) q _).symm
  rw [e, ← Chart.evalHom_pres, map_prod, map_prod, map_prod]
  exact Finset.prod_eq_zero (Finset.mem_univ K) hK

end Algebraic

section Uniformisation

open CategoryTheory AlgebraicGeometry MMP.Analytic.ComplexPoints MMP.Analytic.Analytification
open TopologicalSpace

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
  {Φ : (Fin n → ℂ) → ComplexPoints sX}

/-- **Coordinates of a local biholomorphism.** Let `Φ : ℂⁿ → X(ℂ)` be continuous, holomorphic in
charts, and biholomorphic near `0` onto an open set (with a left inverse holomorphic in charts).
Then in an affine chart `c` around `Φ 0` the coordinates `F` of `Φ` are analytic on an open
neighbourhood `O` of `0`, and their derivative at `0` is injective. -/
theorem exists_chart_analyticAt_injective_fderiv [LocallyOfFiniteType sX] (hΦ : Continuous Φ)
    (hhol : ∀ (v : Fin n → ℂ) (c : Chart sX) (_ : Φ v ∈ chart c.U),
      ∃ F : (Fin n → ℂ) → (Fin c.n → ℂ), DifferentiableAt ℂ F v ∧
        ∀ᶠ v' in 𝓝 v, ∃ h' : Φ v' ∈ chart c.U, c.coords ⟨Φ v', h'⟩ = F v')
    (hloc : ∃ U : Set (Fin n → ℂ), IsOpen U ∧ 0 ∈ U ∧
      ∃ W : Opens (space sX), Set.BijOn Φ U W ∧
        ∃ Ψ : space sX → (Fin n → ℂ), Set.LeftInvOn Ψ Φ U ∧
          ∀ (y : space sX) (_ : y ∈ W) (c : Chart sX)
            (hy : y ∈ ComplexPoints.chart c.U),
            ∃ G : (Fin c.n → ℂ) → (Fin n → ℂ), DifferentiableAt ℂ G (c.coords ⟨y, hy⟩) ∧
              ∀ᶠ y' in 𝓝 y, ∀ hy' : y' ∈ ComplexPoints.chart c.U, y' ∈ W →
                Ψ y' = G (c.coords ⟨y', hy'⟩)) :
    ∃ (c : Chart sX) (F : (Fin n → ℂ) → (Fin c.n → ℂ)) (O : Set (Fin n → ℂ)),
      IsOpen O ∧ (0 : Fin n → ℂ) ∈ O ∧
      (∀ v ∈ O, ∃ h : Φ v ∈ chart c.U, F v = c.coords ⟨Φ v, h⟩) ∧
      (∀ v ∈ O, AnalyticAt ℂ F v) ∧ Function.Injective (fderiv ℂ F 0) := by
  classical
  obtain ⟨U, hUo, hU0, W, hbij, Ψ, hinv, hG⟩ := hloc
  obtain ⟨U', hU', hmem, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := (Φ 0).toScheme) (U := ⊤) trivial
  obtain ⟨c, rfl⟩ := Chart.exists_eq (sX := sX) hU'
  have hch : chart (sX := sX) c.U = toScheme ⁻¹' (c.U : Set X) := Set.ext fun _ => mem_chart_iff
  set O : Set (Fin n → ℂ) := Φ ⁻¹' chart c.U
  have hO : IsOpen O := by
    simp only [O, hch]
    exact (c.U.2.preimage continuous_toScheme).preimage hΦ
  have h0 : Φ 0 ∈ chart c.U := mem_chart_iff.2 hmem
  set F : (Fin n → ℂ) → (Fin c.n → ℂ) := fun v =>
    if h : Φ v ∈ chart c.U then c.coords ⟨Φ v, h⟩ else 0
  have hFO : ∀ v ∈ O, ∃ h : Φ v ∈ chart c.U, F v = c.coords ⟨Φ v, h⟩ := fun v hv =>
    ⟨hv, dif_pos hv⟩
  have hFd : ∀ v ∈ O, DifferentiableAt ℂ F v := by
    intro v hv
    obtain ⟨F', hF', hev⟩ := hhol v c hv
    refine hF'.congr_of_eventuallyEq ?_
    filter_upwards [hev] with v' ⟨h', e⟩
    simp only [F, h', ↓reduceDIte, e]
  have hFa : ∀ v ∈ O, AnalyticAt ℂ F v := by
    intro v hv
    refine analyticAt_pi_iff.2 fun j => ?_
    refine OkaCoherence.analyticOnNhd_of_differentiableOn' hO (fun w hw => ?_) v hv
    exact ((differentiableAt_apply j (F w)).comp w (hFd w hw)).differentiableWithinAt
  refine ⟨c, F, O, hO, h0, hFO, hFa, ?_⟩
  obtain ⟨G, hGd, hGev⟩ := hG (Φ 0) (hbij.mapsTo hU0) c h0
  have hF0 : F 0 = c.coords ⟨Φ 0, h0⟩ := dif_pos h0
  have hGF : G ∘ F =ᶠ[𝓝 0] id := by
    filter_upwards [hUo.mem_nhds hU0, hO.mem_nhds h0, hΦ.continuousAt.eventually hGev]
      with v hvU hvO hv
    obtain ⟨h', e⟩ := hFO v hvO
    have := hv h' (hbij.mapsTo hvU)
    simp only [Function.comp_apply, id_eq, e, ← this]
    exact hinv hvU
  have hd : HasFDerivAt (G ∘ F) ((fderiv ℂ G (F 0)).comp (fderiv ℂ F 0)) 0 :=
    (hF0 ▸ hGd).hasFDerivAt.comp 0 (hFd 0 h0).hasFDerivAt
  have hid : (fderiv ℂ G (F 0)).comp (fderiv ℂ F 0) = ContinuousLinearMap.id ℂ _ :=
    hd.unique ((hasFDerivAt_id (0 : Fin n → ℂ)).congr_of_eventuallyEq hGF)
  exact Function.LeftInverse.injective (g := fderiv ℂ G (F 0)) fun a =>
    DFunLike.congr_fun hid a

/-- If `u ∉ V`, the map `(v, z) ↦ v + z • u` from `V × K` is injective. -/
theorem injective_add_smul_of_notMem {K E : Type*} [DivisionRing K] [AddCommGroup E] [Module K E]
    {V : Submodule K E} {u : E} (hu : u ∉ V) :
    Function.Injective fun p : V × K => (p.1 : E) + p.2 • u := by
  rintro ⟨v, z⟩ ⟨v', z'⟩ h
  simp only at h
  obtain rfl : z = z' := by
    by_contra hne
    apply hu
    have hm : (z - z') • u ∈ V := by
      rw [show (z - z') • u = (v' : E) - v by
        rw [sub_smul, sub_eq_sub_iff_add_eq_add, add_comm, h]]
      exact V.sub_mem v'.2 v.2
    simpa [inv_smul_smul₀ (sub_ne_zero.2 hne)] using V.smul_mem (z - z')⁻¹ hm
  exact Prod.ext (Subtype.ext (add_right_cancel h)) rfl

/-- The components of a linear map `ℂᵐ → ℂᵏ` are linear polynomials in the coordinates. -/
theorem exists_mvPolynomial_eval_eq {m k : ℕ} (L : (Fin m → ℂ) →L[ℂ] (Fin k → ℂ)) :
    ∃ q : Fin k → MvPolynomial (Fin m) ℂ, ∀ z i, MvPolynomial.eval z (q i) = L z i := by
  refine ⟨fun i => ∑ j, MvPolynomial.C (L (fun l => if j = l then 1 else 0) i) * MvPolynomial.X j,
    fun z i => ?_⟩
  conv_rhs => rw [pi_eq_sum_univ z]
  simp [map_sum, mul_comm]

/-- **Identity theorem on a product ball.** A function on `F × ℂ` analytic on `ball 0 r` and
vanishing at the points of the ball with real second coordinate vanishes on the ball. -/
theorem eq_zero_of_mem_ball_of_forall_ofReal {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℂ F] {f : F × ℂ → ℂ} {r : ℝ} (hr : 0 < r)
    (hf : ∀ p ∈ ball (0 : F × ℂ) r, AnalyticAt ℂ f p)
    (h : ∀ (v : F) (t : ℝ), ((v, (t : ℂ)) : F × ℂ) ∈ ball 0 r → f (v, t) = 0) :
    ∀ p ∈ ball (0 : F × ℂ) r, f p = 0 := by
  rintro ⟨v, z⟩ hp
  have hball : ball (0 : F × ℂ) r = ball (0 : F) r ×ˢ ball (0 : ℂ) r := (ball_prod_same _ _ _).symm
  rw [hball, mem_prod] at hp
  have hmem : ∀ z' ∈ ball (0 : ℂ) r, ((v, z') : F × ℂ) ∈ ball (0 : F × ℂ) r :=
    fun z' hz' => hball ▸ ⟨hp.1, hz'⟩
  have hκ : AnalyticOnNhd ℂ (fun z' : ℂ => f (v, z')) (ball 0 r) :=
    fun z' hz' => (hf _ (hmem z' hz')).comp (analyticAt_const.prod analyticAt_id)
  have ht : Tendsto (fun m : ℕ => ((1 / ((m : ℝ) + 1) : ℝ) : ℂ)) atTop (𝓝[≠] 0) := by
    refine tendsto_nhdsWithin_iff.2 ⟨?_, Eventually.of_forall fun m => ?_⟩
    · exact (Complex.continuous_ofReal.tendsto' 0 0 Complex.ofReal_zero).comp
        tendsto_one_div_add_atTop_nhds_zero_nat
    · simp only [mem_compl_iff, mem_singleton_iff, Complex.ofReal_eq_zero]
      positivity
  have hfreq : ∃ᶠ z' in 𝓝[≠] (0 : ℂ), f (v, z') = 0 := by
    refine ht.frequently (Eventually.frequently ?_)
    filter_upwards [(tendsto_nhdsWithin_iff.1 ht).1.eventually (ball_mem_nhds 0 hr)] with m hm
    exact h v _ (hmem _ hm)
  exact hκ.eqOn_zero_of_preconnected_of_frequently_eq_zero (convex_ball 0 r).isPreconnected
    (mem_ball_self hr) hfreq hp.2

/-- A complex multivariate polynomial whose evaluation vanishes near a point is zero. -/
theorem eq_zero_of_eval_eventuallyEq_zero {m : ℕ} {Q : MvPolynomial (Fin m) ℂ} {a : Fin m → ℂ}
    (h : (fun z : Fin m → ℂ => MvPolynomial.eval z Q) =ᶠ[𝓝 a] 0) : Q = 0 := by
  have hall := (AnalyticOnNhd.eval_mvPolynomial Q).eqOn_zero_of_preconnected_of_eventuallyEq_zero
    isPreconnected_univ (mem_univ a) h
  exact MvPolynomial.funext fun z => by simpa using hall (mem_univ z)

/-- **`Φ(V + ℝ u)` with `u ∉ V` is not contained in a closed set of dimension `≤ dim V`.**
Let `Φ : ℂⁿ → X(ℂ)` be as in
`exists_chart_analyticAt_injective_fderiv`, `V ⊆ ℂⁿ` a complex subspace and `u ∉ V`. If `Φ` maps
the real subspace `V + ℝ u` into a closed subset `T` of `X`, then `dim T > dim V`. -/
theorem not_topologicalKrullDim_le_of_forall_add_smul_mem [LocallyOfFiniteType sX]
    (hΦ : Continuous Φ)
    (hhol : ∀ (v : Fin n → ℂ) (c : Chart sX) (_ : Φ v ∈ chart c.U),
      ∃ F : (Fin n → ℂ) → (Fin c.n → ℂ), DifferentiableAt ℂ F v ∧
        ∀ᶠ v' in 𝓝 v, ∃ h' : Φ v' ∈ chart c.U, c.coords ⟨Φ v', h'⟩ = F v')
    (hloc : ∃ U : Set (Fin n → ℂ), IsOpen U ∧ 0 ∈ U ∧
      ∃ W : Opens (space sX), Set.BijOn Φ U W ∧
        ∃ Ψ : space sX → (Fin n → ℂ), Set.LeftInvOn Ψ Φ U ∧
          ∀ (y : space sX) (_ : y ∈ W) (c : Chart sX)
            (hy : y ∈ ComplexPoints.chart c.U),
            ∃ G : (Fin c.n → ℂ) → (Fin n → ℂ), DifferentiableAt ℂ G (c.coords ⟨y, hy⟩) ∧
              ∀ᶠ y' in 𝓝 y, ∀ hy' : y' ∈ ComplexPoints.chart c.U, y' ∈ W →
                Ψ y' = G (c.coords ⟨y', hy'⟩)) {T : Set X} (hT : IsClosed T)
    (V : Submodule ℂ (Fin n → ℂ)) {u : Fin n → ℂ} (hu : u ∉ V)
    (hVu : ∀ v ∈ V, ∀ t : ℝ, (Φ (v + (t : ℂ) • u)).toScheme ∈ T) :
    ¬ topologicalKrullDim T ≤ Module.finrank ℂ V := by
  classical
  intro hTd
  obtain ⟨c, F, O, hO, h0O, hFO, hFa, hinj⟩ :=
    exists_chart_analyticAt_injective_fderiv hΦ hhol hloc
  let ι : (V × ℂ) →L[ℂ] (Fin n → ℂ) :=
    V.subtypeL.coprod ((ContinuousLinearMap.id ℂ ℂ).smulRight u)
  have hι : ∀ p : V × ℂ, ι p = (p.1 : Fin n → ℂ) + p.2 • u := fun p => by simp [ι]
  have hιinj : Function.Injective ι := fun p p' hpp =>
    injective_add_smul_of_notMem hu (by rwa [hι, hι] at hpp)
  set D := (fderiv ℂ F 0).comp ι
  let e : (V × ℂ) ≃ₗ[ℂ] (Fin (Module.finrank ℂ V + 1) → ℂ) :=
    LinearEquiv.ofFinrankEq _ _ (by simp [Module.finrank_prod])
  obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective
    (D : (V × ℂ) →ₗ[ℂ] (Fin c.n → ℂ)) (LinearMap.ker_eq_bot.2 (hinj.comp hιinj))
  let L : (Fin c.n → ℂ) →L[ℂ] (Fin (Module.finrank ℂ V + 1) → ℂ) :=
    LinearMap.toContinuousLinearMap (e.toLinearMap ∘ₗ g)
  have hLD : ∀ p, L (D p) = e p := fun p => by
    simp only [L, LinearMap.coe_toContinuousLinearMap', LinearMap.coe_comp, Function.comp_apply,
      LinearEquiv.coe_coe]
    rw [show g (D p) = p from LinearMap.congr_fun hg p]
  set h : (V × ℂ) → (Fin (Module.finrank ℂ V + 1) → ℂ) := fun p => L (F (ι p))
  have hh : HasStrictFDerivAt h
      (e.toContinuousLinearEquiv : (V × ℂ) →L[ℂ] (Fin (Module.finrank ℂ V + 1) → ℂ)) 0 := by
    have h1 : HasStrictFDerivAt F (fderiv ℂ F 0) (ι 0) := by
      rw [map_zero]
      exact (hFa 0 h0O).hasStrictFDerivAt
    exact (L.hasStrictFDerivAt.comp (0 : V × ℂ) (h1.comp (0 : V × ℂ)
      ι.hasStrictFDerivAt)).congr_fderiv (ContinuousLinearMap.ext hLD)
  obtain ⟨q, hq⟩ := exists_mvPolynomial_eval_eq L
  obtain ⟨Q, hQ0, hQ⟩ := exists_ne_zero_forall_eval_eq_zero c hT hTd q
  have hvan : ∀ p : V × ℂ, ι p ∈ O → (Φ (ι p)).toScheme ∈ T →
      MvPolynomial.eval (h p) Q = 0 := by
    intro p hp hpT
    obtain ⟨hc, e'⟩ := hFO _ hp
    rw [show h p = L (c.coords ⟨Φ (ι p), hc⟩) by simp only [h, e']]
    simpa only [hq] using hQ ⟨Φ (ι p), hc⟩ hpT
  obtain ⟨r, hr, hrO⟩ := Metric.isOpen_iff.1 (hO.preimage ι.continuous) 0 (by simpa using h0O)
  have hka : ∀ p ∈ ball (0 : V × ℂ) r, AnalyticAt ℂ (fun p => MvPolynomial.eval (h p) Q) p :=
    fun p hp => (AnalyticOnNhd.eval_mvPolynomial Q _ (mem_univ _)).comp ((L.analyticAt _).comp
      ((hFa _ (hrO hp)).comp (ι.analyticAt p)))
  have hk0 := eq_zero_of_mem_ball_of_forall_ofReal hr hka fun v t hp =>
    hvan (v, (t : ℂ)) (hrO hp) (by rw [hι]; exact hVu v v.2 t)
  refine hQ0 (eq_zero_of_eval_eventuallyEq_zero (a := h 0) ?_)
  filter_upwards [hh.map_nhds_eq_of_equiv ▸ image_mem_map (ball_mem_nhds 0 hr)]
    with z ⟨p, hp, hpz⟩
  rw [← hpz]
  exact hk0 p hp

/-- The uniformisation is `Λ`-periodic: if `cls ∘ Φ` is a homomorphism with kernel `Λ` and `cls`
is injective, then `Φ (x + μ) = Φ x` for `μ ∈ Λ`. -/
theorem map_add_eq_of_mem {P : Type*} [MulOneClass P] {cls : ComplexPoints sX → P}
    (hinj : Function.Injective cls)
    (hadd : ∀ v v', cls (Φ (v + v')) = cls (Φ v) * cls (Φ v'))
    {Λ : Submodule ℤ (Fin n → ℂ)} (hker : ∀ v, cls (Φ v) = 1 ↔ v ∈ Λ) (x : Fin n → ℂ)
    {μ : Fin n → ℂ} (hμ : μ ∈ Λ) : Φ (x + μ) = Φ x :=
  hinj (by rw [hadd, (hker μ).2 hμ, mul_one])

/-- **The subgroup generated by `V` and the period lattice is locally `V`.** Let
`Φ : ℂⁿ → X(ℂ)` be a `Λ`-periodic map, continuous, holomorphic in charts and biholomorphic near
`0` (the uniformisation of a complex torus `X(ℂ)`). If `Φ` maps the complex subspace `V` into a
closed subset `T` of `X` with `dim T ≤ dim V`, then there is an additive subgroup containing `V`
and `Λ` that coincides with `V` near `0`. -/
theorem exists_addSubgroup_of_subset_isClosed_of_periodic [LocallyOfFiniteType sX]
    (Λ : Submodule ℤ (Fin n → ℂ)) (hΦ : Continuous Φ)
    (hhol : ∀ (v : Fin n → ℂ) (c : Chart sX) (_ : Φ v ∈ chart c.U),
      ∃ F : (Fin n → ℂ) → (Fin c.n → ℂ), DifferentiableAt ℂ F v ∧
        ∀ᶠ v' in 𝓝 v, ∃ h' : Φ v' ∈ chart c.U, c.coords ⟨Φ v', h'⟩ = F v')
    (hloc : ∃ U : Set (Fin n → ℂ), IsOpen U ∧ 0 ∈ U ∧
      ∃ W : Opens (space sX), Set.BijOn Φ U W ∧
        ∃ Ψ : space sX → (Fin n → ℂ), Set.LeftInvOn Ψ Φ U ∧
          ∀ (y : space sX) (_ : y ∈ W) (c : Chart sX)
            (hy : y ∈ ComplexPoints.chart c.U),
            ∃ G : (Fin c.n → ℂ) → (Fin n → ℂ), DifferentiableAt ℂ G (c.coords ⟨y, hy⟩) ∧
              ∀ᶠ y' in 𝓝 y, ∀ hy' : y' ∈ ComplexPoints.chart c.U, y' ∈ W →
                Ψ y' = G (c.coords ⟨y', hy'⟩))
    (hper : ∀ x, ∀ μ ∈ Λ, Φ (x + μ) = Φ x) (V : Submodule ℂ (Fin n → ℂ)) {T : Set X}
    (hT : IsClosed T) (hTd : topologicalKrullDim T ≤ Module.finrank ℂ V)
    (hVT : ∀ v ∈ V, (Φ v).toScheme ∈ T) :
    ∃ G : AddSubgroup (Fin n → ℂ), (V : Set (Fin n → ℂ)) ⊆ G ∧
      (Λ : Set (Fin n → ℂ)) ⊆ G ∧ ∃ ε > 0, ∀ x ∈ G, ‖x‖ < ε → x ∈ V := by
  set H : AddSubgroup (Fin n → ℂ) := V.toAddSubgroup ⊔ Λ.toAddSubgroup
  set G := H.topologicalClosure
  have hVG : (V : Set (Fin n → ℂ)) ⊆ G := fun v hv =>
    H.le_topologicalClosure (AddSubgroup.mem_sup_left (show v ∈ V.toAddSubgroup from hv))
  refine ⟨G, hVG, fun μ hμ =>
    H.le_topologicalClosure (AddSubgroup.mem_sup_right (show μ ∈ Λ.toAddSubgroup from hμ)), ?_⟩
  have hP : IsClosed {x | (Φ x).toScheme ∈ T} := hT.preimage (continuous_toScheme.comp hΦ)
  have hHP : (H : Set (Fin n → ℂ)) ⊆ {x | (Φ x).toScheme ∈ T} := by
    intro x hx
    obtain ⟨v, hv, μ, hμ, rfl⟩ := AddSubgroup.mem_sup.1 hx
    simpa only [mem_setOf_eq, hper v μ hμ] using hVT v hv
  have hGP : (G : Set (Fin n → ℂ)) ⊆ {x | (Φ x).toScheme ∈ T} := by
    rw [H.topologicalClosure_coe]
    exact closure_minimal hHP hP
  by_contra hne
  push Not at hne
  obtain ⟨u, hu, hut⟩ := exists_forall_smul_mem_of_forall_exists_norm_lt
    (V := V.restrictScalars ℝ) H.isClosed_topologicalClosure hVG
    (fun ε hε => by simpa using hne ε hε)
  refine not_topologicalKrullDim_le_of_forall_add_smul_mem hΦ hhol hloc hT V hu
    (fun v hv t => hGP (G.add_mem (hVG hv) ?_)) hTd
  rw [Complex.coe_smul]
  exact hut t

end Uniformisation

