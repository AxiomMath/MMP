/-!
# The analytification of a scheme over `ℂ`

Let `X` be a scheme over `ℂ` and `X(ℂ)` its complex realization
(`MMP.Analytic.ComplexPoints`). A function on an open subset of `ℂⁿ` is holomorphic if it is
complex differentiable, and `𝒪_{ℂⁿ}` is the sheaf of holomorphic functions. On an affine chart
`U = Spec ℂ[z₁, …, zₙ]/I` with complex zero set `Z ⊆ ℂⁿ` the analytic structure sheaf is
`(𝒪_{ℂⁿ}/I 𝒪_{ℂⁿ})|_Z`; these sheaves are glued along the polynomial coordinate changes between
charts, giving the ringed space `X^an`, the *analytification* of `X`.

The map `α_X : X^an → X` sends a complex point to the corresponding closed point, and
`α_X^# : α_X⁻¹ 𝒪_X → 𝒪_{X^an}` sends the class of `p/a^m` on `D(a)` to the class of the
holomorphic function `p/a^m` on `{a ≠ 0}`. For an `𝒪_X`-module `F`,
`F^an = α_X⁻¹ F ⊗_{α_X⁻¹ 𝒪_X} 𝒪_{X^an}`, with `ι_F : α_X⁻¹ F → F^an`, `s ↦ s ⊗ 1`, and the
comparison maps are `c^q_F : H^q(X, F) → H^q(X^an, α_X⁻¹ F) → H^q(X^an, F^an)`, the Godement
pullback along `α_X` followed by `(ι_F)_*`.

A sheaf of modules `S` over a sheaf of rings `A` is *coherent* if it is locally generated by
finitely many sections and the kernel of every `A_V^p → S|_V` given by finitely many sections is
locally generated by finitely many sections; `A` is coherent if it is coherent over itself.

## Main definitions

* `MMP.Analytic.holGerms`: holomorphic germs at a point.
* `MMP.Analytic.Chart`, `MMP.Analytic.ChartHom`: affine charts with a presentation, and
  polynomial coordinate changes between them.
* `MMP.Analytic.Chart.StalkRing`: the local ring `𝒪_{ℂⁿ,p}/I 𝒪_{ℂⁿ,p}` of a chart.
* `MMP.Analytic.Analytification.structureSheaf`: the structure sheaf `𝒪_{X^an}`.
* `MMP.Analytic.analytification`: the ringed space `X^an`.
* `MMP.Analytic.analytificationHom`: the morphism of ringed spaces `α_X : X^an → X`.
* `MMP.Analytic.analytificationSharp`: `α_X^# : α_X⁻¹ 𝒪_X → 𝒪_{X^an}`.
* `MMP.Analytic.analytifyModule`: `F ↦ F^an`.
* `MMP.Analytic.analytifyModuleι`: `ι_F : α_X⁻¹ F → F^an`.
* `MMP.Analytic.comparisonMap`: `c^q_F`.
* `MMP.Analytic.IsCoherentModule`, `MMP.Analytic.IsCoherentRing`: coherence.

## Main results

* `MMP.Analytic.ComplexPoints.continuous_toScheme`: `α_X` is continuous.
* `MMP.Analytic.ComplexPoints.toScheme_mem_basicOpen_iff`: `α_X(y) ∈ D(a)` iff `a(y) ≠ 0`.
* `MMP.Analytic.Analytification.isLocallyHolomorphic_sharpFun`: the family underlying `α_X^#`
  of a section is locally holomorphic.

## Implementation notes

* **The glued sheaf.** A section of `𝒪_{X^an}` over an open `W ⊆ X(ℂ)` is a family, indexed by
  the points `x ∈ W` and the charts `c` containing `x`, of elements of the local rings
  `𝒪_{ℂⁿ,z_c(x)}/I_c 𝒪_{ℂⁿ,z_c(x)}`, such that (i) for every chart `c`, near every point the
  `c`-components are the classes of the germs of one holomorphic function of the coordinates of
  `c`, and (ii) the components are carried into each other by the transition maps of all
  polynomial coordinate changes `ChartHom c d` (composition of germs with the polynomial map
  `ℂ^{n_d} → ℂ^{n_c}`). Condition (i) says that the `c`-component is a section of
  `(𝒪_{ℂⁿ}/I_c 𝒪_{ℂⁿ})|_{Z_c}`, as the sections of an inverse image along `Z_c ⊆ ℂⁿ` are the
  families of stalk elements locally given by sections on opens of `ℂⁿ`, and the sections of
  the quotient sheaf are locally classes of holomorphic functions. Condition (ii) is the
  gluing: the sheaf obtained is the limit of the chart sheaves along the coordinate changes,
  which is the glued sheaf once the coordinate changes are isomorphisms on overlaps. No
  radicality is assumed, so nilpotents of `𝒪_X` are kept.
* The topology on the `ℂ`-points of a chart is `MMP.Analytic.ComplexPoints.chartTopology`, the
  coarsest one making all evaluations continuous; it agrees with the subspace topology of the
  zero set in `ℂⁿ` for any finite set of generators.
* `α_X^#` is constructed in the adjoint form `𝒪_X → (α_X)_* 𝒪_{X^an}`, through the local rings:
  `𝒪_{X,α(y)} = Γ(U, 𝒪_X)_{𝔪_y} → 𝒪_{ℂⁿ,z(y)}/I` sends `p/a` to the class of the germ `p/a`;
  `MMP.Analytic.analytificationSharp` is its adjoint on the inverse image sheaf.
* `F^an` is the pullback of sheaves of modules along `α_X` (the left adjoint of the
  pushforward), which is `α_X⁻¹ F ⊗_{α_X⁻¹ 𝒪_X} 𝒪_{X^an}`; `ι_F` is the adjoint of the unit
  `F → (α_X)_* F^an` on underlying abelian sheaves.
* No finiteness hypothesis is imposed on `X`; for `X` of finite type over `ℂ` the charts cover
  `X(ℂ)`.

## References

* [Serre, *Géométrie algébrique et géométrie analytique*]
* [SGA 1, Exposé XII]
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Topology TopologicalSpace Filter Opposite

namespace MMP.Analytic

/-! ### Holomorphic germs -/

section Germs

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- The germs at `p` of functions that are complex differentiable near `p`. -/
def holGerms (p : E) : Subring (Germ (𝓝 p) ℂ) where
  carrier := {g | ∃ f : E → ℂ, (f : Germ (𝓝 p) ℂ) = g ∧ ∀ᶠ y in 𝓝 p, DifferentiableAt ℂ f y}
  mul_mem' := by
    rintro _ _ ⟨f, rfl, hf⟩ ⟨g, rfl, hg⟩
    exact ⟨f * g, rfl, (hf.and hg).mono fun y h => h.1.mul h.2⟩
  one_mem' := ⟨1, rfl, Eventually.of_forall fun _ => differentiableAt_const _⟩
  add_mem' := by
    rintro _ _ ⟨f, rfl, hf⟩ ⟨g, rfl, hg⟩
    exact ⟨f + g, rfl, (hf.and hg).mono fun y h => h.1.add h.2⟩
  zero_mem' := ⟨0, rfl, Eventually.of_forall fun _ => differentiableAt_const _⟩
  neg_mem' := by
    rintro _ ⟨f, rfl, hf⟩
    exact ⟨-f, rfl, hf.mono fun y h => h.neg⟩

/-- A germ is holomorphic iff it is the germ of a function complex differentiable near `p`. -/
theorem mem_holGerms_iff {p : E} {g : Germ (𝓝 p) ℂ} :
    g ∈ holGerms p ↔ ∃ f : E → ℂ, (f : Germ (𝓝 p) ℂ) = g ∧ ∀ᶠ y in 𝓝 p, DifferentiableAt ℂ f y :=
  Iff.rfl

/-- The germ of a function complex differentiable near `p` is a holomorphic germ. -/
lemma coe_mem_holGerms {p : E} {f : E → ℂ} (hf : ∀ᶠ y in 𝓝 p, DifferentiableAt ℂ f y) :
    (f : Germ (𝓝 p) ℂ) ∈ holGerms p :=
  ⟨f, rfl, hf⟩

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F]

/-- Composition of germs with a map `G` tending to `p` along `𝓝 q`, as a ring homomorphism. -/
def germPullback {p : E} {q : F} (G : F → E) (hG : Tendsto G (𝓝 q) (𝓝 p)) :
    Germ (𝓝 p) ℂ →+* Germ (𝓝 q) ℂ where
  toFun g := g.compTendsto G hG
  map_one' := rfl
  map_mul' a b := Germ.inductionOn₂ a b fun _ _ => rfl
  map_zero' := rfl
  map_add' a b := Germ.inductionOn₂ a b fun _ _ => rfl

/-- Composition of holomorphic germs with a holomorphic map. -/
def holPullback {p : E} {q : F} (G : F → E) (hGd : Differentiable ℂ G)
    (hG : Tendsto G (𝓝 q) (𝓝 p)) : holGerms p →+* holGerms q :=
  (germPullback G hG).restrict _ _ <| by
    rintro _ ⟨f, rfl, hf⟩
    exact ⟨f ∘ G, rfl, (hG.eventually hf).mono fun y hy => hy.comp y (hGd y)⟩

/-- The underlying germ of `holPullback G hGd hG g` is the composition of `g` with `G`. -/
@[simp]
lemma coe_holPullback {p : E} {q : F} (G : F → E) (hGd : Differentiable ℂ G)
    (hG : Tendsto G (𝓝 q) (𝓝 p)) (g : holGerms p) :
    (holPullback G hGd hG g : Germ (𝓝 q) ℂ) = (g : Germ (𝓝 p) ℂ).compTendsto G hG :=
  rfl

end Germs

section Polynomials

variable {n : ℕ}

/-- The polynomial function `y ↦ q(y)` on `ℂⁿ` is complex differentiable. -/
lemma differentiable_eval_mvPolynomial (q : MvPolynomial (Fin n) ℂ) :
    Differentiable ℂ fun y : Fin n → ℂ => MvPolynomial.eval y q := by
  induction q using MvPolynomial.induction_on with
  | C a => simp only [MvPolynomial.eval_C]; fun_prop
  | add a b ha hb => simp only [map_add]; fun_prop
  | mul_X a i ha => simp only [map_mul, MvPolynomial.eval_X]; fun_prop

/-- The germ at `p` of the polynomial function of a polynomial, as a ring homomorphism. -/
def polyGermHom (p : Fin n → ℂ) : MvPolynomial (Fin n) ℂ →+* holGerms p :=
  ((Germ.coeRingHom (𝓝 p)).comp (RingHom.pi MvPolynomial.eval)).codRestrict _
    fun q => coe_mem_holGerms (Eventually.of_forall fun y => differentiable_eval_mvPolynomial q y)

/-- The underlying germ of `polyGermHom p q` is the germ of `y ↦ q(y)`. -/
@[simp]
lemma coe_polyGermHom (p : Fin n → ℂ) (q : MvPolynomial (Fin n) ℂ) :
    (polyGermHom p q : Germ (𝓝 p) ℂ) = ((fun y => MvPolynomial.eval y q : (Fin n → ℂ) → ℂ) :
      Germ (𝓝 p) ℂ) :=
  rfl

/-- The germ of a polynomial not vanishing at `p` is a unit among the holomorphic germs at `p`. -/
lemma isUnit_polyGermHom (p : Fin n → ℂ) (q : MvPolynomial (Fin n) ℂ)
    (hq : MvPolynomial.eval p q ≠ 0) : IsUnit (polyGermHom p q) := by
  set f : (Fin n → ℂ) → ℂ := fun y => MvPolynomial.eval y q
  have hf : ∀ᶠ y in 𝓝 p, f y ≠ 0 :=
    (differentiable_eval_mvPolynomial q).continuous.continuousAt.eventually_ne hq
  refine IsUnit.of_mul_eq_one (b := ⟨(f⁻¹ : (Fin n → ℂ) → ℂ), coe_mem_holGerms (hf.mono fun y hy =>
    ((differentiable_eval_mvPolynomial q) y).inv hy)⟩) (Subtype.ext ?_)
  change ((f * f⁻¹ : (Fin n → ℂ) → ℂ) : Germ (𝓝 p) ℂ) = ((1 : (Fin n → ℂ) → ℂ) : Germ (𝓝 p) ℂ)
  exact Germ.coe_eq.2 (hf.mono fun y hy => by simp [hy])

end Polynomials

/-! ### Points, evaluations and charts -/

namespace ComplexPoints

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

/-- The point of `X` underlying a `ℂ`-point: the image of the unique point of `Spec ℂ`. -/
def toScheme (x : ComplexPoints sX) : X :=
  x.hom (default : Spec (.of ℂ))

/-- A `ℂ`-point lies in the chart of `U` iff its underlying point of `X` lies in `U`. -/
lemma mem_chart_iff {U : X.Opens} {x : ComplexPoints sX} : x ∈ chart U ↔ x.toScheme ∈ U := by
  refine ⟨fun h => (show x.hom ⁻¹ᵁ U = ⊤ from h).ge trivial,
    fun h => eq_top_iff.2 fun p _ => ?_⟩
  rw [Subsingleton.elim p default]
  exact h

/-- The chart of an open `V ⊆ U` is contained in the chart of `U`. -/
lemma chart_mono {U V : X.Opens} (h : V ≤ U) : chart (sX := sX) V ⊆ chart U :=
  fun _ hx => mem_chart_iff.2 (h (mem_chart_iff.1 hx))

/-- Evaluation of sections over `U` at a `ℂ`-point of `U`, as a ring homomorphism. -/
def evalHom (U : X.Opens) (x : chart (sX := sX) U) : Γ(X, U) →+* ℂ :=
  (Scheme.ΓSpecIso (.of ℂ)).hom.hom.comp (x.1.hom.appLE U ⊤ x.2.ge).hom

/-- `evalHom U x f` is the value of the section `f` at the `ℂ`-point `x`. -/
lemma evalHom_apply (U : X.Opens) (x : chart (sX := sX) U) (f : Γ(X, U)) :
    evalHom U x f = eval U f x :=
  rfl

/-- The structure homomorphism `ℂ → Γ(X, U)` of a scheme over `ℂ`. -/
def baseRingHom (sX : X ⟶ Spec (.of ℂ)) (U : X.Opens) : ℂ →+* Γ(X, U) :=
  (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
    (sX.appTop.hom.comp (Scheme.ΓSpecIso (.of ℂ)).inv.hom)

/-- The composite `Γ(Spec ℂ, ⊤) → Γ(X, ⊤) → Γ(X, U) → Γ(Spec ℂ, ⊤)` through a `ℂ`-point of `U` is
the identity. -/
lemma appTop_map_appLE (U : X.Opens) (x : chart (sX := sX) U) :
    sX.appTop ≫ X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ x.1.hom.appLE U ⊤ x.2.ge =
      𝟙 _ := by
  rw [Scheme.Hom.map_appLE]
  have h₁ : sX.appTop ≫ x.1.hom.appLE ⊤ ⊤ (by simp) = (x.1.hom ≫ sX).appLE ⊤ ⊤ (by simp) := by
    rw [Scheme.Hom.comp_appLE]
    rfl
  have key : ∀ (g : Spec (.of ℂ) ⟶ Spec (.of ℂ)) (_ : g = 𝟙 _) (e : ⊤ ≤ g ⁻¹ᵁ ⊤),
      g.appLE ⊤ ⊤ e = 𝟙 _ := by
    rintro _ rfl e; simp [Scheme.Hom.appLE]; rfl
  exact h₁.trans (key _ x.1.hom_comp_structure _)

/-- Evaluating the image of a constant `a ∈ ℂ` at a `ℂ`-point gives `a`. -/
lemma evalHom_baseRingHom (U : X.Opens) (x : chart (sX := sX) U) (a : ℂ) :
    evalHom U x (baseRingHom sX U a) = a := by
  change ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ (sX.appTop ≫ X.presheaf.map (homOfLE le_top).op ≫
    x.1.hom.appLE U ⊤ x.2.ge) ≫ (Scheme.ΓSpecIso (.of ℂ)).hom) a = a
  rw [appTop_map_appLE, Category.id_comp, Iso.inv_hom_id]
  rfl

/-- Evaluation at a `ℂ`-point commutes with restriction of sections. -/
lemma evalHom_res {U V : X.Opens} (h : V ≤ U) (x : chart (sX := sX) V) (f : Γ(X, U)) :
    evalHom U ⟨x.1, chart_mono h x.2⟩ f = evalHom V x (X.presheaf.map (homOfLE h).op f) := by
  simp only [evalHom, RingHom.coe_comp, Function.comp_apply]
  rw [← CommRingCat.comp_apply (X.presheaf.map _), Scheme.Hom.map_appLE]

/-- The structure homomorphism `ℂ → Γ(X, U)` commutes with restriction of sections. -/
lemma baseRingHom_res {U V : X.Opens} (h : V ≤ U) (a : ℂ) :
    X.presheaf.map (homOfLE h).op (baseRingHom sX U a) = baseRingHom sX V a := by
  simp only [baseRingHom, RingHom.coe_comp, Function.comp_apply]
  rw [← CommRingCat.comp_apply _ (X.presheaf.map _), ← Functor.map_comp]
  rfl

end ComplexPoints

open ComplexPoints

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

/-- An affine chart of a scheme `X` over `ℂ`: an affine open `U` together with finitely many
generators `z₁, …, zₙ` of the `ℂ`-algebra `Γ(X, U)`, i.e. a presentation
`Γ(X, U) ≅ ℂ[z₁, …, zₙ]/I`. -/
structure Chart (sX : X ⟶ Spec (.of ℂ)) where
  /-- the affine open -/
  U : X.Opens
  /-- the open `U` is affine -/
  isAffineOpen : IsAffineOpen U
  /-- the number of generators -/
  n : ℕ
  /-- the generators -/
  gen : Fin n → Γ(X, U)
  /-- the generators generate `Γ(X, U)` as a `ℂ`-algebra -/
  surjective : Function.Surjective (MvPolynomial.eval₂Hom (baseRingHom sX U) gen)

namespace Chart

variable (c : Chart sX)

/-- The presentation `ℂ[z₁, …, zₙ] → Γ(X, U)` of a chart. -/
def pres : MvPolynomial (Fin c.n) ℂ →+* Γ(X, c.U) :=
  MvPolynomial.eval₂Hom (baseRingHom sX c.U) c.gen

/-- The presentation of a chart sends a constant to its image in the sections. -/
@[simp] lemma pres_C (a : ℂ) : c.pres (MvPolynomial.C a) = baseRingHom sX c.U a :=
  MvPolynomial.eval₂Hom_C ..

/-- The presentation of a chart sends the `i`-th variable to the `i`-th generator. -/
@[simp] lemma pres_X (i : Fin c.n) : c.pres (MvPolynomial.X i) = c.gen i :=
  MvPolynomial.eval₂Hom_X' ..

/-- The ideal `I ⊆ ℂ[z₁, …, zₙ]` of relations among the generators of a chart. -/
def ideal : Ideal (MvPolynomial (Fin c.n) ℂ) :=
  RingHom.ker c.pres

/-- A polynomial is a relation of the chart iff the section it presents vanishes. -/
lemma mem_ideal_iff {q : MvPolynomial (Fin c.n) ℂ} : q ∈ c.ideal ↔ c.pres q = 0 :=
  RingHom.mem_ker

/-- The coordinates `(z₁(x), …, zₙ(x)) ∈ ℂⁿ` of a `ℂ`-point of the chart. -/
def coords (y : chart (sX := sX) c.U) : Fin c.n → ℂ :=
  fun i => evalHom c.U y (c.gen i)

/-- Evaluating the section presented by a polynomial `q` at `y` is evaluating `q` at the
coordinates of `y`. -/
lemma evalHom_pres (y : chart (sX := sX) c.U) (q : MvPolynomial (Fin c.n) ℂ) :
    evalHom c.U y (c.pres q) = MvPolynomial.eval (c.coords y) q := by
  change ((evalHom c.U y).comp c.pres) q = _
  congr 1
  ext <;> simp [pres, coords, evalHom_baseRingHom]

/-- The local ring of the chart at `p ∈ ℂⁿ`: the holomorphic germs at `p` modulo the ideal
generated by the relations `I` of the chart, i.e. the stalk at `p` of `𝒪_{ℂⁿ}/I 𝒪_{ℂⁿ}`. -/
def StalkRing (p : Fin c.n → ℂ) : Type :=
  holGerms p ⧸ c.ideal.map (polyGermHom p)

/-- The local ring of a chart at `p` is a commutative ring. -/
instance (p : Fin c.n → ℂ) : CommRing (c.StalkRing p) :=
  inferInstanceAs (CommRing (holGerms p ⧸ c.ideal.map (polyGermHom p)))

/-- The class of a holomorphic germ in the local ring of the chart. -/
def StalkRing.mk (p : Fin c.n → ℂ) : holGerms p →+* c.StalkRing p :=
  Ideal.Quotient.mk _

/-- A germ in the ideal generated by the relations of the chart has zero class. -/
lemma StalkRing.mk_eq_zero_of_mem {p : Fin c.n → ℂ} {g : holGerms p}
    (hg : g ∈ c.ideal.map (polyGermHom p)) : StalkRing.mk c p g = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.2 hg

/-- The homomorphism `Γ(X, U) = ℂ[z]/I → 𝒪_{ℂⁿ,p}/I 𝒪_{ℂⁿ,p}` sending a section to the class of
the germ of any polynomial representing it. -/
def toStalkRing (p : Fin c.n → ℂ) : Γ(X, c.U) →+* c.StalkRing p :=
  RingHom.liftOfSurjective c.pres c.surjective
    ⟨(StalkRing.mk c p).comp (polyGermHom p), fun q hq => by
      rw [RingHom.mem_ker, RingHom.comp_apply]
      exact StalkRing.mk_eq_zero_of_mem c (Ideal.mem_map_of_mem _ hq)⟩

/-- The image of the section presented by `q` is the class of the germ of `q`. -/
lemma toStalkRing_pres (p : Fin c.n → ℂ) (q : MvPolynomial (Fin c.n) ℂ) :
    c.toStalkRing p (c.pres q) = StalkRing.mk c p (polyGermHom p q) :=
  RingHom.liftOfRightInverse_comp_apply _ _ _ _ q

end Chart

/-- A morphism of charts `c → d`: an inclusion `U_d ⊆ U_c` of the affine opens together with
the polynomial coordinate change expressing the generators of `c` on `U_d` in terms of the
generators of `d`. -/
structure ChartHom (c d : Chart sX) where
  /-- the inclusion `U_d ⊆ U_c` -/
  le : d.U ≤ c.U
  /-- the coordinate change -/
  P : Fin c.n → MvPolynomial (Fin d.n) ℂ
  /-- the restriction of the `i`-th generator of `c` to `U_d` is presented by `P i` -/
  spec : ∀ i, X.presheaf.map (homOfLE le).op (c.gen i) = d.pres (P i)

namespace ChartHom

variable {c d : Chart sX} (m : ChartHom c d)

/-- The polynomial map `ℂ^{n_d} → ℂ^{n_c}` of a coordinate change. -/
def polyMap (y : Fin d.n → ℂ) : Fin c.n → ℂ :=
  fun i => MvPolynomial.eval y (m.P i)

/-- The polynomial map of a coordinate change is complex differentiable. -/
lemma differentiable_polyMap : Differentiable ℂ m.polyMap :=
  differentiable_pi.2 fun i => differentiable_eval_mvPolynomial (m.P i)

/-- The inclusion of the `ℂ`-points of `U_d` into those of `U_c`. -/
def incl (y : chart (sX := sX) d.U) : chart (sX := sX) c.U :=
  ⟨y.1, chart_mono m.le y.2⟩

/-- The underlying `ℂ`-point of `m.incl y` is that of `y`. -/
@[simp] lemma incl_val (y : chart (sX := sX) d.U) : (m.incl y).1 = y.1 := rfl

/-- Restricting the section presented by `q` from `U_c` to `U_d` gives the section presented by
`q` with the coordinate change substituted. -/
lemma res_pres (q : MvPolynomial (Fin c.n) ℂ) :
    X.presheaf.map (homOfLE m.le).op (c.pres q) = d.pres (MvPolynomial.bind₁ m.P q) := by
  change ((X.presheaf.map (homOfLE m.le).op).hom.comp c.pres) q =
    (d.pres.comp (MvPolynomial.bind₁ m.P).toRingHom) q
  congr 1
  ext a
  · simp [Chart.pres, baseRingHom_res]
  · simpa [Chart.pres] using m.spec a

/-- The coordinates in `c` of a `ℂ`-point of `U_d` are the image of its coordinates in `d`. -/
lemma coords_incl (y : chart (sX := sX) d.U) : c.coords (m.incl y) = m.polyMap (d.coords y) := by
  funext i
  simp only [Chart.coords, incl, polyMap]
  rw [evalHom_res m.le, m.spec i, Chart.evalHom_pres]

/-- The polynomial map of a coordinate change is continuous at the coordinates of a point. -/
lemma tendsto_polyMap (y : chart (sX := sX) d.U) :
    Tendsto m.polyMap (𝓝 (d.coords y)) (𝓝 (c.coords (m.incl y))) := by
  rw [m.coords_incl]
  exact m.differentiable_polyMap.continuous.tendsto _

/-- Evaluating `q` at the image of `y` is evaluating the substituted polynomial at `y`. -/
lemma eval_polyMap (y : Fin d.n → ℂ) (q : MvPolynomial (Fin c.n) ℂ) :
    MvPolynomial.eval (m.polyMap y) q = MvPolynomial.eval y (MvPolynomial.bind₁ m.P q) := by
  simp only [MvPolynomial.eval, MvPolynomial.eval₂Hom_bind₁]
  rfl

/-- Composing the germ of a polynomial `q` with the coordinate change gives the germ of the
substituted polynomial. -/
lemma holPullback_polyGermHom (y : chart (sX := sX) d.U) (q : MvPolynomial (Fin c.n) ℂ) :
    holPullback m.polyMap m.differentiable_polyMap (m.tendsto_polyMap y) (polyGermHom _ q) =
      polyGermHom _ (MvPolynomial.bind₁ m.P q) := by
  apply Subtype.ext
  simp only [coe_holPullback, coe_polyGermHom, Germ.coe_compTendsto]
  congr 1
  funext z
  exact m.eval_polyMap z q

/-- The transition homomorphism `𝒪_{U_c,x} → 𝒪_{U_d,x}` between the local rings of two charts
at a common point, given by composing germs with the coordinate change. -/
def transition (y : chart (sX := sX) d.U) :
    c.StalkRing (c.coords (m.incl y)) →+* d.StalkRing (d.coords y) :=
  Ideal.quotientMap (R := holGerms (c.coords (m.incl y))) (S := holGerms (d.coords y)) _
    (holPullback m.polyMap m.differentiable_polyMap (m.tendsto_polyMap y)) <| by
    rw [Ideal.map_le_iff_le_comap]
    intro q hq
    change holPullback m.polyMap m.differentiable_polyMap (m.tendsto_polyMap y)
      (polyGermHom _ q) ∈ d.ideal.map (polyGermHom (d.coords y))
    rw [m.holPullback_polyGermHom y q]
    apply Ideal.mem_map_of_mem
    rw [Chart.mem_ideal_iff, ← m.res_pres, c.mem_ideal_iff.1 hq, map_zero]

/-- The transition homomorphism sends the class of a germ to the class of its pullback. -/
lemma transition_mk (y : chart (sX := sX) d.U) (g : holGerms (c.coords (m.incl y))) :
    m.transition y (Chart.StalkRing.mk c _ g) = Chart.StalkRing.mk d _
      (holPullback m.polyMap m.differentiable_polyMap (m.tendsto_polyMap y) g) :=
  Ideal.quotientMap_mk ..

/-- The transition homomorphism is compatible with restriction of sections from `U_c` to `U_d`. -/
lemma transition_toStalkRing (y : chart (sX := sX) d.U) (f : Γ(X, c.U)) :
    m.transition y (c.toStalkRing _ f) =
      d.toStalkRing _ (X.presheaf.map (homOfLE m.le).op f) := by
  obtain ⟨q, rfl⟩ := c.surjective f
  change m.transition y (c.toStalkRing _ (c.pres q)) =
    d.toStalkRing _ (X.presheaf.map (homOfLE m.le).op (c.pres q))
  rw [m.res_pres, c.toStalkRing_pres, d.toStalkRing_pres, transition_mk, holPullback_polyGermHom]

end ChartHom

/-! ### The structure sheaf of the analytification -/

namespace Analytification

variable (sX) in
/-- The underlying topological space `X(ℂ)` of the analytification. -/
abbrev space : TopCat.{0} :=
  TopCat.of (ComplexPoints sX)

/-- The fibre at a `ℂ`-point `x` in which sections of `𝒪_{X^an}` take values: one local ring
`𝒪_{ℂⁿ,z(x)}/I 𝒪_{ℂⁿ,z(x)}` for every chart containing `x`. -/
abbrev Fibre (x : space sX) : Type :=
  (c : {c : Chart sX // x ∈ chart c.U}) → c.1.StalkRing (c.1.coords ⟨x, c.2⟩)

/-- The `ℂ`-points of an affine open `U` lying in an open `W ⊆ X(ℂ)` form an open set. -/
lemma isOpen_chart_inter (U : X.affineOpens) (W : Opens (space sX)) :
    IsOpen[chartTopology (U : X.Opens)] {y : chart (sX := sX) (U : X.Opens) | y.1 ∈ W} :=
  @Continuous.isOpen_preimage _ _ (chartTopology (U : X.Opens)) _ _ (continuous_chart_val U) _
    W.isOpen

/-- A family `s` of elements of the fibres over an open `W ⊆ X(ℂ)` is *locally holomorphic* if,
for every chart `c`, near every point of `W` in that chart its `c`-component is the class of a
single holomorphic function of the coordinates of `c`. -/
def IsLocallyHolomorphic {W : Opens (space sX)} (s : ∀ x : W, Fibre x.1) : Prop :=
  ∀ (c : Chart sX) (x : W) (hx : x.1 ∈ chart c.U),
    ∃ O : Set (chart (sX := sX) c.U), IsOpen[chartTopology c.U] O ∧ ⟨x.1, hx⟩ ∈ O ∧
      ∃ h : (Fin c.n → ℂ) → ℂ, ∀ y ∈ O, ∃ hyW : y.1 ∈ W, ∃ g : holGerms (c.coords y),
        (g : Germ (𝓝 (c.coords y)) ℂ) = h ∧ s ⟨y.1, hyW⟩ ⟨c, y.2⟩ = Chart.StalkRing.mk c _ g

/-- A family `s` of elements of the fibres over `W` is *compatible* if its components are
related by the transition homomorphisms of all chart morphisms. -/
def IsCompatible {W : Opens (space sX)} (s : ∀ x : W, Fibre x.1) : Prop :=
  ∀ (c d : Chart sX) (m : ChartHom c d) (x : W) (hx : x.1 ∈ chart d.U),
    m.transition ⟨x.1, hx⟩ (s x ⟨c, chart_mono m.le hx⟩) = s x ⟨d, hx⟩

/-- The local predicate cutting out the sections of `𝒪_{X^an}`. -/
def localPredicate : TopCat.LocalPredicate (fun x : space sX => Fibre x) where
  pred s := IsLocallyHolomorphic s ∧ IsCompatible s
  res := by
    intro W W' i s ⟨hs, hc⟩
    refine ⟨fun c x hx => ?_, fun c d m x hx => hc c d m ⟨x.1, i.le x.2⟩ hx⟩
    obtain ⟨O, hO, hxO, h, hh⟩ := hs c ⟨x.1, i.le x.2⟩ hx
    refine ⟨O ∩ {y | y.1 ∈ W},
      (chartTopology c.U).isOpen_inter _ _ hO (isOpen_chart_inter ⟨c.U, c.isAffineOpen⟩ W),
      ⟨hxO, x.2⟩, h, fun y hy => ?_⟩
    obtain ⟨_, g, hg, hsg⟩ := hh y hy.1
    exact ⟨hy.2, g, hg, hsg⟩
  locality := by
    intro W s hs
    refine ⟨fun c x hx => ?_, fun c d m x hx => ?_⟩
    · obtain ⟨V, hxV, i, hV⟩ := hs x
      obtain ⟨O, hO, hxO, h, hh⟩ := hV.1 c ⟨x.1, hxV⟩ hx
      refine ⟨O, hO, hxO, h, fun y hy => ?_⟩
      obtain ⟨hyV, g, hg, hsg⟩ := hh y hy
      exact ⟨i.le hyV, g, hg, hsg⟩
    · obtain ⟨V, hxV, i, hV⟩ := hs x
      exact hV.2 c d m ⟨x.1, hxV⟩ hx

section RingOps

variable {W : Opens (space sX)}

/-- The zero family is locally holomorphic. -/
lemma isLocallyHolomorphic_zero : IsLocallyHolomorphic (0 : ∀ x : W, Fibre x.1) :=
  fun c x _ => ⟨{y | y.1 ∈ W}, isOpen_chart_inter ⟨c.U, c.isAffineOpen⟩ W, x.2, 0,
    fun _ hy => ⟨hy, 0, rfl, (map_zero _).symm⟩⟩

/-- The unit family is locally holomorphic. -/
lemma isLocallyHolomorphic_one : IsLocallyHolomorphic (1 : ∀ x : W, Fibre x.1) :=
  fun c x _ => ⟨{y | y.1 ∈ W}, isOpen_chart_inter ⟨c.U, c.isAffineOpen⟩ W, x.2, 1,
    fun _ hy => ⟨hy, 1, rfl, (map_one _).symm⟩⟩

/-- The sum of locally holomorphic families is locally holomorphic. -/
lemma IsLocallyHolomorphic.add {s t : ∀ x : W, Fibre x.1} (hs : IsLocallyHolomorphic s)
    (ht : IsLocallyHolomorphic t) : IsLocallyHolomorphic (s + t) := fun c x hx => by
  obtain ⟨O₁, hO₁, hx₁, h₁, hh₁⟩ := hs c x hx
  obtain ⟨O₂, hO₂, hx₂, h₂, hh₂⟩ := ht c x hx
  refine ⟨O₁ ∩ O₂, (chartTopology c.U).isOpen_inter _ _ hO₁ hO₂, ⟨hx₁, hx₂⟩, h₁ + h₂,
    fun y hy => ?_⟩
  obtain ⟨hyW, g₁, hg₁, e₁⟩ := hh₁ y hy.1
  obtain ⟨_, g₂, hg₂, e₂⟩ := hh₂ y hy.2
  refine ⟨hyW, g₁ + g₂, by rw [Subring.coe_add, hg₁, hg₂]; rfl, ?_⟩
  rw [map_add, ← e₁, ← e₂]
  rfl

/-- The product of locally holomorphic families is locally holomorphic. -/
lemma IsLocallyHolomorphic.mul {s t : ∀ x : W, Fibre x.1} (hs : IsLocallyHolomorphic s)
    (ht : IsLocallyHolomorphic t) : IsLocallyHolomorphic (s * t) := fun c x hx => by
  obtain ⟨O₁, hO₁, hx₁, h₁, hh₁⟩ := hs c x hx
  obtain ⟨O₂, hO₂, hx₂, h₂, hh₂⟩ := ht c x hx
  refine ⟨O₁ ∩ O₂, (chartTopology c.U).isOpen_inter _ _ hO₁ hO₂, ⟨hx₁, hx₂⟩, h₁ * h₂,
    fun y hy => ?_⟩
  obtain ⟨hyW, g₁, hg₁, e₁⟩ := hh₁ y hy.1
  obtain ⟨_, g₂, hg₂, e₂⟩ := hh₂ y hy.2
  refine ⟨hyW, g₁ * g₂, by rw [Subring.coe_mul, hg₁, hg₂]; rfl, ?_⟩
  rw [map_mul, ← e₁, ← e₂]
  rfl

/-- The negation of a locally holomorphic family is locally holomorphic. -/
lemma IsLocallyHolomorphic.neg {s : ∀ x : W, Fibre x.1} (hs : IsLocallyHolomorphic s) :
    IsLocallyHolomorphic (-s) := fun c x hx => by
  obtain ⟨O, hO, hxO, h, hh⟩ := hs c x hx
  refine ⟨O, hO, hxO, -h, fun y hy => ?_⟩
  obtain ⟨hyW, g, hg, e⟩ := hh y hy
  refine ⟨hyW, -g, by rw [Subring.coe_neg, hg]; rfl, ?_⟩
  rw [map_neg, ← e]
  rfl

/-- The zero family is compatible. -/
lemma isCompatible_zero : IsCompatible (0 : ∀ x : W, Fibre x.1) :=
  fun _ _ m x hx => map_zero (m.transition ⟨x.1, hx⟩)

/-- The unit family is compatible. -/
lemma isCompatible_one : IsCompatible (1 : ∀ x : W, Fibre x.1) :=
  fun _ _ m x hx => map_one (m.transition ⟨x.1, hx⟩)

/-- The sum of compatible families is compatible. -/
lemma IsCompatible.add {s t : ∀ x : W, Fibre x.1} (hs : IsCompatible s) (ht : IsCompatible t) :
    IsCompatible (s + t) := fun c d m x hx => by
  have e := map_add (m.transition ⟨x.1, hx⟩) (s x ⟨c, chart_mono m.le hx⟩)
    (t x ⟨c, chart_mono m.le hx⟩)
  exact e.trans (congrArg₂ (· + ·) (hs c d m x hx) (ht c d m x hx))

/-- The product of compatible families is compatible. -/
lemma IsCompatible.mul {s t : ∀ x : W, Fibre x.1} (hs : IsCompatible s) (ht : IsCompatible t) :
    IsCompatible (s * t) := fun c d m x hx => by
  have e := map_mul (m.transition ⟨x.1, hx⟩) (s x ⟨c, chart_mono m.le hx⟩)
    (t x ⟨c, chart_mono m.le hx⟩)
  exact e.trans (congrArg₂ (· * ·) (hs c d m x hx) (ht c d m x hx))

/-- The negation of a compatible family is compatible. -/
lemma IsCompatible.neg {s : ∀ x : W, Fibre x.1} (hs : IsCompatible s) :
    IsCompatible (-s) := fun c d m x hx => by
  have e := map_neg (m.transition ⟨x.1, hx⟩) (s x ⟨c, chart_mono m.le hx⟩)
  exact e.trans (congrArg (- ·) (hs c d m x hx))

end RingOps

variable (sX) in
/-- The ring of sections of `𝒪_{X^an}` over an open `W ⊆ X(ℂ)`. -/
def sections (W : Opens (space sX)) : Subring (∀ x : W, Fibre x.1) where
  carrier := {s | (localPredicate (sX := sX)).pred s}
  zero_mem' := ⟨isLocallyHolomorphic_zero, isCompatible_zero⟩
  one_mem' := ⟨isLocallyHolomorphic_one, isCompatible_one⟩
  add_mem' := fun hs ht => ⟨hs.1.add ht.1, hs.2.add ht.2⟩
  mul_mem' := fun hs ht => ⟨hs.1.mul ht.1, hs.2.mul ht.2⟩
  neg_mem' := fun hs => ⟨hs.1.neg, hs.2.neg⟩

/-- Restriction of sections of `𝒪_{X^an}` to a smaller open. -/
def restrictHom {W W' : Opens (space sX)} (h : W' ≤ W) : sections sX W →+* sections sX W' :=
  (RingHom.pi fun x : W' => Pi.evalRingHom (fun x : W => Fibre x.1) ⟨x.1, h x.2⟩).restrict _ _
    fun s hs => localPredicate.res (homOfLE h) s hs

/-- The restriction of a section evaluated at a point is the section evaluated at that point. -/
@[simp]
lemma restrictHom_apply {W W' : Opens (space sX)} (h : W' ≤ W) (s : sections sX W) (x : W') :
    (restrictHom h s).1 x = s.1 ⟨x.1, h x.2⟩ :=
  rfl

variable (sX) in
/-- The presheaf of rings `𝒪_{X^an}` on `X(ℂ)`. -/
def structurePresheaf : TopCat.Presheaf CommRingCat.{0} (space sX) where
  obj W := CommRingCat.of (sections sX W.unop)
  map i := CommRingCat.ofHom (restrictHom i.unop.le)
  map_id _ := by ext : 2; rfl
  map_comp _ _ := by ext : 2; rfl

/-- Forgetting the ring structure of `𝒪_{X^an}` gives the sheaf of sections of the local
predicate. -/
def structurePresheafCompForget :
    structurePresheaf sX ⋙ forget CommRingCat ≅
      TopCat.subpresheafToTypes (localPredicate (sX := sX)).toPrelocalPredicate :=
  NatIso.ofComponents
    (fun W => Iso.refl
      ((TopCat.subpresheafToTypes (localPredicate (sX := sX)).toPrelocalPredicate).obj W))
    (fun _ => rfl)

variable (sX) in
/-- The structure sheaf `𝒪_{X^an}` of the analytification, on the realization `X(ℂ)`. -/
@[mmp "def_mmp_gaga_analytification"]
def structureSheaf : TopCat.Sheaf CommRingCat.{0} (space sX) where
  obj := structurePresheaf sX
  property := by
    rw [CategoryTheory.Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget CommRingCat)]
    exact TopCat.Presheaf.isSheaf_of_iso structurePresheafCompForget.symm
      (TopCat.subpresheafToTypes.isSheaf _)

end Analytification

/-! ### The comparison map `α_X : X^an → X` -/

namespace ComplexPoints

/-- The closed point of a `ℂ`-point `y` lies in `D(a)` iff the value of `a` at `y` is nonzero. -/
lemma toScheme_mem_basicOpen_iff {U : X.Opens} (y : chart (sX := sX) U) (a : Γ(X, U)) :
    y.1.toScheme ∈ X.basicOpen a ↔ evalHom U y a ≠ 0 := by
  have h₁ : y.1.toScheme ∈ X.basicOpen a ↔
      (default : Spec (.of ℂ)) ∈ y.1.hom ⁻¹ᵁ X.basicOpen a := Iff.rfl
  have h₂ : (Spec (.of ℂ)).basicOpen (y.1.hom.appLE U ⊤ y.2.ge a) =
      ⊤ ⊓ y.1.hom ⁻¹ᵁ X.basicOpen a := by
    rw [Scheme.preimage_basicOpen, Scheme.Hom.appLE, CommRingCat.comp_apply,
      Scheme.basicOpen_res]
  rw [h₁, ← top_inf_eq (y.1.hom ⁻¹ᵁ X.basicOpen a), ← h₂, basicOpen_eq_of_affine']
  change (default : PrimeSpectrum ℂ) ∈ PrimeSpectrum.basicOpen (evalHom U y a) ↔ _
  rw [PrimeSpectrum.mem_basicOpen, Ideal.eq_bot_of_prime (default : PrimeSpectrum ℂ).asIdeal]
  simp

/-- The `ℂ`-points of an affine open `U` whose underlying point lies in an open `V` form an
open set. -/
lemma isOpen_toScheme_mem (U : X.affineOpens) (V : X.Opens) :
    IsOpen[chartTopology (U : X.Opens)]
      {y : chart (sX := sX) (U : X.Opens) | y.1.toScheme ∈ V} := by
  rw [@isOpen_iff_forall_mem_open _ (chartTopology _)]
  intro y hy
  obtain ⟨f, hfV, hyf⟩ := U.2.exists_basicOpen_le ⟨_, hy⟩ (mem_chart_iff.1 y.2)
  refine ⟨{z | evalHom (U : X.Opens) z f ≠ 0},
    fun z hz => hfV ((toScheme_mem_basicOpen_iff z f).2 hz),
    @Continuous.isOpen_preimage _ _ (chartTopology _) _ _ (continuous_eval _ f) _
      isOpen_compl_singleton, (toScheme_mem_basicOpen_iff y f).1 hyf⟩

/-- The map `X(ℂ) → X` sending a `ℂ`-point to its closed point is continuous. -/
lemma continuous_toScheme : Continuous (toScheme : ComplexPoints sX → X) := by
  rw [continuous_def]
  intro V hV
  rw [isOpen_iff]
  intro U
  exact isOpen_toScheme_mem U ⟨V, hV⟩

/-- A section not in the prime ideal of the closed point of `y` has nonzero value at `y`. -/
lemma evalHom_ne_zero_of_notMem {U : X.Opens} (hU : IsAffineOpen U) (y : chart (sX := sX) U)
    (a : Γ(X, U)) (ha : a ∉ (hU.primeIdealOf ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩).asIdeal) :
    evalHom U y a ≠ 0 := by
  intro h
  apply ha
  have e := IsAffineOpen.comap_primeIdealOf_appLE (x := (default : Spec (.of ℂ))) U hU ⊤
    (isAffineOpen_top _) y.2.ge trivial
  change a ∈ (hU.primeIdealOf ⟨y.1.hom default, _⟩).asIdeal
  rw [← e]
  change y.1.hom.appLE U ⊤ y.2.ge a ∈
    ((isAffineOpen_top (Spec (.of ℂ))).primeIdealOf ⟨default, trivial⟩).asIdeal
  have : y.1.hom.appLE U ⊤ y.2.ge a = 0 := by
    rw [← Iso.hom_inv_id_apply (Scheme.ΓSpecIso (.of ℂ)) (y.1.hom.appLE U ⊤ y.2.ge a),
      show (Scheme.ΓSpecIso (.of ℂ)).hom (y.1.hom.appLE U ⊤ y.2.ge a) = 0 from h, map_zero]
  rw [this]
  exact Ideal.zero_mem _

end ComplexPoints

namespace Chart

variable (c : Chart sX)

/-- The image of a section with nonzero value at `y` is a unit in the local ring at `y`. -/
lemma isUnit_toStalkRing (y : chart (sX := sX) c.U) (a : Γ(X, c.U))
    (ha : evalHom c.U y a ≠ 0) : IsUnit (c.toStalkRing (c.coords y) a) := by
  obtain ⟨q, rfl⟩ := c.surjective a
  change IsUnit (c.toStalkRing (c.coords y) (c.pres q))
  rw [toStalkRing_pres]
  refine (isUnit_polyGermHom _ q ?_).map _
  rwa [← c.evalHom_pres]

/-- The homomorphism `𝒪_{X,α(y)} → 𝒪_{ℂⁿ,z(y)}/I 𝒪_{ℂⁿ,z(y)}` from the local ring of `X` at
the closed point of a `ℂ`-point `y` of the chart: on `𝒪_{X,α(y)} = Γ(X, U)_{𝔪_y}` it sends
`p/a` to the class of the holomorphic germ `p/a`. -/
def stalkHom (y : chart (sX := sX) c.U) :
    X.presheaf.stalk y.1.toScheme →+* c.StalkRing (c.coords y) :=
  letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (U := c.U)
    ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩
  haveI := c.isAffineOpen.isLocalization_stalk ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩
  IsLocalization.lift (M := (c.isAffineOpen.primeIdealOf
      ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩).asIdeal.primeCompl)
    (g := c.toStalkRing (c.coords y)) fun a =>
      c.isUnit_toStalkRing y a (evalHom_ne_zero_of_notMem c.isAffineOpen y a a.2)

/-- `stalkHom` sends the germ of a section `a` to the image of `a` in the local ring. -/
lemma stalkHom_germ (y : chart (sX := sX) c.U) (a : Γ(X, c.U)) :
    c.stalkHom y (X.presheaf.germ c.U y.1.toScheme (mem_chart_iff.1 y.2) a) =
      c.toStalkRing (c.coords y) a := by
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (U := c.U)
    ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩
  have := c.isAffineOpen.isLocalization_stalk ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩
  exact IsLocalization.lift_eq (M := (c.isAffineOpen.primeIdealOf
      ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩).asIdeal.primeCompl) _ a

end Chart

/-- The transition homomorphisms of a chart morphism commute with the maps `stalkHom`. -/
lemma ChartHom.transition_stalkHom {c d : Chart sX} (m : ChartHom c d) (y : chart (sX := sX) d.U)
    (γ : X.presheaf.stalk y.1.toScheme) :
    m.transition y (c.stalkHom (m.incl y) γ) = d.stalkHom y γ := by
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (U := c.U)
    ⟨(m.incl y).1.toScheme, mem_chart_iff.1 (m.incl y).2⟩
  have := c.isAffineOpen.isLocalization_stalk ⟨(m.incl y).1.toScheme, mem_chart_iff.1 (m.incl y).2⟩
  have key : (m.transition y).comp (c.stalkHom (m.incl y)) = d.stalkHom y := by
    refine IsLocalization.ringHom_ext (M := (c.isAffineOpen.primeIdealOf
      ⟨(m.incl y).1.toScheme, mem_chart_iff.1 (m.incl y).2⟩).asIdeal.primeCompl)
      (S := X.presheaf.stalk (m.incl y).1.toScheme) ?_
    ext a
    change m.transition y (c.stalkHom (m.incl y)
        (X.presheaf.germ c.U (m.incl y).1.toScheme (mem_chart_iff.1 (m.incl y).2) a)) =
      d.stalkHom y (X.presheaf.germ c.U (m.incl y).1.toScheme (mem_chart_iff.1 (m.incl y).2) a)
    rw [c.stalkHom_germ, m.transition_toStalkRing,
      ← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE m.le) (m.incl y).1.toScheme
        (mem_chart_iff.1 y.2)]
    exact (d.stalkHom_germ y _).symm
  exact RingHom.congr_fun key γ

namespace Analytification

variable (sX) in
/-- The continuous map `α_X : X(ℂ) → X` sending a `ℂ`-point to the corresponding closed point. -/
def toSchemeHom : space sX ⟶ X.toPresheafedSpace.carrier :=
  TopCat.ofHom ⟨toScheme, continuous_toScheme⟩

/-- `toSchemeHom sX x` is the closed point of `x`. -/
@[simp]
lemma toSchemeHom_apply (x : space sX) : toSchemeHom sX x = x.toScheme :=
  rfl

/-- The family underlying `α_X^#(g)` for a section `g` of `𝒪_X` over `V`: at a `ℂ`-point `x` and
a chart containing it, the image of the germ of `g` at `α_X(x)`. -/
def sharpFun (V : X.Opens) (g : Γ(X, V)) :
    ∀ x : (Opens.map (toSchemeHom sX)).obj V, Fibre x.1 :=
  fun x c => c.1.stalkHom ⟨x.1, c.2⟩ (X.presheaf.germ V x.1.toScheme x.2 g)

/-- The family underlying `α_X^#(g)` is compatible. -/
lemma isCompatible_sharpFun (V : X.Opens) (g : Γ(X, V)) : IsCompatible (sharpFun (sX := sX) V g) :=
  fun _ _ m x hx => m.transition_stalkHom ⟨x.1, hx⟩ _

/-- If `g · t = a` on `W'` after restriction, then the corresponding germs satisfy `g · t = a`
at every point of `W'`. -/
lemma germ_mul_germ_eq_of_map_eq {V U W' : X.Opens} (g : Γ(X, V)) (t a : Γ(X, U))
    (iVU : W' ⟶ V ⊓ U) (iU : W' ⟶ U)
    (e : X.presheaf.map iVU.op (X.presheaf.map (homOfLE inf_le_left).op g *
      X.presheaf.map (homOfLE inf_le_right).op t) = X.presheaf.map iU.op a)
    (z : X) (hz : z ∈ W') :
    X.presheaf.germ V z (iVU.le hz).1 g * X.presheaf.germ U z (iU.le hz) t =
      X.presheaf.germ U z (iU.le hz) a := by
  simpa only [TopCat.Presheaf.germ_res_apply, map_mul] using congrArg (X.presheaf.germ W' z hz) e

/-- The family underlying `α_X^#(g)` is locally holomorphic. -/
lemma isLocallyHolomorphic_sharpFun (V : X.Opens) (g : Γ(X, V)) :
    IsLocallyHolomorphic (sharpFun (sX := sX) V g) := by
  intro c x hx
  have hU0 : x.1.toScheme ∈ c.U := mem_chart_iff.1 hx
  have hV0 : x.1.toScheme ∈ V := x.2
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (U := c.U) ⟨x.1.toScheme, hU0⟩
  have := c.isAffineOpen.isLocalization_stalk ⟨x.1.toScheme, hU0⟩
  obtain ⟨⟨a, t⟩, ht⟩ := IsLocalization.mk'_surjective
    (c.isAffineOpen.primeIdealOf ⟨x.1.toScheme, hU0⟩).asIdeal.primeCompl
    (X.presheaf.germ V x.1.toScheme hV0 g)
  have e₀ : X.presheaf.germ V x.1.toScheme hV0 g * X.presheaf.germ c.U x.1.toScheme hU0 t =
      X.presheaf.germ c.U x.1.toScheme hU0 a := by
    rw [← ht]
    exact IsLocalization.mk'_spec _ a t
  have e₁ : X.presheaf.germ (V ⊓ c.U) x.1.toScheme (show x.1.toScheme ∈ V ⊓ c.U from ⟨hV0, hU0⟩)
      (X.presheaf.map (homOfLE inf_le_left).op g *
        X.presheaf.map (homOfLE inf_le_right).op (t : Γ(X, c.U))) =
      X.presheaf.germ c.U x.1.toScheme hU0 a := by
    rwa [map_mul, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply]
  obtain ⟨W', hW', iU, iV, e⟩ := TopCat.Presheaf.germ_eq X.presheaf _ _ _ _ _ e₁
  obtain ⟨A, hA⟩ : ∃ A, c.pres A = a := c.surjective a
  obtain ⟨S, hS⟩ : ∃ S, c.pres S = (t : Γ(X, c.U)) := c.surjective (t : Γ(X, c.U))
  have ht₀ : evalHom c.U ⟨x.1, hx⟩ t ≠ 0 :=
    evalHom_ne_zero_of_notMem c.isAffineOpen ⟨x.1, hx⟩ t t.2
  refine ⟨{y | y.1.toScheme ∈ W'} ∩ {y | evalHom c.U y t ≠ 0},
    (chartTopology c.U).isOpen_inter _ _ (isOpen_toScheme_mem ⟨c.U, c.isAffineOpen⟩ W')
      (@Continuous.isOpen_preimage _ _ (chartTopology _) _ _ (continuous_eval _ _) _
        isOpen_compl_singleton), ⟨hW', ht₀⟩,
    fun z => MvPolynomial.eval z A * (MvPolynomial.eval z S)⁻¹, fun y hy => ?_⟩
  have hyV : y.1.toScheme ∈ V := (iU.le hy.1).1
  have hSy : MvPolynomial.eval (c.coords y) S ≠ 0 := by
    rw [← c.evalHom_pres, hS]
    exact hy.2
  have hSev : ∀ᶠ z in 𝓝 (c.coords y), MvPolynomial.eval z S ≠ 0 :=
    (differentiable_eval_mvPolynomial S).continuous.continuousAt.eventually_ne hSy
  refine ⟨hyV, ⟨_, coe_mem_holGerms (hSev.mono fun z hz =>
    (differentiable_eval_mvPolynomial A).differentiableAt.mul
      ((differentiable_eval_mvPolynomial S).differentiableAt.inv hz))⟩, rfl, ?_⟩
  refine (c.isUnit_toStalkRing y t hy.2).mul_left_inj.1 ?_
  have e₂ := congrArg (c.stalkHom y) (germ_mul_germ_eq_of_map_eq g t a iU iV e y.1.toScheme hy.1)
  rw [map_mul, c.stalkHom_germ, c.stalkHom_germ] at e₂
  change c.stalkHom y (X.presheaf.germ V y.1.toScheme hyV g) * _ = _
  rw [e₂, ← hA, ← hS, c.toStalkRing_pres, c.toStalkRing_pres, ← map_mul]
  congr 1
  apply Subtype.ext
  change _ = ((fun z => MvPolynomial.eval z A * (MvPolynomial.eval z S)⁻¹ *
    MvPolynomial.eval z S : (Fin c.n → ℂ) → ℂ) : Germ (𝓝 (c.coords y)) ℂ)
  exact Germ.coe_eq.2 (hSev.mono fun z hz => by
    change _ = MvPolynomial.eval z A * (MvPolynomial.eval z S)⁻¹ * MvPolynomial.eval z S
    rw [inv_mul_cancel_right₀ hz]
    rfl)

/-- `α_X^#` on sections over `V`: the ring homomorphism `𝒪_X(V) → 𝒪_{X^an}(α_X⁻¹ V)`. -/
def sharpHom (V : X.Opens) : Γ(X, V) →+* sections sX ((Opens.map (toSchemeHom sX)).obj V) where
  toFun g := ⟨sharpFun V g, isLocallyHolomorphic_sharpFun V g, isCompatible_sharpFun V g⟩
  map_one' := Subtype.ext <| funext fun x => funext fun c => by
    simp only [sharpFun, map_one]
    rfl
  map_mul' g h := Subtype.ext <| funext fun x => funext fun c => by
    simp only [sharpFun, map_mul]
    rfl
  map_zero' := Subtype.ext <| funext fun x => funext fun c => by
    simp only [sharpFun, map_zero]
    rfl
  map_add' g h := Subtype.ext <| funext fun x => funext fun c => by
    simp only [sharpFun, map_add]
    rfl

/-- The components of `α_X^#(g)` are the images of the germs of `g` under `stalkHom`. -/
@[simp]
lemma sharpHom_apply (V : X.Opens) (g : Γ(X, V)) (x : (Opens.map (toSchemeHom sX)).obj V)
    (c : {c : Chart sX // x.1 ∈ chart c.U}) :
    (sharpHom V g).1 x c = c.1.stalkHom ⟨x.1, c.2⟩ (X.presheaf.germ V x.1.toScheme x.2 g) :=
  rfl

end Analytification

open Analytification

variable (sX) in
/-- The **analytification** `X^an` of a scheme `X` over `ℂ`: the realization `X(ℂ)` with the
sheaf of rings `𝒪_{X^an}`, which on the `ℂ`-points of an affine chart
`Spec ℂ[z₁, …, zₙ]/I` is `(𝒪_{ℂⁿ}/I 𝒪_{ℂⁿ})|_Z`, glued along the polynomial coordinate
changes. -/
@[mmp "def_mmp_gaga_analytification"]
abbrev analytification : SheafedSpace CommRingCat.{0} where
  carrier := space sX
  presheaf := (structureSheaf sX).obj
  IsSheaf := (structureSheaf sX).property

variable (sX) in
/-- The comparison morphism of ringed spaces `α_X : X^an → X`, with
`α_X^# : 𝒪_X → (α_X)_* 𝒪_{X^an}` sending a section to its holomorphic germs. -/
@[mmp "def_mmp_gaga_analytification"]
def analytificationHom : analytification sX ⟶ X.toSheafedSpace :=
  InducedCategory.homMk
    { base := toSchemeHom sX
      c :=
        { app := fun V => CommRingCat.ofHom (sharpHom V.unop)
          naturality := fun V V' i => by
            ext g : 2
            apply Subtype.ext
            funext x c
            exact congrArg (c.1.stalkHom ⟨x.1, c.2⟩)
              (TopCat.Presheaf.germ_res_apply X.presheaf i.unop x.1.toScheme x.2 g) } }

/-! ### Inverse image, analytification of modules and comparison maps -/

variable (sX) in
/-- `α_X^# : α_X⁻¹ 𝒪_X → 𝒪_{X^an}`, the adjoint form of `α_X^#` on the inverse image sheaf. -/
@[mmp "def_mmp_gaga_analytification"]
def analytificationSharp :
    (TopCat.Sheaf.pullback CommRingCat.{0} (toSchemeHom sX)).obj X.sheaf ⟶ structureSheaf sX :=
  ((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{0} (toSchemeHom sX)).homEquiv _ _).symm
    ⟨(analytificationHom sX).hom.c⟩

variable (sX) in
/-- The structure sheaf of `X^an` as a sheaf of (not necessarily commutative) rings. -/
abbrev ringCatSheaf : TopCat.Sheaf RingCat.{0} (space sX) :=
  (sheafCompose _ (forget₂ CommRingCat RingCat.{0})).obj (structureSheaf sX)

/-- The preimage functor along `α_X` is continuous for the Grothendieck topologies of opens. -/
instance : (Opens.map (toSchemeHom sX)).IsContinuous
    (Opens.grothendieckTopology X.toPresheafedSpace.carrier)
    (Opens.grothendieckTopology (space sX)) :=
  Functor.isContinuous_of_coverPreserving (compatiblePreserving_opens_map _)
    (coverPreserving_opens_map _)

variable (sX) in
/-- `α_X^#` as a morphism of sheaves of rings `𝒪_X ⟶ (α_X)_* 𝒪_{X^an}`. -/
def ringCatSheafHom : X.ringCatSheaf ⟶
    ((Opens.map (toSchemeHom sX)).sheafPushforwardContinuous RingCat.{0}
      (Opens.grothendieckTopology X.toPresheafedSpace.carrier)
      (Opens.grothendieckTopology (space sX))).obj (ringCatSheaf sX) where
  hom := Functor.whiskerRight (analytificationHom sX).hom.c _

/-- Pushforward of presheaves of modules along `α_X^#` is a right adjoint. -/
instance : (PresheafOfModules.pushforward.{0} (ringCatSheafHom sX).hom).IsRightAdjoint :=
  PresheafOfModules.instIsRightAdjointPushforward _

/-- Pushforward of sheaves of modules along `α_X^#` is a right adjoint. -/
instance : (SheafOfModules.pushforward.{0} (ringCatSheafHom sX)).IsRightAdjoint :=
  (SheafOfModules.PullbackConstruction.adjunction.{0} (ringCatSheafHom sX)).isRightAdjoint

variable (sX) in
/-- The analytification `F ↦ F^an = α_X⁻¹ F ⊗_{α_X⁻¹ 𝒪_X} 𝒪_{X^an}` of sheaves of
`𝒪_X`-modules: the pullback of modules along `α_X`. -/
@[mmp "def_mmp_gaga_analytification"]
def analytifyModule : X.Modules ⥤ SheafOfModules.{0} (ringCatSheaf sX) :=
  SheafOfModules.pullback.{0} (ringCatSheafHom sX)

variable (sX) in
/-- The unit `F ⟶ (α_X)_* F^an` of the analytification of modules. -/
def analytifyModuleUnit (F : X.Modules) :
    F ⟶ (SheafOfModules.pushforward.{0} (ringCatSheafHom sX)).obj ((analytifyModule sX).obj F) :=
  (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX)).unit.app F

variable (sX) in
/-- The map of abelian sheaves `ι_F : α_X⁻¹ F ⟶ F^an`, `s ↦ s ⊗ 1`. -/
@[mmp "def_mmp_gaga_analytification"]
def analytifyModuleι (F : X.Modules) :
    (TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom sX)).obj
        ((SheafOfModules.toSheaf _).obj F) ⟶
      (SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F) :=
  ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
      (toSchemeHom sX)).homEquiv _ _).symm
    ((SheafOfModules.toSheaf _).map (analytifyModuleUnit sX F))

variable (sX) in
/-- The **comparison map** `c^q_F : H^q(X, F) → H^q(X^an, α_X⁻¹ F) → H^q(X^an, F^an)`, the
Godement pullback along `α_X` followed by `(ι_F)_*`. -/
@[mmp "def_mmp_gaga_analytification"]
def comparisonMap (F : X.Modules) (q : ℤ) :
    (sheafCohomology _ q).obj ((SheafOfModules.toSheaf _).obj F) ⟶
      (sheafCohomology (space sX) q).obj
        ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F)) :=
  sheafCohomologyPullback (toSchemeHom sX) _ q ≫ (sheafCohomology (space sX) q).map
    (analytifyModuleι sX F)

/-! ### Coherent sheaves of modules -/

section Coherent

variable {T : TopCat.{0}} {A : TopCat.Sheaf RingCat.{0} T}

/-- A sheaf of modules `S` over a sheaf of rings `A` on a space `T` is *coherent* if it is locally
generated by finitely many sections and, for every open `V` and finitely many sections
`s₁, …, s_p` of `S` over `V`, the kernel of `A_V^p → S|_V` is locally generated by finitely many
sections. -/
@[mmp "def_mmp_gaga_analytification"]
def IsCoherentModule (S : SheafOfModules.{0} A) : Prop :=
  SheafOfModules.IsFiniteType.{0} S ∧
    ∀ (V : Opens T) (p : ℕ) (s : Fin p → (S.over V).sections),
      SheafOfModules.IsFiniteType.{0} (Limits.kernel ((S.over V).freeHomEquiv.symm s))

variable (A) in
/-- A sheaf of rings is *coherent* if it is coherent as a module over itself. -/
@[mmp "def_mmp_gaga_analytification"]
def IsCoherentRing : Prop :=
  IsCoherentModule (SheafOfModules.unit A)

end Coherent

end MMP.Analytic
