/-!
# Intersection numbers of curves with effective Cartier divisors

Let `D` be a Cartier divisor on a `k`-scheme `X` and `C ⊆ X` an integral projective curve with
`C ⊄ Supp D`. For `P ∈ C ∩ Supp D` let `d_P ∈ 𝒪_{X,P}` be a local equation of `D` at `P`. Then
the intersection number `(D · C) = deg_C(𝒪_X(D)|_C)` (Kollár's degree of 1.20) is

  `(D · C) = ∑_{P ∈ C ∩ Supp D} dim_k 𝒪_{C,P}/(d_P|_C)`,

and the summand at `P` is the local intersection number `(C · D)_P` of `C` with the closed
subscheme of `D`.

The restriction `ι^*𝒪_X(D)` to `C` is the sheaf `𝒪_C(ι^*D)` of the pulled-back Cartier divisor.
On an open `V ∋ η_C` outside `Supp D`, the divisor `D` has the local equation `1`, and the generic
germ `s` of the corresponding generator of `𝒪_C(ι^*D)` is a nonzero rational section. Near
`P = ι(p)` the generator is `(ι^*d_P)⁻¹`, so `s = (ι^*d_P) · (ι^*d_P)⁻¹`, and the local
multiplicity is `e_p(s) = e_p(d_P|_C) = dim_k 𝒪_{C,p}/(d_P|_C)`; it vanishes off `Supp D`, where
the local equation is `1`. The degree is `∑_p e_p(s)`, independent of `s`.

## Main results

* `MMP.Threefold.Resolution.cartierCurveIntersection_eq_finsum_finrank`:
  `(D · C) = ∑_{P ∈ C ∩ Supp D} dim_k 𝒪_{C,P}/(d_P|_C)`.
* `MMP.Threefold.Resolution.rank_quotient_stalk_eq_localIntersectionNumber_subscheme`:
  for effective `D`, `dim_k 𝒪_{C,P}/(d_P|_C) = (C · D)_P`.
* `MMP.Threefold.Resolution.rank_quotient_stalk_eq_localIntersectionNumber`: the same for any
  ideal sheaf generated by `d_P` at `P`.

## Implementation notes

The points of `C ∩ Supp D` are the points `p` of the integral closed subscheme `C` with
`ι(p) ∈ Supp D`, and `𝒪_{C,P}/(d_P|_C)` is the quotient of the local ring of `C` at `p` by the
image of `d_P` under `ι^# : 𝒪_{X,P} → 𝒪_{C,p}`. A local equation `d_P` is a section of `𝒪_X` on
an open `U_P ∋ P` whose image in `𝒦_X(U_P)` is a unit and a local equation of `D`
(`MMP.CartierDivisor.IsRegularLocalEquation`); such local equations exist exactly
when `D` is effective near `P`, and nothing else of effectivity is used, so the first result is
stated for every Cartier divisor with local equations in `𝒪_X` along `C ∩ Supp D`. The hypothesis
that `X` is of finite type over `k` is not needed: `C` is proper over `k`.

The comparison with the local intersection number holds on any `X`; the smooth surface of the
source is where Kollár defines `(C · D)_P`.

## References

* [J. Kollár, *Lectures on resolution of singularities*][KollarResolution], 1.20, 1.50, Chapter 2
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Opposite TopologicalSpace MMP.CartierDivisorSheaf

universe u

namespace MMP.Threefold.Resolution

/-! ### Local generators of `𝒪_X(D)` -/

section Frames

variable {X : Scheme.{u}} {D : X.CartierDivisor}

/-- The section of `𝒦_X` underlying a section of `𝒪_X(D)`. -/
abbrev sheafVal {V : X.Opens} (m : Γ(CartierDivisor.sheaf D, V)) :
    X.totalQuotientSheaf.obj.obj (op V) := m.1

/-- The section of `𝒦_X` underlying `a • m` is `a` times the section underlying `m`. -/
theorem sheafVal_smul {V : X.Opens} (a : Γ(X, V)) (m : Γ(CartierDivisor.sheaf D, V)) :
    sheafVal (a • m) = toK V a * sheafVal m := rfl

/-- Restriction of sections of `𝒪_X(D)` commutes with taking the underlying section of `𝒦_X`. -/
theorem sheafVal_map {V V' : X.Opens} (h : V' ≤ V) (m : Γ(CartierDivisor.sheaf D, V)) :
    sheafVal ((CartierDivisor.sheaf D).presheaf.map (homOfLE h).op m) = resK h (sheafVal m) := rfl

/-- A section of `𝒪_X(D)` is determined by its underlying section of `𝒦_X`. -/
theorem sheafVal_injective {V : X.Opens} : Function.Injective (sheafVal (D := D) (V := V)) :=
  fun _ _ h => Subtype.ext h

variable {W : X.Opens} {f : (X.totalQuotientSheaf.obj.obj (op W))ˣ}

/-- The local generator `f⁻¹` of `𝒪_X(D)` over an open `W` on which `f` is a local equation
of `D`. -/
def frameSection (hf : MMP.Intersection.IsLocalEquationOn D _ f) :
    Γ(CartierDivisor.sheaf D, W) :=
  ⟨((f⁻¹ : (X.totalQuotientSheaf.obj.obj (op W))ˣ) : X.totalQuotientSheaf.obj.obj (op W)),
    mem_inv hf⟩

/-- The section of `𝒦_X` underlying the local generator `frameSection hf` is `f⁻¹`. -/
theorem sheafVal_frameSection (hf : MMP.Intersection.IsLocalEquationOn D _ f) :
    sheafVal (frameSection hf) =
      ((f⁻¹ : (X.totalQuotientSheaf.obj.obj (op W))ˣ) : X.totalQuotientSheaf.obj.obj (op W)) :=
  rfl

/-- Over an open `V ⊆ W`, every section of `𝒪_X(D)` is a multiple of the local generator. -/
theorem exists_eq_smul_frameSection (hf : MMP.Intersection.IsLocalEquationOn D _ f)
    {V : X.Opens} (h : V ≤ W) (m : Γ(CartierDivisor.sheaf D, V)) :
    ∃ a : Γ(X, V),
      m = a • (CartierDivisor.sheaf D).presheaf.map (homOfLE h).op (frameSection hf) := by
  obtain ⟨a, ha⟩ := (mem_iff hf h (sheafVal m)).1 m.2
  exact ⟨a, Subtype.ext ha.symm⟩

end Frames

/-! ### Transport along an isomorphism -/

section Transport

variable {C : Scheme.{u}}

/-- On sections over `V`, the inverse of an isomorphism `M ≅ N` undoes the forward map. -/
theorem app_inv_hom_apply {M N : C.Modules} (e : M ≅ N) {V : C.Opens} (m : Γ(M, V)) :
    e.inv.app V (e.hom.app V m) = m := by
  change ((e.hom ≫ e.inv).app V) m = m
  rw [e.hom_inv_id]
  rfl

/-- On sections over `V`, the forward map of an isomorphism `M ≅ N` undoes the inverse. -/
theorem app_hom_inv_apply {M N : C.Modules} (e : M ≅ N) {V : C.Opens} (n : Γ(N, V)) :
    e.hom.app V (e.inv.app V n) = n := by
  change ((e.inv ≫ e.hom).app V) n = n
  rw [e.inv_hom_id]
  rfl

/-- A morphism of `𝒪_C`-modules commutes with restriction of sections along `V' ⊆ V`. -/
theorem map_app_apply {M N : C.Modules} (φ : M ⟶ N) {V V' : C.Opens} (h : V' ≤ V)
    (m : Γ(M, V)) :
    N.presheaf.map (homOfLE h).op (φ.app V m) = φ.app V' (M.presheaf.map (homOfLE h).op m) :=
  (NatTrans.naturality_apply φ.mapPresheaf (homOfLE h).op m).symm

variable {D : C.CartierDivisor} {N : C.Modules} (e : CartierDivisor.sheaf D ≅ N)

variable {W : C.Opens} {f : (C.totalQuotientSheaf.obj.obj (op W))ˣ}

/-- The germ of the image of a local generator of `𝒪_C(D)` generates the stalk of `N`. -/
theorem isStalkGenerator_germ_frameSection (hf : MMP.Intersection.IsLocalEquationOn D _ f)
    {p : C} (hp : p ∈ W) :
    MMP.Resolution.IsStalkGenerator N p
      (N.presheaf.germ W p hp (e.hom.app W (frameSection hf))) := by
  let := MMP.Resolution.stalkModule N p
  refine eq_top_iff.2 fun z _ => ?_
  obtain ⟨V, hpV, n, rfl⟩ := N.presheaf.exists_germ_eq z
  obtain ⟨a, ha⟩ := exists_eq_smul_frameSection hf (inf_le_right : V ⊓ W ≤ W)
    ((CartierDivisor.sheaf D).presheaf.map (homOfLE (inf_le_left : V ⊓ W ≤ V)).op (e.inv.app V n))
  have key : N.presheaf.map (homOfLE (inf_le_left : V ⊓ W ≤ V)).op n =
      a • N.presheaf.map (homOfLE (inf_le_right : V ⊓ W ≤ W)).op
        (e.hom.app W (frameSection hf)) := by
    rw [map_app_apply, ← Scheme.Modules.Hom.app_smul, ← ha, ← map_app_apply,
      app_hom_inv_apply]
  rw [Submodule.mem_span_singleton]
  refine ⟨C.presheaf.germ (V ⊓ W) p ⟨hpV, hp⟩ a, ?_⟩
  rw [← N.presheaf.germ_res_apply (homOfLE (inf_le_left : V ⊓ W ≤ V)) p ⟨hpV, hp⟩, key]
  refine ((Stacks.ModuleStalkSpecialization.germ_smul N (U := V ⊓ W) (x := p) ⟨hpV, hp⟩ a
    _).trans ?_).symm
  congr 1
  exact N.presheaf.germ_res_apply _ p _ _

/-- On an irreducible scheme every nonempty open contains the generic point. -/
theorem genericPoint_mem_of_mem [IrreducibleSpace C] {V : C.Opens} {p : C} (hp : p ∈ V) :
    genericPoint C ∈ V :=
  (genericPoint_specializes p).mem_open V.isOpen hp

/-- On an integral scheme, the specialization map to the generic stalk sends the germ of `m` at
`p` to the germ of `m` at the generic point. -/
theorem toGenericStalk_germ [IsIntegral C] (M : C.Modules) {V : C.Opens} {p : C} (hp : p ∈ V)
    (m : Γ(M, V)) :
    MMP.Resolution.toGenericStalk M p (M.presheaf.germ V p hp m) =
      M.presheaf.germ V (genericPoint C) (genericPoint_mem_of_mem hp) m :=
  Stacks.ModuleStalkSpecialization.germ_stalkSpecializes_apply M hp _ m

/-- **The local multiplicity of the generic germ of a local generator.** Let `f`, `g` be local
equations of `D` on `W ∋ p` and on `V`, and `u ∈ Γ(C, W ∩ V)` a unit with `g⁻¹ = u f⁻¹`. Then the
generic germ `s` of the image of the generator `g⁻¹` in `N ≅ 𝒪_C(D)` has `e_p(s) = e_p(u)`. -/
theorem sectionMult_germ_frameSection {k : Type u} [Field k] (sC : C ⟶ Spec (.of k))
    [MMP.Mori.IsCurve k sC] [Stacks.Ample.IsInvertibleModule C N]
    {V : C.Opens} {g : (C.totalQuotientSheaf.obj.obj (op V))ˣ}
    (hf : MMP.Intersection.IsLocalEquationOn D _ f)
    (hg : MMP.Intersection.IsLocalEquationOn D _ g) (hηV : genericPoint C ∈ V) {p : C}
    (hp : p ∈ W) (u : Γ(C, W ⊓ V)) (hu : IsUnit u)
    (huf : toK (W ⊓ V) u * resK inf_le_left
        ((f⁻¹ : (C.totalQuotientSheaf.obj.obj (op W))ˣ) : C.totalQuotientSheaf.obj.obj (op W)) =
      resK inf_le_right
        ((g⁻¹ : (C.totalQuotientSheaf.obj.obj (op V))ˣ) : C.totalQuotientSheaf.obj.obj (op V))) :
    MMP.Resolution.sectionMult sC N
        (N.presheaf.germ V (genericPoint C) hηV (e.hom.app V (frameSection hg))) p =
      MMP.Resolution.eMultAt sC {p}
        (C.presheaf.germ (W ⊓ V) (genericPoint C) ⟨genericPoint_mem_of_mem hp, hηV⟩ u) := by
  have hηWV : genericPoint C ∈ W ⊓ V := ⟨genericPoint_mem_of_mem hp, hηV⟩
  have hψ : C.presheaf.germ (W ⊓ V) (genericPoint C) hηWV u ≠ 0 :=
    (hu.map (C.presheaf.germ (W ⊓ V) (genericPoint C) hηWV).hom).ne_zero
  refine (MMP.Resolution.eMultAt_eq_sectionMult sC N _ _
    (isStalkGenerator_germ_frameSection e hf hp) _ hψ ?_).symm
  have hrel : (CartierDivisor.sheaf D).presheaf.map (homOfLE (inf_le_right : W ⊓ V ≤ V)).op
      (frameSection hg) =
      u • (CartierDivisor.sheaf D).presheaf.map (homOfLE (inf_le_left : W ⊓ V ≤ W)).op
          (frameSection hf) :=
    sheafVal_injective (by
      rw [sheafVal_map, sheafVal_smul, sheafVal_map, sheafVal_frameSection,
        sheafVal_frameSection]
      exact huf.symm)
  have hrelN : N.presheaf.map (homOfLE (inf_le_right : W ⊓ V ≤ V)).op
        (e.hom.app V (frameSection hg)) =
      u • N.presheaf.map (homOfLE (inf_le_left : W ⊓ V ≤ W)).op
        (e.hom.app W (frameSection hf)) := by
    rw [map_app_apply, hrel, Scheme.Modules.Hom.app_smul, map_app_apply]
  rw [toGenericStalk_germ, ← N.presheaf.germ_res_apply (homOfLE (inf_le_right : W ⊓ V ≤ V))
    (genericPoint C) hηWV, hrelN]
  refine (Stacks.ModuleStalkSpecialization.germ_smul N (U := W ⊓ V) (x := genericPoint C)
    hηWV u _).trans ?_
  congr 1
  exact N.presheaf.germ_res_apply _ _ _ _

end Transport

/-! ### The pull-back of `𝒪_X(D)` to an integral scheme -/

section Pullback

open MMP.CartierDivisorPullback

variable {X C : Scheme.{u}} [IsIntegral C] (ι : C ⟶ X) (D : X.CartierDivisor)
  (hD : ¬ Set.range ι ⊆ MMP.Intersection.cartierSupport D)

include hD in
/-- `ι^*𝒪_X(D)` is invertible. -/
theorem isInvertibleModule_pullback_sheaf :
    Stacks.Ample.IsInvertibleModule C
      ((Scheme.Modules.pullback ι).obj (MMP.CartierDivisor.sheaf D)) :=
  Stacks.UFDExtensionGlobal.isInvertible_of_iso (MMP.CartierDivisor.pullbackSheafIso ι D hD)
    ((Stacks.UFDExtensionGlobal.isInvertible_iff_isFiniteLocallyFreeOfRank_one _).2
      ((Scheme.Modules.isFiniteLocallyFreeOfRank_iff _ 1).2 inferInstance))

omit [IsIntegral C] in
/-- Outside `Supp D`, the divisor `D` has the local equation `1`. -/
theorem exists_isLocalEquationOn_one {D : X.CartierDivisor} {x : X}
    (hx : x ∉ MMP.Intersection.cartierSupport D) :
    ∃ V : X.Opens, x ∈ V ∧
      MMP.Intersection.IsLocalEquationOn D _ (1 : (X.totalQuotientSheaf.obj.obj (op V))ˣ) := by
  obtain ⟨V, hxV, -, hV⟩ :=
    (MMP.Intersection.notMem_cartierSupport_iff (U := ⊤) (x := x) trivial).mp hx
  refine ⟨V, hxV, ?_⟩
  have h0 := MMP.Intersection.cartierClass_map_units V 1
  rw [map_one] at h0
  exact h0.trans hV.symm

/-- The pull-back of the local equation `1` is the local equation `1`. -/
theorem isLocalEquationOn_pullback_one {V : X.Opens} (hηV : ι (genericPoint C) ∈ V)
    (h1 : MMP.Intersection.IsLocalEquationOn D _ (1 : (X.totalQuotientSheaf.obj.obj (op V))ˣ)) :
    MMP.Intersection.IsLocalEquationOn (MMP.CartierDivisor.pullback ι D hD) _
      (1 : (C.totalQuotientSheaf.obj.obj (op (ι ⁻¹ᵁ V)))ˣ) := by
  have := MMP.CartierDivisor.isLocalEquationOn_pullback ι D hD h1 hηV (a := 1) (by
    unfold IsGermUnit
    rw [Units.val_one, Units.val_one, map_one, map_one])
  simpa [ofFunctionField, pullbackGerm] using this

/-- A nonempty open of an integral scheme has a nonzero ring of sections of `𝒦`. -/
theorem nontrivial_totalQuotient {V : C.Opens} (hV : genericPoint C ∈ V) :
    Nontrivial (C.totalQuotientSheaf.obj.obj (op V)) := by
  have : Nonempty V := ⟨⟨_, hV⟩⟩
  exact (toK_injective V).nontrivial

/-- The generic germ of the local generator `1` of `ι^*𝒪_X(D)`, on the pull-back of an open
`V ∋ ι(η)` where `D` has the local equation `1`. -/
def genericOneSection {V : X.Opens} (hηV : ι (genericPoint C) ∈ V)
    (h1 : MMP.Intersection.IsLocalEquationOn D _ (1 : (X.totalQuotientSheaf.obj.obj (op V))ˣ)) :
    ((Scheme.Modules.pullback ι).obj (CartierDivisor.sheaf D)).presheaf.stalk (genericPoint C) :=
  ((Scheme.Modules.pullback ι).obj (CartierDivisor.sheaf D)).presheaf.germ (ι ⁻¹ᵁ V)
      (genericPoint C) hηV
    ((MMP.CartierDivisor.pullbackSheafIso ι D hD).hom.app (ι ⁻¹ᵁ V)
      (frameSection (isLocalEquationOn_pullback_one ι D hD hηV h1)))

/-- The generic germ of the generator `1` is nonzero. -/
theorem genericOneSection_ne_zero {V : X.Opens} (hηV : ι (genericPoint C) ∈ V)
    (h1 : MMP.Intersection.IsLocalEquationOn D _ (1 : (X.totalQuotientSheaf.obj.obj (op V))ˣ)) :
    genericOneSection ι D hD hηV h1 ≠ 0 := by
  intro h
  unfold genericOneSection at h
  have hg := isLocalEquationOn_pullback_one ι D hD hηV h1
  have h0 : ((Scheme.Modules.pullback ι).obj (CartierDivisor.sheaf D)).presheaf.germ (ι ⁻¹ᵁ V)
      (genericPoint C) hηV
        ((MMP.CartierDivisor.pullbackSheafIso ι D hD).hom.app _ (frameSection hg)) =
      ((Scheme.Modules.pullback ι).obj (CartierDivisor.sheaf D)).presheaf.germ (ι ⁻¹ᵁ V)
          (genericPoint C) hηV 0 := by
    rw [map_zero]; exact h
  obtain ⟨W', hηW', i₁, i₂, hW⟩ :=
    ((Scheme.Modules.pullback ι).obj (MMP.CartierDivisor.sheaf D)).presheaf.germ_eq _ hηV hηV _ _ h0
  rw [Subsingleton.elim i₂ i₁, Subsingleton.elim i₁ (homOfLE (leOfHom i₁)), map_zero,
    map_app_apply] at hW
  have h2 := congrArg ((MMP.CartierDivisor.pullbackSheafIso ι D hD).inv.app W') hW
  rw [app_inv_hom_apply, map_zero] at h2
  have h3 := congrArg sheafVal h2
  rw [sheafVal_map, sheafVal_frameSection, inv_one, Units.val_one, map_one] at h3
  have := nontrivial_totalQuotient (C := C) hηW'
  exact (one_ne_zero : (1 : C.totalQuotientSheaf.obj.obj (op W')) ≠ 0) h3

end Pullback

/-! ### Local multiplicities of the pulled-back divisor -/

section Multiplicity

open MMP.CartierDivisorPullback

variable {k : Type u} [Field k] {X C : Scheme.{u}} (sC : C ⟶ Spec (.of k))
  [MMP.Mori.IsCurve k sC] (ι : C ⟶ X) {D : X.CartierDivisor}
  (hD : ¬ Set.range ι ⊆ MMP.Intersection.cartierSupport D)

/-- **The local multiplicity of `ι^*𝒪_X(D)` at `p`.** If `d ∈ Γ(X, U)` is a local equation of
`D` on `U ∋ ι(p)`, then `e_p(s) = e_p(ι^*d)` for the generic germ `s` of the generator `1`, and
`ι^*d ≠ 0` in `k(C)`. -/
theorem sectionMult_genericOneSection {V : X.Opens} (hηV : ι (genericPoint C) ∈ V)
    (h1 : MMP.Intersection.IsLocalEquationOn D _ (1 : (X.totalQuotientSheaf.obj.obj (op V))ˣ))
    {p : C} {U : X.Opens} (hpU : ι p ∈ U) (d : Γ(X, U)) (hd : IsUnit (toK U d))
    (hloc : MMP.Intersection.IsLocalEquationOn D _ hd.unit) :
    algebraMap (C.presheaf.stalk p) C.functionField
        (ι.stalkMap p (X.presheaf.germ U (ι p) hpU d)) ≠ 0 ∧
      MMP.Resolution.sectionMult sC ((Scheme.Modules.pullback ι).obj (MMP.CartierDivisor.sheaf D))
          (genericOneSection ι D hD hηV h1) p =
        MMP.Resolution.eMultAt sC {p} (algebraMap (C.presheaf.stalk p) C.functionField
          (ι.stalkMap p (X.presheaf.germ U (ι p) hpU d))) := by
  have := isInvertibleModule_pullback_sheaf ι D hD
  have hηU : ι (genericPoint C) ∈ U := genericPoint_mem_of_mem (V := ι ⁻¹ᵁ U) hpU
  obtain ⟨a, ha⟩ := MMP.CartierDivisor.exists_isGermUnit_of_not_range_subset ι D hD hloc hηU
  have hf : MMP.Intersection.IsLocalEquationOn (MMP.CartierDivisor.pullback ι D hD) _
      (Units.map (functionFieldToK (ι ⁻¹ᵁ U)).toMonoidHom (pullbackGerm ι a)) :=
    MMP.CartierDivisor.isLocalEquationOn_pullback ι D hD hloc hηU ha
  have hg := isLocalEquationOn_pullback_one ι D hD hηV h1
  obtain ⟨u, hu1, hu2⟩ :=
    MMP.CartierDivisor.exists_transition (MMP.CartierDivisor.pullback ι D hD) hf hg
  -- the germ of `u` at the generic point is `ι^*d`
  have hηUV : genericPoint C ∈ ι ⁻¹ᵁ U ⊓ ι ⁻¹ᵁ V := ⟨hηU, hηV⟩
  have := nontrivial_totalQuotient hηUV
  have hgerm : C.presheaf.germ (ι ⁻¹ᵁ U ⊓ ι ⁻¹ᵁ V) (genericPoint C) hηUV u.val =
      algebraMap (C.presheaf.stalk p) C.functionField
        (ι.stalkMap p (X.presheaf.germ U (ι p) hpU d)) := by
    have e1 : toK (ι ⁻¹ᵁ U ⊓ ι ⁻¹ᵁ V) u.val = functionFieldToK (ι ⁻¹ᵁ U ⊓ ι ⁻¹ᵁ V)
        (C.presheaf.germ _ (genericPoint C) hηUV u.val) :=
      toTotalQuotient_eq_functionFieldToK u.val hηUV rfl
    rw [hu1] at e1
    have e2 : resK (inf_le_left : ι ⁻¹ᵁ U ⊓ ι ⁻¹ᵁ V ≤ ι ⁻¹ᵁ U)
        ((Units.map (functionFieldToK (ι ⁻¹ᵁ U)).toMonoidHom (pullbackGerm ι a) :
          (C.totalQuotientSheaf.obj.obj (op (ι ⁻¹ᵁ U)))ˣ) :
          C.totalQuotientSheaf.obj.obj (op (ι ⁻¹ᵁ U))) =
        functionFieldToK _ (pullbackGerm ι a).val :=
      MMP.CartierDivisor.resK_functionFieldToK _ _
    rw [e2, inv_one, Units.val_one, map_one, mul_one] at e1
    have e4 := (functionFieldToK (ι ⁻¹ᵁ U ⊓ ι ⁻¹ᵁ V)).injective e1
    rw [← e4]
    have ha' : a.val = X.presheaf.germ U (ι (genericPoint C)) hηU d := by
      apply stalkToTotalQuotient_injective X
      refine ha.trans ?_
      rw [IsUnit.unit_spec]
      exact (TopCat.Presheaf.stalkFunctor_map_germ_apply _ _ _ _ _).symm
    change ι.stalkMap (genericPoint C) a.val = _
    rw [ha', Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.germ_stalkMap_apply,
      RingHom.algebraMap_toAlgebra]
    exact (Stacks.ModuleStalkSpecialization.ringGerm_stalkSpecializes_apply _ _ _).symm
  refine ⟨hgerm ▸ (u.isUnit.map (C.presheaf.germ _ (genericPoint C) hηUV).hom).ne_zero, ?_⟩
  rw [← hgerm]
  exact sectionMult_germ_frameSection (MMP.CartierDivisor.pullbackSheafIso ι D hD) sC hf hg hηV hpU
    u.val u.isUnit hu2.symm

/-- At a closed point `p`, the multiplicity of a nonzero `b ∈ 𝒪_{C,p}` is
`e_p(b) = dim_k 𝒪_{C,p}/(b)`. -/
theorem eMultAt_algebraMap_eq_finrank (hC : Stacks.HProjective.IsQuasiProjective sC) {p : C}
    (hp : IsClosed ({p} : Set C)) {b : C.presheaf.stalk p} (hb : b ≠ 0) :
    MMP.Resolution.eMultAt sC {p} (algebraMap (C.presheaf.stalk p) C.functionField b) =
      letI := MMP.Mori.stalkAlgebra sC p
      (Module.finrank k (C.presheaf.stalk p ⧸ Ideal.span {b}) : ℤ) := by
  have hcurve : MMP.Mori.IsCurve k sC := inferInstance
  have : IsIntegral C := hcurve.toIsIntegral
  have hdim : topologicalKrullDim C = 1 := hcurve.topologicalKrullDim_eq_one
  have hpc : ∀ q ∈ ({p} : Finset C), IsClosed ({q} : Set C) := by
    intro q hq; rw [Finset.mem_singleton] at hq; subst hq; exact hp
  obtain ⟨-, -, hfr, -, -, hcol⟩ := MMP.Resolution.semilocalRing_properties sC hC hdim
    ({p} : Finset C) (Finset.singleton_nonempty p) hpc
  let := MMP.Mori.stalkAlgebra sC p
  let := MMP.Resolution.semilocalRingAlgebra sC ({p} : Finset C)
  let e := MMP.Resolution.stalkAlgEquivSemilocalRing sC p
  have heb : e b ∈ nonZeroDivisors (MMP.Resolution.semilocalRing ({p} : Finset C)) :=
    mem_nonZeroDivisors_of_ne_zero (by simpa using hb)
  have hkey : algebraMap (MMP.Resolution.semilocalRing ({p} : Finset C)) C.functionField (e b) =
      algebraMap (C.presheaf.stalk p) C.functionField b *
        algebraMap (MMP.Resolution.semilocalRing ({p} : Finset C)) C.functionField 1 := by
    rw [map_one, mul_one]; rfl
  rw [show MMP.Resolution.eMultAt sC {p} (algebraMap (C.presheaf.stalk p) C.functionField b) =
      MMP.Resolution.eMultFrac k C.functionField
        (algebraMap (C.presheaf.stalk p) C.functionField b)
        (R := MMP.Resolution.semilocalRing ({p} : Finset C)) from rfl,
    (MMP.Resolution.Kollar.eMultFrac_eq_of_eq_mul k C.functionField hcol heb
      (one_mem (nonZeroDivisors _))
      hkey).2]
  have h1 : MMP.Resolution.eMult k (1 : MMP.Resolution.semilocalRing ({p} : Finset C)) = 0 := by
    unfold MMP.Resolution.eMult
    rw [Ideal.span_singleton_one]
    exact Module.finrank_zero_of_subsingleton
  let q := Ideal.quotientEquivAlg (R₁ := k) (Ideal.span {b}) (Ideal.span {e b}) e
    (by rw [Ideal.map_span, Set.image_singleton]; rfl)
  have h2 : MMP.Resolution.eMult k (e b) =
      Module.finrank k (C.presheaf.stalk p ⧸ Ideal.span {b}) :=
    q.toLinearEquiv.finrank_eq.symm
  rw [h1, h2, Nat.cast_zero, sub_zero]

end Multiplicity

/-! ### The intersection number with an effective Cartier divisor -/

section Main

open CartierDivisor

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}

/-- A proper curve is a curve over `k`. -/
theorem isCurve_ι_comp (C : MMP.Mori.ProperCurve sX) : MMP.Mori.IsCurve k (C.ι ≫ sX) := by
  have : IsProper (C.ι ≫ sX) := inferInstance
  have : IsVariety k (C.ι ≫ sX) := by constructor
  exact (isCurve_iff k _).2 ⟨this, C.dim_eq⟩

/-- **The intersection number of a curve with a Cartier divisor is a sum of local
contributions.** Let `D` be a Cartier divisor on a `k`-scheme `X` and `C ⊆ X` an
integral projective curve with `C ⊄ Supp D`. For each point `P ∈ C ∩ Supp D` let `d_P ∈ Γ(X, U_P)`
be a local equation of `D` on an open `U_P ∋ P` (for `P ∉ Supp D` the choice of `d_P` is
arbitrary). Then
`(D · C) = ∑_{P ∈ C ∩ Supp D} dim_k 𝒪_{C,P}/(d_P|_C)`. -/
@[mmp "lem_kr2a_intersection_effective_divisor_local"]
theorem cartierCurveIntersection_eq_finsum_finrank (C : MMP.Mori.ProperCurve sX)
    (hCproj : IsProjectiveMorphism (C.ι ≫ sX)) (D : X.CartierDivisor)
    (hD : ¬ Set.range C.ι ⊆ MMP.Intersection.cartierSupport D) (U : C.scheme → X.Opens)
    (hU : ∀ p, C.ι p ∈ U p) (d : ∀ p, Γ(X, U p))
    (hd : ∀ p, C.ι p ∈ MMP.Intersection.cartierSupport D →
      MMP.CartierDivisor.IsRegularLocalEquation D (d p)) :
    MMP.Resolution.cartierCurveIntersection D C =
      ∑ᶠ (p : C.scheme) (_ : C.ι p ∈ MMP.Intersection.cartierSupport D),
        letI := MMP.Mori.stalkAlgebra (C.ι ≫ sX) p
        (Module.finrank k (C.scheme.presheaf.stalk p ⧸
          Ideal.span {C.ι.stalkMap p (X.presheaf.germ (U p) (C.ι p) (hU p) (d p))}) : ℤ) := by
  classical
  set sC := C.ι ≫ sX
  have hcurve : MMP.Mori.IsCurve k sC := isCurve_ι_comp C
  have : IsProjectiveVariety k sC := (isProjectiveVariety_iff k sC).2 ⟨hcurve.toIsVariety, hCproj⟩
  have hdim : topologicalKrullDim C.scheme = 1 := hcurve.topologicalKrullDim_eq_one
  have hqp : Stacks.HProjective.IsQuasiProjective sC :=
    (isQuasiProjective_iff_hProjectiveIsQuasiProjective sC).mp hCproj.isQuasiProjective
  have := isInvertibleModule_pullback_sheaf C.ι D hD
  have hη : C.ι (genericPoint C.scheme) ∉ MMP.Intersection.cartierSupport D :=
    (MMP.CartierDivisor.genericPoint_notMem_cartierSupport_iff C.ι D).2 hD
  obtain ⟨V, hηV, h1⟩ := exists_isLocalEquationOn_one hη
  have hs := genericOneSection_ne_zero C.ι D hD hηV h1
  have hpt : ∀ p : C.scheme, (∑ᶠ (_ : C.ι p ∈ MMP.Intersection.cartierSupport D),
      letI := MMP.Mori.stalkAlgebra (C.ι ≫ sX) p
      (Module.finrank k (C.scheme.presheaf.stalk p ⧸
        Ideal.span {C.ι.stalkMap p (X.presheaf.germ (U p) (C.ι p) (hU p) (d p))}) : ℤ)) =
      if IsClosed ({p} : Set C.scheme) then
        MMP.Resolution.sectionMult sC ((Scheme.Modules.pullback C.ι).obj (CartierDivisor.sheaf D))
          (genericOneSection C.ι D hD hηV h1) p else 0 := by
    intro p
    rw [finsum_eq_if]
    by_cases hps : C.ι p ∈ MMP.Intersection.cartierSupport D
    · have hpη : p ≠ genericPoint C.scheme := fun h => hη (h ▸ hps)
      have hpc := Stacks.AlgebraicGeometry.AmpleDimensionOne.isClosed_singleton_of_ne_genericPoint
        C.scheme hdim hpη
      obtain ⟨hu, hloc⟩ := hd p hps
      obtain ⟨hne, hmult⟩ := sectionMult_genericOneSection sC C.ι hD hηV h1 (hU p) (d p) hu hloc
      simp only [hps, hpc, ↓reduceIte]
      rw [hmult, eMultAt_algebraMap_eq_finrank sC hqp hpc (fun h0 => hne (by rw [h0, map_zero]))]
    · simp only [hps, ↓reduceIte]
      split_ifs with hpc
      · obtain ⟨W, hW, hW1⟩ := exists_isLocalEquationOn_one hps
        have hu : IsUnit (toK W (1 : Γ(X, W))) := by rw [map_one]; exact isUnit_one
        have hloc : MMP.Intersection.IsLocalEquationOn D _ hu.unit := by
          have : hu.unit = 1 := Units.ext (by rw [IsUnit.unit_spec, map_one]; rfl)
          rw [this]; exact hW1
        obtain ⟨-, hmult⟩ := sectionMult_genericOneSection sC C.ι hD hηV h1 hW 1 hu hloc
        have h11 : C.ι.stalkMap p (X.presheaf.germ W (C.ι p) hW (1 : Γ(X, W))) = 1 := by
          rw [map_one, map_one]
        rw [hmult, h11, eMultAt_algebraMap_eq_finrank sC hqp hpc one_ne_zero,
          Ideal.span_singleton_one]
        let := MMP.Mori.stalkAlgebra sC p
        rw [Module.finrank_zero_of_subsingleton, Nat.cast_zero]
      · rfl
  unfold MMP.Resolution.cartierCurveIntersection MMP.Resolution.lineBundleCurveIntersection
    MMP.Resolution.degree
  have hex : ∃ s : ((Scheme.Modules.pullback C.ι).obj (MMP.CartierDivisor.sheaf D)).presheaf.stalk
      (genericPoint C.scheme), s ≠ 0 := ⟨_, hs⟩
  simp only [hex, ↓reduceDIte]
  rw [MMP.Resolution.degreeWRT_eq sC _ hex.choose_spec hs]
  have hfin := MMP.Resolution.finite_sectionMult_ne_zero sC _ _ hs
  unfold MMP.Resolution.degreeWRT
  simp only [hfin, ↓reduceDIte]
  rw [finsum_congr hpt, finsum_eq_sum_of_support_subset _ (s := hfin.toFinset)]
  · refine Finset.sum_congr rfl fun p hp => ?_
    simp only [((hfin.mem_toFinset).1 hp).1, ↓reduceIte]
  · intro p hp
    rw [Function.mem_support] at hp
    split_ifs at hp with hpc
    · exact hfin.mem_toFinset.2 ⟨hpc, hp⟩
    · exact absurd rfl hp

/-- The `k`-algebra structures of the local rings are compatible with the map of stalks of a
morphism of `k`-schemes. -/
theorem stalkMap_algebraMap {Y : Scheme.{u}} (g : Y ⟶ X) (y : Y) (c : k) :
    letI := MMP.Mori.stalkAlgebra sX (g y)
    letI := MMP.Mori.stalkAlgebra (g ≫ sX) y
    g.stalkMap y (algebraMap k (X.presheaf.stalk (g y)) c) =
      algebraMap k (Y.presheaf.stalk y) c := by
  change g.stalkMap y (X.presheaf.germ ⊤ (g y) _ (sX.appTop ((Scheme.ΓSpecIso (.of k)).inv c))) =
    Y.presheaf.germ ⊤ y _ ((g ≫ sX).appTop ((Scheme.ΓSpecIso (.of k)).inv c))
  rw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.comp_appTop]
  rfl

/-- **The summand is the local intersection number.** Let `P = ι(p)` be a point of the curve
`C ⊆ X`, `I ⊆ 𝒪_X` an ideal sheaf (the ideal of `D`) with local generator `d` at `P`. Then
`dim_k 𝒪_{C,P}/(d|_C) = (C · D)_P = dim_k 𝒪_{X,P}/(I_{C,P} + I_P)`. -/
theorem rank_quotient_stalk_eq_localIntersectionNumber (C : MMP.Mori.ProperCurve sX)
    {p : C.scheme} {U : X.Opens} (hpU : C.ι p ∈ U) (d : Γ(X, U)) (I : X.IdealSheafData)
    (hI : IdealSheafData.stalk I (C.ι p) = Ideal.span {X.presheaf.germ U (C.ι p) hpU d}) :
    (letI := MMP.Mori.stalkAlgebra (C.ι ≫ sX) p; Module.rank k (C.scheme.presheaf.stalk p ⧸
        Ideal.span {C.ι.stalkMap p (X.presheaf.germ U (C.ι p) hpU d)})).toENat =
      MMP.Resolution.localIntersectionNumber sX
        (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X))) I (C.ι p) := by
  unfold MMP.Resolution.localIntersectionNumber
  let := MMP.Mori.stalkAlgebra (C.ι ≫ sX) p
  let := MMP.Mori.stalkAlgebra sX (C.ι p)
  set g := X.presheaf.germ U (C.ι p) hpU d
  set φ := (C.ι.stalkMap p).hom
  have hsurj : Function.Surjective φ := C.ι.stalkMap_surjective p
  have hker : RingHom.ker φ = IdealSheafData.stalk
      (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X))) (C.ι p) :=
    Stacks.Chow.ker_stalkMap_subschemeι_eq_stalk _ p
  let ψ := (Ideal.Quotient.mk (Ideal.span {φ g})).comp φ
  have hψ : Function.Surjective ψ := Ideal.Quotient.mk_surjective.comp hsurj
  have hkerψ : RingHom.ker ψ = IdealSheafData.stalk
      (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X))) (C.ι p) ⊔
        IdealSheafData.stalk I (C.ι p) := by
    rw [hI, ← hker, sup_comm]
    change Ideal.comap φ (RingHom.ker (Ideal.Quotient.mk (Ideal.span {φ g}))) = _
    rw [Ideal.mk_ker, ← Set.image_singleton, ← Ideal.map_span,
      Ideal.comap_map_of_surjective _ hsurj]
    rfl
  let e : (X.presheaf.stalk (C.ι p) ⧸ (IdealSheafData.stalk
      (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X))) (C.ι p) ⊔
        IdealSheafData.stalk I (C.ι p))) ≃+*
      (C.scheme.presheaf.stalk p ⧸ Ideal.span {φ g}) :=
    (Ideal.quotEquivOfEq hkerψ.symm).trans (RingHom.quotientKerEquivOfSurjective hψ)
  have he : ∀ c : k, e (algebraMap k _ c) = algebraMap k _ c := by
    intro c
    change ψ (algebraMap k (X.presheaf.stalk (C.ι p)) c) = _
    change Ideal.Quotient.mk _ (φ (algebraMap k (X.presheaf.stalk (C.ι p)) c)) = _
    rw [stalkMap_algebraMap]
    rfl
  let eₗ : (X.presheaf.stalk (C.ι p) ⧸ (IdealSheafData.stalk
      (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X))) (C.ι p) ⊔
        IdealSheafData.stalk I (C.ι p))) ≃ₗ[k]
      (C.scheme.presheaf.stalk p ⧸ Ideal.span {φ g}) :=
    { e with
      map_smul' := fun c x => by
        rw [Algebra.smul_def, Algebra.smul_def]
        exact (map_mul e _ _).trans (by rw [he]; rfl) }
  rw [eₗ.rank_eq]

/-- **The summand is the local intersection number with the subscheme of `D`.** If `D` is
effective and `d` a local equation of `D` in `𝒪_X` on `U ∋ P = ι(p)`, then
`dim_k 𝒪_{C,P}/(d|_C) = (C · D)_P`, the local intersection number of `C` with the closed
subscheme of `D`. -/
@[mmp "lem_kr2a_intersection_effective_divisor_local"]
theorem rank_quotient_stalk_eq_localIntersectionNumber_subscheme (C : MMP.Mori.ProperCurve sX)
    {D : X.CartierDivisor} (hDeff : MMP.Intersection.IsEffective D) {p : C.scheme} {U : X.Opens}
    (hpU : C.ι p ∈ U) {d : Γ(X, U)} (hd : MMP.CartierDivisor.IsRegularLocalEquation D d) :
    (letI := MMP.Mori.stalkAlgebra (C.ι ≫ sX) p; Module.rank k (C.scheme.presheaf.stalk p ⧸
        Ideal.span {C.ι.stalkMap p (X.presheaf.germ U (C.ι p) hpU d)})).toENat =
      MMP.Resolution.localIntersectionNumber sX
        (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X)))
        (MMP.CartierDivisor.subscheme D hDeff) (C.ι p) := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hpV, hVU⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hpU U.isOpen
  have hd' := hd.res hVU
  have hgerm : X.presheaf.germ V (C.ι p) hpV ((X.presheaf.map (homOfLE hVU).op).hom d) =
      X.presheaf.germ U (C.ι p) hpU d := X.presheaf.germ_res_apply _ _ _ _
  have hI : IdealSheafData.stalk (MMP.CartierDivisor.subscheme D hDeff) (C.ι p) =
      Ideal.span {X.presheaf.germ V (C.ι p) hpV ((X.presheaf.map (homOfLE hVU).op).hom d)} := by
    rw [IdealSheafData.stalk_eq_map_germ _ _ ⟨V, hV⟩ hpV,
      MMP.CartierDivisor.ideal_subscheme_affine hDeff (U := ⟨V, hV⟩) hd', Ideal.map_span,
      Set.image_singleton]
    rfl
  rw [← rank_quotient_stalk_eq_localIntersectionNumber C hpV _ _ hI, hgerm]

end Main

end MMP.Threefold.Resolution
