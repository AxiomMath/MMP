module

public import Mathlib
public import MMP.Attr
public import MMP.AlgebraicGeometry.Intersection.ConeOfCurves.Relative
import MMP.AlgebraicGeometry.Intersection.ConeOfCurves.RelativeConeInAbsolute
import MMP.AlgebraicGeometry.Intersection.CurveClassesFiniteDim
import MMP.AlgebraicGeometry.MMP.ConeTheorem.SupportingDivisorStein
import MMP.AlgebraicGeometry.MMP.Flip.SmallAmpleModel
import MMP.Analysis.Convex.Cone.ExtremalRays

/-!
# The relative closed cone of curves is generated by its extremal rays

Let `f : X ⟶ S` be a morphism of projective varieties over an algebraically closed field `k` of
characteristic zero. Every class `z` in the relative closed cone of curves `NE(X/S)‾ ⊆ N₁(X/S)` is
a finite sum `z = e₁ + ⋯ + eₛ` (`s ≥ 0`) of elements `eᵢ ∈ Rᵢ` of extremal rays `Rᵢ` of
`NE(X/S)‾`.

The relative closed cone is a closed convex cone in the finite-dimensional space `N₁(X/S)`, which
embeds in `N₁(X)`. Its image lies in `NE(X)‾`, which contains no line, so
`NE(X/S)‾ ∩ (-NE(X/S)‾) = {0}`. A closed convex cone with this property in a finite-dimensional
real vector space is spanned by its extremal rays.

## Main results

* `MMP.Mori.exists_sum_mem_isExtremalRay_relativeClosedConeOfCurves`: every element of
  `NE(X/S)‾` is a finite sum of elements of extremal rays of `NE(X/S)‾`.

## References

* [KM98] J. Kollár, S. Mori, *Birational geometry of algebraic varieties*, proofs of 3.31 and 3.47.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

namespace MMP.Mori

section Topology

variable {k : Type} [Field k] {X S : Scheme.{0}} (sX : X ⟶ Spec (.of k)) (f : X ⟶ S)

/-- A nonzero class of `N₁(X/S)` has nonzero degree against some invertible sheaf. -/
private lemma exists_degree_ne_zero {z : RelativeNumericalCurveClasses sX f} (hz : z ≠ 0) :
    ∃ (L : X.Modules) (_ : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L),
      RelativeNumericalCurveClasses.degree sX f L z ≠ 0 := by
  obtain ⟨Z, rfl⟩ := relativeNumericalClass_surjective sX f z
  by_contra! h
  exact hz <| (Submodule.Quotient.mk_eq_zero _).mpr
    (OneCycle.mem_numericallyTrivial.mpr fun L _ => h L inferInstance)

private lemma injective_relativeToAbsolute : Function.Injective (relativeToAbsolute sX f) :=
  (existsUnique_isNaturalRelativeMap_and_injective sX f).2 _
    (isNaturalRelativeMap_relativeToAbsolute sX f)

private lemma isTopologicalAddGroup_relative :
    IsTopologicalAddGroup (RelativeNumericalCurveClasses sX f) :=
  topologicalAddGroup_iInf fun _ => topologicalAddGroup_iInf fun _ =>
    topologicalAddGroup_induced _

private lemma continuousSMul_relative : ContinuousSMul ℝ (RelativeNumericalCurveClasses sX f) :=
  continuousSMul_iInf fun _ => continuousSMul_iInf fun _ => continuousSMul_induced _

/-- `N₁(X/S)` is Hausdorff, the degree forms separating its points. -/
private lemma t2Space_relative : T2Space (RelativeNumericalCurveClasses sX f) := by
  refine ⟨fun x y hxy => ?_⟩
  obtain ⟨L, _, hL⟩ := exists_degree_ne_zero sX f (sub_ne_zero.mpr hxy)
  rw [map_sub, sub_ne_zero] at hL
  exact separated_by_continuous (RelativeNumericalCurveClasses.continuous_degree sX f L) hL

end Topology

attribute [local instance] isTopologicalAddGroup_relative continuousSMul_relative t2Space_relative

/-- The relative closed cone of curves contains no line: `NE(X/S)‾ ∩ (-NE(X/S)‾) = {0}`, because
`N₁(X/S) → N₁(X)` is injective and carries `NE(X/S)‾` into `NE(X)‾`, which contains no line. -/
private lemma relativeClosedConeOfCurves_inter_neg_eq_singleton_zero
    {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X S : Scheme.{0}} (sX : X ⟶ Spec (.of k))
    (sS : S ⟶ Spec (.of k)) [IsProjectiveVariety k sX] [IsProjectiveVariety k sS] (f : X ⟶ S)
    (hf : f ≫ sS = sX) :
    (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f)) ∩
      -(relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f)) = {0} := by
  have hmem : ∀ v ∈ relativeClosedConeOfCurves sX f,
      relativeToAbsolute sX f v ∈ closedConeOfCurves sX := fun v hv =>
    ((image_relativeClosedConeOfCurves_eq_inter_range sX sS f hf).subset ⟨v, hv, rfl⟩).1
  refine Set.Subset.antisymm (fun v ⟨hv, hnv⟩ => ?_) ?_
  · have h0 : relativeToAbsolute sX f v ∈ (closedConeOfCurves sX).lineal :=
      PointedCone.mem_lineal.2 ⟨hmem v hv, by simpa using hmem (-v) hnv⟩
    rw [lineal_closedConeOfCurves_eq_bot, Submodule.mem_bot] at h0
    exact injective_relativeToAbsolute sX f (h0.trans (map_zero _).symm)
  · rintro _ rfl
    exact ⟨zero_mem _, by simp⟩

/-- For a morphism `f : X ⟶ S` of projective varieties over an algebraically closed field of
characteristic zero, every class `z` in the relative closed cone of curves
`relativeClosedConeOfCurves sX f` is a finite sum `∑ i, w i` of elements `w i ∈ R i` of extremal
rays `R i` of that cone. -/
@[mmp "lem_km3c_relative_cone_sum_of_extremal_rays"]
public theorem exists_sum_mem_isExtremalRay_relativeClosedConeOfCurves
    {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X S : Scheme.{0}} (sX : X ⟶ Spec (.of k))
    (sS : S ⟶ Spec (.of k)) [IsProjectiveVariety k sX] [IsProjectiveVariety k sS] (f : X ⟶ S)
    (hf : f ≫ sS = sX) {z : RelativeNumericalCurveClasses sX f}
    (hz : z ∈ relativeClosedConeOfCurves sX f) :
    ∃ (s : ℕ) (R : Fin s → Set (RelativeNumericalCurveClasses sX f))
      (w : Fin s → RelativeNumericalCurveClasses sX f),
      (∀ i, IsExtremalRay ℝ (relativeClosedConeOfCurves sX f :
          Set (RelativeNumericalCurveClasses sX f)) (R i) ∧ w i ∈ R i) ∧
        z = ∑ i, w i := by
  have : IsVariety k sX := ‹IsProjectiveVariety k sX›.toIsVariety
  have := finiteDimensional_numericalCurveClasses sX
  have : FiniteDimensional ℝ (RelativeNumericalCurveClasses sX f) :=
    .of_injective _ (injective_relativeToAbsolute sX f)
  exact MMP.Positivity.exists_sum_mem_isExtremalRay (isCone_coe _)
    (relativeClosedConeOfCurves sX f).convex isClosed_closure
    (relativeClosedConeOfCurves_inter_neg_eq_singleton_zero sX sS f hf) hz

end MMP.Mori
