/-!
# Twist flatness, and the difference of Euler characteristics under a twist

Let `X` be a proper scheme of dimension at most one over a field `k`, `φ : X ⟶ Y` a morphism of
`k`-schemes, `L` an invertible module on `Y` and `F` an invertible module on `X`. Then
`χ(X, F ⊗ φ^*L) - χ(X, F)` is the degree of `L` on the push-forward of the fundamental 1-cycle of
`X`, the sum of the proper-curve components weighted by the lengths of the local rings at their
generic points; zero-dimensional and embedded components contribute nothing. If both twists have
no higher cohomology this is a difference of dimensions of spaces of global sections.

## Main results

* `MMP.Chow.eulerCharacteristic_tensorModules_sub_eq_finsum`: the same identity as a sum over the
  one-dimensional irreducible components, with the component degrees of `L`.
* `MMP.Chow.eulerCharacteristic_tensorModules_sub_eq_degree_fundamentalCycle`: the identity in
  terms of `MMP.Mori.OneCycle.degree` and `MMP.Mori.cyclePushforwardOfPoint`.
* `MMP.Chow.finrank_sub_finrank_eq_degree_fundamentalCycle`: the form with `h⁰`.
* `MMP.Chow.isFlatOver_tensorModules_tensorPowModule`: flatness over the base of twists of
  invertible modules, as the uniform direct image theorem of `MMP.Chow.UniformDirectImage` needs.

## Implementation notes

The identity is the dévissage argument of the component formula of `Stacks.AlgebraicGeometry.
ComponentDegrees.curveDegree_eq_finsum_componentDegree_of_isProper`, run on `F` in place of the
structure sheaf; the weights are the stalk lengths of `F`, which for an invertible module equal
those of `𝒪_X`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Stacks.Ample
open Stacks.RelativeVeryAmple (tensorModules)
open Stacks.AlgebraicGeometry.ComponentDegrees

universe u

namespace MMP.Chow

/-- A tensor product of two invertible modules on a scheme flat over a base is flat over it. -/
public theorem isFlatOver_tensorModules_of_isInvertibleModule {X S : Scheme.{u}} (f : X ⟶ S)
    [Flat f] (F L : X.Modules) [IsInvertibleModule X F] [IsInvertibleModule X L] :
    IsFlatOver f.toLRSHom.toShHom (tensorModules X F L) := by
  haveI : IsInvertibleModule X (tensorModules X F L) :=
    Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules X F L
  have : (tensorModules X F L).IsQuasicoherent :=
    Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule _
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank (R := X.ringCatSheaf)
      (tensorModules X F L) 1 :=
    Stacks.SheafRankOne.isFiniteLocallyFreeOfRank_one_of_isInvertible_scheme X _
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree (R := X.ringCatSheaf)
      (tensorModules X F L) :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree _ 1
  exact AlgebraicGeometry.VectorBundleCodimensionOne.isFlatOver_of_isFiniteLocallyFree f _

/-- A module generated by a single element with trivial annihilator has the length of the ring. -/
public theorem length_eq_length_self_of_generator {R M : Type*} [Ring R] [AddCommGroup M]
    [Module R M] (g : M) (h1 : ∀ z : M, ∃ r : R, z = r • g) (h2 : ∀ r : R, r • g = 0 → r = 0) :
    Module.length R M = Module.length R R := by
  refine (LinearEquiv.ofBijective (LinearMap.toSpanSingleton R M g) ⟨fun a b hab => ?_,
    fun z => (h1 z).imp fun _ hr => hr.symm⟩).length_eq.symm
  exact sub_eq_zero.mp (h2 _ ((sub_smul a b g).trans (sub_eq_zero.mpr hab)))

/-- The stalk length of an invertible module at a point is the length of the local ring there. -/
public theorem stalkLength_eq_length_of_isInvertibleModule {X : Scheme.{u}} (F : X.Modules)
    [IsInvertibleModule X F] (x : X) :
    stalkLength F x = Module.length (X.presheaf.stalk x) (X.presheaf.stalk x) := by
  obtain ⟨g, hg1, hg2⟩ := Stacks.StalkOrder.exists_generator F x
  exact (stalkLength_eq_length_flatStalk F x).trans
    (@length_eq_length_self_of_generator (X.presheaf.stalk x)
      (Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X.toRingedSpace F.val x) _ _
      (Stacks.SheafOfModules.FlatShortExact.stalkModule (X := X.toRingedSpace) F x) g hg1 hg2)

/-- The quantity `χ(P ⊗ E) − n χ(P)` of a coherent module whose generic stalk lengths are `m ξ`
is the `m`-weighted sum of the component degrees of `E`. -/
public theorem eulerCharacteristicTensorSheafSub_eq_finsum_of_stalkLength (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f] (hX : topologicalKrullDim X ≤ 1)
    (E : X.Modules) (hE : _root_.SheafOfModules.IsCoherent E) (rank : ℕ)
    [_root_.AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E rank]
    (P : X.Modules) (hP : _root_.SheafOfModules.IsCoherent P)
    (m : genericPointsOne X → ℕ)
    (hm : ∀ ξ : genericPointsOne X, stalkLength P ξ.1 = (m ξ : ℕ∞)) :
    _root_.AlgebraicGeometry.eulerCharacteristicTensorSheafSub k f E hE rank P hP =
      ∑ᶠ ξ : genericPointsOne X, (m ξ : ℤ) * componentDegree k f hX E rank ξ := by
  classical
  haveI : IsNoetherian X := isNoetherian_of_isProper_over_field k f
  haveI : IsLocallyNoetherian X := AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian f
  have h02O6 :=
    _root_.AlgebraicGeometry.forall_finiteDimensional_cohomologyOverField_of_isProper k f
  haveI := hP
  obtain ⟨n, G, hG, hbot, htop, hcoh, hquot⟩ :=
    Stacks.AlgebraicGeometry.CoherentDevissage.exists_filtration_by_integral_ideal_pushforwards X P
  have hq : ∀ j : Fin n,
      _root_.SheafOfModules.IsCoherent (filtrationQuotient G hG j) := by
    intro j
    haveI := hcoh j.castSucc
    haveI := hcoh j.succ
    exact _root_.SheafOfModules.cokernel_isCoherent _
  have hstep2 := eulerCharacteristicTensorSheafSub_eq_sum_of_subobject_filtration
    k f E hE rank h02O6 P hP G hG hbot htop hcoh hq
  have hlayer : ∀ j : Fin n,
      _root_.AlgebraicGeometry.eulerCharacteristicTensorSheafSub k f E hE rank
          (filtrationQuotient G hG j) (hq j) =
        ∑ᶠ ξ : genericPointsOne X,
          ((stalkLength (filtrationQuotient G hG j) ξ.1).toNat : ℤ) *
            componentDegree k f hX E rank ξ := by
    intro j
    obtain ⟨Z, i, hi, hZint, I, hIcoh, _, ⟨e⟩⟩ := hquot j
    haveI := hi
    haveI := hZint
    haveI := hIcoh
    have hpush : _root_.SheafOfModules.IsCoherent
        ((Scheme.Modules.pushforward i).obj I.toSheafOfModules) :=
      _root_.AlgebraicGeometry.isCoherent_pushforward_of_isClosedImmersion i _
    rw [eulerCharacteristicTensorSheafSub_eq_of_iso k f E hE rank (hq j) hpush e,
      eulerCharacteristicTensorSheafSub_pushforward_eq_finsum k f hX E hE rank i
        I.toSheafOfModules hIcoh hpush]
    exact finsum_congr fun ξ => by rw [stalkLength_of_iso e ξ.1]
  haveI : Finite (genericPointsOne X) := (finite_genericPointsOne X).to_subtype
  letI : Fintype (genericPointsOne X) := Fintype.ofFinite _
  rw [hstep2]
  simp only [hlayer, finsum_eq_sum_of_fintype]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ξ _ => ?_
  rw [← Finset.sum_mul]
  congr 1
  exact (sum_toNat_of_sum_eq_coe _ _
    ((hm ξ).symm.trans
      (stalkLength_eq_sum_of_subobject_filtration P G hG hbot htop ξ.1))).symm

/-- For invertible modules `F` and `H` on a proper `k`-scheme of dimension at most one,
`χ(F ⊗ H) - χ(F)` is the sum of the component degrees of `H` weighted by the multiplicities. -/
public theorem eulerCharacteristic_tensorModules_sub_eq_finsum (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f] (hX : topologicalKrullDim X ≤ 1)
    (F H : X.Modules) [IsInvertibleModule X F] [IsInvertibleModule X H]
    [F.IsCoherent] [(tensorModules X F H).IsCoherent] :
    eulerCharacteristic k f (tensorModules X F H) - eulerCharacteristic k f F =
      ∑ᶠ ξ : genericPointsOne X, (componentMultiplicity X ξ : ℤ) *
        componentDegree k f hX H 1 ξ := by
  haveI : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} H 1 :=
    Stacks.SheafRankOne.isFiniteLocallyFreeOfRank_one_of_isInvertible_scheme X H
  haveI : H.IsCoherent := AlgebraicGeometry.SheafOfModules.isCoherent_of_isInvertible k f H
  have h := eulerCharacteristicTensorSheafSub_eq_finsum_of_stalkLength k f hX H inferInstance 1 F
    inferInstance (fun ξ => componentMultiplicity X ξ) (fun ξ => by
      rw [stalkLength_eq_length_of_isInvertibleModule F ξ.1, ← stalkLength_unit ξ.1]
      exact stalkLength_unit_eq_componentMultiplicity k f ξ)
  rw [← h]
  simp only [AlgebraicGeometry.eulerCharacteristicTensorSheafSub, Nat.cast_one, one_mul]

/-- Twists of finitely many invertible modules by powers of an invertible module `L` are flat over
the base of a flat morphism: the spelling of the flatness hypothesis of
`MMP.Chow.exists_forall_isZero_higherDirectImage_and_isFiniteLocallyFree_and_isIso_baseChange`. -/
public theorem isFlatOver_tensorModules_tensorPowModule {X S : Scheme.{u}} (f : X ⟶ S) [Flat f]
    {ι : Type*} (F : ι → X.Modules) [∀ j, IsInvertibleModule X (F j)]
    (L : X.Modules) [IsInvertibleModule X L] (j : ι) (n : ℕ) :
    IsFlatOver f.toLRSHom.toShHom (tensorModules X (F j) (tensorPowModule X L (n : ℤ))) :=
  haveI : IsInvertibleModule X (tensorPowModule X L (n : ℤ)) :=
    isInvertibleModule_tensorPowModule X L (n : ℤ)
  isFlatOver_tensorModules_of_isInvertibleModule f (F j) _

section Cycle

open MMP.Mori TopologicalSpace

/-- The closure of a point is homeomorphic to the closed subscheme it carries, so the two have the
same Krull dimension. -/
theorem topologicalKrullDim_curveSubschemeAt_eq {X : Scheme.{u}} (x : X) :
    topologicalKrullDim (curveSubschemeAt x) = topologicalKrullDim (closure ({x} : Set X)) := by
  let I : X.IdealSheafData :=
    Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x} : Set X))
  exact IsHomeomorph.topologicalKrullDim_eq _
    ((IsPreimmersion.isEmbedding I.subschemeι).toHomeomorph.trans
      (Homeomorph.setCongr (I.range_subschemeι.trans rfl))).isHomeomorph

variable {k : Type u} [Field k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)}

/-- The degree of an invertible module on the push-forward of a proper curve is the degree of its
pull-back, with integer coefficients. -/
theorem degree_cyclePushforwardOfPoint_eq [IsSeparated sY] [LocallyOfFiniteType sY]
    (φ : X ⟶ Y) (hφ : φ ≫ sY = sX) (C : ProperCurve sX) (L : Y.Modules)
    [SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2 L] :
    OneCycle.degree ℤ sY L (cyclePushforwardOfPoint ℤ sY φ C.point) =
      C.degree k ((Scheme.Modules.pullback φ).obj L) := by
  refine Int.cast_injective (α := ℝ) ?_
  rw [← C.degree_pushforward_eq_degree_pullback φ hφ L]
  by_cases h : IsProperCurve sY (φ C.point)
  · simp [cyclePushforwardOfPoint, h, OneCycle.degree]
  · simp [cyclePushforwardOfPoint, h]

/-- **`χ(F ⊗ φ^*L) - χ(F)` is the degree of `L` on the push-forward of the fundamental 1-cycle.**
Let `X` be a proper `k`-scheme of dimension at most one, `φ : X ⟶ Y` a `k`-morphism to a separated
`k`-scheme locally of finite type, `L` an invertible module on `Y` and `F` an invertible module on
`X`. The fundamental 1-cycle of `X` is `∑ m_C [C]`, over the proper curves `C ⊆ X` which are
irreducible components, with `m_C` the length of `𝒪_{X,C}`; zero-dimensional and embedded
components do not occur. Its push-forward under `φ` has degree
`χ(X, F ⊗ φ^*L) - χ(X, F)` against `L`. -/
public theorem eulerCharacteristic_tensorModules_sub_eq_degree_fundamentalCycle
    [IsProper sX] [IsSeparated sY] [LocallyOfFiniteType sY]
    (hX : topologicalKrullDim X ≤ 1) (φ : X ⟶ Y) (hφ : φ ≫ sY = sX)
    (L : Y.Modules) [SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2 L]
    (F : X.Modules) [IsInvertibleModule X F] [F.IsCoherent]
    [(tensorModules X F ((Scheme.Modules.pullback φ).obj L)).IsCoherent] :
    eulerCharacteristic k sX (tensorModules X F ((Scheme.Modules.pullback φ).obj L)) -
        eulerCharacteristic k sX F =
      OneCycle.degree ℤ sY L
        (∑ᶠ C : {C : ProperCurve sX // closure ({C.point} : Set X) ∈ irreducibleComponents X},
          ((Module.length (X.presheaf.stalk C.1.point) (X.presheaf.stalk C.1.point)).toNat : ℤ) •
            cyclePushforwardOfPoint ℤ sY φ C.1.point) := by
  classical
  haveI : IsInvertibleModule X ((Scheme.Modules.pullback φ).obj L) :=
    inferInstanceAs (SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2
      ((Scheme.Modules.pullback φ).obj L))
  rw [eulerCharacteristic_tensorModules_sub_eq_finsum k sX hX F]
  have hmem : ∀ ξ : genericPointsOne X, IsProperCurve sX ξ.1 := fun ξ =>
    isProperCurve_of_isProper sX
      ((topologicalKrullDim_curveSubschemeAt_eq ξ.1).trans (mem_genericPointsOne_iff.mp ξ.2).2)
  let e : genericPointsOne X →
      {C : ProperCurve sX // closure ({C.point} : Set X) ∈ irreducibleComponents X} :=
    fun ξ => ⟨⟨ξ.1, hmem ξ⟩, (mem_genericPointsOne_iff.mp ξ.2).1⟩
  have he : Function.Bijective e := by
    refine ⟨fun a b hab => Subtype.ext (congrArg (fun C => C.1.point) hab), fun C => ?_⟩
    refine ⟨⟨C.1.point, mem_genericPointsOne_iff.mpr ⟨C.2, ?_⟩⟩, Subtype.ext (ProperCurve.ext rfl)⟩
    exact (topologicalKrullDim_curveSubschemeAt_eq C.1.point).symm.trans C.1.dim_eq
  haveI : Finite (genericPointsOne X) :=
    (finite_genericPointsOne_of_isProper k sX).to_subtype
  letI : Fintype (genericPointsOne X) := Fintype.ofFinite _
  rw [← finsum_comp e he, finsum_eq_sum_of_fintype, finsum_eq_sum_of_fintype, map_sum]
  refine Finset.sum_congr rfl fun ξ _ => ?_
  rw [map_zsmul, degree_cyclePushforwardOfPoint_eq φ hφ (e ξ).1 L]
  have hd : componentDegree k sX hX ((Scheme.Modules.pullback φ).obj L) 1 ξ =
      (e ξ).1.degree k ((Scheme.Modules.pullback φ).obj L) := by
    unfold componentDegree ProperCurve.degree degreeOn
    exact (AlgebraicGeometry.invertibleCurveDegree_eq_curveDegree k _ _ _).symm
  exact congrArg (_ * ·) hd

/-- The Euler characteristic of a coherent module with no higher cohomology is the dimension of its
space of global sections. -/
public theorem eulerCharacteristic_eq_finrank_zero_of_subsingleton {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (F : X.Modules) [F.IsCoherent]
    (h : ∀ i : ℕ, 0 < i → Subsingleton (cohomologyOverField k f F i)) :
    eulerCharacteristic k f F = (Module.finrank k (cohomologyOverField k f F 0) : ℤ) := by
  rw [eulerCharacteristic_eq_finsum]
  refine (finsum_eq_single _ 0 fun i hi => ?_).trans (by simp)
  haveI := h i (Nat.pos_of_ne_zero hi)
  simp [Module.finrank_zero_of_subsingleton]

/-- **The drop in the number of sections under a twist is the degree on the fundamental cycle.**
Let `X` be a proper `k`-scheme of dimension at most one, `φ : X ⟶ Y` a `k`-morphism to a separated
`k`-scheme locally of finite type, `L` an invertible module on `Y`, and `F`, `G` invertible modules
on `X` with `G ⊗ φ^*L ≅ F`, without higher cohomology. Then
`h⁰(F) - h⁰(G)` is the degree of `L` on the push-forward of the fundamental 1-cycle of `X`. -/
public theorem finrank_sub_finrank_eq_degree_fundamentalCycle
    [IsProper sX] [IsSeparated sY] [LocallyOfFiniteType sY]
    (hX : topologicalKrullDim X ≤ 1) (φ : X ⟶ Y) (hφ : φ ≫ sY = sX)
    (L : Y.Modules) [SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2 L]
    (F G : X.Modules) [IsInvertibleModule X F] [IsInvertibleModule X G]
    [F.IsCoherent] [G.IsCoherent]
    [(tensorModules X G ((Scheme.Modules.pullback φ).obj L)).IsCoherent]
    (e : tensorModules X G ((Scheme.Modules.pullback φ).obj L) ≅ F)
    (hF : ∀ i : ℕ, 0 < i → Subsingleton (cohomologyOverField k sX F i))
    (hG : ∀ i : ℕ, 0 < i → Subsingleton (cohomologyOverField k sX G i)) :
    (Module.finrank k (cohomologyOverField k sX F 0) : ℤ) -
        (Module.finrank k (cohomologyOverField k sX G 0) : ℤ) =
      OneCycle.degree ℤ sY L
        (∑ᶠ C : {C : ProperCurve sX // closure ({C.point} : Set X) ∈ irreducibleComponents X},
          ((Module.length (X.presheaf.stalk C.1.point) (X.presheaf.stalk C.1.point)).toNat : ℤ) •
            cyclePushforwardOfPoint ℤ sY φ C.1.point) := by
  rw [← eulerCharacteristic_tensorModules_sub_eq_degree_fundamentalCycle hX φ hφ L G,
    eulerCharacteristic_eq_of_iso k sX e,
    eulerCharacteristic_eq_finrank_zero_of_subsingleton sX F hF,
    eulerCharacteristic_eq_finrank_zero_of_subsingleton sX G hG]

end Cycle

end MMP.Chow

