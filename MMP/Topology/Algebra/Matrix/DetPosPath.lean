module

public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
public import Mathlib.Topology.Instances.Matrix
public import Mathlib.Topology.Connected.PathConnected
public import Mathlib.Analysis.Normed.Field.Basic

/-!
# Real matrices of positive determinant form a path-connected set

The set `GL⁺(ι, ℝ)` of real square matrices with positive determinant is path connected: every
such matrix is joined to `1` by a path of matrices of positive determinant.

The proof writes a matrix `M` with `det M > 0` as `D * S` with `D` the diagonal matrix
`diag(det M, 1, …, 1)` and `S ∈ SL(ι, ℝ)`. A diagonal matrix with positive entries is joined
to `1` by the segment between them. The special linear group is generated by transvections and
by the matrices `diag₂(c)` (`Matrix.SpecialLinearGroup.diagonal_transvection_induction'`); a
transvection `1 + c E_{ij}` is joined to `1` through `1 + s c E_{ij}`, `diag₂(c)` for `c > 0`
is a positive diagonal matrix, and for `c < 0` it is `diag₂(-1) diag₂(-c)` where
`diag₂(-1) = (T_{ij}(1) T_{ji}(-1) T_{ij}(1))²` is a product of transvections.

## Main results

* `MMP.MatrixDetPos.joinedIn_one_of_det_pos`: a real matrix of positive determinant is joined to
  `1` inside `GL⁺`.
* `MMP.MatrixDetPos.isPathConnected_setOf_det_pos`: `GL⁺(ι, ℝ)` is path connected.
-/

@[expose] public section

namespace MMP.MatrixDetPos

open _root_.Matrix

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Products of matrices joined to `1` inside `GL⁺` are joined to `1` inside `GL⁺`. -/
lemma joinedIn_one_mul {A B : Matrix ι ι ℝ} (hA : JoinedIn {M | 0 < M.det} 1 A)
    (hB : JoinedIn {M | 0 < M.det} 1 B) : JoinedIn {M | 0 < M.det} 1 (A * B) := by
  obtain ⟨γ, hγ⟩ := hA
  obtain ⟨δ, hδ⟩ := hB
  refine ⟨⟨⟨fun s ↦ γ s * δ s, γ.continuous.matrix_mul δ.continuous⟩, by simp, by simp⟩,
    fun s ↦ ?_⟩
  simpa [det_mul] using mul_pos (hγ s) (hδ s)

/-- A diagonal matrix with positive entries is joined to `1` inside `GL⁺`. -/
lemma joinedIn_one_diagonal_of_pos {D : ι → ℝ} (hD : ∀ k, 0 < D k) :
    JoinedIn {M | 0 < M.det} 1 (diagonal D) := by
  refine JoinedIn.ofLine (f := fun s : ℝ ↦ diagonal fun k ↦ (1 - s) + s * D k) ?_ ?_ ?_ ?_
  · refine (continuous_pi fun a ↦ continuous_pi fun b ↦ ?_).continuousOn
    simp only [diagonal_apply]
    split_ifs
    · fun_prop
    · exact continuous_const
  · simp
  · simp
  · rintro _ ⟨s, ⟨hs0, hs1⟩, rfl⟩
    simp only [Set.mem_ofPred_eq]
    rw [det_diagonal]
    refine Finset.prod_pos fun k _ ↦ ?_
    rcases eq_or_lt_of_le hs1 with rfl | hs1
    · simpa using hD k
    · nlinarith [hD k]

/-- A transvection is joined to `1` inside `GL⁺`. -/
lemma joinedIn_one_transvection {i j : ι} (hij : i ≠ j) (c : ℝ) :
    JoinedIn {M | 0 < M.det} 1 (transvection i j c) := by
  refine JoinedIn.ofLine (f := fun s : ℝ ↦ transvection i j (s * c)) ?_ ?_ ?_ ?_
  · refine (continuous_pi fun a ↦ continuous_pi fun b ↦ ?_).continuousOn
    simp only [transvection, Matrix.add_apply, Matrix.single_apply]
    split_ifs <;> fun_prop
  · simp
  · simp
  · rintro _ ⟨s, -, rfl⟩
    simp only [Set.mem_ofPred_eq]
    rw [det_transvection_of_ne _ _ hij]
    exact one_pos

/-- `(T_{ij}(1) T_{ji}(-1) T_{ij}(1))²` is the diagonal matrix with `-1` at `i` and `j`. -/
lemma transvection_rot_sq {i j : ι} (hij : i ≠ j) :
    (transvection i j (1 : ℝ) * transvection j i (-1) * transvection i j 1) *
        (transvection i j (1 : ℝ) * transvection j i (-1) * transvection i j 1) =
      diagonal fun k ↦ if k = i then -1 else if k = j then -1 else 1 := by
  have hji := hij.symm
  ext a b
  by_cases hab : a = b <;> by_cases hai : a = i <;> by_cases haj : a = j <;>
    by_cases hbi : b = i <;> by_cases hbj : b = j <;> subst_vars <;>
    simp_all [transvection, add_mul, mul_add, Matrix.add_apply, one_apply,
      single_mul_single_of_ne, eq_comm]

/-- The matrices `diag₂(c)` of the special linear group are joined to `1` inside `GL⁺`. -/
lemma joinedIn_one_diag2n {i j : ι} (hij : i ≠ j) {c : ℝ} (hc : c ≠ 0) :
    JoinedIn {M | 0 < M.det} 1
      ((SpecialLinearGroup.diag2n hij c hc : SpecialLinearGroup ι ℝ) : Matrix ι ι ℝ) := by
  change JoinedIn _ 1 (diagonal fun k ↦ if k = i then c else if k = j then c⁻¹ else 1)
  rcases hc.lt_or_gt with hc | hc
  · have hsplit : (diagonal fun k ↦ if k = i then c else if k = j then c⁻¹ else 1) =
        (diagonal fun k ↦ if k = i then (-1 : ℝ) else if k = j then -1 else 1) *
          diagonal fun k ↦ if k = i then -c else if k = j then (-c)⁻¹ else 1 := by
      rw [diagonal_mul_diagonal]
      congr 1
      funext k
      split_ifs <;> simp [inv_neg]
    rw [hsplit, ← transvection_rot_sq hij]
    have hA := joinedIn_one_mul (joinedIn_one_mul (joinedIn_one_transvection hij 1)
      (joinedIn_one_transvection hij.symm (-1))) (joinedIn_one_transvection hij 1)
    refine joinedIn_one_mul (joinedIn_one_mul hA hA)
      (joinedIn_one_diagonal_of_pos fun k ↦ ?_)
    split_ifs
    · linarith
    · exact inv_pos.2 (by linarith)
    · exact one_pos
  · refine joinedIn_one_diagonal_of_pos fun k ↦ ?_
    split_ifs
    · exact hc
    · exact inv_pos.2 hc
    · exact one_pos

/-- Every element of `SL(ι, ℝ)` is joined to `1` inside `GL⁺`. -/
lemma joinedIn_one_specialLinearGroup [Nontrivial ι] (S : SpecialLinearGroup ι ℝ) :
    JoinedIn {M | 0 < M.det} 1 (S : Matrix ι ι ℝ) := by
  refine SpecialLinearGroup.diagonal_transvection_induction'
    (fun S : SpecialLinearGroup ι ℝ ↦ JoinedIn {M | 0 < M.det} 1 (S : Matrix ι ι ℝ)) S
    (fun i j hij c hc ↦ joinedIn_one_diag2n hij hc)
    (fun i j hij a ↦ joinedIn_one_transvection hij a)
    (fun A B hA hB ↦ ?_)
  rw [SpecialLinearGroup.coe_mul]
  exact joinedIn_one_mul hA hB

/-- A real matrix of positive determinant is joined to `1` by a path of matrices of positive
determinant. -/
theorem joinedIn_one_of_det_pos {M : Matrix ι ι ℝ} (hM : 0 < M.det) :
    JoinedIn {N | 0 < N.det} 1 M := by
  rcases subsingleton_or_nontrivial ι with hι | hι
  · have hdiag : M = diagonal fun k ↦ M k k := by
      ext a b
      rw [Subsingleton.elim a b, diagonal_apply_eq]
    rw [hdiag]
    refine joinedIn_one_diagonal_of_pos fun k ↦ ?_
    rwa [hdiag, det_diagonal, Fintype.prod_subsingleton _ k] at hM
  · obtain ⟨i₀⟩ : Nonempty ι := inferInstance
    set D : Matrix ι ι ℝ := diagonal fun k ↦ if k = i₀ then M.det else 1
    set D' : Matrix ι ι ℝ := diagonal fun k ↦ if k = i₀ then M.det⁻¹ else 1
    have hDD' : D * D' = 1 := by
      rw [diagonal_mul_diagonal, ← diagonal_one]
      congr 1
      funext k
      split_ifs
      · exact mul_inv_cancel₀ hM.ne'
      · exact one_mul 1
    have hdetD' : D'.det = M.det⁻¹ := by
      rw [det_diagonal, Finset.prod_eq_single i₀ (fun k _ hk ↦ by simp [hk]) (by simp)]
      simp
    have hS : (D' * M).det = 1 := by
      rw [det_mul, hdetD', inv_mul_cancel₀ hM.ne']
    have hM' : M = D * (D' * M) := by rw [← mul_assoc, hDD', one_mul]
    rw [hM']
    refine joinedIn_one_mul (joinedIn_one_diagonal_of_pos fun k ↦ ?_)
      (joinedIn_one_specialLinearGroup ⟨D' * M, hS⟩)
    split_ifs
    · exact hM
    · exact one_pos

/-- The real matrices of positive determinant form a path-connected set. -/
theorem isPathConnected_setOf_det_pos : IsPathConnected {M : Matrix ι ι ℝ | 0 < M.det} :=
  ⟨1, by simp, fun {_} hM ↦ joinedIn_one_of_det_pos hM⟩

end MMP.MatrixDetPos
