module

public import MMP.AlgebraicTopology.PoincareDuality.LocalGenerator
public import MMP.AlgebraicTopology.SingularCohomology.Relative.Excision

/-!
# Low-degree relative homology: Mayer–Vietoris and homotopy transfer

Chain-level statements about the relative homology `H_k(S, S ∩ A; R)` of a subset `S` of a
space `Y` relative to a fixed subset `A`, in the finite singular chain model: a chain *inside*
`S` is a combination of simplices with image in `S`.

* `IsRelBoundaryIn S A k c`: `c` is a relative boundary of `(S, S ∩ A)`.
* `RelHomologyVanishing S A k`: `H_k(S, S ∩ A) = 0`.
* `RelHomologyGenerated S A k G`: `H_k(S, S ∩ A)` is generated by the classes of the chains of `G`.

The Mayer–Vietoris step: for `U`, `V` open, if `H_{k}(U ∩ V, U ∩ V ∩ A) = 0` then every relative
`(k + 1)`-cycle of `U ∪ V` is, up to a relative boundary, a sum of relative cycles of `U` and of
`V`; so vanishing and generation pass from `U`, `V` to `U ∪ V`. The homotopy transfer: vanishing
and generation pass along maps of pairs `f`, `g` with `g ∘ f` homotopic to the identity through
maps of pairs.

These are the homological steps of Thom's theorem (Milnor–Stasheff, §10).

## References

* [J. Milnor, J. Stasheff, *Characteristic classes*][milnorstasheff1974], §10.
* [A. Hatcher, *Algebraic Topology*][hatcher2002], §2.2.
-/

@[expose] public noncomputable section

open Finsupp Set

namespace MMP

namespace SingularChain

variable {R : Type*} [CommRing R] {Y Z : Type*} [TopologicalSpace Y] [TopologicalSpace Z]

section defs

variable (R) in
/-- Relative cycles of `(Y, A)`: all `0`-chains, and the chains whose boundary lies in `A`. -/
def relativeCycles (A : Set Y) : (k : ℕ) → Submodule R (Chain R Y k)
  | 0 => ⊤
  | k + 1 => (inside R k A).comap (bd R k)

/-- A `(k + 1)`-chain is a relative cycle of `(Y, A)` iff its boundary lies in `A`. -/
lemma mem_relativeCycles_succ {A : Set Y} {k : ℕ} {c : Chain R Y (k + 1)} :
    c ∈ relativeCycles R A (k + 1) ↔ bd R k c ∈ inside R k A :=
  Iff.rfl

/-- Every chain in `A` is a relative cycle of `(Y, A)`. -/
lemma inside_le_relativeCycles {A : Set Y} (k : ℕ) : inside R k A ≤ relativeCycles R A k := by
  cases k with
  | zero => exact le_top
  | succ k => exact fun _ hc ↦ bd_mem_inside hc

/-- Every boundary is a relative cycle of `(Y, A)`. -/
lemma bd_mem_relativeCycles {A : Set Y} (k : ℕ) (w : Chain R Y (k + 1)) :
    bd R k w ∈ relativeCycles R A k := by
  cases k with
  | zero => trivial
  | succ k =>
    rw [mem_relativeCycles_succ, bd_bd]
    exact Submodule.zero_mem _

/-- The relative cycles of `(Y, A)` are relative cycles of `(Y, B)` for `A ⊆ B`. -/
lemma relativeCycles_mono {A B : Set Y} (h : A ⊆ B) (k : ℕ) :
    relativeCycles R A k ≤ relativeCycles R B k := by
  cases k with
  | zero => exact le_top
  | succ k => exact fun _ hc ↦ inside_mono _ h hc

/-- Postcomposition with a map sending `A` into `B` sends relative cycles of `(Y, A)` to
relative cycles of `(Z, B)`. -/
lemma postcomp_mem_relativeCycles (f : C(Y, Z)) {A : Set Y} {B : Set Z} (hf : MapsTo f A B)
    {k : ℕ} {c : Chain R Y k} (hc : c ∈ relativeCycles R A k) :
    postcomp R f k c ∈ relativeCycles R B k := by
  cases k with
  | zero => trivial
  | succ k =>
    rw [mem_relativeCycles_succ, ← postcomp_bd]
    exact postcomp_mem_inside f hf hc

variable (R) in
/-- `c` is a relative boundary of `(S, S ∩ A)`: `c - ∂ w` lies in `S ∩ A` for a chain `w` in
`S`. -/
def IsRelBoundaryIn (S A : Set Y) (k : ℕ) (c : Chain R Y k) : Prop :=
  ∃ w ∈ inside R (k + 1) S, c - bd R k w ∈ inside R k (S ∩ A)

variable (R) in
/-- `H_k(S, S ∩ A; R) = 0`: every relative cycle in `S` is a relative boundary. -/
def RelHomologyVanishing (S A : Set Y) (k : ℕ) : Prop :=
  ∀ c ∈ inside R k S, c ∈ relativeCycles R A k → IsRelBoundaryIn R S A k c

variable (R) in
/-- `H_k(S, S ∩ A; R)` is generated by the classes of the chains of `G`. -/
def RelHomologyGenerated (S A : Set Y) (k : ℕ) (G : Submodule R (Chain R Y k)) : Prop :=
  ∀ c ∈ inside R k S, c ∈ relativeCycles R A k → ∃ g ∈ G, IsRelBoundaryIn R S A k (c - g)

end defs

section relBoundary

variable {S S' A A' : Set Y} {k : ℕ}

/-- The zero chain is a relative boundary of `(S, S ∩ A)`. -/
lemma isRelBoundaryIn_zero : IsRelBoundaryIn R S A k 0 :=
  ⟨0, Submodule.zero_mem _, by simp⟩

/-- A chain in `S ∩ A` is a relative boundary of `(S, S ∩ A)`. -/
lemma isRelBoundaryIn_of_mem {c : Chain R Y k} (hc : c ∈ inside R k (S ∩ A)) :
    IsRelBoundaryIn R S A k c :=
  ⟨0, Submodule.zero_mem _, by simpa using hc⟩

/-- The boundary of a chain in `S` is a relative boundary of `(S, S ∩ A)`. -/
lemma isRelBoundaryIn_bd {w : Chain R Y (k + 1)} (hw : w ∈ inside R (k + 1) S) :
    IsRelBoundaryIn R S A k (bd R k w) :=
  ⟨w, hw, by simp⟩

/-- A sum of relative boundaries of `(S, S ∩ A)` is a relative boundary. -/
lemma IsRelBoundaryIn.add {c d : Chain R Y k} (hc : IsRelBoundaryIn R S A k c)
    (hd : IsRelBoundaryIn R S A k d) : IsRelBoundaryIn R S A k (c + d) := by
  obtain ⟨w, hw, hcw⟩ := hc
  obtain ⟨w', hw', hdw⟩ := hd
  refine ⟨w + w', Submodule.add_mem _ hw hw', ?_⟩
  convert Submodule.add_mem _ hcw hdw using 1
  rw [map_add]
  abel

/-- The negative of a relative boundary of `(S, S ∩ A)` is a relative boundary. -/
lemma IsRelBoundaryIn.neg {c : Chain R Y k} (hc : IsRelBoundaryIn R S A k c) :
    IsRelBoundaryIn R S A k (-c) := by
  obtain ⟨w, hw, hcw⟩ := hc
  refine ⟨-w, Submodule.neg_mem _ hw, ?_⟩
  convert Submodule.neg_mem _ hcw using 1
  rw [map_neg]
  abel

/-- A difference of relative boundaries of `(S, S ∩ A)` is a relative boundary. -/
lemma IsRelBoundaryIn.sub {c d : Chain R Y k} (hc : IsRelBoundaryIn R S A k c)
    (hd : IsRelBoundaryIn R S A k d) : IsRelBoundaryIn R S A k (c - d) := by
  rw [sub_eq_add_neg]
  exact hc.add hd.neg

/-- A scalar multiple of a relative boundary of `(S, S ∩ A)` is a relative boundary. -/
lemma IsRelBoundaryIn.smul {c : Chain R Y k} (r : R) (hc : IsRelBoundaryIn R S A k c) :
    IsRelBoundaryIn R S A k (r • c) := by
  obtain ⟨w, hw, hcw⟩ := hc
  refine ⟨r • w, Submodule.smul_mem _ _ hw, ?_⟩
  convert Submodule.smul_mem _ r hcw using 1
  rw [map_smul, smul_sub]

/-- A relative boundary of `(S, S ∩ A)` is a relative boundary of `(S', S' ∩ A')` for
`S ⊆ S'` and `A ⊆ A'`. -/
lemma IsRelBoundaryIn.mono (hS : S ⊆ S') (hA : A ⊆ A') {c : Chain R Y k}
    (hc : IsRelBoundaryIn R S A k c) : IsRelBoundaryIn R S' A' k c := by
  obtain ⟨w, hw, hcw⟩ := hc
  exact ⟨w, inside_mono _ hS hw,
    inside_mono _ (inter_subset_inter hS hA) hcw⟩

/-- If `c - d` and `d` are relative boundaries of `(S, S ∩ A)`, then so is `c`. -/
lemma IsRelBoundaryIn.of_sub {c d : Chain R Y k} (hcd : IsRelBoundaryIn R S A k (c - d))
    (hd : IsRelBoundaryIn R S A k d) : IsRelBoundaryIn R S A k c := by
  simpa using hcd.add hd

/-- Postcomposition with a map of pairs `(S, S ∩ A) → (T, T ∩ B)` sends relative boundaries to
relative boundaries. -/
lemma IsRelBoundaryIn.map (f : C(Y, Z)) {T B : Set Z} (hS : MapsTo f S T)
    (hA : MapsTo f (S ∩ A) (T ∩ B)) {c : Chain R Y k} (hc : IsRelBoundaryIn R S A k c) :
    IsRelBoundaryIn R T B k (postcomp R f k c) := by
  obtain ⟨w, hw, hcw⟩ := hc
  refine ⟨postcomp R f (k + 1) w, postcomp_mem_inside f hS hw, ?_⟩
  rw [← postcomp_bd, ← map_sub]
  exact postcomp_mem_inside f hA hcw

/-- If `H_k(S, S ∩ A)` is generated by the classes of `G`, it is generated by those of any
`G' ≥ G`. -/
lemma RelHomologyGenerated.mono {G G' : Submodule R (Chain R Y k)} (hG : G ≤ G')
    (h : RelHomologyGenerated R S A k G) : RelHomologyGenerated R S A k G' := fun c hc hcz ↦
  (h c hc hcz).elim fun g ⟨hg, hcg⟩ ↦ ⟨g, hG hg, hcg⟩

/-- On the empty set every relative homology group vanishes. -/
lemma relHomologyVanishing_empty : RelHomologyVanishing R (∅ : Set Y) A k := fun c hc _ ↦ by
  rw [eq_zero_of_mem_inside_empty hc]
  exact isRelBoundaryIn_zero

/-- On the empty set every relative homology group is generated by any submodule of chains. -/
lemma relHomologyGenerated_empty (G : Submodule R (Chain R Y k)) :
    RelHomologyGenerated R (∅ : Set Y) A k G := fun c hc _ ↦
  ⟨0, Submodule.zero_mem _, by
    rw [eq_zero_of_mem_inside_empty hc, sub_zero]
    exact isRelBoundaryIn_zero⟩

end relBoundary

section mayerVietoris

variable {U V A : Set Y}

/-- A chain whose simplices lie in `A` and each in `U` or in `V` splits into a chain in `U ∩ A`
and one in `V ∩ A`. -/
lemma exists_add_of_mem_small_pair_inter {n : ℕ} {c : Chain R Y n} (hc : c ∈ small R n {U, V})
    (hcA : c ∈ inside R n A) :
    ∃ cU ∈ inside R n (U ∩ A), ∃ cV ∈ inside R n (V ∩ A), c = cU + cV := by
  have : c ∈ small R n {U ∩ A, V ∩ A} := by
    refine (mem_supported R c).2 fun σ hσ ↦ ?_
    obtain ⟨W, hW, hσW⟩ := (mem_supported R c).1 hc hσ
    have hσA := (mem_supported R c).1 hcA hσ
    simp only [mem_insert_iff, mem_singleton_iff] at hW
    rcases hW with h | h
    · exact ⟨U ∩ A, by simp, subset_inter (h ▸ hσW) hσA⟩
    · exact ⟨V ∩ A, by simp, subset_inter (h ▸ hσW) hσA⟩
  exact exists_add_of_mem_small_pair this

/-- A chain in `U ∪ V` is a chain in `⋃₀ {U, V}`. -/
lemma mem_inside_sUnion_pair' {n : ℕ} {c : Chain R Y n} (hc : c ∈ inside R n (U ∪ V)) :
    c ∈ inside R n (⋃₀ ({U, V} : Set (Set Y))) := by
  simpa using hc

/-- The subdivision `ρ` for the cover `{U, V}` moves a chain of `U ∪ V` by a relative boundary of
`(U ∪ V, (U ∪ V) ∩ A)`, for chains with boundary in `A`. -/
lemma isRelBoundaryIn_sub_smallChainMap {k : ℕ} {c : Chain R Y k}
    (hc : c ∈ inside R k (U ∪ V)) (hcz : c ∈ relativeCycles R A k) :
    IsRelBoundaryIn R (U ∪ V) A k (c - smallChainMap R {U, V} k c) := by
  cases k with
  | zero =>
    rw [smallChainMap_zero, sub_sub_cancel]
    exact isRelBoundaryIn_bd (smallHomotopy_mem_inside _ _ hc)
  | succ k =>
    rw [smallChainMap_succ,
      show ∀ x y z : Chain R Y (k + 1), x - (x - y - z) = z + y from fun x y z ↦ by abel]
    refine (isRelBoundaryIn_of_mem ?_).add (isRelBoundaryIn_bd (smallHomotopy_mem_inside _ _ hc))
    rw [inside_inter]
    exact ⟨smallHomotopy_mem_inside _ _ (bd_mem_inside hc),
      smallHomotopy_mem_inside _ _ (mem_relativeCycles_succ.1 hcz)⟩

/-- **The Mayer–Vietoris splitting.** For `U`, `V` open with `H_k(U ∩ V, U ∩ V ∩ A) = 0`, a
relative `(k + 1)`-cycle of `U ∪ V` is, up to a relative boundary of `U ∪ V`, the sum of a
relative cycle of `U` and one of `V`. -/
theorem exists_relativeCycles_add_of_relHomologyVanishing_inter {k : ℕ} (hU : IsOpen U)
    (hV : IsOpen V) (hUV : RelHomologyVanishing R (U ∩ V) A k) {c : Chain R Y (k + 1)}
    (hc : c ∈ inside R (k + 1) (U ∪ V)) (hcz : c ∈ relativeCycles R A (k + 1)) :
    ∃ cU ∈ inside R (k + 1) U, cU ∈ relativeCycles R A (k + 1) ∧
      ∃ cV ∈ inside R (k + 1) V, cV ∈ relativeCycles R A (k + 1) ∧
        IsRelBoundaryIn R (U ∪ V) A (k + 1) (c - (cU + cV)) := by
  set 𝒰 : Set (Set Y) := {U, V}
  obtain ⟨a, ha, b, hb, hab⟩ := exists_add_of_mem_small_pair
    (smallChainMap_mem_small (isOpen_pair hU hV) (k + 1) (mem_inside_sUnion_pair' hc))
  obtain ⟨qU, hqU, qV, hqV, hq'⟩ := exists_add_of_mem_small_pair_inter (A := A)
    (smallChainMap_mem_small (isOpen_pair hU hV) k
      (mem_inside_sUnion_pair' (bd_mem_inside hc)))
    (smallChainMap_mem_inside 𝒰 k (mem_relativeCycles_succ.1 hcz))
  rw [← bd_smallChainMap 𝒰 k c, hab, map_add] at hq'
  have hz1 : bd R k a - qU = qV - bd R k b := by
    rw [sub_eq_sub_iff_add_eq_add, hq']
    abel
  have hzUV : bd R k a - qU ∈ inside R k (U ∩ V) := by
    rw [inside_inter]
    refine ⟨Submodule.sub_mem _ (bd_mem_inside ha) (inside_mono _ inter_subset_left hqU), ?_⟩
    rw [hz1]
    exact Submodule.sub_mem _ (inside_mono _ inter_subset_left hqV) (bd_mem_inside hb)
  have hzz : bd R k a - qU ∈ relativeCycles R A k :=
    Submodule.sub_mem _ (bd_mem_relativeCycles k a)
      (inside_le_relativeCycles k (inside_mono _ inter_subset_right hqU))
  obtain ⟨y, hy, hzy⟩ := hUV _ hzUV hzz
  rw [inside_inter] at hy
  have hzyA : bd R k a - qU - bd R k y ∈ inside R k A :=
    inside_mono _ inter_subset_right hzy
  refine ⟨a - y, Submodule.sub_mem _ ha hy.1, ?_, b + y, Submodule.add_mem _ hb hy.2, ?_, ?_⟩
  · rw [mem_relativeCycles_succ]
    convert Submodule.add_mem _ hzyA (inside_mono _ inter_subset_right hqU) using 1
    rw [map_sub]
    abel
  · rw [mem_relativeCycles_succ]
    have : bd R k (b + y) = qV - (bd R k a - qU - bd R k y) := by
      rw [map_add, show bd R k b = qV - (bd R k a - qU) by rw [hz1, sub_sub_cancel]]
      abel
    rw [this]
    exact Submodule.sub_mem _ (inside_mono _ inter_subset_right hqV) hzyA
  · rw [show a - y + (b + y) = a + b by abel, ← hab]
    exact isRelBoundaryIn_sub_smallChainMap hc hcz

/-- In degree `0` the splitting needs no hypothesis. -/
theorem exists_add_of_inside_union_zero (hU : IsOpen U) (hV : IsOpen V) {c : Chain R Y 0}
    (hc : c ∈ inside R 0 (U ∪ V)) :
    ∃ cU ∈ inside R 0 U, ∃ cV ∈ inside R 0 V, IsRelBoundaryIn R (U ∪ V) A 0 (c - (cU + cV)) := by
  obtain ⟨a, ha, b, hb, hab⟩ := exists_add_of_mem_small_pair
    (smallChainMap_mem_small (isOpen_pair hU hV) 0 (mem_inside_sUnion_pair' hc))
  refine ⟨a, ha, b, hb, ?_⟩
  rw [← hab]
  exact isRelBoundaryIn_sub_smallChainMap hc trivial

/-- **Mayer–Vietoris for vanishing**, degree `0`. -/
theorem RelHomologyVanishing.union_zero (hU : IsOpen U) (hV : IsOpen V)
    (hUa : RelHomologyVanishing R U A 0) (hVa : RelHomologyVanishing R V A 0) :
    RelHomologyVanishing R (U ∪ V) A 0 := fun c hc _ ↦ by
  obtain ⟨cU, hcU, cV, hcV, h⟩ := exists_add_of_inside_union_zero (A := A) hU hV hc
  exact h.of_sub (((hUa cU hcU trivial).mono subset_union_left subset_rfl).add
    ((hVa cV hcV trivial).mono subset_union_right subset_rfl))

/-- **Mayer–Vietoris for vanishing**: `H_{k+1}` vanishes on `U ∪ V` if it does on `U` and `V`
and `H_k` vanishes on `U ∩ V`. -/
theorem RelHomologyVanishing.union_succ {k : ℕ} (hU : IsOpen U) (hV : IsOpen V)
    (hUa : RelHomologyVanishing R U A (k + 1)) (hVa : RelHomologyVanishing R V A (k + 1))
    (hUV : RelHomologyVanishing R (U ∩ V) A k) : RelHomologyVanishing R (U ∪ V) A (k + 1) :=
  fun c hc hcz ↦ by
  obtain ⟨cU, hcU, hcUz, cV, hcV, hcVz, h⟩ :=
    exists_relativeCycles_add_of_relHomologyVanishing_inter hU hV hUV hc hcz
  exact h.of_sub (((hUa cU hcU hcUz).mono subset_union_left subset_rfl).add
    ((hVa cV hcV hcVz).mono subset_union_right subset_rfl))

/-- **Mayer–Vietoris for generation**, degree `0`. -/
theorem RelHomologyGenerated.union_zero (hU : IsOpen U) (hV : IsOpen V)
    {GU GV : Submodule R (Chain R Y 0)}
    (hUa : RelHomologyGenerated R U A 0 GU) (hVa : RelHomologyGenerated R V A 0 GV) :
    RelHomologyGenerated R (U ∪ V) A 0 (GU ⊔ GV) := fun c hc _ ↦ by
  obtain ⟨cU, hcU, cV, hcV, h⟩ := exists_add_of_inside_union_zero (A := A) hU hV hc
  obtain ⟨gU, hgU, hU'⟩ := hUa cU hcU trivial
  obtain ⟨gV, hgV, hV'⟩ := hVa cV hcV trivial
  refine ⟨gU + gV, Submodule.add_mem_sup hgU hgV, ?_⟩
  convert h.add ((hU'.mono subset_union_left subset_rfl).add
    (hV'.mono subset_union_right subset_rfl)) using 1
  abel

/-- **Mayer–Vietoris for generation**: `H_{k+1}(U ∪ V)` is generated by `G_U + G_V` if
`H_{k+1}(U)`, `H_{k+1}(V)` are generated by `G_U`, `G_V` and `H_k(U ∩ V) = 0`. -/
theorem RelHomologyGenerated.union_succ {k : ℕ} (hU : IsOpen U) (hV : IsOpen V)
    {GU GV : Submodule R (Chain R Y (k + 1))}
    (hUa : RelHomologyGenerated R U A (k + 1) GU) (hVa : RelHomologyGenerated R V A (k + 1) GV)
    (hUV : RelHomologyVanishing R (U ∩ V) A k) :
    RelHomologyGenerated R (U ∪ V) A (k + 1) (GU ⊔ GV) := fun c hc hcz ↦ by
  obtain ⟨cU, hcU, hcUz, cV, hcV, hcVz, h⟩ :=
    exists_relativeCycles_add_of_relHomologyVanishing_inter hU hV hUV hc hcz
  obtain ⟨gU, hgU, hU'⟩ := hUa cU hcU hcUz
  obtain ⟨gV, hgV, hV'⟩ := hVa cV hcV hcVz
  refine ⟨gU + gV, Submodule.add_mem_sup hgU hgV, ?_⟩
  convert h.add ((hU'.mono subset_union_left subset_rfl).add
    (hV'.mono subset_union_right subset_rfl)) using 1
  abel

end mayerVietoris

section transfer

variable {S A : Set Y} {T B : Set Z}

/-- The prism of a homotopy from `g` to the identity: `c - g_# c` is a relative boundary of
`(S, S ∩ A)` for a relative cycle `c` in `S`, if the homotopy keeps `S` and `S ∩ A`. -/
lemma isRelBoundaryIn_sub_postcomp_of_homotopy (F : C(Y × unitInterval, Y)) (g : C(Y, Y))
    (hF₀ : ∀ y, F (y, 0) = g y) (hF₁ : ∀ y, F (y, 1) = y) (hFS : MapsTo F (S ×ˢ univ) S)
    (hFA : MapsTo F ((S ∩ A) ×ˢ univ) (S ∩ A)) {k : ℕ} {c : Chain R Y k}
    (hc : c ∈ inside R k S) (hcz : c ∈ relativeCycles R A k) :
    IsRelBoundaryIn R S A k (c - postcomp R g k c) := by
  cases k with
  | zero =>
    have h := bd_prism_zero (R := R) F (f := g) (g := ContinuousMap.id Y) hF₀ (fun y ↦ hF₁ y) c
    rw [postcomp_id] at h
    rw [← h]
    exact isRelBoundaryIn_bd (prism_mem_inside F hFS hc)
  | succ k =>
    have h := bd_prism_add_prism_bd (R := R) F (f := g) (g := ContinuousMap.id Y) hF₀
      (fun y ↦ hF₁ y) k c
    rw [postcomp_id] at h
    rw [← h]
    refine (isRelBoundaryIn_bd (prism_mem_inside F hFS hc)).add (isRelBoundaryIn_of_mem ?_)
    refine prism_mem_inside F hFA ?_
    rw [inside_inter]
    exact ⟨bd_mem_inside hc, mem_relativeCycles_succ.1 hcz⟩

/-- Postcomposition with a map of pairs `(S, S ∩ A) → (T, T ∩ B)` sends a relative cycle in `S`
to a relative cycle. -/
lemma postcomp_mem_relativeCycles_inter (f : C(Y, Z)) (hfA : MapsTo f (S ∩ A) (T ∩ B)) {k : ℕ}
    {c : Chain R Y k} (hc : c ∈ inside R k S) (hcz : c ∈ relativeCycles R A k) :
    postcomp R f k c ∈ relativeCycles R B k := by
  refine relativeCycles_mono inter_subset_right k (postcomp_mem_relativeCycles f hfA ?_)
  cases k with
  | zero => trivial
  | succ k =>
    rw [mem_relativeCycles_succ, inside_inter]
    exact ⟨bd_mem_inside hc, mem_relativeCycles_succ.1 hcz⟩

/-- **Homotopy transfer of vanishing.** -/
theorem RelHomologyVanishing.of_homotopy (f : C(Y, Z)) (g : C(Z, Y)) (hfS : MapsTo f S T)
    (hfA : MapsTo f (S ∩ A) (T ∩ B)) (hgT : MapsTo g T S) (hgB : MapsTo g (T ∩ B) (S ∩ A))
    (F : C(Y × unitInterval, Y)) (hF₀ : ∀ y, F (y, 0) = g (f y)) (hF₁ : ∀ y, F (y, 1) = y)
    (hFS : MapsTo F (S ×ˢ univ) S) (hFA : MapsTo F ((S ∩ A) ×ˢ univ) (S ∩ A)) {k : ℕ}
    (h : RelHomologyVanishing R T B k) : RelHomologyVanishing R S A k := fun c hc hcz ↦ by
  have h1 := IsRelBoundaryIn.map g hgT hgB (h _ (postcomp_mem_inside f hfS hc)
    (postcomp_mem_relativeCycles_inter f hfA hc hcz))
  rw [postcomp_comp] at h1
  exact (isRelBoundaryIn_sub_postcomp_of_homotopy (R := R) F (g.comp f) hF₀ hF₁ hFS hFA hc
    hcz).of_sub h1

/-- **Homotopy transfer of generation**: the generators are carried by `g`. -/
theorem RelHomologyGenerated.of_homotopy (f : C(Y, Z)) (g : C(Z, Y)) (hfS : MapsTo f S T)
    (hfA : MapsTo f (S ∩ A) (T ∩ B)) (hgT : MapsTo g T S) (hgB : MapsTo g (T ∩ B) (S ∩ A))
    (F : C(Y × unitInterval, Y)) (hF₀ : ∀ y, F (y, 0) = g (f y)) (hF₁ : ∀ y, F (y, 1) = y)
    (hFS : MapsTo F (S ×ˢ univ) S) (hFA : MapsTo F ((S ∩ A) ×ˢ univ) (S ∩ A)) {k : ℕ}
    {G : Submodule R (Chain R Z k)} {G' : Submodule R (Chain R Y k)}
    (hG : G.map (postcomp R g k) ≤ G')
    (h : RelHomologyGenerated R T B k G) : RelHomologyGenerated R S A k G' := fun c hc hcz ↦ by
  obtain ⟨g', hg', h1⟩ := h _ (postcomp_mem_inside f hfS hc)
    (postcomp_mem_relativeCycles_inter f hfA hc hcz)
  have h1' := h1.map g hgT hgB
  rw [map_sub, postcomp_comp] at h1'
  refine ⟨postcomp R g k g', hG ⟨g', hg', rfl⟩, ?_⟩
  have h2 := isRelBoundaryIn_sub_postcomp_of_homotopy (R := R) F (g.comp f) hF₀ hF₁ hFS hFA hc hcz
  convert h2.add h1' using 1
  abel

/-- **A pair deforming into its subspace has no relative homology**: a homotopy from the identity
to a map sending `S` into `S ∩ A`, keeping `S` and `S ∩ A`. -/
theorem relHomologyVanishing_of_homotopy (F : C(Y × unitInterval, Y)) (h : C(Y, Y))
    (hF₀ : ∀ y, F (y, 0) = y) (hF₁ : ∀ y, F (y, 1) = h y) (hFS : MapsTo F (S ×ˢ univ) S)
    (hFA : MapsTo F ((S ∩ A) ×ˢ univ) (S ∩ A)) (hh : MapsTo h S (S ∩ A)) (k : ℕ) :
    RelHomologyVanishing R S A k := fun c hc hcz ↦ by
  let G : C(Y × unitInterval, Y) := ⟨fun p ↦ F (p.1, unitInterval.symm p.2),
    F.continuous.comp (continuous_fst.prodMk (unitInterval.continuous_symm.comp continuous_snd))⟩
  have hrev : ∀ y, G (y, 0) = h y := fun y ↦ by simp [G, hF₁]
  have hrev1 : ∀ y, G (y, 1) = y := fun y ↦ by simp [G, hF₀]
  have hS' : MapsTo G (S ×ˢ univ) S := fun p hp ↦ hFS ⟨hp.1, trivial⟩
  have hA' : MapsTo G ((S ∩ A) ×ˢ univ) (S ∩ A) := fun p hp ↦ hFA ⟨hp.1, trivial⟩
  exact (isRelBoundaryIn_sub_postcomp_of_homotopy (R := R) _ h hrev hrev1 hS' hA' hc
    hcz).of_sub (isRelBoundaryIn_of_mem (postcomp_mem_inside h hh hc))

end transfer

