module

public import MMP.AlgebraicTopology.ThomClass.Isomorphism.Bundle
/-!
# Thom's theorem: existence and uniqueness of the Thom class (Fulton, §19.1)

**Thom's theorem** (Milnor–Stasheff, Thm. 10.4) for a complex topological vector bundle `E` of
rank `r` on an arbitrary space `B`, with coefficients in any commutative ring `R`: there is
exactly one Thom class `u_E ∈ H^{2r}(E, E - 0_E; R)`
(`MMP.ThomClass.existsUnique_isThomClass`), the *Thom class* `thomClass R F E`.

The proof (Milnor–Stasheff, §10): over an open set inside the base of a trivialisation the
relative homology `H_k(E|_U, E|_U - 0)` vanishes for `k < 2r` and `H_{2r}` is generated by the
fibre simplices, freely as far as the coefficient sum is concerned
(`MMP.AlgebraicTopology.ThomClass.Isomorphism.Bundle`); this passes to finite unions of such
sets by Mayer–Vietoris, and to `E` since every singular chain lies over a compact set. Then:

* uniqueness: the difference of two Thom cocycles vanishes on every relative `2r`-cycle, hence is
  a relative coboundary (`H_k = 0` for `k < 2r` and the relative chains are free);
* existence: the coefficient sum of fibre simplices is a well-defined functional on relative
  `2r`-cycles modulo relative boundaries; it extends to a relative cocycle because the relative
  boundaries in degree `2r - 1` form a projective module.

## Main definitions

* `MMP.ThomClass.thomClass`: the Thom class `u_E`.

## Main results

* `MMP.ThomClass.existsUnique_isThomClass`: Thom's theorem.
* `MMP.ThomClass.isThomClass_thomClass`, `MMP.ThomClass.eq_thomClass`

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.1.
* [J. Milnor, J. Stasheff, *Characteristic classes*][milnorstasheff1974], Thm. 10.4.
-/

@[expose] public noncomputable section

open Finsupp Set Bundle

universe u

namespace MMP

namespace SingularCochain

open SingularChain

variable {R : Type*} [CommRing R] {Y : Type*} [TopologicalSpace Y]

section generic

/-- A relative cocycle vanishing on every relative `n`-cycle is a relative coboundary, if
`H_k(Y, A) = 0` for `k < n`. -/
theorem mem_relCoboundaries_of_relHomologyVanishing {A : Set Y} {n : ℕ}
    (hvan : ∀ k < n, RelHomologyVanishing R univ A k) {ψ : Simplex Y n → R}
    (hψ : ∀ c ∈ relativeCycles R A n, eval ψ c = 0) : ψ ∈ relCoboundaries R A n := by
  cases n with
  | zero =>
    rw [show ψ = 0 from funext fun σ ↦ by
      simpa [eval, linearCombination_single] using hψ (single σ 1) trivial]
    exact Submodule.zero_mem _
  | succ m =>
    refine mem_relCoboundaries_of_eval_eq_zero A m (fun c ↦ ?_) (fun k hk c hc ↦ ?_)
      (fun c hc ↦ hψ c hc)
    · obtain ⟨w, -, hw⟩ := hvan 0 (Nat.succ_pos m) c (mem_inside_univ c) trivial
      exact ⟨w, by rwa [univ_inter] at hw⟩
    · obtain ⟨w, -, hw⟩ := hvan (k + 1) hk c (mem_inside_univ c) hc
      exact ⟨w, by rwa [univ_inter] at hw⟩

/-- A relative cocycle vanishes on every relative `n`-cycle if it vanishes on generators of
`H_n(Y, A)`. -/
lemma eval_eq_zero_of_relHomologyGenerated {A : Set Y} {n : ℕ}
    {G : Submodule R (Chain R Y n)} (hG : RelHomologyGenerated R univ A n G)
    {ψ : Simplex Y n → R} (hψc : ψ ∈ relCocycles R A n) (hψ : ∀ g ∈ G, eval ψ g = 0)
    {c : Chain R Y n} (hc : c ∈ relativeCycles R A n) : eval ψ c = 0 := by
  obtain ⟨g, hg, w, -, hw⟩ := hG c (mem_inside_univ c) hc
  rw [univ_inter] at hw
  have h1 := eval_eq_zero_of_mem_vanishing hψc.1 hw
  have h2 : eval ψ (bd R n w) = 0 := by
    rw [← eval_coboundary, hψc.2]
    simp [eval]
  rwa [map_sub, map_sub, h2, sub_zero, hψ g hg, sub_zero] at h1

/-- If `H_k(Y, A) = 0` for `k ≤ m`, the relative `(m + 1)`-cycles are a direct summand of the
`(m + 1)`-chains: a projection onto them. -/
lemma exists_relativeCycles_projection_succ {A : Set Y} {m : ℕ}
    (hvan : ∀ k < m + 1, RelHomologyVanishing R univ A k) :
    ∃ pr : Chain R Y (m + 1) →ₗ[R] relativeCycles R A (m + 1),
      ∀ z (hz : z ∈ relativeCycles R A (m + 1)), pr z = ⟨z, hz⟩ := by
  let P : ℕ → Type _ := fun k ↦ Chain R Y k ⧸ inside R k A
  let d : ∀ k, P (k + 1) →ₗ[R] P k := relBd A
  have hdd : ∀ k, d k ∘ₗ d (k + 1) = 0 := relBd_comp_relBd A
  have hmk0 : ∀ {k} {x : Chain R Y k}, (Submodule.Quotient.mk x : P k) = 0 ↔
      x ∈ inside R k A := fun {_ _} ↦ Submodule.Quotient.mk_eq_zero _
  have hmk : ∀ {k} {x y : Chain R Y k}, (Submodule.Quotient.mk x : P k) =
      Submodule.Quotient.mk y ↔ x - y ∈ inside R k A := fun {_ _ _} ↦ Submodule.Quotient.eq _
  have hproj := projective_range_of_exact (P := P) d hdd (m := m)
    (by
      refine eq_top_iff.2 fun x _ ↦ ?_
      obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      obtain ⟨w, -, hw⟩ := hvan 0 (Nat.succ_pos m) c (mem_inside_univ c) trivial
      rw [univ_inter] at hw
      exact ⟨Submodule.Quotient.mk w, hmk.2 (by rw [← neg_sub]; exact neg_mem hw)⟩)
    (fun k hk x hx ↦ by
      obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      obtain ⟨w, -, hw⟩ := hvan (k + 1) (by omega) c (mem_inside_univ c) (hmk0.1 hx)
      rw [univ_inter] at hw
      exact ⟨Submodule.Quotient.mk w, hmk.2 (by rw [← neg_sub]; exact neg_mem hw)⟩)
    m le_rfl
  let D : Chain R Y (m + 1) →ₗ[R] P m := d m ∘ₗ (inside R (m + 1) A).mkQ
  have hDr : LinearMap.range D = LinearMap.range (d m) :=
    LinearMap.range_comp_of_range_eq_top _ (Submodule.range_mkQ _)
  have : Module.Projective R (LinearMap.range D) := by rw [hDr]; exact hproj
  obtain ⟨s, hs⟩ := Module.projective_lifting_property D.rangeRestrict LinearMap.id
    (LinearMap.surjective_rangeRestrict _)
  have hs' : ∀ x, D (s (D.rangeRestrict x)) = D x := fun x ↦
    congrArg Subtype.val (LinearMap.congr_fun hs (D.rangeRestrict x))
  have hker : ∀ x, x ∈ relativeCycles R A (m + 1) ↔ D x = 0 := fun x ↦ by
    rw [mem_relativeCycles_succ]
    exact hmk0.symm
  have hmem : ∀ x, x - s (D.rangeRestrict x) ∈ relativeCycles R A (m + 1) := fun x ↦ by
    rw [hker, map_sub, hs', sub_self]
  let q : Chain R Y (m + 1) →ₗ[R] Chain R Y (m + 1) := LinearMap.id - s ∘ₗ D.rangeRestrict
  have hq : ∀ x, q x = x - s (D.rangeRestrict x) := fun _ ↦ rfl
  refine ⟨LinearMap.codRestrict (relativeCycles R A (m + 1)) q
    (fun x ↦ by rw [hq]; exact hmem x), fun z hz ↦ Subtype.ext ?_⟩
  have hz0 : D.rangeRestrict z = 0 := Subtype.ext ((hker z).1 hz)
  rw [LinearMap.codRestrict_apply, hq, hz0, map_zero, sub_zero]

/-- If `H_k(Y, A) = 0` for `k < n`, the relative `n`-cycles are a direct summand of the
`n`-chains: a projection onto them. -/
lemma exists_relativeCycles_projection_of_vanishing {A : Set Y} {n : ℕ}
    (hvan : ∀ k < n, RelHomologyVanishing R univ A k) :
    ∃ pr : Chain R Y n →ₗ[R] relativeCycles R A n,
      ∀ z (hz : z ∈ relativeCycles R A n), pr z = ⟨z, hz⟩ := by
  cases n with
  | zero => exact ⟨LinearMap.codRestrict _ LinearMap.id fun _ ↦ trivial, fun _ _ ↦ rfl⟩
  | succ m => exact exists_relativeCycles_projection_succ hvan

/-- A linear form on `n`-chains is the evaluation of the cochain of its values on simplices. -/
lemma eval_apply_single_one {n : ℕ} (ψ : Chain R Y n →ₗ[R] R) :
    eval (fun σ ↦ ψ (single σ 1)) = ψ := by
  ext σ
  simp [eval]

/-- A linear form on `n`-chains vanishing on chains in `A` and on boundaries defines a relative
`n`-cocycle by its values on simplices. -/
lemma mem_relCocycles_of_linearMap {A : Set Y} {n : ℕ} (ψ : Chain R Y n →ₗ[R] R)
    (h₁ : ∀ x ∈ inside R n A, ψ x = 0) (h₂ : ∀ w, ψ (bd R n w) = 0) :
    (fun σ ↦ ψ (single σ 1)) ∈ relCocycles R A n := by
  refine ⟨fun σ hσ ↦ h₁ _ (single_mem_supported R _ hσ), ?_⟩
  change coboundary R n _ = 0
  funext τ
  have h := eval_coboundary n (fun σ ↦ ψ (single σ 1)) (single τ 1)
  rw [eval_apply_single_one] at h
  simp only [eval, linearCombination_single, one_smul] at h
  rw [Pi.zero_apply, h, h₂]

/-- **Existence of a relative cocycle with prescribed values on generators.** If `H_k(Y, A) = 0`
for `k < n`, `H_n(Y, A)` is generated by a submodule `G` of relative cycles, and a linear form
`λ` vanishes on the elements of `G` that are relative boundaries, then some relative cocycle
agrees with `λ` on `G`. -/
theorem exists_mem_relCocycles_eval_eq {A : Set Y} {n : ℕ}
    (hvan : ∀ k < n, RelHomologyVanishing R univ A k) {G : Submodule R (Chain R Y n)}
    (hGZ : G ≤ relativeCycles R A n) (hG : RelHomologyGenerated R univ A n G)
    (lam : Chain R Y n →ₗ[R] R) (hfree : ∀ g ∈ G, IsRelBoundaryIn R univ A n g → lam g = 0) :
    ∃ φ ∈ relCocycles R A n, ∀ g ∈ G, eval φ g = lam g := by
  classical
  set B' : Submodule R (Chain R Y n) := inside R n A ⊔ LinearMap.range (bd R n)
  have hZ : relativeCycles R A n ≤ G ⊔ B' := fun c hc ↦ by
    obtain ⟨g, hg, w, -, hw⟩ := hG c (mem_inside_univ c) hc
    rw [univ_inter] at hw
    rw [show c = g + ((c - g - bd R n w) + bd R n w) by abel]
    exact Submodule.add_mem_sup hg (Submodule.add_mem_sup hw ⟨w, rfl⟩)
  -- the functional on `G ⊔ B'`: `λ` on `G`, `0` on `B'`
  let f : Chain R Y n →ₗ.[R] R := ⟨G, lam ∘ₗ G.subtype⟩
  let g : Chain R Y n →ₗ.[R] R := ⟨B', 0⟩
  have H : ∀ (x : f.domain) (y : g.domain), (x : Chain R Y n) = y → f x = g y := by
    rintro ⟨x, hx⟩ ⟨y, hy⟩ (hxy : x = y)
    change lam x = 0
    subst hxy
    obtain ⟨a, ha, b, ⟨w, rfl⟩, rfl⟩ := Submodule.mem_sup.1 hy
    exact hfree _ hx ⟨w, mem_inside_univ _, by rw [univ_inter, add_sub_cancel_right]; exact ha⟩
  let Λ := f.sup g H
  have hΛG : ∀ x (hx : x ∈ G) (h : x ∈ Λ.domain), Λ ⟨x, h⟩ = lam x := fun x hx h ↦
    (LinearPMap.sup_apply H ⟨x, hx⟩ 0 ⟨x, h⟩ (by simp)).trans (by simp [f, g])
  have hΛB : ∀ y (hy : y ∈ B') (h : y ∈ Λ.domain), Λ ⟨y, h⟩ = 0 := fun y hy h ↦
    (LinearPMap.sup_apply H 0 ⟨y, hy⟩ ⟨y, h⟩ (by simp)).trans (by simp [f, g])
  -- a projection `pr` of `C_n` onto the relative cycles
  obtain ⟨pr, hpr⟩ := exists_relativeCycles_projection_of_vanishing hvan
  have hZ' : relativeCycles R A n ≤ Λ.domain := hZ
  let ψ : Chain R Y n →ₗ[R] R := Λ.toFun ∘ₗ Submodule.inclusion hZ' ∘ₗ pr
  have hψZ : ∀ z (hz : z ∈ relativeCycles R A n), ψ z = Λ ⟨z, hZ' hz⟩ := fun z hz ↦ by
    simp only [ψ, LinearMap.comp_apply, hpr z hz]
    rfl
  refine ⟨fun σ ↦ ψ (single σ 1),
    mem_relCocycles_of_linearMap ψ (fun x hx ↦ ?_) (fun w ↦ ?_), fun x hx ↦ ?_⟩
  · rw [hψZ _ (inside_le_relativeCycles n hx)]
    exact hΛB _ (Submodule.mem_sup_left hx) _
  · rw [hψZ _ (bd_mem_relativeCycles n _)]
    exact hΛB _ (Submodule.mem_sup_right ⟨_, rfl⟩) _
  · rw [eval_apply_single_one, hψZ _ (hGZ hx)]
    exact hΛG _ hx _

end generic

end SingularCochain

namespace ThomClass

open SingularChain SingularCochain

variable {R : Type u} [CommRing R] {B : Type u} [TopologicalSpace B]
  (F : Type*) [NormedAddCommGroup F] [NormedSpace ℂ F] [FiniteDimensional ℂ F]
  (E : B → Type u) [∀ x, AddCommGroup (E x)] [∀ x, Module ℂ (E x)] [∀ x, TopologicalSpace (E x)]
  [TopologicalSpace (TotalSpace F E)] [FiberBundle F E] [_root_.VectorBundle ℂ F E]

section assembly

/-- Mayer–Vietoris for vanishing: if `H_k` vanishes for `(U, U ∩ A)` and `(V, V ∩ A)`, and
`H_{k-1}` vanishes for `(U ∩ V, U ∩ V ∩ A)`, then `H_k` vanishes for `(U ∪ V, (U ∪ V) ∩ A)`. -/
lemma _root_.MMP.SingularChain.RelHomologyVanishing.union {Y : Type*} [TopologicalSpace Y]
    {U V A : Set Y} {k : ℕ}
    (hU : IsOpen U) (hV : IsOpen V) (hUa : RelHomologyVanishing R U A k)
    (hVa : RelHomologyVanishing R V A k)
    (hUV : ∀ j, j + 1 = k → RelHomologyVanishing R (U ∩ V) A j) :
    RelHomologyVanishing R (U ∪ V) A k := by
  cases k with
  | zero => exact SingularChain.RelHomologyVanishing.union_zero hU hV hUa hVa
  | succ j => exact SingularChain.RelHomologyVanishing.union_succ hU hV hUa hVa (hUV j rfl)

/-- Mayer–Vietoris for generation: if `H_k` of `(U, U ∩ A)` is generated by `GU` and of
`(V, V ∩ A)` by `GV`, and `H_{k-1}` vanishes for `(U ∩ V, U ∩ V ∩ A)`, then `H_k` of
`(U ∪ V, (U ∪ V) ∩ A)` is generated by `GU ⊔ GV`. -/
lemma _root_.MMP.SingularChain.RelHomologyGenerated.union {Y : Type*} [TopologicalSpace Y]
    {U V A : Set Y} {k : ℕ}
    {GU GV : Submodule R (Chain R Y k)} (hU : IsOpen U) (hV : IsOpen V)
    (hUa : RelHomologyGenerated R U A k GU) (hVa : RelHomologyGenerated R V A k GV)
    (hUV : ∀ j, j + 1 = k → RelHomologyVanishing R (U ∩ V) A j) :
    RelHomologyGenerated R (U ∪ V) A k (GU ⊔ GV) := by
  cases k with
  | zero => exact SingularChain.RelHomologyGenerated.union_zero hU hV hUa hVa
  | succ j => exact SingularChain.RelHomologyGenerated.union_succ hU hV hUa hVa (hUV j rfl)

variable (R) in
/-- Vanishing below `2r`, generation by fibre simplices and freeness of their coefficient sum,
for the relative homology of `(E|_T, E|_T - 0)`. -/
def ThomHomology (T : Set B) : Prop :=
  (∀ k < 2 * Module.finrank ℂ F,
      RelHomologyVanishing R (TotalSpace.proj ⁻¹' T : Set (TotalSpace F E))
        (range (zeroSection F E))ᶜ k) ∧
    RelHomologyGenerated R (TotalSpace.proj ⁻¹' T : Set (TotalSpace F E))
      (range (zeroSection F E))ᶜ (2 * Module.finrank ℂ F)
      (spanIn R (fibreSimplices F E) (TotalSpace.proj ⁻¹' T)) ∧
    AugFree R (TotalSpace.proj ⁻¹' T : Set (TotalSpace F E)) (range (zeroSection F E))ᶜ
      (2 * Module.finrank ℂ F) (fibreSimplices F E)

omit [FiniteDimensional ℂ F] [_root_.VectorBundle ℂ F E] in
/-- `ThomHomology` holds over the empty set. -/
lemma thomHomology_empty : ThomHomology R F E ∅ := by
  simp only [ThomHomology, preimage_empty]
  exact ⟨fun _ _ ↦ relHomologyVanishing_empty, relHomologyGenerated_empty _, augFree_empty _⟩

/-- `ThomHomology` holds over any subset of the base of a trivialisation, in positive rank. -/
lemma thomHomology_of_subset_baseSet (hr : 0 < Module.finrank ℂ F) {b : B} {U : Set B}
    (hU : U ⊆ (trivializationAt F E b).baseSet) : ThomHomology R F E U :=
  ⟨fun _ hk ↦ relHomologyVanishing_chart R b hU hk, relHomologyGenerated_chart R b hU hr,
    augFree_chart R b hU⟩

/-- **The Mayer–Vietoris step** for `ThomHomology`: it passes from `U`, `V` and `U ∩ V` to
`U ∪ V`. -/
lemma ThomHomology.union {U V : Set B} (hU : IsOpen U) (hV : IsOpen V)
    (hUa : ThomHomology R F E U) (hVa : ThomHomology R F E V)
    (hUV : ThomHomology R F E (U ∩ V)) : ThomHomology R F E (U ∪ V) := by
  have hU' : IsOpen (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E)) :=
    hU.preimage (FiberBundle.continuous_proj F E)
  have hV' : IsOpen (TotalSpace.proj ⁻¹' V : Set (TotalSpace F E)) :=
    hV.preimage (FiberBundle.continuous_proj F E)
  obtain ⟨hU1, hU2, hU3⟩ := hUa
  obtain ⟨hV1, hV2, hV3⟩ := hVa
  obtain ⟨hUV1, hUV2, hUV3⟩ := hUV
  rw [ThomHomology, preimage_union]
  rw [preimage_inter] at hUV1 hUV2 hUV3
  refine ⟨fun k hk ↦ RelHomologyVanishing.union hU' hV' (hU1 k hk) (hV1 k hk)
      (fun j hj ↦ hUV1 j (by omega)),
    (RelHomologyGenerated.union hU' hV' hU2 hV2 (fun j hj ↦ hUV1 j (by omega))).mono
      (sup_le (spanIn_mono subset_union_left) (spanIn_mono subset_union_right)),
    AugFree.union hU' hV' ?_ (fun σ hσ ↦ single_mem_relativeCycles_of_mem_fibreSimplices F E hσ)
      hU3 hV3 hUV2⟩
  rintro σ ⟨x, ψ, v, -, rfl⟩ hσ
  have hx := hσ ⟨stdSimplex.vertex 0, rfl⟩
  change x ∈ U ∪ V at hx
  have key : ∀ W : Set B, x ∈ W →
      range (fibreSimplex F x ψ v) ⊆ TotalSpace.proj ⁻¹' W := fun W hW ↦
    (range_fibreSimplex_subset F E x ψ v).trans fun p hp ↦ by
      change p.proj ∈ W
      rw [show p.proj = x from hp]
      exact hW
  exact hx.imp (key U) (key V)

/-- The union of a list of sets. -/
def listUnion : List (Set B) → Set B
  | [] => ∅
  | U :: l => U ∪ listUnion l

omit [TopologicalSpace B] in
/-- A point lies in `listUnion l` if and only if it lies in some member of `l`. -/
lemma mem_listUnion {x : B} : ∀ {l : List (Set B)}, x ∈ listUnion l ↔ ∃ U ∈ l, x ∈ U
  | [] => by simp [listUnion]
  | U :: l => by simp [listUnion, mem_listUnion]

omit [TopologicalSpace B] in
/-- Intersection with `U` distributes over `listUnion`. -/
lemma inter_listUnion (U : Set B) :
    ∀ l : List (Set B), U ∩ listUnion l = listUnion (l.map (U ∩ ·))
  | [] => by simp [listUnion]
  | V :: l => by simp [listUnion, inter_union_distrib_left, inter_listUnion U l]

/-- The union of a list of open sets is open. -/
lemma isOpen_listUnion : ∀ {l : List (Set B)}, (∀ U ∈ l, IsOpen U) → IsOpen (listUnion l)
  | [], _ => isOpen_empty
  | U :: l, h => (h U (by simp)).union (isOpen_listUnion fun V hV ↦ h V (by simp [hV]))

/-- Open sets inside the base of a trivialisation of the atlas. -/
def IsTrivialisingOpen (U : Set B) : Prop :=
  IsOpen U ∧ ∃ b, U ⊆ (trivializationAt F E b).baseSet

/-- **`ThomHomology` over a finite union of trivialising opens** (Milnor–Stasheff, §10, Case 2). -/
theorem thomHomology_listUnion (hr : 0 < Module.finrank ℂ F) :
    ∀ l : List (Set B), (∀ U ∈ l, IsTrivialisingOpen F E U) →
      ThomHomology R F E (listUnion l) := by
  suffices h : ∀ m (l : List (Set B)), l.length = m → (∀ U ∈ l, IsTrivialisingOpen F E U) →
      ThomHomology R F E (listUnion l) from fun l ↦ h _ l rfl
  intro m
  induction m with
  | zero =>
    intro l hl _
    rw [List.length_eq_zero_iff.1 hl]
    exact thomHomology_empty F E
  | succ m ih =>
    intro l hl hgood
    obtain ⟨U, l', rfl⟩ := List.exists_cons_of_length_eq_add_one hl
    have hl' : l'.length = m := by simpa using hl
    have hU := hgood U (by simp)
    have hgood' : ∀ V ∈ l', IsTrivialisingOpen F E V := fun V hV ↦ hgood V (by simp [hV])
    obtain ⟨b, hb⟩ := hU.2
    refine ThomHomology.union F E hU.1 (isOpen_listUnion fun V hV ↦ (hgood' V hV).1)
      (thomHomology_of_subset_baseSet F E hr hb) (ih l' hl' hgood') ?_
    rw [inter_listUnion]
    refine ih _ (by simpa using hl') fun V hV ↦ ?_
    obtain ⟨W, hW, rfl⟩ := List.mem_map.1 hV
    exact ⟨hU.1.inter (hgood' W hW).1, b, inter_subset_left.trans hb⟩

omit [NormedSpace ℂ F] [FiniteDimensional ℂ F] [∀ x, Module ℂ (E x)]
  [_root_.VectorBundle ℂ F E] in
/-- Every finite set of singular simplices of `E` lies over a finite union of trivialising opens
(Milnor–Stasheff, §10, Case 4: compactness). -/
lemma exists_listUnion_cover {k : ℕ} (s : Finset (Simplex (TotalSpace F E) k)) :
    ∃ l : List (Set B), (∀ U ∈ l, IsTrivialisingOpen F E U) ∧
      ∀ σ ∈ s, range σ ⊆ TotalSpace.proj ⁻¹' listUnion l := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨[], by simp, by simp⟩
  | insert σ s _ ih =>
    obtain ⟨l, hl, hls⟩ := ih
    have hK : IsCompact (range (TotalSpace.proj ∘ σ)) :=
      isCompact_range ((FiberBundle.continuous_proj F E).comp σ.continuous)
    obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun x : B ↦ (trivializationAt F E x).baseSet)
      (fun x ↦ (trivializationAt F E x).open_baseSet)
      (fun y _ ↦ mem_iUnion.2 ⟨y, mem_baseSet_trivializationAt F E y⟩)
    refine ⟨t.toList.map (fun x ↦ (trivializationAt F E x).baseSet) ++ l, ?_, ?_⟩
    · intro U hU
      rcases List.mem_append.1 hU with hU | hU
      · obtain ⟨x, -, rfl⟩ := List.mem_map.1 hU
        exact ⟨(trivializationAt F E x).open_baseSet, x, subset_rfl⟩
      · exact hl U hU
    · intro τ hτ p hp
      change TotalSpace.proj p ∈ listUnion _
      rw [mem_listUnion]
      rcases Finset.mem_insert.1 hτ with rfl | hτ
      · obtain ⟨t', rfl⟩ := hp
        obtain ⟨x, hx, hpx⟩ := mem_iUnion₂.1 (ht ⟨t', rfl⟩)
        exact ⟨_, List.mem_append_left _ (List.mem_map.2 ⟨x, Finset.mem_toList.2 hx, rfl⟩), hpx⟩
      · obtain ⟨U, hU, hpU⟩ := mem_listUnion.1 (hls τ hτ hp)
        exact ⟨U, List.mem_append_right _ hU, hpU⟩

/-- Every singular chain of `E` is supported over a finite union of trivialising opens. -/
lemma exists_listUnion_cover_chain {k : ℕ} (c : Chain R (TotalSpace F E) k) :
    ∃ l : List (Set B), (∀ U ∈ l, IsTrivialisingOpen F E U) ∧
      c ∈ inside R k (TotalSpace.proj ⁻¹' listUnion l) := by
  obtain ⟨l, hl, hls⟩ := exists_listUnion_cover F E c.support
  exact ⟨l, hl, (mem_supported R c).2 fun σ hσ ↦ hls σ hσ⟩

/-- `listUnion` sends concatenation of lists to union of sets. -/
lemma listUnion_append (l₁ l₂ : List (Set B)) :
    listUnion (l₁ ++ l₂) = listUnion l₁ ∪ listUnion l₂ := by
  ext x
  simp [mem_listUnion, or_and_right, exists_or]

end assembly

section rankZero

variable {F E}

/-- In rank `0` every fibre of `E` is a subsingleton. -/
lemma subsingleton_fibre_of_finrank_eq_zero (hr : Module.finrank ℂ F = 0) (x : B) :
    Subsingleton (E x) := by
  have : Subsingleton F := Module.finrank_zero_iff.1 hr
  exact ((trivializationAt F E x).continuousLinearEquivAt ℂ x
    (mem_baseSet_trivializationAt F E x)).toEquiv.injective.subsingleton

/-- In dimension `0` the constant zero family is an oriented simplex around zero. -/
lemma isOrientedSimplexAroundZero_zero_of_eq_zero {V : Type*} [AddCommGroup V] [Module ℝ V]
    {n : ℕ} (hn : n = 0) (b : Module.Basis (Fin n) ℝ V) :
    IsOrientedSimplexAroundZero b (fun _ : Fin (n + 1) ↦ (0 : V)) := by
  subst hn
  exact ⟨⟨fun _ ↦ 1, fun _ ↦ one_pos, by simp, by simp⟩, by simp⟩

/-- In rank `0` every singular `0`-simplex of `E` is a fibre simplex. -/
lemma mem_fibreSimplices_of_finrank_eq_zero (hr : Module.finrank ℂ F = 0)
    (σ : Simplex (TotalSpace F E) (2 * Module.finrank ℂ F)) : σ ∈ fibreSimplices F E := by
  have : Subsingleton (stdSimplex ℝ (Fin (2 * Module.finrank ℂ F + 1))) := by
    rw [show 2 * Module.finrank ℂ F + 1 = 1 by omega]
    infer_instance
  set p := σ (stdSimplex.vertex 0)
  have := subsingleton_fibre_of_finrank_eq_zero (E := E) hr p.proj
  refine ⟨p.proj, (modelFrame F).trans ((trivializationAt F E p.proj).continuousLinearEquivAt ℂ
    p.proj (mem_baseSet_trivializationAt F E p.proj)).symm, fun _ ↦ 0,
    isOrientedSimplexAroundZero_zero_of_eq_zero (by omega) _, ?_⟩
  ext1 t
  rw [fibreSimplex_apply, Subsingleton.elim t (stdSimplex.vertex 0)]
  change TotalSpace.mk p.proj _ = p
  obtain ⟨x, w⟩ := p
  exact congrArg (TotalSpace.mk x) (Subsingleton.elim _ _)

/-- In rank `0` the complement of the zero section of `E` is empty. -/
lemma compl_range_zeroSection_eq_empty_of_finrank_eq_zero (hr : Module.finrank ℂ F = 0) :
    (range (zeroSection F E))ᶜ = ∅ := by
  ext p
  have := subsingleton_fibre_of_finrank_eq_zero (E := E) hr p.proj
  simp only [mem_compl_iff, mem_empty_iff_false, iff_false, not_not]
  exact (mem_range_zeroSection_iff F E).2 (Subsingleton.elim _ _)

/-- The augmentation of the boundary of a singular `1`-chain is `0`. -/
lemma aug_bd_eq_zero_of_eq_zero {Y : Type*} [TopologicalSpace Y] {k : ℕ} (hk : k = 0)
    (w : Chain R Y (k + 1)) : aug R k (bd R k w) = 0 := by
  subst hk
  exact aug_bd_zero w

end rankZero

section global

/-- **`H_k(E, E - 0_E; R) = 0` for `k < 2r`** (Milnor–Stasheff, Thm. 10.4). -/
theorem relHomologyVanishing_bundle {k : ℕ} (hk : k < 2 * Module.finrank ℂ F) :
    RelHomologyVanishing R (univ : Set (TotalSpace F E)) (range (zeroSection F E))ᶜ k := by
  intro c _ hcz
  obtain ⟨l, hl, hc⟩ := exists_listUnion_cover_chain F E c
  exact ((thomHomology_listUnion F E (by omega) l hl).1 k hk c hc hcz).mono (subset_univ _)
    subset_rfl

/-- **`H_{2r}(E, E - 0_E; R)` is generated by the fibre simplices.** -/
theorem relHomologyGenerated_bundle :
    RelHomologyGenerated R (univ : Set (TotalSpace F E)) (range (zeroSection F E))ᶜ
      (2 * Module.finrank ℂ F) (spanIn R (fibreSimplices F E) univ) := by
  intro c _ hcz
  rcases Nat.eq_zero_or_pos (Module.finrank ℂ F) with hr | hr
  · refine ⟨c, (mem_supported R c).2 fun σ _ ↦
      ⟨mem_fibreSimplices_of_finrank_eq_zero hr σ, subset_univ _⟩, ?_⟩
    rw [sub_self]
    exact isRelBoundaryIn_zero
  · obtain ⟨l, hl, hc⟩ := exists_listUnion_cover_chain F E c
    obtain ⟨g, hg, hcg⟩ := (thomHomology_listUnion (R := R) F E hr l hl).2.1 c hc hcz
    exact ⟨g, spanIn_mono (subset_univ _) hg, hcg.mono (subset_univ _) subset_rfl⟩

/-- **A combination of fibre simplices which is a relative boundary of `(E, E - 0_E)` has
coefficient sum `0`.** -/
theorem augFree_bundle :
    AugFree R (univ : Set (TotalSpace F E)) (range (zeroSection F E))ᶜ
      (2 * Module.finrank ℂ F) (fibreSimplices F E) := by
  rintro g hg ⟨w, -, hgw⟩
  rcases Nat.eq_zero_or_pos (Module.finrank ℂ F) with hr | hr
  · rw [univ_inter, compl_range_zeroSection_eq_empty_of_finrank_eq_zero hr] at hgw
    rw [show g = bd R _ w by rw [← sub_eq_zero]; exact eq_zero_of_mem_inside_empty hgw]
    exact aug_bd_eq_zero_of_eq_zero (by omega) w
  · obtain ⟨l₁, hl₁, hg₁⟩ := exists_listUnion_cover_chain F E g
    obtain ⟨l₂, hl₂, hw₂⟩ := exists_listUnion_cover_chain F E w
    have hl : ∀ U ∈ l₁ ++ l₂, IsTrivialisingOpen F E U := fun U hU ↦
      (List.mem_append.1 hU).elim (hl₁ U) (hl₂ U)
    set S : Set (TotalSpace F E) := TotalSpace.proj ⁻¹' listUnion (l₁ ++ l₂)
    have hS₁ : TotalSpace.proj ⁻¹' listUnion l₁ ⊆ S :=
      preimage_mono (by rw [listUnion_append]; exact subset_union_left)
    have hS₂ : TotalSpace.proj ⁻¹' listUnion l₂ ⊆ S :=
      preimage_mono (by rw [listUnion_append]; exact subset_union_right)
    have hgS : g ∈ inside R _ S := inside_mono _ hS₁ hg₁
    have hwS : w ∈ inside R _ S := inside_mono _ hS₂ hw₂
    refine (thomHomology_listUnion (R := R) F E hr _ hl).2.2 g ?_ ⟨w, hwS, ?_⟩
    · exact (mem_supported R g).2 fun σ hσ ↦
        ⟨((mem_supported R g).1 hg hσ).1, (mem_supported R g).1 hgS hσ⟩
    · rw [univ_inter] at hgw
      rw [inside_inter]
      exact ⟨Submodule.sub_mem _ hgS (bd_mem_inside hwS), hgw⟩

end global

section thom

/-- Every combination of fibre simplices is a relative `2r`-cycle of `(E, E - 0_E)`. -/
lemma spanIn_fibreSimplices_le_relativeCycles :
    spanIn R (fibreSimplices F E) univ ≤
      relativeCycles R (range (zeroSection F E))ᶜ (2 * Module.finrank ℂ F) := by
  rw [spanIn, supported_eq_span_single, Submodule.span_le]
  rintro _ ⟨σ, hσ, rfl⟩
  exact single_mem_relativeCycles_of_mem_fibreSimplices F E hσ.1

omit [FiniteDimensional ℂ F] [_root_.VectorBundle ℂ F E] in
/-- The class of a relative cocycle `φ` is a Thom class if and only if `φ` takes the value `1` on
every fibre simplex. -/
lemma isThomClass_iff_eval
    {φ : relCocycles R (range (zeroSection F E))ᶜ (2 * Module.finrank ℂ F)} :
    IsThomClass (R := R) F E ((relativeSingularCohomologyEquiv R
        (Y := TopCat.of (TotalSpace F E)) _ _).symm (Submodule.Quotient.mk φ)) ↔
      ∀ σ ∈ fibreSimplices F E, eval φ.1 (single σ 1) = 1 := by
  constructor
  · rintro h _ ⟨x, ψ, v, hv, rfl⟩
    have := h x ψ v hv
    rwa [LinearEquiv.apply_symm_apply, relEval_mk] at this
  · intro h x ψ v hv
    rw [LinearEquiv.apply_symm_apply, relEval_mk]
    exact h _ ⟨x, ψ, v, hv, rfl⟩

/-- **Thom's theorem** (Milnor–Stasheff, Thm. 10.4): a complex topological vector bundle on any
space has exactly one Thom class, for any coefficient ring. -/
theorem existsUnique_isThomClass :
    ∃! u : cohomologyWithSupports R (ModuleCat.of R R) (TopCat.of (TotalSpace F E))
      (range (zeroSection F E)) (2 * Module.finrank ℂ F : ℕ), IsThomClass F E u := by
  set e := relativeSingularCohomologyEquiv R (Y := TopCat.of (TotalSpace F E))
    (range (zeroSection F E))ᶜ (2 * Module.finrank ℂ F)
  obtain ⟨φ, hφ, hφG⟩ := exists_mem_relCocycles_eval_eq (R := R)
    (fun k hk ↦ relHomologyVanishing_bundle F E hk) (spanIn_fibreSimplices_le_relativeCycles F E)
    (relHomologyGenerated_bundle F E) (aug R _) (fun g hg hb ↦ augFree_bundle F E g hg hb)
  refine ⟨e.symm (Submodule.Quotient.mk ⟨φ, hφ⟩), (isThomClass_iff_eval F E).2 fun σ hσ ↦ ?_,
    fun u hu ↦ ?_⟩
  · rw [hφG _ (single_mem_supported R _ ⟨hσ, subset_univ _⟩), aug_single]
  · obtain ⟨φ', hφ'⟩ := Submodule.Quotient.mk_surjective _ (e u)
    rw [← e.symm_apply_apply u, ← hφ'] at hu ⊢
    have h1 := (isThomClass_iff_eval F E).1 hu
    congr 1
    refine (Submodule.Quotient.eq _).2 ?_
    change φ'.1 - φ ∈ relCoboundaries R _ _
    refine mem_relCoboundaries_of_relHomologyVanishing
      (fun k hk ↦ relHomologyVanishing_bundle F E hk) fun c hc ↦ ?_
    refine eval_eq_zero_of_relHomologyGenerated (relHomologyGenerated_bundle F E)
      (Submodule.sub_mem _ φ'.2 hφ) (fun g hg ↦ ?_) hc
    rw [spanIn, supported_eq_span_single] at hg
    induction hg using Submodule.span_induction with
    | mem _ hx =>
      obtain ⟨σ, hσ, rfl⟩ := hx
      rw [eval_sub_cochain, h1 σ hσ.1, hφG _ (single_mem_supported R _ hσ), aug_single, sub_self]
    | zero => simp [eval, linearCombination_apply]
    | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
    | smul a x _ hx => rw [map_smul, hx, smul_zero]

variable (R) in
/-- **The Thom class** `u_E ∈ H^{2r}(E, E - 0_E; R)` of a complex topological vector bundle `E`
of rank `r` on a space `B` (Fulton, §19.1): the Thom class of the orientation of `E` given by its
complex structure (Milnor–Stasheff, §§9–10), the unique class satisfying `IsThomClass`. -/
def thomClass : cohomologyWithSupports R (ModuleCat.of R R) (TopCat.of (TotalSpace F E))
    (range (zeroSection F E)) (2 * Module.finrank ℂ F : ℕ) :=
  (existsUnique_isThomClass (R := R) F E).exists.choose

/-- `thomClass R F E` is a Thom class. -/
lemma isThomClass_thomClass : IsThomClass F E (thomClass R F E) :=
  (existsUnique_isThomClass (R := R) F E).exists.choose_spec

/-- A Thom class is the Thom class. -/
lemma eq_thomClass {u : cohomologyWithSupports R (ModuleCat.of R R) (TopCat.of (TotalSpace F E))
    (range (zeroSection F E)) (2 * Module.finrank ℂ F : ℕ)} (hu : IsThomClass F E u) :
    u = thomClass R F E :=
  (existsUnique_isThomClass (R := R) F E).unique hu (isThomClass_thomClass F E)

/-- A class is a Thom class if and only if it is `thomClass R F E`. -/
lemma isThomClass_iff_eq_thomClass {u : cohomologyWithSupports R (ModuleCat.of R R)
    (TopCat.of (TotalSpace F E)) (range (zeroSection F E)) (2 * Module.finrank ℂ F : ℕ)} :
    IsThomClass F E u ↔ u = thomClass R F E :=
  ⟨eq_thomClass F E, fun h ↦ h ▸ isThomClass_thomClass F E⟩

end thom

end ThomClass

end MMP
