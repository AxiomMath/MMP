module

public import MMP.AlgebraicTopology.ThomClass.Isomorphism.MayerVietoris

/-!
# The relative homology of `W × (ℝⁿ, ℝⁿ - 0)` in degrees `≤ n`

For every space `W`, in the finite singular chain model:

* `H_k(W × ℝⁿ, W × (ℝⁿ - 0); R) = 0` for `k < n`;
* `H_n(W × ℝⁿ, W × (ℝⁿ - 0); R)` is generated by relative cycles each lying in one fibre
  `{x} × ℝⁿ`.

This is the local computation of Thom's theorem (Milnor–Stasheff, §10, Case 1), the low-degree
part of `H_k(W × (ℝⁿ, ℝⁿ - 0)) ≅ H_{k - n}(W)`. The proof is by induction on `n` (a relative
suspension): with `H₊`, `H₋` the complements of the closed positive and negative last half-axes,
`W × (ℝⁿ⁺¹ - 0) = W × H₊ ∪ W × H₋`; `W × H₋` is a deformation retract of `W × ℝⁿ⁺¹` (star-shaped
fibres), and `(W × H₊, W × (H₊ ∩ H₋))` is homotopy equivalent to `W × (ℝⁿ, ℝⁿ - 0)` through
`y ↦ Fin.init y` and `z ↦ (z, 1)`. A relative cycle `c` of degree `k + 1` has boundary
`a + b` with `a` in `W × H₊`, `b` in `W × H₋` (subdivision); `a` is a relative `k`-cycle of
`(W × H₊, W × (H₊ ∩ H₋))`, which is handled by induction, and the rest deforms into `W × H₋`.

## Main results

* `MMP.SingularChain.relHomologyVanishing_prod_punctured`
* `MMP.SingularChain.relHomologyGenerated_prod_punctured`

## References

* [J. Milnor, J. Stasheff, *Characteristic classes*][milnorstasheff1974], §10.
* [A. Hatcher, *Algebraic Topology*][hatcher2002], §2.2 and §4.D.
-/

@[expose] public noncomputable section

open Finsupp Set

namespace MMP

namespace SingularChain

variable {R : Type*} [CommRing R] {Y X : Type*} [TopologicalSpace Y]

section fibre

variable (R) in
/-- Relative cycles of `(S, S ∩ A)` lying in one fibre of `π`, and their sums. -/
def fibreCycles (π : Y → X) (S A : Set Y) (k : ℕ) : Submodule R (Chain R Y k) :=
  ⨆ x : X, inside R k (S ∩ π ⁻¹' {x}) ⊓ relativeCycles R A k

/-- Every chain of `fibreCycles R π S A k` is supported in `S`. -/
lemma fibreCycles_le_inside (π : Y → X) (S A : Set Y) (k : ℕ) :
    fibreCycles R π S A k ≤ inside R k S :=
  iSup_le fun _ ↦ inf_le_left.trans (inside_mono _ inter_subset_left)

/-- Every chain of `fibreCycles R π S A k` is a relative cycle of `(Y, A)`. -/
lemma fibreCycles_le_relativeCycles (π : Y → X) (S A : Set Y) (k : ℕ) :
    fibreCycles R π S A k ≤ relativeCycles R A k :=
  iSup_le fun _ ↦ inf_le_right

/-- A relative cycle of `(Y, A)` supported in `S ∩ π⁻¹ {x}` lies in `fibreCycles R π S A k`. -/
lemma mem_fibreCycles_of_mem_inside {π : Y → X} {S A : Set Y} {k : ℕ} {c : Chain R Y k}
    (x : X) (hc : c ∈ inside R k (S ∩ π ⁻¹' {x})) (hcz : c ∈ relativeCycles R A k) :
    c ∈ fibreCycles R π S A k :=
  (le_iSup (fun x ↦ inside R k (S ∩ π ⁻¹' {x}) ⊓ relativeCycles R A k) x) ⟨hc, hcz⟩

end fibre

/-- For a homotopy `F` from the identity to `h` keeping `B`, and a relative cycle `c` of
`(Y, B)`, `∂ P c - (h_# c - c)` lies in `B`. -/
lemma bd_prism_sub_mem_inside (F : C(Y × unitInterval, Y)) (h : C(Y, Y))
    (hF₀ : ∀ y, F (y, 0) = y) (hF₁ : ∀ y, F (y, 1) = h y) {B : Set Y}
    (hFB : MapsTo F (B ×ˢ univ) B) {k : ℕ} {c : Chain R Y k} (hc : c ∈ relativeCycles R B k) :
    bd R k (prism R F k c) - (postcomp R h k c - c) ∈ inside R k B := by
  cases k with
  | zero =>
    rw [bd_prism_zero (R := R) F (f := ContinuousMap.id Y) (g := h) hF₀ hF₁,
      postcomp_id, sub_self]
    exact Submodule.zero_mem _
  | succ k =>
    have := bd_prism_add_prism_bd (R := R) F (f := ContinuousMap.id Y) (g := h) hF₀
      hF₁ k c
    rw [postcomp_id] at this
    rw [← this, sub_add_cancel_left]
    exact Submodule.neg_mem _ (prism_mem_inside F hFB (mem_relativeCycles_succ.1 hc))

section product

variable {W : Type*} [TopologicalSpace W]

variable (W) in
/-- `W × (ℝⁿ - 0)`. -/
def punctured (n : ℕ) : Set (W × (Fin n → ℝ)) := Prod.snd ⁻¹' {0}ᶜ

variable (W) in
/-- `W × H_ε`, `H_ε` the complement of the closed half-axis `{t • (-ε) e | t ≥ 0}`. -/
def halfPunctured (n : ℕ) (ε : ℝ) : Set (W × (Fin (n + 1) → ℝ)) :=
  Prod.snd ⁻¹' halfAxisCompl n ε

variable (W) in
/-- `W × (ℝⁿ⁺¹ - ℝ e)`, off the last axis. -/
def offAxis (n : ℕ) : Set (W × (Fin (n + 1) → ℝ)) := Prod.snd ⁻¹' {y | Fin.init y ≠ 0}

/-- `W × H_ε` is open. -/
lemma isOpen_halfPunctured (n : ℕ) (ε : ℝ) : IsOpen (halfPunctured W n ε) :=
  (isOpen_halfAxisCompl n ε).preimage continuous_snd

omit [TopologicalSpace W] in
/-- `W × H₊ ∪ W × H₋ = W × (ℝⁿ⁺¹ - 0)`. -/
lemma halfPunctured_union (n : ℕ) :
    halfPunctured W n 1 ∪ halfPunctured W n (-1) = punctured W (n + 1) := by
  rw [halfPunctured, halfPunctured, ← preimage_union, halfAxisCompl_union]
  rfl

omit [TopologicalSpace W] in
/-- `W × H₊ ∩ W × H₋ = W × (ℝⁿ⁺¹ - ℝ e)`. -/
lemma halfPunctured_inter (n : ℕ) :
    halfPunctured W n 1 ∩ halfPunctured W n (-1) = offAxis W n := by
  rw [halfPunctured, halfPunctured, ← preimage_inter, halfAxisCompl_inter]
  rfl

omit [TopologicalSpace W] in
/-- `W × (ℝⁿ⁺¹ - ℝ e) ⊆ W × H_ε`. -/
lemma offAxis_subset_halfPunctured (n : ℕ) {ε : ℝ} : offAxis W n ⊆ halfPunctured W n ε :=
  fun _ h ↦ Or.inl h

omit [TopologicalSpace W] in
/-- `W × H_ε ⊆ W × (ℝⁿ⁺¹ - 0)`. -/
lemma halfPunctured_subset_punctured (n : ℕ) {ε : ℝ} :
    halfPunctured W n ε ⊆ punctured W (n + 1) := by
  rintro ⟨x, y⟩ (h | h) (rfl : y = 0)
  · exact h rfl
  · simp at h

/-- `(x, y) ↦ (x, Fin.init y)`. -/
def initProd (n : ℕ) : C(W × (Fin (n + 1) → ℝ), W × (Fin n → ℝ)) :=
  ⟨fun p ↦ (p.1, Fin.init p.2), continuous_fst.prodMk continuous_snd.finInit⟩

/-- `(x, z) ↦ (x, (z, 1))`. -/
def snocOneProd (n : ℕ) : C(W × (Fin n → ℝ), W × (Fin (n + 1) → ℝ)) :=
  ⟨fun p ↦ (p.1, Fin.snoc (α := fun _ ↦ ℝ) p.2 (1 : ℝ)),
    continuous_fst.prodMk (Continuous.finSnoc (n := n) (A := fun _ ↦ ℝ)
      (f := fun p : W × (Fin n → ℝ) ↦ p.2) (g := fun _ ↦ (1 : ℝ)) continuous_snd
      continuous_const)⟩

/-- The homotopy `((x, y), t) ↦ (x, (Fin.init y, (1 - t) + t yₙ))` from
`snocOneProd ∘ initProd` to the identity. -/
def liftHomotopy (n : ℕ) : C((W × (Fin (n + 1) → ℝ)) × unitInterval, W × (Fin (n + 1) → ℝ)) :=
  ⟨fun p ↦ (p.1.1, Fin.snoc (α := fun _ ↦ ℝ) (Fin.init p.1.2)
      ((1 - (p.2 : ℝ)) + (p.2 : ℝ) * p.1.2 (Fin.last n))),
    (continuous_fst.comp continuous_fst).prodMk
      ((continuous_snd.comp continuous_fst).finInit.finSnoc
        ((continuous_const.sub (continuous_subtype_val.comp continuous_snd)).add
          ((continuous_subtype_val.comp continuous_snd).mul
            ((continuous_apply _).comp (continuous_snd.comp continuous_fst)))))⟩

/-- The point `-e = (0, …, 0, -1)` of `H₋`. -/
def negAxisPoint (n : ℕ) : Fin (n + 1) → ℝ := Pi.single (Fin.last n) (-1)

/-- The fibrewise contraction `((x, y), t) ↦ (x, (1 - t) y + t (-e))` onto `W × {-e}`. -/
def contractHomotopy (n : ℕ) :
    C((W × (Fin (n + 1) → ℝ)) × unitInterval, W × (Fin (n + 1) → ℝ)) :=
  ⟨fun p ↦ (p.1.1, (p.2 : ℝ) • negAxisPoint n + (1 - (p.2 : ℝ)) • p.1.2),
    (continuous_fst.comp continuous_fst).prodMk
      (((continuous_subtype_val.comp continuous_snd).smul continuous_const).add
        ((continuous_const.sub (continuous_subtype_val.comp continuous_snd)).smul
          (continuous_snd.comp continuous_fst)))⟩

/-- `(x, y) ↦ (x, -e)`. -/
def toNegAxis (n : ℕ) : C(W × (Fin (n + 1) → ℝ), W × (Fin (n + 1) → ℝ)) :=
  ⟨fun p ↦ (p.1, negAxisPoint n), continuous_fst.prodMk continuous_const⟩

/-- `-e ∈ H₋`. -/
lemma negAxisPoint_mem_halfAxisCompl (n : ℕ) : negAxisPoint n ∈ halfAxisCompl n (-1) :=
  Or.inr (by simp [negAxisPoint])

/-- The fibrewise contraction keeps `W × H₋` in `W × H₋`. -/
lemma contractHomotopy_mapsTo (n : ℕ) :
    MapsTo (contractHomotopy (W := W) n) (halfPunctured W n (-1) ×ˢ univ)
      (halfPunctured W n (-1)) := by
  rintro ⟨⟨x, y⟩, t⟩ ⟨hy, -⟩
  exact starConvex_halfAxisCompl n (neg_ne_zero.2 one_ne_zero) hy t.2.1
    (sub_nonneg.2 t.2.2) (by ring)

/-- The fibrewise contraction keeps `S × ℝⁿ⁺¹` in `S × ℝⁿ⁺¹`. -/
lemma contractHomotopy_mapsTo_fibre (n : ℕ) (S : Set W) :
    MapsTo (contractHomotopy (W := W) n) ((Prod.fst ⁻¹' S) ×ˢ univ) (Prod.fst ⁻¹' S) :=
  fun _ hp ↦ hp.1

/-- At time `0` the fibrewise contraction is the identity. -/
lemma contractHomotopy_zero (n : ℕ) (p : W × (Fin (n + 1) → ℝ)) :
    contractHomotopy n (p, 0) = p := by
  simp [contractHomotopy]

/-- At time `1` the fibrewise contraction is `toNegAxis`. -/
lemma contractHomotopy_one (n : ℕ) (p : W × (Fin (n + 1) → ℝ)) :
    contractHomotopy n (p, 1) = toNegAxis n p := by
  simp [contractHomotopy, toNegAxis]

/-- `toNegAxis` maps every set into `W × H₋`. -/
lemma toNegAxis_mapsTo (n : ℕ) (S : Set (W × (Fin (n + 1) → ℝ))) :
    MapsTo (toNegAxis (W := W) n) S (halfPunctured W n (-1)) :=
  fun _ _ ↦ negAxisPoint_mem_halfAxisCompl n

/-- `H_k(W × ℝⁿ⁺¹, W × H₋) = 0`. -/
lemma relHomologyVanishing_univ_halfPunctured_neg (n k : ℕ) :
    RelHomologyVanishing R (univ : Set (W × (Fin (n + 1) → ℝ))) (halfPunctured W n (-1)) k :=
  relHomologyVanishing_of_homotopy (contractHomotopy n) (toNegAxis n) (contractHomotopy_zero n)
    (contractHomotopy_one n) (mapsTo_univ _ _)
    (by rw [univ_inter]; exact contractHomotopy_mapsTo n)
    (by rw [univ_inter]; exact toNegAxis_mapsTo n _) k

/-- At time `0` the homotopy `liftHomotopy` is `snocOneProd ∘ initProd`. -/
lemma liftHomotopy_zero (n : ℕ) (p : W × (Fin (n + 1) → ℝ)) :
    liftHomotopy n (p, 0) = snocOneProd n (initProd n p) := by
  simp [liftHomotopy, snocOneProd, initProd]

/-- At time `1` the homotopy `liftHomotopy` is the identity. -/
lemma liftHomotopy_one (n : ℕ) (p : W × (Fin (n + 1) → ℝ)) : liftHomotopy n (p, 1) = p := by
  simp [liftHomotopy]

/-- The homotopy `liftHomotopy` keeps `W × H₊` in `W × H₊`. -/
lemma liftHomotopy_mapsTo (n : ℕ) :
    MapsTo (liftHomotopy (W := W) n) (halfPunctured W n 1 ×ˢ univ) (halfPunctured W n 1) := by
  rintro ⟨⟨x, y⟩, t⟩ ⟨hy, -⟩
  change Fin.init (Fin.snoc (α := fun _ ↦ ℝ) (Fin.init y) _) ≠ 0 ∨ 0 < 1 * Fin.snoc
    (α := fun _ ↦ ℝ) (Fin.init y) _ (Fin.last n)
  rw [Fin.init_snoc, Fin.snoc_last, one_mul]
  rcases hy with h | h
  · exact Or.inl h
  · right
    have h' : 0 < y (Fin.last n) := by simpa using h
    have h0 : (0 : ℝ) ≤ t := t.2.1
    have h1 : (t : ℝ) ≤ 1 := t.2.2
    change 0 < 1 - (t : ℝ) + (t : ℝ) * y (Fin.last n)
    rcases h1.lt_or_eq with ht | ht
    · nlinarith [mul_nonneg h0 h'.le]
    · rw [ht]; linarith

/-- The homotopy `liftHomotopy` keeps `W × (H₊ ∩ H₋)` in `W × (H₊ ∩ H₋)`. -/
lemma liftHomotopy_mapsTo_offAxis (n : ℕ) :
    MapsTo (liftHomotopy (W := W) n) ((halfPunctured W n 1 ∩ offAxis W n) ×ˢ univ)
      (halfPunctured W n 1 ∩ offAxis W n) := by
  rintro ⟨⟨x, y⟩, t⟩ ⟨hy, -⟩
  refine ⟨liftHomotopy_mapsTo n ⟨hy.1, trivial⟩, ?_⟩
  change Fin.init (Fin.snoc (α := fun _ ↦ ℝ) (Fin.init y) _) ≠ 0
  rw [Fin.init_snoc]
  exact hy.2

/-- `snocOneProd` maps every set into `W × H₊`. -/
lemma snocOneProd_mapsTo (n : ℕ) (S : Set (W × (Fin n → ℝ))) :
    MapsTo (snocOneProd (W := W) n) S (halfPunctured W n 1) := fun p _ ↦ by
  change Fin.init (Fin.snoc (α := fun _ ↦ ℝ) p.2 (1 : ℝ)) ≠ 0 ∨
    0 < 1 * Fin.snoc (α := fun _ ↦ ℝ) p.2 (1 : ℝ) (Fin.last n)
  rw [Fin.snoc_last]
  exact Or.inr (by norm_num)

/-- `snocOneProd` maps a subset of `W × (ℝⁿ - 0)` into `W × (ℝⁿ⁺¹ - ℝ e)`. -/
lemma snocOneProd_mapsTo_offAxis (n : ℕ) {S : Set (W × (Fin n → ℝ))} (hS : S ⊆ punctured W n) :
    MapsTo (snocOneProd (W := W) n) S (offAxis W n) := fun p hp ↦ by
  change Fin.init (Fin.snoc (α := fun _ ↦ ℝ) p.2 (1 : ℝ)) ≠ 0
  rw [Fin.init_snoc]
  exact hS hp

/-- `snocOneProd` maps `W × (ℝⁿ - 0)` into `W × (H₊ ∩ H₋)`. -/
lemma snocOneProd_mapsTo_punctured (n : ℕ) :
    MapsTo (snocOneProd (W := W) n) (univ ∩ punctured W n)
      (halfPunctured W n 1 ∩ offAxis W n) := fun _ hp ↦
  ⟨snocOneProd_mapsTo n _ hp, snocOneProd_mapsTo_offAxis n inter_subset_right hp⟩

/-- `initProd` maps `W × (H₊ ∩ H₋)` into `W × (ℝⁿ - 0)`. -/
lemma initProd_mapsTo (n : ℕ) :
    MapsTo (initProd (W := W) n) (halfPunctured W n 1 ∩ offAxis W n) (univ ∩ punctured W n) :=
  fun _ hp ↦ ⟨trivial, hp.2⟩

/-- `snocOneProd` maps the fibre `{x} × ℝⁿ` into `W × H₊ ∩ {x} × ℝⁿ⁺¹`. -/
lemma snocOneProd_mapsTo_fibre (n : ℕ) (x : W) :
    MapsTo (snocOneProd (W := W) n) (univ ∩ Prod.fst ⁻¹' {x})
      (halfPunctured W n 1 ∩ Prod.fst ⁻¹' {x}) := fun _ hp ↦
  ⟨snocOneProd_mapsTo n _ hp, hp.2⟩

/-- The pair `(W × H₊, W × (H₊ ∩ H₋))` has the relative homology of `W × (ℝⁿ, ℝⁿ - 0)`:
vanishing. -/
lemma relHomologyVanishing_halfPunctured_of_punctured {n k : ℕ}
    (h : RelHomologyVanishing R (univ : Set (W × (Fin n → ℝ))) (punctured W n) k) :
    RelHomologyVanishing R (halfPunctured W n 1) (offAxis W n) k :=
  RelHomologyVanishing.of_homotopy (initProd n) (snocOneProd n) (mapsTo_univ _ _)
    (initProd_mapsTo n) (snocOneProd_mapsTo n _) (snocOneProd_mapsTo_punctured n)
    (liftHomotopy n) (liftHomotopy_zero n) (liftHomotopy_one n) (liftHomotopy_mapsTo n)
    (liftHomotopy_mapsTo_offAxis n) h

/-- If `H_n(W × (ℝⁿ, ℝⁿ - 0))` is generated by fibrewise relative cycles, so is
`H_n(W × H₊, W × (H₊ ∩ H₋))`. -/
lemma relHomologyGenerated_halfPunctured_of_punctured {n : ℕ}
    (h : RelHomologyGenerated R (univ : Set (W × (Fin n → ℝ))) (punctured W n) n
      (fibreCycles R Prod.fst univ (punctured W n) n)) :
    RelHomologyGenerated R (halfPunctured W n 1) (offAxis W n) n
      (fibreCycles R Prod.fst (halfPunctured W n 1) (offAxis W n) n) := by
  refine RelHomologyGenerated.of_homotopy (initProd n) (snocOneProd n) (mapsTo_univ _ _)
    (initProd_mapsTo n) (snocOneProd_mapsTo n _) (snocOneProd_mapsTo_punctured n)
    (liftHomotopy n) (liftHomotopy_zero n) (liftHomotopy_one n) (liftHomotopy_mapsTo n)
    (liftHomotopy_mapsTo_offAxis n) ?_ h
  rw [fibreCycles, Submodule.map_iSup]
  refine iSup_le fun x ↦ ?_
  rw [Submodule.map_le_iff_le_comap]
  rintro c ⟨hc, hcz⟩
  exact mem_fibreCycles_of_mem_inside x
    (postcomp_mem_inside _ (snocOneProd_mapsTo_fibre n x) hc)
    (postcomp_mem_relativeCycles _ (snocOneProd_mapsTo_offAxis n subset_rfl) hcz)

/-- **The splitting step**: a relative `(k + 1)`-cycle `c` of `W × (ℝⁿ⁺¹, ℝⁿ⁺¹ - 0)` is, up to a
chain in `W × (ℝⁿ⁺¹ - 0)`, a chain `c'` with `∂ c' = a + b`, `a` a relative `k`-cycle of
`(W × H₊, W × (H₊ ∩ H₋))` and `b` in `W × H₋`. -/
lemma exists_bd_eq_add_halfPunctured (n k : ℕ) {c : Chain R (W × (Fin (n + 1) → ℝ)) (k + 1)}
    (hcz : c ∈ relativeCycles R (punctured W (n + 1)) (k + 1)) :
    ∃ c', c - c' ∈ inside R (k + 1) (punctured W (n + 1)) ∧ ∃ a b, bd R k c' = a + b ∧
      a ∈ inside R k (halfPunctured W n 1) ∧ a ∈ relativeCycles R (offAxis W n) k ∧
        b ∈ inside R k (halfPunctured W n (-1)) := by
  set 𝒰 : Set (Set (W × (Fin (n + 1) → ℝ))) := {halfPunctured W n 1, halfPunctured W n (-1)}
  have hbc : bd R k c ∈ inside R k (punctured W (n + 1)) := mem_relativeCycles_succ.1 hcz
  have hbc' : bd R k c ∈ inside R k (⋃₀ 𝒰) := by
    rw [sUnion_insert, sUnion_singleton, halfPunctured_union]
    exact hbc
  have hρ : bd R k (c - smallHomotopy R 𝒰 k (bd R k c)) = smallChainMap R 𝒰 k (bd R k c) := by
    cases k with
    | zero => rw [map_sub, smallChainMap_zero]
    | succ k => rw [map_sub, smallChainMap_succ, bd_bd, map_zero, sub_zero]
  obtain ⟨a, ha, b, hb, hab⟩ := exists_add_of_mem_small_pair
    (smallChainMap_mem_small (isOpen_pair (isOpen_halfPunctured n 1)
      (isOpen_halfPunctured n (-1))) k hbc')
  refine ⟨c - smallHomotopy R 𝒰 k (bd R k c), ?_, a, b, hρ.trans hab, ha, ?_, hb⟩
  · rw [sub_sub_cancel]
    exact smallHomotopy_mem_inside _ _ hbc
  · cases k with
    | zero => trivial
    | succ k =>
      rw [mem_relativeCycles_succ, ← halfPunctured_inter, inside_inter]
      have h0 : bd R k a + bd R k b = 0 := by
        rw [← map_add, ← hab, ← hρ, bd_bd]
      refine ⟨bd_mem_inside ha, ?_⟩
      rw [eq_neg_of_add_eq_zero_left h0]
      exact Submodule.neg_mem _ (bd_mem_inside hb)

/-- If `H_k(W × ℝⁿ, W × (ℝⁿ - 0)) = 0`, then `H_{k+1}(W × ℝⁿ⁺¹, W × (ℝⁿ⁺¹ - 0)) = 0`. -/
lemma relHomologyVanishing_prod_punctured_succ {n k : ℕ}
    (h : RelHomologyVanishing R (univ : Set (W × (Fin n → ℝ))) (punctured W n) k) :
    RelHomologyVanishing R (univ : Set (W × (Fin (n + 1) → ℝ))) (punctured W (n + 1))
      (k + 1) := by
  intro c _ hcz
  obtain ⟨c', hcc', a, b, hab, ha, haz, hb⟩ := exists_bd_eq_add_halfPunctured n k hcz
  obtain ⟨y, hy, hay⟩ := relHomologyVanishing_halfPunctured_of_punctured h a ha haz
  have hD : c' - y ∈ relativeCycles R (halfPunctured W n (-1)) (k + 1) := by
    rw [mem_relativeCycles_succ, map_sub, hab,
      show a + b - bd R k y = (a - bd R k y) + b by abel]
    refine Submodule.add_mem _ (inside_mono _ ?_ hay) hb
    exact inter_subset_right.trans (offAxis_subset_halfPunctured n)
  have hDb := (relHomologyVanishing_univ_halfPunctured_neg (R := R) n (k + 1) _
    (mem_inside_univ _) hD).mono subset_rfl
    (halfPunctured_subset_punctured (W := W) n)
  have hy' : IsRelBoundaryIn R univ (punctured W (n + 1)) (k + 1) y :=
    isRelBoundaryIn_of_mem (by
      rw [univ_inter]; exact inside_mono _ (halfPunctured_subset_punctured n) hy)
  have hc' : IsRelBoundaryIn R univ (punctured W (n + 1)) (k + 1) (c - c') :=
    isRelBoundaryIn_of_mem (by rw [univ_inter]; exact hcc')
  convert hc'.add (hy'.add hDb) using 1
  abel

/-- The prism of the fibrewise contraction carries fibrewise relative cycles of
`(W × H₊, W × (H₊ ∩ H₋))` to fibrewise relative cycles of `W × (ℝⁿ⁺¹, ℝⁿ⁺¹ - 0)`. -/
lemma prism_contractHomotopy_mem_fibreCycles (n : ℕ) {f : Chain R (W × (Fin (n + 1) → ℝ)) n}
    (hf : f ∈ fibreCycles R Prod.fst (halfPunctured W n 1) (offAxis W n) n) :
    prism R (contractHomotopy (W := W) n) n f ∈
      fibreCycles R Prod.fst univ (punctured W (n + 1)) (n + 1) := by
  induction hf using Submodule.iSup_induction' with
  | mem x f hfx =>
    obtain ⟨hfx, hfxz⟩ := hfx
    refine mem_fibreCycles_of_mem_inside x ?_ ?_
    · rw [univ_inter]
      exact prism_mem_inside _ (contractHomotopy_mapsTo_fibre n {x})
        (inside_mono _ inter_subset_right hfx)
    · have hfx' : f ∈ relativeCycles R (halfPunctured W n (-1)) n :=
        relativeCycles_mono (offAxis_subset_halfPunctured n) n hfxz
      have h1 := bd_prism_sub_mem_inside (R := R) (contractHomotopy n) (toNegAxis n)
        (contractHomotopy_zero n) (contractHomotopy_one n) (contractHomotopy_mapsTo n) hfx'
      rw [mem_relativeCycles_succ]
      have : bd R n (prism R (contractHomotopy (W := W) n) n f) =
          (bd R n (prism R (contractHomotopy n) n f) - (postcomp R (toNegAxis n) n f - f)) +
            postcomp R (toNegAxis n) n f - f := by abel
      rw [this]
      refine Submodule.sub_mem _ (Submodule.add_mem _ ?_ ?_) ?_
      · exact inside_mono _ (halfPunctured_subset_punctured n) h1
      · exact postcomp_mem_inside _ ((toNegAxis_mapsTo n _).mono_right
          (halfPunctured_subset_punctured n)) (mem_inside_univ f)
      · exact inside_mono _ (inter_subset_left.trans (halfPunctured_subset_punctured n)) hfx
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add f₁ f₂ _ _ h₁ h₂ => rw [map_add]; exact Submodule.add_mem _ h₁ h₂

/-- Every `0`-chain is a sum of `0`-chains in single fibres. -/
lemma mem_fibreCycles_zero (π : Y → X) (A : Set Y) (c : Chain R Y 0) :
    c ∈ fibreCycles R π univ A 0 := by
  induction c using Finsupp.induction_linear with
  | zero => exact Submodule.zero_mem _
  | add c d hc hd => exact Submodule.add_mem _ hc hd
  | single σ a =>
    rw [← smul_single_one]
    refine Submodule.smul_mem _ _
      (mem_fibreCycles_of_mem_inside (π (σ (stdSimplex.vertex 0)))
        (single_mem_supported R _ ?_) trivial)
    rw [simplex_zero_eq_const σ]
    rintro _ ⟨t, rfl⟩
    exact ⟨trivial, rfl⟩

/-- If `H_n(W × (ℝⁿ, ℝⁿ - 0))` is generated by fibrewise relative cycles, so is
`H_{n+1}(W × (ℝⁿ⁺¹, ℝⁿ⁺¹ - 0))`. -/
lemma relHomologyGenerated_prod_punctured_succ {n : ℕ}
    (h : RelHomologyGenerated R (univ : Set (W × (Fin n → ℝ))) (punctured W n) n
      (fibreCycles R Prod.fst univ (punctured W n) n)) :
    RelHomologyGenerated R (univ : Set (W × (Fin (n + 1) → ℝ))) (punctured W (n + 1)) (n + 1)
      (fibreCycles R Prod.fst univ (punctured W (n + 1)) (n + 1)) := by
  intro c _ hcz
  obtain ⟨c', hcc', a, b, hab, ha, haz, hb⟩ := exists_bd_eq_add_halfPunctured n n hcz
  obtain ⟨f, hf, y, hy, hafy⟩ := relHomologyGenerated_halfPunctured_of_punctured h a ha haz
  set P := prism R (contractHomotopy (W := W) n) n
  have hfS0 : f ∈ relativeCycles R (halfPunctured W n (-1)) n :=
    relativeCycles_mono (offAxis_subset_halfPunctured n) n
      (fibreCycles_le_relativeCycles _ _ _ n hf)
  have hPf := bd_prism_sub_mem_inside (R := R) (contractHomotopy n) (toNegAxis n)
    (contractHomotopy_zero n) (contractHomotopy_one n) (contractHomotopy_mapsTo n) hfS0
  have hD : c' - y + P f ∈ relativeCycles R (halfPunctured W n (-1)) (n + 1) := by
    rw [mem_relativeCycles_succ, map_add, map_sub, hab]
    have : a + b - bd R n y + bd R n (P f) =
        (a - f - bd R n y) + b + postcomp R (toNegAxis n) n f +
          (bd R n (P f) - (postcomp R (toNegAxis n) n f - f)) := by abel
    rw [this]
    refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _ ?_ hb) ?_) hPf
    · exact inside_mono _ (inter_subset_right.trans (offAxis_subset_halfPunctured n)) hafy
    · exact postcomp_mem_inside _ (toNegAxis_mapsTo n _) (mem_inside_univ f)
  have hDb := (relHomologyVanishing_univ_halfPunctured_neg (R := R) n (n + 1) _
    (mem_inside_univ _) hD).mono subset_rfl
    (halfPunctured_subset_punctured (W := W) n)
  have hPfib := prism_contractHomotopy_mem_fibreCycles (R := R) n hf
  refine ⟨-P f, Submodule.neg_mem _ hPfib, ?_⟩
  have hy' : IsRelBoundaryIn R univ (punctured W (n + 1)) (n + 1) y :=
    isRelBoundaryIn_of_mem (by
      rw [univ_inter]; exact inside_mono _ (halfPunctured_subset_punctured n) hy)
  have hc' : IsRelBoundaryIn R univ (punctured W (n + 1)) (n + 1) (c - c') :=
    isRelBoundaryIn_of_mem (by rw [univ_inter]; exact hcc')
  convert hc'.add (hy'.add hDb) using 1
  abel

/-- **`H_k(W × ℝⁿ, W × (ℝⁿ - 0); R) = 0` for `k < n`.** -/
theorem relHomologyVanishing_prod_punctured :
    ∀ n k : ℕ, k < n →
      RelHomologyVanishing R (univ : Set (W × (Fin n → ℝ))) (punctured W n) k
  | 0, k, hk => absurd hk (Nat.not_lt_zero k)
  | n + 1, 0, _ => fun c _ _ ↦
    (relHomologyVanishing_univ_halfPunctured_neg (R := R) (W := W) n 0 c (mem_inside_univ _)
      trivial).mono subset_rfl (halfPunctured_subset_punctured n)
  | n + 1, k + 1, hk =>
    relHomologyVanishing_prod_punctured_succ
      (relHomologyVanishing_prod_punctured n k (by omega))

/-- **`H_n(W × ℝⁿ, W × (ℝⁿ - 0); R)` is generated by fibrewise relative cycles.** -/
theorem relHomologyGenerated_prod_punctured : ∀ n : ℕ,
    RelHomologyGenerated R (univ : Set (W × (Fin n → ℝ))) (punctured W n) n
      (fibreCycles R Prod.fst univ (punctured W n) n)
  | 0 => fun c _ _ ↦
    ⟨c, mem_fibreCycles_zero _ _ c, by rw [sub_self]; exact isRelBoundaryIn_zero⟩
  | n + 1 => relHomologyGenerated_prod_punctured_succ (relHomologyGenerated_prod_punctured n)

