module

public import MMP.AlgebraicTopology.ThomClass.Isomorphism.Local
public import MMP.AlgebraicTopology.ThomClass.Isomorphism.Trivial

/-!
# The relative homology of `(E, E - 0_E)` in degrees `≤ 2r`

Let `E` be a complex topological vector bundle of rank `r` on an arbitrary space `B`, with zero
section `0_E`. In the finite singular chain model, with `n = 2r`:

* `H_k(E, E - 0_E; R) = 0` for `k < n`;
* `H_n(E, E - 0_E; R)` is generated by the fibre simplices (oriented simplices around `0` in the
  fibres, for complex frames);
* a combination of fibre simplices which is a relative boundary has coefficient sum `0`.

This file carries out the local step. Over a set `U` inside the base set of a trivialisation,
`E|_U ≅ U × ℝⁿ`, and the three statements over `E|_U` are those of
`MMP.AlgebraicTopology.ThomClass.Isomorphism.Product` (and, for the third, the Thom cocycle of
a trivial bundle). They pass to finite unions of such sets by Mayer–Vietoris, and to `E` because
every singular chain lies over a compact set (Milnor–Stasheff, §10, Cases 1–4); this passage is in
`MMP.AlgebraicTopology.ThomClass.Isomorphism.Basic`.

## Main results

* `MMP.ThomClass.relHomologyVanishing_chart`
* `MMP.ThomClass.relHomologyGenerated_chart`
* `MMP.ThomClass.augFree_chart`

## References

* [J. Milnor, J. Stasheff, *Characteristic classes*][milnorstasheff1974], §10.
-/

@[expose] public noncomputable section

open Finsupp Set Bundle

universe u

namespace MMP

namespace ThomClass

open SingularChain SingularCochain

section frames

/-- The real isomorphism `ℝ^{2r} ≅ ℂ^r` sending the standard basis to
`e₁, i e₁, …, e_r, i e_r`. -/
def realFrame (r : ℕ) : (Fin (2 * r) → ℝ) ≃L[ℝ] (Fin r → ℂ) :=
  (complexOrientationBasis r).equivFunL.symm

/-- `realFrame r z` is the combination `∑ i, z i • complexOrientationBasis r i`. -/
lemma realFrame_apply (r : ℕ) (z : Fin (2 * r) → ℝ) :
    realFrame r z = ∑ i, z i • complexOrientationBasis r i :=
  (complexOrientationBasis r).equivFun_symm_apply z

/-- `realFrame r` sends the `i`-th standard basis vector to `complexOrientationBasis r i`. -/
lemma realFrame_basisFun (r : ℕ) (i : Fin (2 * r)) :
    realFrame r (Pi.basisFun ℝ (Fin (2 * r)) i) = complexOrientationBasis r i := by
  rw [realFrame_apply, Pi.basisFun_apply]
  simp [Pi.single_apply]

/-- The image under `realFrame r` of `localGeneratorVertices (2 * r)` is an oriented simplex
around `0` for `complexOrientationBasis r`. -/
lemma isOrientedSimplexAroundZero_realFrame_localGeneratorVertices (r : ℕ) :
    IsOrientedSimplexAroundZero (complexOrientationBasis r)
      (realFrame r ∘ localGeneratorVertices (2 * r)) :=
  (isOrientedSimplexAroundZero_localGeneratorVertices (2 * r)).map_linearMap
    (bH := complexOrientationBasis r)
    ((realFrame r).toLinearEquiv : (Fin (2 * r) → ℝ) →ₗ[ℝ] (Fin r → ℂ)) (by
      have : (((realFrame r).toLinearEquiv : (Fin (2 * r) → ℝ) →ₗ[ℝ] (Fin r → ℂ)) :
          (Fin (2 * r) → ℝ) → (Fin r → ℂ)) ∘ Pi.basisFun ℝ (Fin (2 * r)) =
          complexOrientationBasis r :=
        funext fun i ↦ realFrame_basisFun r i
      rw [this, Module.Basis.det_self]
      exact one_pos)

/-- `realFrame r` commutes with taking affine simplices. -/
lemma realFrame_affineSimplex {r k : ℕ} (u : Fin (k + 1) → (Fin (2 * r) → ℝ))
    (t : stdSimplex ℝ (Fin (k + 1))) :
    realFrame r (affineSimplex u t) = affineSimplex (realFrame r ∘ u) t := by
  simp [affineSimplex_apply, map_sum, map_smul]

end frames

variable {R : Type u} [CommRing R] {B : Type u} [TopologicalSpace B]
  (F : Type*) [NormedAddCommGroup F] [NormedSpace ℂ F] [FiniteDimensional ℂ F]
  (E : B → Type u) [∀ x, AddCommGroup (E x)] [∀ x, Module ℂ (E x)] [∀ x, TopologicalSpace (E x)]
  [TopologicalSpace (TotalSpace F E)] [FiberBundle F E] [_root_.VectorBundle ℂ F E]

section setup

/-- A fixed complex frame `ℂ^r ≅ F` of the model fibre. -/
def modelFrame : (Fin (Module.finrank ℂ F) → ℂ) ≃L[ℂ] F :=
  ContinuousLinearEquiv.ofFinrankEq (by simp)

/-- The real isomorphism `ℝ^{2r} ≅ F`. -/
def realModelFrame : (Fin (2 * Module.finrank ℂ F) → ℝ) ≃L[ℝ] F :=
  (realFrame _).trans
    { toLinearEquiv := (modelFrame F).toLinearEquiv.restrictScalars ℝ
      continuous_toFun := (modelFrame F).continuous
      continuous_invFun := (modelFrame F).symm.continuous }

/-- `realModelFrame F` is `modelFrame F` composed with `realFrame`. -/
lemma realModelFrame_apply (z : Fin (2 * Module.finrank ℂ F) → ℝ) :
    realModelFrame F z = modelFrame F (realFrame _ z) :=
  rfl

/-- The inverse of `realModelFrame F` is the inverse of `realFrame` composed with the inverse
of `modelFrame F`. -/
lemma realModelFrame_symm_apply (w : F) :
    (realModelFrame F).symm w = (realFrame _).symm ((modelFrame F).symm w) :=
  rfl

/-- The fibre simplices: oriented simplices around `0` in a fibre, for a complex frame. -/
def fibreSimplices : Set (Simplex (TotalSpace F E) (2 * Module.finrank ℂ F)) :=
  {σ | ∃ (x : B) (ψ : (Fin (Module.finrank ℂ F) → ℂ) ≃L[ℂ] E x)
    (v : Fin (2 * Module.finrank ℂ F + 1) → (Fin (Module.finrank ℂ F) → ℂ)),
    IsOrientedSimplexAroundZero (complexOrientationBasis _) v ∧ fibreSimplex F x ψ v = σ}

omit [TopologicalSpace B] [NormedAddCommGroup F] [NormedSpace ℂ F] [FiniteDimensional ℂ F]
  [∀ x, Module ℂ (E x)] [∀ x, TopologicalSpace (E x)] [TopologicalSpace (TotalSpace F E)]
  [FiberBundle F E] [_root_.VectorBundle ℂ F E] in
/-- A point of the total space lies on the zero section iff its fibre coordinate is `0`. -/
lemma mem_range_zeroSection_iff {p : TotalSpace F E} :
    p ∈ range (zeroSection F E) ↔ p.2 = 0 := by
  obtain ⟨x, w⟩ := p
  constructor
  · rintro ⟨y, hy⟩
    obtain rfl : y = x := congrArg TotalSpace.proj hy
    exact ((TotalSpace.mk_inj).1 hy).symm
  · rintro (rfl : w = 0)
    exact ⟨x, rfl⟩

/-- A singular simplex whose faces lie in `A` is a relative cycle of `(Y, A)`. -/
lemma single_mem_relativeCycles {Y : Type*} [TopologicalSpace Y] {A : Set Y} {k : ℕ}
    (σ : Simplex Y k) (hσ : ∀ t : stdSimplex ℝ (Fin (k + 1)), (∃ i, t i = 0) → σ t ∈ A) :
    single σ (1 : R) ∈ relativeCycles R A k := by
  cases k with
  | zero => trivial
  | succ m =>
    rw [mem_relativeCycles_succ, bd_single]
    refine Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ ?_
    refine single_mem_supported R _ ?_
    rintro _ ⟨t, rfl⟩
    refine hσ _ ⟨i, ?_⟩
    change (stdSimplex.map i.succAbove t : Fin (m + 2) → ℝ) i = 0
    exact stdSimplex_map_succAbove_self i t

omit [FiniteDimensional ℂ F] [_root_.VectorBundle ℂ F E] in
/-- A fibre simplex is a relative cycle of `(E, E - 0_E)`. -/
lemma single_mem_relativeCycles_of_mem_fibreSimplices {σ} (hσ : σ ∈ fibreSimplices F E) :
    single σ (1 : R) ∈ relativeCycles R (range (zeroSection F E))ᶜ (2 * Module.finrank ℂ F) := by
  obtain ⟨x, ψ, v, hv, rfl⟩ := hσ
  exact single_mem_relativeCycles _ (fibreSimplex_notMem_range_zeroSection F x ψ hv)

omit [FiniteDimensional ℂ F] [_root_.VectorBundle ℂ F E] in
/-- A simplex `fibreSimplex F x ψ v` lies in the fibre over `x`. -/
lemma range_fibreSimplex_subset (x : B) (ψ : (Fin (Module.finrank ℂ F) → ℂ) ≃L[ℂ] E x)
    {k : ℕ} (v : Fin (k + 1) → (Fin (Module.finrank ℂ F) → ℂ)) :
    range (fibreSimplex F x ψ v) ⊆ TotalSpace.proj ⁻¹' {x} := by
  rintro _ ⟨t, rfl⟩
  rfl

end setup

section chart

variable {F E} (b : B) {U : Set B} (hU : U ⊆ (trivializationAt F E b).baseSet)

omit [∀ x, Module ℂ (E x)] [_root_.VectorBundle ℂ F E] in
include hU in
/-- For `p = (x, z)` in `U × ℝⁿ`, the point `e⁻¹ (x, L z)` lies over `U`. -/
lemma symm_mem_proj_preimage (p : U × (Fin (2 * Module.finrank ℂ F) → ℝ)) :
    ((trivializationAt F E b).toOpenPartialHomeomorph.symm
      ((p.1 : B), realModelFrame F p.2)).proj ∈ U := by
  rw [(trivializationAt F E b).proj_symm_apply ((trivializationAt F E b).mem_target.2 (hU p.1.2))]
  exact p.1.2

/-- The chart `U × ℝⁿ → E|_U`, `(x, z) ↦ e⁻¹ (x, L z)`. -/
def chartInv :
    C(U × (Fin (2 * Module.finrank ℂ F) → ℝ), (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E))) :=
  ⟨fun p ↦ ⟨(trivializationAt F E b).toOpenPartialHomeomorph.symm
      ((p.1 : B), realModelFrame F p.2), symm_mem_proj_preimage b hU p⟩,
    (((trivializationAt F E b).toOpenPartialHomeomorph.continuousOn_symm.comp_continuous
      ((continuous_subtype_val.comp continuous_fst).prodMk
        ((realModelFrame F).continuous.comp continuous_snd))
      (fun p ↦ (trivializationAt F E b).mem_target.2 (hU p.1.2)))).subtype_mk _⟩

/-- The chart `E|_U → U × ℝⁿ`, `p ↦ (π p, L⁻¹ (e p)₂)`. -/
def chart :
    C((TotalSpace.proj ⁻¹' U : Set (TotalSpace F E)), U × (Fin (2 * Module.finrank ℂ F) → ℝ)) :=
  ⟨fun p ↦ (⟨p.1.proj, p.2⟩, (realModelFrame F).symm ((trivializationAt F E b) p.1).2),
    (((FiberBundle.continuous_proj F E).comp continuous_subtype_val).subtype_mk _).prodMk
      ((realModelFrame F).symm.continuous.comp
        (((trivializationAt F E b).continuousOn.comp_continuous continuous_subtype_val
          (fun p ↦ (trivializationAt F E b).mem_source.2 (hU p.2))).snd))⟩

/-- `chartInv` is a left inverse of `chart`. -/
lemma chartInv_chart (p : (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E))) :
    chartInv b hU (chart b hU p) = p := by
  apply Subtype.ext
  change (trivializationAt F E b).toOpenPartialHomeomorph.symm
    (p.1.proj, realModelFrame F ((realModelFrame F).symm ((trivializationAt F E b) p.1).2)) = p.1
  have hs : p.1 ∈ (trivializationAt F E b).source :=
    (trivializationAt F E b).mem_source.2 (hU p.2)
  rw [ContinuousLinearEquiv.apply_symm_apply, (trivializationAt F E b).mk_proj_snd hs]
  exact (trivializationAt F E b).symm_apply_apply hs

/-- `chartInv` is a right inverse of `chart`. -/
lemma chart_chartInv (p : U × (Fin (2 * Module.finrank ℂ F) → ℝ)) :
    chart b hU (chartInv b hU p) = p := by
  have ht : ((p.1 : B), realModelFrame F p.2) ∈ (trivializationAt F E b).target :=
    (trivializationAt F E b).mem_target.2 (hU p.1.2)
  refine Prod.ext (Subtype.ext ?_) ?_
  · exact (trivializationAt F E b).proj_symm_apply ht
  · change (realModelFrame F).symm ((trivializationAt F E b)
      ((trivializationAt F E b).toOpenPartialHomeomorph.symm ((p.1 : B), realModelFrame F p.2))).2 =
        p.2
    rw [(trivializationAt F E b).apply_symm_apply ht, ContinuousLinearEquiv.symm_apply_apply]

/-- `chartInv b hU (x, z)` is the point of the fibre over `x` obtained by applying the inverse of
the trivialisation's linear equivalence at `x` to `realModelFrame F z`. -/
lemma chartInv_val (p : U × (Fin (2 * Module.finrank ℂ F) → ℝ)) :
    (chartInv b hU p : TotalSpace F E) = TotalSpace.mk (p.1 : B)
      (((trivializationAt F E b).continuousLinearEquivAt ℂ p.1 (hU p.1.2)).symm
        (realModelFrame F p.2)) :=
  (trivializationAt F E b).symm_apply_eq_mk_continuousLinearEquivAt_symm _ _ _

/-- The `ℝⁿ`-coordinate of `chart b hU p` is the inverse of `realModelFrame F` applied to the
image of `p` under the trivialisation's linear equivalence at `π p`. -/
lemma chart_snd (p : (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E))) :
    (chart b hU p).2 = (realModelFrame F).symm
      ((trivializationAt F E b).continuousLinearEquivAt ℂ p.1.proj (hU p.2) p.1.2) := by
  change (realModelFrame F).symm ((trivializationAt F E b) p.1).2 = _
  obtain ⟨⟨x, w⟩, hx⟩ := p
  rw [(trivializationAt F E b).apply_eq_prod_continuousLinearEquivAt ℂ x (hU hx) w]

/-- `chart` maps the complement of the zero section into `U × (ℝⁿ - 0)`. -/
lemma chart_mapsTo :
    MapsTo (chart b hU) (univ ∩ Subtype.val ⁻¹' (range (zeroSection F E))ᶜ)
      (univ ∩ punctured U (2 * Module.finrank ℂ F)) := by
  rintro p ⟨-, hp⟩
  refine ⟨trivial, fun h0 ↦ hp ?_⟩
  rw [mem_range_zeroSection_iff]
  change (chart b hU p).2 = 0 at h0
  rwa [chart_snd, ContinuousLinearEquiv.map_eq_zero_iff, ContinuousLinearEquiv.map_eq_zero_iff]
    at h0

/-- `chartInv` maps `U × (ℝⁿ - 0)` into the complement of the zero section. -/
lemma chartInv_mapsTo :
    MapsTo (chartInv b hU) (univ ∩ punctured U (2 * Module.finrank ℂ F))
      (univ ∩ Subtype.val ⁻¹' (range (zeroSection F E))ᶜ) := by
  rintro p ⟨-, hp⟩
  refine ⟨trivial, fun h0 ↦ hp ?_⟩
  change (chartInv b hU p : TotalSpace F E) ∈ range (zeroSection F E) at h0
  rw [mem_range_zeroSection_iff, chartInv_val] at h0
  change ((trivializationAt F E b).continuousLinearEquivAt ℂ p.1 (hU p.1.2)).symm
    (realModelFrame F p.2) = 0 at h0
  rwa [ContinuousLinearEquiv.map_eq_zero_iff, ContinuousLinearEquiv.map_eq_zero_iff] at h0

/-- The image of `{x} × Δₙ` under the chart is a fibre simplex. -/
lemma chartInv_comp_localGenerator (x : U) :
    (subtypeValMap _).comp ((chartInv b hU).comp
        ((fibreInclusion x (2 * Module.finrank ℂ F)).comp (localGenerator _))) =
      fibreSimplex F (x : B)
        ((modelFrame F).trans ((trivializationAt F E b).continuousLinearEquivAt ℂ x (hU x.2)).symm)
        (realFrame _ ∘ localGeneratorVertices _) := by
  ext1 t
  change (chartInv b hU (x, localGenerator _ t) : TotalSpace F E) = _
  rw [chartInv_val, fibreSimplex_apply]
  congr 1
  change _ = ((trivializationAt F E b).continuousLinearEquivAt ℂ x (hU x.2)).symm
    (modelFrame F (affineSimplex (realFrame _ ∘ localGeneratorVertices _) t))
  rw [realModelFrame_apply, ← realFrame_affineSimplex]
  rfl

variable (R) in
include hU in
/-- For `U` inside the base set of `trivializationAt F E b`, `H_k(E|_U, E|_U - 0_E; R) = 0` for
`k < 2r`. -/
theorem relHomologyVanishing_chart {k : ℕ} (hk : k < 2 * Module.finrank ℂ F) :
    RelHomologyVanishing R (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E))
      (range (zeroSection F E))ᶜ k := by
  refine RelHomologyVanishing.of_subtype ?_
  refine RelHomologyVanishing.of_homotopy (chart b hU) (chartInv b hU) (mapsTo_univ _ _)
    (chart_mapsTo b hU) (mapsTo_univ _ _) (chartInv_mapsTo b hU) ContinuousMap.fst
    (fun p ↦ (chartInv_chart b hU p).symm) (fun _ ↦ rfl) (fun _ hp ↦ hp.1) (fun _ hp ↦ hp.1)
    (relHomologyVanishing_prod_punctured (R := R) _ k hk)

variable (R) in
include hU in
/-- For `U` inside the base set of `trivializationAt F E b` and `0 < r`,
`H_{2r}(E|_U, E|_U - 0_E; R)` is generated by the fibre simplices over `U`. -/
theorem relHomologyGenerated_chart (hr : 0 < Module.finrank ℂ F) :
    RelHomologyGenerated R (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E))
      (range (zeroSection F E))ᶜ (2 * Module.finrank ℂ F)
      (spanIn R (fibreSimplices F E) (TotalSpace.proj ⁻¹' U)) := by
  have hgen : RelHomologyGenerated R (univ : Set (U × (Fin (2 * Module.finrank ℂ F) → ℝ)))
      (punctured U (2 * Module.finrank ℂ F)) (2 * Module.finrank ℂ F)
      (localFibreGenerators R U (2 * Module.finrank ℂ F)) := by
    obtain ⟨m, hm⟩ : ∃ m, 2 * Module.finrank ℂ F = m + 1 := ⟨2 * Module.finrank ℂ F - 1, by lia⟩
    rw [hm]
    exact relHomologyGenerated_prod_localGenerator m
  refine RelHomologyGenerated.of_subtype (G := (localFibreGenerators R U _).map
    (postcomp R (chartInv b hU) _)) ?_ ?_
  · rw [localFibreGenerators, Submodule.map_span, Submodule.map_span, Submodule.span_le]
    rintro _ ⟨_, ⟨_, ⟨x, rfl⟩, rfl⟩, rfl⟩
    rw [SetLike.mem_coe, postcomp_single, postcomp_single, chartInv_comp_localGenerator]
    refine single_mem_supported R _ ⟨⟨_, _, _,
      isOrientedSimplexAroundZero_realFrame_localGeneratorVertices _, rfl⟩, ?_⟩
    refine (range_fibreSimplex_subset F E _ _ _).trans fun p hp ↦ ?_
    change p.proj ∈ U
    rw [show p.proj = x from hp]
    exact x.2
  · refine RelHomologyGenerated.of_homotopy (chart b hU) (chartInv b hU) (mapsTo_univ _ _)
      (chart_mapsTo b hU) (mapsTo_univ _ _) (chartInv_mapsTo b hU) ContinuousMap.fst
      (fun p ↦ (chartInv_chart b hU p).symm) (fun _ ↦ rfl) (fun _ hp ↦ hp.1) (fun _ hp ↦ hp.1)
      le_rfl hgen

/-- The coordinate `E|_U → ℂ^r`, `p ↦ (modelFrame F)⁻¹ (e p)₂`. -/
def chartCoord :
    C((TotalSpace.proj ⁻¹' U : Set (TotalSpace F E)), Fin (Module.finrank ℂ F) → ℂ) :=
  (⟨realFrame _, (realFrame _).continuous⟩ :
    C(Fin (2 * Module.finrank ℂ F) → ℝ, Fin (Module.finrank ℂ F) → ℂ)).comp
    (ContinuousMap.snd.comp (chart b hU))

/-- `chartCoord b hU p` is the inverse of `modelFrame F` applied to the image of `p` under the
trivialisation's linear equivalence at `π p`. -/
lemma chartCoord_apply (p : (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E))) :
    chartCoord b hU p = (modelFrame F).symm
      ((trivializationAt F E b).continuousLinearEquivAt ℂ p.1.proj (hU p.2) p.1.2) := by
  change realFrame _ (chart b hU p).2 = _
  rw [chart_snd, realModelFrame_symm_apply, ContinuousLinearEquiv.apply_symm_apply]

/-- `chartCoord` maps the complement of the zero section into `ℂ^r - 0`. -/
lemma chartCoord_mapsTo :
    MapsTo (chartCoord b hU)
      (Subtype.val ⁻¹' (TotalSpace.proj ⁻¹' U ∩ (range (zeroSection F E))ᶜ))
      ({0}ᶜ : Set (Fin (Module.finrank ℂ F) → ℂ)) := by
  rintro p ⟨-, hp⟩ h0
  refine hp ?_
  rw [mem_range_zeroSection_iff]
  change chartCoord b hU p = 0 at h0
  rwa [chartCoord_apply, ContinuousLinearEquiv.map_eq_zero_iff,
    ContinuousLinearEquiv.map_eq_zero_iff] at h0

/-- On a simplex lying over `U` which is a fibre simplex, `chartCoord` is the affine simplex
composed with a complex linear equivalence. -/
lemma chartCoord_comp_of_eq_fibreSimplex {k : ℕ} {x : B} (hx : x ∈ U)
    (ψ : (Fin (Module.finrank ℂ F) → ℂ) ≃L[ℂ] E x)
    (v : Fin (k + 1) → (Fin (Module.finrank ℂ F) → ℂ))
    (σ : Simplex (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E)) k)
    (hxv : fibreSimplex F x ψ v = (subtypeValMap _).comp σ) :
    (chartCoord b hU).comp σ = ((ψ.trans (((trivializationAt F E b).continuousLinearEquivAt ℂ x
      (hU hx)).trans (modelFrame F).symm) : _ ≃L[ℂ] _) : C(_, _)).comp (affineSimplex v) := by
  ext1 t
  have ht : (σ t : TotalSpace F E) = TotalSpace.mk x (ψ (affineSimplex v t)) :=
    DFunLike.congr_fun hxv.symm t
  change chartCoord b hU (σ t) = (modelFrame F).symm
    ((trivializationAt F E b).continuousLinearEquivAt ℂ x (hU hx) (ψ (affineSimplex v t)))
  rw [chartCoord_apply]
  generalize σ t = p at ht ⊢
  obtain ⟨⟨y, w⟩, hy⟩ := p
  change TotalSpace.mk y w = TotalSpace.mk x (ψ (affineSimplex v t)) at ht
  obtain ⟨rfl, hw⟩ : y = x ∧ HEq w (ψ (affineSimplex v t)) := TotalSpace.mk.inj ht
  cases eq_of_heq hw
  rfl

variable (R) in
include hU in
/-- For `U` inside the base set of `trivializationAt F E b`, a combination of fibre simplices over
`U` which is a relative boundary has coefficient sum `0`. -/
theorem augFree_chart :
    AugFree R (TotalSpace.proj ⁻¹' U : Set (TotalSpace F E)) (range (zeroSection F E))ᶜ
      (2 * Module.finrank ℂ F) (fibreSimplices F E) := by
  classical
  rintro g hg ⟨w, hw, hgw⟩
  set S : Set (TotalSpace F E) := TotalSpace.proj ⁻¹' U
  obtain ⟨g', rfl⟩ := exists_postcomp_subtypeValMap_eq (spanIn_le_inside hg)
  obtain ⟨w', rfl⟩ := exists_postcomp_subtypeValMap_eq hw
  obtain ⟨α, hα, h1⟩ := exists_relCocycles_eval_affineSimplex (R := R) (Module.finrank ℂ F)
  have hrel : g' - bd R _ w' ∈ inside R _ (Subtype.val ⁻¹' (S ∩ (range (zeroSection F E))ᶜ)) := by
    refine mem_inside_preimage_of_postcomp ?_
    rw [map_sub, postcomp_bd]
    exact hgw
  have e1 : eval α (postcomp R (chartCoord b hU) _ (g' - bd R _ w')) = 0 :=
    eval_eq_zero_of_mem_vanishing hα.1 (postcomp_mem_inside _ (chartCoord_mapsTo b hU) hrel)
  have e2 : eval α (postcomp R (chartCoord b hU) _ (bd R _ w')) = 0 := by
    rw [postcomp_bd, ← eval_coboundary, hα.2]
    simp [eval]
  rw [map_sub, map_sub, e2, sub_zero] at e1
  rw [aug_postcomp, ← e1]
  have hinj : Function.Injective
      fun σ : Simplex S (2 * Module.finrank ℂ F) ↦ (subtypeValMap S).comp σ :=
    fun σ τ h ↦ ContinuousMap.ext fun t ↦ Subtype.ext (DFunLike.congr_fun h t)
  rw [postcomp, lmapDomain_apply, eval, linearCombination_mapDomain, SingularChain.aug,
    linearCombination_apply, linearCombination_apply]
  refine Finsupp.sum_congr fun σ hσ ↦ ?_
  have hσ' : (subtypeValMap S).comp σ ∈ (postcomp R (subtypeValMap S) _ g').support := by
    rw [postcomp, lmapDomain_apply, Finsupp.mapDomain_support_of_injective hinj]
    exact Finset.mem_image_of_mem _ hσ
  obtain ⟨⟨x, ψ, v, hv, hxv⟩, hS⟩ := (mem_supported R _).1 hg hσ'
  have hx : x ∈ U := by
    have := hS ⟨stdSimplex.vertex 0, rfl⟩
    rwa [← hxv] at this
  set N : (Fin (Module.finrank ℂ F) → ℂ) ≃L[ℂ] (Fin (Module.finrank ℂ F) → ℂ) :=
    ψ.trans (((trivializationAt F E b).continuousLinearEquivAt ℂ x (hU hx)).trans
      (modelFrame F).symm)
  have hc : (chartCoord b hU).comp σ = (N : C(_, _)).comp (affineSimplex v) :=
    chartCoord_comp_of_eq_fibreSimplex b hU hx ψ v σ hxv
  have := eval_comp_affineSimplex_eq_one h1 N hv
  rw [← hc] at this
  simp only [eval, linearCombination_single, one_smul] at this
  simp [this]

end chart

end ThomClass

end MMP
