module

public import MMP.AlgebraicTopology.FundamentalClass.Restriction
public import MMP.AlgebraicTopology.PoincareDuality.LocalPackage
public import MMP.AlgebraicTopology.FundamentalClass.Locality
public import MMP.AlgebraicTopology.FundamentalClass.Homeomorphism
public import MMP.AlgebraicTopology.PoincareDuality.LocalInjectiveManifold
public import MMP.AlgebraicTopology.BorelMoore.FiniteChains

/-!
# Poincaré duality in top degree

Let `Y` be a connected, Hausdorff, second countable real `n`-manifold, `n = m + 1`, modelled on
a Hausdorff real vector space `H` with a basis `b`. Assume the *local package* at every point
`y` and every oriented chart simplex `Δ` around `y`: every relative `n`-cycle of `(Y, Y - y)` is
homologous to a multiple of `Δ`, the multiples of `Δ` are free, and a relative cocycle `φ` of
`(Y, Y - y)` takes the value `1` on `Δ` (that is, `H_n(Y, Y - y) ≅ R` generated by `Δ` and
detected by `φ`). Then every fundamental class `μ ∈ H_n Y` freely generates `H_n Y`.

The proof (Hatcher, Lemma 3.27 and Theorem 3.26): fix a representing locally finite cycle `μ̃`.
At a point `x₀` the detecting cocycle `φ₀` pairs to `1` with `μ̃`, so `r • μ = 0` forces `r = 0`.
For a cycle `z`, put `z' = z - ⟨φ₀, z⟩ μ̃`. The set of points where the truncation of `z'` is a
relative boundary is open and closed (in a chart, a closed ball inside one oriented simplex `Δ`:
the truncation is homologous to `t Δ` near one point, hence on the whole ball by the box step,
and `t` is detected at every point of the ball by freeness), and contains `x₀`; so it is
everything. By Lemma 3.27(b) the truncation of `z'` to every compact set is then a relative
boundary, and the `lim¹` lifting argument makes `z'` a boundary.

## Main definitions

* `MMP.PoincareDuality.LocalPackage`: the local package, a hypothesis.

## Main results

* `MMP.PoincareDuality.eventually_isOrientedSimplexAroundZero`: being an oriented
  simplex around a point is an open condition on the point.
* `MMP.PoincareDuality.isRelBoundary_chartBall`: the box step for a closed ball of
  a chart.
* `MMP.PoincareDuality.topHomologyFreeOnFundamentalClass_of_localPackage`:
  Poincaré duality in top degree `n = m + 1`, from the local package.
* `MMP.PoincareDuality.topHomologyFreeOnFundamentalClass_zero`: the case `n = 0`
  (a connected `0`-manifold is a point), unconditionally.
* `MMP.PoincareDuality.topHomologyFreeOnFundamentalClass`: every `n`, from the
  local package in every positive dimension.

## References

* [A. Hatcher, *Algebraic Topology*][hatcher2002], §3.3, Lemma 3.27, Theorem 3.26.
* [W. Fulton, *Intersection Theory*][fulton1998], §19.1, (3).
-/

@[expose] public noncomputable section

open CategoryTheory Set Topology Opposite Simplicial Finsupp
open MMP.SingularChain MMP.SingularCochain
  MMP.ThomClass MMP.FundamentalClass

universe u v

namespace MMP

section Duality

variable (R : Type u) [CommRing R] {H : Type v} [AddCommGroup H] [Module ℝ H]
  [TopologicalSpace H] [ContinuousAdd H] [ContinuousSMul ℝ H]

/-- Every fundamental class `μ_Y ∈ H_n Y` of the real `n`-manifold `Y`, oriented in its charts by
the basis `b`, freely generates `H_n Y`: the map `R → H_n Y`, `r ↦ r • μ_Y`, is bijective. -/
def TopHomologyFreeOnFundamentalClass (Y : Type u) [TopologicalSpace Y] [T2Space Y]
    [ChartedSpace H Y] {n : ℕ} (b : Module.Basis (Fin n) ℝ H) : Prop :=
  ∀ μ : borelMooreHomology R (ModuleCat.of R R) (TopCat.of Y) n, IsFundamentalClass R b μ →
    Function.Bijective fun r : R ↦ r • μ

end Duality

namespace PoincareDuality

section Orientation

variable {H : Type v} [AddCommGroup H] [Module ℝ H] [TopologicalSpace H] [ContinuousAdd H]
  [ContinuousSMul ℝ H] [T2Space H]

/-- **Being an oriented simplex around a point is an open condition on the point.** -/
theorem eventually_isOrientedSimplexAroundZero {n : ℕ} (b : Module.Basis (Fin n) ℝ H)
    {v : Fin (n + 1) → H} {p₀ : H} (h : IsOrientedSimplexAroundZero b fun k ↦ v k - p₀) :
    ∀ᶠ p in 𝓝 p₀, IsOrientedSimplexAroundZero b fun k ↦ v k - p := by
  have hd : ∀ p : H, (fun k : Fin n ↦ (v k.succ - p) - (v 0 - p)) = fun k ↦ v k.succ - v 0 :=
    fun p ↦ funext fun k ↦ by abel
  have hdet : 0 < b.det fun k ↦ v k.succ - v 0 := by
    have := h.2
    simp only [hd] at this
    exact this
  obtain ⟨hli, hspan⟩ := b.is_basis_iff_det.2 (isUnit_iff_ne_zero.2 hdet.ne')
  set B := Module.Basis.mk hli hspan.ge
  haveI : IsTopologicalAddGroup H :=
    { continuous_neg := by
        have : (fun x : H ↦ -x) = fun x ↦ (-1 : ℝ) • x := funext fun x ↦ by simp
        rw [this]
        exact continuous_const_smul _ }
  haveI : FiniteDimensional ℝ H := Module.Finite.of_basis b
  have hcoord : ∀ k, Continuous fun p : H ↦ B.coord k (p - v 0) := fun k ↦
    (LinearMap.continuous_of_finiteDimensional (B.coord k)).comp
      (continuous_id.sub continuous_const)
  set s : H → Fin (n + 1) → ℝ := fun p ↦
    Fin.cons (1 - ∑ k, B.coord k (p - v 0)) fun k ↦ B.coord k (p - v 0) with hs
  have hs1 : ∀ p, ∑ k, s p k = 1 := fun p ↦ by
    rw [Fin.sum_univ_succ]
    simp [s]
  have hsv : ∀ p, ∑ k, s p k • (v k - p) = 0 := fun p ↦ by
    have hrepr : ∑ k, B.coord k (p - v 0) • (v k.succ - v 0) = p - v 0 := by
      conv_rhs => rw [← B.sum_repr (p - v 0)]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [Module.Basis.coord_apply, Module.Basis.mk_apply]
    rw [Fin.sum_univ_succ]
    simp only [s, Fin.cons_zero, Fin.cons_succ]
    have hsplit : ∑ k : Fin n, B.coord k (p - v 0) • (v k.succ - p) =
        ∑ k, B.coord k (p - v 0) • (v k.succ - v 0) +
          (∑ k, B.coord k (p - v 0)) • (v 0 - p) := by
      rw [Finset.sum_smul, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [← smul_add]
      congr 1
      abel
    rw [hsplit, hrepr, sub_smul, one_smul]
    abel
  obtain ⟨t, ht, ht1, htv⟩ := h.1
  have hst : s p₀ = t := by
    have := h.eq_zero_of_sum_eq_zero (c := s p₀ - t)
      (by simp [Finset.sum_sub_distrib, hs1, ht1])
      (by simp [sub_smul, Finset.sum_sub_distrib, hsv, htv])
    exact sub_eq_zero.1 this
  have hcont : ∀ k, Continuous fun p ↦ s p k := by
    intro k
    refine Fin.cases ?_ (fun k ↦ ?_) k
    · simp only [s, Fin.cons_zero]
      exact continuous_const.sub (continuous_finset_sum _ fun k _ ↦ hcoord k)
    · simp only [s, Fin.cons_succ]
      exact hcoord k
  have hev : ∀ᶠ p in 𝓝 p₀, ∀ k, 0 < s p k := Filter.eventually_all.2 fun k ↦
    (hcont k).continuousAt.eventually (lt_mem_nhds (show 0 < s p₀ k by rw [hst]; exact ht k))
  filter_upwards [hev] with p hp
  refine ⟨⟨s p, hp, hs1 p, hsv p⟩, ?_⟩
  simp only [hd]
  exact hdet

end Orientation

section Box

variable {R : Type*} [CommRing R] {H : Type v} [AddCommGroup H] [Module ℝ H] [TopologicalSpace H]
  [ContinuousAdd H] [ContinuousSMul ℝ H] [T2Space H] {Y : Type*} [TopologicalSpace Y] [T2Space Y]

/-- The closed ball of radius `r` about `p` in the coordinates `ψ ∘ e` of a chart `e`
(`ψ = basisHomeomorph b`), as a subset of `Y`. -/
def chartBall {n : ℕ} (b : Module.Basis (Fin n) ℝ H) (e : OpenPartialHomeomorph Y H)
    (p : Fin n → ℝ) (r : ℝ) : Set Y :=
  (fun u ↦ e.symm ((basisHomeomorph b).symm u)) '' Metric.closedBall p r

variable {n : ℕ} {b : Module.Basis (Fin n) ℝ H} {e : OpenPartialHomeomorph Y H}
  {p : Fin n → ℝ} {r : ℝ}

/-- A chart ball whose coordinate ball lies in the chart's target is contained in the chart's
source. -/
lemma chartBall_subset_source
    (hB : ∀ u ∈ Metric.closedBall p r, (basisHomeomorph b).symm u ∈ e.target) :
    chartBall b e p r ⊆ e.source := by
  rintro _ ⟨u, hu, rfl⟩
  exact e.map_target (hB u hu)

/-- A chart ball whose coordinate ball lies in the chart's target is compact. -/
lemma isCompact_chartBall
    (hB : ∀ u ∈ Metric.closedBall p r, (basisHomeomorph b).symm u ∈ e.target) :
    IsCompact (chartBall b e p r) :=
  (isCompact_closedBall p r).image_of_continuousOn
    (e.continuousOn_symm.comp (basisHomeomorph b).symm.continuous.continuousOn hB)

/-- **The box step on a manifold**: a relative cycle for a closed coordinate ball `Q` of a chart
which is a relative boundary for one point of `Q` is a relative boundary for `Q`. -/
theorem isRelBoundary_chartBall
    (hB : ∀ u ∈ Metric.closedBall p r, (basisHomeomorph b).symm u ∈ e.target) {x : Y}
    (hx : x ∈ chartBall b e p r) {m : ℕ} {c : Chain R Y (m + 1)}
    (hbd : bd R m c ∈ inside R m (chartBall b e p r)ᶜ) (hc : IsRelBoundary R (m + 1) {x} c) :
    IsRelBoundary R (m + 1) (chartBall b e p r) c := by
  set ψ := basisHomeomorph b
  set Q := chartBall b e p r with hQdef
  set ι := ContinuousMap.subtypeVal e.source
  have hQs : Q ⊆ e.source := chartBall_subset_source hB
  have hQc : IsClosed Q := (isCompact_chartBall hB).isClosed
  obtain ⟨c₁, hc₁, hbd₁⟩ := exists_isRelBoundary_sub_postcomp_subtypeVal e.open_source hQc hQs hbd
  set x' : e.source := ⟨x, hQs hx⟩
  have hloc₁ : IsRelBoundary R (m + 1) (Subtype.val ⁻¹' ({x} : Set Y) : Set e.source) c₁ := by
    have h1 : IsRelBoundary R (m + 1) {x} (postcomp R ι (m + 1) c₁) := by
      have := hc.sub (hc₁.mono (singleton_subset_iff.2 hx))
      rwa [sub_sub_cancel] at this
    exact IsRelBoundary.of_postcomp_subtypeVal e.open_source isClosed_singleton
      (singleton_subset_iff.2 (hQs hx)) h1
  set F : C(e.source, Fin n → ℝ) :=
    ((ψ : C(H, Fin n → ℝ)).comp (ContinuousMap.subtypeVal e.target)).comp
      (e.toHomeomorphSourceTarget : C(e.source, e.target))
  have hF : IsOpenEmbedding F :=
    (ψ.isOpenEmbedding.comp e.open_target.isOpenEmbedding_subtypeVal).comp
      e.toHomeomorphSourceTarget.isOpenEmbedding
  have hFapp : ∀ u : e.source, F u = ψ (e u) := fun u ↦ rfl
  have hFQ : ∀ u : e.source, F u ∈ Metric.closedBall p r → (u : Y) ∈ Q := fun u hu ↦
    ⟨F u, hu, by
      change e.symm (ψ.symm (F u)) = u
      rw [hFapp, Homeomorph.symm_apply_apply, e.left_inv u.2]⟩
  have hQF : ∀ u : e.source, (u : Y) ∈ Q → F u ∈ Metric.closedBall p r := by
    rintro u ⟨w, hw, hwu⟩
    rw [hFapp, ← hwu, e.right_inv (hB w hw), Homeomorph.apply_symm_apply]
    exact hw
  have hbdF : bd R m (postcomp R F (m + 1) c₁) ∈ inside R m (Metric.closedBall p r)ᶜ := by
    rw [← postcomp_bd]
    exact postcomp_mem_inside F (U := (Subtype.val ⁻¹' Q : Set e.source)ᶜ)
      (V := (Metric.closedBall p r)ᶜ)
      (fun u (hu : u ∈ (Subtype.val ⁻¹' Q : Set e.source)ᶜ)
        (hFu : F u ∈ Metric.closedBall p r) ↦ hu (hFQ u hFu)) hbd₁
  have hFx : F x' ∈ Metric.closedBall p r := hQF x' hx
  have hrelF : IsRelBoundary R (m + 1) {F x'} (postcomp R F (m + 1) c₁) :=
    isRelBoundary_postcomp F (K := (Subtype.val ⁻¹' ({x} : Set Y) : Set e.source))
      (L := {F x'}) (fun z (hz : z ∈ F ⁻¹' {F x'}) ↦
        show z ∈ (Subtype.val ⁻¹' ({x} : Set Y) : Set e.source) from
          congrArg Subtype.val (hF.injective hz)) hloc₁
  have hball := isRelBoundary_of_convex (convex_closedBall p r) Metric.isBounded_closedBall hFx
    hbdF hrelF
  have hrange : Metric.closedBall p r ⊆ range F := fun w hw ↦
    ⟨⟨e.symm (ψ.symm w), e.map_target (hB w hw)⟩, by
      rw [hFapp]
      change ψ (e (e.symm (ψ.symm w))) = w
      rw [e.right_inv (hB w hw), Homeomorph.apply_symm_apply]⟩
  have hback := IsRelBoundary.of_postcomp_isOpenEmbedding hF Metric.isClosed_closedBall hrange
    hball
  have hback' : IsRelBoundary R (m + 1) ((↑) ⁻¹' Q : Set e.source) c₁ :=
    hback.mono fun u hu ↦ hQF u hu
  have hY : IsRelBoundary R (m + 1) Q (postcomp R ι (m + 1) c₁) :=
    isRelBoundary_postcomp_subtypeVal hback'
  have := hc₁.add hY
  rwa [sub_add_cancel] at this

end Box

section ChartSimplex

variable {R : Type*} [CommRing R] {H : Type v} [AddCommGroup H] [Module ℝ H] [TopologicalSpace H]
  [ContinuousAdd H] [ContinuousSMul ℝ H] {Y : Type*} [TopologicalSpace Y]

/-- The boundary of the chart simplex `e⁻¹ ∘ Δ` avoids every point `y` of the chart around which
`Δ` is an oriented simplex. -/
lemma bd_single_chartSimplex_mem_inside {m : ℕ} {b : Module.Basis (Fin (m + 1)) ℝ H}
    {e : OpenPartialHomeomorph Y H} {v : Fin (m + 2) → H}
    (hvt : range (affineSimplex v) ⊆ e.target) {S : Set Y}
    (hS : ∀ y ∈ S, ∃ hy : y ∈ e.source, IsOrientedSimplexAroundZero b fun k ↦ v k - e y) :
    bd R m (single ((ContinuousMap.subtypeVal _).comp (chartSimplex e v hvt)) 1) ∈
      inside R m Sᶜ := by
  rw [bd_single]
  refine Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ (single_mem_supported R _ ?_)
  rintro _ ⟨t, rfl⟩ hyS
  obtain ⟨hy, hv⟩ := hS _ hyS
  refine chartSimplex_ne (x := ⟨_, hy⟩) hv hvt (face m i t) ⟨i, ?_⟩ (Subtype.ext rfl)
  change (stdSimplex.map i.succAbove t : Fin (m + 2) → ℝ) i = 0
  rw [stdSimplex.map_coe, FunOnFinite.linearMap_apply_apply]
  refine Finset.sum_eq_zero fun k hk ↦ ?_
  exact absurd (Finset.mem_filter.1 hk).2 (Fin.succAbove_ne i k)

end ChartSimplex

section Trunc

open borelMooreHomology LocallyFiniteChain

variable {R : Type u} [CommRing R] {X : TopCat.{u}}

/-- The truncation of a locally finite chain to a compact set `K`, as a finite chain. -/
def truncFin {K : Set X} (hK : IsCompact K) {n : ℕ}
    (z : (borelMooreChainComplex R (ModuleCat.of R R) X).X n) : Chain R X n :=
  toFinsupp (truncChain K z) (finite_support_truncChain hK z)

/-- Viewed as a locally finite chain, `truncFin hK z` is the truncation `truncChain K z`. -/
lemma ofFinsupp_truncFin {K : Set X} (hK : IsCompact K) {n : ℕ}
    (z : (borelMooreChainComplex R (ModuleCat.of R R) X).X n) :
    ofFinsupp (truncFin hK z) = truncChain K z :=
  ofFinsupp_toFinsupp _ _

/-- The truncation of a cycle to `K` is a relative cycle of `(X, X - K)`. -/
lemma bd_truncFin_mem_inside {K : Set X} (hK : IsCompact K) {m : ℕ}
    {z : (borelMooreChainComplex R (ModuleCat.of R R) X).X (m + 1)}
    (hz : ((borelMooreChainComplex R (ModuleCat.of R R) X).d (m + 1) m).hom z = 0) :
    bd R m (truncFin hK z) ∈ inside R m Kᶜ := by
  rw [← isOffChain_ofFinsupp_iff, ← d_ofFinsupp, ofFinsupp_truncFin]
  have h := (isOffChain_sub_truncChain K z).d (M := ModuleCat.of R R)
  rw [map_sub, hz, zero_sub] at h
  have := h.neg
  rwa [neg_neg] at this

/-- Truncations to `K' ⊆ K` agree on the simplices meeting `K'`. -/
lemma truncFin_sub_mem_inside {K K' : Set X} (hK : IsCompact K) (hK' : IsCompact K')
    (h : K' ⊆ K) {n : ℕ} (z : (borelMooreChainComplex R (ModuleCat.of R R) X).X n) :
    truncFin hK z - truncFin hK' z ∈ inside R n K'ᶜ := by
  rw [← isOffChain_ofFinsupp_iff, ofFinsupp_sub, ofFinsupp_truncFin, ofFinsupp_truncFin]
  intro σ hσ
  change (truncChain K z).1 σ - (truncChain K' z).1 σ = 0
  rw [truncChain_apply, truncChain_apply, if_pos hσ,
    if_pos (hσ.mono (inter_subset_inter_right _ h)), sub_self]

/-- The pairing of a finite chain, as a locally finite chain, is the evaluation. -/
lemma localPairing_ofFinsupp {n : ℕ} (f : Chain R X n) (φ : Simplex X n → R) :
    localPairing ((ofFinsupp f).1 : (TopCat.toSSet.obj X).obj (op ⦋n⦌) → R) φ = eval φ f := by
  classical
  rw [localPairing]
  change ∑ᶠ σ, f (SingularCochain.simplexEquiv X n σ) * φ (SingularCochain.simplexEquiv X n σ) = _
  rw [finsum_comp_equiv (SingularCochain.simplexEquiv X n) (f := fun τ ↦ f τ * φ τ),
    finsum_eq_sum_of_support_subset (s := f.support) _ (fun τ hτ ↦ by
      rw [Finset.mem_coe, Finsupp.mem_support_iff]
      intro h0
      exact hτ (by simp [h0])), linearCombination_apply, Finsupp.sum]
  exact Finset.sum_congr rfl fun τ _ ↦ by rw [smul_eq_mul]

/-- The pairing with a cochain vanishing off `x ∈ K` sees only the truncation to `K`. -/
lemma eval_truncFin {K : Set X} (hK : IsCompact K) {n : ℕ}
    (z : (borelMooreChainComplex R (ModuleCat.of R R) X).X n) {x : X} (hx : x ∈ K)
    {φ : Simplex X n → R} (hφ : φ ∈ vanishing R n ({x}ᶜ : Set X)) :
    eval φ (truncFin hK z) =
      localPairing (z.1 : (TopCat.toSSet.obj X).obj (op ⦋n⦌) → R) φ := by
  classical
  rw [← localPairing_ofFinsupp, ofFinsupp_truncFin]
  refine finsum_congr fun σ ↦ ?_
  rw [truncChain_apply]
  split_ifs with h
  · rfl
  · rw [zero_mul, hφ _ (fun y hy ↦ ?_), mul_zero]
    rintro rfl
    exact h ⟨_, (range_simplexEquiv _).subset hy, hx⟩

end Trunc

section Package

variable {H : Type v} [AddCommGroup H] [Module ℝ H] [TopologicalSpace H] [ContinuousAdd H]
  [ContinuousSMul ℝ H]

/-- The *local package* of an `(m + 1)`-manifold `Y` with orientation basis `b`: at every point
`y` of a chart `e` and every oriented chart simplex `Δ = e⁻¹ ∘ Δ_v` around `y`, (generation)
every relative `(m + 1)`-cycle of `(Y, Y - y)` is homologous rel `Y - y` to a multiple of `Δ`,
(freeness) no non-zero multiple of `Δ` is a relative boundary, and (detection) some relative
cocycle of `(Y, Y - y)` takes the value `1` on `Δ`. That is, `H_{m+1}(Y, Y - y) ≅ R`, freely
generated by `Δ`, with a dual cocycle. This is a hypothesis, discharged elsewhere. -/
def LocalPackage (R : Type*) [CommRing R] (Y : Type u) [TopologicalSpace Y] {m : ℕ}
    (b : Module.Basis (Fin (m + 1)) ℝ H) : Prop :=
  ∀ (e : OpenPartialHomeomorph Y H) (y : Y), y ∈ e.source → ∀ (v : Fin (m + 2) → H),
    (IsOrientedSimplexAroundZero b fun k ↦ v k - e y) →
    ∀ (hvt : range (affineSimplex v) ⊆ e.target),
      (∀ c : Chain R Y (m + 1), bd R m c ∈ inside R m {y}ᶜ →
        ∃ (r : R) (w : Chain R Y (m + 2)),
          c - r • single ((ContinuousMap.subtypeVal _).comp (chartSimplex e v hvt)) 1 -
            bd R (m + 1) w ∈ inside R (m + 1) {y}ᶜ) ∧
      (∀ r : R, (∃ w : Chain R Y (m + 2),
          r • single ((ContinuousMap.subtypeVal _).comp (chartSimplex e v hvt)) 1 -
            bd R (m + 1) w ∈ inside R (m + 1) {y}ᶜ) → r = 0) ∧
      ∃ φ ∈ relCocycles R ({y}ᶜ : Set Y) (m + 1),
        eval φ (single ((ContinuousMap.subtypeVal _).comp (chartSimplex e v hvt)) 1) = 1

end Package

/-- Two chains whose difference is supported in `Kᶜ` are either both or neither relative
boundaries for `K`. -/
lemma isRelBoundary_iff_of_sub_mem_inside {R : Type*} [CommRing R] {Y : Type*}
    [TopologicalSpace Y] {m : ℕ} {K : Set Y} {c d : Chain R Y m} (h : c - d ∈ inside R m Kᶜ) :
    IsRelBoundary R m K c ↔ IsRelBoundary R m K d := by
  refine ⟨fun hc ↦ ?_, fun hd ↦ ?_⟩
  · have := hc.sub (isRelBoundary_of_mem_inside h)
    rwa [sub_sub_cancel] at this
  · have := hd.add (isRelBoundary_of_mem_inside h)
    rwa [add_sub_cancel] at this

section Constancy

open borelMooreHomology

variable {R : Type u} [CommRing R] {H : Type v} [AddCommGroup H] [Module ℝ H]
  [TopologicalSpace H] [ContinuousAdd H] [ContinuousSMul ℝ H] [T2Space H]
  {Y : Type u} [TopologicalSpace Y] [T2Space Y] [ChartedSpace H Y]

/-- For `y` in a compact `K`, being a relative boundary at `y` can be read on the truncation
to `K` or to `{y}`. -/
lemma isRelBoundary_truncFin_iff {K : Set (TopCat.of Y)} (hK : IsCompact K) {y : Y} (hy : y ∈ K)
    {n : ℕ} (z : (borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)).X n) :
    IsRelBoundary R n {y} (truncFin hK z) ↔
      IsRelBoundary R n {y} (truncFin (isCompact_singleton (x := (y : TopCat.of Y))) z) :=
  isRelBoundary_iff_of_sub_mem_inside
    (truncFin_sub_mem_inside hK isCompact_singleton (singleton_subset_iff.2 hy) z)

/-- **Local constancy.** For a locally finite `(m + 1)`-cycle `z` of an `(m + 1)`-manifold with
the local package, being a relative boundary at a point (for the truncation of `z`) is locally
constant in the point. -/
theorem eventually_isRelBoundary_truncFin_iff {m : ℕ} {b : Module.Basis (Fin (m + 1)) ℝ H}
    (hP : LocalPackage R Y b)
    {z : (borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)).X (m + 1)}
    (hz : ((borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)).d (m + 1) m).hom z = 0)
    (x : Y) : ∀ᶠ y in 𝓝 x,
      (IsRelBoundary R (m + 1) {y} (truncFin (isCompact_singleton (x := (y : TopCat.of Y))) z) ↔
        IsRelBoundary R (m + 1) {x} (truncFin (isCompact_singleton (x := (x : TopCat.of Y))) z)) := by
  set e := chartAt H x
  have hx : x ∈ e.source := mem_chart_source H x
  set ψ := basisHomeomorph b
  obtain ⟨v, hv, hvt⟩ := exists_isOrientedSimplexAroundZero_subset b (e x)
    (e.open_target.mem_nhds (mem_chart_target H x))
  have hev := eventually_isOrientedSimplexAroundZero b hv
  set p₀ := ψ (e x)
  have hψ : Filter.Tendsto ψ.symm (𝓝 p₀) (𝓝 (e x)) := by
    have := ψ.symm.continuous.tendsto p₀
    rwa [Homeomorph.symm_apply_apply] at this
  have hO : ∀ᶠ u in 𝓝 p₀, ψ.symm u ∈ e.target ∧
      IsOrientedSimplexAroundZero b fun k ↦ v k - ψ.symm u :=
    hψ.eventually (Filter.Eventually.and (e.open_target.mem_nhds (mem_chart_target H x)) hev)
  obtain ⟨ε, hε, hεO⟩ := Metric.eventually_nhds_iff.1 hO
  set r := ε / 2
  have hr : 0 < r := half_pos hε
  have hball : ∀ u ∈ Metric.closedBall p₀ r, ψ.symm u ∈ e.target ∧
      IsOrientedSimplexAroundZero b fun k ↦ v k - ψ.symm u := fun u hu ↦
    hεO (lt_of_le_of_lt (Metric.mem_closedBall.1 hu) (half_lt_self hε))
  have hB : ∀ u ∈ Metric.closedBall p₀ r, ψ.symm u ∈ e.target := fun u hu ↦ (hball u hu).1
  set Q := chartBall b e p₀ r
  have hQK : IsCompact Q := isCompact_chartBall hB
  have hQor : ∀ y ∈ Q, ∃ hy : y ∈ e.source, IsOrientedSimplexAroundZero b fun k ↦ v k - e y := by
    rintro _ ⟨u, hu, rfl⟩
    refine ⟨e.map_target (hB u hu), ?_⟩
    rw [e.right_inv (hB u hu)]
    exact (hball u hu).2
  have hQn : Q ∈ 𝓝 x := by
    have hg : ContinuousAt (fun y ↦ ψ (e y)) x :=
      ψ.continuous.continuousAt.comp (e.continuousAt hx)
    refine Filter.mem_of_superset (Filter.inter_mem (e.open_source.mem_nhds hx)
      (hg.preimage_mem_nhds (Metric.ball_mem_nhds p₀ hr))) fun y ⟨hys, hyb⟩ ↦ ?_
    refine ⟨ψ (e y), Metric.ball_subset_closedBall hyb, ?_⟩
    change e.symm (ψ.symm (ψ (e y))) = y
    rw [Homeomorph.symm_apply_apply, e.left_inv hys]
  have hxQ : x ∈ Q := mem_of_mem_nhds hQn
  set Δ : Simplex Y (m + 1) := (ContinuousMap.subtypeVal _).comp (chartSimplex e v hvt)
  set c := truncFin (R := R) hQK z
  have hc : bd R m c ∈ inside R m Qᶜ := bd_truncFin_mem_inside hQK hz
  have hΔ : bd R m (single Δ 1) ∈ inside R m Qᶜ := bd_single_chartSimplex_mem_inside hvt hQor
  obtain ⟨hgen, -, -⟩ := hP e x hx v hv hvt
  obtain ⟨t, w, htw⟩ := hgen c (inside_mono m (compl_subset_compl.2
    (singleton_subset_iff.2 hxQ)) hc)
  have hbox : IsRelBoundary R (m + 1) Q (c - t • single Δ 1) := by
    refine isRelBoundary_chartBall hB hxQ ?_ ⟨w, htw⟩
    rw [map_sub, map_smul]
    exact Submodule.sub_mem _ hc (Submodule.smul_mem _ _ hΔ)
  have key : ∀ y ∈ Q, (IsRelBoundary R (m + 1) {y} c ↔ t = 0) := by
    intro y hy
    obtain ⟨hys, hvy⟩ := hQor y hy
    obtain ⟨-, hfree, -⟩ := hP e y hys v hvy hvt
    have hby := hbox.mono (singleton_subset_iff.2 hy)
    refine ⟨fun h ↦ hfree t ?_, fun ht ↦ ?_⟩
    · have := h.sub hby
      rwa [sub_sub_cancel] at this
    · rw [ht, zero_smul, sub_zero] at hby
      exact hby
  filter_upwards [hQn] with y hy
  rw [← isRelBoundary_truncFin_iff hQK hy, ← isRelBoundary_truncFin_iff hQK hxQ, key y hy,
    key x hxQ]

end Constancy

section Global

open borelMooreHomology

variable {R : Type u} [CommRing R] {H : Type v} [AddCommGroup H] [Module ℝ H]
  [TopologicalSpace H] [ContinuousAdd H] [ContinuousSMul ℝ H] [T2Space H]
  {Y : Type u} [TopologicalSpace Y] [T2Space Y] [ChartedSpace H Y]

/-- **A locally finite top-degree cycle which is a relative boundary at every point is a
boundary**: by Hatcher's Lemma 3.27(b) its truncation to every compact `K` is a relative boundary
for `K`, and the `lim¹` lifting argument (with `H_{n+1}(Y, Y - K) = 0`) concludes. -/
theorem exists_d_eq_of_forall_isRelBoundary [SecondCountableTopology Y] {m : ℕ}
    (b : Module.Basis (Fin (m + 1)) ℝ H)
    {z : (borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)).X (m + 1)}
    (hz : ((borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)).d (m + 1) m).hom z = 0)
    (hloc : ∀ x : Y,
      IsRelBoundary R (m + 1) {x} (truncFin (isCompact_singleton (x := (x : TopCat.of Y))) z)) :
    ∃ W : (borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)).X (m + 2),
      ((borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)).d (m + 2) (m + 1)).hom W = z := by
  haveI : LocallyCompactSpace H := (basisHomeomorph b).isOpenEmbedding.locallyCompactSpace
  haveI : LocallyCompactSpace Y := ChartedSpace.locallyCompactSpace H Y
  refine exists_d_eq_of_forall_isCompact (m := m + 1) z (fun K hK ↦ ?_) (fun K hK ↦
    relVanishingBM_of_relVanishing (relVanishing_of_isCompact_of_chartedSpace (Y := Y) b
      (fun a c k hk ↦ relVanishing_Icc (fun n hn j hj ↦ cycleVanishing_compl_zero n hn j hj)
        _ a c k hk) hK (m + 1) le_rfl))
  obtain ⟨w, hw⟩ := isRelBoundary_of_isCompact_of_forall_mem (Y := Y) b le_rfl hK
    (bd_truncFin_mem_inside hK hz) fun x hx ↦
      (isRelBoundary_truncFin_iff (R := R) hK hx z).2 (hloc x)
  refine ⟨ofFinsupp w, ?_⟩
  rw [d_ofFinsupp]
  have h2 : IsOffChain K (ofFinsupp (truncFin hK z - bd R (m + 1) w)) :=
    isOffChain_ofFinsupp_iff.2 hw
  rw [ofFinsupp_sub, ofFinsupp_truncFin] at h2
  have := (isOffChain_sub_truncChain K z).add h2
  rwa [sub_add_sub_cancel] at this

end Global

section Main

open borelMooreHomology

variable {R : Type u} [CommRing R] {H : Type v} [AddCommGroup H] [Module ℝ H]
  [TopologicalSpace H] [ContinuousAdd H] [ContinuousSMul ℝ H] [T2Space H]
  {Y : Type u} [TopologicalSpace Y] [T2Space Y] [ChartedSpace H Y]

/-- **Poincaré duality in top degree, from the local package** (Hatcher, Theorem 3.26; Fulton,
§19.1, (3)): on a connected, Hausdorff, second countable real `(m + 1)`-manifold `Y` with the
local package, every fundamental class `μ` freely generates `H_{m+1} Y`. -/
theorem topHomologyFreeOnFundamentalClass_of_localPackage [SecondCountableTopology Y]
    [ConnectedSpace Y] {m : ℕ} (b : Module.Basis (Fin (m + 1)) ℝ H) (hP : LocalPackage R Y b) :
    TopHomologyFreeOnFundamentalClass R Y b := by
  intro μ hμ
  set C := borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)
  set ι := borelMooreHomologyIsoOfNat R (ModuleCat.of R R) (TopCat.of Y) (m + 1)
  have hsurjπ := (ModuleCat.epi_iff_surjective (C.homologyπ (m + 1))).1 inferInstance
  obtain ⟨x₀⟩ := (inferInstance : Nonempty Y)
  set e₀ := chartAt H x₀
  have hx₀ : x₀ ∈ e₀.source := mem_chart_source H x₀
  obtain ⟨v₀, hv₀, hvt₀⟩ := exists_isOrientedSimplexAroundZero_subset b (e₀ x₀)
    (e₀.open_target.mem_nhds (mem_chart_target H x₀))
  obtain ⟨hgen₀, -, φ₀, hφ₀, hφ₀Δ⟩ := hP e₀ x₀ hx₀ v₀ hv₀ hvt₀
  have hlocμ : IsLocallyClassOf R μ x₀
      (inclChainSimplex (chartOpens e₀) (chartSimplex e₀ v₀ hvt₀)) :=
    IsLocallyClassOf.of_restrict (chartOpens e₀) (x := ⟨x₀, hx₀⟩)
      (hμ e₀ (chart_mem_atlas H x₀) ⟨x₀, hx₀⟩ v₀ hv₀ hvt₀)
  obtain ⟨μz, hμz⟩ := hsurjπ (ι.hom μ)
  set P := chainPairing (X := TopCat.of Y) (x := x₀) hφ₀.1
  have hμ1 : P (C.iCycles (m + 1) μz) = 1 := by
    rw [chainPairing_apply, hlocμ μz hμz φ₀ hφ₀]
    change φ₀ ((ContinuousMap.subtypeVal _).comp (chartSimplex e₀ v₀ hvt₀)) = 1
    rw [← hφ₀Δ, SingularCochain.eval, linearCombination_single, one_smul]
  -- injectivity
  have hinj0 : ∀ r : R, r • μ = 0 → r = 0 := by
    intro r hr
    have h1 : C.homologyπ (m + 1) (r • μz) = C.homologyπ (m + 1) 0 := by
      rw [map_smul, hμz, map_zero, ← map_smul, hr, map_zero]
    have := localPairing_eq_of_homologyπ_eq h1 hφ₀
    rw [← chainPairing_apply hφ₀.1, ← chainPairing_apply hφ₀.1] at this
    change P (C.iCycles (m + 1) (r • μz)) = P (C.iCycles (m + 1) 0) at this
    rwa [map_smul, map_smul, map_zero, map_zero, hμ1, smul_eq_mul, mul_one] at this
  refine ⟨fun r s h ↦ sub_eq_zero.1 (hinj0 (r - s) (by
    change r • μ = s • μ at h
    rw [sub_smul, h, sub_self])), fun a ↦ ?_⟩
  -- surjectivity
  obtain ⟨z, hz⟩ := hsurjπ (ι.hom a)
  set r := P (C.iCycles (m + 1) z)
  refine ⟨r, ?_⟩
  change r • μ = a
  have hd : ∀ w : C.cycles (m + 1), (C.d (m + 1) m).hom (C.iCycles (m + 1) w) = 0 := fun w ↦
    congrArg (fun f ↦ ModuleCat.Hom.hom f w) (C.iCycles_d (m + 1) m)
  set ζ : C.X (m + 1) := C.iCycles (m + 1) (z - r • μz)
  have hζ : (C.d (m + 1) m).hom ζ = 0 := hd _
  have hpair : P ζ = 0 := by
    simp only [ζ, map_sub, map_smul, hμ1, smul_eq_mul, mul_one]
    exact sub_self _
  -- the base point is in the good set
  have hS₀ : IsRelBoundary R (m + 1) {x₀}
      (truncFin (isCompact_singleton (x := (x₀ : TopCat.of Y))) ζ) := by
    obtain ⟨t, w, htw⟩ := hgen₀ _ (bd_truncFin_mem_inside isCompact_singleton hζ)
    have he := eval_eq_zero_of_mem_vanishing hφ₀.1 htw
    have hcob : coboundary R (m + 1) φ₀ = 0 := hφ₀.2
    rw [map_sub, map_sub, map_smul, hφ₀Δ, ← eval_coboundary, hcob] at he
    have heval := eval_truncFin (isCompact_singleton (x := (x₀ : TopCat.of Y))) ζ
      (mem_singleton _) hφ₀.1
    erw [heval] at he
    have ht : t = 0 := by
      have h0 : localPairing ((ζ.1 : _ → R)) φ₀ = 0 := hpair
      simpa [h0] using he
    rw [ht, zero_smul, sub_zero] at htw
    exact ⟨w, htw⟩
  -- the good set is open and closed
  have hS : ∀ x : Y, IsRelBoundary R (m + 1) {x}
      (truncFin (isCompact_singleton (x := (x : TopCat.of Y))) ζ) := by
    set S : Set Y := setOf fun x : Y ↦ IsRelBoundary R (m + 1) {x}
      (truncFin (isCompact_singleton (x := (x : TopCat.of Y))) ζ)
    have hopen : IsOpen S := isOpen_iff_mem_nhds.2 fun x hx ↦
      (eventually_isRelBoundary_truncFin_iff hP hζ x).mono fun y hy ↦ hy.2 hx
    have hclosed : IsOpen Sᶜ := isOpen_iff_mem_nhds.2 fun x hx ↦
      (eventually_isRelBoundary_truncFin_iff hP hζ x).mono fun y hy hyS ↦ hx (hy.1 hyS)
    have huniv := IsClopen.eq_univ ⟨isOpen_compl_iff.1 hclosed, hopen⟩ ⟨x₀, hS₀⟩
    intro x
    have hx : x ∈ S := by rw [huniv]; exact mem_univ x
    exact hx
  obtain ⟨W, hW⟩ := exists_d_eq_of_forall_isRelBoundary b hζ hS
  have hcyc : z - r • μz = C.toCycles (m + 2) (m + 1) W := by
    apply (ModuleCat.mono_iff_injective (C.iCycles (m + 1))).1 inferInstance
    have := ConcreteCategory.congr_hom (C.toCycles_i (m + 2) (m + 1)) W
    rw [ConcreteCategory.comp_apply] at this
    rw [this]
    exact hW.symm
  have h0 : C.homologyπ (m + 1) (z - r • μz) = 0 := by
    rw [hcyc]
    have := ConcreteCategory.congr_hom (C.toCycles_comp_homologyπ (m + 2) (m + 1)) W
    rw [ConcreteCategory.comp_apply] at this
    exact this.trans (by rfl)
  rw [map_sub, sub_eq_zero, map_smul, hz, hμz, ← map_smul] at h0
  have := congrArg ι.inv h0
  simpa using this.symm

/-- **Poincaré duality in top degree, dimension `0`**: a connected `0`-manifold is a point, and
every fundamental class freely generates `H_0`. No local package is needed. -/
theorem topHomologyFreeOnFundamentalClass_zero [ConnectedSpace Y]
    (b : Module.Basis (Fin 0) ℝ H) : TopHomologyFreeOnFundamentalClass R Y b := by
  intro μ hμ
  haveI : Subsingleton H := b.equivFun.injective.subsingleton
  obtain ⟨x₀⟩ := (inferInstance : Nonempty Y)
  have hY : ∀ y : Y, y = x₀ := by
    have hopen : ∀ x : Y, IsOpen ({x} : Set Y) := fun x ↦ by
      have : (chartAt H x).source = {x} := Set.eq_singleton_iff_unique_mem.2
        ⟨mem_chart_source H x, fun y hy ↦
          (chartAt H x).injOn hy (mem_chart_source H x) (Subsingleton.elim _ _)⟩
      rw [← this]
      exact (chartAt H x).open_source
    have huniv := IsClopen.eq_univ ⟨isClosed_singleton, hopen x₀⟩ ⟨x₀, rfl⟩
    intro y
    have hy : y ∈ ({x₀} : Set Y) := by rw [huniv]; exact mem_univ y
    exact hy
  set C := borelMooreChainComplex R (ModuleCat.of R R) (TopCat.of Y)
  set ι := borelMooreHomologyIsoOfNat R (ModuleCat.of R R) (TopCat.of Y) 0
  have hsurjπ := (ModuleCat.epi_iff_surjective (C.homologyπ 0)).1 inferInstance
  set e₀ := chartAt H x₀
  have hx₀ : x₀ ∈ e₀.source := mem_chart_source H x₀
  obtain ⟨v₀, hv₀, hvt₀⟩ := exists_isOrientedSimplexAroundZero_subset b (e₀ x₀)
    (e₀.open_target.mem_nhds (mem_chart_target H x₀))
  set φ₀ : Simplex (TopCat.of Y) 0 → R := fun _ ↦ 1
  have hφ₀ : φ₀ ∈ relCocycles R ({x₀}ᶜ : Set (TopCat.of Y)) 0 := by
    refine ⟨fun σ hσ ↦ absurd (hσ ⟨stdSimplex.vertex 0, rfl⟩) fun h ↦ h (hY _), ?_⟩
    refine LinearMap.mem_ker.2 (funext fun σ ↦ ?_)
    rw [coboundary_apply]
    simp [φ₀, Fin.sum_univ_two]
  have hlocμ : IsLocallyClassOf R μ x₀
      (inclChainSimplex (chartOpens e₀) (chartSimplex e₀ v₀ hvt₀)) :=
    IsLocallyClassOf.of_restrict (chartOpens e₀) (x := ⟨x₀, hx₀⟩)
      (hμ e₀ (chart_mem_atlas H x₀) ⟨x₀, hx₀⟩ v₀ hv₀ hvt₀)
  obtain ⟨μz, hμz⟩ := hsurjπ (ι.hom μ)
  set P := chainPairing (X := TopCat.of Y) (x := x₀) hφ₀.1
  have hμ1 : P (C.iCycles 0 μz) = 1 := by
    rw [chainPairing_apply, hlocμ μz hμz φ₀ hφ₀]
  haveI : Subsingleton (C(stdSimplex ℝ (Fin 1), TopCat.of Y)) :=
    ⟨fun f g ↦ ContinuousMap.ext fun _ ↦ (hY _).trans (hY _).symm⟩
  haveI : Subsingleton ((TopCat.toSSet.obj (TopCat.of Y)).obj (op ⦋0⦌)) :=
    (SingularCochain.simplexEquiv (TopCat.of Y) _).injective.subsingleton
  have hP0 : ∀ (c : C.X 0) σ, c.1 σ = P c := by
    intro c σ
    rw [chainPairing_apply, localPairing,
      finsum_eq_single _ σ (fun τ hτ ↦ absurd (Subsingleton.elim τ σ) hτ)]
    exact (mul_one _).symm
  -- injectivity
  have hinj0 : ∀ r : R, r • μ = 0 → r = 0 := by
    intro r hr
    have h1 : C.homologyπ 0 (r • μz) = C.homologyπ 0 0 := by
      rw [map_smul, hμz, map_zero, ← map_smul, hr, map_zero]
    have := localPairing_eq_of_homologyπ_eq h1 hφ₀
    rw [← chainPairing_apply hφ₀.1, ← chainPairing_apply hφ₀.1] at this
    change P (C.iCycles 0 (r • μz)) = P (C.iCycles 0 0) at this
    rwa [map_smul, map_smul, map_zero, map_zero, hμ1, smul_eq_mul, mul_one] at this
  refine ⟨fun r s h ↦ sub_eq_zero.1 (hinj0 (r - s) (by
    change r • μ = s • μ at h
    rw [sub_smul, h, sub_self])), fun a ↦ ?_⟩
  -- surjectivity: a `0`-chain of a point is its coefficient times the point
  obtain ⟨z, hz⟩ := hsurjπ (ι.hom a)
  set r := P (C.iCycles 0 z)
  refine ⟨r, ?_⟩
  change r • μ = a
  have hcyc : z - r • μz = 0 := by
    apply (ModuleCat.mono_iff_injective (C.iCycles 0)).1 inferInstance
    rw [map_zero]
    apply Subtype.ext
    funext σ
    rw [hP0]
    simp only [map_sub, map_smul, hμ1, smul_eq_mul, mul_one, r]
    exact sub_self _
  have h0 : C.homologyπ 0 (z - r • μz) = 0 := by rw [hcyc, map_zero]
  rw [map_sub, sub_eq_zero, map_smul, hz, hμz, ← map_smul] at h0
  have := congrArg ι.inv h0
  simpa using this.symm

/-- **Poincaré duality in top degree** (Fulton, §19.1, (3)): on a connected, Hausdorff, second
countable real `n`-manifold `Y`, every fundamental class freely generates `H_n Y`, given the
local package in every positive dimension. -/
theorem topHomologyFreeOnFundamentalClass [SecondCountableTopology Y] [ConnectedSpace Y]
    (hP : ∀ (m : ℕ) (b' : Module.Basis (Fin (m + 1)) ℝ H), LocalPackage R Y b') {n : ℕ}
    (b : Module.Basis (Fin n) ℝ H) : TopHomologyFreeOnFundamentalClass R Y b := by
  cases n with
  | zero => exact topHomologyFreeOnFundamentalClass_zero b
  | succ m => exact topHomologyFreeOnFundamentalClass_of_localPackage b (hP m b)

omit [ChartedSpace H Y] in
/-- The local package holds at every point of every chart. -/
theorem localPackage {m : ℕ} (b : Module.Basis (Fin (m + 1)) ℝ H) : LocalPackage R Y b :=
  fun e _ hy _ hv hvt ↦ ⟨exists_sub_smul_chartSimplexIn_mem b e hy hv hvt,
    eq_zero_of_smul_chartSimplexIn_mem b e hy hv hvt,
    exists_mem_relCocycles_eval_chartSimplexIn b e hy hv hvt⟩

/-- **Poincaré duality in top degree** (Fulton, §19.1, (3); the first clause of
`thm_ext_c19_poincare_alexander_duality`): on a connected, Hausdorff, second countable real
`n`-manifold `Y`, modelled on a Hausdorff real vector space `H` with a basis `b` of `n` vectors
and oriented in its charts by `b`, every fundamental class `μ_Y` freely generates `H_n Y`:
`r ↦ r • μ_Y` is a bijection `R ≃ H_n Y`. -/
theorem topHomologyFreeOnFundamentalClass_of_manifold [SecondCountableTopology Y]
    [ConnectedSpace Y] {n : ℕ} (b : Module.Basis (Fin n) ℝ H) :
    TopHomologyFreeOnFundamentalClass R Y b :=
  topHomologyFreeOnFundamentalClass (fun _ b' ↦ localPackage b') b

end Main

