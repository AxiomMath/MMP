module

public import MMP.AlgebraicTopology.PoincareDuality.PuncturedLow
public import MMP.AlgebraicTopology.ThomClass.Basic
public import Mathlib.Algebra.BigOperators.Field

/-!
# The local homology `H_n(ℝⁿ, ℝⁿ - 0)` is free of rank one

In the finite chain model of singular chains, the local homology `H_n(ℝⁿ, ℝⁿ - 0; R)`, `n ≥ 1`, is
free of rank one on the class of an explicit affine simplex `Δₙ` positively oriented around `0` for
the standard basis.

* Generation and freeness of reduced homology on a given cycle (`GenBy`, `FreeBy`); reduced
  cycles are `0`-chains of augmentation `0` in degree `0`, and cycles above.
* Their transport along a homotopy equivalence, and the Mayer–Vietoris step for two open
  acyclic sets `U`, `V`: if `A ⊆ U`, `B ⊆ V` with `∂ A + ∂ B = 0` and `∂ A` generates (freely)
  the reduced homology of `U ∩ V`, then `A + B` generates (freely) that of `U ∪ V`.
* The vertices `Δ₀ = 0 ∈ ℝ⁰`, and `Δₙ₊₁` with vertices `(v, -1)` for the vertices `v` of `Δₙ`
  and the apex `(0, 1)`. The faces of `Δₙ₊₁` through the apex miss the closed negative last
  half-axis, the last face lies in `xₙ = -1` and projects onto `Δₙ`.
* Induction on `n` with the complements `halfAxisCompl` of the closed last half-axes, and the
  long exact sequence of the pair `(ℝⁿ, ℝⁿ - 0)` at the chain level.

## Main results

* `MMP.SingularChain.isOrientedSimplexAroundZero_localGeneratorVertices`
* `MMP.SingularChain.exists_sub_smul_localGenerator_mem`: generation.
* `MMP.SingularChain.eq_zero_of_smul_localGenerator_mem`: freeness.

## References

* [A. Hatcher, *Algebraic Topology*][hatcher2002], §2.1, Corollary 2.14 and §2.2, Example 2.23.
-/

@[expose] public noncomputable section

open Finsupp Set

namespace MMP

namespace SingularChain

variable {R : Type*} [CommRing R] {Y Z : Type*} [TopologicalSpace Y] [TopologicalSpace Z]

section reduced

variable (R Y) in
/-- Reduced cycles: `0`-chains of augmentation `0` in degree `0`, cycles in positive degree. -/
def reducedCycles : (k : ℕ) → Submodule R (Chain R Y k)
  | 0 => LinearMap.ker (aug R 0)
  | k + 1 => LinearMap.ker (bd R k)

/-- A `0`-chain is a reduced cycle iff its augmentation vanishes. -/
lemma mem_reducedCycles_zero {c : Chain R Y 0} : c ∈ reducedCycles R Y 0 ↔ aug R 0 c = 0 :=
  LinearMap.mem_ker

/-- A chain of positive degree is a reduced cycle iff its boundary vanishes. -/
lemma mem_reducedCycles_succ {k : ℕ} {c : Chain R Y (k + 1)} :
    c ∈ reducedCycles R Y (k + 1) ↔ bd R k c = 0 :=
  LinearMap.mem_ker

/-- A boundary is a reduced cycle. -/
lemma bd_mem_reducedCycles (k : ℕ) (w : Chain R Y (k + 1)) : bd R k w ∈ reducedCycles R Y k := by
  cases k with
  | zero => exact mem_reducedCycles_zero.2 (aug_bd_zero w)
  | succ k => exact mem_reducedCycles_succ.2 (bd_bd k w)

/-- Pushforward along a continuous map preserves reduced cycles. -/
lemma postcomp_mem_reducedCycles (f : C(Y, Z)) {k : ℕ} {c : Chain R Y k}
    (hc : c ∈ reducedCycles R Y k) : postcomp R f k c ∈ reducedCycles R Z k := by
  cases k with
  | zero => rw [mem_reducedCycles_zero, aug_postcomp]; exact mem_reducedCycles_zero.1 hc
  | succ k =>
    rw [mem_reducedCycles_succ, ← postcomp_bd, mem_reducedCycles_succ.1 hc, map_zero]

/-- A reduced cycle in a star-shaped set bounds there. -/
lemma isBoundaryIn_of_starConvex {E : Type*} [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℝ E] {C : Set E} {p : E}
    (hC : StarConvex ℝ p C) {k : ℕ} {c : Chain R E k} (hc : c ∈ inside R k C)
    (hz : c ∈ reducedCycles R E k) : IsBoundaryIn R k C c := by
  cases k with
  | zero => exact exists_bd_eq_of_starConvex_zero hC hc (mem_reducedCycles_zero.1 hz)
  | succ k => exact exists_bd_eq_of_starConvex hC hc (mem_reducedCycles_succ.1 hz)

/-- The prism of a homotopy on a reduced cycle: `∂ P x = g_# x - f_# x`. -/
lemma bd_prism_of_mem_reducedCycles (F : C(Y × unitInterval, Z)) {f g : C(Y, Z)}
    (hf : ∀ y, F (y, 0) = f y) (hg : ∀ y, F (y, 1) = g y) {k : ℕ} {x : Chain R Y k}
    (hx : x ∈ reducedCycles R Y k) :
    bd R k (prism R F k x) = postcomp R g k x - postcomp R f k x := by
  cases k with
  | zero => exact bd_prism_zero F hf hg x
  | succ k =>
    have h := bd_prism_add_prism_bd (R := R) F hf hg k x
    rwa [mem_reducedCycles_succ.1 hx, map_zero, add_zero] at h

end reduced

section genFree

variable (R) in
/-- The reduced homology `H̃_k(S; R)` (chains of `Y` lying in `S`) is generated by the class
of `z`. -/
def GenBy (S : Set Y) (k : ℕ) (z : Chain R Y k) : Prop :=
  ∀ c ∈ inside R k S, c ∈ reducedCycles R Y k → ∃ r : R, IsBoundaryIn R k S (c - r • z)

variable (R) in
/-- The class of `z` in `H̃_k(S; R)` is free: `r • z` bounds in `S` only for `r = 0`. -/
def FreeBy (S : Set Y) (k : ℕ) (z : Chain R Y k) : Prop :=
  ∀ r : R, IsBoundaryIn R k S (r • z) → r = 0

/-- `(-1) ^ j * (-1) ^ j = 1`. -/
lemma neg_one_pow_mul_neg_one_pow (j : ℕ) : (-1 : R) ^ j * (-1) ^ j = 1 := by
  rw [← mul_pow, neg_one_mul, neg_neg, one_pow]

/-- If `z` generates `H̃_k(S)`, so does `(-1) ^ j • z`. -/
lemma GenBy.neg_one_pow_smul {S : Set Y} {k : ℕ} {z : Chain R Y k} (h : GenBy R S k z)
    (j : ℕ) : GenBy R S k ((-1 : R) ^ j • z) := by
  intro c hc hz
  obtain ⟨r, hr⟩ := h c hc hz
  refine ⟨r * (-1) ^ j, ?_⟩
  rwa [smul_smul, mul_assoc, neg_one_pow_mul_neg_one_pow, mul_one]

/-- If the class of `z` is free, so is that of `(-1) ^ j • z`. -/
lemma FreeBy.neg_one_pow_smul {S : Set Y} {k : ℕ} {z : Chain R Y k} (h : FreeBy R S k z)
    (j : ℕ) : FreeBy R S k ((-1 : R) ^ j • z) := by
  intro r hr
  rw [← mul_one r, ← neg_one_pow_mul_neg_one_pow j, ← mul_assoc,
    h (r * (-1) ^ j) (by rwa [mul_smul]), zero_mul]

/-- **Homotopy transfer of generation**: if `f` maps `A` into `B`, `g` maps `B` into `A`, `F` is
a homotopy from `g ∘ f` to the identity keeping `A` in `A`, and `f_# z` generates `H̃_k(B)`, then
`z` generates `H̃_k(A)`. -/
theorem GenBy.of_homotopy {A : Set Y} {B : Set Z} (f : C(Y, Z)) (g : C(Z, Y))
    (hf : MapsTo f A B) (hg : MapsTo g B A) (F : C(Y × unitInterval, Y))
    (hF₀ : ∀ y, F (y, 0) = g (f y)) (hF₁ : ∀ y, F (y, 1) = y) (hF : MapsTo F (A ×ˢ univ) A)
    {k : ℕ} {z : Chain R Y k} (hzA : z ∈ inside R k A) (hzc : z ∈ reducedCycles R Y k)
    (h : GenBy R B k (postcomp R f k z)) : GenBy R A k z := by
  intro c hc hcz
  obtain ⟨r, w, hw, hbw⟩ := h (postcomp R f k c) (postcomp_mem_inside f hf hc)
    (postcomp_mem_reducedCycles f hcz)
  refine ⟨r, ?_⟩
  have hx : c - r • z ∈ inside R k A := Submodule.sub_mem _ hc (Submodule.smul_mem _ _ hzA)
  have hxz : c - r • z ∈ reducedCycles R Y k :=
    Submodule.sub_mem _ hcz (Submodule.smul_mem _ _ hzc)
  have key := bd_prism_of_mem_reducedCycles (R := R) F (f := g.comp f)
    (g := ContinuousMap.id Y) (fun y ↦ hF₀ y) (fun y ↦ hF₁ y) hxz
  rw [postcomp_id, ← postcomp_comp] at key
  refine ⟨postcomp R g (k + 1) w + prism R F k (c - r • z),
    Submodule.add_mem _ (postcomp_mem_inside g hg hw) (prism_mem_inside F hF hx), ?_⟩
  rw [map_add, key, ← postcomp_bd, hbw]
  simp only [map_sub, map_smul]
  abel

/-- **Transport of freeness** along a map `f` sending `A` into `B`. -/
theorem FreeBy.of_map {A : Set Y} {B : Set Z} (f : C(Y, Z)) (hf : MapsTo f A B) {k : ℕ}
    {z : Chain R Y k} (h : FreeBy R B k (postcomp R f k z)) : FreeBy R A k z := by
  rintro r ⟨w, hw, hbw⟩
  exact h r ⟨postcomp R f (k + 1) w, postcomp_mem_inside f hf hw,
    by rw [← postcomp_bd, hbw, map_smul]⟩

/-- Every member of the pair `{U, V}` of open sets is open. -/
lemma isOpen_pair {U V : Set Y} (hU : IsOpen U) (hV : IsOpen V) :
    ∀ W ∈ ({U, V} : Set (Set Y)), IsOpen W := by
  rintro W (rfl | rfl)
  · exact hU
  · exact hV

/-- A chain lying in `U ∪ V` lies in `⋃₀ {U, V}`. -/
lemma mem_inside_sUnion_pair {n : ℕ} {U V : Set Y} {c : Chain R Y n}
    (hc : c ∈ inside R n (U ∪ V)) : c ∈ inside R n (⋃₀ ({U, V} : Set (Set Y))) := by
  simpa using hc

/-- **The Mayer–Vietoris step for generation.** For `U`, `V` open with vanishing `H_{k+1}`, a
chain `A` in `U` and `B` in `V` with `∂ A + ∂ B = 0`: if `∂ A` generates `H̃_k(U ∩ V)`, then
`A + B` generates `H_{k+1}(U ∪ V)`. -/
theorem GenBy.union {k : ℕ} {U V : Set Y} (hU : IsOpen U) (hV : IsOpen V)
    (hUa : CycleVanishing R Y k U) (hVa : CycleVanishing R Y k V) {A B : Chain R Y (k + 1)}
    (hA : A ∈ inside R (k + 1) U) (hB : B ∈ inside R (k + 1) V)
    (hAB : bd R k A + bd R k B = 0) (h : GenBy R (U ∩ V) k (bd R k A)) :
    GenBy R (U ∪ V) (k + 1) (A + B) := by
  intro c hc hcz
  have hbc := mem_reducedCycles_succ.1 hcz
  set 𝒰 : Set (Set Y) := {U, V}
  obtain ⟨a, ha, b, hb, hsplit⟩ := exists_add_of_mem_small_pair
    (smallChainMap_mem_small (isOpen_pair hU hV) (k + 1) (mem_inside_sUnion_pair hc))
  rw [smallChainMap_succ, hbc, map_zero, sub_zero] at hsplit
  have hab : bd R k a + bd R k b = 0 := by
    have := congrArg (bd R k) hsplit
    rw [map_sub, bd_bd, hbc, sub_zero, map_add] at this
    exact this.symm
  have hb' : bd R k b = -bd R k a := eq_neg_of_add_eq_zero_right hab
  have hB' : bd R k B = -bd R k A := eq_neg_of_add_eq_zero_right hAB
  have haUV : bd R k a ∈ inside R k (U ∩ V) := by
    rw [inside_inter]
    refine ⟨bd_mem_inside ha, ?_⟩
    rw [← neg_neg (bd R k a), ← hb']
    exact Submodule.neg_mem _ (bd_mem_inside hb)
  obtain ⟨r, d, hd, hbd⟩ := h _ haUV (bd_mem_reducedCycles k a)
  rw [inside_inter] at hd
  obtain ⟨eU, heU, hbeU⟩ := hUa (a - r • A - d)
    (Submodule.sub_mem _ (Submodule.sub_mem _ ha (Submodule.smul_mem _ _ hA)) hd.1)
    (by rw [map_sub, map_sub, map_smul, hbd]; abel)
  obtain ⟨eV, heV, hbeV⟩ := hVa (b - r • B + d)
    (Submodule.add_mem _ (Submodule.sub_mem _ hb (Submodule.smul_mem _ _ hB)) hd.2)
    (by rw [map_add, map_sub, map_smul, hbd, hb', hB', smul_neg]; abel)
  refine ⟨r, smallHomotopy R 𝒰 (k + 1) c + eU + eV, ?_, ?_⟩
  · refine Submodule.add_mem _ (Submodule.add_mem _ (smallHomotopy_mem_inside_of_mem 𝒰 hc) ?_) ?_
    · exact inside_mono _ subset_union_left heU
    · exact inside_mono _ subset_union_right heV
  · have hc_eq := sub_eq_iff_eq_add'.1 hsplit
    rw [map_add, map_add, hbeU, hbeV, smul_add]
    conv_rhs => rw [hc_eq]
    abel

/-- On a `𝒰`-small chain with `𝒰`-small boundary, `ρ` is the identity. -/
lemma smallChainMap_eq_self_of_mem_small {𝒰 : Set (Set Y)} {n : ℕ} {g : Chain R Y (n + 1)}
    (hg : g ∈ small R (n + 1) 𝒰) (hbg : bd R n g ∈ small R n 𝒰) :
    smallChainMap R 𝒰 (n + 1) g = g := by
  rw [smallChainMap_succ_of_bd_mem_small hbg, smallHomotopy_eq_zero_of_mem_small hg, map_zero,
    sub_zero]

/-- **The Mayer–Vietoris step for freeness.** For `U`, `V` open, a chain `A` in `U` and `B` in
`V` with `∂ A + ∂ B = 0`: if the class of `∂ A` in `H̃_k(U ∩ V)` is free, so is the class of
`A + B` in `H_{k+1}(U ∪ V)`. -/
theorem FreeBy.union {k : ℕ} {U V : Set Y} (hU : IsOpen U) (hV : IsOpen V)
    {A B : Chain R Y (k + 1)} (hA : A ∈ inside R (k + 1) U) (hB : B ∈ inside R (k + 1) V)
    (hAB : bd R k A + bd R k B = 0) (h : FreeBy R (U ∩ V) k (bd R k A)) :
    FreeBy R (U ∪ V) (k + 1) (A + B) := by
  rintro r ⟨w, hw, hbw⟩
  set 𝒰 : Set (Set Y) := {U, V}
  obtain ⟨a, ha, b, hb, hsplit⟩ := exists_add_of_mem_small_pair
    (smallChainMap_mem_small (isOpen_pair hU hV) (k + 2) (mem_inside_sUnion_pair hw))
  have hsm : r • (A + B) ∈ small R (k + 1) 𝒰 :=
    Submodule.smul_mem _ _ (Submodule.add_mem _ (inside_le_small _ (by simp [𝒰]) hA)
      (inside_le_small _ (by simp [𝒰]) hB))
  have hbsm : bd R k (r • (A + B)) ∈ small R k 𝒰 := by
    rw [map_smul, map_add, hAB, smul_zero]
    exact Submodule.zero_mem _
  have h1 := bd_smallChainMap 𝒰 (k + 1) w
  rw [hbw, smallChainMap_eq_self_of_mem_small hsm hbsm, hsplit, map_add] at h1
  have hg : bd R (k + 1) a - r • A ∈ inside R (k + 1) (U ∩ V) := by
    rw [inside_inter]
    refine ⟨Submodule.sub_mem _ (bd_mem_inside ha) (Submodule.smul_mem _ _ hA), ?_⟩
    have : bd R (k + 1) a - r • A = r • B - bd R (k + 1) b := by
      rw [smul_add] at h1
      rw [sub_eq_sub_iff_add_eq_add, add_comm (r • B), ← h1]
    rw [this]
    exact Submodule.sub_mem _ (Submodule.smul_mem _ _ hB) (bd_mem_inside hb)
  refine h r ⟨-(bd R (k + 1) a - r • A), Submodule.neg_mem _ hg, ?_⟩
  rw [map_neg, map_sub, bd_bd, map_smul]
  abel

/-- **The Mayer–Vietoris step for generation in degree `0`**, for `U`, `V` open with vanishing
reduced `H̃₀`: `0`-chains `A` in `U` and `B` in `V` of augmentations `1` and `-1` generate
`H̃₀(U ∪ V)`. -/
theorem GenBy.union_zero {U V : Set Y} (hU : IsOpen U) (hV : IsOpen V)
    (hUa : ReducedZeroVanishing R U) (hVa : ReducedZeroVanishing R V) {A B : Chain R Y 0}
    (hA : A ∈ inside R 0 U) (hB : B ∈ inside R 0 V) (haA : aug R 0 A = 1)
    (haB : aug R 0 B = -1) : GenBy R (U ∪ V) 0 (A + B) := by
  intro c hc hcz
  have hac := mem_reducedCycles_zero.1 hcz
  set 𝒰 : Set (Set Y) := {U, V}
  obtain ⟨a, ha, b, hb, hsplit⟩ := exists_add_of_mem_small_pair
    (smallChainMap_mem_small (isOpen_pair hU hV) 0 (mem_inside_sUnion_pair hc))
  rw [smallChainMap_zero] at hsplit
  have hab : aug R 0 a + aug R 0 b = 0 := by
    have := congrArg (aug R 0) hsplit
    rw [map_sub, hac, aug_bd_zero, sub_zero, map_add] at this
    exact this.symm
  obtain ⟨eU, heU, hbeU⟩ := hUa (a - aug R 0 a • A)
    (Submodule.sub_mem _ ha (Submodule.smul_mem _ _ hA))
    (by rw [map_sub, map_smul, haA, smul_eq_mul, mul_one, sub_self])
  obtain ⟨eV, heV, hbeV⟩ := hVa (b - aug R 0 a • B)
    (Submodule.sub_mem _ hb (Submodule.smul_mem _ _ hB))
    (by rw [map_sub, map_smul, haB, smul_eq_mul, mul_neg_one, sub_neg_eq_add, add_comm, hab])
  refine ⟨aug R 0 a, smallHomotopy R 𝒰 0 c + eU + eV, ?_, ?_⟩
  · refine Submodule.add_mem _ (Submodule.add_mem _ (smallHomotopy_mem_inside_of_mem 𝒰 hc) ?_) ?_
    · exact inside_mono _ subset_union_left heU
    · exact inside_mono _ subset_union_right heV
  · have hc_eq := sub_eq_iff_eq_add'.1 hsplit
    rw [map_add, map_add, hbeU, hbeV, smul_add]
    conv_rhs => rw [hc_eq]
    abel

/-- **The Mayer–Vietoris step for freeness in degree `0`**, for disjoint open `U`, `V`: a
`0`-chain `A` in `U` of augmentation `1` and any `0`-chain `B` in `V` have a free class `A + B`
in `H̃₀(U ∪ V)`. -/
theorem FreeBy.union_zero {U V : Set Y} (hU : IsOpen U) (hV : IsOpen V) (hUV : U ∩ V = ∅)
    {A B : Chain R Y 0} (hA : A ∈ inside R 0 U) (hB : B ∈ inside R 0 V) (haA : aug R 0 A = 1) :
    FreeBy R (U ∪ V) 0 (A + B) := by
  rintro r ⟨w, hw, hbw⟩
  set 𝒰 : Set (Set Y) := {U, V}
  obtain ⟨a, ha, b, hb, hsplit⟩ := exists_add_of_mem_small_pair
    (smallChainMap_mem_small (isOpen_pair hU hV) 1 (mem_inside_sUnion_pair hw))
  have hsm : r • (A + B) ∈ small R 0 𝒰 :=
    Submodule.smul_mem _ _ (Submodule.add_mem _ (inside_le_small _ (by simp [𝒰]) hA)
      (inside_le_small _ (by simp [𝒰]) hB))
  have h1 := bd_smallChainMap 𝒰 0 w
  rw [hbw, smallChainMap_zero, smallHomotopy_eq_zero_of_mem_small hsm, map_zero, sub_zero,
    hsplit, map_add] at h1
  have hg : bd R 0 a - r • A ∈ inside R 0 (U ∩ V) := by
    rw [inside_inter]
    refine ⟨Submodule.sub_mem _ (bd_mem_inside ha) (Submodule.smul_mem _ _ hA), ?_⟩
    have : bd R 0 a - r • A = r • B - bd R 0 b := by
      rw [smul_add] at h1
      rw [sub_eq_sub_iff_add_eq_add, add_comm (r • B), ← h1]
    rw [this]
    exact Submodule.sub_mem _ (Submodule.smul_mem _ _ hB) (bd_mem_inside hb)
  rw [hUV] at hg
  have h0 := congrArg (aug R 0) (eq_zero_of_mem_inside_empty hg)
  rwa [map_sub, aug_bd_zero, map_smul, haA, smul_eq_mul, mul_one, zero_sub, map_zero,
    neg_eq_zero] at h0

end genFree

section vertices

open ThomClass

/-- The vertices of the explicit oriented simplex `Δₙ` around `0` in `ℝⁿ`: `Δ₀ = 0 ∈ ℝ⁰`, and
`Δₙ₊₁` has the vertices `(v, -1)`, `v` a vertex of `Δₙ`, followed by the apex `(0, 1)`. -/
def localGeneratorVertices : (n : ℕ) → Fin (n + 1) → (Fin n → ℝ)
  | 0 => fun _ ↦ 0
  | n + 1 => Fin.snoc (α := fun _ ↦ Fin (n + 1) → ℝ)
      (fun i ↦ Fin.snoc (α := fun _ ↦ ℝ) (localGeneratorVertices n i) (-1))
      (Fin.snoc (α := fun _ ↦ ℝ) 0 1)

/-- The `i`-th non-apex vertex of `Δₙ₊₁` is `(vᵢ, -1)`, `vᵢ` the `i`-th vertex of `Δₙ`. -/
lemma localGeneratorVertices_castSucc (n : ℕ) (i : Fin (n + 1)) :
    localGeneratorVertices (n + 1) i.castSucc =
      Fin.snoc (α := fun _ ↦ ℝ) (localGeneratorVertices n i) (-1) := by
  simp [localGeneratorVertices]

/-- The last vertex of `Δₙ₊₁` is the apex `(0, 1)`. -/
lemma localGeneratorVertices_last (n : ℕ) :
    localGeneratorVertices (n + 1) (Fin.last (n + 1)) = Fin.snoc (α := fun _ ↦ ℝ) 0 1 := by
  simp [localGeneratorVertices]

/-- The last coordinate of a combination of the vertices of `Δₙ₊₁`. -/
lemma sum_smul_localGeneratorVertices_last (n : ℕ) (s : Fin (n + 2) → ℝ) :
    (∑ k, s k • localGeneratorVertices (n + 1) k) (Fin.last n) =
      s (Fin.last (n + 1)) - ∑ i : Fin (n + 1), s i.castSucc := by
  rw [Fin.sum_univ_castSucc]
  simp [Finset.sum_apply, localGeneratorVertices_castSucc, localGeneratorVertices_last]
  ring

/-- The first `n` coordinates of a combination of the vertices of `Δₙ₊₁`. -/
lemma init_sum_smul_localGeneratorVertices (n : ℕ) (s : Fin (n + 2) → ℝ) :
    Fin.init (∑ k, s k • localGeneratorVertices (n + 1) k) =
      ∑ i : Fin (n + 1), s i.castSucc • localGeneratorVertices n i := by
  funext j
  rw [Fin.sum_univ_castSucc]
  simp [Fin.init, Finset.sum_apply, localGeneratorVertices_castSucc, localGeneratorVertices_last]

/-- The `0`-th vertex of `Δₙ₊₁` is `(v₀, -1)`, `v₀` the `0`-th vertex of `Δₙ`. -/
lemma localGeneratorVertices_zero (n : ℕ) :
    localGeneratorVertices (n + 1) 0 =
      Fin.snoc (α := fun _ ↦ ℝ) (localGeneratorVertices n 0) (-1) := by
  rw [← Fin.castSucc_zero, localGeneratorVertices_castSucc]

/-- The `(i + 1)`-th vertex of `Δₙ₊₁`, for `i < n`, is `(vᵢ₊₁, -1)`. -/
lemma localGeneratorVertices_castSucc_succ (n : ℕ) (i : Fin n) :
    localGeneratorVertices (n + 1) i.castSucc.succ =
      Fin.snoc (α := fun _ ↦ ℝ) (localGeneratorVertices n i.succ) (-1) := by
  rw [Fin.succ_castSucc, localGeneratorVertices_castSucc]

/-- The determinant of the edge vectors `vₖ₊₁ - v₀` of `Δₙ₊₁` in the standard basis is twice
that of `Δₙ`. -/
lemma det_localGeneratorVertices_succ (n : ℕ) :
    (Pi.basisFun ℝ (Fin (n + 1))).det (fun k ↦ localGeneratorVertices (n + 1) k.succ -
      localGeneratorVertices (n + 1) 0) =
    2 * (Pi.basisFun ℝ (Fin n)).det (fun k ↦ localGeneratorVertices n k.succ -
      localGeneratorVertices n 0) := by
  rw [Module.Basis.det_apply, Module.Basis.det_apply, Matrix.det_succ_row _ (Fin.last n),
    Fin.sum_univ_castSucc]
  rw [Finset.sum_eq_zero (fun i _ ↦ by
    simp [Module.Basis.toMatrix_apply, localGeneratorVertices_castSucc_succ,
      localGeneratorVertices_zero]), zero_add]
  have hsub : ((Pi.basisFun ℝ (Fin (n + 1))).toMatrix fun k ↦ localGeneratorVertices (n + 1)
      k.succ - localGeneratorVertices (n + 1) 0).submatrix (Fin.last n).succAbove
      (Fin.last n).succAbove = (Pi.basisFun ℝ (Fin n)).toMatrix fun k ↦
        localGeneratorVertices n k.succ - localGeneratorVertices n 0 := by
    ext i j
    simp [Module.Basis.toMatrix_apply, localGeneratorVertices_castSucc_succ,
      localGeneratorVertices_zero]
  rw [hsub, Even.neg_one_pow ⟨_, rfl⟩, one_mul]
  congr 1
  simp [Module.Basis.toMatrix_apply, localGeneratorVertices_zero, localGeneratorVertices_last]
  norm_num

/-- **`Δₙ` is an oriented simplex around `0`** for the standard basis of `ℝⁿ`. -/
theorem isOrientedSimplexAroundZero_localGeneratorVertices :
    ∀ n, IsOrientedSimplexAroundZero (Pi.basisFun ℝ (Fin n)) (localGeneratorVertices n)
  | 0 => ⟨⟨fun _ ↦ 1, fun _ ↦ one_pos, by simp, by simp [localGeneratorVertices]⟩,
      by simp⟩
  | n + 1 => by
    obtain ⟨⟨t, ht0, ht1, htv⟩, hdet⟩ := isOrientedSimplexAroundZero_localGeneratorVertices n
    refine ⟨⟨Fin.snoc (α := fun _ ↦ ℝ) (fun i ↦ t i / 2) (1 / 2), ?_, ?_, ?_⟩, ?_⟩
    · intro k
      induction k using Fin.lastCases with
      | last => simp
      | cast i => simp only [Fin.snoc_castSucc]; exact half_pos (ht0 i)
    · rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last]
      rw [← Finset.sum_div, ht1]
      norm_num
    · refine (init_eq_zero_and_last_eq_zero_iff _).1 ⟨?_, ?_⟩
      · rw [init_sum_smul_localGeneratorVertices]
        simp only [Fin.snoc_castSucc, div_eq_mul_inv, mul_comm _ (2⁻¹ : ℝ), mul_smul,
          ← Finset.smul_sum, htv, smul_zero]
      · rw [sum_smul_localGeneratorVertices_last]
        simp only [Fin.snoc_castSucc, Fin.snoc_last]
        rw [← Finset.sum_div, ht1]
        norm_num
    · rw [det_localGeneratorVertices_succ]
      exact mul_pos two_pos hdet

/-- The explicit oriented simplex `Δₙ` around `0` in `ℝⁿ`. -/
def localGenerator (n : ℕ) : Simplex (Fin n → ℝ) n :=
  affineSimplex (localGeneratorVertices n)

/-- A point of the `i`-th face of the standard simplex has `i`-th coordinate `0`. -/
lemma stdSimplex_map_succAbove_self {n : ℕ} (i : Fin (n + 2)) (t : stdSimplex ℝ (Fin (n + 1))) :
    (stdSimplex.map i.succAbove t : Fin (n + 2) → ℝ) i = 0 := by
  rw [stdSimplex.map_coe, FunOnFinite.linearMap_apply_apply]
  exact Finset.sum_eq_zero fun k hk ↦ absurd (Finset.mem_filter.1 hk).2 (Fin.succAbove_ne i k)

/-- Including the standard simplex along `Fin.castSucc` preserves the coordinates `i.castSucc`. -/
lemma stdSimplex_map_castSucc_castSucc {n : ℕ} (t : stdSimplex ℝ (Fin (n + 1)))
    (i : Fin (n + 1)) : (stdSimplex.map Fin.castSucc t : Fin (n + 2) → ℝ) i.castSucc = t i := by
  rw [stdSimplex.map_coe, FunOnFinite.linearMap_apply_apply]
  simp [Fin.castSucc_inj, Finset.filter_eq']

/-- The faces of `Δₙ₊₁` through the apex miss the closed negative last half-axis. -/
lemma sum_smul_mem_halfAxisCompl_one (n : ℕ) {s : Fin (n + 2) → ℝ}
    (hs : s ∈ stdSimplex ℝ (Fin (n + 2))) {i : Fin (n + 1)} (hi : s i.castSucc = 0) :
    ∑ k, s k • localGeneratorVertices (n + 1) k ∈ halfAxisCompl n 1 := by
  by_contra hcon
  simp only [halfAxisCompl, mem_ofPred_eq, not_or, not_not, not_lt, one_mul] at hcon
  obtain ⟨h1, h2⟩ := hcon
  rw [init_sum_smul_localGeneratorVertices] at h1
  rw [sum_smul_localGeneratorVertices_last] at h2
  set S := ∑ j : Fin (n + 1), s j.castSucc with hSdef
  have hsum : S + s (Fin.last (n + 1)) = 1 := by
    rw [hSdef, ← Fin.sum_univ_castSucc]
    exact hs.2
  have hS : 0 < S := by linarith
  have hv := isOrientedSimplexAroundZero_localGeneratorVertices n
  obtain ⟨⟨τ, hτ0, hτ1, hτv⟩, -⟩ := id hv
  have hc := hv.eq_zero_of_sum_eq_zero (c := fun j ↦ s j.castSucc - S * τ j)
    (by simp [Finset.sum_sub_distrib, ← Finset.mul_sum, hτ1, ← hSdef])
    (by simp [sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hτv, h1])
  have := congrFun hc i
  simp only [hi, zero_sub, Pi.zero_apply, neg_eq_zero] at this
  exact (mul_pos hS (hτ0 i)).ne' this

/-- The last face of `Δₙ₊₁` lies in `xₙ = -1`. -/
lemma sum_smul_mem_halfAxisCompl_neg_one (n : ℕ) {s : Fin (n + 2) → ℝ}
    (hs : s ∈ stdSimplex ℝ (Fin (n + 2))) (hl : s (Fin.last (n + 1)) = 0) :
    ∑ k, s k • localGeneratorVertices (n + 1) k ∈ halfAxisCompl n (-1) := by
  have hsum := hs.2
  rw [Fin.sum_univ_castSucc, hl, add_zero] at hsum
  refine Or.inr ?_
  rw [sum_smul_localGeneratorVertices_last, hl, hsum]
  norm_num

/-- The last face of `Δₙ₊₁` projects onto `Δₙ`. -/
lemma initMap_comp_localGenerator_comp_face_last (n : ℕ) :
    (initMap n).comp ((localGenerator (n + 1)).comp (face n (Fin.last (n + 1)))) =
      localGenerator n := by
  ext1 t
  change Fin.init (∑ k, (stdSimplex.map (Fin.last (n + 1)).succAbove t : Fin (n + 2) → ℝ) k •
    localGeneratorVertices (n + 1) k) = ∑ k, (t : Fin (n + 1) → ℝ) k • localGeneratorVertices n k
  rw [init_sum_smul_localGeneratorVertices]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [Fin.succAbove_last, stdSimplex_map_castSucc_castSucc]

end vertices

section chains

open ThomClass

variable (R) in
/-- The faces of `∂ Δₙ₊₁` through the apex. -/
def localGeneratorA (n : ℕ) : Chain R (Fin (n + 1) → ℝ) n :=
  ∑ i : Fin (n + 1), (-1 : R) ^ (i : ℕ) •
    single ((localGenerator (n + 1)).comp (face n i.castSucc)) 1

variable (R) in
/-- The last face of `∂ Δₙ₊₁`. -/
def localGeneratorB (n : ℕ) : Chain R (Fin (n + 1) → ℝ) n :=
  (-1 : R) ^ (n + 1) • single ((localGenerator (n + 1)).comp (face n (Fin.last (n + 1)))) 1

/-- The boundary of `Δₙ₊₁` is the sum of its faces through the apex and its last face. -/
lemma bd_localGenerator (n : ℕ) :
    bd R n (single (localGenerator (n + 1)) 1) = localGeneratorA R n + localGeneratorB R n := by
  rw [bd_single, Fin.sum_univ_castSucc]
  simp [localGeneratorA, localGeneratorB]

/-- The faces of `∂ Δₙ₊₁` through the apex lie in `halfAxisCompl n 1`. -/
lemma localGeneratorA_mem (n : ℕ) : localGeneratorA R n ∈ inside R n (halfAxisCompl n 1) :=
  Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ (single_mem_supported R _ (by
    rintro _ ⟨t, rfl⟩
    exact sum_smul_mem_halfAxisCompl_one n (stdSimplex.map _ t).2
      (stdSimplex_map_succAbove_self _ t)))

/-- The last face of `∂ Δₙ₊₁` lies in `halfAxisCompl n (-1)`. -/
lemma localGeneratorB_mem (n : ℕ) : localGeneratorB R n ∈ inside R n (halfAxisCompl n (-1)) :=
  Submodule.smul_mem _ _ (single_mem_supported R _ (by
    rintro _ ⟨t, rfl⟩
    exact sum_smul_mem_halfAxisCompl_neg_one n (stdSimplex.map _ t).2
      (stdSimplex_map_succAbove_self _ t)))

/-- The projection `initMap n` sends the last face of `∂ Δₙ₊₁` to `(-1) ^ (n + 1) • Δₙ`. -/
lemma postcomp_initMap_localGeneratorB (n : ℕ) :
    postcomp R (initMap n) n (localGeneratorB R n) =
      (-1 : R) ^ (n + 1) • single (localGenerator n) 1 := by
  rw [localGeneratorB, map_smul, postcomp_single, initMap_comp_localGenerator_comp_face_last]

/-- **`∂ Δₙ₊₁` lies in `ℝⁿ⁺¹ - 0`.** -/
theorem bd_localGenerator_mem (n : ℕ) :
    bd R n (single (localGenerator (n + 1)) 1) ∈ inside R n ({0}ᶜ : Set (Fin (n + 1) → ℝ)) := by
  rw [bd_localGenerator, ← halfAxisCompl_union]
  exact Submodule.add_mem _ (inside_mono _ subset_union_left (localGeneratorA_mem n))
    (inside_mono _ subset_union_right (localGeneratorB_mem n))

/-- `initMap n` maps `halfAxisCompl n 1 ∩ halfAxisCompl n (-1)` into `ℝⁿ - 0`. -/
lemma initMap_mapsTo_inter (n : ℕ) :
    MapsTo (initMap n) (halfAxisCompl n 1 ∩ halfAxisCompl n (-1)) {0}ᶜ := by
  rw [halfAxisCompl_inter]
  exact fun x hx ↦ hx

/-- `snocZeroMap n` maps `ℝⁿ - 0` into `halfAxisCompl n 1 ∩ halfAxisCompl n (-1)`. -/
lemma snocZeroMap_mapsTo_inter (n : ℕ) :
    MapsTo (snocZeroMap n) {0}ᶜ (halfAxisCompl n 1 ∩ halfAxisCompl n (-1)) := by
  rw [halfAxisCompl_inter]
  intro y hy
  change Fin.init (snocZeroMap n y) ≠ 0
  rw [snocZeroMap_apply, Fin.init_snoc]
  exact hy

/-- `flattenHomotopy n` keeps `halfAxisCompl n 1 ∩ halfAxisCompl n (-1)` in itself. -/
lemma flattenHomotopy_mapsTo_inter (n : ℕ) :
    MapsTo (flattenHomotopy n) ((halfAxisCompl n 1 ∩ halfAxisCompl n (-1)) ×ˢ univ)
      (halfAxisCompl n 1 ∩ halfAxisCompl n (-1)) := by
  rw [halfAxisCompl_inter]
  rintro ⟨x, t⟩ hp
  change Fin.init (flattenHomotopy n (x, t)) ≠ 0
  rw [flattenHomotopy_apply, Fin.init_snoc]
  exact hp.1

/-- At time `0`, `flattenHomotopy n` is `snocZeroMap n ∘ initMap n`. -/
lemma flattenHomotopy_zero (n : ℕ) (x : Fin (n + 1) → ℝ) :
    flattenHomotopy n (x, 0) = snocZeroMap n (initMap n x) := by
  rw [flattenHomotopy_apply, initMap_apply, snocZeroMap_apply, Set.Icc.coe_zero, zero_mul]

/-- At time `1`, `flattenHomotopy n` is the identity. -/
lemma flattenHomotopy_one (n : ℕ) (x : Fin (n + 1) → ℝ) : flattenHomotopy n (x, 1) = x := by
  rw [flattenHomotopy_apply, Set.Icc.coe_one, one_mul, Fin.snoc_init_self]

/-- **`H̃ₙ(ℝⁿ⁺¹ - 0; R)` is free of rank one on `∂ Δₙ₊₁`.** -/
theorem genBy_freeBy_bd_localGenerator : ∀ n : ℕ,
    GenBy R ({0}ᶜ : Set (Fin (n + 1) → ℝ)) n (bd R n (single (localGenerator (n + 1)) 1)) ∧
      FreeBy R ({0}ᶜ : Set (Fin (n + 1) → ℝ)) n (bd R n (single (localGenerator (n + 1)) 1))
  | 0 => by
    rw [bd_localGenerator, ← halfAxisCompl_union]
    have hUV : halfAxisCompl 0 1 ∩ halfAxisCompl 0 (-1) = ∅ := by
      rw [halfAxisCompl_inter]
      exact eq_empty_of_forall_notMem fun x hx ↦ hx (Subsingleton.elim _ _)
    have haA : aug R 0 (localGeneratorA R 0) = 1 := by simp [localGeneratorA, aug_single]
    have haB : aug R 0 (localGeneratorB R 0) = -1 := by simp [localGeneratorB, aug_single]
    refine ⟨GenBy.union_zero (isOpen_halfAxisCompl 0 1) (isOpen_halfAxisCompl 0 (-1))
      (fun c hc ha ↦ isBoundaryIn_of_starConvex (starConvex_halfAxisCompl 0 one_ne_zero) hc
        (mem_reducedCycles_zero.2 ha))
      (fun c hc ha ↦ isBoundaryIn_of_starConvex
        (starConvex_halfAxisCompl 0 (neg_ne_zero.2 one_ne_zero)) hc
        (mem_reducedCycles_zero.2 ha))
      (localGeneratorA_mem 0) (localGeneratorB_mem 0) haA haB,
      FreeBy.union_zero (isOpen_halfAxisCompl 0 1) (isOpen_halfAxisCompl 0 (-1)) hUV
        (localGeneratorA_mem 0) (localGeneratorB_mem 0) haA⟩
  | n + 1 => by
    obtain ⟨hG, hF⟩ := genBy_freeBy_bd_localGenerator n
    have hAB : bd R n (localGeneratorA R (n + 1)) + bd R n (localGeneratorB R (n + 1)) = 0 := by
      rw [← map_add, ← bd_localGenerator, bd_bd]
    have hA' := eq_neg_of_add_eq_zero_left hAB
    have hinit : postcomp R (initMap (n + 1)) n (bd R n (localGeneratorA R (n + 1))) =
        (-1 : R) ^ (n + 1) • bd R n (single (localGenerator (n + 1)) 1) := by
      rw [hA', map_neg, postcomp_bd, postcomp_initMap_localGeneratorB, map_smul,
        pow_succ _ (n + 1), mul_neg_one, neg_smul, neg_neg]
    have hzA : bd R n (localGeneratorA R (n + 1)) ∈
        inside R n (halfAxisCompl (n + 1) 1 ∩ halfAxisCompl (n + 1) (-1)) := by
      rw [inside_inter]
      refine ⟨bd_mem_inside (localGeneratorA_mem _), ?_⟩
      rw [hA']
      exact Submodule.neg_mem _ (bd_mem_inside (localGeneratorB_mem _))
    rw [bd_localGenerator, ← halfAxisCompl_union]
    refine ⟨GenBy.union (isOpen_halfAxisCompl _ 1) (isOpen_halfAxisCompl _ (-1))
      (cycleVanishing_of_starConvex (starConvex_halfAxisCompl _ one_ne_zero) _)
      (cycleVanishing_of_starConvex (starConvex_halfAxisCompl _ (neg_ne_zero.2 one_ne_zero)) _)
      (localGeneratorA_mem _) (localGeneratorB_mem _) hAB ?_,
      FreeBy.union (isOpen_halfAxisCompl _ 1) (isOpen_halfAxisCompl _ (-1))
      (localGeneratorA_mem _) (localGeneratorB_mem _) hAB ?_⟩
    · refine GenBy.of_homotopy (initMap (n + 1)) (snocZeroMap (n + 1)) (initMap_mapsTo_inter _)
        (snocZeroMap_mapsTo_inter _) (flattenHomotopy (n + 1)) (flattenHomotopy_zero _)
        (flattenHomotopy_one _) (flattenHomotopy_mapsTo_inter _) hzA
        (bd_mem_reducedCycles _ _) ?_
      rw [hinit]
      exact hG.neg_one_pow_smul _
    · refine FreeBy.of_map (initMap (n + 1)) (initMap_mapsTo_inter _) ?_
      rw [hinit]
      exact hF.neg_one_pow_smul _

/-- **Generation of `H_n(ℝⁿ, ℝⁿ - 0; R)`** (`n = m + 1`) by the oriented simplex `Δₙ` around
`0`: every relative cycle `c` is `r Δₙ` plus a boundary, modulo chains in `ℝⁿ - 0`. -/
theorem exists_sub_smul_localGenerator_mem (m : ℕ) (c : Chain R (Fin (m + 1) → ℝ) (m + 1))
    (hc : bd R m c ∈ inside R m ({0}ᶜ : Set (Fin (m + 1) → ℝ))) :
    ∃ r : R, ∃ w, c - r • single (localGenerator (m + 1)) 1 - bd R (m + 1) w ∈
      inside R (m + 1) ({0}ᶜ : Set (Fin (m + 1) → ℝ)) := by
  obtain ⟨r, w', hw', hbw'⟩ := (genBy_freeBy_bd_localGenerator (R := R) m).1 _ hc
    (bd_mem_reducedCycles m c)
  obtain ⟨w, -, hbw⟩ := exists_bd_eq_of_starConvex (R := R) (starConvex_univ (0 : Fin (m + 1) → ℝ))
    (m := m) (mem_inside_univ (c - r • single (localGenerator (m + 1)) 1 - w'))
    (by rw [map_sub, map_sub, map_smul, hbw', sub_self])
  refine ⟨r, w, ?_⟩
  rw [hbw, sub_sub_cancel]
  exact hw'

/-- **Freeness of `H_n(ℝⁿ, ℝⁿ - 0; R)`** (`n = m + 1`) on the oriented simplex `Δₙ` around `0`:
`r Δₙ` is a relative boundary only for `r = 0`. -/
theorem eq_zero_of_smul_localGenerator_mem (m : ℕ) (r : R)
    (h : ∃ w, r • single (localGenerator (m + 1)) 1 - bd R (m + 1) w ∈
      inside R (m + 1) ({0}ᶜ : Set (Fin (m + 1) → ℝ))) : r = 0 := by
  obtain ⟨w, hw⟩ := h
  refine (genBy_freeBy_bd_localGenerator (R := R) m).2 r ⟨_, hw, ?_⟩
  rw [map_sub, bd_bd, sub_zero, map_smul]

end chains

end SingularChain

end MMP
