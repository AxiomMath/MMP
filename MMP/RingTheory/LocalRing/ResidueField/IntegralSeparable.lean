module

public import Mathlib.FieldTheory.Perfect
public import Mathlib.RingTheory.Henselian
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.SimpleRing.Principal

/-!
# Residue field extensions at the points of a finite cover

Let `A₀ → B₀` be an integral ring map, `Q` a prime of `B₀`, `R = (B₀)_Q`, and `A → R` a local
homomorphism of local rings compatible with `A₀ → A` and `A₀ → B₀ → R`. Then the residue field of
`R` is algebraic over that of `A`: it is generated by the residues of `B₀`, which are integral
over the residues of `A₀`. Over a perfect residue field (e.g. in characteristic zero) the
extension is therefore separable.

In the geometric application `A₀ → B₀` is the ring map of a finite cover over an affine open,
`A` and `R` are the local rings at the generic point of a prime divisor and at a point over it.

## Main results

* `MMP.FourfoldProofs.FractionalLogComplexProof.isAlgebraic_residueField_of_isLocalization`.
* `MMP.FourfoldProofs.FractionalLogComplexProof.isSeparable_residueField_of_isLocalization`.
-/

@[expose] public section

open IsLocalRing

namespace MMP.FourfoldProofs.FractionalLogComplexProof

/-- **Residue fields at the points of a finite cover are algebraic.** -/
theorem isAlgebraic_residueField_of_isLocalization {A₀ B₀ A R : Type*} [CommRing A₀]
    [CommRing B₀] [CommRing A] [CommRing R] [Algebra A₀ B₀] [Algebra.IsIntegral A₀ B₀]
    [Algebra A₀ A] [Algebra B₀ R] [Algebra A R] [IsLocalRing A] [IsLocalRing R]
    [IsLocalHom (algebraMap A R)] (Q : Ideal B₀) [Q.IsPrime] [IsLocalization.AtPrime R Q]
    (hcomm : ∀ a, algebraMap A R (algebraMap A₀ A a) = algebraMap B₀ R (algebraMap A₀ B₀ a)) :
    Algebra.IsAlgebraic (ResidueField A) (ResidueField R) := by
  let g : B₀ →+* ResidueField R := (residue R).comp (algebraMap B₀ R)
  have hg : ∀ b : B₀, IsIntegral (ResidueField A) (g b) := by
    intro b
    obtain ⟨p, hp, hpb⟩ := Algebra.IsIntegral.isIntegral (R := A₀) b
    refine ⟨p.map ((residue A).comp (algebraMap A₀ A)), hp.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have he : (algebraMap (ResidueField A) (ResidueField R)).comp
        ((residue A).comp (algebraMap A₀ A)) = g.comp (algebraMap A₀ B₀) := by
      ext a
      simp only [RingHom.coe_comp, Function.comp_apply, g]
      rw [ResidueField.algebraMap_residue, hcomm]
    rw [he, ← Polynomial.hom_eval₂, hpb, map_zero]
  refine ⟨fun z => ?_⟩
  obtain ⟨r, rfl⟩ := residue_surjective z
  obtain ⟨⟨b, c⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl r
  dsimp only
  have hc : IsUnit (algebraMap B₀ R c) := IsLocalization.map_units R c
  have hgc : g c ≠ 0 := (hc.map (residue R)).ne_zero
  have hres : residue R (IsLocalization.mk' R b c) = g b * (g c)⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq₀ hgc]
    simp only [g, RingHom.coe_comp, Function.comp_apply]
    rw [← map_mul, IsLocalization.mk'_spec]
  rw [hres]
  exact (hg b).isAlgebraic.mul (hg c).isAlgebraic.inv

/-- **Residue fields at the points of a finite cover are separable over a perfect field.** -/
theorem isSeparable_residueField_of_isLocalization {A₀ B₀ A R : Type*} [CommRing A₀]
    [CommRing B₀] [CommRing A] [CommRing R] [Algebra A₀ B₀] [Algebra.IsIntegral A₀ B₀]
    [Algebra A₀ A] [Algebra B₀ R] [Algebra A R] [IsLocalRing A] [IsLocalRing R]
    [IsLocalHom (algebraMap A R)] [PerfectField (ResidueField A)] (Q : Ideal B₀) [Q.IsPrime]
    [IsLocalization.AtPrime R Q]
    (hcomm : ∀ a, algebraMap A R (algebraMap A₀ A a) = algebraMap B₀ R (algebraMap A₀ B₀ a)) :
    Algebra.IsSeparable (ResidueField A) (ResidueField R) := by
  have := isAlgebraic_residueField_of_isLocalization Q hcomm
  infer_instance

end MMP.FourfoldProofs.FractionalLogComplexProof
