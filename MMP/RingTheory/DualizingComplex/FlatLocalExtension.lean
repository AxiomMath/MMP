private theorem extendScalars_additive {A : Type u} {B : Type w}
    [CommRing A] [CommRing B] (f : A →+* B) :
    (ModuleCat.extendScalars.{u, w, v} f).Additive where
  map_add := by
    intro X Y g h
    let _ := f.toAlgebra
    apply ModuleCat.ExtendScalars.hom_ext
    intro x
    change (LinearMap.baseChange B (g.hom + h.hom)) (1 ⊗ₜ[A] x) =
      (LinearMap.baseChange B g.hom + LinearMap.baseChange B h.hom) (1 ⊗ₜ[A] x)
    rw [LinearMap.baseChange_add]

attribute [local instance] extendScalars_additive

private theorem extendScalars_preservesFiniteLimits_of_flat
    {A : Type u} {B : Type w} [CommRing A] [CommRing B]
    [Algebra A B] [Module.Flat A B] :
    Limits.PreservesFiniteLimits
      (ModuleCat.extendScalars.{u, w, v} (algebraMap A B)) :=
  ModuleCat.extendScalars_preservesFiniteLimits_of_flat _
    (RingHom.flat_algebraMap_iff.mpr inferInstance)

private theorem extendScalars_preservesFiniteColimits'
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B] :
    Limits.PreservesFiniteColimits
      (ModuleCat.extendScalars.{u, w, v} (algebraMap A B)) :=
  ModuleCat.extendScalars_preservesFiniteColimits _

attribute [local instance] extendScalars_preservesFiniteLimits_of_flat
  extendScalars_preservesFiniteColimits'

private theorem finite_extendScalars
    {A : Type u} {B : Type w} [CommRing A] [CommRing B]
    (f : A →+* B) (M : ModuleCat.{v} A) [Module.Finite A M] :
    Module.Finite B ((ModuleCat.extendScalars.{u, w, v} f).obj M) := by
  let : Algebra A B := f.toAlgebra
  have heq : (inferInstance : Module A B) = Module.compHom B f :=
    Module.ext' _ _ (by intro a b; rfl)
  cases heq
  exact Module.Finite.base_change A B M

private theorem finiteCohomology_extendScalars
    {A : Type u} {B : Type w} [CommRing A] [CommRing B]
    [Algebra A B] [Module.Flat A B]
    (K : DerivedCategory (ModuleCat.{v} A))
    (hK : ∀ i : ℤ, Module.Finite A
      ((DerivedCategory.homologyFunctor (ModuleCat.{v} A) i).obj K)) :
    ∀ i : ℤ, Module.Finite B
      ((DerivedCategory.homologyFunctor (ModuleCat.{max w v} B) i).obj
        ((ModuleCat.extendScalars.{u, w, v} (algebraMap A B)).mapDerivedCategory.obj K)) := by
  let F := ModuleCat.extendScalars.{u, w, v} (algebraMap A B)
  let : F.Additive := extendScalars_additive _
  let : Limits.PreservesFiniteLimits F := extendScalars_preservesFiniteLimits_of_flat
  let : Limits.PreservesFiniteColimits F := extendScalars_preservesFiniteColimits'
  intro i
  let e := (StacksDraft.PseudoCoherence.mapDerivedCategoryHomologyIso F i).app K
  have hF : Module.Finite B (F.obj
      ((DerivedCategory.homologyFunctor (ModuleCat.{v} A) i).obj K)) := by
    have := hK i
    exact finite_extendScalars (algebraMap A B) _
  exact @Module.Finite.equiv B _ _ inferInstance inferInstance inferInstance
    inferInstance inferInstance hF e.symm.toLinearEquiv

private theorem exists_tStructure_bounds_of_finiteInjectiveDimension
    {R : Type u} [CommRing R]
    (K : DerivedCategory (ModuleCat.{v} R))
    (hK : StacksDraft.InjectiveDimension.HasFiniteInjectiveDimension K) :
    ∃ a b : ℤ, K.IsGE a ∧ K.IsLE b := by
  obtain ⟨a, b, ⟨J, hJGE, hJLE, _, ⟨e⟩⟩⟩ := hK
  exact ⟨a, b,
    DerivedCategory.TStructure.t.isGE_of_iso e.symm a,
    DerivedCategory.TStructure.t.isLE_of_iso e.symm b⟩

private theorem finiteInjectiveDimension_ulift
    {R : Type u} [CommRing R] [Small.{v} R]
    (K : DerivedCategory (ModuleCat.{v} R))
    (hK : StacksDraft.InjectiveDimension.HasFiniteInjectiveDimension K) :
    StacksDraft.InjectiveDimension.HasFiniteInjectiveDimension
      (((ModuleCat.uliftFunctor.{max u w, v} R).mapDerivedCategory).obj K) := by
  let U := ModuleCat.uliftFunctor.{max u w, v} R
  let : U.PreservesInjectiveObjects := inferInstance
  obtain ⟨a, b, ⟨J, hJGE, hJLE, hJinj, ⟨e⟩⟩⟩ := hK
  refine ⟨a, b, ⟨(U.mapHomologicalComplex (ComplexShape.up ℤ)).obj J,
    ?_, ?_, ?_, ?_⟩⟩
  · exact (CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff
      (K := J) U a).2 hJGE
  · exact (CochainComplex.isStrictlyLE_mapHomologicalComplex_obj_iff
      (K := J) U b).2 hJLE
  · intro i
    exact U.injective_obj_of_injective (hJinj i)
  · exact ⟨U.mapDerivedCategory.mapIso e ≪≫ U.mapDerivedCategoryFactors.app J⟩

private theorem pseudoCoherent_ulift_of_dualizing
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (K : DerivedCategory (ModuleCat.{v} A))
    (hK : IsDualizingComplex (A := A) K) :
    StacksDraft.PseudoCoherence.IsPseudoCoherent
      (((ModuleCat.uliftFunctor.{max u w, v} A).mapDerivedCategory).obj K) := by
  let U := ModuleCat.uliftFunctor.{max u w, v} A
  let : Limits.PreservesFiniteLimits U := inferInstance
  let : Limits.PreservesFiniteColimits U := inferInstance
  let F := U.mapDerivedCategory
  let : F.Additive := inferInstance
  obtain ⟨-, b, -, hLE⟩ :=
    exists_tStructure_bounds_of_finiteInjectiveDimension K hK.finiteInjectiveDimension
  have hLE' : F.obj K |>.IsLE b := by
    rw [DerivedCategory.isLE_iff]
    intro i hi
    let e := (StacksDraft.PseudoCoherence.mapDerivedCategoryHomologyIso U i).app K
    have hz := U.map_isZero ((DerivedCategory.isLE_iff K b).mp hLE i hi)
    exact hz.of_iso e
  have hfinite : ∀ i : ℤ, Module.Finite A
      ((DerivedCategory.homologyFunctor (ModuleCat.{max (max u v) w} A) i).obj (F.obj K)) := by
    intro i
    let e := (StacksDraft.PseudoCoherence.mapDerivedCategoryHomologyIso U i).app K
    have hU : Module.Finite A (U.obj
        ((DerivedCategory.homologyFunctor (ModuleCat.{v} A) i).obj K)) := by
      let M := (DerivedCategory.homologyFunctor (ModuleCat.{v} A) i).obj K
      let : Module.Finite A M := hK.finiteCohomology i
      let eM : U.obj M ≃ₗ[A] M :=
        { toFun := fun x => x.down
          invFun := ULift.up
          left_inv := by intro x; cases x; rfl
          right_inv := by intro x; rfl
          map_add' := by intros; rfl
          map_smul' := by intros; rfl }
      exact Module.Finite.equiv eM.symm
    exact @Module.Finite.equiv A _ _ inferInstance inferInstance inferInstance
      inferInstance inferInstance hU e.symm.toLinearEquiv
  let : Small.{max (max u v) w} A := inferInstance
  exact (StacksDraft.PseudoCoherence.pseudoCoherent_iff_boundedAbove_finite_homology
      (F.obj K) 0 (ULift.{max (max u v) w} A)).2.1.mpr
    ⟨⟨b, fun i hi => DerivedCategory.isZero_of_isLE (F.obj K) b i hi⟩, hfinite⟩

private theorem derivedHomBaseChange_isIso_of_flat_pseudoCoherent
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    [Module.Flat A B]
    (X M : DerivedCategory (ModuleCat.{max u v w} A))
    (hX : StacksDraft.PseudoCoherence.IsPseudoCoherent X)
    (hM : ∃ b : ℤ, M.IsGE b) :
    let E := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
    let F := E.mapDerivedCategory
    let α := E.mapDerivedCategoryFactors.hom
    let W := HomologicalComplex.quasiIso (ModuleCat.{max u v w} A) (ComplexShape.up ℤ)
    letI : F.IsLeftDerivedFunctor α W :=
      Functor.isLeftDerivedFunctor_of_inverts W F E.mapDerivedCategoryFactors
    IsIso (Stacks.DerivedHom.ExtensionOfScalars.derivedHomBaseChange.{u, w, max u v w} (algebraMap A
      B) F α X M) := by
  let E := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let F := E.mapDerivedCategory
  let α := E.mapDerivedCategoryFactors.hom
  let W := HomologicalComplex.quasiIso (ModuleCat.{max u v w} A) (ComplexShape.up ℤ)
  let : F.IsLeftDerivedFunctor α W :=
    Functor.isLeftDerivedFunctor_of_inverts W F E.mapDerivedCategoryFactors
  apply Stacks.DerivedHom.BaseChangeIso.isIso_derivedHomBaseChange.{u, w, max u v w}
  exact Or.inr (Or.inr (Or.inl ⟨
    RingHom.flat_algebraMap_iff.mpr inferInstance, hX, hM⟩))
private theorem subsingleton_mapDerivedHom_of_flat_pseudoCoherent
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    [Module.Flat A B]
    (X M : DerivedCategory (ModuleCat.{max u v w} A))
    (hX : StacksDraft.PseudoCoherence.IsPseudoCoherent X)
    (hM : ∃ b : ℤ, M.IsGE b)
    (hXM : Subsingleton (X ⟶ M)) :
    Subsingleton
      ((ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapDerivedCategory.obj X ⟶
        (ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapDerivedCategory.obj M) := by
  let E := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let F := E.mapDerivedCategory
  let α := E.mapDerivedCategoryFactors.hom
  let W := HomologicalComplex.quasiIso (ModuleCat.{max u v w} A) (ComplexShape.up ℤ)
  let : E.Additive := extendScalars_additive _
  let : F.Additive := inferInstance
  let : Limits.PreservesFiniteLimits E := extendScalars_preservesFiniteLimits_of_flat
  let : Limits.PreservesFiniteColimits E := extendScalars_preservesFiniteColimits'
  let : F.IsLeftDerivedFunctor α W :=
    Functor.isLeftDerivedFunctor_of_inverts W F E.mapDerivedCategoryFactors
  let HA := (Stacks.DerivedHom.ScalarTransportedInternalHom.hom.{u, max u v w} A).obj (Opposite.op
    X, M)
  let HB := (Stacks.DerivedHom.ScalarTransportedInternalHom.hom.{w, max u v w} B).obj
    (Opposite.op (F.obj X), F.obj M)
  let φ := Stacks.DerivedHom.ExtensionOfScalars.derivedHomBaseChange.{u, w, max u v w} (algebraMap A
    B) F α X M
  have : IsIso φ := derivedHomBaseChange_isIso_of_flat_pseudoCoherent.{u, v, w} X M hX hM
  have hA : Limits.IsZero
      ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} A) 0).obj HA) :=
    (hom_subsingleton_iff_derivedInternalHom_homology_isZero.{u, max u v w} X M).mp hXM
  have hFA : Limits.IsZero
      ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) 0).obj (F.obj HA)) := by
    let e := (StacksDraft.PseudoCoherence.mapDerivedCategoryHomologyIso E 0).app HA
    exact (E.map_isZero hA).of_iso e
  have hFB : Limits.IsZero
      ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) 0).obj HB) :=
    hFA.of_iso
      (asIso ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) 0).map φ)).symm
  exact (hom_subsingleton_iff_derivedInternalHom_homology_isZero.{w, max u v w}
    (F.obj X) (F.obj M)).2 hFB

private lemma exists_injective_representative
    {R : Type u} [CommRing R] [Small.{v} R]
    (K : DerivedCategory (ModuleCat.{v} R)) (a : ℤ) [K.IsGE a] :
    ∃ (I : CochainComplex (ModuleCat.{v} R) ℤ) (_ : I.IsStrictlyGE a),
      (∀ n, Injective (I.X n)) ∧ Nonempty (K ≅ DerivedCategory.Q.obj I) := by
  obtain ⟨L, hL, ⟨e⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isGE K a
  obtain ⟨I, hI, f, hf⟩ := CochainComplex.Plus.exists_quasiIso_injective
    ⟨L, a, hL⟩ a
  refine ⟨((InjectiveObject.ι (ModuleCat.{v} R)).mapHomologicalComplex (.up ℤ)).obj I.obj,
    inferInstance, ?_, ⟨e ≪≫ @asIso _ _ _ _ (DerivedCategory.Q.map f.hom)
      ((DerivedCategory.isIso_Q_map_iff_quasiIso (ModuleCat.{v} R) f.hom).2 hf)⟩⟩
  intro n
  exact inferInstanceAs (Injective ((InjectiveObject.ι _).obj (I.obj.X n)))

private lemma subsingleton_hom_of_ulift
    {R : Type u} [CommRing R] [Small.{v} R]
    (X Y : DerivedCategory (ModuleCat.{v} R)) (a : ℤ) [Y.IsGE a]
    (h : Subsingleton
      ((ModuleCat.uliftFunctor.{w, v} R).mapDerivedCategory.obj X ⟶
        (ModuleCat.uliftFunctor.{w, v} R).mapDerivedCategory.obj Y)) :
    Subsingleton (X ⟶ Y) := by
  let U := ModuleCat.uliftFunctor.{w, v} R
  let UH := U.mapHomotopyCategory (ComplexShape.up ℤ)
  let q := HomotopyCategory.quotient (ModuleCat.{v} R) (ComplexShape.up ℤ)
  let q' := HomotopyCategory.quotient (ModuleCat.{max w v} R) (ComplexShape.up ℤ)
  obtain ⟨J, hJGE, hJinj, ⟨eY⟩⟩ := exists_injective_representative Y a
  let : J.IsStrictlyGE a := hJGE
  let : ∀ i, Injective (J.X i) := hJinj
  let : J.IsKInjective := CochainComplex.isKInjective_of_injective J a
  let JU : CochainComplex (ModuleCat.{max w v} R) ℤ :=
    (U.mapHomologicalComplex (ComplexShape.up ℤ)).obj J
  have : JU.IsStrictlyGE a :=
    (CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff (K := J) U a).2 hJGE
  let : ∀ i, Injective (JU.X i) := fun i => U.injective_obj_of_injective (hJinj i)
  let : JU.IsKInjective := CochainComplex.isKInjective_of_injective JU a
  let Xh := DerivedCategory.Qh.objPreimage X
  let eX := DerivedCategory.Qh.objObjPreimageIso X
  let eJ : DerivedCategory.Qh.obj (q.obj J) ≅ Y :=
    (DerivedCategory.quotientCompQhIso _).app J ≪≫ eY.symm
  let eUX : DerivedCategory.Qh.obj (UH.obj Xh) ≅ U.mapDerivedCategory.obj X :=
    (U.mapDerivedCategoryFactorsh.app Xh).symm ≪≫ U.mapDerivedCategory.mapIso eX
  let eUJ : DerivedCategory.Qh.obj (q'.obj JU) ≅ U.mapDerivedCategory.obj Y :=
    (DerivedCategory.quotientCompQhIso _).app JU ≪≫
      (U.mapDerivedCategoryFactors.app J).symm ≪≫ U.mapDerivedCategory.mapIso eY.symm
  let := h
  have : Subsingleton (DerivedCategory.Qh.obj (UH.obj Xh) ⟶
      DerivedCategory.Qh.obj (q'.obj JU)) :=
    Equiv.subsingleton (Iso.homCongr eUX eUJ)
  have : Subsingleton (UH.obj Xh ⟶ q'.obj JU) :=
    (CochainComplex.IsKInjective.Qh_map_bijective (UH.obj Xh) JU).injective.subsingleton
  let ej : UH.obj (q.obj J) ≅ q'.obj JU :=
    (U.mapHomotopyCategoryFactors (ComplexShape.up ℤ)).app J
  have : Subsingleton (UH.obj Xh ⟶ UH.obj (q.obj J)) :=
    Equiv.subsingleton (Iso.homCongr (Iso.refl _) ej)
  have : Subsingleton (Xh ⟶ q.obj J) := UH.map_injective.subsingleton
  have : Subsingleton (DerivedCategory.Qh.obj Xh ⟶ DerivedCategory.Qh.obj (q.obj J)) :=
    (CochainComplex.IsKInjective.Qh_map_bijective Xh J).surjective.subsingleton
  exact Equiv.subsingleton (Iso.homCongr eX eJ).symm

private noncomputable def extendScalarsULiftCommLinearEquiv
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    (M : ModuleCat.{v} A) :
    ((ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).obj
      ((ModuleCat.uliftFunctor.{max u w, v} A).obj M)) ≃ₗ[B]
      ((ModuleCat.uliftFunctor.{u, max w v} B).obj
        ((ModuleCat.extendScalars.{u, w, v} (algebraMap A B)).obj M)) := by
  let B_A := (ModuleCat.restrictScalars (algebraMap A B)).obj (ModuleCat.of B B)
  letI : IsScalarTower A B B_A :=
    IsScalarTower.of_algebraMap_smul (by intro r x; rfl)
  change TensorProduct A B_A (ULift.{max u w} M) ≃ₗ[B]
    ULift.{u} (TensorProduct A B_A M)
  exact (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl B B_A)
    (ULift.moduleEquiv (R := A))).trans (ULift.moduleEquiv (R := B)).symm

private noncomputable def extendScalarsULiftCommComplexIso
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    (P : CochainComplex (ModuleCat.{v} A) ℤ) :
    ((ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj
        (((ModuleCat.uliftFunctor.{max u w, v} A).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj P) ≅
    ((ModuleCat.uliftFunctor.{u, max w v} B).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj
        (((ModuleCat.extendScalars.{u, w, v} (algebraMap A B)).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj P) := by
  apply HomologicalComplex.Hom.isoOfComponents
    (fun i => (extendScalarsULiftCommLinearEquiv (B := B) (P.X i)).toModuleIso)

private noncomputable def extendScalarsULiftCommDerivedIso
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    [Module.Flat A B] (K : DerivedCategory (ModuleCat.{v} A)) :
    (ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapDerivedCategory.obj
      ((ModuleCat.uliftFunctor.{max u w, v} A).mapDerivedCategory.obj K) ≅
    (ModuleCat.uliftFunctor.{u, max w v} B).mapDerivedCategory.obj
      ((ModuleCat.extendScalars.{u, w, v} (algebraMap A B)).mapDerivedCategory.obj K) := by
  let U := ModuleCat.uliftFunctor.{max u w, v} A
  let V := ModuleCat.uliftFunctor.{u, max w v} B
  let F := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let E := ModuleCat.extendScalars.{u, w, v} (algebraMap A B)
  let P := DerivedCategory.Q.objPreimage K
  let e := DerivedCategory.Q.objObjPreimageIso K
  exact F.mapDerivedCategory.mapIso (U.mapDerivedCategory.mapIso e.symm) ≪≫
    F.mapDerivedCategory.mapIso (U.mapDerivedCategoryFactors.app P) ≪≫
    F.mapDerivedCategoryFactors.app ((U.mapHomologicalComplex (.up ℤ)).obj P) ≪≫
    DerivedCategory.Q.mapIso (extendScalarsULiftCommComplexIso (B := B) P) ≪≫
    (V.mapDerivedCategoryFactors.app ((E.mapHomologicalComplex (.up ℤ)).obj P)).symm ≪≫
    V.mapDerivedCategory.mapIso (E.mapDerivedCategoryFactors.app P).symm ≪≫
    V.mapDerivedCategory.mapIso (E.mapDerivedCategory.mapIso e)

private theorem homothetyQuasiIso_extendScalars_of_homIso
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
    (K : DerivedCategory (ModuleCat.{v} A))
    (eTargetSingle :
      (Stacks.DerivedHom.ScalarTransportedInternalHom.hom.{w, max u v w} B).obj
          (Opposite.op
            ((ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapDerivedCategory.obj
              ((ModuleCat.uliftFunctor.{max u w, v} A).mapDerivedCategory.obj K)),
            (ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapDerivedCategory.obj
              ((ModuleCat.uliftFunctor.{max u w, v} A).mapDerivedCategory.obj K)) ≅
        DerivedCategory.Q.obj ((CochainComplex.singleFunctor (ModuleCat.{max u v w} B) 0).obj
          ((ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).obj
            ((ModuleCat.uliftFunctor.{w, max u v} A).obj (ModuleCat.of A (ULift.{v} A)))))) :
    IsDerivedHomothetyQuasiIso (A := B)
      ((ModuleCat.extendScalars.{u, w, v} (algebraMap A B)).mapDerivedCategory.obj K) := by
  let U := ModuleCat.uliftFunctor.{max u w, v} A
  let V := ModuleCat.uliftFunctor.{u, max w v} B
  let F := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let KU := U.mapDerivedCategory.obj K
  let D := F.mapDerivedCategory
  let HRB := Stacks.DerivedHom.ScalarTransportedInternalHom.hom.{w, max u v w} B
  let U₂ := ModuleCat.uliftFunctor.{w, max u v} A
  let M₁ := ModuleCat.of A (ULift.{v} A)
  intro J hJ hJinj hJbound
  obtain ⟨c, d, hJGE, hJLE⟩ := hJbound
  let Ju : CochainComplex (ModuleCat.{max u v w} B) ℤ := (V.mapHomologicalComplex (.up ℤ)).obj J
  let eJ : DerivedCategory.Q.obj Ju ≅ D.obj KU :=
    (V.mapDerivedCategoryFactors.app J).symm ≪≫
      V.mapDerivedCategory.mapIso hJ.some ≪≫ (extendScalarsULiftCommDerivedIso K).symm
  have hJuGE : Ju.IsStrictlyGE c :=
    (CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff (K := J) V c).2 hJGE
  have hJuInj : ∀ i, Injective (Ju.X i) := fun i => V.injective_obj_of_injective (hJinj i)
  let eJModel := derivedInternalHomModelIso.{w, max u v} Ju c hJuGE hJuInj
  let HJ := CochainComplex.HomComplexR B J J
  let HJu := CochainComplex.HomComplexR B Ju Ju
  let MB := F.obj (U₂.obj M₁)
  let SB := (CochainComplex.singleFunctor (ModuleCat.{max u v w} B) 0).obj MB
  let eJSingle : DerivedCategory.Q.obj HJu ≅ DerivedCategory.Q.obj SB :=
    eJModel.symm ≪≫ HRB.mapIso (eJ.symm.op.prod eJ) ≪≫ eTargetSingle
  let eHom (n : ℤ) : V.obj (HJ.homology n) ≅ SB.homology n :=
    ((HJ.sc n).mapHomologyIso V).symm ≪≫
      (HomologicalComplex.homologyFunctor (ModuleCat.{max u v w} B) (.up ℤ) n).mapIso
        (homComplexULiftIso.{w, max w v, u} J J) ≪≫
      ((DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).app HJu).symm ≪≫
      (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).mapIso eJSingle ≪≫
      (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).app SB
  let eH₀ : HJ.homology 0 ≃ₗ[B] B :=
    (ULift.moduleEquiv (R := B)).symm.trans
      (((eHom 0) ≪≫ HomologicalComplex.singleObjHomologySelfIso (.up ℤ) 0 MB).toLinearEquiv.trans
        (localized_baseModuleEquiv.{u, v, w}))
  have hHjZero (n : ℤ) (hn : n ≠ 0) : IsZero (HJ.homology n) := by
    have h : IsZero (V.obj (HJ.homology n)) :=
      (HomologicalComplex.isZero_single_obj_homology (.up ℤ) 0 MB n hn).of_iso (eHom n)
    have hsub : Subsingleton (V.obj (HJ.homology n)) :=
      ModuleCat.isZero_iff_subsingleton.mp h
    apply ModuleCat.isZero_iff_subsingleton.mpr
    refine ⟨fun x y => ?_⟩
    have hxy : (ULift.up x : V.obj (HJ.homology n)) = ULift.up y :=
      @Subsingleton.elim _ hsub _ _
    exact congrArg ULift.down hxy
  let : J.IsStrictlyGE c := hJGE
  let : ∀ i, Injective (J.X i) := hJinj
  let : J.IsKInjective := CochainComplex.isKInjective_of_injective J c
  exact quasiIso_homothety_of_rankOne J eH₀ hHjZero

private theorem homothetyQuasiIso_extendScalars_of_flat
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    [Module.Flat A B] [IsNoetherianRing A]
    (K : DerivedCategory (ModuleCat.{v} A)) (hK : IsDualizingComplex (A := A) K) :
    IsDerivedHomothetyQuasiIso (A := B)
      ((ModuleCat.extendScalars.{u, w, v} (algebraMap A B)).mapDerivedCategory.obj K) := by
  let : Small.{v} A := small_base_from_dualizing K hK
  let U := ModuleCat.uliftFunctor.{max u w, v} A
  let F := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let KU := U.mapDerivedCategory.obj K
  let D := F.mapDerivedCategory
  let α := F.mapDerivedCategoryFactors.hom
  let W := HomologicalComplex.quasiIso (ModuleCat.{max u v w} A) (.up ℤ)
  let : D.IsLeftDerivedFunctor α W :=
    Functor.isLeftDerivedFunctor_of_inverts W D F.mapDerivedCategoryFactors
  obtain ⟨a, b, I, hGE, hLE, hIinj, ⟨eI⟩⟩ := hK.finiteInjectiveDimension
  let Iu : CochainComplex (ModuleCat.{max u v w} A) ℤ := (U.mapHomologicalComplex (.up ℤ)).obj I
  let eK : KU ≅ DerivedCategory.Q.obj Iu :=
    U.mapDerivedCategory.mapIso eI ≪≫ U.mapDerivedCategoryFactors.app I
  have hIuGE : Iu.IsStrictlyGE a :=
    (CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff (K := I) U a).2 hGE
  have hIuInj : ∀ i, Injective (Iu.X i) := fun i => U.injective_obj_of_injective (hIinj i)
  let : Iu.IsStrictlyGE a := hIuGE
  have hKUge : KU.IsGE a := DerivedCategory.TStructure.t.isGE_of_iso eK.symm a
  have hpc : StacksDraft.PseudoCoherence.IsPseudoCoherent KU :=
    pseudoCoherent_ulift_of_dualizing K hK
  have : IsIso (Stacks.DerivedHom.ExtensionOfScalars.derivedHomBaseChange.{u, w, max u v w}
      (algebraMap A B) D α KU KU) :=
    derivedHomBaseChange_isIso_of_flat_pseudoCoherent.{u, v, w} KU KU hpc ⟨a, hKUge⟩
  have : QuasiIso (sourceHomothetyAtCommonUniverse.{u, v, w} I) :=
    sourceHomothetyAtCommonUniverse_quasiIso I
      (hK.homothetyQuasiIso I ⟨eI.symm⟩ hIinj ⟨a, b, hGE, hLE⟩)
  let HRA := Stacks.DerivedHom.ScalarTransportedInternalHom.hom.{u, max u v w} A
  let U₂ := ModuleCat.uliftFunctor.{w, max u v} A
  let M₁ := ModuleCat.of A (ULift.{v} A)
  let R₀ := (U₂.mapHomologicalComplex (.up ℤ)).obj
    ((CochainComplex.singleFunctor (ModuleCat.{max u v} A) 0).obj M₁)
  let eSource : HRA.obj (Opposite.op KU, KU) ≅ DerivedCategory.Q.obj R₀ :=
    HRA.mapIso (eK.symm.op.prod eK) ≪≫
      derivedInternalHomModelIso.{u, max v w} Iu a hIuGE hIuInj ≪≫
        (asIso (DerivedCategory.Q.map
          (sourceHomothetyAtCommonUniverse.{u, v, w} I))).symm
  let HRB := Stacks.DerivedHom.ScalarTransportedInternalHom.hom.{w, max u v w} B
  let eTarget := (asIso (Stacks.DerivedHom.ExtensionOfScalars.derivedHomBaseChange.{u, w, max u v w}
      (algebraMap A B) D α KU KU)).symm ≪≫
    D.mapIso eSource ≪≫ F.mapDerivedCategoryFactors.app R₀
  let eSingle : (F.mapHomologicalComplex (.up ℤ)).obj R₀ ≅
      (CochainComplex.singleFunctor (ModuleCat.{max u v w} B) 0).obj
        (F.obj (U₂.obj M₁)) :=
    (F.mapHomologicalComplex (.up ℤ)).mapIso
        ((Functor.mapCochainComplexSingleFunctor U₂ 0).app M₁) ≪≫
      (Functor.mapCochainComplexSingleFunctor F 0).app (U₂.obj M₁)
  let eTargetSingle := eTarget ≪≫ DerivedCategory.Q.mapIso eSingle
  exact homothetyQuasiIso_extendScalars_of_homIso K eTargetSingle

/-- When the maximal ideal of `A` generates the maximal ideal of `B`, base change along
`A → B` carries the residue field of `A` to the residue field of `B`. -/
private noncomputable def residueShrink_iso_extendScalars
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    [IsLocalRing A] [IsLocalRing B]
    (hmax : (IsLocalRing.maximalIdeal A).map (algebraMap A B) =
      IsLocalRing.maximalIdeal B) :
    (ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).obj
        (ModuleCat.of A (Shrink.{max u v w} (A ⧸ IsLocalRing.maximalIdeal A))) ≅
      ModuleCat.of B (Shrink.{max u v w} (B ⧸ IsLocalRing.maximalIdeal B)) := by
  let B_A := (ModuleCat.restrictScalars (algebraMap A B)).obj (ModuleCat.of B B)
  let : IsScalarTower A B B_A := IsScalarTower.of_algebraMap_smul (by intro r x; rfl)
  let eB : B_A ≃ₗ[B] B :=
    { toFun := fun x => x
      invFun := fun x => x
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl
      map_smul' := by intro a x; rfl }
  apply LinearEquiv.toModuleIso
  change TensorProduct A B_A (Shrink.{max u v w} (A ⧸ IsLocalRing.maximalIdeal A)) ≃ₗ[B]
    Shrink.{max u v w} (B ⧸ IsLocalRing.maximalIdeal B)
  exact ((TensorProduct.AlgebraTensorModule.congr eB
      (Shrink.linearEquiv.{max u v w, u, u} A (A ⧸ IsLocalRing.maximalIdeal A))).trans
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B
      (IsLocalRing.maximalIdeal A)).symm.toLinearEquiv).trans
      ((Ideal.quotientEquivAlgOfEq B hmax).toLinearEquiv.trans
        (Shrink.linearEquiv.{max u v w, w, w} B (B ⧸ IsLocalRing.maximalIdeal B)).symm)

/-- A faithfully flat extension of scalars only kills the zero module. -/
private theorem isZero_of_isZero_extendScalars_of_faithfullyFlat
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    [Module.FaithfullyFlat A B] (M : ModuleCat.{v} A)
    (hM : IsZero ((ModuleCat.extendScalars.{u, w, v} (algebraMap A B)).obj M)) :
    IsZero M := by
  let eLeft : ((ModuleCat.restrictScalars (algebraMap A B)).obj
      (ModuleCat.of B B)) ≃ₗ[A] B :=
    { AddEquiv.refl B with
      map_smul' := fun a b ↦ (Algebra.smul_def (R := A) (A := B) a b).symm }
  let : Subsingleton (TensorProduct A
      ((ModuleCat.restrictScalars (algebraMap A B)).obj (ModuleCat.of B B)) M) :=
    ModuleCat.isZero_iff_subsingleton.mp hM
  let : Subsingleton (TensorProduct A B M) :=
    Equiv.subsingleton (TensorProduct.congr eLeft (LinearEquiv.refl A M)).symm.toEquiv
  exact ModuleCat.isZero_iff_subsingleton.mpr
    ((Module.FaithfullyFlat.subsingleton_tensorProduct_iff_right A B).1 ‹_›)

/-- For a faithfully flat extension of scalars, a nonzero morphism group out of a
pseudo-coherent object stays nonzero after base change. -/
private theorem not_subsingleton_mapDerivedHom_of_faithfullyFlat
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    [Module.FaithfullyFlat A B]
    (X M : DerivedCategory (ModuleCat.{max u v w} A))
    (hX : StacksDraft.PseudoCoherence.IsPseudoCoherent X)
    (hM : ∃ b : ℤ, M.IsGE b)
    (hXM : ¬ Subsingleton (X ⟶ M)) :
    ¬ Subsingleton
      ((ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapDerivedCategory.obj X ⟶
        (ModuleCat.extendScalars.{u, w, max u v w}
          (algebraMap A B)).mapDerivedCategory.obj M) := by
  let E := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let F := E.mapDerivedCategory
  let α := E.mapDerivedCategoryFactors.hom
  let W := HomologicalComplex.quasiIso (ModuleCat.{max u v w} A) (ComplexShape.up ℤ)
  let : E.Additive := extendScalars_additive _
  let : F.Additive := inferInstance
  let : Limits.PreservesFiniteLimits E := extendScalars_preservesFiniteLimits_of_flat
  let : Limits.PreservesFiniteColimits E := extendScalars_preservesFiniteColimits'
  let : F.IsLeftDerivedFunctor α W :=
    Functor.isLeftDerivedFunctor_of_inverts W F E.mapDerivedCategoryFactors
  let HA := (Stacks.DerivedHom.ScalarTransportedInternalHom.hom.{u, max u v w} A).obj
    (Opposite.op X, M)
  let φ := Stacks.DerivedHom.ExtensionOfScalars.derivedHomBaseChange.{u, w, max u v w}
    (algebraMap A B) F α X M
  have : IsIso φ := derivedHomBaseChange_isIso_of_flat_pseudoCoherent.{u, v, w} X M hX hM
  intro hSub
  have hFB : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) 0).obj
      ((Stacks.DerivedHom.ScalarTransportedInternalHom.hom.{w, max u v w} B).obj
        (Opposite.op (F.obj X), F.obj M))) :=
    (hom_subsingleton_iff_derivedInternalHom_homology_isZero.{w, max u v w}
      (F.obj X) (F.obj M)).mp hSub
  have hFA : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) 0).obj
      (F.obj HA)) :=
    hFB.of_iso (asIso ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) 0).map φ))
  have hEA : IsZero (E.obj
      ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} A) 0).obj HA)) :=
    hFA.of_iso ((StacksDraft.PseudoCoherence.mapDerivedCategoryHomologyIso E 0).app HA).symm
  exact hXM ((hom_subsingleton_iff_derivedInternalHom_homology_isZero.{u, max u v w} X M).mpr
    (isZero_of_isZero_extendScalars_of_faithfullyFlat _ hEA))

/-- Morphisms from the residue field placed in degree zero into `K` are morphisms from the
residue field into `RHom(κ, K)` over the residue field: the derived restriction of scalars along
`R → κ` is left adjoint to `RHom(κ, -)`. -/
private noncomputable def residueSingleHomEquiv
    {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (K : DerivedCategory (ModuleCat.{max v u} R)) :
    ((DerivedCategory.singleFunctor (ModuleCat.{max v u} R) 0).obj
        (ModuleCat.of R (Shrink.{max v u} (R ⧸ IsLocalRing.maximalIdeal R))) ⟶ K) ≃
      ((DerivedCategory.singleFunctor (ModuleCat.{max v u} (IsLocalRing.ResidueField R)) 0).obj
          ((ModuleCat.uliftFunctor.{v} (IsLocalRing.ResidueField R)).obj
            (ModuleCat.of (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField R))) ⟶
        (derivedHom.{u, v} (IsLocalRing.residue R)).obj K) :=
  let k := IsLocalRing.ResidueField R
  let G := ModuleCat.restrictScalars.{max v u} (IsLocalRing.residue R)
  let sMod := (ModuleCat.uliftFunctor.{v} k).obj (ModuleCat.of k k)
  let eQMod : ModuleCat.of R (Shrink.{max v u} (R ⧸ IsLocalRing.maximalIdeal R)) ≅
      G.obj sMod :=
    ((Shrink.linearEquiv R k).trans ULift.moduleEquiv.symm :
      Shrink.{max v u} k ≃ₗ[R] ULift.{v} k).toModuleIso
  let eK₀ := (DerivedCategory.singleFunctor (ModuleCat.{max v u} R) 0).mapIso eQMod ≪≫
    ((G.mapDerivedCategorySingleFunctor 0).app sMod).symm
  (Iso.homCongr eK₀ (Iso.refl K)).trans
    ((restrictScalarsDerived_adj_derivedHom.{u, v} (IsLocalRing.residue R)).some.homEquiv _ K)

/-- Normalization makes the degree-zero part of `RHom(κ, K)` nonzero, so some morphism from the
residue field in degree zero to `K` is nonzero. -/
private theorem residueHom_nontrivial_of_normalization
    {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (K : DerivedCategory (ModuleCat.{max v u} R))
    (hNorm : Nonempty
      ((derivedHom.{u, v} (IsLocalRing.residue R)).obj K ≅
        (DerivedCategory.singleFunctor
          (ModuleCat.{max v u} (IsLocalRing.ResidueField R)) 0).obj
            ((ModuleCat.uliftFunctor.{v} (IsLocalRing.ResidueField R)).obj
              (ModuleCat.of (IsLocalRing.ResidueField R)
                (IsLocalRing.ResidueField R))))) :
    ¬ Subsingleton
      ((DerivedCategory.singleFunctor (ModuleCat.{max v u} R) 0).obj
        (ModuleCat.of R (Shrink.{max v u}
          (R ⧸ IsLocalRing.maximalIdeal R))) ⟶ K) := by
  intro hSub
  obtain ⟨eNorm⟩ := hNorm
  have := Equiv.subsingleton
    ((residueSingleHomEquiv.{u, v} K).trans (Iso.homCongr (Iso.refl _) eNorm)).symm
  exact residueSingle_id_ne_zero.{u, v} (IsLocalRing.ResidueField R) (Subsingleton.elim _ _)

/-- A dualizing complex over a Noetherian local ring is normalized as soon as some morphism
from the residue field in degree zero to it is nonzero. -/
private theorem isNormalizedDualizingComplex_of_residueHom_nontrivial
    {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (K : DerivedCategory (ModuleCat.{max v u} R))
    (hDual : IsDualizingComplex (A := R) K)
    (hHom : ¬ Subsingleton
      ((DerivedCategory.singleFunctor (ModuleCat.{max v u} R) 0).obj
        (ModuleCat.of R (Shrink.{max v u}
          (R ⧸ IsLocalRing.maximalIdeal R))) ⟶ K)) :
    IsNormalizedDualizingComplex.{u, v} K := by
  obtain ⟨n, ⟨eShift⟩⟩ := derivedHom_localResidueField_iso_shift.{u, v} K hDual
  obtain rfl : n = 0 := by
    by_contra hn
    have h0 := residueSingle_shift_hom_eq_zero.{u, v} (IsLocalRing.ResidueField R) n hn
    have : Subsingleton (_ ⟶ _⟦n⟧) := ⟨fun f g => (h0 f).trans (h0 g).symm⟩
    exact hHom (Equiv.subsingleton
      ((residueSingleHomEquiv.{u, v} K).trans (Iso.homCongr (Iso.refl _) eShift)))
  exact ⟨hDual, ⟨eShift ≪≫ shiftZero ℤ _⟩⟩

end FlatBaseChange

section

variable {A : Type u} {B : Type w} [CommRing A] [CommRing B]

/-- A dualizing complex is invariant under isomorphism. -/
private theorem isDualizingComplex_of_iso [IsNoetherianRing A]
    {K L : DerivedCategory (ModuleCat.{v} A)} (e : K ≅ L)
    (hK : Dualizing.IsDualizingComplex (A := A) K) : Dualizing.IsDualizingComplex (A := A) L := by
  constructor
  · rcases hK.finiteInjectiveDimension with ⟨a, b, I, hge, hle, hinj, ⟨eI⟩⟩
    exact ⟨a, b, I, hge, hle, hinj, ⟨e.symm ≪≫ eI⟩⟩
  · intro i
    have := hK.finiteCohomology i
    exact Module.Finite.equiv
      (((DerivedCategory.homologyFunctor (ModuleCat.{v} A) i).mapIso e).toLinearEquiv)
  · intro I hI hinj hbound
    rcases hI with ⟨eI⟩
    exact hK.homothetyQuasiIso I ⟨eI ≪≫ e.symm⟩ hinj hbound

/-- A normalized dualizing complex is invariant under isomorphism. -/
private theorem isNormalizedDualizingComplex_of_iso [IsNoetherianRing A] [IsLocalRing A]
    {K L : DerivedCategory (ModuleCat.{max v u} A)} (e : K ≅ L)
    (hK : Dualizing.IsNormalizedDualizingComplex.{u, v} K) :
    Dualizing.IsNormalizedDualizingComplex.{u, v} L :=
  ⟨isDualizingComplex_of_iso e hK.1,
    hK.2.map fun i => ((Dualizing.derivedHom.{u, v} (IsLocalRing.residue A)).mapIso e).symm ≪≫ i⟩

/-- A flat local homomorphism of Noetherian local rings whose closed fibre is the residue field
of the target preserves the Krull dimension. -/
private theorem ringKrullDim_eq_of_flat_of_map_maximalIdeal_eq [Algebra A B] [Module.Flat A B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    [IsLocalHom (algebraMap A B)]
    (hmax : (IsLocalRing.maximalIdeal A).map (algebraMap A B) = IsLocalRing.maximalIdeal B) :
    ringKrullDim B = ringKrullDim A := by
  have : Algebra.HasGoingDown A B := Algebra.HasGoingDown.of_flat
  have : (IsLocalRing.maximalIdeal B).LiesOver (IsLocalRing.maximalIdeal A) :=
    ⟨(IsLocalRing.maximalIdeal_comap (algebraMap A B)).symm⟩
  have h := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
    (IsLocalRing.maximalIdeal A) (IsLocalRing.maximalIdeal B)
  rw [hmax, Ideal.map_quotient_self, Ideal.height_bot, add_zero] at h
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
    ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h]

variable (f : A →+* B) (hf : f.Flat)

/-- Extension of scalars is a left adjoint, at the module universe `max v u w`. -/
private theorem isLeftAdjoint_extendScalars :
    (ModuleCat.extendScalars.{u, w, max v u w} f).IsLeftAdjoint :=
  (ModuleCat.extendRestrictScalarsAdj.{max v u, u, w} f).isLeftAdjoint

private theorem additive_extendScalars :
    (ModuleCat.extendScalars.{u, w, max v u w} f).Additive :=
  extendScalars_additive f

set_option backward.isDefEq.respectTransparency false in
/-- Extension of scalars of a universe lift is the extension of scalars of the module. -/
private noncomputable def extendScalarsUliftIso (M : ModuleCat.{max u v} A) :
    (ModuleCat.extendScalars.{u, w, max u v w} f).obj
        ((ModuleCat.uliftFunctor.{max u w, max u v} A).obj M) ≅
      (ModuleCat.extendScalars.{u, w, max u v} f).obj M := by
  let e := TensorProduct.congr (LinearEquiv.refl A ((ModuleCat.restrictScalars f).obj
    (ModuleCat.of B B))) (ULift.moduleEquiv (R := A) (M := M) : ULift.{max u w} M ≃ₗ[A] M)
  refine LinearEquiv.toModuleIso ?_
  refine
    { toFun := e
      invFun := e.symm
      map_add' := e.map_add
      left_inv := e.left_inv
      right_inv := e.right_inv
      map_smul' := fun b x => ?_ }
  induction x using TensorProduct.induction_on with
  | zero =>
    change e (b • 0) = b • e 0
    rw [smul_zero, e.map_zero, smul_zero]
  | tmul b' m => rfl
  | add x y hx hy =>
    change e (b • (x + y)) = b • e (x + y)
    rw [smul_add, e.map_add, e.map_add, smul_add]
    exact congrArg₂ (· + ·) hx hy

set_option backward.isDefEq.respectTransparency false in
/-- Degreewise, extension of scalars of the universe lift of a complex is the extension of
scalars of the complex. -/
private noncomputable def extendScalarsUliftComplexIso
    (P : CochainComplex (ModuleCat.{max u v} A) ℤ) :
    ((ModuleCat.extendScalars.{u, w, max u v w} f).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (((ModuleCat.uliftFunctor.{max u w, max u v} A).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj P) ≅
      ((ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj P :=
  HomologicalComplex.Hom.isoOfComponents (fun i => extendScalarsUliftIso.{u, v, w} f (P.X i)) (by
    intro i j _
    ext x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul b m => rfl
    | add x y hx hy => simp only [map_add, hx, hy])

/-- On derived categories, extension of scalars of the universe lift is the extension of
scalars. -/
private noncomputable def extendScalarsUliftDerivedIso [Algebra A B] [Module.Flat A B]
    (K : DerivedCategory (ModuleCat.{max u v} A)) :
    letI := additive_extendScalars.{u, max u v, w} (algebraMap A B)
    letI := ModuleCat.extendScalars_preservesFiniteLimits_of_flat.{u, w, max u v w}
      (algebraMap A B) (RingHom.flat_algebraMap_iff.mpr inferInstance)
    haveI := isLeftAdjoint_extendScalars.{u, max u v, w} (algebraMap A B)
    letI := extendScalars_additive.{u, max u v, w} (algebraMap A B)
    letI := extendScalars_preservesFiniteLimits_of_flat.{u, max u v, w} (A := A) (B := B)
    letI := extendScalars_preservesFiniteColimits'.{u, max u v, w}
      (A := A) (B := B)
    (ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapDerivedCategory.obj
        ((ModuleCat.uliftFunctor.{max u w, max u v} A).mapDerivedCategory.obj K) ≅
      (ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)).mapDerivedCategory.obj K := by
  letI := additive_extendScalars.{u, max u v, w} (algebraMap A B)
  letI := ModuleCat.extendScalars_preservesFiniteLimits_of_flat.{u, w, max u v w}
    (algebraMap A B) (RingHom.flat_algebraMap_iff.mpr inferInstance)
  haveI := isLeftAdjoint_extendScalars.{u, max u v, w} (algebraMap A B)
  letI := extendScalars_additive.{u, max u v, w} (algebraMap A B)
  letI := extendScalars_preservesFiniteLimits_of_flat.{u, max u v, w} (A := A) (B := B)
  letI := extendScalars_preservesFiniteColimits'.{u, max u v, w}
    (A := A) (B := B)
  let U := ModuleCat.uliftFunctor.{max u w, max u v} A
  let F := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let E := ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)
  let P := DerivedCategory.Q.objPreimage K
  let e := DerivedCategory.Q.objObjPreimageIso K
  exact F.mapDerivedCategory.mapIso (U.mapDerivedCategory.mapIso e.symm) ≪≫
    F.mapDerivedCategory.mapIso (U.mapDerivedCategoryFactors.app P) ≪≫
    F.mapDerivedCategoryFactors.app ((U.mapHomologicalComplex (.up ℤ)).obj P) ≪≫
    DerivedCategory.Q.mapIso (extendScalarsUliftComplexIso.{u, v, w} (algebraMap A B) P) ≪≫
    (E.mapDerivedCategoryFactors.app P).symm ≪≫ E.mapDerivedCategory.mapIso e

include hf in
/-- Along a flat map, every total derived extension of scalars is the degreewise extension of
scalars on derived categories. -/
private noncomputable def totalDerivedIsoMapDerivedCategory
    (D : CochainComplex.DerivedExtensionScalars.TotalDerivedExtensionScalars.{u, v, w} f) :
    letI := additive_extendScalars.{u, v, w} f
    letI := ModuleCat.extendScalars_preservesFiniteLimits_of_flat.{u, w, max v u w} f hf
    haveI := isLeftAdjoint_extendScalars.{u, v, w} f
    D.functor ≅ (ModuleCat.extendScalars.{u, w, max v u w} f).mapDerivedCategory := by
  letI := additive_extendScalars.{u, v, w} f
  letI := ModuleCat.extendScalars_preservesFiniteLimits_of_flat.{u, w, max v u w} f hf
  haveI := isLeftAdjoint_extendScalars.{u, v, w} f
  let G := ModuleCat.extendScalars.{u, w, max v u w} f
  haveI : G.mapDerivedCategory.IsLeftDerivedFunctor G.mapDerivedCategoryFactors.hom
      (HomologicalComplex.quasiIso (ModuleCat.{max v u w} A) (ComplexShape.up ℤ)) :=
    Functor.isLeftDerivedFunctor_of_inverts _ G.mapDerivedCategory G.mapDerivedCategoryFactors
  haveI := D.isLeftDerived
  exact Functor.leftDerivedNatIso D.functor G.mapDerivedCategory D.comparison
    G.mapDerivedCategoryFactors.hom
    (HomologicalComplex.quasiIso (ModuleCat.{max v u w} A) (ComplexShape.up ℤ)) (Iso.refl _)

/-- **Stacks Project, Tag 0AWD, across module universes.** For a flat local homomorphism
`A → B` of Noetherian local rings with `𝔪_A B = 𝔪_B` and a normalized dualizing complex `K`
over `A`, the extension of scalars of the universe lift of `K` is a normalized dualizing
complex over `B`. -/
private theorem isNormalizedDualizingComplex_extendScalars_uliftFunctor [Algebra A B]
    [Module.Flat A B] [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    [IsLocalHom (algebraMap A B)]
    (hmax : (IsLocalRing.maximalIdeal A).map (algebraMap A B) = IsLocalRing.maximalIdeal B)
    (K : DerivedCategory (ModuleCat.{max u v} A))
    (hK : Dualizing.IsNormalizedDualizingComplex.{u, v} K) :
    letI := additive_extendScalars.{u, max u v, w} (algebraMap A B)
    letI := ModuleCat.extendScalars_preservesFiniteLimits_of_flat.{u, w, max u v w}
      (algebraMap A B) (RingHom.flat_algebraMap_iff.mpr inferInstance)
    haveI := isLeftAdjoint_extendScalars.{u, max u v, w} (algebraMap A B)
    Dualizing.IsNormalizedDualizingComplex.{w, max u v}
      ((ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)).mapDerivedCategory.obj
        ((ModuleCat.uliftFunctor.{max u w, max u v} A).mapDerivedCategory.obj K)) := by
  have hf : (algebraMap A B).Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  let := additive_extendScalars.{u, max u v, w} (algebraMap A B)
  let := ModuleCat.extendScalars_preservesFiniteLimits_of_flat.{u, w, max u v w}
    (algebraMap A B) hf
  have := isLeftAdjoint_extendScalars.{u, max u v, w} (algebraMap A B)
  let F := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let U := ModuleCat.uliftFunctor.{max u w, max u v} A
  let KU := U.mapDerivedCategory.obj K
  let QA := ModuleCat.of A (Shrink.{max u v w} (A ⧸ IsLocalRing.maximalIdeal A))
  let QB := ModuleCat.of B (Shrink.{max u v w} (B ⧸ IsLocalRing.maximalIdeal B))
  let XA := (DerivedCategory.singleFunctor (ModuleCat.{max u v w} A) 0).obj QA
  let XB := (DerivedCategory.singleFunctor (ModuleCat.{max u v w} B) 0).obj QB
  have hXApc : StacksDraft.PseudoCoherence.IsPseudoCoherent XA :=
    (StacksDraft.PseudoCoherence.pseudoCoherent_iff_boundedAbove_finite_homology XA 0
      (QA : Type (max u v w))).2.2.mpr inferInstance
  let eX : F.mapDerivedCategory.obj XA ≅ XB :=
    (F.mapDerivedCategorySingleFunctor 0).app QA ≪≫
      (DerivedCategory.singleFunctor (ModuleCat.{max u v w} B) 0).mapIso
        (residueShrink_iso_extendScalars.{u, v, w} hmax)
  have hKU : StacksDraft.InjectiveDimension.HasFiniteInjectiveDimension KU :=
    finiteInjectiveDimension_ulift.{u, max u v, w} K hK.1.finiteInjectiveDimension
  obtain ⟨a, b, hGE, hLE⟩ :=
    exists_tStructure_bounds_of_finiteInjectiveDimension KU hKU
  have hGE' : (F.mapDerivedCategory.obj KU).IsGE a := by
    rw [DerivedCategory.isGE_iff]
    intro i hi
    exact (F.map_isZero ((DerivedCategory.isGE_iff KU a).mp hGE i hi)).of_iso
      ((StacksDraft.PseudoCoherence.mapDerivedCategoryHomologyIso F i).app KU)
  have hfinU (i : ℤ) : Module.Finite A
      ((DerivedCategory.homologyFunctor (ModuleCat.{max u v w} A) i).obj KU) := by
    let e := (StacksDraft.PseudoCoherence.mapDerivedCategoryHomologyIso U i).app K
    have := hK.1.finiteCohomology i
    exact Module.Finite.equiv ((ULift.moduleEquiv (R := A)).symm ≪≫ₗ e.symm.toLinearEquiv)
  have hfinite := finiteCohomology_extendScalars (B := B) KU hfinU
  obtain ⟨c, d, hAmp⟩ := hKU
  have hExtB : ∃ e : ℤ, ∀ i : ℤ, e < i →
      Subsingleton (DerivedCategory.Ext XB (F.mapDerivedCategory.obj KU) i) := by
    refine ⟨d, fun i hi => ?_⟩
    have hMi : (KU⟦i⟧).IsGE (a - i) :=
      DerivedCategory.TStructure.t.isGE_shift KU a i (a - i) (by omega)
    have hc : Subsingleton (XA ⟶ KU⟦i⟧) :=
      (StacksDraft.InjectiveDimension.hasInjectiveAmplitude_iff_ext_vanishing_iff_quotient_vanishing
        KU c d).1.1 hAmp QA i (Or.inr hi)
    have hExtB0 : Subsingleton
        (F.mapDerivedCategory.obj XA ⟶ F.mapDerivedCategory.obj (KU⟦i⟧)) :=
      subsingleton_mapDerivedHom_of_flat_pseudoCoherent.{u, v, w} XA (KU⟦i⟧) hXApc
        ⟨a - i, hMi⟩ hc
    exact @Equiv.subsingleton _ _
      (Iso.homCongr eX ((F.mapDerivedCategory.commShiftIso i).app KU)).symm hExtB0
  have hhom : Dualizing.IsDerivedHomothetyQuasiIso (A := B) (F.mapDerivedCategory.obj KU) := by
    have h := homothetyQuasiIso_extendScalars_of_flat.{u, max u v, w}
      (B := B) K hK.1
    intro I hI hinj hb
    exact h I (hI.map fun i => i ≪≫ extendScalarsUliftDerivedIso.{u, v, w} K)
      hinj hb
  have hDual : Dualizing.IsDualizingComplex (A := B) (F.mapDerivedCategory.obj KU) :=
    { -- [Stacks, Tag 0AVJ]
      finiteInjectiveDimension :=
        (StacksDraft.InjectiveDimension.hasFiniteInjectiveDimension_iff_residueField_ext_vanishing
          (ObjectProperty.FullSubcategory.mk _ ⟨a, hGE'⟩) hfinite).2 hExtB
      finiteCohomology := hfinite
      homothetyQuasiIso := hhom }
  have h1 := residueHom_nontrivial_of_normalization.{u, v} K hK.2
  obtain ⟨a₀, b₀, hGE₀, -⟩ :=
    exists_tStructure_bounds_of_finiteInjectiveDimension K hK.1.finiteInjectiveDimension
  let QA₀ := ModuleCat.of A (Shrink.{max u v} (A ⧸ IsLocalRing.maximalIdeal A))
  have h2 : ¬ Subsingleton (XA ⟶ KU) := by
    intro hs
    apply h1
    let eS : U.mapDerivedCategory.obj
        ((DerivedCategory.singleFunctor (ModuleCat.{max u v} A) 0).obj QA₀) ≅ XA :=
      (U.mapDerivedCategorySingleFunctor 0).app QA₀ ≪≫
        (DerivedCategory.singleFunctor (ModuleCat.{max u v w} A) 0).mapIso
          (LinearEquiv.toModuleIso ((ULift.moduleEquiv (R := A)).trans
            ((Shrink.linearEquiv A _).trans (Shrink.linearEquiv A _).symm)))
    exact subsingleton_hom_of_ulift.{u, max u v, max u w} _ K a₀
      (Equiv.subsingleton (Iso.homCongr eS (Iso.refl KU)))
  have : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hNT : ¬ Subsingleton (XB ⟶ F.mapDerivedCategory.obj KU) := by
    have h0 := not_subsingleton_mapDerivedHom_of_faithfullyFlat.{u, v, w} (B := B)
      XA KU hXApc ⟨a, hGE⟩ h2
    intro hSub
    exact h0 (Equiv.subsingleton (Iso.homCongr eX (Iso.refl (F.mapDerivedCategory.obj KU))))
  exact isNormalizedDualizingComplex_of_residueHom_nontrivial.{w, max u v} _ hDual hNT

/-! ### The flat comparison `H^n(K) ⊗_A B ⟶ H^n(K ⊗^L_A B)` -/

set_option backward.isDefEq.respectTransparency false in
/-- The universe-lift identification of `extendScalarsUliftIso`, natural in the module. -/
private noncomputable def extendScalarsUliftNatIso :
    ModuleCat.uliftFunctor.{max u w, max u v} A ⋙ ModuleCat.extendScalars.{u, w, max u v w} f ≅
      ModuleCat.extendScalars.{u, w, max u v} f :=
  NatIso.ofComponents (fun M => extendScalarsUliftIso.{u, v, w} f M) (by
    intro M N g
    ext x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul b m => rfl
    | add x y hx hy => simp only [map_add, hx, hy])

include hf in
/-- Along a flat map the comparison of the total derived extension of scalars with termwise
extension of scalars is an isomorphism. -/
private theorem isIso_totalDerivedExtensionScalars_comparison :
    IsIso (CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, w, max u v}
      f).comparison := by
  let F := ModuleCat.extendScalars.{u, w, max u v w} f
  let D := CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, w, max u v} f
  let := additive_extendScalars.{u, max u v, w} f
  let : PreservesFiniteLimits F :=
    ModuleCat.extendScalars_preservesFiniteLimits_of_flat.{u, w, max u v w} f hf
  let : PreservesFiniteColimits F := ModuleCat.extendScalars_preservesFiniteColimits f
  let : F.PreservesHomology := Functor.preservesHomologyOfExact F
  exact Functor.isIso_of_isLeftDerivedFunctor_of_inverts
    D.functor D.comparison (W := HomologicalComplex.quasiIso
      (ModuleCat.{max u w (max u v)} A) (ComplexShape.up ℤ)) (by
      intro X Y g hg
      have : QuasiIso g := hg
      change IsIso (DerivedCategory.Q.map ((F.mapHomologicalComplex _).map g))
      infer_instance)

include hf in
/-- Along a flat ring map `f : A → B`, the derived extension of scalars of a complex `C` is
computed by the termwise extension of scalars `B ⊗_A C`: the comparison of the total derived
functor with termwise extension of scalars, after the universe lift built into
`StacksDraft.PseudoCoherence.derivedExtensionScalars`. -/
public noncomputable def flatDerivedExtensionScalarsIso :
    DerivedCategory.Q ⋙ StacksDraft.PseudoCoherence.derivedExtensionScalars.{max u v, u, w} f ≅
      (ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex (ComplexShape.up ℤ) ⋙
        DerivedCategory.Q := by
  let U := ModuleCat.uliftFunctor.{max u w, max u v} A
  let D := CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, w, max u v} f
  letI := additive_extendScalars.{u, max u v, w} f
  letI := extendScalars_additive.{u, max u v, w} f
  haveI := isIso_totalDerivedExtensionScalars_comparison.{u, v, w} f hf
  exact (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight U.mapDerivedCategoryFactors D.functor ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft (U.mapHomologicalComplex (ComplexShape.up ℤ)) (asIso D.comparison) ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight
      (Functor.mapHomologicalComplexCompIso (extendScalarsUliftNatIso.{u, v, w} f) _)
      DerivedCategory.Q

include hf in
/-- Flat extension of scalars commutes with the cohomology of cochain complexes, naturally in
the complex; the component at `C` is `ModuleCat.extendScalarsHomologyIso`. -/
private noncomputable def extendScalarsHomologyNatIso (n : ℤ) :
    (ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex (ComplexShape.up ℤ) ⋙
        HomologicalComplex.homologyFunctor _ (ComplexShape.up ℤ) n ≅
      HomologicalComplex.homologyFunctor _ (ComplexShape.up ℤ) n ⋙
        ModuleCat.extendScalars.{u, w, max u v} f := by
  let F := ModuleCat.extendScalars.{u, w, max u v} f
  letI : PreservesFiniteLimits F := ModuleCat.extendScalars_preservesFiniteLimits_of_flat f hf
  letI : PreservesFiniteColimits F := ModuleCat.extendScalars_preservesFiniteColimits f
  letI : F.PreservesHomology := Functor.preservesHomologyOfExact F
  exact NatIso.ofComponents (fun K => ModuleCat.extendScalarsHomologyIso f hf K n) (fun φ =>
    ShortComplex.mapHomologyIso_hom_naturality
      ((HomologicalComplex.shortComplexFunctor _ (ComplexShape.up ℤ) n).map φ) F)

include hf in
/-- **The flat comparison on cohomology.** For a flat ring map `f : A → B` and `n : ℤ`, the
natural map `H^n(K) ⊗_A B ⟶ H^n(K ⊗^L_A B)` on `D(A)`. It is induced by flat tensor on
complexes: on a complex `C` it is the map `H^n(C) ⊗_A B ⟶ H^n(B ⊗_A C)`, `[z] ⊗ b ↦ [b ⊗ z]`,
followed by the identification `flatDerivedExtensionScalarsIso` of `B ⊗_A C` with the derived
extension of scalars (`flatHomologyTensorComparison_app_Q`). -/
public noncomputable def flatHomologyTensorComparison (n : ℤ) :
    DerivedCategory.homologyFunctor (ModuleCat.{max u v} A) n ⋙
        ModuleCat.extendScalars.{u, w, max u v} f ⟶
      StacksDraft.PseudoCoherence.derivedExtensionScalars.{max u v, u, w} f ⋙
        DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n :=
  (Localization.liftNatIso DerivedCategory.Q
    (HomologicalComplex.quasiIso (ModuleCat.{max u v} A) (ComplexShape.up ℤ))
    (DerivedCategory.Q ⋙ (DerivedCategory.homologyFunctor (ModuleCat.{max u v} A) n ⋙
        ModuleCat.extendScalars.{u, w, max u v} f))
    (DerivedCategory.Q ⋙ (StacksDraft.PseudoCoherence.derivedExtensionScalars.{max u v, u, w} f ⋙
        DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n)) _ _
    ((Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight (DerivedCategory.homologyFunctorFactors _ n) _ ≪≫
      (extendScalarsHomologyNatIso.{u, v, w} f hf n).symm ≪≫
      Functor.isoWhiskerLeft _ (DerivedCategory.homologyFunctorFactors _ n).symm ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight (flatDerivedExtensionScalarsIso.{u, v, w} f hf).symm _ ≪≫
      Functor.associator _ _ _)).hom

include hf in
private theorem isIso_flatHomologyTensorComparison (n : ℤ) :
    IsIso (flatHomologyTensorComparison.{u, v, w} f hf n) := by
  unfold flatHomologyTensorComparison
  infer_instance

include hf in
/-- On the image of a complex `C`, the flat comparison is the comparison
`ModuleCat.extendScalarsHomologyIso` of flat tensor with the cohomology of `C`, read through
`flatDerivedExtensionScalarsIso`. -/
private theorem flatHomologyTensorComparison_app_Q (n : ℤ)
    (C : CochainComplex (ModuleCat.{max u v} A) ℤ) :
    (flatHomologyTensorComparison.{u, v, w} f hf n).app (DerivedCategory.Q.obj C) =
      (ModuleCat.extendScalars.{u, w, max u v} f).map
          ((DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).hom.app C) ≫
        (extendScalarsHomologyNatIso.{u, v, w} f hf n).inv.app C ≫
        (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).inv.app
          (((ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj C) ≫
        (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
          ((flatDerivedExtensionScalarsIso.{u, v, w} f hf).inv.app C) := by
  simp only [flatHomologyTensorComparison, Localization.liftNatIso_hom,
    Localization.liftNatTrans_app, Localization.Lifting.compLeft_iso, Iso.refl_hom, Iso.refl_inv,
    NatTrans.id_app, Category.id_comp, Category.comp_id, Iso.trans_hom, NatTrans.comp_app,
    Functor.isoWhiskerRight_hom, Functor.whiskerRight_app, Functor.isoWhiskerLeft_hom,
    Functor.whiskerLeft_app, Iso.symm_hom, Functor.associator_hom_app,
    Functor.associator_inv_app]

include hf in
/-- The flat comparison on the image of a complex `C`, followed by a chain map out of
`B ⊗_A C`, is the cohomology comparison of `C` followed by the cohomology of that chain map. -/
private theorem flatHomologyTensorComparison_app_Q_comp (n : ℤ)
    (C : CochainComplex (ModuleCat.{max u v} A) ℤ)
    {D : CochainComplex (ModuleCat.{max u v w} B) ℤ}
    (h : ((ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj C ⟶ D) :
    (flatHomologyTensorComparison.{u, v, w} f hf n).app (DerivedCategory.Q.obj C) ≫
        (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
          ((flatDerivedExtensionScalarsIso.{u, v, w} f hf).hom.app C ≫ DerivedCategory.Q.map h) ≫
        (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).hom.app D =
      (ModuleCat.extendScalars.{u, w, max u v} f).map
          ((DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).hom.app C) ≫
        (extendScalarsHomologyNatIso.{u, v, w} f hf n).inv.app C ≫
        (HomologicalComplex.homologyFunctor _ (ComplexShape.up ℤ) n).map h := by
  have h4 : ∀ {T : ModuleCat.{max u v w} B} (k : (DerivedCategory.homologyFunctor
      (ModuleCat.{max u v w} B) n).obj (DerivedCategory.Q.obj
        (((ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj C)) ⟶ T),
      (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
          ((flatDerivedExtensionScalarsIso.{u, v, w} f hf).inv.app C) ≫
        (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
          ((flatDerivedExtensionScalarsIso.{u, v, w} f hf).hom.app C) ≫ k = k := by
    intro T k
    rw [← Functor.map_comp_assoc, Iso.inv_hom_id_app, CategoryTheory.Functor.map_id,
      Category.id_comp]
  have h5 : (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).inv.app
        (((ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj C) ≫
      (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
        (DerivedCategory.Q.map h) ≫
      (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).hom.app D =
        (HomologicalComplex.homologyFunctor _ (ComplexShape.up ℤ) n).map h := by
    have := (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).hom.naturality h
    rw [Functor.comp_map] at this
    rw [this, Iso.inv_hom_id_app_assoc]
  rw [flatHomologyTensorComparison_app_Q.{u, v, w} f hf n C]
  simp only [Category.assoc, CategoryTheory.Functor.map_comp]
  rw [h4, h5]

end

/-! ### Elementwise descriptions -/

section Elementwise

variable {R : Type*} {S : Type*} [Ring R] [Ring S]

private theorem iCycles_mapCyclesIso_inv_apply
    (F : ModuleCat.{v} R ⥤ ModuleCat.{w} S) [F.PreservesZeroMorphisms]
    (K : ShortComplex (ModuleCat.{v} R)) [F.PreservesLeftHomologyOf K] (x : F.obj K.cycles) :
    (K.map F).iCycles ((K.mapCyclesIso F).inv x) = F.map K.iCycles x := by
  rw [← ConcreteCategory.comp_apply, ← K.mapCyclesIso_hom_iCycles F, Iso.inv_hom_id_assoc]

set_option backward.isDefEq.respectTransparency false in
/-- For a functor `F` between module categories preserving the left homology of `K`, the
comparison `F(H(K)) ⟶ H(F(K))` sends `F([z])` to the class of a cycle with the same image. -/
private theorem mapHomologyIso_inv_map_homologyπ_apply
    (F : ModuleCat.{v} R ⥤ ModuleCat.{w} S) [F.PreservesZeroMorphisms]
    (K : ShortComplex (ModuleCat.{v} R)) [F.PreservesLeftHomologyOf K]
    (x : F.obj K.cycles) (y : (K.map F).cycles) (hy : (K.map F).iCycles y = F.map K.iCycles x) :
    (K.mapHomologyIso F).inv (F.map K.homologyπ x) = (K.map F).homologyπ y := by
  have hy' : y = (K.mapCyclesIso F).inv x := by
    have hmono : Function.Injective ((K.map F).iCycles) :=
      (ModuleCat.mono_iff_injective _).1 inferInstance
    apply hmono
    rw [hy, iCycles_mapCyclesIso_inv_apply]
  subst hy'
  simpa only [ConcreteCategory.comp_apply] using
    congrArg (fun g => g x) (ShortComplex.π_comp_mapHomologyIso_inv K F)

private theorem mapHomologyIso_hom_homologyπ_apply
    (F : ModuleCat.{v} R ⥤ ModuleCat.{w} S) [F.PreservesZeroMorphisms]
    (K : ShortComplex (ModuleCat.{v} R)) [F.PreservesLeftHomologyOf K]
    (y : (K.map F).cycles) :
    (K.mapHomologyIso F).hom ((K.map F).homologyπ y) =
      F.map K.homologyπ ((K.mapCyclesIso F).hom y) := by
  rw [← mapHomologyIso_inv_map_homologyπ_apply F K ((K.mapCyclesIso F).hom y) y
    (by rw [← ConcreteCategory.comp_apply, K.mapCyclesIso_hom_iCycles F])]
  exact Iso.inv_hom_id_apply (K.mapHomologyIso F) _

private theorem map_iCycles_mapCyclesIso_hom_apply
    (F : ModuleCat.{v} R ⥤ ModuleCat.{w} S) [F.PreservesZeroMorphisms]
    (K : ShortComplex (ModuleCat.{v} R)) [F.PreservesLeftHomologyOf K]
    (y : (K.map F).cycles) :
    F.map K.iCycles ((K.mapCyclesIso F).hom y) = (K.map F).iCycles y := by
  rw [← ConcreteCategory.comp_apply, K.mapCyclesIso_hom_iCycles F]

end Elementwise

section CoefficientChange

variable {A : Type u} {B : Type w} [CommRing A] [CommRing B] (f : A →+* B)

attribute [local instance] extendScalars_additive

open scoped ChangeOfRings

set_option backward.isDefEq.respectTransparency false in
/-- Flat extension of scalars on cohomology sends `b ⊗ [z]` to the class of the cycle `b ⊗ z`. -/
private theorem extendScalarsHomologyIso_inv_tmul_homologyπ (hf : f.Flat)
    (C : CochainComplex (ModuleCat.{max u v} A) ℤ)
    (n : ℤ) (z : C.cycles n) (b : B)
    (y : (((ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj C).cycles n)
    (hy : (((ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj C).iCycles n y = b ⊗ₜ[A,f] C.iCycles n z) :
    (ModuleCat.extendScalarsHomologyIso f hf C n).inv (b ⊗ₜ[A,f] C.homologyπ n z) =
      (((ModuleCat.extendScalars.{u, w, max u v} f).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj C).homologyπ n y := by
  let F := ModuleCat.extendScalars.{u, w, max u v} f
  let : PreservesFiniteLimits F := ModuleCat.extendScalars_preservesFiniteLimits_of_flat f hf
  let : PreservesFiniteColimits F := ModuleCat.extendScalars_preservesFiniteColimits f
  let : F.PreservesHomology := Functor.preservesHomologyOfExact F
  exact mapHomologyIso_inv_map_homologyπ_apply F (C.sc n) (b ⊗ₜ[A,f] z) y hy

section RingSquare

variable {A' : Type u} {B' : Type w} [CommRing A'] [CommRing B'] (f' : A' →+* B') (σ : A →+* A')
  (τ : B →+* B')

set_option backward.isDefEq.respectTransparency false in
/-- The base-change map `B ⊗_A M' ⟶ B' ⊗_{A'} M'`, `b ⊗ m ↦ τ b ⊗ m`, of a commutative square
of ring maps, for an `A'`-module `M'` restricted to `A`. -/
private noncomputable def extendScalarsRestrictScalarsBaseChangeApp (hc : τ.comp f = f'.comp σ)
    (M' : ModuleCat.{max u v} A') :
    (ModuleCat.extendScalars.{u, w, max u v} f).obj ((ModuleCat.restrictScalars σ).obj M') ⟶
      (ModuleCat.restrictScalars τ).obj ((ModuleCat.extendScalars.{u, w, max u v} f').obj M') := by
  letI : Module A' B' := Module.compHom B' f'
  let T := (ModuleCat.extendScalars.{u, w, max u v} f').obj M'
  letI : Module A T := Module.compHom T (f'.comp σ)
  let β : (ModuleCat.restrictScalars f).obj (ModuleCat.of B B) →ₗ[A]
      (ModuleCat.restrictScalars σ).obj M' →ₗ[A] T :=
    { toFun := fun b =>
        { toFun := fun m => (τ b) ⊗ₜ[A',f'] (m : M')
          map_add' := fun m₁ m₂ => TensorProduct.tmul_add _ _ _
          map_smul' := fun a m => by
            change (τ b) ⊗ₜ[A',f'] ((σ a) • (m : M')) = (f' (σ a)) • ((τ b) ⊗ₜ[A',f'] m)
            rw [ModuleCat.ExtendScalars.smul_tmul, ← TensorProduct.smul_tmul]
            rfl }
      map_add' := fun b₁ b₂ => by
        ext m
        change (τ (b₁ + b₂)) ⊗ₜ[A',f'] (m : M') = (τ b₁) ⊗ₜ[A',f'] m + (τ b₂) ⊗ₜ[A',f'] m
        rw [map_add, TensorProduct.add_tmul]
      map_smul' := fun a b => by
        ext m
        change (τ (f a * (show B from b))) ⊗ₜ[A',f'] (m : M') =
          (f' (σ a)) • ((τ b) ⊗ₜ[A',f'] m)
        rw [ModuleCat.ExtendScalars.smul_tmul, map_mul]
        have : τ (f a) = f' (σ a) := congrArg (fun g => g a) hc
        rw [this] }
  let X := (ModuleCat.extendScalars.{u, w, max u v} f).obj ((ModuleCat.restrictScalars σ).obj M')
  let Y := (ModuleCat.restrictScalars τ).obj T
  let ℓ : X → Y := fun x => TensorProduct.lift β x
  have hadd : ∀ x y : X, ℓ (x + y) = ℓ x + ℓ y := fun x y => map_add (TensorProduct.lift β) x y
  have hsmul : ∀ (b : B) (x : X), ℓ (b • x) = b • ℓ x := by
    intro b x
    induction x using TensorProduct.induction_on with
    | zero =>
      have h0 : ℓ 0 = 0 := map_zero (TensorProduct.lift β)
      rw [smul_zero, h0, smul_zero]
    | tmul b' m =>
      have e : (τ (b * (show B from b'))) ⊗ₜ[A',f'] (m : M') =
          (τ b * τ b') ⊗ₜ[A',f'] (m : M') := by rw [map_mul]
      exact e
    | add x y hx hy =>
      rw [smul_add, hadd, hadd, hx, hy, smul_add]
  let L : X →ₗ[B] Y :=
    { toFun := ℓ
      map_add' := hadd
      map_smul' := hsmul }
  exact ModuleCat.ofHom (X := X) (Y := Y) L

/-- The base-change transformation `restrictScalars σ ⋙ extendScalars f ⟶
extendScalars f' ⋙ restrictScalars τ` of a commutative square of ring maps `τ ∘ f = f' ∘ σ`:
on an `A'`-module `M'` it is `B ⊗_A M' ⟶ B' ⊗_{A'} M'`, `b ⊗ m ↦ τ b ⊗ m`. -/
public noncomputable def extendScalarsRestrictScalarsBaseChange (hc : τ.comp f = f'.comp σ) :
    ModuleCat.restrictScalars.{max u v} σ ⋙ ModuleCat.extendScalars.{u, w, max u v} f ⟶
      ModuleCat.extendScalars.{u, w, max u v} f' ⋙ ModuleCat.restrictScalars τ where
  app M' := extendScalarsRestrictScalarsBaseChangeApp f f' σ τ hc M'
  naturality _ _ _ := ModuleCat.ExtendScalars.hom_ext fun _ => rfl

set_option backward.isDefEq.respectTransparency false in
/-- The cohomology comparison of flat tensor is natural in coefficient-ring maps: for a
commutative square `τ ∘ f = f' ∘ σ` of ring maps and a complex `C'` of `A'`-modules, it
commutes with the base change `extendScalarsRestrictScalarsBaseChange`. -/
private theorem extendScalarsHomologyIso_inv_extendScalarsRestrictScalarsBaseChange (hf : f.Flat)
    (hf' : f'.Flat) (hc : τ.comp f = f'.comp σ) (C' : CochainComplex (ModuleCat.{max u v} A') ℤ)
    (n : ℤ) :
    (ModuleCat.extendScalarsHomologyIso f hf
        (((ModuleCat.restrictScalars.{max u v} σ).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj C') n).inv ≫
      HomologicalComplex.homologyMap
        ((NatTrans.mapHomologicalComplex
          (extendScalarsRestrictScalarsBaseChange.{u, v, w} f f' σ τ hc) (ComplexShape.up ℤ)).app
            C') n ≫
      (((((ModuleCat.extendScalars.{u, w, max u v} f').mapHomologicalComplex
          (ComplexShape.up ℤ)).obj C').sc n).mapHomologyIso (ModuleCat.restrictScalars τ)).hom =
    (ModuleCat.extendScalars.{u, w, max u v} f).map
        ((C'.sc n).mapHomologyIso (ModuleCat.restrictScalars.{max u v} σ)).hom ≫
      (extendScalarsRestrictScalarsBaseChange.{u, v, w} f f' σ τ hc).app (C'.homology n) ≫
      (ModuleCat.restrictScalars τ).map (ModuleCat.extendScalarsHomologyIso f' hf' C' n).inv := by
  let E := ModuleCat.extendScalars.{u, w, max u v} f
  let : PreservesFiniteLimits E := ModuleCat.extendScalars_preservesFiniteLimits_of_flat f hf
  let : PreservesFiniteColimits E := ModuleCat.extendScalars_preservesFiniteColimits f
  let : E.PreservesHomology := Functor.preservesHomologyOfExact E
  let Rσ := ModuleCat.restrictScalars.{max u v} σ
  let Rτ := ModuleCat.restrictScalars.{max u v w} τ
  let K := C'.sc n
  apply ModuleCat.ExtendScalars.hom_ext
  intro x
  obtain ⟨z, rfl⟩ := (ModuleCat.epi_iff_surjective
    ((K.map Rσ).homologyπ)).1 inferInstance x
  let E' := ModuleCat.extendScalars.{u, w, max u v} f'
  let zc' : K.cycles := (K.mapCyclesIso Rσ).hom z
  have hz' : K.iCycles zc' = (K.map Rσ).iCycles z := map_iCycles_mapCyclesIso_hom_apply Rσ K z
  let w : ((K.map Rσ).map E).cycles := ((K.map Rσ).mapCyclesIso E).inv ((1 : B) ⊗ₜ[A,f] z)
  have hw : ((K.map Rσ).map E).iCycles w = (1 : B) ⊗ₜ[A,f] (K.map Rσ).iCycles z :=
    iCycles_mapCyclesIso_inv_apply E (K.map Rσ) _
  let φ := (NatTrans.mapHomologicalComplex
    (extendScalarsRestrictScalarsBaseChange.{u, v, w} f f' σ τ hc) (ComplexShape.up ℤ)).app C'
  let S' := ((E'.mapHomologicalComplex (ComplexShape.up ℤ)).obj C').sc n
  let y : S'.cycles := (S'.mapCyclesIso Rτ).hom (HomologicalComplex.cyclesMap φ n w)
  have hy : S'.iCycles y = (1 : B') ⊗ₜ[A',f'] K.iCycles zc' := by
    have h1 := map_iCycles_mapCyclesIso_hom_apply Rτ S' (HomologicalComplex.cyclesMap φ n w)
    have h2 := congrArg (fun g => g w) (HomologicalComplex.cyclesMap_i φ n)
    simp only [ConcreteCategory.comp_apply] at h2
    refine h1.trans ?_
    refine h2.trans ?_
    rw [hz']
    erw [hw]
    change (τ 1) ⊗ₜ[A',f'] _ = _
    rw [map_one]
  have L1 := extendScalarsHomologyIso_inv_tmul_homologyπ.{u, v, w} f hf
    ((Rσ.mapHomologicalComplex (ComplexShape.up ℤ)).obj C') n z 1 w hw
  have L2 := congrArg (fun g => g w) (HomologicalComplex.homologyπ_naturality φ n)
  have L3 := mapHomologyIso_hom_homologyπ_apply Rτ S' (HomologicalComplex.cyclesMap φ n w)
  have R1 := mapHomologyIso_hom_homologyπ_apply Rσ K z
  have R2 := extendScalarsHomologyIso_inv_tmul_homologyπ.{u, v, w} f' hf' C' n zc' 1 y hy
  simp only [ConcreteCategory.comp_apply] at L2 ⊢
  erw [L1, L2, L3]
  have R3 : (ModuleCat.restrictScalars τ).map (ModuleCat.extendScalarsHomologyIso f' hf' C' n).inv
      ((extendScalarsRestrictScalarsBaseChange.{u, v, w} f f' σ τ hc).app (C'.homology n)
        ((ModuleCat.extendScalars.{u, w, max u v} f).map
          ((C'.sc n).mapHomologyIso (ModuleCat.restrictScalars.{max u v} σ)).hom
          ((1 : B) ⊗ₜ[A,f] (K.map Rσ).homologyπ z))) =
      (ModuleCat.extendScalarsHomologyIso f' hf' C' n).inv
        ((τ 1) ⊗ₜ[A',f'] ((K.mapHomologyIso Rσ).hom ((K.map Rσ).homologyπ z))) := rfl
  have R4 : (ModuleCat.extendScalarsHomologyIso f' hf' C' n).inv
        ((τ 1) ⊗ₜ[A',f'] ((K.mapHomologyIso Rσ).hom ((K.map Rσ).homologyπ z))) =
      (((E'.mapHomologicalComplex (ComplexShape.up ℤ)).obj C').homologyπ n) y := by
    rw [R1, map_one]
    exact R2
  exact (R3.trans R4).symm

end RingSquare

open scoped TensorProduct

set_option backward.isDefEq.respectTransparency false in
private theorem extendScalars_map_smul {M N : ModuleCat.{v} A} (a : A) (φ : M ⟶ N) :
    (ModuleCat.extendScalars.{u, w, v} f).map (a • φ) =
      f a • (ModuleCat.extendScalars.{u, w, v} f).map φ := by
  apply ModuleCat.ExtendScalars.hom_ext
  intro m
  let : Module A B := Module.compHom B f
  change (1 : B) ⊗ₜ[A,f] (a • φ m) = (f a * 1) ⊗ₜ[A,f] φ m
  rw [← TensorProduct.smul_tmul]
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- The base change of homomorphisms, `B ⊗_A Hom_A(M, N) ⟶ Hom_B(B ⊗_A M, B ⊗_A N)`,
`b ⊗ φ ↦ b • (B ⊗ φ)`. -/
private noncomputable def extendScalarsHomBaseChange (M N : ModuleCat.{v} A) :
    (ModuleCat.extendScalars.{u, w, v} f).obj (ModuleCat.of A (M ⟶ N)) ⟶
      ModuleCat.of B ((ModuleCat.extendScalars.{u, w, v} f).obj M ⟶
        (ModuleCat.extendScalars.{u, w, v} f).obj N) := by
  let E := ModuleCat.extendScalars.{u, w, v} f
  let T := E.obj M ⟶ E.obj N
  letI : Module A T := Module.compHom T f
  let β : (ModuleCat.restrictScalars f).obj (ModuleCat.of B B) →ₗ[A] (M ⟶ N) →ₗ[A] T :=
    { toFun := fun b =>
        { toFun := fun φ => (show B from b) • E.map φ
          map_add' := fun φ ψ => by
            change (show B from b) • E.map (φ + ψ) = (show B from b) • E.map φ +
              (show B from b) • E.map ψ
            rw [E.map_add, smul_add]
          map_smul' := fun a φ => by
            change (show B from b) • E.map (a • φ) = f a • ((show B from b) • E.map φ)
            rw [extendScalars_map_smul, smul_comm] }
      map_add' := fun b₁ b₂ => by
        ext φ : 1
        change ((show B from b₁) + (show B from b₂)) • E.map φ =
          (show B from b₁) • E.map φ + (show B from b₂) • E.map φ
        rw [add_smul]
      map_smul' := fun a b => by
        ext φ : 1
        change (f a * (show B from b)) • E.map φ = f a • ((show B from b) • E.map φ)
        rw [mul_smul] }
  let X := E.obj (ModuleCat.of A (M ⟶ N))
  let Y := ModuleCat.of B T
  let ℓ : X → Y := fun x => TensorProduct.lift β x
  have hadd : ∀ x y : X, ℓ (x + y) = ℓ x + ℓ y := fun x y => map_add (TensorProduct.lift β) x y
  have hsmul : ∀ (b : B) (x : X), ℓ (b • x) = b • ℓ x := by
    intro b x
    induction x using TensorProduct.induction_on with
    | zero =>
      have h0 : ℓ 0 = 0 := map_zero (TensorProduct.lift β)
      rw [smul_zero, h0, smul_zero]
    | tmul b' φ =>
      have e : (b * (show B from b')) • E.map φ = b • ((show B from b') • E.map φ) := mul_smul _ _ _
      exact e
    | add x y hx hy =>
      rw [smul_add, hadd, hadd, hx, hy, smul_add]
  exact ModuleCat.ofHom (X := X) (Y := Y)
    { toFun := ℓ
      map_add' := hadd
      map_smul' := hsmul }

set_option backward.isDefEq.respectTransparency false in
private theorem isIso_extendScalarsHomBaseChange (hf : f.Flat) (M N : ModuleCat.{v} A)
    [Module.Free A M] [Module.Finite A M] :
    IsIso (extendScalarsHomBaseChange f M N) := by
  let := f.toAlgebra
  have : Module.Flat A B := hf
  have : Module.FinitePresentation A M := Module.finitePresentation_of_projective A M
  have hBC := Module.FinitePresentation.isBaseChange_map A M N B
  let e₀ : B ⊗[A] (M ⟶ N) ≃ₗ[A] B ⊗[A] (M →ₗ[A] N) :=
    TensorProduct.congr (LinearEquiv.refl A B) (ModuleCat.homLinearEquiv (S := A))
  let e₂ : (B ⊗[A] M →ₗ[B] B ⊗[A] N) ≃ (((ModuleCat.extendScalars.{u, w, v} f).obj M) ⟶
      ((ModuleCat.extendScalars.{u, w, v} f).obj N)) :=
    { toFun := fun g => ModuleCat.ofHom (X := (ModuleCat.extendScalars.{u, w, v} f).obj M)
        (Y := (ModuleCat.extendScalars.{u, w, v} f).obj N) g
      invFun := fun h => h.hom
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have key : ∀ x : B ⊗[A] (M ⟶ N),
      extendScalarsHomBaseChange f M N x = e₂ (hBC.equiv (e₀ x)) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero]; rfl
    | tmul b φ => rfl
    | add x y hx hy => rw [map_add, hx, hy, map_add, map_add]; rfl
  rw [ConcreteCategory.isIso_iff_bijective]
  have hb : Function.Bijective (fun x : B ⊗[A] (M ⟶ N) => e₂ (hBC.equiv (e₀ x))) :=
    e₂.bijective.comp (hBC.equiv.bijective.comp e₀.bijective)
  have h2 : (fun x : B ⊗[A] (M ⟶ N) => extendScalarsHomBaseChange f M N x) =
      fun x => e₂ (hBC.equiv (e₀ x)) := funext key
  change Function.Bijective (fun x : B ⊗[A] (M ⟶ N) => extendScalarsHomBaseChange f M N x)
  rw [h2]
  exact hb

set_option backward.isDefEq.respectTransparency false in
/-- The base change `B ⊗_A Hom_A(F, N) ⟶ Hom_B(B ⊗_A F, B ⊗_A N)` of the Hom complex of a
chain complex `F` into a module `N`, given in degree `i` by `b ⊗ φ ↦ b • (B ⊗ φ)`. -/
public noncomputable def linearHomComplexBaseChange (F : ChainComplex (ModuleCat.{v} A) ℤ)
    (N : ModuleCat.{v} A) :
    ((ModuleCat.extendScalars.{u, w, v} f).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((((linearYoneda A (ModuleCat.{v} A)).obj N).mapHomologicalComplex _).obj F.op :
          CochainComplex (ModuleCat.{v} A) ℤ) ⟶
      ((((linearYoneda B (ModuleCat.{max v w} B)).obj
        ((ModuleCat.extendScalars.{u, w, v} f).obj N)).mapHomologicalComplex _).obj
          (((ModuleCat.extendScalars.{u, w, v} f).mapHomologicalComplex
            (ComplexShape.down ℤ)).obj F).op : CochainComplex (ModuleCat.{max v w} B) ℤ) where
  f i := extendScalarsHomBaseChange f (F.X i) N
  comm' i j _ := by
    apply ModuleCat.ExtendScalars.hom_ext
    intro φ
    change (ModuleCat.extendScalars.{u, w, v} f).map (F.d j i) ≫
        ((1 : B) • (ModuleCat.extendScalars.{u, w, v} f).map φ) =
      (1 : B) • (ModuleCat.extendScalars.{u, w, v} f).map (F.d j i ≫ φ)
    rw [one_smul, one_smul, Functor.map_comp]

private theorem isIso_linearHomComplexBaseChange (hf : f.Flat)
    (F : ChainComplex (ModuleCat.{v} A) ℤ)
    (N : ModuleCat.{v} A) (hF : ∀ i, Module.Free A (F.X i) ∧ Module.Finite A (F.X i)) :
    IsIso (linearHomComplexBaseChange f F N) := by
  have : ∀ i, IsIso ((linearHomComplexBaseChange f F N).f i) := fun i => by
    have := (hF i).1
    have := (hF i).2
    exact isIso_extendScalarsHomBaseChange f hf (F.X i) N
  exact HomologicalComplex.Hom.isIso_of_components _

/-- The flat comparison at the Hom complex `Hom_A(F, N)`, followed by the base change of Hom
complexes, sends `b ⊗ [φ]` to the class of a cycle with image `b • (B ⊗ φ)`. -/
private theorem flatHomologyTensorComparison_linearHomComplex_apply (hf : f.Flat)
    (F : ChainComplex (ModuleCat.{max u v} A) ℤ) (N : ModuleCat.{max u v} A) (n : ℤ) :
    let E := ModuleCat.extendScalars.{u, w, max u v} f
    let HomA : CochainComplex (ModuleCat.{max u v} A) ℤ :=
      (((linearYoneda A (ModuleCat.{max u v} A)).obj N).mapHomologicalComplex _).obj F.op
    let HomB : CochainComplex (ModuleCat.{max u v w} B) ℤ :=
      (((linearYoneda B (ModuleCat.{max u v w} B)).obj (E.obj N)).mapHomologicalComplex
        _).obj ((E.mapHomologicalComplex (ComplexShape.down ℤ)).obj F).op
    ∀ (z : HomA.cycles n) (b : B) (y : HomB.cycles n),
      HomB.iCycles n y = b • E.map (show F.X n ⟶ N from HomA.iCycles n z) →
      ((flatHomologyTensorComparison.{u, v, w} f hf n).app (DerivedCategory.Q.obj HomA) ≫
          (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
            ((flatDerivedExtensionScalarsIso.{u, v, w} f hf).hom.app HomA ≫
              DerivedCategory.Q.map (linearHomComplexBaseChange f F N)) ≫
          (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).hom.app HomB)
        (b ⊗ₜ[A,f]
          (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).inv.app HomA
            (HomA.homologyπ n z)) =
        HomB.homologyπ n y := by
  intro E HomA HomB z b y hy
  let h := linearHomComplexBaseChange f F N
  let : PreservesFiniteLimits E :=
    ModuleCat.extendScalars_preservesFiniteLimits_of_flat f hf
  let : PreservesFiniteColimits E := ModuleCat.extendScalars_preservesFiniteColimits _
  let : E.PreservesHomology := Functor.preservesHomologyOfExact E
  let w : ((E.mapHomologicalComplex (ComplexShape.up ℤ)).obj HomA).cycles n :=
    ((HomA.sc n).mapCyclesIso E).inv (b ⊗ₜ[A,f] z)
  have hw : ((E.mapHomologicalComplex (ComplexShape.up ℤ)).obj HomA).iCycles n w =
      b ⊗ₜ[A,f] HomA.iCycles n z := by
    change ((HomA.sc n).map E).iCycles _ = _
    exact iCycles_mapCyclesIso_inv_apply E (HomA.sc n) _
  have s1 : E.map ((DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).hom.app HomA)
      (b ⊗ₜ[A,f]
        (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).inv.app HomA
          (HomA.homologyπ n z)) = b ⊗ₜ[A,f] HomA.homologyπ n z := by
    rw [ModuleCat.ExtendScalars.map_tmul]
    congr 1
    exact Iso.inv_hom_id_apply
      ((DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).app HomA) _
  have s2 := extendScalarsHomologyIso_inv_tmul_homologyπ.{u, v, w} f hf HomA n z b w hw
  have s3 := congrArg (fun g => g w) (HomologicalComplex.homologyπ_naturality h n)
  simp only [ConcreteCategory.comp_apply] at s3
  have s4 : HomologicalComplex.cyclesMap h n w = y := by
    have hmono : Function.Injective (HomB.iCycles n) :=
      (ModuleCat.mono_iff_injective _).1 inferInstance
    apply hmono
    have h6 := congrArg (fun g => g w) (HomologicalComplex.cyclesMap_i h n)
    simp only [ConcreteCategory.comp_apply] at h6
    refine h6.trans ?_
    erw [hw]
    exact hy.symm
  rw [flatHomologyTensorComparison_app_Q_comp.{u, v, w} f hf n HomA h]
  change HomologicalComplex.homologyMap h n ((ModuleCat.extendScalarsHomologyIso f hf
    HomA n).inv (E.map
      ((DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).hom.app HomA) _)) = _
  rw [s1]
  exact (congrArg (fun t => HomologicalComplex.homologyMap h n t) s2).trans
    (s3.trans (congrArg _ s4))

end CoefficientChange

/-- Let `A → B` be a flat local homomorphism of Noetherian local rings with `𝔪_A B = 𝔪_B`, and
let `K` be a normalized dualizing complex over `A`. Then the derived base change `K ⊗^L_A B` is a
normalized dualizing complex over `B`, `dim B = dim A`, and for `d = dim A` the comparison
`flatHomologyTensorComparison` is an isomorphism `ω_A ⊗_A B ≅ ω_B` of canonical modules,
`ω_A = H^{-d}(K)`, `ω_B = H^{-d}(K ⊗^L_A B)`. This comparison is induced by flat tensor on
complexes, is natural in the complexes and in coefficient rings, and commutes with the
finite-free Hom-complex calculations. -/
@[mmp "lem_mmp_foundation_normalized_canonical_flat_local_completion"]
public theorem canonicalModule_derivedExtensionScalars_iso_of_flat
    {A : Type u} {B : Type w} [CommRing A] [CommRing B] [Algebra A B]
    [Module.Flat A B] [IsNoetherianRing A] [IsNoetherianRing B]
    [IsLocalRing A] [IsLocalRing B] [IsLocalHom (algebraMap A B)]
    (hmax : (IsLocalRing.maximalIdeal A).map (algebraMap A B) = IsLocalRing.maximalIdeal B)
    (K : DerivedCategory (ModuleCat.{max u v} A))
    (hK : Dualizing.IsNormalizedDualizingComplex.{u, v} K) :
    Dualizing.IsNormalizedDualizingComplex.{w, max u v}
        ((StacksDraft.PseudoCoherence.derivedExtensionScalars.{max u v, u, w}
          (algebraMap A B)).obj K) ∧
      ringKrullDim B = ringKrullDim A ∧
      -- the canonical-module comparison `ω_A ⊗_A B ⟶ ω_B` is an isomorphism
      (∀ d : ℕ, ringKrullDim A = d →
        IsIso ((flatHomologyTensorComparison.{u, v, w} (algebraMap A B)
          (RingHom.flat_algebraMap_iff.mpr inferInstance) (-(d : ℤ))).app K)) ∧
      -- it is induced by flat tensor on complexes
      (∀ (n : ℤ) (C : CochainComplex (ModuleCat.{max u v} A) ℤ),
        (flatHomologyTensorComparison.{u, v, w} (algebraMap A B)
            (RingHom.flat_algebraMap_iff.mpr inferInstance) n).app (DerivedCategory.Q.obj C) =
          (ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)).map
              ((DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).hom.app C) ≫
            (ModuleCat.extendScalarsHomologyIso (algebraMap A B)
              (RingHom.flat_algebraMap_iff.mpr inferInstance) C n).inv ≫
            (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).inv.app
              (((ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)).mapHomologicalComplex
                (ComplexShape.up ℤ)).obj C) ≫
            (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
              ((flatDerivedExtensionScalarsIso.{u, v, w} (algebraMap A B)
                (RingHom.flat_algebraMap_iff.mpr inferInstance)).inv.app C)) ∧
      (∀ (n : ℤ) (C : CochainComplex (ModuleCat.{max u v} A) ℤ) (z : C.cycles n) (b : B)
        (y : (((ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj C).cycles n),
        (((ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj C).iCycles n y = b ⊗ₜ[A,algebraMap A B] C.iCycles n z →
        (ModuleCat.extendScalarsHomologyIso (algebraMap A B)
            (RingHom.flat_algebraMap_iff.mpr inferInstance) C n).inv
            (b ⊗ₜ[A,algebraMap A B] C.homologyπ n z) =
          (((ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj C).homologyπ n y) ∧
      -- it is natural in the complexes
      (∀ (n : ℤ) {K₁ K₂ : DerivedCategory (ModuleCat.{max u v} A)} (g : K₁ ⟶ K₂),
        (ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)).map
            ((DerivedCategory.homologyFunctor (ModuleCat.{max u v} A) n).map g) ≫
          (flatHomologyTensorComparison.{u, v, w} (algebraMap A B)
            (RingHom.flat_algebraMap_iff.mpr inferInstance) n).app K₂ =
        (flatHomologyTensorComparison.{u, v, w} (algebraMap A B)
            (RingHom.flat_algebraMap_iff.mpr inferInstance) n).app K₁ ≫
          (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
            ((StacksDraft.PseudoCoherence.derivedExtensionScalars.{max u v, u, w}
              (algebraMap A B)).map g)) ∧
      -- it is natural in the coefficient rings
      (∀ (A' : Type u) (B' : Type w) [CommRing A'] [CommRing B'] (f' : A' →+* B')
        (hf' : f'.Flat) (σ : A →+* A') (τ : B →+* B') (hc : τ.comp (algebraMap A B) = f'.comp σ)
        (C' : CochainComplex (ModuleCat.{max u v} A') ℤ) (n : ℤ),
        (ModuleCat.extendScalarsHomologyIso (algebraMap A B)
            (RingHom.flat_algebraMap_iff.mpr inferInstance)
            (((ModuleCat.restrictScalars.{max u v} σ).mapHomologicalComplex
              (ComplexShape.up ℤ)).obj C') n).inv ≫
          HomologicalComplex.homologyMap
            ((NatTrans.mapHomologicalComplex
              (extendScalarsRestrictScalarsBaseChange.{u, v, w} (algebraMap A B) f' σ τ hc)
                (ComplexShape.up ℤ)).app C') n ≫
          (((((ModuleCat.extendScalars.{u, w, max u v} f').mapHomologicalComplex
              (ComplexShape.up ℤ)).obj C').sc n).mapHomologyIso
                (ModuleCat.restrictScalars τ)).hom =
        (ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)).map
            ((C'.sc n).mapHomologyIso (ModuleCat.restrictScalars.{max u v} σ)).hom ≫
          (extendScalarsRestrictScalarsBaseChange.{u, v, w} (algebraMap A B) f' σ τ hc).app
            (C'.homology n) ≫
          (ModuleCat.restrictScalars τ).map (ModuleCat.extendScalarsHomologyIso f' hf' C' n).inv) ∧
      -- it commutes with the finite-free Hom-complex (ambient Ext) calculations
      (∀ (F : ChainComplex (ModuleCat.{max u v} A) ℤ) (N : ModuleCat.{max u v} A),
        (∀ i, Module.Free A (F.X i) ∧ Module.Finite A (F.X i)) →
        let E := ModuleCat.extendScalars.{u, w, max u v} (algebraMap A B)
        let HomA : CochainComplex (ModuleCat.{max u v} A) ℤ :=
          (((linearYoneda A (ModuleCat.{max u v} A)).obj N).mapHomologicalComplex _).obj F.op
        let HomB : CochainComplex (ModuleCat.{max u v w} B) ℤ :=
          (((linearYoneda B (ModuleCat.{max u v w} B)).obj (E.obj N)).mapHomologicalComplex
            _).obj ((E.mapHomologicalComplex (ComplexShape.down ℤ)).obj F).op
        IsIso (linearHomComplexBaseChange (algebraMap A B) F N) ∧
        ∀ (n : ℤ) (z : HomA.cycles n) (b : B) (y : HomB.cycles n),
          HomB.iCycles n y = b • E.map (show F.X n ⟶ N from HomA.iCycles n z) →
          ((flatHomologyTensorComparison.{u, v, w} (algebraMap A B)
                (RingHom.flat_algebraMap_iff.mpr inferInstance) n).app
                (DerivedCategory.Q.obj HomA) ≫
              (DerivedCategory.homologyFunctor (ModuleCat.{max u v w} B) n).map
                ((flatDerivedExtensionScalarsIso.{u, v, w} (algebraMap A B)
                  (RingHom.flat_algebraMap_iff.mpr inferInstance)).hom.app HomA ≫
                  DerivedCategory.Q.map (linearHomComplexBaseChange (algebraMap A B) F N)) ≫
              (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v w} B) n).hom.app HomB)
            (b ⊗ₜ[A,algebraMap A B]
              (DerivedCategory.homologyFunctorFactors (ModuleCat.{max u v} A) n).inv.app HomA
                (HomA.homologyπ n z)) =
          HomB.homologyπ n y) := by
  have hf : (algebraMap A B).Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  let U := ModuleCat.uliftFunctor.{max u w, max u v} A
  let D := CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, w, max u v}
    (algebraMap A B)
  let := additive_extendScalars.{u, max u v, w} (algebraMap A B)
  let := ModuleCat.extendScalars_preservesFiniteLimits_of_flat.{u, w, max u v w}
    (algebraMap A B) hf
  have := isLeftAdjoint_extendScalars.{u, max u v, w} (algebraMap A B)
  let G := ModuleCat.extendScalars.{u, w, max u v w} (algebraMap A B)
  let e : (StacksDraft.PseudoCoherence.derivedExtensionScalars.{max u v, u, w}
      (algebraMap A B)).obj K ≅ G.mapDerivedCategory.obj (U.mapDerivedCategory.obj K) :=
    (totalDerivedIsoMapDerivedCategory.{u, max u v, w} (algebraMap A B) hf D).app _
  refine ⟨?_, ?_, fun d _ => ?_, fun n C => ?_, fun n C z b y hy => ?_, fun n K₁ K₂ g => ?_,
    fun A' B' _ _ f' hf' σ τ hc C' n => ?_, fun F N hF => ?_⟩
  · exact isNormalizedDualizingComplex_of_iso.{w, max u v} e.symm
      (isNormalizedDualizingComplex_extendScalars_uliftFunctor.{u, v, w} hmax K hK)
  · exact ringKrullDim_eq_of_flat_of_map_maximalIdeal_eq hmax
  · have := isIso_flatHomologyTensorComparison.{u, v, w} (algebraMap A B) hf (-(d : ℤ))
    infer_instance
  · exact flatHomologyTensorComparison_app_Q.{u, v, w} (algebraMap A B) hf n C
  · exact extendScalarsHomologyIso_inv_tmul_homologyπ.{u, v, w} (algebraMap A B) hf C n z b y hy
  · exact (flatHomologyTensorComparison.{u, v, w} (algebraMap A B) hf n).naturality g
  · exact extendScalarsHomologyIso_inv_extendScalarsRestrictScalarsBaseChange.{u, v, w}
      (algebraMap A B) f' σ τ hf hf' hc C' n
  intro E HomA HomB
  exact ⟨isIso_linearHomComplexBaseChange (algebraMap A B) hf F N hF,
    fun n => flatHomologyTensorComparison_linearHomComplex_apply.{u, v, w} (algebraMap A B) hf F N
      n⟩

end MMP

end FlatLocalCanonicalModule

section RelativeAmpleProj

open CategoryTheory AlgebraicGeometry Opposite RingedSpaceModuleAdjunction

namespace MMP

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

open Stacks.GradedSections (powSections sectionRing)

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- The canonical morphism `X ⟶ Proj Γ_*(X, L)` pulls a function on `D₊(a)` back to its image
under the chart ring map, read on the nonvanishing open `X_a`. -/
private theorem projHomOfIsAmple_app_awayToSection (hL : Stacks.Ample.IsAmple X L) {d : ℕ}
    (a : powSections L d) (hd : 0 < d)
    (x : HomogeneousLocalization.Away (Stacks.AmpleFiniteAvoidance.grading L)
      (DirectSum.of (powSections L) d a)) :
    X.presheaf.map
        (eqToHom (Stacks.SectionRingProjMorphism.projHomOfIsAmple_preimage_projBasicOpen
          L hL a hd).symm).op
      ((Stacks.SectionRingProjMorphism.projHomOfIsAmple L hL).app _
        (Proj.awayToSection _ (DirectSum.of _ d a) x)) =
      Stacks.SectionRingChartMap.chartRingMap L a le_rfl x := by
  have happ := congrArg (fun φ => φ.hom x)
    (Stacks.SectionRingProjQuasicoherent.awayToSection_comp_projHomOfIsAmple_app L hL a hd)
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at happ
  rw [happ, ← CommRingCat.comp_apply, ← Functor.map_comp, ← op_comp, eqToHom_trans,
    eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
  rfl

/-- The chart ring map at `a` sends the fraction `b / a` to the ratio of sections `b / a`. -/
private theorem chartRingMap_mk_one {d : ℕ} (a b : powSections L d) :
    Stacks.SectionRingChartMap.chartRingMap L a le_rfl
        (HomogeneousLocalization.Away.mk _ (Stacks.ExternalGrading.of_mem_summand d a) 1
          (DirectSum.of _ d b) (by simpa using Stacks.ExternalGrading.of_mem_summand d b)) =
      Stacks.SectionRingChartMap.ratio L a le_rfl b := by
  rw [Stacks.SectionRingChartMap.chartRingMap_mk, Stacks.SectionRingChartMap.chartFamily_apply,
    Stacks.SectionRingChartMap.numMapR_of_mul L a le_rfl 1 le_rfl (Nat.le_add_left 1 1)
      (by simpa using Stacks.ExternalGrading.of_mem_summand d b),
    Stacks.SectionRingChartMap.numMapR_def,
    Stacks.SectionRingChartMap.ratioR_congr L (Nat.mul_one d) _ a _ le_rfl
      (by simpa using Stacks.SectionRingChartMap.of_powSec_eq_pow L a 1),
    Stacks.SectionRingChartMap.ratioR_of]

/-- Over an affine open `V` of a locally Noetherian base, the section ring of the restriction
of an ample invertible module to `g⁻¹(V)` along a proper `g` is generated, as a ring, by the
image of `Γ(Y, V)` in degree zero and finitely many further elements (Stacks Tag 0B5T). -/
public theorem exists_finset_closure_sectionRing_eq_top_of_isProper {Z Y : Scheme.{u}}
    (g : Z ⟶ Y) [IsProper g] [IsLocallyNoetherian Y] (L : Z.Modules)
    [Stacks.Ample.IsInvertibleModule Z L] {V : Y.Opens} (hV : IsAffineOpen V) :
    let M : (g ⁻¹ᵁ V).toScheme.Modules := (modulePullback (g ⁻¹ᵁ V).ι.toLRSHom.toShHom).obj L
    Stacks.Ample.IsAmple (g ⁻¹ᵁ V).toScheme M →
    ∃ G : Finset (sectionRing M),
      Subring.closure (Set.range (fun a : Γ(Y, V) =>
          DirectSum.of (powSections M) 0
            ((Stacks.SectionRingGeometric.unitScalarEquiv (g ⁻¹ᵁ V).toScheme).symm
              ((g ⁻¹ᵁ V).topIso.inv (g.app V a)))) ∪ ↑G) = ⊤ := by
  intro M hM
  let f : (g ⁻¹ᵁ V).toScheme ⟶ Spec Γ(Y, V) := (g ∣_ V) ≫ hV.isoSpec.hom
  have : IsNoetherianRing Γ(Y, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  let := Stacks.SectionRingGeometric.schemeSectionCommRing (g ⁻¹ᵁ V).toScheme M
  let : Algebra Γ(Y, V) (sectionRing M) := RingHom.toAlgebra
    ((Stacks.SectionRingZero.sectionRingZeroHom _ M).comp
      (Stacks.AlgebraicGeometry.GradedProperCohomology.specAlgebraRingHom Γ(Y, V) f))
  obtain ⟨G, hG⟩ :=
    (Stacks.AlgebraicGeometry.ProperAmpleCohomology.ringHomFiniteType_sectionRing f M hM).out
  refine ⟨G, (?_ : _ = (Algebra.adjoin Γ(Y, V) (G : Set (sectionRing M))).toSubring).trans
    ((congrArg Subalgebra.toSubring hG).trans Algebra.top_toSubring)⟩
  have hbase : (Scheme.ΓSpecIso Γ(Y, V)).inv ≫ f.appTop = g.app V ≫ (g ⁻¹ᵁ V).topIso.inv := by
    rw [Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_hom_appTop,
      ← Scheme.Hom.resLE_eq_morphismRestrict, Scheme.Hom.appTop, Scheme.Hom.resLE_app_top]
    simp only [Category.assoc, Iso.inv_hom_id_assoc, Scheme.Hom.app_eq_appLE]
  have hfun : (fun a : Γ(Y, V) => DirectSum.of (powSections M) 0
      ((Stacks.SectionRingGeometric.unitScalarEquiv (g ⁻¹ᵁ V).toScheme).symm
        ((g ⁻¹ᵁ V).topIso.inv (g.app V a)))) = ⇑(algebraMap Γ(Y, V) (sectionRing M)) := by
    funext a
    change _ = DirectSum.of (powSections M) 0
      ((Stacks.SectionRingGeometric.unitScalarAddEquiv _).symm
        (((Scheme.ΓSpecIso Γ(Y, V)).inv ≫ f.appTop).hom a))
    rw [hbase]
    rfl
  rw [Algebra.adjoin_eq_ring_closure, ← hfun]

/-- For a proper `g : Z ⟶ Y` over a locally Noetherian base and a `g`-ample invertible
`𝒪_Z`-module `L`, over every affine open `V ⊆ Y` the section ring of the restriction of `L` to
`g⁻¹(V)` is generated, as a ring, by the image of `Γ(Y, V)` in degree zero and finitely many
further elements. -/
public theorem exists_finset_closure_sectionRing_eq_top_of_isRelativelyAmple {Z Y : Scheme.{u}}
    (g : Z ⟶ Y) [IsProper g] [IsLocallyNoetherian Y] (L : Z.Modules)
    [Stacks.Ample.IsInvertibleModule Z L] (hL : MMP.Mori.IsRelativelyAmple g L)
    {V : Y.Opens} (hV : IsAffineOpen V) :
    let M : (g ⁻¹ᵁ V).toScheme.Modules := (modulePullback (g ⁻¹ᵁ V).ι.toLRSHom.toShHom).obj L
    ∃ G : Finset (sectionRing M),
      Subring.closure (Set.range (fun a : Γ(Y, V) =>
          DirectSum.of (powSections M) 0
            ((Stacks.SectionRingGeometric.unitScalarEquiv (g ⁻¹ᵁ V).toScheme).symm
              ((g ⁻¹ᵁ V).topIso.inv (g.app V a)))) ∪ ↑G) = ⊤ :=
  exists_finset_closure_sectionRing_eq_top_of_isProper g L hV
    ((Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple g L
      inferInstance hL).2 V hV)
/-- **An ample section algebra is of finite type and recovers the proper source.** Let
`g : Z ⟶ Y` be a proper morphism of varieties over `k` and `L` an invertible `𝒪_Z`-module which
is `g`-ample. For every affine open `V ⊆ Y`, writing `M` for the restriction of `L` to `g⁻¹(V)`
and `R = ⨁_{m ≥ 0} Γ(g⁻¹(V), M^{⊗ m})`:

* `R` is generated over the image of `Γ(Y, V)` in degree zero by finitely many elements;
* `M` is ample, and the canonical morphism `φ : g⁻¹(V) ⟶ Proj R` is an isomorphism;
* for `n > 0` and sections `s, b` of `M^{⊗ n}`, `φ⁻¹(D₊(s))` is the nonvanishing open of `s`,
  and `φ` pulls the degree-zero fraction `b / s` back to the ratio `b / s` of sections. -/
@[mmp "lem_mmp_foundation_relative_ample_section_proj_recovery"]
public theorem isIso_projHomOfIsAmple_of_isProper (k : Type u) [Field k] {Z Y : Scheme.{u}}
    (sZ : Z ⟶ Spec (.of k)) (sY : Y ⟶ Spec (.of k)) (_hZ : MMP.Mori.IsVariety k sZ)
    (hY : MMP.Mori.IsVariety k sY) (g : Z ⟶ Y) (_hg : g ≫ sY = sZ) [IsProper g]
    (L : Z.Modules) [Stacks.Ample.IsInvertibleModule Z L] (hL : MMP.Mori.IsRelativelyAmple g L)
    (V : Y.Opens) (hV : IsAffineOpen V) :
    let M : (g ⁻¹ᵁ V).toScheme.Modules := (modulePullback (g ⁻¹ᵁ V).ι.toLRSHom.toShHom).obj L
    (∃ G : Finset (sectionRing M),
      Subring.closure (Set.range (fun a : Γ(Y, V) =>
          DirectSum.of (powSections M) 0
            ((Stacks.SectionRingGeometric.unitScalarEquiv (g ⁻¹ᵁ V).toScheme).symm
              ((g ⁻¹ᵁ V).topIso.inv (g.app V a)))) ∪ ↑G) = ⊤) ∧
    ∃ hM : Stacks.Ample.IsAmple (g ⁻¹ᵁ V).toScheme M,
      IsIso (Stacks.SectionRingProjMorphism.projHomOfIsAmple M hM) ∧
      ∀ (n : ℕ) (_ : 0 < n) (s b : powSections M n),
        ∃ h : Stacks.SectionRingProjMorphism.projHomOfIsAmple M hM ⁻¹ᵁ
            Proj.basicOpen _ (DirectSum.of _ n s) = Stacks.AmpleFiniteAvoidance.nvOpen M s,
          (g ⁻¹ᵁ V).toScheme.presheaf.map (eqToHom h.symm).op
              ((Stacks.SectionRingProjMorphism.projHomOfIsAmple M hM).app _
                (Proj.awayToSection _ (DirectSum.of _ n s)
                  (HomogeneousLocalization.Away.mk _ ⟨s, rfl⟩ 1 (DirectSum.of _ n b)
                    (by simpa using ⟨b, rfl⟩)))) =
            Stacks.SectionRingChartMap.ratio M s le_rfl b := by
  intro M
  have hM : Stacks.Ample.IsAmple (g ⁻¹ᵁ V).toScheme M :=
    (Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple g L
      inferInstance hL).2 V hV
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  exact ⟨exists_finset_closure_sectionRing_eq_top_of_isProper g L hV hM, hM,
    Stacks.SectionRingProjIso.isIso_projHomOfIsAmple_of_isProper M hM ((g ∣_ V) ≫ hV.isoSpec.hom),
    fun n hn s b => ⟨Stacks.SectionRingProjMorphism.projHomOfIsAmple_preimage_projBasicOpen
      M hM s hn, (projHomOfIsAmple_app_awayToSection M hM s hn _).trans
        (chartRingMap_mk_one M s b)⟩⟩

end MMP

end RelativeAmpleProj

section RelativeSemiampleSectionAlgebra

open CategoryTheory MonoidalCategory AlgebraicGeometry
open Stacks.GradedSections Stacks.TensorPowers

namespace MMP

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

attribute [local implicit_reducible] Stacks.TensorPowers.natTensorPow

/-- Relative semiampleness of `L` over `S`: every point of `S` has an open neighbourhood `U` over
which some positive power `L^{⊗ d}` has its sections over `f⁻¹U` generating every stalk. -/
private abbrev IsRelSemiample {Y S : Scheme.{u}} (f : Y ⟶ S) (L : Y.Modules) : Prop :=
  ∀ s : S, ∃ U : S.Opens, s ∈ U ∧ ∃ d : ℕ, 0 < d ∧ ∀ y ∈ f ⁻¹ᵁ U,
    ∃ t : Γ(natTensorPow L d, f ⁻¹ᵁ U),
      y ∈ Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn (natTensorPow L d) (f ⁻¹ᵁ U) t

/-- The structure map `Γ(S, U) → Γ(f⁻¹U, ⊤)` of the open subscheme `f⁻¹U` over `Γ(S, U)`. -/
private noncomputable def baseMap {Y S : Scheme.{u}} (f : Y ⟶ S) (U : S.Opens) :
    Γ(S, U) →+* Γ((f ⁻¹ᵁ U).toScheme, ⊤) :=
  (f ⁻¹ᵁ U).topIso.inv.hom.comp (f.app U).hom

/-- `baseMap f U` is the structure map of `f⁻¹U ⟶ U ≅ Spec Γ(S, U)` on global sections. -/
private theorem specAlgebraRingHom_eq_baseMap {Y S : Scheme.{u}} (f : Y ⟶ S) (U : S.Opens)
    (hU : IsAffineOpen U) :
    Stacks.AlgebraicGeometry.GradedProperCohomology.specAlgebraRingHom Γ(S, U)
      ((f ∣_ U) ≫ hU.isoSpec.hom) = baseMap f U := by
  have h : (Scheme.ΓSpecIso Γ(S, U)).inv ≫ ((f ∣_ U) ≫ hU.isoSpec.hom).appTop =
      f.app U ≫ (f ⁻¹ᵁ U).topIso.inv := by
    rw [Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_hom_appTop, Category.assoc,
      Iso.inv_hom_id_assoc, Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv,
      morphismRestrict_appTop,
      Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
    simp only [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    erw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  exact congrArg CommRingCat.Hom.hom h

/-- Each `Γ(f⁻¹U, L^{⊗ q})` is spanned over `Γ(S, U)` by a finite set, for proper `f`: the
direct image of the coherent `L^{⊗ q}` along the proper `f⁻¹U ⟶ Spec Γ(S, U)` is coherent. -/
private theorem exists_finset_eq_sum_baseMap {Y S : Scheme.{u}} (f : Y ⟶ S) [IsProper f]
    [IsLocallyNoetherian S] (L : Y.Modules) (U : S.Opens) (hU : IsAffineOpen U)
    [Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι)] (q : ℕ) :
    ∃ t : Finset (powSections (L.restrict (f ⁻¹ᵁ U).ι) q),
      ∀ u : powSections (L.restrict (f ⁻¹ᵁ U).ι) q,
        ∃ c : powSections (L.restrict (f ⁻¹ᵁ U).ι) q → Γ(S, U),
          u = ∑ y ∈ t, baseMap f U (c y) • y := by
  have : IsNoetherianRing Γ(S, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  have : IsLocallyNoetherian (Spec Γ(S, U)) := isLocallyNoetherian_Spec.mpr inferInstance
  have : IsLocallyNoetherian (f ⁻¹ᵁ U).toScheme :=
    LocallyOfFiniteType.isLocallyNoetherian ((f ∣_ U) ≫ hU.isoSpec.hom)
  have : (natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) q).IsCoherent := by
    rw [← Stacks.SectionRingProjTheta.twistPow_unit (L.restrict (f ⁻¹ᵁ U).ι) q]
    exact Stacks.AlgebraicGeometry.ProperAmpleCohomology.isCoherent_twistPow _ _
      (Stacks.AlgebraicGeometry.ProperAmpleCohomology.isCoherent_tensorUnit _) q
  obtain ⟨t, ht⟩ := Stacks.AlgebraicGeometry.ProperAmpleCohomology.exists_finset_eq_sum_base
    (R := Γ(S, U)) ((f ∣_ U) ≫ hU.isoSpec.hom) (natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) q)
  refine ⟨t, fun u => ?_⟩
  obtain ⟨c, hc⟩ := ht u
  exact ⟨c, by rw [hc, specAlgebraRingHom_eq_baseMap]⟩

/-- The degree of the `k`-th iterated power, `d * (k + 1)`, with the recursion of the product. -/
private def powDeg (d : ℕ) : ℕ → ℕ
  | 0 => d
  | k + 1 => d + powDeg d k

private theorem powDeg_eq (d : ℕ) : ∀ k, powDeg d k = d * (k + 1)
  | 0 => by simp [powDeg]
  | k + 1 => by rw [powDeg, powDeg_eq d k]; ring

/-- The `(k + 1)`-st power of a section, by iterated multiplication. -/
private noncomputable def sectionPow {X : Scheme.{u}} (L : X.Modules) {d : ℕ}
    (t : powSections L d) : (k : ℕ) → powSections L (powDeg d k)
  | 0 => t
  | k + 1 => mul t (sectionPow L t k)

private theorem nonvanishingLocus_sectionPow {X : Scheme.{u}} (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] {d : ℕ} (t : powSections L d) :
    ∀ k, Stacks.Ample.nonvanishingLocus (natTensorPow L (powDeg d k))
        (Stacks.SectionProduct.globalSection X _ (sectionPow L t k)) =
      Stacks.Ample.nonvanishingLocus (natTensorPow L d)
        (Stacks.SectionProduct.globalSection X _ t)
  | 0 => rfl
  | k + 1 => by
    change Stacks.Ample.nonvanishingLocus (natTensorPow L (d + powDeg d k))
        (Stacks.SectionProduct.globalSection X _ (mul t (sectionPow L t k))) = _
    rw [Stacks.SectionProduct.nonvanishingLocus_mul,
      nonvanishingLocus_sectionPow L t k, Set.inter_self]

private theorem nonvanishingLocus_cast {X : Scheme.{u}} (L : X.Modules) {a b : ℕ} (h : a = b)
    (t : powSections L a) :
    Stacks.Ample.nonvanishingLocus (natTensorPow L b)
        (Stacks.SectionProduct.globalSection X _ (h ▸ t)) =
      Stacks.Ample.nonvanishingLocus (natTensorPow L a)
        (Stacks.SectionProduct.globalSection X _ t) := by
  subst h
  rfl

/-- On a quasi-compact scheme, if every point lies in the nonvanishing locus of a section of some
positive tensor power of `L`, then finitely many sections of one positive power do. -/
private theorem exists_common_degree {X : Scheme.{u}} [CompactSpace X] (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L]
    (h : ∀ x : X, ∃ d : ℕ, 0 < d ∧ ∃ t : powSections L d,
      x ∈ Stacks.Ample.nonvanishingLocus (natTensorPow L d)
        (Stacks.SectionProduct.globalSection X _ t)) :
    ∃ D : ℕ, 0 < D ∧ ∃ (n : ℕ) (s : Fin n → powSections L D), ∀ x : X, ∃ i,
      x ∈ Stacks.Ample.nonvanishingLocus (natTensorPow L D)
        (Stacks.SectionProduct.globalSection X _ (s i)) := by
  classical
  choose d hd t ht using h
  obtain ⟨F, hF⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X => Stacks.Ample.nonvanishingLocus (natTensorPow L (d x))
      (Stacks.SectionProduct.globalSection X _ (t x)))
    (fun x => Stacks.NonvanishingOpen.isOpen_nonvanishingLocus X _ _)
    (fun x _ => Set.mem_iUnion.mpr ⟨x, ht x⟩)
  set D := ∏ x ∈ F, d x with hD
  have hDpos : 0 < D := Finset.prod_pos fun x _ => hd x
  have hdvd : ∀ x ∈ F, d x ∣ D := fun x hx => Finset.dvd_prod_of_mem _ hx
  have hk : ∀ x ∈ F, powDeg (d x) (D / d x - 1) = D := fun x hx => by
    rw [powDeg_eq, Nat.sub_add_cancel (Nat.div_pos (Nat.le_of_dvd hDpos (hdvd x hx)) (hd x)),
      Nat.mul_div_cancel' (hdvd x hx)]
  refine ⟨D, hDpos, F.card, fun i => ?_, fun y => ?_⟩
  · let x := (F.equivFin.symm i : X)
    exact hk x (F.equivFin.symm i).2 ▸ sectionPow L (t x) (D / d x - 1)
  · obtain ⟨x, hxF, hyx⟩ := Set.mem_iUnion₂.mp (hF (Set.mem_univ y))
    refine ⟨F.equivFin ⟨x, hxF⟩, ?_⟩
    rw [nonvanishingLocus_cast, nonvanishingLocus_sectionPow]
    generalize hz : F.equivFin.symm (F.equivFin ⟨x, hxF⟩) = z
    rw [Equiv.symm_apply_apply] at hz
    subst hz
    exact hyx

open Stacks.NonvanishingLocusRestrict in
/-- Near a point `y` of `f⁻¹U`, a section of some positive power of `L` over the neighbourhood
given by `hL` becomes, after multiplication by a power of a function `a` on `U` with
`f y ∈ D(a)`, the restriction of a section over all of `f⁻¹U`, still nonvanishing at `y`. -/
private theorem exists_section_over_preimage {Y S : Scheme.{u}} (f : Y ⟶ S) [QuasiCompact f]
    [QuasiSeparated f] (L : Y.Modules) [Stacks.Ample.IsInvertibleModule Y L]
    (hL : IsRelSemiample f L) (U : S.Opens) (hU : IsAffineOpen U) (y : Y)
    (hy : y ∈ f ⁻¹ᵁ U) :
    ∃ d : ℕ, 0 < d ∧ ∃ e : Γ(natTensorPow L d, f ⁻¹ᵁ U),
      y ∈ nonvanishingLocusOn (natTensorPow L d) (f ⁻¹ᵁ U) e := by
  obtain ⟨V, hyV, d, hd, hV⟩ := hL (f.base y)
  obtain ⟨t, ht⟩ := hV y hyV
  obtain ⟨a, haV, hya⟩ := hU.exists_basicOpen_le (V := V) ⟨f.base y, hyV⟩ hy
  set g : Γ(Y, f ⁻¹ᵁ U) := f.app U a
  have hbo : Y.basicOpen g = f ⁻¹ᵁ S.basicOpen a := (Scheme.preimage_basicOpen f a).symm
  have hWV : Y.basicOpen g ≤ f ⁻¹ᵁ V := fun z hz => haV (by rw [hbo] at hz; exact hz)
  have hyg : y ∈ Y.basicOpen g := by rw [hbo]; exact hya
  have hc : IsCompact ((f ⁻¹ᵁ U : Y.Opens) : Set Y) :=
    QuasiCompact.isCompact_preimage (f := f) _ U.2 hU.isCompact
  have hqs : IsQuasiSeparated ((f ⁻¹ᵁ U : Y.Opens) : Set Y) :=
    f.isQuasiSeparated_preimage hU.isQuasiSeparated
  obtain ⟨k, e, he⟩ :=
    Stacks.AlgebraicGeometry.QcqsLocalization.exists_eq_pow_smul_of_isCompact_of_isQuasiSeparated
      (natTensorPow L d) hc hqs g ((natTensorPow L d).presheaf.map (homOfLE hWV).op t)
  refine ⟨d, hd, e, (mem_nonvanishingLocusOn_iff _ _ hy).mpr ?_⟩
  rw [← TopCat.Presheaf.germ_res_apply (C := Ab.{u}) (natTensorPow L d).presheaf
    (homOfLE (Y.basicOpen_le g)) y hyg, he, Stacks.ModuleStalk.germ_smul,
    Stacks.ModuleStalk.smul_mem_maximalSmul_iff, not_or, not_not,
    TopCat.Presheaf.germ_res_apply (C := Ab.{u})]
  refine ⟨?_, ht.2⟩
  rw [map_pow]
  exact (IsUnit.map (Y.presheaf.germ (Y.basicOpen g) y hyg).hom
    (Y.toRingedSpace.isUnit_res_basicOpen g)).pow k

/-- Every point of `f⁻¹U` lies in the nonvanishing locus of a global section of some positive
power of the restriction of `L` to `f⁻¹U`. -/
private theorem exists_powSections_restrict_at {Y S : Scheme.{u}} (f : Y ⟶ S) [QuasiCompact f]
    [QuasiSeparated f] (L : Y.Modules) [Stacks.Ample.IsInvertibleModule Y L]
    (hL : IsRelSemiample f L) (U : S.Opens) (hU : IsAffineOpen U)
    [Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι)]
    (x : (f ⁻¹ᵁ U).toScheme) :
    ∃ d : ℕ, 0 < d ∧ ∃ t : powSections (L.restrict (f ⁻¹ᵁ U).ι) d,
      x ∈ Stacks.Ample.nonvanishingLocus (natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) d)
        (Stacks.SectionProduct.globalSection _ _ t) := by
  obtain ⟨d, hd, e, he⟩ := exists_section_over_preimage f L hL U hU ((f ⁻¹ᵁ U).ι.base x) x.2
  let eIso : (Scheme.Modules.pullback (f ⁻¹ᵁ U).ι).obj L ≅ L.restrict (f ⁻¹ᵁ U).ι :=
    ((Scheme.Modules.restrictFunctorIsoPullback (f ⁻¹ᵁ U).ι).app L).symm
  let σ' := Stacks.AlgebraicGeometry.ProjChartRatioPullbackLocalMul.restrictPowSection L
    (f ⁻¹ᵁ U) d e
  let σ := (Stacks.AmplePullbackPart1.natTensorPowCongr eIso d).hom.app ⊤ σ'
  refine ⟨d, hd, (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv _ _).symm σ, ?_⟩
  change x ∈ Stacks.Ample.nonvanishingLocus _
    (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv _ _
      ((Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv _ _).symm σ))
  rw [AddEquiv.apply_symm_apply, Stacks.Ample.nonvanishingLocus_congr]
  exact (iff_of_eq (congrArg (x ∈ ·)
    (Stacks.AlgebraicGeometry.ProjChartRatioPullbackLocalMul.nonvanishingOpen_restrictPowSection
      L (f ⁻¹ᵁ U) d e))).mpr he

/-- Some positive power of the restriction of `L` to `f⁻¹U` is generated by finitely
many global sections: their nonvanishing loci cover `f⁻¹U`. -/
private theorem exists_covering_powSections_restrict {Y S : Scheme.{u}} (f : Y ⟶ S)
    [QuasiCompact f] [QuasiSeparated f] (L : Y.Modules) [Stacks.Ample.IsInvertibleModule Y L]
    (hL : IsRelSemiample f L) (U : S.Opens) (hU : IsAffineOpen U)
    [Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι)] :
    ∃ D : ℕ, 0 < D ∧ ∃ (n : ℕ) (s : Fin n → powSections (L.restrict (f ⁻¹ᵁ U).ι) D),
      ∀ x : (f ⁻¹ᵁ U).toScheme, ∃ i,
        x ∈ Stacks.Ample.nonvanishingLocus (natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) D)
          (Stacks.SectionProduct.globalSection _ _ (s i)) := by
  have : CompactSpace (f ⁻¹ᵁ U).toScheme :=
    isCompact_iff_compactSpace.mp (QuasiCompact.isCompact_preimage (f := f) _ U.2 hU.isCompact)
  exact exists_common_degree _ (exists_powSections_restrict_at f L hL U hU)

/-- Some positive power `L^{⊗ D}` of the restriction of `L`
to `f⁻¹U` has `N + 1` global sections generating every stalk, the datum
`Stacks.ProjectiveFromSections.toProjectiveSpaceOver` takes. -/
private theorem exists_generatesStalks_restrict {Y S : Scheme.{u}} (f : Y ⟶ S)
    [QuasiCompact f] [QuasiSeparated f] (L : Y.Modules) [Stacks.Ample.IsInvertibleModule Y L]
    (hL : IsRelSemiample f L) (U : S.Opens) (hU : IsAffineOpen U)
    [Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι)] :
    ∃ D : ℕ, 0 < D ∧ ∃ (N : ℕ) (s : Fin (N + 1) → Γ(natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) D, ⊤)),
      Stacks.ProjectiveFromSections.GeneratesStalks s := by
  obtain ⟨D, hD, n, s, hs⟩ := exists_covering_powSections_restrict f L hL U hU
  refine ⟨D, hD, n, Fin.lastCases 0 (fun i => Stacks.SectionProduct.globalSection _ _ (s i)),
    fun x w => ?_⟩
  obtain ⟨i, hi⟩ := hs x
  obtain ⟨r, hr⟩ :=
    (Stacks.SectionProduct.mem_nonvanishingLocus_iff_generates _ _ x).mp hi w
  refine ⟨{i.castSucc}, fun _ => r, ?_⟩
  simp only [Finset.sum_singleton, Fin.lastCases_castSucc]
  exact hr

/-- For proper `f`, the high-degree pieces of the section ring of `L` over `f⁻¹U` are generated
by one finite family of sections of a fixed positive degree: the sections of a globally generated
power `L^{⊗ D}` given by `exists_generatesStalks_restrict`. -/
private theorem exists_generators_restrict {Y S : Scheme.{u}} (f : Y ⟶ S) [IsProper f]
    [IsLocallyNoetherian S] (L : Y.Modules)
    [Stacks.Ample.IsInvertibleModule Y L]
    (hL : IsRelSemiample f L) (U : S.Opens) (hU : IsAffineOpen U)
    [Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι)] :
    ∃ (m r N : ℕ) (s : Fin r → powSections (L.restrict (f ⁻¹ᵁ U).ι) m), 1 ≤ m ∧
      ∀ n : ℕ, N ≤ n → ∀ u : powSections (L.restrict (f ⁻¹ᵁ U).ι) (m + n),
        ∃ a : Fin r → powSections (L.restrict (f ⁻¹ᵁ U).ι) n, u = ∑ j, mul (s j) (a j) := by
  obtain ⟨D, hD, N, σ, hσ⟩ := exists_generatesStalks_restrict f L hL U hU
  have : IsNoetherianRing Γ(S, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  obtain ⟨s, N₀, hs⟩ := MMP.SemiampleSections.exists_forall_eq_sum_mul_of_generatesStalks
    (R := Γ(S, U)) ((f ∣_ U) ≫ hU.isoSpec.hom) (L.restrict (f ⁻¹ᵁ U).ι) hD σ hσ
  exact ⟨D, N + 1, N₀, s, hD, hs⟩

/-- **Finite generation of the section algebra of a relatively semiample invertible module.**
For a projective `f : Y ⟶ S` over a locally Noetherian `S` and an invertible `L` some positive
power of which is generated by relative sections locally over `S`, the section ring
`⨁_{m ≥ 0} Γ(f⁻¹(U), L^{⊗ m})` is generated, over the image of `Γ(S, U)` in degree zero, by
finitely many elements, for every affine open `U ⊆ S`. -/
@[mmp "lem_mmp_foundation_relative_semiample_section_algebra"]
public theorem fg_sectionRing_restrict_of_isProjective {Y S : Scheme.{u}} (f : Y ⟶ S)
    (hf : IsProjective f) [IsLocallyNoetherian S] (L : Y.Modules)
    [Stacks.Ample.IsInvertibleModule Y L]
    (hL : ∀ s : S, ∃ U : S.Opens, s ∈ U ∧ ∃ d : ℕ, 0 < d ∧ ∀ y ∈ f ⁻¹ᵁ U,
      ∃ t : Γ(natTensorPow L d, f ⁻¹ᵁ U),
        y ∈ Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn (natTensorPow L d) (f ⁻¹ᵁ U) t)
    (U : S.Opens) (hU : IsAffineOpen U) :
    ∃ G : Finset (sectionRing (L.restrict (f ⁻¹ᵁ U).ι)),
      Subring.closure (Set.range (fun a : Γ(S, U) =>
          DirectSum.of (powSections (L.restrict (f ⁻¹ᵁ U).ι)) 0
            ((Stacks.SectionRingGeometric.unitScalarEquiv (f ⁻¹ᵁ U).toScheme).symm
              ((f ⁻¹ᵁ U).topIso.inv (f.app U a)))) ∪ ↑G) = ⊤ := by
  have : Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι) :=
    letI := Stacks.InvertiblePullback.isInvertibleModule_restrict (f ⁻¹ᵁ U) L
    Stacks.AlgebraicGeometry.ProjAmpleTwist.isInvertibleModule_of_iso
      ((Scheme.Modules.restrictFunctorIsoPullback (f ⁻¹ᵁ U).ι).app L ≪≫
        (Stacks.ProjectiveBundleQuotients.pullbackIso (f ⁻¹ᵁ U).ι).app L).symm
  have : IsProper f := hf.isProper
  choose gen hgen0 using exists_finset_eq_sum_baseMap f L U hU
  obtain ⟨m, r, N, s, hm, hgen⟩ := exists_generators_restrict f L hL U hU
  have hft := Stacks.AlgebraicGeometry.ProperAmpleCohomology.ringHomFiniteType_of_gen
    (L.restrict (f ⁻¹ᵁ U).ι) (baseMap f U) gen hgen0 m r N hm s hgen
  obtain ⟨G, hG⟩ := hft.out
  refine ⟨G, eq_top_iff.mpr fun x hx => ?_⟩
  clear hx
  induction (SetLike.ext_iff.mp hG x).mpr trivial using Algebra.adjoin_induction with
  | mem y hy => exact Subring.subset_closure (Or.inr hy)
  | algebraMap a => exact Subring.subset_closure (Or.inl ⟨a, rfl⟩)
  | add y z _ _ hy hz => exact Subring.add_mem _ hy hz
  | mul y z _ _ hy hz => exact Subring.mul_mem _ hy hz

end MMP

end RelativeSemiampleSectionAlgebra

section CoefficientModel

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry MMP.CoefficientModels

namespace MMP

/-- **Finite coefficient model of a finite projective diagram.** Let `k₀` be a Noetherian ring
and `K` a field which is a `k₀`-algebra. Let `X : J ⥤ Over (Spec K)` be a diagram indexed by a
finite category, each object immersed by `ι j` over `Spec K` into `ℙⁿ_K`, and let `π : E ⥤ J`
be a finite category over `J` carrying coherent modules `M e` on `X (π e)` and maps
`μ φ : M e ⟶ (X (π φ))^* M e'`, unital and compatible with composition. Then there is a finitely
generated `k₀`-subalgebra `R ⊆ K`, a diagram `Y : J ⥤ Over (Spec R)` with immersions `ιY j` into
`ℙⁿ_R`, a system `(N, μY)` of coherent modules and maps of the same kind, and comparison
morphisms `p j : X j ⟶ Y j` making `X j` the base change of `Y j` along `Spec K ⟶ Spec R`,
natural in `j`, compatible with the embeddings, with isomorphisms `θ e : (p (π e))^* N e ≅ M e`
transporting `μY` to `μ`. Open and closed immersions, isomorphisms, monomorphisms, epimorphisms,
invertible and trivial modules are retained. -/
@[mmp "lem_mmp_finite_projective_coefficient_model"]
public theorem exists_fg_subalgebra_model_of_finCategory
    (k₀ : Type v) [CommRing k₀] [IsNoetherianRing k₀] (K : Type u) [Field K] [Algebra k₀ K]
    {J : Type u} [SmallCategory J] [FinCategory J]
    (X : J ⥤ Over (Spec (.of K))) (n : ℕ)
    (ι : ∀ j, (X.obj j).left ⟶ projectiveSpaceOver n (Spec (.of K)))
    (hι : ∀ j, IsImmersion (ι j))
    (hιover : ∀ j, ι j ≫ (projectiveSpaceOver n (Spec (.of K)) ↘ Spec (.of K)) = (X.obj j).hom)
    {E : Type u} [SmallCategory E] [FinCategory E] (π : E ⥤ J)
    (M : ∀ e, (X.obj (π.obj e)).left.Modules)
    (hM : ∀ e, SheafOfModules.IsCoherent (M e))
    (μ : ∀ {e e' : E} (φ : e ⟶ e'),
      M e ⟶ (Scheme.Modules.pullback (X.map (π.map φ)).left).obj (M e'))
    (hμid : ∀ e, μ (𝟙 e) = (Scheme.Modules.pullbackId _).inv.app (M e) ≫
      (Scheme.Modules.pullbackCongr (by simp)).hom.app (M e))
    (hμcomp : ∀ {e e' e'' : E} (φ : e ⟶ e') (ψ : e' ⟶ e''), μ (φ ≫ ψ) =
      μ φ ≫ (Scheme.Modules.pullback (X.map (π.map φ)).left).map (μ ψ) ≫
        (Scheme.Modules.pullbackComp _ _).hom.app (M e'') ≫
        (Scheme.Modules.pullbackCongr (by simp)).hom.app (M e'')) :
    ∃ (R : Subalgebra k₀ K), R.FG ∧
    ∃ (Y : J ⥤ Over (Spec (.of R)))
      (ιY : ∀ j, (Y.obj j).left ⟶ projectiveSpaceOver n (Spec (.of R)))
      (p : ∀ j, (X.obj j).left ⟶ (Y.obj j).left)
      (hp : ∀ {j j'} (g : j ⟶ j'), (X.map g).left ≫ p j' = p j ≫ (Y.map g).left)
      (N : ∀ e, (Y.obj (π.obj e)).left.Modules)
      (θ : ∀ e, (Scheme.Modules.pullback (p (π.obj e))).obj (N e) ≅ M e)
      (μY : ∀ {e e' : E} (φ : e ⟶ e'),
        N e ⟶ (Scheme.Modules.pullback (Y.map (π.map φ)).left).obj (N e')),
      -- the model is a diagram of immersed `R`-schemes with base change the given one
      (∀ j, IsImmersion (ιY j)) ∧
      (∀ j, ιY j ≫ (projectiveSpaceOver n (Spec (.of R)) ↘ Spec (.of R)) = (Y.obj j).hom) ∧
      (∀ j, IsPullback (p j) (X.obj j).hom (Y.obj j).hom
        (Spec.map (CommRingCat.ofHom (algebraMap R K)))) ∧
      (∀ j, ι j ≫ projectiveSpaceOver.toIntegralAtUniverse n _ =
        p j ≫ ιY j ≫ projectiveSpaceOver.toIntegralAtUniverse n _) ∧
      -- closed embeddings and open/closed immersions in the diagram are retained
      (∀ j, IsClosedImmersion (ι j) → IsClosedImmersion (ιY j)) ∧
      (∀ {j j'} (g : j ⟶ j'), IsOpenImmersion (X.map g).left → IsOpenImmersion (Y.map g).left) ∧
      (∀ {j j'} (g : j ⟶ j'),
        IsClosedImmersion (X.map g).left → IsClosedImmersion (Y.map g).left) ∧
      -- the model module system is coherent, unital and compatible with composition
      (∀ e, SheafOfModules.IsCoherent (N e)) ∧
      (∀ e, μY (𝟙 e) = (Scheme.Modules.pullbackId _).inv.app (N e) ≫
        (Scheme.Modules.pullbackCongr (by simp)).hom.app (N e)) ∧
      (∀ {e e' e'' : E} (φ : e ⟶ e') (ψ : e' ⟶ e''), μY (φ ≫ ψ) =
        μY φ ≫ (Scheme.Modules.pullback (Y.map (π.map φ)).left).map (μY ψ) ≫
          (Scheme.Modules.pullbackComp _ _).hom.app (N e'') ≫
          (Scheme.Modules.pullbackCongr (by simp)).hom.app (N e'')) ∧
      -- the specified properties of the module data are retained
      (∀ {e e' : E} (φ : e ⟶ e'), IsIso (μ φ) → IsIso (μY φ)) ∧
      (∀ {e e' : E} (φ : e ⟶ e'), Mono (μ φ) → Mono (μY φ)) ∧
      (∀ {e e' : E} (φ : e ⟶ e'), Epi (μ φ) → Epi (μY φ)) ∧
      (∀ e, Stacks.Ample.IsInvertibleModule _ (M e) →
        Stacks.Ample.IsInvertibleModule _ (N e)) ∧
      (∀ e, Nonempty (M e ≅ SheafOfModules.unit _) →
        Nonempty (N e ≅ SheafOfModules.unit _)) ∧
      -- the maps along the arrows descend to the model
      (∀ {e e' : E} (φ : e ⟶ e'),
        (θ e).inv ≫ (Scheme.Modules.pullback (p (π.obj e))).map (μY φ) ≫
          (Scheme.Modules.pullbackComp (p (π.obj e)) (Y.map (π.map φ)).left).hom.app _ ≫
          (Scheme.Modules.pullbackCongr (hp (π.map φ))).inv.app _ ≫
          (Scheme.Modules.pullbackComp (X.map (π.map φ)).left (p (π.obj e'))).inv.app _ ≫
          (Scheme.Modules.pullback (X.map (π.map φ)).left).map (θ e').hom =
        μ φ) := by
  have hfp : ∀ j, FinitePresentation (X.obj j).hom := fun j => by
    have := hι j
    rw [← hιover j]
    exact finitePresentation_of_isImmersion_projectiveSpaceOver K n (ι j)
  have : ∀ j, @IsImmersion _ (projectiveSpaceOver n (specCone k₀ K).pt) (ι j) := hι
  -- the diagram, the modules and the module maps at a stage
  obtain ⟨d, hd⟩ := exists_diagramStageData (specDiagram k₀ K) (specCone k₀ K)
    (isLimitSpecCone k₀ K) n (J := J) X ι hιover hfp
  obtain ⟨md, hinv, htriv⟩ := exists_moduleStageData d π M (isLimitSpecCone k₀ K)
    fun e => have := hM e; isFinitePresentation_of_isCoherent (M e)
  obtain ⟨ms⟩ := exists_mapStageData md μ (isLimitSpecCone k₀ K)
  -- the stages from which on the identities, isomorphisms and open immersions are kept
  obtain ⟨b₁, bb₁, hu⟩ := ms.exists_unit_cocycle (isLimitSpecCone k₀ K) hμid hμcomp
  obtain ⟨b₂, bb₂, hiso⟩ := ms.exists_isIso (isLimitSpecCone k₀ K)
  obtain ⟨b₃, bb₃, hopen⟩ := d.exists_isOpenImmersion (isLimitSpecCone k₀ K)
  obtain ⟨m₀, ⟨t₁⟩, ⟨t₂⟩, ⟨t₃⟩⟩ : ∃ (m₀ : Over d.i₀), Nonempty (m₀ ⟶ b₁) ∧
      Nonempty (m₀ ⟶ b₂) ∧ Nonempty (m₀ ⟶ b₃) := by
    classical
    obtain ⟨m₀, hm₀⟩ := IsCofiltered.inf_objs_exists ({b₁, b₂, b₃} : Finset (Over d.i₀))
    exact ⟨m₀, hm₀ (by simp), hm₀ (by simp), hm₀ (by simp)⟩
  -- the last stage, at which the injective and surjective maps are kept
  obtain ⟨m, bm, hme⟩ := ms.exists_mono_epi (t₁ ≫ bb₁)
  let x : m ⟶ ms.a := bm ≫ t₁ ≫ bb₁
  obtain ⟨ιY, h1, h2, h3, -, h5, h6⟩ := hd m ((x ≫ ms.ba) ≫ md.b₃)
  have := isLocallyNoetherian_specDiagram_obj k₀ K m.left
  refine ⟨m.left.unop.1, m.left.unop.2, d.diagram ((x ≫ ms.ba) ≫ md.b₃), ιY, d.proj m,
    fun g => d.proj_map ((x ≫ ms.ba) ≫ md.b₃) g, md.module (x ≫ ms.ba),
    md.moduleIso (x ≫ ms.ba), fun φ => ms.modelHom x φ, h1, h2, d.isPullback_proj m,
    fun j => ?_, h5, fun g hg => ?_, h6, md.isCoherent_module (x ≫ ms.ba),
    fun e => ?_, fun φ ψ => ?_, fun φ hφ => ?_,
    fun φ hφ => (hme φ).1 hφ, fun φ hφ => (hme φ).2 hφ,
    fun e h => md.isInvertibleModule_module (x ≫ ms.ba) (hinv e h),
    fun e h => md.nonempty_iso_unit_module (x ≫ ms.ba) (htriv e h),
    fun φ => ms.modelHom_descent x φ⟩
  · exact (congrArg (ι j ≫ ·)
      (projectiveSpaceOverMap_snd n ((specCone k₀ K).π.app m.left)).symm).trans
        ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ _) (h3 j).symm).trans
          (Category.assoc _ _ _)))
  · rw [d.diagram_congr ((x ≫ ms.ba) ≫ md.b₃) ((bm ≫ t₃) ≫ bb₃)]
    exact hopen (bm ≫ t₃) g hg
  · have hue := (hu (bm ≫ t₁)).1 e
    rw [Subsingleton.elim ((bm ≫ t₁) ≫ bb₁) x] at hue
    exact ms.modelHom_id x e hue _
  · have huc := (hu (bm ≫ t₁)).2 φ ψ
    rw [Subsingleton.elim ((bm ≫ t₁) ≫ bb₁) x] at huc
    exact ms.modelHom_comp x φ ψ huc _
  · rw [Subsingleton.elim x ((bm ≫ t₂) ≫ bb₂)]
    exact hiso (bm ≫ t₂) φ hφ

end MMP

end CoefficientModel
