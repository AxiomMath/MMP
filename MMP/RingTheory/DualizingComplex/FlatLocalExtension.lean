section RegularLocalRing

open CategoryTheory AlgebraicGeometry TopologicalSpace MMP MMP.Mori

/-- A prime divisor whose generic point lies on another prime divisor is that prime divisor:
both generic points have coheight one, so neither can be a proper generization of the other. -/
private theorem eq_of_genericPoint_mem_support {Y : Scheme.{u}} {E P : Mori.PrimeDivisor Y}
    (hE : E.genericPoint ∈ P.support) : E = P := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hE
  have hle : E.genericPoint ≤ P.genericPoint := specializes_iff_mem_closure.mpr hE
  by_contra hne
  have hlt : E.genericPoint < P.genericPoint := lt_of_le_not_ge hle fun h =>
    hne (AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (Specializes.antisymm (show E.genericPoint ⤳ P.genericPoint from h)
        (show P.genericPoint ⤳ E.genericPoint from hle)).eq)
  have h2 := Order.coheight_add_one_le hlt
  rw [Mori.PrimeDivisor.coheight_genericPoint, Mori.PrimeDivisor.coheight_genericPoint] at h2
  exact absurd h2 (by decide)

/-- On a Noetherian normal scheme with factorial local rings and a point `c` to which every point
specializes, each prime divisor `P` is the divisor of a unit of `K(Y)`. -/
private theorem exists_principalDivisor_eq_single {Y : Scheme.{u}}
    [IsLocallyNoetherian Y] [CompactSpace Y] [IsNormal Y]
    (hUFD : ∀ y : Y, UniqueFactorizationMonoid (Y.presheaf.stalk y))
    (c : Y) (hc : ∀ y : Y, y ⤳ c) (P : Mori.PrimeDivisor Y) :
    ∃ φ : (RationalFunctions Y)ˣ, Mori.principalDivisor φ = Finsupp.single P 1 := by
  classical
  have := P.integral
  have hcart : Stacks.Divisors.IsEffectiveCartierDivisor P.idealSheaf :=
    isEffectiveCartierDivisor_of_codimension_one_of_uniqueFactorizationMonoid P.idealSheaf
      P.codimension_one (fun x _ => hUFD x)
  obtain ⟨W, hW, hxW, f, hf, hspan⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor
      P.idealSheaf hcart c
  have hmemW : ∀ y : Y, y ∈ W := fun y => (hc y).mem_open W.isOpen hxW
  have hgerm : ∀ y (hy : y ∈ W), IdealSheafData.stalk P.idealSheaf y =
      Ideal.span {(Y.presheaf.germ W y hy).hom f} := by
    intro y hy
    rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ P.idealSheaf y ⟨W, hW⟩ hy, hspan,
      Ideal.map_span, Set.image_singleton]
  have hnzd : ∀ y (hy : y ∈ W), (Y.presheaf.germ W y hy).hom f ∈
      nonZeroDivisors (Y.presheaf.stalk y) := fun y hy =>
    Stacks.Divisors.germ_mem_nonZeroDivisors hW hf y hy
  have hu : ∀ Z : irreducibleComponents Y,
      IsUnit ((Y.presheaf.germ W _ (hmemW (componentGenericPoint Y Z))).hom f) := fun Z => by
    obtain ⟨b, hb⟩ := (RationalFunctions.isField_stalk Y Z).mul_inv_cancel
      (nonZeroDivisors.ne_zero (hnzd _ (hmemW _)))
    exact IsUnit.of_mul_eq_one b hb
  let u : ∀ Z : irreducibleComponents Y, (Y.presheaf.stalk (componentGenericPoint Y Z))ˣ :=
    fun Z => (hu Z).unit
  let φ : (RationalFunctions Y)ˣ := (RationalFunctions.unitsEquiv Y).symm u
  refine ⟨φ, Finsupp.ext fun E => ?_⟩
  refine (coeff_principalDivisor φ E).trans ?_
  have hηW : E.genericPoint ∈ W := hmemW _
  have key : E.toComponent.hom ((Y.presheaf.germ W _ hηW).hom f) =
      (φ : RationalFunctions Y) E.component :=
    TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  by_cases hEP : P = E
  · subst hEP
    rw [Finsupp.single_eq_same]
    have hmem : P.genericPoint ∈ P.support := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact subset_closure rfl
    have hg0 := nonZeroDivisors.ne_zero (hnzd _ hηW)
    have hprime : Prime ((Y.presheaf.germ W _ hηW).hom f) := by
      rw [← Ideal.span_singleton_prime hg0, ← hgerm _ hηW]
      have hxr : P.genericPoint ∈ Set.range P.idealSheaf.subschemeι := by
        rw [Scheme.IdealSheafData.range_subschemeι]
        exact hmem
      obtain ⟨y', hy'⟩ := hxr
      rw [← hy', ← Stacks.Divisors.kernel_stalkMap_subscheme_eq_idealStalk]
      exact RingHom.ker_isPrime _
    exact P.ord_eq_one_of_irreducible hprime.irreducible key
  · simp only [Finsupp.single_apply, hEP, ↓reduceIte]
    have hnm : E.genericPoint ∉ P.support := fun h => hEP (eq_of_genericPoint_mem_support h).symm
    have htop := (AlgebraicGeometry.IdealSheafData.stalk_eq_top_iff_notMem_support
      P.idealSheaf _).2 hnm
    rw [hgerm _ hηW, Ideal.span_singleton_eq_top] at htop
    exact E.ord_eq_zero_of_isUnit htop key

/-- On a Noetherian normal scheme, if every prime divisor is principal then so is every Weil
divisor, since the prime divisors generate `Div(X)`. -/
private theorem exists_principalDivisor_eq_of_forall_single {X : Scheme.{u}}
    [IsLocallyNoetherian X] [CompactSpace X] [IsNormal X]
    (h : ∀ P : Mori.PrimeDivisor X, ∃ φ : (RationalFunctions X)ˣ,
      Mori.principalDivisor φ = Finsupp.single P 1)
    (D : Mori.Divisor X) : ∃ φ : (RationalFunctions X)ˣ, D = Mori.principalDivisor φ := by
  have hD : D ∈ (principalDivisorHom (X := X)).range := by
    induction D using Finsupp.induction with
    | zero => exact zero_mem _
    | single_add P n D _ _ ih =>
      refine add_mem ?_ ih
      obtain ⟨φ, hφ⟩ := h P
      rw [← Finsupp.smul_single_one, ← hφ]
      exact zsmul_mem (AddMonoidHom.mem_range.2 ⟨Additive.ofMul φ, rfl⟩) n
  obtain ⟨φ, hφ⟩ := hD
  exact ⟨φ.toMul, hφ.symm⟩

/-- If `x` lies in no minimal prime of the Noetherian local ring `A` and `A ⧸ (x)` is regular,
then `A` is regular: `dim A ⧸ (x) + 1 ≤ dim A`, and `𝔪` is generated by `x` together with lifts
of generators of the maximal ideal of `A ⧸ (x)`. -/
private theorem isRegularLocalRing_of_isRegularLocalRing_quotient {A : Type*} [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] {x : A} (hmin : ∀ 𝔭 ∈ minimalPrimes A, x ∉ 𝔭)
    (hreg : IsRegularLocalRing (A ⧸ Ideal.span {x})) : IsRegularLocalRing A := by
  have hdim : ringKrullDim (A ⧸ Ideal.span {x}) + 1 ≤ ringKrullDim A :=
    ringKrullDim_quotient_succ_le_of_forall_notMem_minimalPrimes _ fun p hp hle =>
      hmin p hp (Ideal.span_singleton_le_iff_mem p |>.mp hle)
  have hgen := key_generator_bound A (A ⧸ Ideal.span {x}) (Ideal.Quotient.mk _)
    Ideal.Quotient.mk_surjective
  rw [Ideal.mk_ker] at hgen
  have h1 : (Ideal.span {x} : Ideal A).spanFinrank ≤ 1 := by
    simpa using Submodule.spanFinrank_span_le_ncard_of_finite (R := A) (Set.finite_singleton x)
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le A (le_trans ?_ hdim)
  rw [← hreg.spanFinrank_maximalIdeal]
  exact_mod_cast (by omega : (IsLocalRing.maximalIdeal A).spanFinrank ≤
    (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x})).spanFinrank + 1)
/-- Let `A` be a Noetherian local ring. If `A` is regular, then `A` is a unique factorisation
domain, all its localizations at primes are regular, and every Weil divisor on `Spec A` is
principal. If `x` lies in the maximal ideal and in no minimal prime of `A`, and `A ⧸ (x)` is
regular, then `A` is regular. -/
@[mmp "lem_mmp_foundation_km5b_regular_factorial_and_quotient"]
public theorem MMP.isRegularLocalRing_factorial_and_of_quotient_span_singleton
    (A : Type*) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] :
    (IsRegularLocalRing A →
      (∃ _ : IsDomain A, UniqueFactorizationMonoid A) ∧
      (∀ (𝔭 : Ideal A) [𝔭.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔭)) ∧
      (∀ [AlgebraicGeometry.IsNormal (AlgebraicGeometry.Spec (.of A))]
        (D : MMP.Mori.Divisor (AlgebraicGeometry.Spec (.of A))),
        ∃ φ : (MMP.Mori.RationalFunctions (AlgebraicGeometry.Spec (.of A)))ˣ,
          D = MMP.Mori.principalDivisor φ)) ∧
    (∀ x ∈ IsLocalRing.maximalIdeal A, (∀ 𝔭 ∈ minimalPrimes A, x ∉ 𝔭) →
      IsRegularLocalRing (A ⧸ Ideal.span {x}) → IsRegularLocalRing A) := by
  refine ⟨fun h => ?_, fun _ _ hmin hreg =>
    isRegularLocalRing_of_isRegularLocalRing_quotient hmin hreg⟩
  have hRR : IsRegularRing A := ((IsLocalRing.isRegularRing_tfae (R := A)).out 1 3).mp h
  refine ⟨⟨IsRegularLocalRing.isDomain A, IsRegularLocalRing.uniqueFactorizationMonoid A⟩,
    fun 𝔭 _ => IsRegularRing.isRegularLocalRing_localization 𝔭, ?_⟩
  intro _ D
  have hUFD : ∀ y : Spec (.of A),
      UniqueFactorizationMonoid ((Spec (.of A)).presheaf.stalk y) := fun y => by
    have : IsRegularLocalRing ((Spec (.of A)).presheaf.stalk y) :=
      IsRegularLocalRing.of_ringEquiv (Spec.stalkIso (.of A) y).commRingCatIsoToRingEquiv.symm
    exact IsRegularLocalRing.uniqueFactorizationMonoid _
  have hc : ∀ y : Spec (.of A), y ⤳ (IsLocalRing.closedPoint A : Spec (.of A)) := fun y =>
    (PrimeSpectrum.le_iff_specializes y _).mp (IsLocalRing.le_maximalIdeal y.isPrime.ne_top)
  exact exists_principalDivisor_eq_of_forall_single
    (exists_principalDivisor_eq_single hUFD _ hc) D

end RegularLocalRing

section FiniteOverProjective

open CategoryTheory AlgebraicGeometry MMP.Resolution.Bridges

namespace MMP.Intersection

/-- A line bundle in Lazarsfeld's sense (locally free of rank one) is invertible. -/
private theorem isInvertibleModule_of_isLineBundle {X : Scheme.{u}} (A : X.Modules)
    (hA : MMP.Intersection.Scheme.Modules.IsLineBundle A) : Stacks.Ample.IsInvertibleModule X A :=
  Stacks.AlgebraicGeometry.TwistMapsInvertible.isInvertibleModule_of_forall_exists_restrict_isoUnit
    A fun x => (hA x).imp fun _ hU =>
      ⟨hU.1, hU.2.map fun e => e ≪≫ Limits.coproductUniqueIso _⟩

/-- A scheme finite over a projective scheme over `k` is projective over `k`, and the pull-back
of an ample line bundle along a finite morphism is ample. -/
@[mmp "lem_mmp_foundation_laz_finite_over_projective"]
public theorem isProjectiveMorphism_and_isAmple_pullback_of_isFinite (k : Type u) [Field k]
    {W Y : Scheme.{u}} [W.Over (Spec (.of k))] [Y.Over (Spec (.of k))]
    [IsSeparatedAlgebraicScheme k W] [IsSeparatedAlgebraicScheme k Y]
    (g : W ⟶ Y) [g.IsOver (Spec (.of k))] [IsFinite g]
    (hY : IsProjectiveMorphism (Y ↘ Spec (.of k))) :
    IsProjectiveMorphism (W ↘ Spec (.of k)) ∧
      ∀ A : Y.Modules, Scheme.Modules.IsLineBundle A → IsAmple k A →
        IsAmple k ((Scheme.Modules.pullback g).obj A) := by
  have : IsProper (Y ↘ Spec (.of k)) := isProper_of_isProjectiveMorphism _ hY
  have hWp : IsProper (W ↘ Spec (.of k)) := by
    rw [← comp_over g (Spec (.of k))]
    infer_instance
  refine ⟨?_, ?_⟩
  · obtain ⟨⟨_, _⟩, L, hL, hamp⟩ :=
      MMP.Intersection.isQuasiProjective_of_isFinite k g hY.isQuasiProjective
    have : Stacks.Ample.IsInvertibleModule W L := hL
    obtain ⟨d, -, n, i, hi, hover, -⟩ :=
      ((Stacks.AmpleRelativeFiniteType.tfae_six (W ↘ Spec (.of k)) L).out 2 5).1 hamp
    have : IsImmersion i := hi
    have : IsProper (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) :=
      isProper_projectiveSpaceOver n _
    have : IsProper (i ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))) := by
      rw [show i ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = W ↘ Spec (.of k)
        from hover]
      infer_instance
    have : IsProper i := IsProper.of_comp i (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))
    exact ⟨n, i, IsClosedImmersion.of_isPreimmersion _ i.isClosedMap.isClosed_range, hover⟩
  · intro A hA hAmp
    have : Stacks.Ample.IsInvertibleModule Y A := isInvertibleModule_of_isLineBundle A hA
    have : Stacks.Ample.IsInvertibleModule W ((Scheme.Modules.pullback g).obj A) :=
      MMP.Fourfold.isInvertibleModule_pullback g A
    obtain ⟨m, hm, hva⟩ := hAmp
    obtain ⟨eP⟩ := nonempty_tensorPow_iso_tensorPowModule Y A m
    have h5 : ∃ d : ℕ, 1 ≤ d ∧ Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver
        (Y ↘ Spec (.of k)) (Stacks.Ample.tensorPowModule Y A (d : ℤ)) :=
      ⟨m, hm, hasImmersionTwistOver_of_isVeryAmple k _ _ hva eP.symm⟩
    have hYA : Stacks.Ample.IsAmple Y A :=
      ((Stacks.AmpleRelativeFiniteType.tfae_six (Y ↘ Spec (.of k)) A).out 5 1).1 h5
    have : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (W ↘ Spec (.of k))
    have hWA : Stacks.Ample.IsAmple W ((Scheme.Modules.pullback g).obj A) :=
      (Stacks.AmpleBridge.isAmple_iff_isAmple W _).2
        (Scheme.Modules.isAmple_pullback_of_isAffineHom g A
          ((Stacks.AmpleBridge.isAmple_iff_isAmple Y A).1 hYA))
    obtain ⟨d, hd, h⟩ :=
      ((Stacks.AmpleRelativeFiniteType.tfae_six (W ↘ Spec (.of k)) _).out 1 5).1 hWA
    obtain ⟨eQ⟩ := nonempty_tensorPow_iso_tensorPowModule W ((Scheme.Modules.pullback g).obj A) d
    exact ⟨d, hd, isVeryAmple_of_hasImmersionTwistOver k _ _ eQ h⟩

end MMP.Intersection

