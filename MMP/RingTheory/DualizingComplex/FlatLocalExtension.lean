/-- **Cohomology along a finite morphism.** For a finite morphism `f : Y ⟶ X`, cohomology of
quasi-coherent `𝒪_Y`-modules agrees with cohomology of their direct images, naturally in the
module, in every degree `i`. -/
@[mmp "lem_mmp_foundation_finite_algebraic_cohomology"]
public theorem nonempty_cohomologyPushforwardIso_of_isFinite {Y X : Scheme.{u}} (f : Y ⟶ X)
    [IsFinite f] (i : ℕ) :
    Nonempty (ObjectProperty.ι (SheafOfModules.isQuasicoherent Y.ringCatSheaf) ⋙
          Hfunctor Y.ringCatSheaf ⊤ i ≅
        ObjectProperty.ι (SheafOfModules.isQuasicoherent Y.ringCatSheaf) ⋙
          Scheme.Modules.pushforward f ⋙ Hfunctor X.ringCatSheaf ⊤ i) :=
  ⟨Stacks.AffineCohomologyResolution.cohomologyPushforwardIso f i⟩

end MMP

