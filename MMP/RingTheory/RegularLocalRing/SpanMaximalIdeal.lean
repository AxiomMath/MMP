module

public import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

/-!
# Regular local rings by generators of the maximal ideal

A Noetherian local ring `A` is regular iff its maximal ideal is generated by `dim A` elements,
the form of the definition in Fulton's Appendix A.7. Mathlib's `IsRegularLocalRing` is the
equality `spanFinrank 𝔪 = dim A`.

## Main results

* `MMP.isRegularLocalRing_iff_exists_span_eq_maximalIdeal`.
-/

@[expose] public section

namespace MMP

open IsLocalRing Submodule

/-- A Noetherian local ring `A` is regular if and only if its maximal ideal is generated by
`dim A` elements. -/
theorem isRegularLocalRing_iff_exists_span_eq_maximalIdeal (A : Type*) [CommRing A]
    [IsLocalRing A] [IsNoetherianRing A] :
    IsRegularLocalRing A ↔ ∃ (n : ℕ) (f : Fin n → A),
      (n : WithBot ℕ∞) = ringKrullDim A ∧ Ideal.span (Set.range f) = maximalIdeal A := by
  constructor
  · intro h
    obtain ⟨s, hs, hspan⟩ :=
      (IsNoetherian.noetherian (maximalIdeal A)).exists_span_set_encard_eq_spanFinrank
    have hfin : s.Finite := Set.finite_of_encard_eq_coe hs
    have hcard : hfin.toFinset.card = (maximalIdeal A).spanFinrank := by
      rw [← Set.ncard_eq_toFinset_card s hfin, Set.ncard_def, hs]
      rfl
    refine ⟨_, fun i ↦ (hfin.toFinset.equivFin.symm (Fin.cast hcard.symm i) : A),
      h.spanFinrank_maximalIdeal, ?_⟩
    convert hspan
    ext x
    refine ⟨?_, fun hx ↦ ⟨Fin.cast hcard (hfin.toFinset.equivFin ⟨x, hfin.mem_toFinset.2 hx⟩),
      by simp⟩⟩
    rintro ⟨i, rfl⟩
    exact hfin.mem_toFinset.1 (Finset.coe_mem _)
  · rintro ⟨n, f, hn, hf⟩
    refine ⟨le_antisymm ?_ (ringKrullDim_le_spanFinrank_maximalIdeal A)⟩
    rw [← hn, ← hf]
    have h : (Set.range f).ncard ≤ n := by
      rw [← Set.image_univ]
      exact (Set.ncard_image_le Set.finite_univ).trans (by simp [Set.ncard_univ])
    exact_mod_cast (spanFinrank_span_le_ncard_of_finite (R := A) (Set.finite_range f)).trans h

end MMP
