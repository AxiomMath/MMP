module

public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Algebra
public import StacksFrontier.RingTheory.Sequence.QuasiRegular.Graded
public import StacksFrontier.RingTheory.RegularLocalRing.Basic
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.Spreading

/-!
# Symbolic powers of regular centres

In a regular local ring `R`, an ideal `J` with `R/J` regular local is generated by a regular, hence
quasi-regular, sequence. Consequently `J^m` is `J`-primary: if `s ∉ J` and `s a ∈ J^m`, then
`a ∈ J^m`.

## Main results

* `MMP.Resolution.pow_cancel_of_isQuasiRegularRel`: for a quasi-regular sequence `f` generating
  a prime ideal `Jid f`, if `s ∉ Jid f` and `s * a ∈ Jid f ^ m`, then `a ∈ Jid f ^ m`.
* `MMP.Resolution.pow_cancel_of_isRegularLocalRing_quotient`: in a regular local ring, `J^m` is
  `J`-primary when `R ⧸ J` is regular local.
* `MMP.Resolution.mem_pow_of_algebraMap_mem_map_pow`: under the same hypotheses, `J^m` is the
  contraction of its extension to the localization at `J`.

## References

* J. Kollár, *Lectures on Resolution of Singularities*, 3.47–3.60
-/

@[expose] public section

namespace MMP.Resolution

open Stacks.RingTheory.QuasiRegular Stacks.RingTheory.RegularIdealSheaf IsLocalRing

/-- For a quasi-regular sequence `f` generating a prime ideal and `s ∉ Jid f`, if
`s * ∑ l e * f^e ∈ Jid f ^ (i + 1)` with every `e ∈ l.support` of degree `i`, then every
coefficient `l e` lies in `Jid f`. -/
theorem coeff_mem_of_mul_sum_mem_pow {R : Type*} [CommRing R] {c : ℕ} (f : Fin c → R)
    (hq : IsQuasiRegularRel f) (hp : (Jid f).IsPrime) {s : R} (hs : s ∉ Jid f) {i : ℕ}
    (l : (Fin c →₀ ℕ) →₀ R) (hl : ∀ e ∈ l.support, qrMdeg e = i)
    (h : s * ∑ e ∈ l.support, l e * fpow f e ∈ Jid f ^ (i + 1)) :
    ∀ e ∈ l.support, l e ∈ Jid f := by
  classical
  set S := l.support
  obtain ⟨p, hcoeff⟩ : ∃ p : MvPolynomial (Fin c) R, ∀ e, p.coeff e = l e := by
    refine ⟨∑ e ∈ S, MvPolynomial.monomial e (l e), fun e => ?_⟩
    simp only [MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
    by_cases he : e ∈ S
    · rw [Finset.sum_eq_single e (fun b _ hb => by simp [hb]) (fun h => absurd he h)]
      simp
    · rw [Finset.sum_eq_zero (fun b hb => by
        have : b ≠ e := fun h => he (h ▸ hb)
        simp [this])]
      simpa [S, eq_comm] using he
  have hpS : p.support ⊆ S := by
    intro e he
    rw [MvPolynomial.mem_support_iff, hcoeff] at he
    simpa [S] using he
  have hsp : (MvPolynomial.C s * p).support ⊆ S := by
    intro e he
    apply hpS
    rw [MvPolynomial.mem_support_iff] at he ⊢
    exact fun h0 => he (by simp [MvPolynomial.coeff_C_mul, h0])
  have hgp : ∀ d, gradedPartOn f (MvPolynomial.C s * p) S d = s * gradedPartOn f p S d := by
    intro d
    rw [gradedPartOn_eq_sum, gradedPartOn_eq_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [MvPolynomial.coeff_C_mul]
    ring
  have hpi : gradedPartOn f p S i = ∑ e ∈ S, l e * fpow f e := by
    rw [gradedPartOn_eq_sum, Finset.filter_true_of_mem hl]
    exact Finset.sum_congr rfl fun e _ => by rw [hcoeff, mul_comm]
  have hpd : ∀ d, d ≠ i → gradedPartOn f p S d = 0 := by
    intro d hd
    rw [gradedPartOn_eq_sum]
    refine Finset.sum_eq_zero fun e he => ?_
    obtain ⟨he₁, he₂⟩ := Finset.mem_filter.1 he
    exact absurd ((hl e he₁).symm.trans he₂ |>.symm) (by simpa using hd)
  have hcond : ∀ d,
      gradedPartOn f (MvPolynomial.C s * p) S d ∈ (Jid f ^ (d + 1) : Ideal R) := by
    intro d
    rw [hgp]
    by_cases hd : d = i
    · subst hd
      rwa [hpi]
    · simp [hpd d hd]
  have hco := hq (MvPolynomial.C s * p) S hsp hcond
  intro e _
  have := hco e
  rw [MvPolynomial.coeff_C_mul, hcoeff] at this
  exact (hp.mem_or_mem this).resolve_left hs

/-- If `f` is a quasi-regular sequence generating a prime ideal `Jid f`, `s ∉ Jid f` and
`s * a ∈ Jid f ^ m`, then `a ∈ Jid f ^ m`. -/
theorem pow_cancel_of_isQuasiRegularRel {R : Type*} [CommRing R] {c : ℕ} (f : Fin c → R)
    (hq : IsQuasiRegularRel f) (hp : (Jid f).IsPrime) {s a : R} (hs : s ∉ Jid f) (m : ℕ)
    (h : s * a ∈ Jid f ^ m) : a ∈ Jid f ^ m := by
  suffices H : ∀ i, i ≤ m → a ∈ Jid f ^ i from H m le_rfl
  intro i
  induction i with
  | zero => simp
  | succ i ih =>
    intro hi
    have hspan : a ∈ Submodule.span R (fpow f '' {e : Fin c →₀ ℕ | qrMdeg e = i}) := by
      have := pow_le_span_monSet f i (ih (by omega))
      rwa [show monSet f i = fpow f '' {e : Fin c →₀ ℕ | qrMdeg e = i} by
        ext x
        constructor <;> rintro ⟨e, he, rfl⟩ <;> exact ⟨e, he, rfl⟩] at this
    obtain ⟨l, hl, hla⟩ := (Finsupp.mem_span_image_iff_linearCombination R (v := fpow f)
      (s := {e : Fin c →₀ ℕ | qrMdeg e = i}) (x := a)).1 hspan
    have hsum : a = ∑ e ∈ l.support, l e * fpow f e := by
      rw [← hla, Finsupp.linearCombination_apply, Finsupp.sum]
      simp [smul_eq_mul]
    have hsupp : ∀ e ∈ l.support, qrMdeg e = i := fun e he => hl (Finset.mem_coe.2 he)
    have hli := coeff_mem_of_mul_sum_mem_pow f hq hp hs l hsupp
      (by rw [← hsum]; exact Ideal.pow_le_pow_right hi h)
    rw [hsum, pow_succ']
    exact Ideal.sum_mem _ fun e he => Ideal.mul_mem_mul (hli e he) (hsupp e he ▸ fpow_mem f e)

/-- In a regular local ring `R`, for an ideal `J` with regular quotient, `J^m` is `J`-primary. -/
theorem pow_cancel_of_isRegularLocalRing_quotient {R : Type*} [CommRing R] [IsRegularLocalRing R]
    (J : Ideal R) (hJ : IsRegularLocalRing (R ⧸ J)) {s a : R} (hs : s ∉ J) (m : ℕ)
    (h : s * a ∈ J ^ m) : a ∈ J ^ m := by
  obtain ⟨xs, hxs, hlen, c, hc, hJ', -⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq J hJ
  have hreg :=
    ((IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      R).1 xs hxs hlen).1
  have hweak : RingTheory.Sequence.IsWeaklyRegular R (xs.take c) := by
    have h1 := hreg.toIsWeaklyRegular
    rw [← List.take_append_drop c xs] at h1
    exact ((RingTheory.Sequence.isWeaklyRegular_append_iff R (xs.take c) (xs.drop c)).mp h1).1
  have hqr := Stacks.AlgebraicGeometry.isQuasiRegular_of_isWeaklyRegular _ hweak
  set l := xs.take c
  let f : Fin l.length → R := fun i => l[i]
  have hf : List.ofFn f = l := by simp [f]
  have hrel : IsQuasiRegularRel f := (isQuasiRegularRel_iff_bijective f).2 <| by
    rwa [← isQuasiRegular_ofFn_iff, hf]
  have hJf : Jid f = J := by
    rw [← hJ', Jid, Ideal.ofList]
    congr 1
    ext x
    simp only [Set.mem_range, Set.mem_ofPred_eq, List.mem_iff_getElem, f]
    exact ⟨fun ⟨y, hy⟩ => ⟨y, y.2, hy⟩, fun ⟨i, hi, hx⟩ => ⟨⟨i, hi⟩, hx⟩⟩
  have hprime : J.IsPrime := by
    have := IsRegularLocalRing.isDomain (R ⧸ J)
    exact Ideal.Quotient.isDomain_iff_prime J |>.1 inferInstance
  rw [← hJf] at hs h hprime ⊢
  exact pow_cancel_of_isQuasiRegularRel f hrel hprime hs m h

/-- If the image of `a` in the localization of a regular local ring `R` at a prime `J` with
regular quotient lies in `J^m S`, then `a ∈ J^m`. -/
theorem mem_pow_of_algebraMap_mem_map_pow {R : Type*} [CommRing R] [IsRegularLocalRing R]
    (J : Ideal R) (hJ : IsRegularLocalRing (R ⧸ J)) [hJp : J.IsPrime] (S : Type*) [CommRing S]
    [Algebra R S] [IsLocalization.AtPrime S J] {a : R} (m : ℕ)
    (h : algebraMap R S a ∈ (J ^ m).map (algebraMap R S)) : a ∈ J ^ m := by
  rw [IsLocalization.mem_map_algebraMap_iff J.primeCompl S] at h
  obtain ⟨⟨b, t⟩, hbt⟩ := h
  obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists J.primeCompl S).1
    (show algebraMap R S (a * t) = algebraMap R S b by rwa [map_mul])
  have hct : (c : R) * t ∉ J := fun hm => (hJp.mem_or_mem hm).elim c.2 t.2
  refine pow_cancel_of_isRegularLocalRing_quotient J hJ hct m ?_
  rw [show (c : R) * t * a = c * b by linear_combination hc]
  exact Ideal.mul_mem_left _ _ b.2

end MMP.Resolution
