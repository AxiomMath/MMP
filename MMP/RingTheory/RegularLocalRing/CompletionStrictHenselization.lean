module
public import MMP.AlgebraicGeometry.Resolution.MarkedIdeal.Cosupport
public import MMP.AlgebraicGeometry.MMP.Fourfold.ThreefoldGraphDivisor
import MMP.AlgebraicGeometry.Singularities.Snc.LocalEquations
import MMP.AlgebraicGeometry.Intersection.QCartierCurveProjection

/-!
# Regular local rings, completions, and two applications

This file collects local-algebra facts used in resolution of singularities and in the minimal
model program, together with two consequences.

* A regular local ring `(R, 𝔪)` is a unique factorization domain, and the members of a regular
  system of parameters are pairwise non-associate primes.
* If `R` is regular local and `R ⧸ J` is regular local, the symbolic powers of `J` are its
  ordinary powers.
* The completion `R^` of a Noetherian local ring is Noetherian, local with maximal ideal `𝔪 R^`,
  complete and separated, every ideal of `R^` is closed, `R^ ⧸ J R^ ≃ (R ⧸ J)^`, `R → R^` is
  faithfully flat and regular systems of parameters are preserved.
* For a strict henselization `H` of a local ring `A` essentially of finite type over a field and
  an ideal `I ⊆ A` with `J = I H`, the quotient `H / J` is a strict henselization of `A / I`
  (for `I` proper), `Ĥ / J Ĥ ≃ (H / J)^`, and contraction along `H → Ĥ` is a bijection from the
  minimal primes over `J Ĥ` onto the minimal primes over `J`.
* For an ideal sheaf `I` with `m = maxord I ≤ 5` and `L = lcm(2, …, m)`, the maximal coefficient
  ideals satisfy `W_{rL}(I) · W_t(I) = W_{rL+t}(I)` for `t ≥ m!`. The proof is a subset-sum
  bound: a multiset of weights in `{1, …, m}` of total weight at least `L + m!` contains a
  submultiset of weight exactly `L`.
* For a threefold step diagram `(X⁻, B⁻) → Z ← (X⁺, B⁺)` with normalized graph `(G, u, v)` and
  graph divisor `H = u^* D⁻ - v^* D⁺`, the divisor `-H` is ample over `Z`.

## Main results

* `MMP.Mori.IsRegularSystemOfParameters.isDomain_uniqueFactorizationMonoid_prime`
* `MMP.comap_map_pow_eq_pow_of_isRegularLocalRing_quotient`
* `MMP.Resolution.adicCompletion_maximalIdeal_package`
* `MMP.minimalPrimes_bijOn_comap_adicCompletion_of_strictHenselization`
* `MMP.Resolution.Kollar.maximalCoefficientIdeal_mul_eq_of_maxOrder_le_five`
* `MMP.Fourfold.IsThreefoldGraphDivisor.hasRelativelyAmpleMultiple_neg`

## Implementation notes

* Mathlib does not register that a regular local ring is a domain, so the domain structure is
  part of the conclusion of the first result, produced as an existential witness.
* The symbolic-power statement is given for local rings: the scheme-theoretic form is the case
  `R = 𝒪_{X,p}`, `J = I_{Z,p}`, the localization being taken abstractly through
  `IsLocalization.AtPrime S J`.
* The quotient identification for completions is stated for ideals `J` with `R ⧸ J` local; for
  `J = R` both sides are zero rings and the maximal-ideal completion of `R ⧸ J` is not defined.
* A strict henselization is stated, in hypothesis and conclusion alike, as the four properties
  of Stacks 04GP: henselian, ind-étale, maximal ideal generated by that of the base, residue
  field a separable closure of that of the base. That `H / I H` is a strict henselization of
  `A / I` is Stacks 05WS, `IsLocalRing.strictHenselization_quotient`; it is stated for `I ≠ ⊤`,
  since `A / A` is not local. Minimal primes of `H / J` and `Ĥ / J Ĥ` are stated as minimal
  primes of `H` over `J` and of `Ĥ` over `J Ĥ`.
* For the graph divisor, the source restricts an ample divisor on `X⁻ ×_Z X⁺` to the graph and
  pulls it back along the normalization; here the finite composite `G ⟶ X⁻ ×_Z X⁺` is used
  directly, and the argument is carried out on invertible sheaves, since `X⁻ ×_Z X⁺` need not be
  normal.

## References

* [R. Lazarsfeld, *Positivity in algebraic geometry I*][lazarsfeld2004]
* [J. Kollár, *Lectures on resolution of singularities*][kollar2007]
* [StacksProject 05WS](https://stacks.math.columbia.edu/tag/05WS)
* [StacksProject 0C2E](https://stacks.math.columbia.edu/tag/0C2E)
* [StacksProject 0DNK](https://stacks.math.columbia.edu/tag/0DNK)
* [StacksProject 0892](https://stacks.math.columbia.edu/tag/0892)
-/

universe u

open IsLocalRing

/-! ### Regular parameters are prime -/

namespace MMP.Mori

/-- No member of a regular system of parameters lies in the ideal generated by the others. -/
private theorem IsRegularSystemOfParameters.notMem_span_image_compl {R : Type*} [CommRing R]
    [IsRegularLocalRing R] {n : ℕ} {z : Fin n → R} (hz : IsRegularSystemOfParameters z)
    (i : Fin n) : z i ∉ Ideal.span (z '' {i}ᶜ) := by
  intro hi
  have hspan : Ideal.span (z '' {i}ᶜ) = maximalIdeal R := by
    rw [← hz.1]
    refine le_antisymm (Ideal.span_mono (Set.image_subset_range _ _)) (Ideal.span_le.2 ?_)
    rintro _ ⟨k, rfl⟩
    by_cases hk : k = i
    · exact hk ▸ hi
    · exact Ideal.subset_span ⟨k, hk, rfl⟩
  have h := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) ((Set.toFinite {i}ᶜ).image z)
  rw [← Ideal.span, hspan] at h
  have hn := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
  rw [hz.2] at hn
  norm_cast at hn
  have hc := Set.ncard_image_le (f := z) (Set.toFinite {i}ᶜ)
  rw [Set.ncard_compl, Set.ncard_singleton, Nat.card_eq_fintype_card, Fintype.card_fin] at hc
  have := i.pos
  omega

/-- **Regular parameters are prime.** A regular local ring `R` is a unique factorization domain,
and the members of a regular system of parameters `z₁, …, zₙ` of `R` are prime elements, no two
of which are associate. -/
@[mmp "lem_mmp_foundation_laz_regular_parameters_prime"]
public theorem IsRegularSystemOfParameters.isDomain_uniqueFactorizationMonoid_prime
    {R : Type*} [CommRing R] [IsRegularLocalRing R] {n : ℕ} {z : Fin n → R}
    (hz : IsRegularSystemOfParameters z) :
    ∃ _ : IsDomain R, UniqueFactorizationMonoid R ∧ (∀ i, Prime (z i)) ∧
      Pairwise fun i j => ¬ Associated (z i) (z j) :=
  ⟨IsRegularLocalRing.isDomain R, IsRegularLocalRing.uniqueFactorizationMonoid R,
    MMP.Intersection.prime_of_isRegularSystemOfParameters hz, fun i j hij ⟨_, hu⟩ =>
      hz.notMem_span_image_compl j
        (hu ▸ Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, hij, rfl⟩))⟩

end MMP.Mori

/-! ### Symbolic powers of an ideal with regular quotient -/

namespace MMP

/-- If `R` is a regular local ring and `J` an ideal with `R ⧸ J` regular local, then the symbolic
powers of `J` are its ordinary powers: `J ^ r` extended to the localization `S` of `R` at `J` and
contracted back to `R` is `J ^ r`. -/
@[mmp "lem_mmp_foundation_smooth_center_ordinary_symbolic_powers"]
public theorem comap_map_pow_eq_pow_of_isRegularLocalRing_quotient
    {R : Type*} [CommRing R] [IsRegularLocalRing R] (J : Ideal R) [J.IsPrime]
    [hJ : IsRegularLocalRing (R ⧸ J)] (S : Type*) [CommRing S] [Algebra R S]
    [IsLocalization.AtPrime S J] (r : ℕ) :
    (Ideal.map (algebraMap R S) (J ^ r)).comap (algebraMap R S) = J ^ r :=
  le_antisymm (fun _ ↦ MMP.Resolution.mem_pow_of_algebraMap_mem_map_pow J hJ S r)
    Ideal.le_comap_map

end MMP

/-! ### The completion of a Noetherian local ring -/

namespace MMP.Resolution

/-- In a Noetherian local ring every ideal is closed for the adic topology of the maximal
ideal. -/
private theorem isClosed_ideal_adicTopology_maximalIdeal {S : Type*} [CommRing S]
    [IsLocalRing S] [IsNoetherianRing S] (K : Ideal S) :
    @IsClosed _ (maximalIdeal S).adicTopology (K : Set S) := by
  let : TopologicalSpace S := (maximalIdeal S).adicTopology
  obtain rfl | hK := eq_or_ne K ⊤
  · exact isClosed_univ
  have : Nontrivial (S ⧸ K) := Ideal.Quotient.nontrivial_iff.mpr hK
  have := IsLocalRing.of_surjective' (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
  have hmap := IsLocalRing.map_maximalIdeal_of_surjective _ (Ideal.Quotient.mk_surjective (I := K))
  refine isOpen_compl_iff.mp <| isOpen_iff_mem_nhds.mpr fun x hx => ?_
  -- Krull: the image of `x ∉ K` in `S ⧸ K` misses some power of its maximal ideal.
  have hx0 : Ideal.Quotient.mk K x ∉ ⨅ i, maximalIdeal (S ⧸ K) ^ i := by
    rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ (maximalIdeal.isMaximal _).ne_top]
    exact mt Ideal.Quotient.eq_zero_iff_mem.mp hx
  obtain ⟨n, hn⟩ := not_forall.mp (Submodule.mem_iInf _ |>.not.mp hx0)
  refine (Ideal.hasBasis_nhds_adic (maximalIdeal S) x).mem_iff.mpr ⟨n, trivial, ?_⟩
  rintro _ ⟨y, hy, rfl⟩ hxy
  have hxy' : Ideal.Quotient.mk K x = -Ideal.Quotient.mk K y :=
    eq_neg_of_add_eq_zero_left (by rw [← map_add]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hxy)
  refine hn ?_
  rw [← hmap, ← Ideal.map_pow, hxy']
  exact neg_mem (Ideal.mem_map_of_mem _ hy)

/-- The canonical identification `R^ ⧸ J R^ ≃+* (R ⧸ J)^` for a Noetherian local ring `R` and
an ideal `J` with `R ⧸ J` local: the map induced on the quotient by the comparison map
`adicCompletionMapQuotient J : R^ → (R ⧸ J)^` of completions (the map `R → R ⧸ J` completed),
whose kernel is `J R^`. -/
public noncomputable def adicCompletionQuotientEquiv {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (J : Ideal R) [IsLocalRing (R ⧸ J)] :
    (AdicCompletion (maximalIdeal R) R ⧸
        J.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) ≃+*
      AdicCompletion (maximalIdeal (R ⧸ J)) (R ⧸ J) :=
  RingEquiv.ofBijective
    (Ideal.Quotient.lift _ (adicCompletionMapQuotient J)
      fun _ hx => (RingHom.mem_ker).mp ((ker_adicCompletionMapQuotient J).ge hx))
    (by
      convert ((Ideal.quotEquivOfEq (ker_adicCompletionMapQuotient J).symm).trans
        (RingHom.quotientKerEquivOfSurjective (adicCompletionMapQuotient_surjective J))).bijective
        using 1
      funext x
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      rfl)

/-- `adicCompletionQuotientEquiv J` sends the class of `x ∈ R^` to its image under the
comparison map of completions. -/
@[simp]
public theorem adicCompletionQuotientEquiv_mk {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (J : Ideal R) [IsLocalRing (R ⧸ J)]
    (x : AdicCompletion (maximalIdeal R) R) :
    adicCompletionQuotientEquiv J (Ideal.Quotient.mk _ x) = adicCompletionMapQuotient J x := by
  rw [adicCompletionQuotientEquiv, RingEquiv.ofBijective_apply, Ideal.Quotient.lift_mk]

/-- `adicCompletionQuotientEquiv J` sends the class of `r ∈ R` to the image of `r mod J`. -/
public theorem adicCompletionQuotientEquiv_mk_algebraMap {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] (J : Ideal R) [IsLocalRing (R ⧸ J)] (r : R) :
    adicCompletionQuotientEquiv J
        (Ideal.Quotient.mk _ (algebraMap R (AdicCompletion (maximalIdeal R) R) r)) =
      algebraMap (R ⧸ J) (AdicCompletion (maximalIdeal (R ⧸ J)) (R ⧸ J))
        (Ideal.Quotient.mk J r) := by
  rw [adicCompletionQuotientEquiv_mk, completionQuotientMap_algebraMap]

/-- **The completion package for a Noetherian local ring.** For a Noetherian local ring `R`
with completion `R^ = AdicCompletion (maximalIdeal R) R`:
`R^` is Noetherian, its maximal ideal is `𝔪 R^`, it is `maximalIdeal R^`-adically complete and
separated, every ideal of `R^` is closed in the adic topology, for every ideal `J` with
`R ⧸ J` local the canonical isomorphism `adicCompletionQuotientEquiv J : R^ ⧸ J R^ ≃+* (R ⧸ J)^`
sends the class of `r ∈ R` to the image of `r mod J`, `J R^ ∩ R = J`, `R → R^` is faithfully
flat, and the image of a regular system of parameters of `R` is a regular system of parameters of
the regular local ring `R^`. -/
@[mmp "lem_mmp_resolution_noetherian_local_completion_package"]
public theorem adicCompletion_maximalIdeal_package (R : Type*) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] :
    IsNoetherianRing (AdicCompletion (maximalIdeal R) R) ∧
    maximalIdeal (AdicCompletion (maximalIdeal R) R) =
      (maximalIdeal R).map (algebraMap R (AdicCompletion (maximalIdeal R) R)) ∧
    IsAdicComplete (maximalIdeal (AdicCompletion (maximalIdeal R) R))
      (AdicCompletion (maximalIdeal R) R) ∧
    (∀ K : Ideal (AdicCompletion (maximalIdeal R) R),
      @IsClosed _ (maximalIdeal (AdicCompletion (maximalIdeal R) R)).adicTopology
        (K : Set (AdicCompletion (maximalIdeal R) R))) ∧
    (∀ (J : Ideal R) [IsLocalRing (R ⧸ J)] (r : R),
      adicCompletionQuotientEquiv J
          (Ideal.Quotient.mk _ (algebraMap R (AdicCompletion (maximalIdeal R) R) r)) =
        algebraMap (R ⧸ J) (AdicCompletion (maximalIdeal (R ⧸ J)) (R ⧸ J))
          (Ideal.Quotient.mk J r)) ∧
    (∀ J : Ideal R,
      (J.map (algebraMap R (AdicCompletion (maximalIdeal R) R))).comap
        (algebraMap R (AdicCompletion (maximalIdeal R) R)) = J) ∧
    Module.FaithfullyFlat R (AdicCompletion (maximalIdeal R) R) ∧
    (∀ {n : ℕ} (z : Fin n → R), MMP.Mori.IsRegularSystemOfParameters z →
      IsRegularLocalRing (AdicCompletion (maximalIdeal R) R) ∧
        MMP.Mori.IsRegularSystemOfParameters
          (fun i => algebraMap R (AdicCompletion (maximalIdeal R) R) (z i))) := by
  have := isNoetherianRing_adicCompletion R
  have hff : Module.FaithfullyFlat R (AdicCompletion (maximalIdeal R) R) :=
    AdicCompletion.faithfullyFlat_of_le_ringJacobson _ (ringJacobson_eq_maximalIdeal R).ge
  refine ⟨inferInstance, AdicCompletion.maximalIdeal_eq_map, inferInstance,
    isClosed_ideal_adicTopology_maximalIdeal, fun J _ =>
      adicCompletionQuotientEquiv_mk_algebraMap J,
    Ideal.comap_map_eq_self_of_faithfullyFlat, hff,
    fun z hz => ⟨isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp
      (MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz), ?_, ?_⟩⟩
  · rw [Set.range_comp' (algebraMap R _) z, ← Ideal.map_span, hz.1,
      AdicCompletion.maximalIdeal_eq_map]
  · rw [← _root_.ringKrullDim_adicCompletion_maximalIdeal, hz.2]

end MMP.Resolution

/-! ### Minimal primes of a strictly henselian quotient and of its completion

The quotient `C = H ⧸ J` is a strictly henselian Noetherian local G-ring, so its completion map
is regular and, by Stacks 0C2E, `C` and `Ĉ` have the same number of branches; since both are
henselian, these are the numbers of their minimal primes. Contraction along the faithfully flat
map `C → Ĉ` maps minimal primes onto minimal primes, hence bijectively. -/

namespace MMP

open scoped TensorProduct

/-- Geometrically regular algebras over a field are geometrically normal. -/
private theorem isGeometricallyNormal_of_isGeometricallyRegular
    {k : Type u} {R : Type u} [Field k] [CommRing R] [Algebra k R]
    (h : Algebra.IsGeometricallyRegular k R) : Algebra.IsGeometricallyNormal k R := by
  refine ⟨fun L _ _ => ?_⟩
  refine isNormalRing_tensorProduct_of_forall_fg_intermediateField fun F hF => ?_
  let : Algebra.EssFiniteType k F := IntermediateField.essFiniteType_iff.mpr hF
  let : Small.{u} F := Algebra.EssFiniteType.small_of_field k F
  let : IsRegularRing (F ⊗[k] R) := h.isRegularRing_tensorProduct F
  exact main_theorem0567 _

/-- Contraction along an algebra with going down sends minimal primes to minimal primes. -/
private theorem comap_mem_minimalPrimes_of_hasGoingDown {A B : Type*} [CommRing A]
    [CommRing B] [Algebra A B] [Algebra.HasGoingDown A B] {q : Ideal B} (hq : q ∈ minimalPrimes B) :
    q.comap (algebraMap A B) ∈ minimalPrimes A := by
  have : q.IsPrime := hq.1.1
  refine ⟨⟨Ideal.comap_isPrime _ _, bot_le⟩, ?_⟩
  rintro P ⟨hP, -⟩ hPq
  have : q.LiesOver (q.comap (algebraMap A B)) := ⟨rfl⟩
  obtain ⟨P', hP'q, hP', hP'P⟩ := Ideal.exists_ideal_le_liesOver_of_le (p := P) q hPq
  exact (Ideal.comap_mono (hq.2 ⟨hP', bot_le⟩ hP'q)).trans (le_of_eq hP'P.over.symm)

/-- Contraction along an injective algebra map sends the minimal primes onto the minimal primes. -/
private theorem surjOn_comap_minimalPrimes_of_injective {A B : Type*} [CommRing A]
    [CommRing B] [Algebra A B] (hinj : Function.Injective (algebraMap A B)) :
    Set.SurjOn (Ideal.comap (algebraMap A B)) (minimalPrimes B) (minimalPrimes A) := by
  intro p hp
  refine Ideal.exists_minimalPrimes_comap_eq (algebraMap A B) p ?_
  rwa [← RingHom.ker_eq_comap_bot, (RingHom.injective_iff_ker_eq_bot _).mp hinj]

/-- A bijection `g : S → T` transported along injections `u`, `v` intertwining `g` with `f`. -/
private theorem bijOn_image_of_bijOn {α β γ δ : Type*} {f : α → β} {g : γ → δ} {u : γ → α}
    {v : δ → β} {S : Set γ} {T : Set δ} (hg : Set.BijOn g S T) (hv : Function.Injective v)
    (h : ∀ x, f (u x) = v (g x)) : Set.BijOn f (u '' S) (v '' T) := by
  refine ⟨?_, ?_, ?_⟩
  · rintro _ ⟨x, hx, rfl⟩
    exact ⟨g x, hg.mapsTo hx, (h x).symm⟩
  · rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩ hxy
    rw [h, h] at hxy
    rw [hg.injOn hx hy (hv hxy)]
  · rintro _ ⟨z, hz, rfl⟩
    obtain ⟨x, hx, rfl⟩ := hg.surjOn hz
    exact ⟨u x, ⟨x, hx, rfl⟩, h x⟩

/-- For a henselian Noetherian local G-ring `C` with separably closed residue field, contraction
along `C → Ĉ` is a bijection on minimal primes. -/
private theorem bijOn_comap_minimalPrimes_adicCompletion (C : Type u) [CommRing C]
    [HenselianLocalRing C] [IsNoetherianRing C] [IsSepClosed (ResidueField C)]
    (hC : IsGRing C) :
    Set.BijOn (Ideal.comap (algebraMap C (AdicCompletion (maximalIdeal C) C)))
      (minimalPrimes (AdicCompletion (maximalIdeal C) C)) (minimalPrimes C) := by
  set Ch := AdicCompletion (maximalIdeal C) C
  obtain ⟨-, -, -, -, -, -, hff, -⟩ := MMP.Resolution.adicCompletion_maximalIdeal_package C
  have hfg : (maximalIdeal C).FG := (maximalIdeal C).fg_of_isNoetherianRing
  let : IsLocalRing Ch := AdicCompletion.isLocalRing_of_fg hfg
  have : HenselianLocalRing Ch := henselianLocalRing_adicCompletion C hfg
  have hmaps : Set.MapsTo (Ideal.comap (algebraMap C Ch)) (minimalPrimes Ch)
      (minimalPrimes C) := fun _ => comap_mem_minimalPrimes_of_hasGoingDown
  have hsurj := surjOn_comap_minimalPrimes_of_injective
    (RingHom.faithfullyFlat_algebraMap_iff.mpr hff).injective
  have hfin : (minimalPrimes Ch).Finite := minimalPrimes.finite_of_isNoetherianRing Ch
  have : IsSepClosed (ResidueField Ch) :=
    IsSepClosed.of_ringEquiv
      (RingEquiv.ofBijective _ (AdicCompletion.residueField_map_bijective C)).symm
  have : IsHenselization C (ResidueField C) C := isHenselization_self C
  have : IsHenselization Ch (ResidueField Ch) Ch := isHenselization_self Ch
  have hformal : ∀ q : PrimeSpectrum C,
      Algebra.IsGeometricallyNormal q.asIdeal.ResidueField (q.asIdeal.Fiber Ch) := fun q =>
    isGeometricallyNormal_of_isGeometricallyRegular ((isRegularRingHom_algebraMap_iff.mp
      (isRegularRingHom_algebraMap_adicCompletion hC (maximalIdeal C))).2 q.asIdeal).2
  have hcard := (isNagataRing_and_numberOfBranches_and_numberOfGeometricBranches_eq_adicCompletion
    C C Ch C Ch (ResidueField C) (ResidueField Ch) hformal).2.1
  have hcard' : (minimalPrimes Ch).encard = (minimalPrimes C).encard := hcard.symm
  refine ⟨hmaps, Set.injOn_of_ncard_image_eq ?_ hfin, hsurj⟩
  rw [hsurj.image_eq_of_mapsTo hmaps, Set.ncard_def, Set.ncard_def, hcard']

/-- Let `A` be a local ring essentially of finite type over a field `k`, `A → H` a strict
henselization (henselian, ind-étale, `𝔪_A H = 𝔪_H`, residue field a separable closure of that of
`A`), `R` the `𝔪_H`-adic completion of `H` and `I` an ideal of `A`, `J = I H`. Then, for `I`
proper, `H / J` with the map induced from `A / I` is a strict henselization of `A / I` (local,
henselian, ind-étale over `A / I`, `𝔪_{A/I} (H / J) = 𝔪_{H/J}`, residue field a separable
closure of that of `A / I`); `R / J R ≃ (H / J)^` compatibly with `H`; and
`Ideal.comap (algebraMap H R)` is a bijection from the minimal primes of `R` over `J R` onto those
of `H` over `J`. -/
@[mmp "lem_mmp_foundation_strict_hensel_quotient_completion_minimal_primes"]
public theorem minimalPrimes_bijOn_comap_adicCompletion_of_strictHenselization
    (k : Type u) [Field k] {A H : Type u} [CommRing A] [IsLocalRing A] [Algebra k A]
    [Algebra.EssFiniteType k A] [CommRing H] [Algebra A H] [HenselianLocalRing H]
    [IsLocalHom (algebraMap A H)] [IsSepClosure (ResidueField A) (ResidueField H)]
    (hind : (CommAlgCat.etale.{u} A).ind.{u} (CommAlgCat.of A H))
    (hmax : (maximalIdeal A).map (algebraMap A H) = maximalIdeal H)
    (I : Ideal A) :
    (I ≠ ⊤ →
      ∃ (_ : IsLocalRing (A ⧸ I)) (_ : IsLocalRing (H ⧸ I.map (algebraMap A H)))
          (_ : IsLocalHom (algebraMap (A ⧸ I) (H ⧸ I.map (algebraMap A H)))),
        HenselianLocalRing (H ⧸ I.map (algebraMap A H)) ∧
        (CommAlgCat.etale.{u} (A ⧸ I)).ind.{u}
          (CommAlgCat.of (A ⧸ I) (H ⧸ I.map (algebraMap A H))) ∧
        (maximalIdeal (A ⧸ I)).map (algebraMap (A ⧸ I) (H ⧸ I.map (algebraMap A H))) =
          maximalIdeal (H ⧸ I.map (algebraMap A H)) ∧
        IsSepClosure (ResidueField (A ⧸ I)) (ResidueField (H ⧸ I.map (algebraMap A H)))) ∧
    (∃ e : (AdicCompletion (maximalIdeal H) H ⧸
          (I.map (algebraMap A H)).map (algebraMap H (AdicCompletion (maximalIdeal H) H))) ≃+*
        AdicCompletion ((maximalIdeal H).map (Ideal.Quotient.mk (I.map (algebraMap A H))))
          (H ⧸ I.map (algebraMap A H)),
      ∀ h : H, e (Ideal.Quotient.mk _ (algebraMap H (AdicCompletion (maximalIdeal H) H) h)) =
        algebraMap (H ⧸ I.map (algebraMap A H)) _ (Ideal.Quotient.mk _ h)) ∧
    Set.BijOn (Ideal.comap (algebraMap H (AdicCompletion (maximalIdeal H) H)))
      ((I.map (algebraMap A H)).map
        (algebraMap H (AdicCompletion (maximalIdeal H) H))).minimalPrimes
      (I.map (algebraMap A H)).minimalPrimes := by
  refine ⟨fun hI => IsLocalRing.strictHenselization_quotient hind hmax I (le_maximalIdeal hI), ?_⟩
  set J := I.map (algebraMap A H)
  set R := AdicCompletion (maximalIdeal H) H
  have hAG : IsGRing A :=
    isGRing_of_essFiniteType (R := k) (isGRing_basic_examples.{u, u}.1 k)
  have : IsHenselization A (ResidueField H) H :=
    IsHenselization.of_ind_etale.{u, u, u} inferInstance hind
      ⟨RingEquiv.refl _, fun x => by simp⟩
  obtain ⟨Ah, _, _, _, _⟩ := IsLocalRing.exists_isHenselization_residueField A
  have hHG : IsGRing H :=
    (isGRing_henselization_and_strictHenselization A Ah H (ResidueField H) hAG).2
  have : IsNoetherianRing H := hHG.1
  have : IsSepClosed (ResidueField H) := IsSepClosure.sep_closed (ResidueField A)
  by_cases hJ : J = ⊤
  · have hJR : J.map (algebraMap H R) = ⊤ := by rw [hJ, Ideal.map_top]
    refine ⟨?_, ?_⟩
    · have : Subsingleton (R ⧸ J.map (algebraMap H R)) :=
        Ideal.Quotient.subsingleton_iff.mpr hJR
      have : Subsingleton (H ⧸ J) := Ideal.Quotient.subsingleton_iff.mpr hJ
      have : Subsingleton (AdicCompletion ((maximalIdeal H).map (Ideal.Quotient.mk J))
          (H ⧸ J)) := ⟨fun a b => AdicCompletion.ext fun n => Subsingleton.elim _ _⟩
      refine ⟨
        { toFun := fun _ => 0
          invFun := fun _ => 0
          left_inv := fun _ => Subsingleton.elim _ _
          right_inv := fun _ => Subsingleton.elim _ _
          map_mul' := fun _ _ => Subsingleton.elim _ _
          map_add' := fun _ _ => Subsingleton.elim _ _ }, fun _ => Subsingleton.elim _ _⟩
    · rw [hJR, hJ, Ideal.minimalPrimes_top, Ideal.minimalPrimes_top]
      exact Set.bijOn_empty _
  have : HenselianLocalRing (H ⧸ J) := Stacks.Henselian.henselianLocalRing_quotient hJ
  set C := H ⧸ J
  set π := Ideal.Quotient.mk J
  have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
  rw [map_maximalIdeal_of_surjective _ hπ]
  obtain ⟨-, -, -, -, hq, -, -, -⟩ := MMP.Resolution.adicCompletion_maximalIdeal_package H
  set e := MMP.Resolution.adicCompletionQuotientEquiv J
  have he := hq J
  refine ⟨⟨e, he⟩, ?_⟩
  have hCG : IsGRing C := isGRing_of_essFiniteType hHG
  have : IsNoetherianRing C := hCG.1
  have : IsLocalHom π := IsLocalHom.of_surjective _ hπ
  have : IsSepClosed (ResidueField C) := IsSepClosed.of_ringEquiv
    (RingEquiv.ofBijective (ResidueField.map π)
      ⟨(ResidueField.map π).injective, fun y => by
        obtain ⟨c, rfl⟩ := residue_surjective y
        obtain ⟨h, rfl⟩ := hπ c
        exact ⟨residue H h, ResidueField.map_residue _ h⟩⟩).symm
  set Ch := AdicCompletion (maximalIdeal C) C
  let ψ : R →+* Ch := e.toRingHom.comp (Ideal.Quotient.mk (J.map (algebraMap H R)))
  have hψ : Function.Surjective ψ := e.surjective.comp Ideal.Quotient.mk_surjective
  have hkψ : (⊥ : Ideal Ch).comap ψ = J.map (algebraMap H R) := by
    ext x; simp [ψ, Ideal.Quotient.eq_zero_iff_mem]
  have hkπ : (⊥ : Ideal C).comap π = J := by
    ext x; simpa [π] using Ideal.Quotient.eq_zero_iff_mem
  have hcomm : ψ.comp (algebraMap H R) = (algebraMap C Ch).comp π := RingHom.ext he
  have e1 : (J.map (algebraMap H R)).minimalPrimes = Ideal.comap ψ '' minimalPrimes Ch := by
    rw [← hkψ]; exact Ideal.comap_minimalPrimes_eq_of_surjective hψ ⊥
  have e2 : J.minimalPrimes = Ideal.comap π '' minimalPrimes C := by
    have := Ideal.comap_minimalPrimes_eq_of_surjective hπ ⊥
    rwa [hkπ] at this
  rw [e1, e2]
  refine bijOn_image_of_bijOn (bijOn_comap_minimalPrimes_adicCompletion C hCG)
    (Ideal.comap_injective_of_surjective π hπ) fun Q => ?_
  rw [Ideal.comap_comap, Ideal.comap_comap, hcomm]

end MMP

/-! ### Exact multiplication of maximal coefficient ideals of small maximal order -/

namespace MMP.Resolution.Kollar

open AlgebraicGeometry

/-- A multiset of weights `1, 2, 3` of total at least `8` has a submultiset of weight `6`. -/
private theorem exists_six (a₁ a₂ a₃ : ℕ) (h : 8 ≤ a₁ + 2 * a₂ + 3 * a₃) :
    ∃ b₁ b₂ b₃ : ℕ, b₁ ≤ a₁ ∧ b₂ ≤ a₂ ∧ b₃ ≤ a₃ ∧ b₁ + 2 * b₂ + 3 * b₃ = 6 := by
  by_cases h3 : 2 ≤ a₃
  · exact ⟨0, 0, 2, by omega, by omega, h3, rfl⟩
  by_cases h2 : 3 ≤ a₂
  · exact ⟨0, 3, 0, by omega, h2, by omega, rfl⟩
  by_cases h32 : a₃ = 1 ∧ a₂ = 2
  · exact ⟨1, 1, 1, by omega, by omega, by omega, rfl⟩
  · exact ⟨6 - (2 * a₂ + 3 * a₃), a₂, a₃, by omega, le_rfl, le_rfl, by omega⟩

/-- A multiset of weights `1, 2, 3` of total at least `6n + 2` has a submultiset of
weight `6n`. -/
private theorem exists_six_mul (n a₁ a₂ a₃ : ℕ) (h : 6 * n + 2 ≤ a₁ + 2 * a₂ + 3 * a₃) :
    ∃ b₁ b₂ b₃ : ℕ, b₁ ≤ a₁ ∧ b₂ ≤ a₂ ∧ b₃ ≤ a₃ ∧ b₁ + 2 * b₂ + 3 * b₃ = 6 * n := by
  induction n generalizing a₁ a₂ a₃ with
  | zero => exact ⟨0, 0, 0, by omega, by omega, by omega, rfl⟩
  | succ n ih =>
    obtain ⟨c₁, c₂, c₃, h₁, h₂, h₃, hc⟩ := exists_six a₁ a₂ a₃ (by omega)
    obtain ⟨b₁, b₂, b₃, g₁, g₂, g₃, hb⟩ := ih (a₁ - c₁) (a₂ - c₂) (a₃ - c₃) (by omega)
    exact ⟨b₁ + c₁, b₂ + c₂, b₃ + c₃, by omega, by omega, by omega, by omega⟩

/-- A multiset of weights `1, …, 4` of total at least `36` has a submultiset of weight `12`. -/
private theorem exists_twelve (a₁ a₂ a₃ a₄ : ℕ) (h : 36 ≤ a₁ + 2 * a₂ + 3 * a₃ + 4 * a₄) :
    ∃ b₁ b₂ b₃ b₄ : ℕ, b₁ ≤ a₁ ∧ b₂ ≤ a₂ ∧ b₃ ≤ a₃ ∧ b₄ ≤ a₄ ∧
      b₁ + 2 * b₂ + 3 * b₃ + 4 * b₄ = 12 := by
  by_cases h4 : 3 ≤ a₄
  · exact ⟨0, 0, 0, 3, by omega, by omega, by omega, h4, rfl⟩
  by_cases h3 : 4 ≤ a₃
  · exact ⟨0, 0, 4, 0, by omega, by omega, h3, by omega, rfl⟩
  by_cases h2 : 6 ≤ a₂
  · exact ⟨0, 6, 0, 0, by omega, h2, by omega, by omega, rfl⟩
  · exact ⟨12 - 2 * a₂, a₂, 0, 0, by omega, le_rfl, by omega, by omega, by omega⟩

/-- A multiset of weights `1, …, 5` of total at least `180` has a submultiset of weight `60`. -/
private theorem exists_sixty (a₁ a₂ a₃ a₄ a₅ : ℕ)
    (h : 180 ≤ a₁ + 2 * a₂ + 3 * a₃ + 4 * a₄ + 5 * a₅) :
    ∃ b₁ b₂ b₃ b₄ b₅ : ℕ, b₁ ≤ a₁ ∧ b₂ ≤ a₂ ∧ b₃ ≤ a₃ ∧ b₄ ≤ a₄ ∧ b₅ ≤ a₅ ∧
      b₁ + 2 * b₂ + 3 * b₃ + 4 * b₄ + 5 * b₅ = 60 := by
  by_cases h5 : 12 ≤ a₅
  · exact ⟨0, 0, 0, 0, 12, by omega, by omega, by omega, by omega, h5, rfl⟩
  by_cases h4 : 15 ≤ a₄
  · exact ⟨0, 0, 0, 15, 0, by omega, by omega, by omega, h4, by omega, rfl⟩
  by_cases h45 : 10 ≤ a₄ ∧ 4 ≤ a₅
  · exact ⟨0, 0, 0, 10, 4, by omega, by omega, by omega, h45.1, h45.2, rfl⟩
  by_cases h45' : 5 ≤ a₄ ∧ 8 ≤ a₅
  · exact ⟨0, 0, 0, 5, 8, by omega, by omega, by omega, h45'.1, h45'.2, rfl⟩
  obtain ⟨b₁, b₂, b₃, g₁, g₂, g₃, hb⟩ := exists_six_mul 10 a₁ a₂ a₃ (by omega)
  exact ⟨b₁, b₂, b₃, 0, 0, g₁, g₂, g₃, by omega, by omega, by omega⟩

/-- For `m ≤ 5`, a monomial in `u₁, …, u_m` (`deg uᵢ = i`) of degree at least `L + m!`,
`L = lcm(2, …, m)`, is divisible by a monomial of degree exactly `L`. -/
private theorem exists_le_weight_eq_lcmUpTo (m : ℕ) (hm : m ≤ 5) (u : Fin m → ℕ)
    (h : lcmUpTo m + m.factorial ≤ ∑ i, u i * monomialWeight m i) :
    ∃ e : Fin m → ℕ, e ≤ u ∧ ∑ i, e i * monomialWeight m i = lcmUpTo m := by
  interval_cases m
  · simp at h
  · have hL : lcmUpTo 1 = 1 := by decide +kernel
    simp [monomialWeight, hL] at h
    refine ⟨![1], fun i => ?_, by simp [monomialWeight, hL]⟩
    fin_cases i; simp; omega
  · have hL : lcmUpTo 2 = 2 := by decide +kernel
    simp [monomialWeight, hL, Fin.sum_univ_two, Nat.factorial] at h
    by_cases h1 : 1 ≤ u 1
    · refine ⟨![0, 1], fun i => ?_, by simp [monomialWeight, hL, Fin.sum_univ_two]⟩
      fin_cases i <;> simp
      omega
    · refine ⟨![2, 0], fun i => ?_, by simp [monomialWeight, hL, Fin.sum_univ_two]⟩
      fin_cases i <;> simp
      omega
  · have hL : lcmUpTo 3 = 6 := by decide +kernel
    simp [monomialWeight, hL, Fin.sum_univ_three, Nat.factorial] at h
    obtain ⟨b₁, b₂, b₃, g₁, g₂, g₃, hb⟩ := exists_six (u 0) (u 1) (u 2) (by omega)
    refine ⟨![b₁, b₂, b₃], fun i => ?_, ?_⟩
    · fin_cases i <;> simpa
    · simp [monomialWeight, hL, Fin.sum_univ_three]; omega
  · have hL : lcmUpTo 4 = 12 := by decide +kernel
    simp [monomialWeight, hL, Fin.sum_univ_four, Nat.factorial] at h
    obtain ⟨b₁, b₂, b₃, b₄, g₁, g₂, g₃, g₄, hb⟩ :=
      exists_twelve (u 0) (u 1) (u 2) (u 3) (by omega)
    refine ⟨![b₁, b₂, b₃, b₄], fun i => ?_, ?_⟩
    · fin_cases i <;> simpa
    · simp [monomialWeight, hL, Fin.sum_univ_four]; omega
  · have hL : lcmUpTo 5 = 60 := by decide +kernel
    simp [monomialWeight, hL, Fin.sum_univ_five, Nat.factorial] at h
    obtain ⟨b₁, b₂, b₃, b₄, b₅, g₁, g₂, g₃, g₄, g₅, hb⟩ :=
      exists_sixty (u 0) (u 1) (u 2) (u 3) (u 4) (by omega)
    refine ⟨![b₁, b₂, b₃, b₄, b₅], fun i => ?_, ?_⟩
    · fin_cases i <;> simpa
    · simp [monomialWeight, hL, Fin.sum_univ_five]; omega

/-- For `m ≤ 5`, a monomial of degree at least `rL + m!` is a product `U₁ U₂` with
`deg U₁ = rL`. -/
private theorem exists_split_of_le_five (m : ℕ) (hm : m ≤ 5) (r : ℕ) (u : Fin m → ℕ)
    (h : r * lcmUpTo m + m.factorial ≤ ∑ i, u i * monomialWeight m i) :
    ∃ u₁ u₂ : Fin m → ℕ, u = u₁ + u₂ ∧ ∑ i, u₁ i * monomialWeight m i = r * lcmUpTo m := by
  induction r generalizing u with
  | zero => exact ⟨0, u, by simp, by simp⟩
  | succ r ih =>
    obtain ⟨e, hle, he⟩ := exists_le_weight_eq_lcmUpTo m hm u (by
      have : lcmUpTo m ≤ (r + 1) * lcmUpTo m := Nat.le_mul_of_pos_left _ (by omega)
      omega)
    have hsum : ∑ i, u i * monomialWeight m i =
        ∑ i, e i * monomialWeight m i + ∑ i, (u - e) i * monomialWeight m i := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Pi.sub_apply, ← add_mul, add_tsub_cancel_of_le (hle i)]
    obtain ⟨u₁, u₂, h1, h2⟩ := ih (u - e) (by rw [hsum, he, add_mul, one_mul] at h; omega)
    refine ⟨u₁ + e, u₂, funext fun i => ?_, ?_⟩
    · have h3 : u i - e i = u₁ i + u₂ i := congrFun h1 i
      have h4 : e i ≤ u i := hle i
      change u i = u₁ i + e i + u₂ i
      omega
    · simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib, h2, he, one_mul]

/-- For `m ≤ 5`, an exponent vector `c ∈ ℕ^{m+1}` of weight at least `rL + m!` is a sum
`c₁ + c₂` with `c₁` of weight exactly `rL`. -/
private theorem exists_coefficient_split (m : ℕ) (hm : m ≤ 5) (r : ℕ) (c : Fin (m + 1) → ℕ)
    (hc : r * lcmUpTo m + m.factorial ≤ coefficientWeight m c) :
    ∃ c₁ c₂, c = c₁ + c₂ ∧ coefficientWeight m c₁ = r * lcmUpTo m := by
  obtain ⟨u₁, u₂, hU, hU₁⟩ :=
    exists_split_of_le_five m hm r (fun i => c i.rev.castSucc)
      (coefficientWeight_eq_sum_rev m c ▸ hc)
  refine ⟨Fin.snoc (α := fun _ => ℕ) (fun i => u₁ i.rev) 0,
    Fin.snoc (α := fun _ => ℕ) (fun i => u₂ i.rev) (c (Fin.last m)), ?_, ?_⟩
  · funext j
    induction j using Fin.lastCases with
    | last => simp
    | cast i => simpa using congrFun hU i.rev
  · rw [coefficientWeight_eq_sum_rev, ← hU₁]
    simp

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))

/-- If every exponent vector of weight at least `s + t` splits as a sum of one of weight at
least `s` and one of weight at least `t`, then `W_{s+t}(I) ⊆ W_s(I) · W_t(I)`. -/
private theorem le_mul_of_forall_exists_split (I : X.IdealSheafData) (s t : ℤ)
    (h : ∀ c : Fin ((maxOrder I).toNat + 1) → ℕ, s + t ≤ coefficientWeight _ c →
      ∃ c₁ c₂, c = c₁ + c₂ ∧ s ≤ coefficientWeight _ c₁ ∧ t ≤ coefficientWeight _ c₂) :
    maximalCoefficientIdeal sX I (s + t) ≤
      maximalCoefficientIdeal sX I s * maximalCoefficientIdeal sX I t := by
  unfold maximalCoefficientIdeal
  refine iSup_le fun c => iSup_le fun hc => ?_
  obtain ⟨c₁, c₂, rfl, h₁, h₂⟩ := h c hc
  rw [iSup_mul_idealSheaf]
  refine le_iSup_of_le c₁ ?_
  rw [iSup_mul_idealSheaf]
  refine le_iSup_of_le h₁ ?_
  rw [mul_iSup_idealSheaf]
  refine le_iSup_of_le c₂ ?_
  rw [mul_iSup_idealSheaf]
  refine le_iSup_of_le h₂ (le_of_eq ?_)
  rw [← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun j _ => by rw [Pi.add_apply, pow_add]

/-- Let `I` be an ideal sheaf with `m = maxord I ≤ 5` and `L = lcm(2, …, m)`. If `s = rL` and
`t ≥ m!`, then `W_s(I) · W_t(I) = W_{s+t}(I)`. For `m ∈ {3, 4, 5}` this improves the bound
`t ≥ (m - 1)L` of `MMP.Resolution.Kollar.maximalCoefficientIdeal_mul_eq`. -/
@[mmp "lem_mmp_foundation_small_weight_coefficient_ideal_product"]
public theorem maximalCoefficientIdeal_mul_eq_of_maxOrder_le_five (I : X.IdealSheafData)
    (hm : (maxOrder I).toNat ≤ 5) (r : ℕ) (t : ℤ)
    (ht : ((maxOrder I).toNat.factorial : ℤ) ≤ t) :
    maximalCoefficientIdeal sX I ((r * lcmUpTo (maxOrder I).toNat : ℕ) : ℤ) *
        maximalCoefficientIdeal sX I t =
      maximalCoefficientIdeal sX I ((r * lcmUpTo (maxOrder I).toNat : ℕ) + t) := by
  refine le_antisymm (maximalCoefficientIdeal_mul_le sX I _ t)
    (le_mul_of_forall_exists_split sX I _ t fun c hc => ?_)
  obtain ⟨c₁, c₂, rfl, h₁⟩ := exists_coefficient_split _ hm r c (by omega)
  rw [coefficientWeight_add] at hc
  exact ⟨c₁, c₂, rfl, by omega, by omega⟩

end MMP.Resolution.Kollar

/-! ### The negative of the graph divisor is relatively ample

Choose `m₁, m₂ > 0` with `L₁ = -m₁ D⁻` Cartier and `f⁻`-ample and `L₂ = m₂ D⁺` Cartier and
`f⁺`-ample. Then `𝒪(m₂ L₁)` and `𝒪(m₁ L₂)` are relatively ample, so on `X⁻ ×_Z X⁺` the external
tensor product `p₁^* 𝒪(m₂ L₁) ⊗ p₂^* 𝒪(m₁ L₂)` is ample over `Z` (Stacks 0DNK). Its pull-back
along the finite morphism `(u, v) : G ⟶ X⁻ ×_Z X⁺` is ample over `Z` (Stacks 0892), and it is
the divisorial sheaf of the Cartier divisor `m₁ m₂ (-H)`. -/

namespace MMP.Fourfold

open CategoryTheory AlgebraicGeometry Limits RingedSpaceModuleAdjunction MMP.Mori Stacks.Ample
  Stacks.RelativeVeryAmple

section

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

/-- `Supp (n • B) ⊆ Supp B`. -/
private theorem supp_zsmul_le {Y : Scheme.{0}} (B : Divisor Y) (n : ℤ) :
    (n • B).supp ≤ B.supp := by
  intro y hy
  rw [DivisorWithCoeffs.mem_supp_iff] at hy ⊢
  obtain ⟨E, hE, hyE⟩ := hy
  exact ⟨E, fun h => hE (by rw [DivisorWithCoeffs.coeff_smul, h, smul_zero]), hyE⟩

/-- `𝒪_X(d D) ≅ 𝒪_X(D)^{⊗ d}` for a Cartier divisor `D` and `d ≥ 1`. -/
private theorem nonempty_divisorialSheaf_zsmul_iso {X : Scheme.{0}} [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {D : Divisor X} (hD : D.IsCartier) (d : ℕ)
    (hd : 1 ≤ d) :
    haveI := hD.isInvertibleModule_divisorialSheaf
    Nonempty (((d : ℤ) • D).divisorialSheaf ≅ tensorPowModule X D.divisorialSheaf (d : ℤ)) := by
  have := hD.isInvertibleModule_divisorialSheaf
  induction d, hd using Nat.le_induction with
  | base =>
    exact ⟨eqToIso (congrArg Divisor.divisorialSheaf (by rw [Nat.cast_one, one_smul])) ≪≫
      (tensorPowModuleOneIso X _).symm⟩
  | succ n hn ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso
        (congrArg Divisor.divisorialSheaf (by rw [Nat.cast_succ, add_smul, one_smul])) ≪≫
      ((hD.zsmul n).divisorialSheafTensorIso hD).symm ≪≫
      tensorModulesMapIso X e (tensorPowModuleOneIso X _).symm ≪≫
      tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr X _ (by push_cast; rfl)⟩

/-- If the Cartier divisor `D` is `f`-ample for a quasi-compact `f`, then so is `d D`, `d ≥ 1`,
in the sense of Stacks Tag 01VH. -/
private theorem isRelativelyAmple_zsmul {X Y : Scheme.{0}} [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ Y) [QuasiCompact f] {D : Divisor X}
    (hD : D.IsCartier) (hamp : D.IsRelativelyAmple f hD) (d : ℕ) (hd : 1 ≤ d) :
    haveI := (hD.zsmul (d : ℤ)).isInvertibleModule_divisorialSheaf
    Stacks.RelativeAmple.IsRelativelyAmple f ((d : ℤ) • D).divisorialSheaf := by
  have := hD.isInvertibleModule_divisorialSheaf
  have := (hD.zsmul (d : ℤ)).isInvertibleModule_divisorialSheaf
  obtain ⟨e⟩ := nonempty_divisorialSheaf_zsmul_iso hD d hd
  have h1 : Stacks.RelativeAmple.IsRelativelyAmple f D.divisorialSheaf :=
    Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple f _
      inferInstance hamp
  exact (isRelativelyAmple_congr f _ _ e).mpr
    (Stacks.Tag01VUReduction.isRelativelyAmple_tensorPowModule_of_isRelativelyAmple f _ d hd h1)

/-- **Sum of pulled-back relatively ample divisors.** Let `A₁` be `f₁`-ample on
`X₁` and `A₂` be `f₂`-ample on `X₂` (Cartier, Stacks Tag 01VH), and let `u : G ⟶ X₁`,
`v : G ⟶ X₂` be maps over `Z` with `(u, v) : G ⟶ X₁ ×_Z X₂` finite. Then
`u^* A₁ + v^* A₂` is `u ≫ f₁`-ample. -/
private theorem isRelativelyAmple_add_of_isPullback {X₁ X₂ Z G : Scheme.{0}} [CompactSpace X₁]
    [IsLocallyNoetherian X₁] [IsNormal X₁] [CompactSpace X₂] [IsLocallyNoetherian X₂]
    [IsNormal X₂] [IsIntegral G] [CompactSpace G] [IsLocallyNoetherian G] [IsNormal G]
    {f₁ : X₁ ⟶ Z} {f₂ : X₂ ⟶ Z} [QuasiCompact f₁] [QuasiCompact f₂] {u : G ⟶ X₁} {v : G ⟶ X₂}
    (huv : u ≫ f₁ = v ≫ f₂) [IsFinite (pullback.lift u v huv)]
    {A₁ : Divisor X₁} {A₂ : Divisor X₂} (hA₁ : A₁.IsCartier) (hA₂ : A₂.IsCartier)
    (ha₁ : haveI := hA₁.isInvertibleModule_divisorialSheaf
      Stacks.RelativeAmple.IsRelativelyAmple f₁ A₁.divisorialSheaf)
    (ha₂ : haveI := hA₂.isInvertibleModule_divisorialSheaf
      Stacks.RelativeAmple.IsRelativelyAmple f₂ A₂.divisorialSheaf)
    {M₁ M₂ : Divisor G}
    {hB₁ : ∀ T : irreducibleComponents G, u (componentGenericPoint G T) ∉ A₁.supp}
    {hB₂ : ∀ T : irreducibleComponents G, v (componentGenericPoint G T) ∉ A₂.supp}
    (hq₁ : A₁.IsPullback u hB₁ M₁) (hq₂ : A₂.IsPullback v hB₂ M₂) :
    (M₁ + M₂).IsRelativelyAmple (u ≫ f₁) ((hq₁.isCartier hA₁).add (hq₂.isCartier hA₂)) := by
  have := hA₁.isInvertibleModule_divisorialSheaf
  have := hA₂.isInvertibleModule_divisorialSheaf
  have := ((hq₁.isCartier hA₁).add (hq₂.isCartier hA₂)).isInvertibleModule_divisorialSheaf
  have key := Stacks.AmpleFibreNeighbourhood.isRelativelyAmple_pullbackModule_of_isAffineHom
    (pullback.lift u v huv) (pullback.fst f₁ f₂ ≫ f₁) _
    (Stacks.AmpleExternalTensor.isRelativelyAmple_tensorModules_of_isPullback f₁ f₂ _ _
      (IsPullback.of_hasPullback f₁ f₂) ha₁ ha₂)
  rw [pullback.lift_fst_assoc] at key
  refine MMP.Mori.IsRelativelyAmple.of_stacks _ _ ((isRelativelyAmple_congr _ _ _ ?_).mp key)
  exact pullbackTensorModulesIso _ _ _ ≪≫
    tensorModulesMapIso G
      ((Scheme.Modules.pullbackComp _ _).app _ ≪≫
        (Scheme.Modules.pullbackCongr (pullback.lift_fst _ _ _)).app _ ≪≫
        (hq₁.divisorialSheafIso (hBc := hA₁)).symm)
      ((Scheme.Modules.pullbackComp _ _).app _ ≪≫
        (Scheme.Modules.pullbackCongr (pullback.lift_snd _ _ _)).app _ ≪≫
        (hq₂.divisorialSheafIso (hBc := hA₂)).symm) ≪≫
    (hq₁.isCartier hA₁).divisorialSheafTensorIso (hq₂.isCartier hA₂)

variable {Xm Xp Z G : Scheme.{0}} [CompactSpace Xm] [IsLocallyNoetherian Xm] [IsNormal Xm]
  [CompactSpace Xp] [IsLocallyNoetherian Xp] [IsNormal Xp]
  [CompactSpace G] [IsLocallyNoetherian G] [IsNormal G]

/-- For a threefold step diagram `(X⁻, B⁻) → Z ← (X⁺, B⁺)` with normalized graph `(G, u, v)` and
graph divisor `H`, the divisor `-H` is ample over `Z` for the structure morphism
`u ≫ f⁻ : G ⟶ Z`. -/
@[mmp "lem_mmp_indexc_graph_minus_h_ample"]
public theorem IsThreefoldGraphDivisor.hasRelativelyAmpleMultiple_neg
    {sXm : Xm ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {sXp : Xp ⟶ Spec (.of ℂ)}
    {K : Divisor Xm} {B : QDivisor Xm} {fm : Xm ⟶ Z} {fp : Xp ⟶ Z} {u : G ⟶ Xm} {v : G ⟶ Xp}
    {H : QDivisor G} (h : IsThreefoldGraphDivisor sXm sZ sXp K B fm fp u v H) :
    (-H).HasRelativelyAmpleMultiple (u ≫ fm) := by
  have hD := h.isThreefoldStepDiagram
  have hG := h.isNormalizedGraph
  have := hG.isIntegral
  have : QuasiCompact fm :=
    haveI := isProper_of_isProjectiveMorphism _ hD.isProjectiveMorphism_minus; inferInstance
  have : QuasiCompact fp :=
    haveI := isProper_of_isProjectiveMorphism _ hD.isProjectiveMorphism_plus; inferInstance
  have : IsFinite (pullback.lift u v hG.comp_eq) := hG.isFinite
  obtain ⟨Hm, Hp, hm, hp, hHm, hHp, rfl⟩ := h.exists_pullback
  obtain ⟨m₁, hm₁, L₁, hL₁c, hL₁, hL₁a⟩ := hD.hasRelativelyAmpleMultiple_minus
  obtain ⟨m₂, hm₂, L₂, hL₂c, hL₂, hL₂a⟩ := hD.hasRelativelyAmpleMultiple_plus
  obtain ⟨D₁, hD₁, hp₁⟩ := hHm m₁ hm₁ (-L₁) (by rw [map_neg, hL₁, smul_neg, neg_neg]) hL₁c.neg
  obtain ⟨D₂, hD₂, hp₂⟩ := hHp m₂ hm₂ L₂ hL₂ hL₂c
  have hsupp₁ : (-L₁).supp = (Divisor.toQDivisor K + B).supp := by
    rw [DivisorWithCoeffs.supp_neg,
      QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm₁.ne') hL₁, DivisorWithCoeffs.supp_neg]
  have hsupp₂ := QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm₂.ne') hL₂
  have hq₁ : (((m₂ : ℕ) : ℤ) • L₁).IsPullback u
      (fun T hT => hm T (by rw [← hsupp₁, DivisorWithCoeffs.supp_neg]; exact supp_zsmul_le L₁ _ hT))
      ((-((m₂ : ℕ) : ℤ)) • D₁) :=
    Divisor.IsPullback.of_eq (neg_smul_neg _ _) (hp₁.zsmul hL₁c.neg _
      fun T hT => hm T (hsupp₁ ▸ supp_zsmul_le (-L₁) _ hT))
  have hq₂ := hp₂.zsmul hL₂c ((m₁ : ℕ) : ℤ) fun T hT => hp T (hsupp₂ ▸ supp_zsmul_le L₂ _ hT)
  have hA₁ := hL₁c.zsmul ((m₂ : ℕ) : ℤ)
  have hA₂ := hL₂c.zsmul ((m₁ : ℕ) : ℤ)
  refine ⟨m₁ * m₂, Nat.mul_pos hm₁ hm₂, _, (hq₁.isCartier hA₁).add (hq₂.isCartier hA₂), ?_,
    isRelativelyAmple_add_of_isPullback hG.comp_eq hA₁ hA₂
      (isRelativelyAmple_zsmul fm hL₁c hL₁a m₂ hm₂) (isRelativelyAmple_zsmul fp hL₂c hL₂a m₁ hm₁)
      hq₁ hq₂⟩
  rw [map_add, map_zsmul, map_zsmul, hD₁, hD₂, smul_smul, smul_smul]
  push_cast
  module

end

end MMP.Fourfold
