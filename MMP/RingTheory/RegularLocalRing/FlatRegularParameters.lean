public import MMP.Attr
public import MMP.AlgebraicGeometry.Divisor.SNC
public import StacksFrontier.RingTheory.RegularLocalRing.FlatLocalHom

/-!
# Regular parameters along a flat local homomorphism

Let `A → B` be a flat local homomorphism of Noetherian local rings, and write
`F = B / 𝔪_A B` for its closed fibre. If `A` and `F` are regular, then `B` is regular, of
dimension `dim B = dim A + dim F`, and a regular system of parameters of `B` is obtained by
concatenating the images in `B` of a regular system of parameters `a₁, …, a_r` of `A` with
arbitrary lifts `b₁, …, b_s ∈ B` of a regular system of parameters of `F`.

Regularity of `B` and the dimension formula are the corresponding results for flat local
homomorphisms (Stacks 00OF and 00ON). For the parameters, the `aᵢ` and `bⱼ` lie in `𝔪_B`;
conversely, for `x ∈ 𝔪_B` the class of `x` in `F` is a combination of the classes of the `bⱼ`,
so `x` minus a combination of the `bⱼ` lies in `𝔪_A B`, which is generated by the `aᵢ`. There
are `r + s = dim B` of them.

## Main results

* `MMP.Flips.ResolutionInputs.isRegularSystemOfParameters_append_of_flat`: the images of a
  regular system of parameters of `A` followed by lifts of one of the closed fibre form a regular
  system of parameters of `B`.
* `MMP.Flips.ResolutionInputs.isRegularLocalRing_and_isRegularSystemOfParameters_append_of_flat`:
  `B` is regular, `dim B = dim A + dim F`, and the concatenated parameters are parameters of `B`.

## Implementation notes

The closed fibre is `ClosedFibre A B`, the quotient `B ⧸ (maximalIdeal A).map (algebraMap A B)`.
Regular systems of parameters are `MMP.Mori.IsRegularSystemOfParameters`, families `Fin n → R`
with `n = dim R` spanning the maximal ideal; the concatenation is `Fin.append`.

## References

* [Stacks Project, Tag 00OF](https://stacks.math.columbia.edu/tag/00OF)
* [Stacks Project, Tag 00ON](https://stacks.math.columbia.edu/tag/00ON)
-/

@[expose] public section

open IsLocalRing

namespace MMP.Flips.ResolutionInputs

open MMP.Mori

variable {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsNoetherianRing A]
  [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]
  [Module.Flat A B]

/-- Along a flat local homomorphism `A → B` of Noetherian local rings, the images of a regular
system of parameters `a` of `A`, followed by lifts `b` to `B` of a regular system of parameters
`bbar` of the closed fibre `B / 𝔪_A B`, form a regular system of parameters of `B`. -/
theorem isRegularSystemOfParameters_append_of_flat {r s : ℕ} {a : Fin r → A}
    (ha : IsRegularSystemOfParameters a) {bbar : Fin s → ClosedFibre A B}
    (hb : IsRegularSystemOfParameters bbar) {b : Fin s → B}
    (hbb : Ideal.Quotient.mk _ ∘ b = bbar) :
    IsRegularSystemOfParameters (Fin.append (algebraMap A B ∘ a) b) := by
  set I := Ideal.span (Set.range (Fin.append (algebraMap A B ∘ a) b))
  set J := (maximalIdeal A).map (algebraMap A B)
  have hbmem (j : Fin s) : b j ∈ maximalIdeal B := by
    by_contra h
    have hu : IsUnit (b j) := by simpa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using h
    have hm : bbar j ∈ maximalIdeal (ClosedFibre A B) := by
      rw [← hb.1]; exact Ideal.subset_span ⟨j, rfl⟩
    rw [← hbb] at hm
    exact (IsLocalRing.mem_maximalIdeal _).1 hm (hu.map _)
  have hker : J ≤ I := by
    simp only [J]
    rw [← ha.1, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    exact Ideal.subset_span ⟨Fin.castAdd s i, by simp⟩
  have hmap : maximalIdeal (ClosedFibre A B) ≤ I.map (Ideal.Quotient.mk J) := by
    rw [← hb.1, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [← hbb]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨Fin.natAdd r j, by simp⟩)
  refine ⟨le_antisymm ?_ ?_, ?_⟩
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    refine Fin.addCases (fun i => ?_) (fun j => ?_) i
    · simp only [Fin.append_left, Function.comp_apply]
      exact ClosedFibre.mapMaximalIdeal_le A B
        (Ideal.mem_map_of_mem _ (ha.1 ▸ Ideal.subset_span ⟨i, rfl⟩))
    · simpa using hbmem j
  · intro x hx
    have hx' : Ideal.Quotient.mk J x ∈ maximalIdeal (ClosedFibre A B) := by
      refine (IsLocalRing.mem_maximalIdeal _).2 fun hu => ?_
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (hu.unit⁻¹ : (ClosedFibre A B)ˣ).1
      have hy' : Ideal.Quotient.mk J y = ↑hu.unit⁻¹ := hy
      have h1 : x * y - 1 ∈ J := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_one, hy', sub_eq_zero]
        exact hu.mul_val_inv
      have h2 : x * y - 1 ∈ maximalIdeal B := ClosedFibre.mapMaximalIdeal_le A B h1
      have h3 : x * y ∈ maximalIdeal B := Ideal.mul_mem_right _ _ hx
      exact (maximalIdeal.isMaximal B).ne_top
        ((Ideal.eq_top_iff_one _).2 (by simpa using sub_mem h3 h2))
    have := hmap hx'
    rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at this
    exact sup_le le_rfl hker this
  · rw [ringKrullDim_eq_add_ringKrullDim_closedFibre A B inferInstance, ha.2, hb.2]
    push_cast; rfl

/-- Let `A → B` be a flat local homomorphism of Noetherian local rings with `A` and the closed
fibre `B / 𝔪_A B` regular. Then `B` is regular, `dim B = dim A + dim (B / 𝔪_A B)`, and the
images of any regular system of parameters of `A` followed by any lifts of any regular system of
parameters of the closed fibre form a regular system of parameters of `B`. -/
@[mmp "lem_mmp_foundation_flat_local_regular_parameters"]
theorem isRegularLocalRing_and_isRegularSystemOfParameters_append_of_flat
    (hA : IsRegularLocalRing A) (hF : IsRegularLocalRing (ClosedFibre A B)) :
    IsRegularLocalRing B ∧
      ringKrullDim B = ringKrullDim A + ringKrullDim (ClosedFibre A B) ∧
      ∀ {r s : ℕ} {a : Fin r → A}, IsRegularSystemOfParameters a →
        ∀ {bbar : Fin s → ClosedFibre A B}, IsRegularSystemOfParameters bbar →
          ∀ {b : Fin s → B}, Ideal.Quotient.mk _ ∘ b = bbar →
            IsRegularSystemOfParameters (Fin.append (algebraMap A B ∘ a) b) :=
  ⟨isRegularLocalRing_of_flat_of_closedFibre A B hA hF inferInstance,
    ringKrullDim_eq_add_ringKrullDim_closedFibre A B inferInstance,
    fun ha _ hb _ hbb => isRegularSystemOfParameters_append_of_flat ha hb hbb⟩

end MMP.Flips.ResolutionInputs
