/-!
# Convexity and countability inputs

Finite-dimensional convex geometry: relative interiors, Minkowski's theorem, separation of a
pointed cone from a disjoint subspace, Gordan's lemma; and the embedding of countable fields of
characteristic zero into `ℂ`.

## Main results

* `MMP.Resolution.Bridges.intrinsicInterior_nonempty_closure_eq_segment`: `ri(C) ≠ ∅`,
  `ri(C̄) = ri(C)`, and `(1 - t)z + tw ∈ ri(C)` for `z ∈ ri(C)`, `w ∈ C̄`, `0 ≤ t < 1`.
* `MMP.Resolution.Bridges.convexHull_extremePoints_eq`: a compact convex set is the convex hull
  of its extreme points.
* `MMP.Resolution.Bridges.exists_dual_eq_zero_pos_of_salient`: a closed pointed convex cone `W`
  with `W ∩ U = {0}` has a linear form vanishing on `U` and positive on `W ∖ {0}`.
* `MMP.Resolution.Bridges.exists_finset_lattice_points_eq_closure`: Gordan's lemma.
* `MMP.Resolution.Bridges.nonempty_ringHom_complex_and_countable_algebraicClosure`: countable
  fields of characteristic zero embed in `ℂ`, and the relative algebraic closure of a countably
  generated subfield of an algebraically closed field is countable and algebraically closed.

## Implementation notes

* A finite-dimensional real vector space is a finite-dimensional real normed space (all norms
  are equivalent). The relative interior is Mathlib's `intrinsicInterior ℝ C`, the interior of `C`
  in its affine span; extreme points are `Set.extremePoints ℝ S`.
* A cone is `MMP.Mori.IsCone ℝ` (`0 ∈ N`, closed under positive scaling); a convex cone
  is moreover `Convex ℝ`, and pointed means `W ∩ (-W) = {0}`.
* In Gordan's lemma the cone generated by finitely many rational vectors `s ⊆ ℚ^m` is
  `PointedCone.hull ℝ` of their images in `ℝ^m`, and "`σ ∩ ℤ^m` is finitely generated" is: there
  is a finite set `g ⊆ ℤ^m` whose additive closure is exactly the set of lattice points of `σ`.
* The algebraic closure of a subfield `F ⊆ Ω` in `Ω` is `algebraicClosure F Ω`; the subfield
  generated by a countable set `S` is `Subfield.closure S`.
-/

@[expose] public section

universe u

open Set
open scoped Cardinal

namespace MMP.Resolution.Bridges

section ConvexAux

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The directions in which a point `p` of a convex set `S` moves in both senses inside `S`. -/
private def faceDir (S : Set E) (hS : Convex ℝ S) (p : E) (hp : p ∈ S) : Submodule ℝ E where
  carrier := {v | ∃ ε : ℝ, 0 < ε ∧ ∀ s ∈ Icc (-ε) ε, p + s • v ∈ S}
  zero_mem' := ⟨1, one_pos, fun s _ => by simpa using hp⟩
  add_mem' := by
    rintro v w ⟨ε, hε, hv⟩ ⟨δ, hδ, hw⟩
    refine ⟨min ε δ / 2, by positivity, fun s hs => ?_⟩
    have hs' : |s| ≤ min ε δ / 2 := abs_le.2 ⟨by linarith [hs.1], hs.2⟩
    have h1 : 2 * s ∈ Icc (-ε) ε := by
      have := abs_le.1 hs'
      constructor <;> linarith [min_le_left ε δ, min_le_right ε δ]
    have h2 : 2 * s ∈ Icc (-δ) δ := by
      have := abs_le.1 hs'
      constructor <;> linarith [min_le_left ε δ, min_le_right ε δ]
    have := hS (hv _ h1) (hw _ h2) (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num : (0:ℝ) ≤ 1/2)
      (by norm_num)
    convert this using 1
    module
  smul_mem' := by
    rintro c v ⟨ε, hε, hv⟩
    refine ⟨ε / (|c| + 1), by positivity, fun s hs => ?_⟩
    have hc : 0 < |c| + 1 := by positivity
    have : s * c ∈ Icc (-ε) ε := by
      have hs' : |s| ≤ ε / (|c| + 1) := abs_le.2 hs
      have : |s * c| ≤ ε := by
        rw [abs_mul]
        calc |s| * |c| ≤ ε / (|c| + 1) * |c| := by gcongr
          _ ≤ ε := by
            rw [div_mul_eq_mul_div, div_le_iff₀ hc]
            nlinarith [abs_nonneg c]
      exact abs_le.1 this
    simpa [smul_smul] using hv _ this

private theorem sub_mem_faceDir {S : Set E} {hS : Convex ℝ S} {p : E} {hp : p ∈ S} {x₁ x₂ : E}
    (h₁ : x₁ ∈ S) (h₂ : x₂ ∈ S) (hseg : p ∈ openSegment ℝ x₁ x₂) :
    x₁ - p ∈ faceDir S hS p hp := by
  obtain ⟨a, b, ha, hb, hab, rfl⟩ := hseg
  have hseg1 : ∀ y ∈ S, ∀ u ∈ Icc (0:ℝ) 1, (a • x₁ + b • x₂) + u • (y - (a • x₁ + b • x₂)) ∈ S := by
    intro y hy u hu
    have := hS hp hy (by linarith [hu.2] : (0:ℝ) ≤ 1 - u) hu.1 (by ring)
    convert this using 1
    module
  refine ⟨min a b, lt_min ha hb, fun s hs => ?_⟩
  have hamin : min a b ≤ a := min_le_left _ _
  have hbmin : min a b ≤ b := min_le_right _ _
  have ha1 : a ≤ 1 := by linarith
  have hb1 : b ≤ 1 := by linarith
  rcases le_total 0 s with h0 | h0
  · simpa using hseg1 x₁ h₁ s ⟨h0, by linarith [hs.2]⟩
  · have hu : -s * b / a ∈ Icc (0:ℝ) 1 := by
      refine ⟨by apply div_nonneg <;> nlinarith [hs.1], ?_⟩
      rw [div_le_one ha]
      nlinarith [hs.1]
    have := hseg1 x₂ h₂ _ hu
    convert this using 1
    have hb' : b = 1 - a := by linarith
    subst hb'
    match_scalars <;> field_simp
    ring

private theorem mem_extremePoints_of_faceDir_eq_bot {S : Set E} {hS : Convex ℝ S} {p : E}
    {hp : p ∈ S} (hbot : faceDir S hS p hp = ⊥) : p ∈ S.extremePoints ℝ := by
  rw [mem_extremePoints]
  refine ⟨hp, fun x₁ h₁ x₂ h₂ hseg => ?_⟩
  have e1 := sub_mem_faceDir (hS := hS) (hp := hp) h₁ h₂ hseg
  have e2 := sub_mem_faceDir (hS := hS) (hp := hp) h₂ h₁ (openSegment_symm ℝ x₁ x₂ ▸ hseg)
  rw [hbot, Submodule.mem_bot, sub_eq_zero] at e1 e2
  exact ⟨e1, e2⟩

private theorem faceDir_le_of_mem_openSegment {S : Set E} {hS : Convex ℝ S} {a b p : E}
    {ha : a ∈ S} {hb : b ∈ S} {hp : p ∈ S} (hseg : p ∈ openSegment ℝ a b) :
    faceDir S hS a ha ≤ faceDir S hS p hp := by
  obtain ⟨l, m, hl, hm, hlm, rfl⟩ := hseg
  intro w hw
  obtain ⟨ε, hε, h⟩ := hw
  refine ⟨l * ε, mul_pos hl hε, fun s hs => ?_⟩
  have hs' : s / l ∈ Icc (-ε) ε := by
    constructor
    · rw [le_div_iff₀ hl]
      linarith [hs.1]
    · rw [div_le_iff₀ hl]
      linarith [hs.2]
  have := hS (h _ hs') hb hl.le hm.le hlm
  convert this using 1
  match_scalars <;> field_simp

private theorem exists_max_faceDir {S : Set E} (hSk : IsCompact S)
    {hS : Convex ℝ S} {p : E} {hp : p ∈ S} {v : E} (hv : v ∈ faceDir S hS p hp) (hv0 : v ≠ 0) :
    ∃ t : ℝ, 0 < t ∧ p + t • v ∈ S ∧ ∀ t' : ℝ, t < t' → p + t' • v ∉ S := by
  set T : Set ℝ := {t | 0 ≤ t ∧ p + t • v ∈ S}
  have hcl : IsClosed T := isClosed_Ici.inter (hSk.isClosed.preimage (by fun_prop))
  obtain ⟨R, hR⟩ := hSk.isBounded.exists_norm_le
  have hvpos : 0 < ‖v‖ := norm_pos_iff.2 hv0
  have hsub : T ⊆ Icc 0 ((R + ‖p‖) / ‖v‖) := by
    rintro t ⟨ht, htS⟩
    refine ⟨ht, ?_⟩
    rw [le_div_iff₀ hvpos]
    have h1 := hR _ htS
    have h2 : ‖t • v‖ ≤ ‖p + t • v‖ + ‖p‖ := by
      simpa only [add_sub_cancel_left] using norm_sub_le (p + t • v) p
    rw [norm_smul, Real.norm_of_nonneg ht] at h2
    linarith
  have hcpt : IsCompact T := IsCompact.of_isClosed_subset isCompact_Icc hcl hsub
  have hne : T.Nonempty := ⟨0, le_rfl, by simpa using hp⟩
  obtain ⟨t, ht⟩ := hcpt.exists_isGreatest hne
  obtain ⟨ε, hε, hεS⟩ := hv
  have hεT : ε ∈ T := ⟨hε.le, hεS ε ⟨by linarith, le_rfl⟩⟩
  exact ⟨t, lt_of_lt_of_le hε (ht.2 hεT), ht.1.2, fun t' ht' hmem =>
    absurd (ht.2 ⟨ht.1.1.trans ht'.le, hmem⟩) (not_le.2 ht')⟩

private theorem mem_convexHull_extremePoints_of_finrank [FiniteDimensional ℝ E] {S : Set E}
    (hSk : IsCompact S) (hS : Convex ℝ S) :
    ∀ n : ℕ, ∀ (p : E) (hp : p ∈ S), Module.finrank ℝ (faceDir S hS p hp) ≤ n →
      p ∈ convexHull ℝ (S.extremePoints ℝ) := by
  intro n
  induction n with
  | zero =>
    intro p hp hn
    exact subset_convexHull ℝ _
      (mem_extremePoints_of_faceDir_eq_bot (Submodule.finrank_eq_zero.1 (Nat.le_zero.1 hn)))
  | succ n ih =>
    intro p hp hn
    by_cases hbot : faceDir S hS p hp = ⊥
    · exact subset_convexHull ℝ _ (mem_extremePoints_of_faceDir_eq_bot hbot)
    obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff _).1 hbot
    obtain ⟨t₁, ht₁, hat₁, hmax₁⟩ := exists_max_faceDir hSk hv hv0
    obtain ⟨t₂, ht₂, hat₂, hmax₂⟩ := exists_max_faceDir hSk (neg_mem hv) (neg_ne_zero.2 hv0)
    have key : ∀ (a b : E) (ha : a ∈ S) (hb : b ∈ S) (w : E), p ∈ openSegment ℝ a b →
        w ∈ faceDir S hS p hp → (∀ ε : ℝ, 0 < ε → a + ε • w ∉ S ∨ a - ε • w ∉ S) →
        a ∈ convexHull ℝ (S.extremePoints ℝ) := by
      intro a b ha hb w hseg hw hno
      refine ih a ha ?_
      have hle : faceDir S hS a ha ≤ faceDir S hS p hp :=
        faceDir_le_of_mem_openSegment (hb := hb) hseg
      have hlt : faceDir S hS a ha < faceDir S hS p hp := by
        refine lt_of_le_of_ne hle fun heq => ?_
        obtain ⟨ε, hε, h⟩ : w ∈ faceDir S hS a ha := heq ▸ hw
        rcases hno ε hε with h1 | h1
        · exact h1 (by simpa using h ε ⟨by linarith, le_rfl⟩)
        · exact h1 (by simpa [sub_eq_add_neg] using h (-ε) ⟨le_rfl, by linarith⟩)
      have := Submodule.finrank_lt_finrank_of_lt hlt
      omega
    have hseg : p ∈ openSegment ℝ (p + t₁ • v) (p + t₂ • -v) := by
      refine ⟨t₂ / (t₁ + t₂), t₁ / (t₁ + t₂), by positivity, by positivity, ?_, ?_⟩
      · field_simp
        ring
      · match_scalars <;> field_simp <;> ring
    refine (convex_convexHull ℝ _).openSegment_subset ?_ ?_ hseg
    · refine key _ _ hat₁ hat₂ v hseg hv fun ε hε => Or.inl ?_
      have := hmax₁ (t₁ + ε) (by linarith)
      have e : p + t₁ • v + ε • v = p + (t₁ + ε) • v := by module
      rwa [e]
    · refine key _ _ hat₂ hat₁ (-v) (by rw [openSegment_symm]; exact hseg) (neg_mem hv)
        fun ε hε => Or.inl ?_
      have := hmax₂ (t₂ + ε) (by linarith)
      have e : p + t₂ • -v + ε • -v = p + (t₂ + ε) • -v := by module
      rwa [e]

private theorem mem_intrinsicInterior_iff_dist (s : Set E) (x : E) :
    x ∈ intrinsicInterior ℝ s ↔ x ∈ (affineSpan ℝ s : Set E) ∧
      ∃ ε > 0, ∀ y ∈ (affineSpan ℝ s : Set E), dist y x < ε → y ∈ s := by
  rw [mem_intrinsicInterior]
  constructor
  · rintro ⟨y, hy, rfl⟩
    refine ⟨y.2, ?_⟩
    rw [mem_interior_iff_mem_nhds, Metric.mem_nhds_iff] at hy
    obtain ⟨ε, hε, hsub⟩ := hy
    refine ⟨ε, hε, fun z hz hd => ?_⟩
    exact hsub (show (⟨z, hz⟩ : affineSpan ℝ s) ∈ Metric.ball y ε from hd)
  · rintro ⟨hx, ε, hε, h⟩
    refine ⟨⟨x, hx⟩, ?_, rfl⟩
    rw [mem_interior_iff_mem_nhds, Metric.mem_nhds_iff]
    exact ⟨ε, hε, fun z hz => h z.1 z.2 hz⟩

section FiniteDimensional

variable [FiniteDimensional ℝ E]

private theorem closure_subset_affineSpan_of_finiteDimensional (C : Set E) :
    closure C ⊆ (affineSpan ℝ C : Set E) :=
  closure_minimal (subset_affineSpan ℝ C) (AffineSubspace.closed_of_finiteDimensional _)

private theorem affineSpan_closure_eq (C : Set E) : affineSpan ℝ (closure C) = affineSpan ℝ C :=
  le_antisymm (affineSpan_le.2 (closure_subset_affineSpan_of_finiteDimensional C))
    (affineSpan_mono ℝ subset_closure)

private theorem combo_intrinsicInterior_closure_mem {C : Set E} (hC : Convex ℝ C) {z w : E}
    (hz : z ∈ intrinsicInterior ℝ C) (hw : w ∈ closure C) {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t < 1) :
    (1 - t) • z + t • w ∈ intrinsicInterior ℝ C := by
  rw [mem_intrinsicInterior_iff_dist] at hz ⊢
  obtain ⟨hzA, ε, hε, hz⟩ := hz
  have hwA := closure_subset_affineSpan_of_finiteDimensional C hw
  have hxA : (1 - t) • z + t • w ∈ (affineSpan ℝ C : Set E) := by
    rw [← AffineMap.lineMap_apply_module]
    exact AffineMap.lineMap_mem _ hzA hwA
  have hu : 0 < 1 - t := by linarith
  refine ⟨hxA, (1 - t) * ε / 2, by positivity, fun y hy hd => ?_⟩
  set δ := (1 - t) * ε / (2 * (t + 1)) with hδ
  have hδpos : 0 < δ := by positivity
  obtain ⟨c, hcC, hcw⟩ := Metric.mem_closure_iff.1 hw δ hδpos
  have hcA : c ∈ (affineSpan ℝ C : Set E) := subset_affineSpan ℝ C hcC
  set z'' : E := (1 - t)⁻¹ • y - (t / (1 - t)) • c with hz''
  have hz''A : z'' ∈ (affineSpan ℝ C : Set E) := by
    have : z'' = AffineMap.lineMap c y (1 - t)⁻¹ := by
      rw [AffineMap.lineMap_apply_module, hz'']
      match_scalars <;> field_simp
      ring
    rw [this]
    exact AffineMap.lineMap_mem _ hcA hy
  have hdist : dist z'' z < ε := by
    have h1 : z'' - z = (1 - t)⁻¹ • ((y - ((1 - t) • z + t • w)) + t • (w - c)) := by
      rw [hz'']
      match_scalars <;> field_simp
      ring
    rw [dist_eq_norm, h1, norm_smul, norm_inv, Real.norm_of_nonneg hu.le]
    have h2 : ‖(y - ((1 - t) • z + t • w)) + t • (w - c)‖ < (1 - t) * ε := by
      calc _ ≤ ‖y - ((1 - t) • z + t • w)‖ + ‖t • (w - c)‖ := norm_add_le _ _
        _ < (1 - t) * ε / 2 + (1 - t) * ε / 2 := by
            have h3 : ‖t • (w - c)‖ ≤ (1 - t) * ε / 2 := by
              rw [norm_smul, Real.norm_of_nonneg ht0, ← dist_eq_norm]
              calc t * dist w c ≤ t * δ := by gcongr
                _ ≤ _ := by
                  rw [hδ, ← mul_div_assoc, div_le_div_iff₀ (by positivity) (by norm_num)]
                  nlinarith [mul_pos hu hε]
            have h4 : ‖y - ((1 - t) • z + t • w)‖ < (1 - t) * ε / 2 := by
              rwa [← dist_eq_norm]
            linarith
        _ = (1 - t) * ε := by ring
    rw [inv_mul_lt_iff₀ hu]
    linarith
  have hz''C := hz z'' hz''A hdist
  have : y = (1 - t) • z'' + t • c := by
    rw [hz'']
    match_scalars <;> field_simp
    ring
  rw [this]
  exact hC hz''C hcC hu.le ht0 (by ring)

private theorem exists_pos_mul_norm_le_norm_apply {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℝ F] {W : Set E} (hW : MMP.Mori.IsCone ℝ W) (hWcl : IsClosed W) (p : E →ₗ[ℝ] F)
    (hker : ∀ w ∈ W, p w = 0 → w = 0) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ w ∈ W, δ * ‖w‖ ≤ ‖p w‖ := by
  have hS : IsCompact (W ∩ Metric.sphere (0 : E) 1) := (isCompact_sphere 0 1).inter_left hWcl
  have hnorm : ∀ w ∈ W, w ≠ 0 → ‖w‖⁻¹ • w ∈ W ∩ Metric.sphere (0 : E) 1 := by
    intro w hw hw0
    refine ⟨hW.2 w hw _ (inv_pos.2 (norm_pos_iff.2 hw0)), ?_⟩
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.2 hw0)]
  rcases (W ∩ Metric.sphere (0 : E) 1).eq_empty_or_nonempty with he | hne
  · refine ⟨1, one_pos, fun w hw => ?_⟩
    by_cases hw0 : w = 0
    · simp [hw0]
    · have := hnorm w hw hw0
      rw [he] at this
      exact absurd this (notMem_empty _)
  · obtain ⟨s, hs, hmin⟩ :=
      hS.exists_isMinOn hne (continuous_norm.comp p.continuous_of_finiteDimensional).continuousOn
    have hs0 : s ≠ 0 := by
      rintro rfl
      simpa using hs.2
    have hδ : 0 < ‖p s‖ := norm_pos_iff.2 (fun h => hs0 (hker s hs.1 h))
    refine ⟨‖p s‖, hδ, fun w hw => ?_⟩
    by_cases hw0 : w = 0
    · simp [hw0]
    · have h1 : ‖p s‖ ≤ ‖p (‖w‖⁻¹ • w)‖ := hmin (hnorm w hw hw0)
      rw [map_smul, norm_smul, norm_inv, norm_norm] at h1
      have hpos : 0 < ‖w‖ := norm_pos_iff.2 hw0
      have := mul_le_mul_of_nonneg_left h1 hpos.le
      rw [← mul_assoc, mul_inv_cancel₀ hpos.ne', one_mul] at this
      linarith

private theorem isClosed_image_of_isCone {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {W : Set E} (hW : MMP.Mori.IsCone ℝ W) (hWcl : IsClosed W) (p : E →ₗ[ℝ] F)
    (hker : ∀ w ∈ W, p w = 0 → w = 0) : IsClosed (p '' W) := by
  obtain ⟨δ, hδ, hb⟩ := exists_pos_mul_norm_le_norm_apply hW hWcl p hker
  rw [← closure_subset_iff_isClosed]
  intro y hy
  set R := (‖y‖ + 1) / δ
  have hT : IsCompact (p '' (W ∩ Metric.closedBall (0 : E) R)) :=
    (((isCompact_closedBall (0 : E) R)).inter_left hWcl).image p.continuous_of_finiteDimensional
  have hy' : y ∈ closure (p '' W ∩ Metric.closedBall y 1) := by
    rw [mem_closure_iff_nhds] at hy ⊢
    intro t ht
    obtain ⟨z, hz, hzW⟩ :=
      hy (t ∩ Metric.ball y 1) (Filter.inter_mem ht (Metric.ball_mem_nhds y one_pos))
    exact ⟨z, hz.1, hzW, Metric.ball_subset_closedBall hz.2⟩
  have hsub : p '' W ∩ Metric.closedBall y 1 ⊆ p '' (W ∩ Metric.closedBall (0 : E) R) := by
    rintro _ ⟨⟨w, hw, rfl⟩, hy1⟩
    refine ⟨w, ⟨hw, ?_⟩, rfl⟩
    rw [mem_closedBall_zero_iff]
    have h1 : ‖p w‖ ≤ ‖y‖ + 1 := by
      have h3 := norm_le_insert' (p w) y
      rw [mem_closedBall_iff_norm', norm_sub_rev] at hy1
      linarith
    have := hb w hw
    rw [le_div_iff₀ hδ]
    nlinarith
  obtain ⟨w, hw, rfl⟩ := closure_minimal hsub hT.isClosed hy'
  exact ⟨w, hw.1, rfl⟩

end FiniteDimensional

end ConvexAux

section Convex

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- **Relative interiors.** Let `C` be a nonempty convex subset of a finite-dimensional real
vector space. Then `ri(C)` is nonempty, `ri(C̄) = ri(C)`, and for `z ∈ ri(C)` and `w ∈ C̄` every
point `(1 - t)z + tw` with `0 ≤ t < 1` lies in `ri(C)`. -/
@[mmp "lem_mmp_foundation_convex_relative_interior"]
theorem intrinsicInterior_nonempty_closure_eq_segment {C : Set E} (hC : Convex ℝ C)
    (hne : C.Nonempty) :
    (intrinsicInterior ℝ C).Nonempty ∧ intrinsicInterior ℝ (closure C) = intrinsicInterior ℝ C ∧
      ∀ z ∈ intrinsicInterior ℝ C, ∀ w ∈ closure C, ∀ t : ℝ, 0 ≤ t → t < 1 →
        (1 - t) • z + t • w ∈ intrinsicInterior ℝ C := by
  have hri : (intrinsicInterior ℝ C).Nonempty := hne.intrinsicInterior hC
  refine ⟨hri, ?_, fun z hz w hw t h0 h1 => combo_intrinsicInterior_closure_mem hC hz hw h0 h1⟩
  ext x
  constructor
  · intro hx
    obtain ⟨z, hz⟩ := hri
    rw [mem_intrinsicInterior_iff_dist, affineSpan_closure_eq] at hx
    obtain ⟨hxA, ε, hε, hx⟩ := hx
    have hzA : z ∈ (affineSpan ℝ C : Set E) := subset_affineSpan ℝ C (intrinsicInterior_subset hz)
    set s : ℝ := ε / (2 * (‖x - z‖ + 1)) with hs
    have hspos : 0 < s := by positivity
    have hwA : x + s • (x - z) ∈ (affineSpan ℝ C : Set E) := by
      have : x + s • (x - z) = AffineMap.lineMap z x (1 + s) := by
        rw [AffineMap.lineMap_apply_module]
        module
      rw [this]
      exact AffineMap.lineMap_mem _ hzA hxA
    have hw : x + s • (x - z) ∈ closure C := by
      apply hx _ hwA
      rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hspos.le, hs]
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
      nlinarith [mul_nonneg hε.le (norm_nonneg (x - z))]
    have := combo_intrinsicInterior_closure_mem hC hz hw (t := (1 + s)⁻¹) (by positivity)
      (by rw [inv_lt_one_iff₀]; right; linarith)
    convert this using 1
    match_scalars <;> field_simp
    ring
  · intro hx
    rw [mem_intrinsicInterior_iff_dist] at hx ⊢
    rw [affineSpan_closure_eq]
    obtain ⟨hxA, ε, hε, h⟩ := hx
    exact ⟨hxA, ε, hε, fun y hy hd => subset_closure (h y hy hd)⟩

/-- **Minkowski's theorem.** A compact convex subset `S` of a finite-dimensional real vector space
is the convex hull of its extreme points. -/
@[mmp "lem_mmp_foundation_finite_dimensional_minkowski"]
theorem convexHull_extremePoints_eq {S : Set E} (hS : IsCompact S) (hSc : Convex ℝ S) :
    convexHull ℝ (S.extremePoints ℝ) = S :=
  Subset.antisymm (convexHull_min extremePoints_subset hSc) fun p hp =>
    mem_convexHull_extremePoints_of_finrank hS hSc _ p hp le_rfl

/-- **Strict separation of a pointed cone from a disjoint subspace.** Let `W` be a closed pointed
convex cone in a finite-dimensional real vector space `E` and `U` a linear subspace with
`W ∩ U = {0}`. Then there is a linear form vanishing on `U` and positive on `W ∖ {0}`. -/
@[mmp "lem_mmp_foundation_pointed_cone_subspace_separation"]
theorem exists_dual_eq_zero_pos_of_salient {W : Set E} (hW : MMP.Mori.IsCone ℝ W)
    (hWc : Convex ℝ W) (hWcl : IsClosed W) (hWs : W ∩ -W = {0}) (U : Submodule ℝ E)
    (hWU : W ∩ U = {0}) :
    ∃ G : Module.Dual ℝ E, (∀ u ∈ U, G u = 0) ∧ ∀ z ∈ W, z ≠ 0 → 0 < G z := by
  obtain ⟨q, hq⟩ := Submodule.exists_isCompl U
  let p : E →ₗ[ℝ] q := Submodule.projectionOnto q U hq.symm
  have hpU : ∀ x, p x = 0 ↔ x ∈ U := fun _ => Submodule.projectionOnto_apply_eq_zero_iff hq.symm
  have hker : ∀ w ∈ W, p w = 0 → w = 0 := by
    intro w hw h0
    have : w ∈ W ∩ (U : Set E) := ⟨hw, (hpU w).1 h0⟩
    rw [hWU] at this
    exact this
  have hWsum : ∀ a ∈ W, ∀ b ∈ W, a + b ∈ W := by
    intro a ha b hb
    have := hWc ha hb (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num)
    have h2 := hW.2 _ this 2 two_pos
    simpa [smul_add, smul_smul] using h2
  have hcone : MMP.Mori.IsCone ℝ (p '' W) :=
    ⟨⟨0, hW.1, map_zero p⟩, by
      rintro _ ⟨w, hw, rfl⟩ c hc
      exact ⟨c • w, hW.2 w hw c hc, map_smul p c w⟩⟩
  have hconv : Convex ℝ (p '' W) := hWc.linear_image p
  have hcl : IsClosed (p '' W) := isClosed_image_of_isCone hW hWcl p hker
  have hsal : p '' W ∩ -(p '' W) = {0} := by
    refine Set.eq_singleton_iff_unique_mem.2 ⟨⟨hcone.1, by simpa using hcone.1⟩, ?_⟩
    rintro x ⟨⟨w1, hw1, rfl⟩, ⟨w2, hw2, h2⟩⟩
    have hs : p (w1 + w2) = 0 := by simp [h2]
    have hsW : w1 + w2 ∈ W := hWsum _ hw1 _ hw2
    have h0 := hker _ hsW hs
    have : w1 ∈ W ∩ -W := ⟨hw1, by
      rw [eq_neg_of_add_eq_zero_left h0]
      simpa using hw2⟩
    rw [hWs] at this
    have : w1 = 0 := this
    simp [this]
  obtain ⟨G', hG'⟩ := MMP.Positivity.exists_dual_pos_of_salient hcone hconv hcl hsal
  refine ⟨G'.comp p, fun u hu => ?_, fun z hz hz0 => ?_⟩
  · simp [(hpU u).2 hu]
  · exact hG' (p z) ⟨z, hz, rfl⟩ (fun h => hz0 (hker z hz h))

end Convex

private theorem cast_clearDen_eq {m D : ℕ} (q : Fin m → ℚ) (hdvd : ∀ i, (q i).den ∣ D) :
    (fun i => ((((D / (q i).den : ℕ) : ℤ) * (q i).num : ℤ) : ℝ)) =
      (D : ℝ) • fun i => (q i : ℝ) := by
  funext i
  have hden : ((q i).den : ℝ) ≠ 0 := by exact_mod_cast (q i).den_nz
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [Int.cast_mul, Int.cast_natCast, Nat.cast_div (hdvd i) hden, Rat.cast_def]
  field_simp

private theorem finite_fractional_combinations {m : ℕ} (s : Finset (Fin m → ℚ))
    (u : (Fin m → ℚ) → Fin m → ℤ) :
    {w : Fin m → ℤ | ∃ f : (Fin m → ℚ) → ℝ, (∀ q ∈ s, 0 ≤ f q ∧ f q < 1) ∧
      (fun i => (w i : ℝ)) = ∑ q ∈ s, f q • fun i => (u q i : ℝ)}.Finite := by
  let B : Fin m → ℤ := fun i => ∑ q ∈ s, |u q i|
  refine (Finset.Icc (-B) B).finite_toSet.subset ?_
  rintro w ⟨f, hf, hw⟩
  rw [Finset.coe_Icc]
  have key : ∀ i, |(w i : ℝ)| ≤ (B i : ℝ) := by
    intro i
    have := congrFun hw i
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at this
    rw [this]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    simp only [B]
    push_cast
    refine Finset.sum_le_sum fun q hq => ?_
    rw [abs_mul, abs_of_nonneg (hf q hq).1]
    exact mul_le_of_le_one_left (abs_nonneg _) (hf q hq).2.le
  refine ⟨fun i => ?_, fun i => ?_⟩
  · have := (abs_le.1 (key i)).1
    have h2 : ((-B i : ℤ) : ℝ) ≤ (w i : ℝ) := by
      push_cast
      exact this
    exact_mod_cast h2
  · exact_mod_cast (abs_le.1 (key i)).2

private theorem mem_closure_of_mem_hull {m D : ℕ} {s : Finset (Fin m → ℚ)}
    {u : (Fin m → ℚ) → Fin m → ℤ} (hD : 0 < D)
    (hu : ∀ q ∈ s, (fun i => (u q i : ℝ)) = (D : ℝ) • fun i => (q i : ℝ))
    {g : Set (Fin m → ℤ)} (hug : ∀ q ∈ s, u q ∈ g)
    (hPg : ∀ w : Fin m → ℤ, (∃ f : (Fin m → ℚ) → ℝ, (∀ q ∈ s, 0 ≤ f q ∧ f q < 1) ∧
      (fun i => (w i : ℝ)) = ∑ q ∈ s, f q • fun i => (u q i : ℝ)) → w ∈ g)
    {v : Fin m → ℤ} (hv : (fun i => (v i : ℝ)) ∈
      PointedCone.hull ℝ ((fun q : Fin m → ℚ => fun i => (q i : ℝ)) '' s)) :
    v ∈ AddSubmonoid.closure g := by
  let ι : (Fin m → ℤ) →+ (Fin m → ℝ) := (Int.castAddHom ℝ).compLeft (Fin m)
  have hι : ∀ v, ι v = fun i => (v i : ℝ) := fun _ => rfl
  rw [← hι] at hv
  obtain ⟨c, hc⟩ := (Submodule.mem_span_image_finset_iff_exists_fun' (R := NNReal)).1 hv
  let lam : (Fin m → ℚ) → ℝ := fun q => (c q : ℝ) / D
  have hlam : ∀ q, 0 ≤ lam q := fun q => by positivity
  let n : (Fin m → ℚ) → ℕ := fun q => ⌊lam q⌋₊
  have hvsum : ι v = ∑ q ∈ s, lam q • ι (u q) := by
    rw [← hc]
    refine Finset.sum_congr rfl fun q hq => ?_
    rw [hι, hu q hq, smul_smul]
    have : lam q * D = c q := by
      simp only [lam]
      field_simp
    rw [this]
    exact NNReal.smul_def _ _
  let w : Fin m → ℤ := v - ∑ q ∈ s, n q • u q
  have hwg : w ∈ g := by
    refine hPg w ⟨fun q => lam q - n q, fun q _ => ⟨?_, ?_⟩, ?_⟩
    · have := Nat.floor_le (hlam q)
      simp only [n]
      linarith
    · have := Nat.lt_floor_add_one (lam q)
      simp only [n]
      linarith
    · change ι w = ∑ q ∈ s, (lam q - n q) • ι (u q)
      simp only [w, map_sub, map_sum, map_nsmul]
      rw [hvsum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun q _ => ?_
      rw [sub_smul, Nat.cast_smul_eq_nsmul]
  have hsum : ∑ q ∈ s, n q • u q ∈ AddSubmonoid.closure g :=
    AddSubmonoid.sum_mem _ fun q hq =>
      AddSubmonoid.nsmul_mem _ (AddSubmonoid.subset_closure (hug q hq)) _
  simpa [w] using add_mem (AddSubmonoid.subset_closure hwg) hsum

/-- **Gordan's lemma.** Let `σ ⊆ ℝ^m` be the convex cone generated by finitely many vectors of
`ℚ^m`. Then the monoid `σ ∩ ℤ^m` is finitely generated: there is a finite set `g ⊆ ℤ^m` whose
additive closure is the set of lattice points of `σ`. -/
@[mmp "lem_mmp_foundation_gordan_lattice_cone"]
theorem exists_finset_lattice_points_eq_closure {m : ℕ} (s : Finset (Fin m → ℚ)) :
    ∃ g : Finset (Fin m → ℤ), ∀ v : Fin m → ℤ,
      ((fun i => (v i : ℝ)) ∈ PointedCone.hull ℝ ((fun q : Fin m → ℚ => fun i => (q i : ℝ)) '' s)
        ↔ v ∈ AddSubmonoid.closure (g : Set (Fin m → ℤ))) := by
  classical
  set D : ℕ := ∏ q ∈ s, ∏ i, (q i).den
  have hDpos : 0 < D := Finset.prod_pos fun q _ => Finset.prod_pos fun i _ => (q i).den_pos
  let u : (Fin m → ℚ) → (Fin m → ℤ) := fun q i => ((D / (q i).den : ℕ) : ℤ) * (q i).num
  let qr : (Fin m → ℚ) → (Fin m → ℝ) := fun q i => (q i : ℝ)
  have hu : ∀ q ∈ s, (fun i => ((u q i : ℤ) : ℝ)) = (D : ℝ) • qr q := fun q hq =>
    cast_clearDen_eq q fun i =>
      (Finset.dvd_prod_of_mem (fun i => (q i).den) (Finset.mem_univ i)).trans
        (Finset.dvd_prod_of_mem (fun q : Fin m → ℚ => ∏ i, (q i).den) hq)
  let ι : (Fin m → ℤ) →+ (Fin m → ℝ) := (Int.castAddHom ℝ).compLeft (Fin m)
  have hι : ∀ v, ι v = fun i => (v i : ℝ) := fun _ => rfl
  let σ := PointedCone.hull ℝ ((fun q : Fin m → ℚ => fun i => (q i : ℝ)) '' (s : Set (Fin m → ℚ)))
  have hσsum : ∀ c : (Fin m → ℚ) → ℝ, (∀ q ∈ s, 0 ≤ c q) → ∑ q ∈ s, c q • qr q ∈ σ := by
    intro c hc
    refine (Submodule.mem_span_image_finset_iff_exists_fun' (R := NNReal)).2 ?_
    refine ⟨fun q => Real.toNNReal (c q), Finset.sum_congr rfl fun q hq => ?_⟩
    change (c q).toNNReal • (fun i => (q i : ℝ)) = c q • qr q
    rw [NNReal.smul_def, Real.coe_toNNReal _ (hc q hq)]
  have hσu : ∀ q ∈ s, ι (u q) ∈ σ := by
    intro q hq
    have := hσsum (fun q' => if q' = q then (D : ℝ) else 0) (fun q' _ => by
      split_ifs <;> positivity)
    simp only [ite_smul, zero_smul] at this
    rw [Finset.sum_ite_eq' s q] at this
    simpa [hq, ← hu q hq, hι] using this
  have hPfin := finite_fractional_combinations s u
  set g : Finset (Fin m → ℤ) := hPfin.toFinset ∪ s.image u
  have hgσ : ∀ x ∈ (g : Set (Fin m → ℤ)), ι x ∈ σ := by
    intro x hx
    rw [Finset.mem_coe, Finset.mem_union, Set.Finite.mem_toFinset, Finset.mem_image] at hx
    rcases hx with ⟨f, hf, hw⟩ | ⟨q, hq, rfl⟩
    · rw [hι, hw]
      have : ∑ q ∈ s, f q • (fun i => (u q i : ℝ)) = ∑ q ∈ s, (f q * D) • qr q :=
        Finset.sum_congr rfl fun q hq => by rw [hu q hq, smul_smul]
      rw [this]
      exact hσsum _ fun q hq => mul_nonneg (hf q hq).1 (by positivity)
    · exact hσu q hq
  refine ⟨g, fun v => ⟨mem_closure_of_mem_hull hDpos hu
    (fun q hq => Finset.mem_coe.2 (Finset.mem_union_right _ (Finset.mem_image_of_mem u hq)))
    (fun w hw => Finset.mem_coe.2 (Finset.mem_union_left _ (hPfin.mem_toFinset.2 hw))),
    fun hv => (AddSubmonoid.closure_le (S := σ.toAddSubmonoid.comap ι)).2 hgσ hv⟩⟩

private theorem nonempty_ringHom_complex_of_countable (K : Type u) [Field K] [CharZero K]
    [Countable K] : Nonempty (K →+* ℂ) := by
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis ℤ K
  obtain ⟨t, ht⟩ := exists_isTranscendenceBasis ℤ ℂ
  have htunc : ℵ₀ < #t := by
    by_contra hle
    push Not at hle
    have h := IsAlgClosed.cardinal_le_max_transcendence_basis' (R := ℤ) (K' := ℂ) (ι' := t)
      Subtype.val ht
    rw [Cardinal.mk_complex] at h
    have : max (max #ℤ #t) ℵ₀ ≤ ℵ₀ := max_le (max_le (by simp) hle) le_rfl
    exact absurd (h.trans this) (not_le.2 Cardinal.aleph0_lt_continuum)
  have hsc : #s ≤ ℵ₀ := Cardinal.mk_le_aleph0
  obtain ⟨f⟩ : Nonempty (s ↪ t) :=
    Cardinal.lift_mk_le'.1 ((Cardinal.lift_le.2 hsc).trans (by simpa using htunc.le))
  let w : s → ℂ := fun i => (f i : ℂ)
  have hw : AlgebraicIndependent ℤ w := ht.1.comp f f.injective
  let φ := hs.1.aevalEquiv.symm.trans hw.aevalEquiv
  let g : Algebra.adjoin ℤ (Set.range ((↑) : s → K)) →+* ℂ :=
    (Algebra.adjoin ℤ (Set.range w)).val.toRingHom.comp φ.toRingEquiv.toRingHom
  let : Algebra (Algebra.adjoin ℤ (Set.range ((↑) : s → K))) ℂ := g.toAlgebra
  have hg : Function.Injective g := Subtype.val_injective.comp φ.injective
  have : FaithfulSMul (Algebra.adjoin ℤ (Set.range ((↑) : s → K))) ℂ :=
    (faithfulSMul_iff_algebraMap_injective _ _).2 hg
  have := hs.isAlgebraic
  exact ⟨(IsAlgClosed.lift (R := Algebra.adjoin ℤ (Set.range ((↑) : s → K))) (S := K)
    (M := ℂ)).toRingHom⟩

private theorem countable_algebraicClosure_isAlgClosed (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (S : Set Ω) (hS : S.Countable) :
    Countable (algebraicClosure (Subfield.closure S) Ω) ∧
      IsAlgClosed (algebraicClosure (Subfield.closure S) Ω) := by
  refine ⟨?_, IsAlgClosure.isAlgClosed (Subfield.closure S)⟩
  have h1 : Countable (Subfield.closure S) := by
    have := Subfield.cardinalMk_closure_le_max S
    rw [← Cardinal.mk_le_aleph0_iff]
    refine this.trans (max_le ?_ le_rfl)
    exact Cardinal.mk_le_aleph0_iff.2 hS.to_subtype
  have h2 := Algebraic.countable (Subfield.closure S) Ω
  have h3 : ((algebraicClosure (Subfield.closure S) Ω : IntermediateField _ Ω) : Set Ω) ⊆
      {x : Ω | IsAlgebraic (Subfield.closure S) x} := fun x hx =>
    mem_algebraicClosure_iff.1 hx
  exact (h2.mono h3).to_subtype

/-- **Countable fields embed in `ℂ`.** Every countable field of characteristic zero admits a field
embedding into `ℂ`; and the algebraic closure, inside an algebraically closed field `Ω`, of a
countably generated subfield is a countable algebraically closed field. -/
@[mmp "lem_mmp_foundation_countable_field_complex_embedding"]
theorem nonempty_ringHom_complex_and_countable_algebraicClosure :
    (∀ (K : Type u) [Field K] [CharZero K] [Countable K], Nonempty (K →+* ℂ)) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (S : Set Ω), S.Countable →
      Countable (algebraicClosure (Subfield.closure S) Ω) ∧
        IsAlgClosed (algebraicClosure (Subfield.closure S) Ω)) :=
  ⟨fun K _ _ _ => nonempty_ringHom_complex_of_countable K, fun Ω _ _ S hS =>
    countable_algebraicClosure_isAlgClosed Ω S hS⟩

end MMP.Resolution.Bridges
