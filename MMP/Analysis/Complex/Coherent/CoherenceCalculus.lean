open Limits

section FreeFintype

variable {C : Type*} [Category C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{0}}
  [HasWeakSheafify J AddCommGrpCat.{0}] [J.WEqualsLocallyBijective AddCommGrpCat.{0}]

open SheafOfModules in
/-- Every element of a free module of finite rank is a combination of the basis sections
`freeSection j`. -/
theorem exists_eq_sum_smul_freeSection' {I : Type} [Fintype I] (X : Cᵒᵖ)
    (x : (free (R := R) I).val.obj X) :
    ∃ a : I → R.obj.obj X, x = ∑ j, a j •
      (show (free (R := R) I).val.obj X from (freeSection (R := R) j).1 X) := by
  classical
  exact MMP.exists_eq_sum_smul_freeSection X x

end FreeFintype

variable {C : Type} [SmallCategory C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{0}}
  [HasSheafify J AddCommGrpCat.{0}] [J.WEqualsLocallyBijective AddCommGrpCat.{0}]

/-- The sieve of arrows along which `q` lifts through `φ`. -/
def liftSieve {P Q : SheafOfModules.{0} R} (φ : P ⟶ Q) {X : C} (q : Q.val.obj (op X)) :
    Sieve X where
  arrows Y f := ∃ p : P.val.obj (op Y), φ.val.app (op Y) p = Q.val.map f.op q
  downward_closed := by
    rintro Y Z f ⟨p, hp⟩ g
    refine ⟨P.val.map g.op p, ?_⟩
    rw [PresheafOfModules.naturality_apply, hp, op_comp, PresheafOfModules.map_comp_apply]

/-- The local image of `φ`: the subsheaf of `Q` of elements which lift through `φ` locally. -/
def localImage {P Q : SheafOfModules.{0} R} (φ : P ⟶ Q) : Q.Submodule where
  obj X :=
    { carrier := {q | liftSieve φ q ∈ J X.unop}
      add_mem' := by
        intro a b ha hb
        refine J.superset_covering ?_ (J.intersection_covering ha hb)
        rintro Y f ⟨⟨p, hp⟩, ⟨p', hp'⟩⟩
        exact ⟨p + p', by rw [map_add, hp, hp', map_add]; rfl⟩
      zero_mem' := by
        refine J.superset_covering ?_ (J.top_mem _)
        intro Y f _
        exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
      smul_mem' := by
        intro r a ha
        refine J.superset_covering ?_ ha
        rintro Y f ⟨p, hp⟩
        refine ⟨R.obj.map f.op r • p, ?_⟩
        rw [map_smul, hp, PresheafOfModules.map_smul]; rfl }
  map {X Y} f := by
    intro q hq
    induction Y using Opposite.rec with | op Y => ?_
    change liftSieve φ (show Q.val.obj (op Y) from Q.val.map f q) ∈ J Y
    refine J.superset_covering ?_ (J.pullback_stable f.unop hq)
    rintro Z g ⟨p, hp⟩
    refine ⟨p, ?_⟩
    rw [hp, op_comp, PresheafOfModules.map_comp_apply]
    rfl
  isSheaf := by
    intro X q hq
    refine J.transitive hq _ fun Y f hf => ?_
    refine J.superset_covering ?_ hf
    rintro Z g ⟨p, hp⟩
    refine ⟨p, ?_⟩
    rw [hp]
    change _ = Q.val.map (g ≫ f).op q
    rw [op_comp, PresheafOfModules.map_comp_apply]
    rfl

/-- The image under `φ` of an element of `P` lies in the local image of `φ`. -/
theorem app_mem_localImage {P Q : SheafOfModules.{0} R} (φ : P ⟶ Q) (X : Cᵒᵖ) (p : P.val.obj X) :
    φ.val.app X p ∈ (localImage φ).obj X := by
  induction X using Opposite.rec with | op X => ?_
  refine J.superset_covering ?_ (J.top_mem X)
  intro Y f _
  exact ⟨P.val.map f.op p, PresheafOfModules.naturality_apply _ _ _⟩

/-- The corestriction of `φ` to its local image. -/
noncomputable def toLocalImage {P Q : SheafOfModules.{0} R} (φ : P ⟶ Q) :
    P ⟶ (localImage φ).toSheafOfModules :=
  ⟨{ app X := ModuleCat.ofHom ((φ.val.app X).hom.codRestrict _ (app_mem_localImage φ X))
     naturality {X Y} f := by
       ext p
       exact Subtype.ext (PresheafOfModules.naturality_apply φ.val f p) }⟩

/-- `φ` factors through its local image via `toLocalImage φ`. -/
theorem toLocalImage_ι {P Q : SheafOfModules.{0} R} (φ : P ⟶ Q) :
    toLocalImage φ ≫ (localImage φ).ι = φ := by
  ext X p
  rfl

/-- Along an epimorphism of sheaves of modules every element lifts locally: its `liftSieve` is
covering. -/
theorem liftSieve_mem_of_epi {P Q : SheafOfModules.{0} R} (φ : P ⟶ Q) [Epi φ] {X : C}
    (q : Q.val.obj (op X)) : liftSieve φ q ∈ J X := by
  have : Epi (localImage φ).ι := epi_of_epi_fac (toLocalImage_ι φ)
  have : IsIso (localImage φ).ι := isIso_of_mono_of_epi _
  have h : (inv (localImage φ).ι ≫ (localImage φ).ι).val.app (op X) q = q := by
    rw [IsIso.inv_hom_id]; rfl
  rw [← h]
  exact ((inv (localImage φ).ι).val.app (op X) q).2

/-- The morphism from a free module defined by sections `t` sends `∑ i, a i • eᵢ` to
`∑ i, a i • t i`. -/
theorem freeHomEquiv_symm_app_sum {P : SheafOfModules.{0} R} {I : Type} [Fintype I]
    (t : I → P.sections) (X : Cᵒᵖ) (a : I → R.obj.obj X) :
    (P.freeHomEquiv.symm t).val.app X (∑ i, a i •
      (show (SheafOfModules.free (R := R) I).val.obj X from
        (SheafOfModules.freeSection (R := R) i).1 X)) =
      ∑ i, a i • (show P.val.obj X from (t i).1 X) := by
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul]
  exact congrArg _ (freeHomEquiv_symm_app_freeSection t i X)

/-- Finitely many elements `g` of `M` over `Y` *locally generate* `M` over `Y`. -/
def LocallyGenerates (M : SheafOfModules.{0} R) {Y : C} {m : ℕ} (g : Fin m → M.val.obj (op Y)) :
    Prop :=
  ∀ (Z : C) (z : Z ⟶ Y) (t : M.val.obj (op Z)), ∃ S ∈ J Z, ∀ (W : C) (f : W ⟶ Z), S f →
    ∃ c : Fin m → R.obj.obj (op W), M.val.map f.op t = ∑ k, c k • M.val.map (f ≫ z).op (g k)

/-- Elements `g` locally generating `M` over `Y` define an epimorphism onto `M.over Y` from a free
module. -/
theorem epi_freeHomEquiv_symm_overSection (M : SheafOfModules.{0} R) {Y : C} {m : ℕ}
    (g : Fin m → M.val.obj (op Y)) (hg : LocallyGenerates M g) :
    Epi ((M.over Y).freeHomEquiv.symm fun k => overSection M (g k)) := by
  refine epi_of_locally_surjective _ fun U q => ?_
  obtain ⟨S, hS, hSc⟩ := hg U.left U.hom q
  refine ⟨(Sieve.overEquiv U).symm S, ?_, fun W f hf => ?_⟩
  · rw [GrothendieckTopology.mem_over_iff]
    simpa using hS
  · rw [Sieve.overEquiv_symm_iff] at hf
    obtain ⟨c, hc⟩ := hSc W.left f.left hf
    refine ⟨∑ k, (show (R.over Y).obj.obj (op W) from c k) •
      (show (SheafOfModules.free (R := R.over Y) (Fin m)).val.obj (op W) from
        (SheafOfModules.freeSection (R := R.over Y) k).1 (op W)), ?_⟩
    rw [freeHomEquiv_symm_app_sum]
    change _ = M.val.map f.left.op q
    rw [hc, Over.w f]
    rfl

/-- A sheaf of modules locally generated by finitely many elements over each member of a covering
family is of finite type. -/
theorem isFiniteType_of_locallyGenerates (M : SheafOfModules.{0} R) {I : Type} {Y : I → C}
    (hY : J.CoversTop Y) (m : I → ℕ) (g : ∀ i, Fin (m i) → M.val.obj (op (Y i)))
    (hg : ∀ i, LocallyGenerates M (g i)) : SheafOfModules.IsFiniteType.{0} M := by
  let σ : M.LocalGeneratorsData :=
    { I := I, X := Y, coversTop := hY
      generators := fun i => ⟨Fin (m i), fun k => overSection M (g i k),
        epi_freeHomEquiv_symm_overSection M (g i) (hg i)⟩ }
  exact ⟨⟨σ, ⟨fun i => ⟨inferInstanceAs (Finite (Fin (m i)))⟩⟩⟩⟩

/-- The value of a section of `M.over Y` on `U` is the restriction of its value on `Y`. -/
theorem overSection_apply (M : SheafOfModules.{0} R) {Y : C} (s : (M.over Y).sections)
    (U : Over Y) : s.1 (op U) = M.val.map U.hom.op (s.1 (op (Over.mk (𝟙 Y)))) :=
  (PresheafOfModules.sections_property s (Over.homMk (U := U) (V := Over.mk (𝟙 Y))
    U.hom (by simp)).op).symm

/-- The restriction maps of `M.over Y` are those of `M`. -/
theorem over_map_apply (M : SheafOfModules.{0} R) {Y : C} {U V : Over Y} (g : U ⟶ V)
    (t : M.val.obj (op V.left)) :
    (M.over Y).val.map g.op t = M.val.map g.left.op t := rfl

/-- The values on `Y` of finitely many generating sections of `M.over Y` locally generate `M` over
`Y`. -/
theorem locallyGenerates_of_generatingSections (M : SheafOfModules.{0} R) {Y : C}
    (G : (M.over Y).GeneratingSections) [Fintype G.I] {m : ℕ} (e : G.I ≃ Fin m) :
    LocallyGenerates M (fun k => (G.s (e.symm k)).1 (op (Over.mk (𝟙 Y)))) := by
  intro Z z t
  have hl := liftSieve_mem_of_epi ((M.over Y).freeHomEquiv.symm G.s) (X := Over.mk z) t
  refine ⟨Sieve.overEquiv (Over.mk z) (liftSieve ((M.over Y).freeHomEquiv.symm G.s)
    (X := Over.mk z) t), hl, fun W f hf => ?_⟩
  rw [Sieve.overEquiv_iff] at hf
  obtain ⟨p, hp⟩ := hf
  obtain ⟨a, ha⟩ := exists_eq_sum_smul_freeSection' (R := R.over Y)
    (I := G.I) (op (Over.mk (f ≫ (Over.mk z).hom))) p
  rw [ha, freeHomEquiv_symm_app_sum, over_map_apply] at hp
  refine ⟨fun k => a (e.symm k), hp.symm.trans ?_⟩
  rw [← e.symm.sum_comp]
  refine Finset.sum_congr rfl fun k _ => ?_
  congr 1
  exact overSection_apply M _ (Over.mk (f ≫ z))

/-- A sheaf of modules of finite type is locally generated by finitely many elements over each
member of a covering family. -/
theorem exists_locallyGenerates_of_isFiniteType (M : SheafOfModules.{0} R)
    (hM : SheafOfModules.IsFiniteType.{0} M) :
    ∃ (I : Type) (Y : I → C), J.CoversTop Y ∧ ∃ (m : I → ℕ)
      (g : ∀ i, Fin (m i) → M.val.obj (op (Y i))), ∀ i, LocallyGenerates M (g i) := by
  obtain ⟨σ, hσ⟩ := hM.1
  have := fun i => (hσ.isFiniteType i).finite
  letI := fun i => Fintype.ofFinite (σ.generators i).I
  exact ⟨σ.I, σ.X, σ.coversTop, fun i => Fintype.card (σ.generators i).I, _,
    fun i => locallyGenerates_of_generatingSections M (σ.generators i)
      (Fintype.equivFin _)⟩

section Top

open TopologicalSpace

variable {T : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- Restriction of an element of `M` along an inclusion of opens. -/
noncomputable abbrev resM (M : SheafOfModules.{0} A) {U U' : Opens T} (h : U' ≤ U)
    (t : M.val.obj (op U)) : M.val.obj (op U') :=
  M.val.map (homOfLE h).op t

/-- Restriction of a section of `A` along an inclusion of opens. -/
noncomputable abbrev resA {U U' : Opens T} (h : U' ≤ U) (a : A.obj.obj (op U)) :
    A.obj.obj (op U') :=
  A.obj.map (homOfLE h).op a

/-- If `g` locally generates `M` over `W`, every element of `M` over `U ≤ W` is, near each point of
`U`, a combination of the restrictions of the `g`. -/
theorem LocallyGenerates.exists_nhds {M : SheafOfModules.{0} A} {W : Opens T} {m : ℕ}
    {g : Fin m → M.val.obj (op W)} (hg : LocallyGenerates M g) {U : Opens T} (hU : U ≤ W)
    (t : M.val.obj (op U)) {y : T} (hy : y ∈ U) :
    ∃ (U' : Opens T) (h : U' ≤ U), y ∈ U' ∧ ∃ c : Fin m → A.obj.obj (op U'),
      resM M h t = ∑ k, c k • resM M (h.trans hU) (g k) := by
  obtain ⟨S, hS, hc⟩ := hg U (homOfLE hU) t
  obtain ⟨U', f, hf, hy'⟩ := ((Opens.mem_grothendieckTopology _).1 hS) y hy
  obtain ⟨c, hc⟩ := hc U' f hf
  exact ⟨U', f.le, hy', c, hc⟩

/-- If every element of `M` over every `U ≤ W` is, near each point of `U`, a combination of the
restrictions of the `g`, then `g` locally generates `M` over `W`. -/
theorem locallyGenerates_of_nhds {M : SheafOfModules.{0} A} {W : Opens T} {m : ℕ}
    (g : Fin m → M.val.obj (op W))
    (hg : ∀ (U : Opens T) (hU : U ≤ W) (t : M.val.obj (op U)) (y : T), y ∈ U →
      ∃ (U' : Opens T) (h : U' ≤ U), y ∈ U' ∧ ∃ c : Fin m → A.obj.obj (op U'),
        resM M h t = ∑ k, c k • resM M (h.trans hU) (g k)) :
    LocallyGenerates M g := by
  intro Z z t
  let S : Sieve Z :=
    { arrows := fun V f => ∃ c : Fin m → A.obj.obj (op V),
        M.val.map f.op t = ∑ k, c k • M.val.map (f ≫ z).op (g k)
      downward_closed := by
        rintro V V' f ⟨c, hc⟩ h
        refine ⟨fun k => A.obj.map h.op (c k), ?_⟩
        rw [op_comp, PresheafOfModules.map_comp_apply, hc]
        erw [map_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        erw [PresheafOfModules.map_smul]
        rw [← PresheafOfModules.map_comp_apply, ← op_comp, Category.assoc]
        rfl }
  refine ⟨S, (Opens.mem_grothendieckTopology _).2 fun y hy => ?_, fun V f hf => hf⟩
  obtain ⟨U', h, hy', c, hc⟩ := hg Z z.le t y hy
  exact ⟨U', homOfLE h, ⟨c, hc⟩, hy'⟩

/-- `M` is locally generated by finitely many elements near every point. -/
def FinGen (M : SheafOfModules.{0} A) : Prop :=
  ∀ x : T, ∃ (W : Opens T), x ∈ W ∧ ∃ (m : ℕ) (g : Fin m → M.val.obj (op W)),
    LocallyGenerates M g

/-- A sheaf of modules on a space is of finite type if and only if it is locally generated by
finitely many elements near every point. -/
theorem isFiniteType_iff_finGen (M : SheafOfModules.{0} A) :
    SheafOfModules.IsFiniteType.{0} M ↔ FinGen M := by
  constructor
  · intro hM x
    obtain ⟨I, Y, hY, m, g, hg⟩ := exists_locallyGenerates_of_isFiniteType M hM
    obtain ⟨i, hi⟩ := ((Opens.coversTop_iff (U := Y)).1 hY).exists_mem x
    exact ⟨Y i, hi, m i, g i, hg i⟩
  · intro hM
    choose W hW m g hg using hM
    refine isFiniteType_of_locallyGenerates M ((Opens.coversTop_iff (U := W)).2 ?_) m g hg
    exact IsOpenCover.mk (eq_top_iff.2 fun x _ => Opens.mem_iSup.2 ⟨x, hW x⟩)

end Top

section Kernels

variable {C : Type} [SmallCategory C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{0}}
  [HasSheafify J AddCommGrpCat.{0}] [J.WEqualsLocallyBijective AddCommGrpCat.{0}]

/-- The restriction maps of a free module of finite rank act on the coefficients in the basis
`freeElt`. -/
theorem free_map_sum_smul {p : ℕ} {X X' : Cᵒᵖ} (h : X ⟶ X')
    (a : Fin p → R.obj.obj X) :
    (SheafOfModules.free (R := R) (Fin p)).val.map h (∑ i, a i • freeElt i X) =
      ∑ i, R.obj.map h (a i) • freeElt i X' := by
  erw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  erw [PresheafOfModules.map_smul, free_map_freeElt]
  rfl

/-- The coefficients of an element of a free module of finite rank in the basis `freeElt` are
unique. -/
theorem free_sum_smul_injective {I : Type} [Fintype I] {X : Cᵒᵖ} {a b : I → R.obj.obj X}
    (h : ∑ j, a j • freeElt (R := R) j X = ∑ j, b j • freeElt j X) : a = b := by
  classical
  exact funext (OkaCoherence.coeff_eq_of_sum_smul_eq h)

/-- A combination of combinations is a combination, with the product coefficients. -/
theorem sum_smul_sum_smul {R N : Type*} [Semiring R] [AddCommMonoid N] [Module R N]
    {ι κ : Type*} [Fintype ι] [Fintype κ] (d : ι → R) (r : ι → κ → R) (g : κ → N) :
    ∑ l, d l • ∑ k, r l k • g k = ∑ k, (∑ l, d l * r l k) • g k := by
  simp only [Finset.smul_sum, smul_smul, Finset.sum_smul]
  exact Finset.sum_comm

/-- A combination of restricted kernel elements of `g : Rᵖ ⟶ N` has, in the basis `freeElt`, the
combined restricted coefficients. -/
theorem kernel_ι_app_sum_smul_map {p s : ℕ} {N : SheafOfModules.{0} R}
    (g : SheafOfModules.free (R := R) (Fin p) ⟶ N) {X X' : Cᵒᵖ} (h : X ⟶ X')
    (kk : Fin s → (kernel g).val.obj X) (r : Fin s → Fin p → R.obj.obj X)
    (hkk : ∀ k, (kernel.ι g).val.app X (kk k) = ∑ j, r k j • freeElt j X)
    (c : Fin s → R.obj.obj X') :
    (kernel.ι g).val.app X' (∑ k, c k • (kernel g).val.map h (kk k)) =
      ∑ j, (∑ k, c k * R.obj.map h (r k j)) • freeElt j X' := by
  erw [map_sum]
  refine Eq.trans ?_ (sum_smul_sum_smul c (fun k j => R.obj.map h (r k j)) _)
  refine Finset.sum_congr rfl fun k _ => ?_
  erw [map_smul, PresheafOfModules.naturality_apply, hkk k, free_map_sum_smul]

end Kernels

section Coherence

open TopologicalSpace MMP.Analytic

variable {T : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- Finitely many elements of `M` over every open have locally finitely generated relations. -/
def RelFin (M : SheafOfModules.{0} A) : Prop :=
  ∀ (V : Opens T) (p : ℕ) (f : Fin p → M.val.obj (op V)) (x : T), x ∈ V →
    ∃ (W : Opens T) (hWV : W ≤ V), x ∈ W ∧ ∃ (s : ℕ) (r : Fin s → Fin p → A.obj.obj (op W)),
      (∀ k, ∑ j, r k j • resM M hWV (f j) = 0) ∧
      ∀ (U : Opens T) (hUW : U ≤ W) (a : Fin p → A.obj.obj (op U)),
        ∑ j, a j • resM M (hUW.trans hWV) (f j) = 0 → ∀ y ∈ U,
        ∃ (U' : Opens T) (h : U' ≤ U), y ∈ U' ∧ ∃ c : Fin s → A.obj.obj (op U'),
          ∀ j, resA h (a j) = ∑ k, c k * resA (h.trans hUW) (r k j)

/-- A coherent sheaf of modules has locally finitely generated relations. -/
theorem relFin_of_isCoherentModule {M : SheafOfModules.{0} A} (hM : IsCoherentModule M) :
    RelFin M := by
  intro V p f x hx
  let s : Fin p → (M.over V).sections := fun j => overSection M (f j)
  let g := (M.over V).freeHomEquiv.symm s
  obtain ⟨I, Y, hY, m, kk, hkk⟩ := exists_locallyGenerates_of_isFiniteType (kernel g) (hM.2 V p s)
  have hcov := hY (Over.mk (𝟙 V))
  rw [GrothendieckTopology.mem_over_iff] at hcov
  obtain ⟨V', f', hf', hxV'⟩ := (Opens.mem_grothendieckTopology _).1 hcov x hx
  rw [Sieve.overEquiv_iff] at hf'
  obtain ⟨i, ⟨φ⟩⟩ := hf'
  have hWV : (Y i).left ≤ V := (Y i).hom.le
  choose r hr using fun k => MMP.exists_eq_sum_smul_freeSection (R := A.over V) (op (Y i))
    ((kernel.ι g).val.app _ (kk i k))
  refine ⟨(Y i).left, hWV, φ.left.le hxV', m i, r, fun k => ?_, ?_⟩
  · have := kernel_condition_app g _ (kk i k)
    rwa [hr k, freeHomEquiv_symm_app_sum] at this
  · intro U hUW a ha y hy
    let Z : Over V := Over.mk (homOfLE (hUW.trans hWV))
    let q : (SheafOfModules.free (R := A.over V) (Fin p)).val.obj (op Z) :=
      ∑ j, (show (A.over V).obj.obj (op Z) from a j) • freeElt j (op Z)
    have hq : g.val.app (op Z) q = 0 := by
      rw [freeHomEquiv_symm_app_sum]
      exact ha
    obtain ⟨t, ht⟩ := exists_kernel_ι_app_eq g _ q hq
    let z : Z ⟶ Y i := Over.homMk (homOfLE hUW) (Subsingleton.elim _ _)
    obtain ⟨S, hS, hc⟩ := hkk i Z z t
    rw [GrothendieckTopology.mem_over_iff] at hS
    obtain ⟨U', f'', hf'', hyU'⟩ := (Opens.mem_grothendieckTopology _).1 hS y hy
    rw [Sieve.overEquiv_iff] at hf''
    obtain ⟨c, hc'⟩ := hc _ _ hf''
    refine ⟨U', f''.le, hyU', c, fun j => ?_⟩
    let φ : Over.mk (f'' ≫ Z.hom) ⟶ Z := Over.homMk f''
    have key' := (PresheafOfModules.naturality_apply (kernel.ι g).val φ.op t).symm.trans
      (congrArg ((kernel.ι g).val.app (op (Over.mk (f'' ≫ Z.hom)))) hc')
    have hL : (SheafOfModules.free (R := A.over V) (Fin p)).val.map φ.op
        ((kernel.ι g).val.app (op Z) t) =
        ∑ j, (A.over V).obj.map φ.op (a j) • freeElt j (op (Over.mk (f'' ≫ Z.hom))) := by
      rw [ht]
      exact free_map_sum_smul _ _
    exact congrFun (free_sum_smul_injective (hL.symm.trans
      (key'.trans (kernel_ι_app_sum_smul_map g (φ ≫ z).op (kk i) r hr c)))) j

/-- Restriction of sections of `A` is transitive. -/
theorem resA_resA {U U' U'' : Opens T} (h : U' ≤ U) (h' : U'' ≤ U') (a : A.obj.obj (op U)) :
    resA (A := A) h' (resA h a) = resA (h'.trans h) a := by
  simp only [resA]
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- Restriction of sections of `A` is multiplicative. -/
theorem resA_mul {U U' : Opens T} (h : U' ≤ U) (a b : A.obj.obj (op U)) :
    resA (A := A) h (a * b) = resA h a * resA h b :=
  map_mul (A.obj.map (homOfLE h).op).hom a b

/-- Restriction of sections of `A` commutes with subtraction. -/
theorem resA_sub {U U' : Opens T} (h : U' ≤ U) (a b : A.obj.obj (op U)) :
    resA (A := A) h (a - b) = resA h a - resA h b :=
  map_sub (A.obj.map (homOfLE h).op).hom a b

/-- Restriction of sections of `A` commutes with finite sums. -/
theorem resA_sum {U U' : Opens T} (h : U' ≤ U) {ι : Type*} [Fintype ι]
    (a : ι → A.obj.obj (op U)) :
    resA (A := A) h (∑ k, a k) = ∑ k, resA h (a k) :=
  map_sum (A.obj.map (homOfLE h).op).hom a _

/-- A sheaf of modules which is locally finitely generated and has locally finitely generated
relations is coherent. -/
theorem isCoherentModule_of_finGen_of_relFin {M : SheafOfModules.{0} A} (hF : FinGen M)
    (hR : RelFin M) : IsCoherentModule M := by
  refine ⟨(isFiniteType_iff_finGen M).2 hF, fun V p σ => ?_⟩
  let g := (M.over V).freeHomEquiv.symm σ
  let f : Fin p → M.val.obj (op V) := fun i => (σ i).1 (op (Over.mk (𝟙 V)))
  have hg : ∀ (Z : Over V) (a : Fin p → A.obj.obj (op Z.left)),
      g.val.app (op Z) (∑ i, (show (A.over V).obj.obj (op Z) from a i) • freeElt i (op Z)) =
        ∑ i, a i • resM M Z.hom.le (f i) := by
    intro Z a
    rw [freeHomEquiv_symm_app_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    exact congrArg _ (overSection_apply M (σ i) Z)
  choose W hWV hxW s r hr hgen using fun x : V => hR V p f x.1 x.2
  let Y : V → Over V := fun x => Over.mk (homOfLE (hWV x))
  have hk : ∀ x k, g.val.app (op (Y x))
      (∑ i, (show (A.over V).obj.obj (op (Y x)) from r x k i) • freeElt i (op (Y x))) = 0 :=
    fun x k => (hg (Y x) (r x k)).trans (hr x k)
  choose kk hkk using fun x k => exists_kernel_ι_app_eq g _ _ (hk x k)
  refine isFiniteType_of_locallyGenerates (kernel g) (Y := Y) ?_ s kk ?_
  · intro U
    rw [GrothendieckTopology.mem_over_iff]
    refine (Opens.mem_grothendieckTopology _).2 fun y hy => ?_
    let x : V := ⟨y, U.hom.le hy⟩
    refine ⟨U.left ⊓ W x, homOfLE inf_le_left, ?_, ⟨hy, hxW x⟩⟩
    rw [Sieve.overEquiv_iff]
    exact ⟨x, ⟨Over.homMk (homOfLE inf_le_right) (Subsingleton.elim _ _)⟩⟩
  · intro x Z z t
    obtain ⟨a, ha⟩ := MMP.exists_eq_sum_smul_freeSection (R := A.over V) (op Z)
      ((kernel.ι g).val.app (op Z) t)
    have hZW : Z.left ≤ W x := z.left.le
    let a' : Fin p → A.obj.obj (op Z.left) := a
    have hm' : ∑ i, a' i • resM M (hZW.trans (hWV x)) (f i) = 0 := by
      have h0 := kernel_condition_app g _ t
      rw [ha] at h0
      exact (hg Z a').symm.trans h0
    choose U' hU' hyU' c hc using hgen x Z.left hZW a' hm'
    let S : Sieve Z :=
      { arrows := fun W' _ => ∃ y : Z.left, W'.left ≤ U' y.1 y.2
        downward_closed := fun {W' W''} _ ⟨y, hy⟩ g => ⟨y, g.left.le.trans hy⟩ }
    refine ⟨S, ?_, ?_⟩
    · rw [GrothendieckTopology.mem_over_iff]
      refine (Opens.mem_grothendieckTopology _).2 fun y hy => ?_
      refine ⟨U' y hy, homOfLE (hU' y hy), ?_, hyU' y hy⟩
      rw [Sieve.overEquiv_iff]
      exact ⟨⟨y, hy⟩, le_rfl⟩
    · rintro W' φ ⟨⟨y, hy⟩, hle⟩
      refine ⟨fun k => (show (A.over V).obj.obj (op W') from resA hle (c y hy k)), ?_⟩
      apply kernel_ι_app_injective g (op W')
      have hL : (kernel.ι g).val.app (op W') ((kernel g).val.map φ.op t) =
          ∑ j, (A.over V).obj.map φ.op (a j) • freeElt j (op W') := by
        rw [PresheafOfModules.naturality_apply, ha]
        exact free_map_sum_smul _ _
      refine hL.trans (Eq.trans ?_
        (kernel_ι_app_sum_smul_map g (φ ≫ z).op (kk x) (r x) (hkk x) _).symm)
      refine Finset.sum_congr rfl fun j _ => ?_
      congr 1
      have key := congrArg (resA (A := A) hle) (hc y hy j)
      rw [resA_resA, resA_sum] at key
      simp only [resA_mul, resA_resA] at key
      exact key

end Coherence

section Res

open TopologicalSpace MMP.Analytic

variable {T : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- Restriction of elements of `M` is transitive. -/
theorem resM_resM (M : SheafOfModules.{0} A) {U U' U'' : Opens T} (h : U' ≤ U) (h' : U'' ≤ U')
    (t : M.val.obj (op U)) : resM M h' (resM M h t) = resM M (h'.trans h) t := by
  simp only [resM]
  rw [← PresheafOfModules.map_comp_apply]
  rfl

/-- Restriction of elements of `M` along `U ≤ U` is the identity. -/
theorem resM_refl (M : SheafOfModules.{0} A) {U : Opens T} (t : M.val.obj (op U)) :
    resM M (le_refl U) t = t := by
  simp only [resM]
  rw [show homOfLE (le_refl U) = 𝟙 U from Subsingleton.elim _ _, op_id,
    PresheafOfModules.map_id]
  rfl

/-- Restriction of sections of `A` along `U ≤ U` is the identity. -/
theorem resA_refl {U : Opens T} (a : A.obj.obj (op U)) : resA (A := A) (le_refl U) a = a := by
  simp only [resA]
  rw [show homOfLE (le_refl U) = 𝟙 U from Subsingleton.elim _ _, op_id,
    CategoryTheory.Functor.map_id]
  rfl

/-- Restriction of elements of `M` is semilinear along the restriction of sections of `A`. -/
theorem resM_smul (M : SheafOfModules.{0} A) {U U' : Opens T} (h : U' ≤ U) (a : A.obj.obj (op U))
    (t : M.val.obj (op U)) : resM M h (a • t) = resA h a • resM M h t :=
  PresheafOfModules.map_smul _ _ _ _

/-- Restriction of elements of `M` commutes with finite sums. -/
theorem resM_sum (M : SheafOfModules.{0} A) {U U' : Opens T} (h : U' ≤ U) {s : ℕ}
    (t : Fin s → M.val.obj (op U)) : resM M h (∑ k, t k) = ∑ k, resM M h (t k) :=
  map_sum (M.val.map (homOfLE h).op).hom t _

/-- The restriction of a combination is the combination of the restrictions, with restricted
coefficients. -/
theorem resM_sum_smul (M : SheafOfModules.{0} A) {U U' : Opens T} (h : U' ≤ U) {s : ℕ}
    (a : Fin s → A.obj.obj (op U)) (t : Fin s → M.val.obj (op U)) :
    resM M h (∑ k, a k • t k) = ∑ k, resA h (a k) • resM M h (t k) := by
  rw [resM_sum]
  exact Finset.sum_congr rfl fun k _ => resM_smul M h _ _

/-- Restricting a combination of restrictions further is the combination of the composite
restrictions, with restricted coefficients. -/
theorem resM_sum_smul_resM (M : SheafOfModules.{0} A) {U U' U'' : Opens T} (h : U'' ≤ U')
    (h' : U' ≤ U) {s : ℕ} (a : Fin s → A.obj.obj (op U')) (g : Fin s → M.val.obj (op U)) :
    resM M h (∑ k, a k • resM M h' (g k)) = ∑ k, resA h (a k) • resM M (h.trans h') (g k) := by
  rw [resM_sum_smul]
  simp only [resM_resM]

/-- Restriction of elements of `M` is additive. -/
theorem resM_add (M : SheafOfModules.{0} A) {U U' : Opens T} (h : U' ≤ U)
    (t t' : M.val.obj (op U)) : resM M h (t + t') = resM M h t + resM M h t' :=
  map_add (M.val.map (homOfLE h).op).hom t t'

/-- Restriction of elements of `M` sends `0` to `0`. -/
theorem resM_zero (M : SheafOfModules.{0} A) {U U' : Opens T} (h : U' ≤ U) :
    resM M h (0 : M.val.obj (op U)) = 0 :=
  map_zero (M.val.map (homOfLE h).op).hom

/-- A morphism of sheaves of modules commutes with restriction. -/
theorem hom_resM {M N : SheafOfModules.{0} A} (φ : M ⟶ N) {U U' : Opens T} (h : U' ≤ U)
    (t : M.val.obj (op U)) : φ.val.app (op U') (resM M h t) = resM N h (φ.val.app (op U) t) :=
  PresheafOfModules.naturality_apply _ _ _

/-- A morphism of sheaves of modules sends a combination to the combination of the images. -/
theorem hom_sum_smul {M N : SheafOfModules.{0} A} (φ : M ⟶ N) {U : Opens T} {s : ℕ}
    (a : Fin s → A.obj.obj (op U)) (t : Fin s → M.val.obj (op U)) :
    φ.val.app (op U) (∑ k, a k • t k) = ∑ k, a k • φ.val.app (op U) (t k) := by
  rw [map_sum]
  exact Finset.sum_congr rfl fun k _ => map_smul _ _ _

/-- Finitely many opens containing a point contain a common open neighbourhood of it. -/
theorem exists_le_of_forall_mem {x : T} {ι : Type*} [Finite ι] (V : ι → Opens T)
    (hx : ∀ j, x ∈ V j) : ∃ W : Opens T, x ∈ W ∧ ∀ j, W ≤ V j :=
  ⟨⟨interior (⋂ j, (V j : Set T)), isOpen_interior⟩, mem_interior_iff_mem_nhds.2 <|
    Filter.iInter_mem.2 fun j => (V j).isOpen.mem_nhds (hx j),
    fun j _ hy => Set.mem_iInter.1 (interior_subset hy) j⟩

end Res

section PartOne

open TopologicalSpace MMP.Analytic

variable {T : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- The kernel of a map from a locally finitely generated sheaf of modules to one with locally
finitely generated relations is locally finitely generated. -/
theorem finGen_kernel {P Q : SheafOfModules.{0} A} (φ : P ⟶ Q) (hP : FinGen P)
    (hQ : RelFin Q) : FinGen (kernel φ) := by
  intro x
  obtain ⟨W, hxW, m, g, hg⟩ := hP x
  obtain ⟨W', hW'W, hxW', s, r, hr, hgen⟩ := hQ W m (fun k => φ.val.app _ (g k)) x hxW
  have hk : ∀ l, φ.val.app (op W') (∑ k, r l k • resM P hW'W (g k)) = 0 := by
    intro l
    rw [hom_sum_smul]
    simpa only [hom_resM] using hr l
  choose κ hκ using fun l => exists_kernel_ι_app_eq φ (op W') _ (hk l)
  refine ⟨W', hxW', s, κ, locallyGenerates_of_nhds κ fun U hU t y hy => ?_⟩
  obtain ⟨U1, h1, hy1, c, hc⟩ := hg.exists_nhds (hU.trans hW'W) ((kernel.ι φ).val.app _ t) hy
  have hrel : ∑ k, c k • resM Q ((h1.trans hU).trans hW'W) (φ.val.app _ (g k)) = 0 := by
    have := congrArg (φ.val.app (op U1)) hc
    rw [hom_resM, kernel_condition_app, resM_zero, hom_sum_smul] at this
    simpa only [hom_resM] using this.symm
  obtain ⟨U2, h2, hy2, d, hd⟩ := hgen U1 (h1.trans hU) c hrel y hy1
  refine ⟨U2, h2.trans h1, hy2, d, ?_⟩
  apply kernel_ι_app_injective φ (op U2)
  have hL : (kernel.ι φ).val.app (op U2) (resM (kernel φ) (h2.trans h1) t) =
      ∑ k, resA h2 (c k) • resM P (((h2.trans h1).trans hU).trans hW'W) (g k) := by
    rw [hom_resM, ← resM_resM P h1 h2, hc, resM_sum_smul]
    simp only [resM_resM]
  have hR : (kernel.ι φ).val.app (op U2) (∑ l, d l • resM (kernel φ) ((h2.trans h1).trans hU) (κ l))
      = ∑ k, (∑ l, d l * resA (h2.trans (h1.trans hU)) (r l k)) •
        resM P (((h2.trans h1).trans hU).trans hW'W) (g k) := by
    rw [hom_sum_smul]
    simp only [hom_resM, hκ, resM_sum_smul, resM_resM]
    exact sum_smul_sum_smul d _ _
  rw [hL, hR]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [hd k]

/-- An element of `Q` with zero image in the cokernel of `φ` lies, near each point, in the image of
`φ`. -/
theorem exists_eq_of_cokernel_π_eq_zero {P Q : SheafOfModules.{0} A} (φ : P ⟶ Q) {U : Opens T}
    (t : Q.val.obj (op U)) (ht : (cokernel.π φ).val.app (op U) t = 0) {y : T} (hy : y ∈ U) :
    ∃ (U' : Opens T) (h : U' ≤ U), y ∈ U' ∧ ∃ σ : P.val.obj (op U'),
      φ.val.app (op U') σ = resM Q h t := by
  obtain ⟨k, hk⟩ := exists_kernel_ι_app_eq (cokernel.π φ) _ t ht
  have hl := liftSieve_mem_of_epi (Abelian.factorThruImage φ) k
  obtain ⟨U', f, ⟨σ, hσ⟩, hy'⟩ := (Opens.mem_grothendieckTopology _).1 hl y hy
  refine ⟨U', f.le, hy', σ, ?_⟩
  have h1 : φ.val.app (op U') σ =
      (kernel.ι (cokernel.π φ)).val.app (op U')
        ((Abelian.factorThruImage φ).val.app (op U') σ) := by
    conv_lhs => rw [← Abelian.image.fac φ]
    rfl
  rw [h1, hσ, PresheafOfModules.naturality_apply, hk]
  rfl

/-- The image of `φ` maps to zero in the cokernel of `φ`. -/
theorem cokernel_π_app_hom_app {P Q : SheafOfModules.{0} A} (φ : P ⟶ Q) {U : Opens T}
    (σ : P.val.obj (op U)) : (cokernel.π φ).val.app (op U) (φ.val.app (op U) σ) = 0 := by
  change (φ ≫ cokernel.π φ).val.app (op U) σ = 0
  rw [cokernel.condition]
  rfl

/-- A section of the cokernel of `φ` lifts, near each point, to a section of `Q`. -/
theorem exists_cokernel_π_app_eq {P Q : SheafOfModules.{0} A} (φ : P ⟶ Q) {V : Opens T}
    (e : (cokernel φ).val.obj (op V)) {x : T} (hx : x ∈ V) :
    ∃ (V' : Opens T) (h : V' ≤ V), x ∈ V' ∧ ∃ n : Q.val.obj (op V'),
      (cokernel.π φ).val.app (op V') n = resM (cokernel φ) h e := by
  obtain ⟨V', f, ⟨n, hn⟩, hx'⟩ :=
    (Opens.mem_grothendieckTopology _).1 (liftSieve_mem_of_epi (cokernel.π φ) e) x hx
  exact ⟨V', f.le, hx', n, hn⟩

/-- The cokernel of a map from a locally finitely generated sheaf of modules to one with locally
finitely generated relations has locally finitely generated relations. -/
theorem relFin_cokernel {P Q : SheafOfModules.{0} A} (φ : P ⟶ Q) (hP : FinGen P)
    (hQ : RelFin Q) : RelFin (cokernel φ) := by
  intro V p e x hx
  choose Vj hVj hxVj n hn using fun j => exists_cokernel_π_app_eq φ (e j) hx
  obtain ⟨V0, hxV0, hV0⟩ := exists_le_of_forall_mem Vj hxVj
  obtain ⟨W1, hxW1, m, g, hg⟩ := hP x
  let W2 := V0 ⊓ W1 ⊓ V
  have hW2V : W2 ≤ V := inf_le_right
  have hW2W1 : W2 ≤ W1 := inf_le_left.trans inf_le_right
  have hW2Vj : ∀ j, W2 ≤ Vj j := fun j => (inf_le_left.trans inf_le_left).trans (hV0 j)
  have hx2 : x ∈ W2 := ⟨⟨hxV0, hxW1⟩, hx⟩
  let F : Fin (p + m) → Q.val.obj (op W2) := Fin.append (fun j => resM Q (hW2Vj j) (n j))
    (fun k => φ.val.app _ (resM P hW2W1 (g k)))
  obtain ⟨W, hWW2, hxW, s, r, hr, hgen⟩ := hQ W2 (p + m) F x hx2
  refine ⟨W, hWW2.trans hW2V, hxW, s, fun k j => r k (Fin.castAdd m j), fun k => ?_, ?_⟩
  · have h0 := congrArg ((cokernel.π φ).val.app (op W)) (hr k)
    rw [hom_sum_smul, map_zero, Fin.sum_univ_add] at h0
    simpa only [hom_resM, F, Fin.append_left, Fin.append_right, cokernel_π_app_hom_app,
      resM_zero, smul_zero, Finset.sum_const_zero, add_zero, hn, resM_resM] using h0
  · intro U hUW a ha y hy
    let u : Q.val.obj (op U) := ∑ j, a j • resM Q (hUW.trans (hWW2.trans (hW2Vj j))) (n j)
    have hu : (cokernel.π φ).val.app (op U) u = 0 := by
      simp only [u]
      rw [hom_sum_smul]
      simp only [hom_resM, hn, resM_resM]
      exact ha
    obtain ⟨U1, h1, hy1, σ, hσ⟩ := exists_eq_of_cokernel_π_eq_zero φ u hu hy
    obtain ⟨U2, h2, hy2, c, hc⟩ :=
      hg.exists_nhds ((h1.trans hUW).trans (hWW2.trans hW2W1)) σ hy1
    let b : Fin (p + m) → A.obj.obj (op U2) :=
      Fin.append (fun j => resA (h2.trans h1) (a j)) (fun l => - c l)
    have hb : ∑ i, b i • resM Q ((h2.trans (h1.trans hUW)).trans hWW2) (F i) = 0 := by
      rw [Fin.sum_univ_add]
      simp only [b, F, Fin.append_left, Fin.append_right, resM_resM, hom_resM, neg_smul,
        Finset.sum_neg_distrib]
      have e1 : ∑ j, resA (h2.trans h1) (a j) •
          resM Q ((h2.trans (h1.trans hUW)).trans (hWW2.trans (hW2Vj j))) (n j) =
          resM Q h2 (resM Q h1 u) := by
        simp only [u, resM_sum_smul, resA_resA, resM_resM]
      have e2 : ∑ l, c l • resM Q ((h2.trans (h1.trans hUW)).trans (hWW2.trans hW2W1))
          (φ.val.app _ (g l)) = resM Q h2 (resM Q h1 u) := by
        rw [← hσ, ← hom_resM, hc, hom_sum_smul]
        simp only [hom_resM, resM_resM]
      rw [e1, e2, add_neg_cancel]
    obtain ⟨U3, h3, hy3, d, hd⟩ := hgen U2 ((h2.trans h1).trans hUW) b hb y hy2
    refine ⟨U3, h3.trans (h2.trans h1), hy3, d, fun j => ?_⟩
    simpa only [b, Fin.append_left, resA_resA] using hd (Fin.castAdd m j)

/-- The kernel of a map of coherent sheaves of modules is coherent. -/
theorem isCoherentModule_kernel {P Q : SheafOfModules.{0} A} (φ : P ⟶ Q)
    (hP : IsCoherentModule P) (hQ : IsCoherentModule Q) : IsCoherentModule (kernel φ) :=
  isCoherentModule_of_mono (kernel.ι φ) hP ((isFiniteType_iff_finGen _).2
    (finGen_kernel φ ((isFiniteType_iff_finGen P).1 hP.1) (relFin_of_isCoherentModule hQ)))

/-- The cokernel of a map from a sheaf of finite type to a coherent sheaf is coherent. -/
theorem isCoherentModule_cokernel {P Q : SheafOfModules.{0} A} (φ : P ⟶ Q)
    (hP : SheafOfModules.IsFiniteType.{0} P) (hQ : IsCoherentModule Q) :
    IsCoherentModule (cokernel φ) :=
  isCoherentModule_of_finGen_of_relFin
    ((isFiniteType_iff_finGen _).1 (isFiniteType_of_epi (cokernel.π φ) hQ.1))
    (relFin_cokernel φ ((isFiniteType_iff_finGen P).1 hP) (relFin_of_isCoherentModule hQ))

end PartOne

section PartTwo

open TopologicalSpace MMP.Analytic

variable {T : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- An element of a sheaf of modules which vanishes locally is zero. -/
theorem eq_zero_of_locally_eq_zero (M : SheafOfModules.{0} A) {U : Opens T}
    (t : M.val.obj (op U))
    (h : ∀ y ∈ U, ∃ (U' : Opens T) (hU' : U' ≤ U), y ∈ U' ∧ resM M hU' t = 0) : t = 0 := by
  let F : TopCat.Sheaf AddCommGrpCat.{0} T := ⟨M.val.presheaf, M.isSheaf⟩
  refine TopCat.Presheaf.section_ext F U t 0 fun y hy => ?_
  obtain ⟨U', hU', hy', h0⟩ := h y hy
  have e1 := TopCat.Presheaf.germ_res_apply F.presheaf (homOfLE hU') y hy' t
  have e2 := TopCat.Presheaf.germ_res_apply F.presheaf (homOfLE hU') y hy' 0
  rw [← e1, ← e2]
  exact congrArg _ (h0.trans (resM_zero M hU').symm)

/-- A sheaf of modules of finite type whose stalk at `x` vanishes is zero near `x`. -/
theorem exists_isZero_over_of_isZero_stalk (M : SheafOfModules.{0} A)
    (hM : SheafOfModules.IsFiniteType.{0} M) (x : T)
    (hx : Limits.IsZero (TopCat.Presheaf.stalk (X := T) M.val.presheaf x)) :
    ∃ W : Opens T, x ∈ W ∧ Limits.IsZero (M.over W) := by
  obtain ⟨W, hxW, m, g, hg⟩ := (isFiniteType_iff_finGen M).1 hM x
  have hloc : ∀ k, ∃ (Wk : Opens T), x ∈ Wk ∧ ∃ (h : Wk ≤ W), resM M h (g k) = 0 := by
    intro k
    have hgerm : TopCat.Presheaf.germ (X := T) M.val.presheaf W x hxW (g k) =
        TopCat.Presheaf.germ (X := T) M.val.presheaf W x hxW 0 := by
      rw [hx.eq_of_tgt (TopCat.Presheaf.germ (X := T) M.val.presheaf W x hxW) 0]
      rfl
    obtain ⟨Wk, hxk, i1, i2, he⟩ := TopCat.Presheaf.germ_eq _ x hxW hxW _ _ hgerm
    refine ⟨Wk, hxk, i1.le, ?_⟩
    obtain rfl : i1 = i2 := Subsingleton.elim _ _
    exact he.trans (map_zero _)
  choose Wk hxk hWk hk using hloc
  obtain ⟨W', hxW', hW'⟩ := exists_le_of_forall_mem Wk hxk
  refine ⟨W' ⊓ W, ⟨hxW', hxW⟩, ?_⟩
  have hzero : ∀ (U : Opens T) (hU : U ≤ W' ⊓ W) (t : M.val.obj (op U)), t = 0 := by
    intro U hU t
    refine eq_zero_of_locally_eq_zero M t fun y hy => ?_
    obtain ⟨U', hU', hy', c, hc⟩ := hg.exists_nhds (hU.trans inf_le_right) t hy
    refine ⟨U', hU', hy', hc.trans ?_⟩
    refine Finset.sum_eq_zero fun k _ => ?_
    have : resM M (hU'.trans (hU.trans inf_le_right)) (g k) = 0 := by
      have e := resM_resM M (hWk k) ((hU'.trans hU).trans (inf_le_left.trans (hW' k))) (g k)
      rw [hk k, resM_zero] at e
      exact e.symm
    rw [this, smul_zero]
  rw [Limits.IsZero.iff_id_eq_zero]
  ext Z t
  exact hzero Z.unop.left Z.unop.hom.le t

end PartTwo

section PartTwoA

open TopologicalSpace MMP.Analytic

section Site

variable {C : Type} [SmallCategory C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{0}}
  [HasSheafify J AddCommGrpCat.{0}] [J.WEqualsLocallyBijective AddCommGrpCat.{0}]

/-- If the values over `Y` of finitely many sections locally generate `M` over `Y`, the morphism
from the free module they define is an epimorphism on `Y`. -/
theorem epi_over_freeHomEquiv_symm (M : SheafOfModules.{0} R) {r : ℕ}
    (s : Fin r → M.sections) (Y : C) (hs : LocallyGenerates M (fun i => (s i).1 (op Y))) :
    Epi (SheafOfModules.Hom.over (M.freeHomEquiv.symm s) Y) := by
  refine epi_of_locally_surjective _ fun U q => ?_
  obtain ⟨S, hS, hSc⟩ := hs U.left U.hom q
  refine ⟨(Sieve.overEquiv U).symm S, ?_, fun W f hf => ?_⟩
  · rw [GrothendieckTopology.mem_over_iff]
    simpa using hS
  · rw [Sieve.overEquiv_symm_iff] at hf
    obtain ⟨c, hc⟩ := hSc W.left f.left hf
    refine ⟨∑ k, c k •
      (show (SheafOfModules.free (R := R) (Fin r)).val.obj (op W.left) from
        (SheafOfModules.freeSection (R := R) k).1 (op W.left)), ?_⟩
    change (M.freeHomEquiv.symm s).val.app (op W.left) _ = M.val.map f.left.op q
    refine (freeHomEquiv_symm_app_sum s (op W.left) c).trans ?_
    rw [hc]
    refine Finset.sum_congr rfl fun k _ => ?_
    congr 1
    rw [Over.w f]
    exact (PresheafOfModules.sections_property (s k) (W.hom).op).symm

end Site

variable {T : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- Local generation on an open `W ≤ V`, read on the slice over `V`. -/
theorem LocallyGenerates.over (M : SheafOfModules.{0} A) {V W : Opens T} (hWV : W ≤ V)
    {m : ℕ} {g : Fin m → M.val.obj (op W)} (hg : LocallyGenerates M g) :
    LocallyGenerates (M.over V) (Y := Over.mk (homOfLE hWV)) g := by
  intro Z z t
  obtain ⟨S, hS, hSc⟩ := hg Z.left z.left t
  refine ⟨(Sieve.overEquiv Z).symm S, ?_, fun W' f hf => ?_⟩
  · rw [GrothendieckTopology.mem_over_iff]
    simpa using hS
  · rw [Sieve.overEquiv_symm_iff] at hf
    exact hSc W'.left f.left hf

end PartTwoA

/-- **A determinant trick.** If `G = α σ + β G` in a module and `1 - β` has a left inverse, the
`G` are combinations of the `σ`. -/
theorem exists_eq_sum_smul_of_eq_add {R N : Type*} [Ring R] [AddCommGroup N] [Module R N]
    {q r : ℕ} (G : Fin q → N) (σ : Fin r → N) (α : Fin q → Fin r → R) (β : Fin q → Fin q → R)
    (hG : ∀ l, G l = ∑ i, α l i • σ i + ∑ k, β l k • G k)
    (Ninv : Matrix (Fin q) (Fin q) R) (hN : Ninv * (1 - Matrix.of β) = 1) :
    ∃ γ : Fin q → Fin r → R, ∀ l, G l = ∑ i, γ l i • σ i := by
  have h1 : ∀ m, ∑ k, (1 - Matrix.of β) m k • G k = ∑ i, α m i • σ i := by
    intro m
    simp only [Matrix.sub_apply, Matrix.one_apply, Matrix.of_apply, sub_smul,
      Finset.sum_sub_distrib, ite_smul, one_smul, zero_smul,
      Finset.sum_ite_eq, Finset.mem_univ, if_true]
    rw [hG m]
    abel
  refine ⟨fun l i => ∑ m, Ninv l m * α m i, fun l => ?_⟩
  calc G l = ∑ k, (Ninv * (1 - Matrix.of β)) l k • G k := by
        rw [hN]
        simp [Matrix.one_apply]
    _ = ∑ m, Ninv l m • ∑ k, (1 - Matrix.of β) m k • G k := by
        simp only [Matrix.mul_apply, Finset.sum_smul, Finset.smul_sum, mul_smul]
        exact Finset.sum_comm
    _ = ∑ i, (∑ m, Ninv l m * α m i) • σ i := by
        simp only [h1, Finset.smul_sum, Finset.sum_smul, mul_smul]
        exact Finset.sum_comm

section Holomorphic

open TopologicalSpace MMP.Analytic
open scoped Manifold ContDiff

variable {n : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
  [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M]

/-- The value at a point of the restriction of a holomorphic function is the value of the function
there. -/
theorem holEval_resA {U U' : Opens (TopCat.of M)} (h : U' ≤ U) (w : U')
    (a : (holomorphicRingCatSheaf n M).obj.obj (op U)) :
    holEval n U' w (resA h a) = holEval n U ⟨w.1, h w.2⟩ a := rfl

/-- The commutative ring structure on holomorphic functions, extending the given ring
structure. -/
noncomputable abbrev holCommRing (U : Opens (TopCat.of M)) :
    CommRing ((holomorphicRingCatSheaf n M).obj.obj (op U)) :=
  { (inferInstance : Ring ((holomorphicRingCatSheaf n M).obj.obj (op U))) with
    mul_comm := fun a b => holEval_ext fun w => by
      rw [map_mul, map_mul, mul_comm] }

/-- A holomorphic function without zeros is a unit. -/
theorem isUnit_of_holEval_ne_zero {U : Opens (TopCat.of M)}
    (a : (holomorphicRingCatSheaf n M).obj.obj (op U)) (h : ∀ w, holEval n U w a ≠ 0) :
    IsUnit a := by
  let b : (holomorphicRingCatSheaf n M).obj.obj (op U) :=
    (⟨fun w => (holEval n U w a)⁻¹, (contMDiff_holEval U a).inv₀ h⟩ :
      C^∞⟮𝓘(ℂ, EuclideanSpace ℂ (Fin n)), U; 𝓘(ℂ), ℂ⟯)
  refine ⟨⟨a, b, holEval_ext fun w => ?_, holEval_ext fun w => ?_⟩, rfl⟩
  · rw [map_mul, map_one]
    exact mul_inv_cancel₀ (h w)
  · rw [map_mul, map_one]
    exact inv_mul_cancel₀ (h w)

/-- The open subset of `U` where a holomorphic function does not vanish. -/
def nonvanishing {U : Opens (TopCat.of M)} (a : (holomorphicRingCatSheaf n M).obj.obj (op U)) :
    Opens (TopCat.of M) :=
  ⟨Subtype.val '' {w : U | holEval n U w a ≠ 0}, U.isOpen.isOpenMap_subtype_val _
    (isOpen_ne_fun (contMDiff_holEval U a).continuous continuous_const)⟩

/-- The nonvanishing locus of a holomorphic function on `U` is contained in `U`. -/
theorem nonvanishing_le {U : Opens (TopCat.of M)}
    (a : (holomorphicRingCatSheaf n M).obj.obj (op U)) : nonvanishing a ≤ U := by
  rintro _ ⟨w, _, rfl⟩; exact w.2

/-- A point of `U` where `a` does not vanish lies in the nonvanishing locus of `a`. -/
theorem mem_nonvanishing {U : Opens (TopCat.of M)}
    (a : (holomorphicRingCatSheaf n M).obj.obj (op U)) (w : U) (hw : holEval n U w a ≠ 0) :
    w.1 ∈ nonvanishing a :=
  ⟨w, hw, rfl⟩

/-- A holomorphic function does not vanish at the points of its nonvanishing locus. -/
theorem holEval_ne_zero_of_mem_nonvanishing {U : Opens (TopCat.of M)}
    (a : (holomorphicRingCatSheaf n M).obj.obj (op U)) (w : nonvanishing a) :
    holEval n U ⟨w.1, nonvanishing_le a w.2⟩ a ≠ 0 := by
  obtain ⟨v, hv, hvw⟩ := w.2
  have : (⟨w.1, nonvanishing_le a w.2⟩ : U) = v := Subtype.ext hvw.symm
  rw [this]; exact hv

/-- Evaluation at a point commutes with the determinant of a matrix of holomorphic functions. -/
theorem holEval_det {U : Opens (TopCat.of M)} (w : U) {q : ℕ}
    (B : Matrix (Fin q) (Fin q) ((holomorphicRingCatSheaf n M).obj.obj (op U))) :
    letI := holCommRing (n := n) U
    holEval n U w B.det = (B.map (holEval n U w)).det := by
  letI := holCommRing (n := n) U
  exact RingHom.map_det (holEval n U w) B

/-- If a matrix `β` of holomorphic functions vanishes at `x`, then `x` lies in the nonvanishing
locus of `det (1 - β)`. -/
theorem mem_nonvanishing_det_one_sub {U : Opens (TopCat.of M)} {x : M} (hx : x ∈ U) {q : ℕ}
    (β : Fin q → Fin q → (holomorphicRingCatSheaf n M).obj.obj (op U))
    (hβ : ∀ l k, holEval n U ⟨x, hx⟩ (β l k) = 0) :
    x ∈ nonvanishing (letI := holCommRing (n := n) U; (1 - Matrix.of β).det) := by
  letI := holCommRing (n := n) U
  refine mem_nonvanishing _ ⟨x, hx⟩ ?_
  rw [holEval_det]
  have : (1 - Matrix.of β).map (holEval n U ⟨x, hx⟩) = 1 := by
    ext l k
    simp [Matrix.one_apply, hβ]
  rw [this, Matrix.det_one]
  exact one_ne_zero

/-- On an open set where `det (1 - β)` does not vanish, the restriction of `1 - β` has a left
inverse. -/
theorem exists_mul_one_sub_resA_eq_one {U W : Opens (TopCat.of M)} (h : W ≤ U) {q : ℕ}
    (β : Fin q → Fin q → (holomorphicRingCatSheaf n M).obj.obj (op U))
    (hβ : ∀ w : W,
      holEval n U ⟨w.1, h w.2⟩ (letI := holCommRing (n := n) U; (1 - Matrix.of β).det) ≠ 0) :
    ∃ N : Matrix (Fin q) (Fin q) ((holomorphicRingCatSheaf n M).obj.obj (op W)),
      N * (1 - Matrix.of fun l k => resA h (β l k)) = 1 := by
  letI := holCommRing (n := n) W
  have hdet : IsUnit (1 - Matrix.of fun l k => resA h (β l k)).det := by
    refine isUnit_of_holEval_ne_zero _ fun w => ?_
    rw [holEval_det]
    have : (1 - Matrix.of fun l k => resA h (β l k)).map (holEval n W w) =
        (1 - Matrix.of β).map (holEval n U ⟨w.1, h w.2⟩) := by
      ext l k
      simp only [Matrix.map_apply, Matrix.sub_apply, Matrix.one_apply, Matrix.of_apply, map_sub]
      rw [holEval_resA h]
      split_ifs <;> simp only [map_one, map_zero]
    rw [this, ← holEval_det]
    exact hβ w
  exact ⟨_, Matrix.nonsing_inv_mul _ hdet⟩

/-- **Generation near a point.** If finitely many elements `s` of a sheaf of `𝒪_M`-modules of
finite type generate it near `x` modulo combinations with coefficients vanishing at `x`, they
generate it on a neighbourhood of `x`. -/
theorem exists_locallyGenerates_of_generates_mod
    (S : SheafOfModules.{0} (holomorphicRingCatSheaf n M))
    (hS : SheafOfModules.IsFiniteType.{0} S) {V : Opens (TopCat.of M)} {x : M} (hxV : x ∈ V)
    {r : ℕ} (s : Fin r → S.val.obj (op V))
    (H : ∀ (U : Opens (TopCat.of M)) (t : S.val.obj (op U)), x ∈ U →
      ∃ (U' : Opens (TopCat.of M)) (hU' : U' ≤ U ⊓ V) (hx : x ∈ U')
        (a : Fin r → (holomorphicRingCatSheaf n M).obj.obj (op U')) (m : ℕ)
        (b : Fin m → (holomorphicRingCatSheaf n M).obj.obj (op U'))
        (u : Fin m → S.val.obj (op U')),
        (∀ j, holEval n U' ⟨x, hx⟩ (b j) = 0) ∧
        resM S (hU'.trans inf_le_left) t =
          ∑ i, a i • resM S (hU'.trans inf_le_right) (s i) + ∑ j, b j • u j) :
    ∃ (W : Opens (TopCat.of M)) (hWV : W ≤ V), x ∈ W ∧
      LocallyGenerates S (fun i => resM S hWV (s i)) := by
  obtain ⟨W0, hxW0, q, g, hg⟩ := (isFiniteType_iff_finGen S).1 hS x
  choose U' hU' hxU' a m b u hb hgl using fun l => H W0 (g l) hxW0
  have hU'W0 : ∀ l, U' l ≤ W0 := fun l => (hU' l).trans inf_le_left
  choose U'' hU'' hxU'' C hC using fun (p : Σ l, Fin (m l)) =>
    hg.exists_nhds (hU'W0 p.1) (u p.1 p.2) (hxU' p.1)
  obtain ⟨W1a, hxW1a, hW1a⟩ := exists_le_of_forall_mem (ι := Σ l, Fin (m l)) U'' hxU''
  obtain ⟨W1b, hxW1b, hW1b⟩ := exists_le_of_forall_mem (ι := Fin q) U' hxU'
  let W1 := W1a ⊓ W1b ⊓ (W0 ⊓ V)
  have hxW1 : x ∈ W1 := ⟨⟨hxW1a, hxW1b⟩, hxW0, hxV⟩
  have h1U' : ∀ l, W1 ≤ U' l := fun l => (inf_le_left.trans inf_le_right).trans (hW1b l)
  have h1U'' : ∀ p, W1 ≤ U'' p := fun p => (inf_le_left.trans inf_le_left).trans (hW1a p)
  have h1W0 : W1 ≤ W0 := inf_le_right.trans inf_le_left
  have h1V : W1 ≤ V := inf_le_right.trans inf_le_right
  let G : Fin q → S.val.obj (op W1) := fun l => resM S h1W0 (g l)
  let σ : Fin r → S.val.obj (op W1) := fun i => resM S h1V (s i)
  let α : Fin q → Fin r → (holomorphicRingCatSheaf n M).obj.obj (op W1) :=
    fun l i => resA (h1U' l) (a l i)
  let β : Fin q → Fin q → (holomorphicRingCatSheaf n M).obj.obj (op W1) :=
    fun l k => ∑ j, resA (h1U' l) (b l j) * resA (h1U'' ⟨l, j⟩) (C ⟨l, j⟩ k)
  have hu : ∀ l j, resM S (h1U' l) (u l j) = ∑ k, resA (h1U'' ⟨l, j⟩) (C ⟨l, j⟩ k) • G k := by
    intro l j
    have e := congrArg (resM S (h1U'' ⟨l, j⟩)) (hC ⟨l, j⟩)
    rw [resM_resM, resM_sum_smul] at e
    simpa only [resM_resM] using e
  have hG : ∀ l, G l = ∑ i, α l i • σ i + ∑ k, β l k • G k := by
    intro l
    have e := congrArg (resM S (h1U' l)) (hgl l)
    rw [resM_resM, resM_add, resM_sum_smul, resM_sum_smul] at e
    simp only [resM_resM, hu] at e
    refine e.trans ?_
    congr 1
    exact sum_smul_sum_smul _ _ _
  have hβ : ∀ l k, holEval n W1 ⟨x, hxW1⟩ (β l k) = 0 := by
    intro l k
    simp only [β, map_sum, map_mul]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [holEval_resA (h1U' l), hb, zero_mul]
  let D : (holomorphicRingCatSheaf n M).obj.obj (op W1) :=
    letI := holCommRing (n := n) W1; (1 - Matrix.of β).det
  let W2 := nonvanishing D
  have h21 : W2 ≤ W1 := nonvanishing_le D
  have hxW2 : x ∈ W2 := mem_nonvanishing_det_one_sub hxW1 β hβ
  let G' : Fin q → S.val.obj (op W2) := fun l => resM S h21 (G l)
  let σ' : Fin r → S.val.obj (op W2) := fun i => resM S h21 (σ i)
  let β' : Fin q → Fin q → (holomorphicRingCatSheaf n M).obj.obj (op W2) :=
    fun l k => resA h21 (β l k)
  have hG' : ∀ l, G' l = ∑ i, resA h21 (α l i) • σ' i + ∑ k, β' l k • G' k := by
    intro l
    simp only [G', σ', β']
    conv_lhs => rw [hG l]
    rw [resM_add, resM_sum_smul, resM_sum_smul]
  obtain ⟨Ninv, hN⟩ :=
    exists_mul_one_sub_resA_eq_one h21 β (holEval_ne_zero_of_mem_nonvanishing D)
  obtain ⟨γ, hγ⟩ := exists_eq_sum_smul_of_eq_add G' σ' _ β' hG' Ninv hN
  refine ⟨W2, h21.trans h1V, hxW2, locallyGenerates_of_nhds _ fun U hU t y hy => ?_⟩
  obtain ⟨U3, h3, hy3, c, hc⟩ := hg.exists_nhds (hU.trans (h21.trans h1W0)) t hy
  refine ⟨U3, h3, hy3, fun i => ∑ k, c k * resA (h3.trans hU) (γ k i), ?_⟩
  rw [hc]
  have key : ∀ k, resM S (h3.trans (hU.trans (h21.trans h1W0))) (g k) =
      ∑ i, resA (h3.trans hU) (γ k i) •
        resM S ((h3.trans hU).trans (h21.trans h1V)) (s i) := by
    intro k
    have e := congrArg (resM S (h3.trans hU)) (hγ k)
    simp only [G', σ', G, σ, resM_resM] at e
    rw [resM_sum_smul] at e
    simpa only [resM_resM] using e
  simp only [key, resM_resM]
  exact sum_smul_sum_smul _ _ _

end Holomorphic

section PartTwoStatement

open TopologicalSpace MMP.Analytic
open scoped Manifold ContDiff

variable {n : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
  [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M]

/-- **Generation near a point.** If sections `s` over `V` of a coherent sheaf of `𝒪_M`-modules
generate it near `x` modulo combinations with coefficients vanishing at `x`, the morphism from the
free module they define is an epimorphism on a neighbourhood `W ≤ V` of `x`. -/
theorem generation_near_point (S : SheafOfModules.{0} (holomorphicRingCatSheaf n M))
    (hS : IsCoherentModule S) (V : Opens (TopCat.of M)) (x : M) (r : ℕ)
    (s : Fin r → (S.over V).sections)
    (H : ∀ (U : Opens (TopCat.of M)) (t : S.val.obj (op U)), x ∈ U →
      ∃ (U' : Opens (TopCat.of M)) (hU' : U' ≤ U ⊓ V) (hx : x ∈ U')
        (a : Fin r → (holomorphicRingCatSheaf n M).obj.obj (op U')) (m : ℕ)
        (b : Fin m → 𝒪[n, M].presheaf.obj (op U')) (u : Fin m → S.val.obj (op U')),
        (∀ j, b j ⟨x, hx⟩ = 0) ∧
        (show S.val.obj (op U') from
            S.val.presheaf.map (homOfLE (hU'.trans inf_le_left)).op t) =
          ∑ i, a i • (show S.val.obj (op U') from
            S.val.presheaf.map (homOfLE (hU'.trans inf_le_right)).op
              ((s i).1 (op (Over.mk (𝟙 V))))) +
          ∑ j, (show (holomorphicRingCatSheaf n M).obj.obj (op U') from b j) • u j) :
    ∃ (W : Opens (TopCat.of M)) (hWV : W ≤ V), x ∈ W ∧
      Epi (SheafOfModules.Hom.over ((S.over V).freeHomEquiv.symm s)
        (Over.mk (homOfLE hWV))) := by
  by_cases hxV : x ∈ V
  · obtain ⟨W, hWV, hxW, hgen⟩ := exists_locallyGenerates_of_generates_mod S hS.1 hxV
      (fun i => (s i).1 (op (Over.mk (𝟙 V)))) fun U t hx => by
        obtain ⟨U', hU', hx', a, m, b, u, hb, he⟩ := H U t hx
        exact ⟨U', hU', hx', a, m, b, u, hb, he⟩
    refine ⟨W, hWV, hxW, epi_over_freeHomEquiv_symm _ s _ ?_⟩
    have := LocallyGenerates.over S hWV hgen
    have he : (fun i => (s i).1 (op (Over.mk (homOfLE hWV)))) =
        fun i => resM S hWV ((s i).1 (op (Over.mk (𝟙 V)))) := by
      funext i
      exact overSection_apply S (s i) (Over.mk (homOfLE hWV))
    rw [he]
    exact this
  · obtain ⟨U', hU', hx', -⟩ := H ⊤ 0 trivial
    exact absurd ((hU'.trans inf_le_right) hx') hxV

end PartTwoStatement

section Vectors

open TopologicalSpace MMP.Analytic Limits

variable {T : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- Relations among `p` vectors of length `q` of sections of `A` are locally finitely
generated. -/
def VecRel (A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}) (q : ℕ) : Prop :=
  ∀ (V : Opens T) (p : ℕ) (F : Fin p → Fin q → A.obj.obj (op V)) (x : T), x ∈ V →
    ∃ (W : Opens T) (hWV : W ≤ V), x ∈ W ∧ ∃ (s : ℕ) (r : Fin s → Fin p → A.obj.obj (op W)),
      (∀ k m, ∑ j, r k j * resA hWV (F j m) = 0) ∧
      ∀ (U : Opens T) (hUW : U ≤ W) (a : Fin p → A.obj.obj (op U)),
        (∀ m, ∑ j, a j * resA (hUW.trans hWV) (F j m) = 0) → ∀ y ∈ U,
        ∃ (U' : Opens T) (h : U' ≤ U), y ∈ U' ∧ ∃ c : Fin s → A.obj.obj (op U'),
          ∀ j, resA h (a j) = ∑ k, c k * resA (h.trans hUW) (r k j)

/-- Relations among vectors of length `0` are locally finitely generated. -/
theorem vecRel_zero : VecRel A 0 := by
  classical
  intro V p F x hx
  refine ⟨V, le_rfl, hx, p, fun k j => if k = j then 1 else 0, fun k m => m.elim0,
    fun U hUW a _ y hy => ⟨U, le_rfl, hy, fun k => resA le_rfl (a k), fun j => ?_⟩⟩
  have : ∀ k, resA (A := A) ((le_rfl : U ≤ U).trans hUW)
      (if k = j then (1 : A.obj.obj (op V)) else 0) = if k = j then 1 else 0 := by
    intro k; split_ifs <;> simp [resA, map_one, map_zero]
  simp only [this, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]

/-- If `A`, as a module over itself, has locally finitely generated relations, so have vectors of
length `1`. -/
theorem vecRel_one_of_relFin (h : RelFin (SheafOfModules.unit A)) : VecRel A 1 := by
  intro V p F x hx
  obtain ⟨W, hWV, hxW, s, r, hr, hgen⟩ := h V p (fun j => F j 0) x hx
  refine ⟨W, hWV, hxW, s, r, fun k m => ?_, fun U hUW a ha y hy => hgen U hUW a (ha 0) y hy⟩
  rw [Subsingleton.elim m 0]
  exact hr k

/-- If relations among vectors of length `1` and among vectors of length `q` are locally finitely
generated, so are relations among vectors of length `q + 1`. -/
theorem vecRel_succ {q : ℕ} (h1 : VecRel A 1) (hq : VecRel A q) : VecRel A (q + 1) := by
  intro V p F x hx
  obtain ⟨W₁, hW₁V, hx₁, s₁, r, hr, hgr⟩ := h1 V p (fun j _ => F j (Fin.last q)) x hx
  let G : Fin s₁ → Fin q → A.obj.obj (op W₁) := fun k m =>
    ∑ j, r k j * resA hW₁V (F j m.castSucc)
  obtain ⟨W₂, hW₂W, hx₂, s₂, t, ht, hgt⟩ := hq W₁ s₁ G x hx₁
  refine ⟨W₂, hW₂W.trans hW₁V, hx₂, s₂, fun l j => ∑ k, t l k * resA hW₂W (r k j),
    fun l m => ?_, fun U hUW a har y hy => ?_⟩
  · have key : ∑ j, (∑ k, t l k * resA hW₂W (r k j)) * resA (hW₂W.trans hW₁V) (F j m) =
        ∑ k, t l k * resA hW₂W (∑ j, r k j * resA hW₁V (F j m)) := by
      simp only [resA_sum, resA_mul, resA_resA, Finset.sum_mul, Finset.mul_sum, mul_assoc]
      exact Finset.sum_comm
    rw [key]
    induction m using Fin.lastCases with
    | last =>
      have h0 : ∀ k, ∑ j, r k j * resA hW₁V (F j (Fin.last q)) = 0 := fun k => hr k 0
      simp only [h0]
      simp [resA]
    | cast m => exact ht l m
  · obtain ⟨U₁, hU₁U, hy₁, c, hc⟩ := hgr U (hUW.trans hW₂W) a (fun _ => har (Fin.last q)) y hy
    have hcG : ∀ m, ∑ k, c k * resA (hU₁U.trans (hUW.trans hW₂W)) (G k m) = 0 := by
      intro m
      have e : ∑ k, c k * resA (hU₁U.trans (hUW.trans hW₂W)) (G k m) =
          resA hU₁U (∑ j, a j * resA ((hUW.trans hW₂W).trans hW₁V) (F j m.castSucc)) := by
        simp only [G, resA_sum, resA_mul, resA_resA, hc, Finset.sum_mul, Finset.mul_sum,
          mul_assoc]
        exact Finset.sum_comm
      rw [e, har m.castSucc]
      simp [resA]
    obtain ⟨U₂, hU₂U, hy₂, d, hd⟩ := hgt U₁ (hU₁U.trans hUW) c hcG y hy₁
    refine ⟨U₂, hU₂U.trans hU₁U, hy₂, d, fun j => ?_⟩
    have e1 := congrArg (resA (A := A) hU₂U) (hc j)
    rw [resA_resA, resA_sum] at e1
    rw [e1]
    simp only [resA_mul, resA_resA, hd, Finset.sum_mul, Finset.mul_sum, resA_sum, mul_assoc]
    exact Finset.sum_comm

/-- If relations among vectors of length `1` are locally finitely generated, so are relations among
vectors of every length. -/
theorem vecRel_of_one (h1 : VecRel A 1) : ∀ q, VecRel A q
  | 0 => vecRel_zero
  | q + 1 => vecRel_succ h1 (vecRel_of_one h1 q)

/-- Relations among elements of a free module of finite rank. -/
theorem relFin_free_of_vecRel {q : ℕ} (h : VecRel A q) :
    RelFin (SheafOfModules.free (R := A) (Fin q)) := by
  intro V p f x hx
  choose F hF using fun j => MMP.exists_eq_sum_smul_freeSection (R := A) (op V) (f j)
  obtain ⟨W, hWV, hxW, s, r, hr, hgen⟩ := h V p F x hx
  have key : ∀ {U : Opens T} (hU : U ≤ V) (a : Fin p → A.obj.obj (op U)),
      ∑ j, a j • resM (SheafOfModules.free (R := A) (Fin q)) hU (f j) =
        ∑ m, (∑ j, a j * resA hU (F j m)) • freeElt m (op U) := by
    intro U hU a
    have e : ∀ j, resM (SheafOfModules.free (R := A) (Fin q)) hU (f j) =
        ∑ m, resA hU (F j m) • freeElt m (op U) := by
      intro j
      rw [hF j]
      exact free_map_sum_smul (R := A) _ _
    simp only [e]
    exact sum_smul_sum_smul _ _ _
  refine ⟨W, hWV, hxW, s, r, fun k => ?_, fun U hUW a ha y hy => ?_⟩
  · rw [key]
    simp only [hr k, zero_smul, Finset.sum_const_zero]
  · refine hgen U hUW a (fun m => ?_) y hy
    rw [key] at ha
    exact congrFun (free_sum_smul_injective (b := fun _ => 0) (ha.trans (by simp))) m

end Vectors

end CoherenceCalculus

section ClosureTheorem

open Topology IsLocalRing
open scoped Manifold ContDiff

variable {n : ℕ}

/-- The value `z^α` of a monomial. -/
noncomputable abbrev mon (α : Fin n →₀ ℕ) (z : Fin n → ℂ) : ℂ := ∏ i, z i ^ α i

/-- The monomial `∏ i, (z i - 0) ^ α i` of an expansion at `0` is `mon α z`. -/
theorem prod_eq_mon (α : Fin n →₀ ℕ) (z : Fin n → ℂ) :
    (α.prod fun i k => (z i - (0 : Fin n → ℂ) i) ^ k) = mon α z := by
  rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  simp

/-- `z ^ (β + eᵢ) = z i * z ^ β`. -/
theorem mon_add_single (β : Fin n →₀ ℕ) (i : Fin n) (z : Fin n → ℂ) :
    mon (β + Finsupp.single i 1) z = z i * mon β z := by
  simp only [mon, Finsupp.coe_add, Pi.add_apply, pow_add, Finset.prod_mul_distrib]
  rw [mul_comm]
  congr 1
  rw [Finset.prod_eq_single i (fun j _ hj => by rw [Finsupp.single_eq_of_ne hj, pow_zero])
    (by simp)]
  simp

/-- If every coordinate of `z` has norm at most `r`, then `‖z ^ α‖ ≤ r ^ |α|`. -/
theorem norm_mon_le {r : ℝ} (α : Fin n →₀ ℕ) {z : Fin n → ℂ}
    (hz : ∀ i, ‖z i‖ ≤ r) : ‖mon α z‖ ≤ r ^ α.degree := by
  rw [Finsupp.degree_eq_sum, ← Finset.prod_pow_eq_pow_sum, norm_prod]
  refine Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) fun i _ => ?_
  rw [norm_pow]
  exact pow_le_pow_left₀ (norm_nonneg _) (hz i) _

/-- For `r ≥ 0`, the monomial `z ^ α` at `z = (r, …, r)` has norm `r ^ |α|`. -/
theorem norm_mon_const {r : ℝ} (hr : 0 ≤ r) (α : Fin n →₀ ℕ) :
    ‖mon α (fun _ => (r : ℂ))‖ = r ^ α.degree := by
  rw [Finsupp.degree_eq_sum, ← Finset.prod_pow_eq_pow_sum, norm_prod]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [norm_pow, Complex.norm_real, Real.norm_of_nonneg hr]

variable (n) in
/-- The ring of holomorphic germs at `0 ∈ ℂⁿ` is a regular local ring. -/
@[instance_reducible] noncomputable def instRegular :
    IsRegularLocalRing (holGerms (0 : Fin n → ℂ)) :=
  (isRegularLocalRing_holGerms n).choose

attribute [local instance] instRegular

/-- The germ at `0` of a coordinate function lies in the maximal ideal of the ring of holomorphic
germs. -/
theorem coord_mem_maximalIdeal (i : Fin n) :
    (⟨((fun z : Fin n → ℂ => z i) : Germ (𝓝 (0 : Fin n → ℂ)) ℂ),
      coe_mem_holGerms (Eventually.of_forall fun _ => differentiableAt_apply i _)⟩ :
        holGerms (0 : Fin n → ℂ)) ∈ maximalIdeal (holGerms (0 : Fin n → ℂ)) := by
  obtain ⟨_, _, hm, _⟩ := isRegularLocalRing_holGerms n
  rw [hm]
  refine Ideal.subset_span ⟨i, ?_⟩
  apply Subtype.ext
  rw [coe_polyGermHom]
  congr 1
  funext y
  simp

/-- A function which is near `0` the sum of a power series has a holomorphic germ at `0`. -/
theorem mem_holGerms_of_hasSum {g : (Fin n → ℂ) → ℂ} {a : MvPowerSeries (Fin n) ℂ}
    (ha : ∀ᶠ z in 𝓝 0, HasSum (fun α => MvPowerSeries.coeff α a * mon α z) (g z)) :
    (g : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) ∈ holGerms (0 : Fin n → ℂ) := by
  refine coe_mem_holGerms
    (((eventually_differentiableAt_iff_exists_hasSum_mvPowerSeries.{0, 0} (0 : Fin n → ℂ)).1 g).2
      ⟨a, ?_⟩)
  filter_upwards [ha] with z hz
  simpa only [prod_eq_mon] using hz

/-- Adding `eᵢ` to a multi-index raises its degree by one. -/
theorem degree_add_single_one (β : Fin n →₀ ℕ) (i : Fin n) :
    (β + Finsupp.single i 1).degree = β.degree + 1 := by
  rw [map_add, Finsupp.degree_single]

/-- The weight `(β i + 1) / (|β| + 1)` has norm at most `1`. -/
theorem norm_succ_div_degree_succ_le_one (β : Fin n →₀ ℕ) (i : Fin n) :
    ‖((β i + 1 : ℂ) / (β.degree + 1))‖ ≤ 1 := by
  rw [norm_div]
  refine div_le_one_of_le₀ ?_ (norm_nonneg _)
  have h1 : (β i : ℝ) ≤ β.degree := by
    rw [Finsupp.degree_eq_sum]
    exact_mod_cast Finset.single_le_sum (fun j _ => Nat.zero_le (β j)) (Finset.mem_univ i)
  have e1 : ‖(β i + 1 : ℂ)‖ = β i + 1 := by
    rw [show (β i + 1 : ℂ) = ((β i + 1 : ℕ) : ℂ) by push_cast; ring, Complex.norm_natCast]
    push_cast; ring
  have e2 : ‖(β.degree + 1 : ℂ)‖ = β.degree + 1 := by
    rw [show (β.degree + 1 : ℂ) = ((β.degree + 1 : ℕ) : ℂ) by push_cast; ring,
      Complex.norm_natCast]
    push_cast; ring
  rw [e1, e2]
  linarith

/-- A multi-index with a nonzero `i`-th entry is `β + eᵢ` for some `β`. -/
theorem exists_add_single_eq {α : Fin n →₀ ℕ} {i : Fin n} (hα : α i ≠ 0) :
    ∃ β, β + Finsupp.single i 1 = α := by
  refine ⟨α - Finsupp.single i 1, ?_⟩
  ext j
  by_cases hj : j = i
  · subst hj
    simp
    omega
  · rw [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply,
      if_neg (fun h => hj h.symm)]
    simp

/-- Euler's identity for a power series without constant term: if `∑ aₐ zᵅ = w` and
`vᵢ = ∑ (βᵢ + 1)/(|β| + 1) a_{β + eᵢ} zᵝ`, then `w = ∑ zᵢ vᵢ`. -/
theorem eq_sum_mul_of_hasSum {a : MvPowerSeries (Fin n) ℂ} (hc0 : MvPowerSeries.coeff 0 a = 0)
    {z : Fin n → ℂ} {w : ℂ} {v : Fin n → ℂ}
    (hw : HasSum (fun α => MvPowerSeries.coeff α a * mon α z) w)
    (hv : ∀ i, HasSum (fun β => ((β i + 1 : ℂ) / (β.degree + 1)) *
      MvPowerSeries.coeff (β + Finsupp.single i 1) a * mon β z) (v i)) :
    w = ∑ i, z i * v i := by
  let F : Fin n → (Fin n →₀ ℕ) → ℂ := fun i α =>
    ((α i : ℂ) / α.degree) * MvPowerSeries.coeff α a * mon α z
  have hF : ∀ i, HasSum (F i) (z i * v i) := by
    intro i
    rw [← (add_left_injective (Finsupp.single i 1)).hasSum_iff]
    · refine ((hv i).mul_left (z i)).congr_fun fun β => ?_
      simp only [F, Function.comp, mon_add_single, degree_add_single_one, Finsupp.coe_add,
        Pi.add_apply, Finsupp.single_eq_same]
      push_cast
      ring
    · intro α hα
      have : α i = 0 := by
        by_contra hne
        exact hα (exists_add_single_eq hne)
      simp [F, this]
  refine hw.unique ((hasSum_sum (s := Finset.univ) fun i _ => hF i).congr_fun fun α => ?_)
  simp only [F]
  rw [← Finset.sum_mul, ← Finset.sum_mul, ← Finset.sum_div]
  by_cases hα : α.degree = 0
  · have : α = 0 := by
      rw [Finsupp.degree_eq_sum] at hα
      ext j
      exact (Finset.sum_eq_zero_iff.1 hα) j (Finset.mem_univ j)
    subst this
    simp [hc0]
  · have : (∑ i, (α i : ℂ)) / (α.degree : ℂ) = 1 := by
      rw [div_eq_one_iff_eq (by exact_mod_cast hα), Finsupp.degree_eq_sum]
      push_cast; rfl
    rw [this, one_mul]

/-- A holomorphic germ which near `0` is `∑ zᵢ hᵢ(z)` is the sum of the coordinate germs times
the germs of the `hᵢ`. -/
theorem holGerm_eq_sum_coord_mul {g : (Fin n → ℂ) → ℂ}
    (hg : (g : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) ∈ holGerms (0 : Fin n → ℂ))
    {h : Fin n → (Fin n → ℂ) → ℂ}
    (hh : ∀ i, (h i : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) ∈ holGerms (0 : Fin n → ℂ))
    (heq : ∀ᶠ z in 𝓝 0, g z = ∑ i, z i * h i z) :
    (⟨g, hg⟩ : holGerms (0 : Fin n → ℂ)) =
      ∑ i, (⟨((fun z : Fin n → ℂ => z i) : Germ (𝓝 (0 : Fin n → ℂ)) ℂ),
        coe_mem_holGerms (Eventually.of_forall fun _ => differentiableAt_apply i _)⟩ :
          holGerms (0 : Fin n → ℂ)) * ⟨h i, hh i⟩ := by
  apply Subtype.val_injective
  change _ = (holGerms (0 : Fin n → ℂ)).subtype (∑ i, _)
  rw [map_sum]
  simp only [map_mul, Subring.coe_subtype]
  change Germ.coeRingHom (𝓝 (0 : Fin n → ℂ)) g =
    ∑ i, Germ.coeRingHom (𝓝 (0 : Fin n → ℂ)) (fun z : Fin n → ℂ => z i) *
      Germ.coeRingHom (𝓝 (0 : Fin n → ℂ)) (h i)
  simp only [← map_mul, ← map_sum]
  refine Germ.coe_eq.2 ?_
  filter_upwards [heq] with z hz
  rw [hz, Finset.sum_apply]
  rfl

/-- A holomorphic germ whose power series has no terms of degree `< k` lies in `𝔪ᵏ`. -/
theorem mem_maximalIdeal_pow_of_coeff_eq_zero (k : ℕ) : ∀ (g : (Fin n → ℂ) → ℂ)
    (a : MvPowerSeries (Fin n) ℂ)
    (ha : ∀ᶠ z in 𝓝 0, HasSum (fun α => MvPowerSeries.coeff α a * mon α z) (g z)),
    (∀ α : Fin n →₀ ℕ, α.degree < k → MvPowerSeries.coeff α a = 0) →
    (⟨g, mem_holGerms_of_hasSum ha⟩ : holGerms (0 : Fin n → ℂ)) ∈
      maximalIdeal (holGerms (0 : Fin n → ℂ)) ^ k := by
  induction k with
  | zero => intro g a ha _; simp
  | succ k ih =>
    intro g a ha hk
    obtain ⟨ε, hε, hεs⟩ := Metric.eventually_nhds_iff.1 ha
    set r : ℝ := ε / 2 with hr_def
    have hr : 0 < r := half_pos hε
    have hrε : r < ε := half_lt_self hε
    have hw : HasSum (fun α => MvPowerSeries.coeff α a * mon α (fun _ => (r : ℂ)))
        (g fun _ => (r : ℂ)) := by
      refine hεs ?_
      rw [dist_zero_right]
      refine lt_of_le_of_lt ((pi_norm_le_iff_of_nonneg hr.le).2 fun i => ?_) hrε
      rw [Complex.norm_real, Real.norm_of_nonneg hr.le]
    let A : (Fin n →₀ ℕ) → ℝ := fun α => ‖MvPowerSeries.coeff α a‖ * r ^ α.degree
    have hA : Summable A := by
      have := summable_norm_iff.2 hw.summable
      refine this.congr fun α => ?_
      rw [norm_mul, norm_mon_const hr.le]
    let b : Fin n → MvPowerSeries (Fin n) ℂ := fun i β =>
      ((β i + 1 : ℂ) / (β.degree + 1)) * MvPowerSeries.coeff (β + Finsupp.single i 1) a
    have hb : ∀ i β, MvPowerSeries.coeff β (b i) =
        ((β i + 1 : ℂ) / (β.degree + 1)) * MvPowerSeries.coeff (β + Finsupp.single i 1) a :=
      fun _ _ => rfl
    have hcoef_le : ∀ i β, ‖MvPowerSeries.coeff β (b i)‖ ≤
        ‖MvPowerSeries.coeff (β + Finsupp.single i 1) a‖ := fun i β => by
      rw [hb, norm_mul]
      exact mul_le_of_le_one_left (norm_nonneg _) (norm_succ_div_degree_succ_le_one β i)
    have hsum : ∀ i (z : Fin n → ℂ), ‖z‖ < r →
        Summable (fun β => MvPowerSeries.coeff β (b i) * mon β z) := by
      intro i z hz
      have hz' : ∀ j, ‖z j‖ ≤ r := fun j => (norm_le_pi_norm z j).trans hz.le
      refine Summable.of_norm_bounded ((hA.comp_injective (add_left_injective
        (Finsupp.single i 1))).div_const r) fun β => ?_
      rw [norm_mul]
      calc ‖MvPowerSeries.coeff β (b i)‖ * ‖mon β z‖
          ≤ ‖MvPowerSeries.coeff (β + Finsupp.single i 1) a‖ * r ^ β.degree :=
            mul_le_mul (hcoef_le i β) (norm_mon_le β hz') (norm_nonneg _) (norm_nonneg _)
        _ = A (β + Finsupp.single i 1) / r := by
            simp only [A, Function.comp, degree_add_single_one, pow_succ]
            field_simp
    let h : Fin n → (Fin n → ℂ) → ℂ := fun i z =>
      ∑' β, MvPowerSeries.coeff β (b i) * mon β z
    have hh : ∀ i, ∀ᶠ z in 𝓝 0, HasSum (fun β => MvPowerSeries.coeff β (b i) * mon β z) (h i z) :=
      fun i => Metric.eventually_nhds_iff.2 ⟨r, hr, fun {z} hz => by
        rw [dist_zero_right] at hz
        exact (hsum i z hz).hasSum⟩
    have hbk : ∀ i (β : Fin n →₀ ℕ), β.degree < k → MvPowerSeries.coeff β (b i) = 0 := by
      intro i β hβ
      rw [hb, hk _ (by rw [degree_add_single_one]; omega), mul_zero]
    have hmem : ∀ i, (⟨h i, mem_holGerms_of_hasSum (hh i)⟩ : holGerms (0 : Fin n → ℂ)) ∈
        maximalIdeal (holGerms (0 : Fin n → ℂ)) ^ k :=
      fun i => ih (h i) (b i) (hh i) (hbk i)
    have hc0 : MvPowerSeries.coeff 0 a = 0 := hk 0 (by simp)
    have hgerm := holGerm_eq_sum_coord_mul (mem_holGerms_of_hasSum ha)
      (fun i => mem_holGerms_of_hasSum (hh i)) <| by
      filter_upwards [Metric.ball_mem_nhds (0 : Fin n → ℂ) hr] with z hz
      rw [Metric.mem_ball, dist_zero_right] at hz
      exact eq_sum_mul_of_hasSum hc0 (hεs (by rw [dist_zero_right]; exact hz.trans hrε))
        fun i => (hsum i z hz).hasSum
    rw [hgerm, pow_succ']
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_mul (coord_mem_maximalIdeal i) (hmem i)

/-- A representative of a holomorphic germ at `0`. -/
noncomputable def rep (g : holGerms (0 : Fin n → ℂ)) : (Fin n → ℂ) → ℂ := g.2.choose

/-- The germ of `rep g` is `g`. -/
theorem coe_rep (g : holGerms (0 : Fin n → ℂ)) : (rep g : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) = g :=
  g.2.choose_spec.1

/-- `rep g` is complex differentiable near `0`. -/
theorem rep_differentiable (g : holGerms (0 : Fin n → ℂ)) :
    ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), DifferentiableAt ℂ (rep g) z :=
  g.2.choose_spec.2

/-- `rep g` is near `0` the sum of a power series. -/
theorem exists_hasSum_rep (g : holGerms (0 : Fin n → ℂ)) :
    ∃ a : MvPowerSeries (Fin n) ℂ, ∀ᶠ z in 𝓝 0,
      HasSum (fun α => MvPowerSeries.coeff α a * mon α z) (rep g z) := by
  obtain ⟨a, ha⟩ := ((eventually_differentiableAt_iff_exists_hasSum_mvPowerSeries.{0, 0}
    (0 : Fin n → ℂ)).1 (rep g)).1 (rep_differentiable g)
  refine ⟨a, ?_⟩
  filter_upwards [ha] with z hz
  simpa only [prod_eq_mon] using hz

/-- The power series at `0` of a holomorphic germ. -/
noncomputable def serG (g : holGerms (0 : Fin n → ℂ)) : MvPowerSeries (Fin n) ℂ :=
  (exists_hasSum_rep g).choose

/-- `rep g` is near `0` the sum of the power series `serG g`. -/
theorem serG_spec (g : holGerms (0 : Fin n → ℂ)) : ∀ᶠ z in 𝓝 0,
    HasSum (fun α => MvPowerSeries.coeff α (serG g) * mon α z) (rep g z) :=
  (exists_hasSum_rep g).choose_spec

/-- The power series of a germ is the power series at `0` of any of its representatives. -/
theorem serG_eq {g : holGerms (0 : Fin n → ℂ)} {f : (Fin n → ℂ) → ℂ}
    (hf : (f : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) = g) {a : MvPowerSeries (Fin n) ℂ}
    (ha : ∀ᶠ z in 𝓝 0, HasSum (fun α => MvPowerSeries.coeff α a * mon α z) (f z)) :
    serG g = a := by
  have hrf : rep g =ᶠ[𝓝 0] f := Germ.coe_eq.1 ((coe_rep g).trans hf.symm)
  refine (eventually_differentiableAt_iff_exists_hasSum_mvPowerSeries.{0, 0}
    (0 : Fin n → ℂ)).2.1 (rep g) _ _ ?_ ?_
  · filter_upwards [serG_spec g] with z hz
    simpa only [prod_eq_mon] using hz
  · filter_upwards [ha, hrf] with z hz hz'
    rw [hz']
    simpa only [prod_eq_mon] using hz

/-- The power series of a sum of germs is the sum of their power series. -/
theorem serG_add (g g' : holGerms (0 : Fin n → ℂ)) : serG (g + g') = serG g + serG g' := by
  refine serG_eq (f := rep g + rep g') ?_ ?_
  · rw [Germ.coe_add, coe_rep, coe_rep]; rfl
  · filter_upwards [serG_spec g, serG_spec g'] with z hz hz'
    simpa only [map_add, add_mul, Pi.add_apply] using hz.add hz'

/-- The germ at `0` of the constant function `c`. -/
noncomputable def constG (c : ℂ) : holGerms (0 : Fin n → ℂ) :=
  ⟨((fun _ => c : (Fin n → ℂ) → ℂ) : Germ (𝓝 (0 : Fin n → ℂ)) ℂ),
    coe_mem_holGerms (Eventually.of_forall fun _ => differentiableAt_const c)⟩

/-- The power series of `constG c * g` is `c • serG g`. -/
theorem serG_constG_mul (c : ℂ) (g : holGerms (0 : Fin n → ℂ)) :
    serG (constG c * g) = c • serG g := by
  refine serG_eq (f := fun z => c * rep g z) ?_ ?_
  · change Germ.coeRingHom _ ((fun _ => c) * rep g) = _
    rw [map_mul]
    change ((fun _ => c : (Fin n → ℂ) → ℂ) : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) * (rep g : Germ _ ℂ) = _
    rw [coe_rep]; rfl
  · filter_upwards [serG_spec g] with z hz
    simpa only [map_smul, smul_eq_mul, mul_assoc] using hz.mul_left c

/-- The power series of `-g` is the negative of the power series of `g`. -/
theorem serG_neg (g : holGerms (0 : Fin n → ℂ)) : serG (-g) = - serG g := by
  have h := serG_add g (-g)
  rw [add_neg_cancel] at h
  have h0 : serG (0 : holGerms (0 : Fin n → ℂ)) = 0 := by
    have := serG_add (0 : holGerms (0 : Fin n → ℂ)) 0
    rw [add_zero] at this
    exact left_eq_add.1 this
  rw [h0] at h
  exact (neg_eq_of_add_eq_zero_right h.symm).symm

/-- The closed polydisc of radius `ρ` about `0`. -/
abbrev polydisc (ρ : ℝ) : Set (Fin n → ℂ) := Set.univ.pi fun _ => Metric.closedBall (0 : ℂ) ρ

/-- **Cauchy estimates** for the power series of a germ. -/
theorem norm_coeff_serG_le {U : Set (Fin n → ℂ)} (hU : IsOpen U) {ρ : ℝ} (hρ : 0 < ρ)
    (hD : polydisc ρ ⊆ U) {h : (Fin n → ℂ) → ℂ} (hh : DifferentiableOn ℂ h U) {ε : ℝ}
    (hε : ∀ z ∈ polydisc ρ, ‖h z‖ ≤ ε) {g : holGerms (0 : Fin n → ℂ)}
    (hg : (h : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) = g) (α : Fin n →₀ ℕ) :
    ‖MvPowerSeries.coeff α (serG g)‖ ≤ ε / ρ ^ α.degree := by
  have hC := ((MMP.SeveralComplex.cauchy_osgood_laurent.{0, 0} ℂ).2.2.2.1 n 0 (fun _ => ρ) ε U h
    (fun _ => hρ) hU hD hh hε).1
  have hrh : rep g =ᶠ[𝓝 0] h := Germ.coe_eq.1 ((coe_rep g).trans hg.symm)
  have key := hC (fun β => MvPowerSeries.coeff (Finsupp.equivFunOnFinite.symm β) (serG g)) ?_
    (Finsupp.equivFunOnFinite α)
  · simp only [Equiv.symm_apply_apply] at key
    refine key.trans_eq ?_
    congr 1
    rw [Finsupp.degree_eq_sum, ← Finset.prod_pow_eq_pow_sum]
    rfl
  · filter_upwards [serG_spec g, hrh] with z hz hz'
    rw [hz', ← (Finsupp.equivFunOnFinite (α := Fin n) (M := ℕ)).symm.hasSum_iff] at hz
    refine hz.congr_fun fun β => ?_
    simp only [Function.comp, mon, smul_eq_mul, Pi.zero_apply, sub_zero]
    rw [mul_comm]
    rfl

/-- The germ at `0` of a function holomorphic near `0`. -/
noncomputable abbrev germOf (g : (Fin n → ℂ) → ℂ)
    (hg : ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), DifferentiableAt ℂ g z) : holGerms (0 : Fin n → ℂ) :=
  ⟨g, coe_mem_holGerms hg⟩

/-- The coercion of holomorphic germs to germs commutes with finite sums. -/
theorem coe_sum_germ {s : ℕ} (x : Fin s → holGerms (0 : Fin n → ℂ)) :
    ((∑ l, x l : holGerms (0 : Fin n → ℂ)) : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) = ∑ l, (x l : Germ _ ℂ) :=
  map_sum (holGerms (0 : Fin n → ℂ)).subtype x _

/-- The germ of `z ↦ ∑ l, c l z * G l z` is `∑ l, c l * G l` in the ring of germs. -/
theorem coe_sum_mul_germ {s : ℕ} (c G : Fin s → (Fin n → ℂ) → ℂ) :
    ((fun z => ∑ l, c l z * G l z : (Fin n → ℂ) → ℂ) : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) =
      ∑ l, (c l : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) * (G l : Germ _ ℂ) := by
  change Germ.coeRingHom _ _ = ∑ l, Germ.coeRingHom _ (c l) * Germ.coeRingHom _ (G l)
  simp only [← map_mul, ← map_sum]
  congr 1
  funext z
  simp [Finset.sum_apply]

/-- If `F m → f` uniformly on a polydisc, the power series coefficients at `0` of `F m - f`
tend to zero. -/
theorem tendsto_coeff_serG_sub_of_tendstoUniformlyOn {U : Set (Fin n → ℂ)} (hU : IsOpen U)
    {ρ : ℝ} (hρ : 0 < ρ) (hD : polydisc ρ ⊆ U) {F : ℕ → (Fin n → ℂ) → ℂ} {f : (Fin n → ℂ) → ℂ}
    (hF : ∀ m, DifferentiableOn ℂ (F m) U) (hf : DifferentiableOn ℂ f U)
    (hconv : TendstoUniformlyOn F f atTop (polydisc ρ))
    (hF' : ∀ m, ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), DifferentiableAt ℂ (F m) z)
    (hf' : ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), DifferentiableAt ℂ f z) (α : Fin n →₀ ℕ) :
    Tendsto (fun m => MvPowerSeries.coeff α (serG (germOf (F m) (hF' m) - germOf f hf')))
      atTop (𝓝 0) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  set c : ℝ := ρ ^ α.degree with hc
  have hcpos : 0 < c := pow_pos hρ _
  obtain ⟨M, hM⟩ := Filter.eventually_atTop.1
    ((Metric.tendstoUniformlyOn_iff.1 hconv) (ε * c / 2) (by positivity))
  refine ⟨M, fun m hm => ?_⟩
  rw [dist_zero_right]
  have hb := norm_coeff_serG_le hU hρ hD ((hF m).sub hf) (ε := ε * c / 2)
    (fun z hz => by
      have := hM m hm z hz
      rw [dist_comm, dist_eq_norm] at this
      exact this.le)
    (g := germOf (F m) (hF' m) - germOf f hf') (by rw [Germ.coe_sub]; rfl) α
  calc _ ≤ ε * c / 2 / c := hb
    _ = ε / 2 := by field_simp
    _ < ε := half_lt_self hε

/-- If vectors of germs `γF m ∈ N` converge coefficientwise to `γf`, then `γf` lies in `N`
modulo every power of the maximal ideal. -/
theorem exists_mem_sub_mem_maximalIdeal_pow_of_tendsto_coeff {p : ℕ}
    (N : Submodule (holGerms (0 : Fin n → ℂ)) (Fin p → holGerms (0 : Fin n → ℂ)))
    (γF : ℕ → Fin p → holGerms (0 : Fin n → ℂ)) (hγF : ∀ m, γF m ∈ N)
    (γf : Fin p → holGerms (0 : Fin n → ℂ))
    (hcoeff : ∀ j α, Tendsto (fun m => MvPowerSeries.coeff α (serG (γF m j - γf j))) atTop (𝓝 0))
    (k : ℕ) : ∃ ν ∈ N, ∀ j, γf j - ν j ∈ maximalIdeal (holGerms (0 : Fin n → ℂ)) ^ k := by
  let toα : (Fin n → Fin k) → (Fin n →₀ ℕ) := fun β =>
    Finsupp.equivFunOnFinite.symm (fun i => (β i : ℕ))
  let J : (Fin p → holGerms (0 : Fin n → ℂ)) → (Fin p → (Fin n → Fin k) → ℂ) := fun ν j β =>
    MvPowerSeries.coeff (toα β) (serG (ν j))
  have J_add : ∀ ν ν', J (ν + ν') = J ν + J ν' := by
    intro ν ν'; funext j β
    simp only [J, Pi.add_apply]
    rw [serG_add, map_add]
  have J_zero : J 0 = 0 := by
    have := J_add 0 0
    rw [add_zero] at this
    exact left_eq_add.1 this
  have J_sub : ∀ ν ν', J (ν - ν') = J ν - J ν' := by
    intro ν ν'; funext j β
    simp only [J]
    rw [Pi.sub_apply, sub_eq_add_neg, serG_add, serG_neg, map_add, map_neg, sub_eq_add_neg]
    rfl
  have J_smul : ∀ (c : ℂ) ν, J ((constG c : holGerms (0 : Fin n → ℂ)) • ν) = c • J ν := by
    intro c ν; funext j β
    simp only [J, Pi.smul_apply, smul_eq_mul, serG_constG_mul, map_smul]
  let S : Submodule ℂ (Fin p → (Fin n → Fin k) → ℂ) :=
    { carrier := J '' N
      add_mem' := by
        rintro _ _ ⟨ν, hν, rfl⟩ ⟨ν', hν', rfl⟩
        exact ⟨ν + ν', N.add_mem hν hν', J_add ν ν'⟩
      zero_mem' := ⟨0, N.zero_mem, J_zero⟩
      smul_mem' := by
        rintro c _ ⟨ν, hν, rfl⟩
        exact ⟨(constG c : holGerms (0 : Fin n → ℂ)) • ν, N.smul_mem _ hν, J_smul c ν⟩ }
  have hS : IsClosed (S : Set (Fin p → (Fin n → Fin k) → ℂ)) := S.closed_of_finiteDimensional
  have hlim : Tendsto (fun m => J (γF m)) atTop (𝓝 (J γf)) := by
    refine tendsto_pi_nhds.2 fun j => tendsto_pi_nhds.2 fun β => ?_
    have hsplit : ∀ m, J (γF m) j β = J γf j β +
        MvPowerSeries.coeff (toα β) (serG (γF m j - γf j)) := by
      intro m
      simp only [J]
      rw [← map_add, ← serG_add, add_sub_cancel]
    simp only [hsplit]
    simpa using (tendsto_const_nhds (x := J γf j β)).add (hcoeff j (toα β))
  have hJf : J γf ∈ S := hS.mem_of_tendsto hlim (Eventually.of_forall fun m => ⟨γF m, hγF m, rfl⟩)
  obtain ⟨ν, hν, hJν⟩ := hJf
  refine ⟨ν, hν, fun j => ?_⟩
  set w := γf j - ν j with hw
  have hcoef : ∀ β, MvPowerSeries.coeff (toα β) (serG w) = 0 := by
    intro β
    have h1 := congrFun (congrFun (J_sub γf ν) j) β
    rw [hJν, sub_self] at h1
    exact h1
  have hT := mem_maximalIdeal_pow_of_coeff_eq_zero k (rep w) (serG w) (serG_spec w) (by
    intro α hα
    have hlt : ∀ i, α i < k := fun i => by
      have : α i ≤ α.degree := by
        rw [Finsupp.degree_eq_sum]
        exact Finset.single_le_sum (fun j _ => Nat.zero_le (α j)) (Finset.mem_univ i)
      omega
    have : α = toα (fun i => ⟨α i, hlt i⟩) := by
      ext i; simp [toα]
    rw [this]
    exact hcoef _)
  have hrw : (⟨rep w, mem_holGerms_of_hasSum (serG_spec w)⟩ : holGerms (0 : Fin n → ℂ)) = w :=
    Subtype.ext (coe_rep w)
  rwa [hrw] at hT

/-- **Krull closure.** Over a noetherian local ring `R`, a vector lying in a submodule `N` of `Rᵖ`
modulo every power of the maximal ideal lies in `N`. -/
theorem mem_of_forall_sub_mem_maximalIdeal_pow {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] {p : ℕ} (N : Submodule R (Fin p → R)) (γ : Fin p → R)
    (h : ∀ k : ℕ, ∃ ν ∈ N, ∀ j, γ j - ν j ∈ maximalIdeal R ^ k) : γ ∈ N := by
  have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (R := R) (M := (Fin p → R) ⧸ N)
    (I := maximalIdeal R) (maximalIdeal.isMaximal R).ne_top
  have hmemK : N.mkQ γ ∈ (⨅ i : ℕ, maximalIdeal R ^ i • ⊤ : Submodule R ((Fin p → R) ⧸ N)) := by
    refine Submodule.mem_iInf _ |>.2 fun k => ?_
    obtain ⟨ν, hν, hw⟩ := h k
    have h1 : N.mkQ γ = N.mkQ (γ - ν) := by
      rw [map_sub, show N.mkQ ν = 0 from (Submodule.Quotient.mk_eq_zero N).2 hν, sub_zero]
    rw [h1, pi_eq_sum_univ (γ - ν), map_sum]
    refine Submodule.sum_mem _ fun j _ => ?_
    rw [map_smul]
    exact Submodule.smul_mem_smul (hw j) Submodule.mem_top
  rw [hK, Submodule.mem_bot] at hmemK
  exact (Submodule.Quotient.mk_eq_zero N).1 hmemK

/-- **The closure theorem at a point.** If vectors `F m` of holomorphic functions, each a
combination near `0` of fixed vectors `G l`, converge uniformly on a polydisc to `f`, then `f` is
a combination of the `G l` near `0`. -/
theorem exists_eventuallyEq_sum_of_tendstoUniformlyOn {p s : ℕ}
    (G : Fin s → Fin p → (Fin n → ℂ) → ℂ) (hG : ∀ l j, ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ (G l j) z)
    (F : ℕ → Fin p → (Fin n → ℂ) → ℂ) (f : Fin p → (Fin n → ℂ) → ℂ)
    {U : Set (Fin n → ℂ)} (hU : IsOpen U) {ρ : ℝ} (hρ : 0 < ρ) (hD : polydisc ρ ⊆ U)
    (hF : ∀ m j, DifferentiableOn ℂ (F m j) U) (hf : ∀ j, DifferentiableOn ℂ (f j) U)
    (hconv : ∀ j, TendstoUniformlyOn (fun m => F m j) (f j) atTop (polydisc ρ))
    (hmem : ∀ m, ∃ c : Fin s → (Fin n → ℂ) → ℂ, (∀ l, ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ (c l) z) ∧
      ∀ j, F m j =ᶠ[𝓝 0] fun z => ∑ l, c l z * G l j z) :
    ∃ c : Fin s → (Fin n → ℂ) → ℂ, (∀ l, ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ (c l) z) ∧
      ∀ j, f j =ᶠ[𝓝 0] fun z => ∑ l, c l z * G l j z := by
  have h0U : (0 : Fin n → ℂ) ∈ U := hD fun i _ => Metric.mem_closedBall_self hρ.le
  have hdiffU : ∀ g : (Fin n → ℂ) → ℂ, DifferentiableOn ℂ g U →
      ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), DifferentiableAt ℂ g z := fun g hg =>
    Filter.eventually_of_mem (hU.mem_nhds h0U) fun z hz => hg.differentiableAt (hU.mem_nhds hz)
  let O := holGerms (0 : Fin n → ℂ)
  let gv : Fin s → (Fin p → O) := fun l j => germOf (G l j) (hG l j)
  let N : Submodule O (Fin p → O) := Submodule.span O (Set.range gv)
  let γF : ℕ → Fin p → O := fun m j => germOf (F m j) (hdiffU _ (hF m j))
  let γf : Fin p → O := fun j => germOf (f j) (hdiffU _ (hf j))
  have hγF : ∀ m, γF m ∈ N := by
    intro m
    obtain ⟨c, hc, heq⟩ := hmem m
    have : γF m = ∑ l, germOf (c l) (hc l) • gv l := by
      funext j
      apply Subtype.ext
      rw [Finset.sum_apply]
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [coe_sum_germ]
      simp only [Subring.coe_mul]
      rw [← coe_sum_mul_germ]
      exact Germ.coe_eq.2 (heq j)
    rw [this]
    exact Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
  have hγf : γf ∈ N := mem_of_forall_sub_mem_maximalIdeal_pow N γf fun k =>
    exists_mem_sub_mem_maximalIdeal_pow_of_tendsto_coeff N γF hγF γf (fun j α =>
      tendsto_coeff_serG_sub_of_tendstoUniformlyOn hU hρ hD (fun m => hF m j) (hf j) (hconv j)
        (fun m => hdiffU _ (hF m j)) (hdiffU _ (hf j)) α) k
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun O).1 hγf
  refine ⟨fun l => rep (c l), fun l => rep_differentiable (c l), fun j => ?_⟩
  refine Germ.coe_eq.1 ?_
  rw [coe_sum_mul_germ]
  have h2 := congrArg (fun v : Fin p → O => (v j : Germ (𝓝 (0 : Fin n → ℂ)) ℂ)) hc
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at h2
  rw [coe_sum_germ] at h2
  simp only [Subring.coe_mul] at h2
  rw [show ((f j : (Fin n → ℂ) → ℂ) : Germ (𝓝 (0 : Fin n → ℂ)) ℂ) = (γf j : Germ _ ℂ) from rfl,
    ← h2]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [coe_rep]

section Chart

open TopologicalSpace CategoryTheory Opposite

variable {M : Type} [TopologicalSpace M] [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
  [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M]

/-- The coordinate identification `EuclideanSpace ℂ (Fin n) ≃ (Fin n → ℂ)`. -/
noncomputable abbrev coordEquiv (n : ℕ) := EuclideanSpace.equiv (Fin n) ℂ

/-- The chart at `x`, read as a map from a neighbourhood of `0 ∈ ℂⁿ` to `M`. -/
noncomputable def chartInv (x : M) (z : Fin n → ℂ) : M :=
  (chartAt (EuclideanSpace ℂ (Fin n)) x).symm
    ((coordEquiv n).symm (z + coordEquiv n (chartAt (EuclideanSpace ℂ (Fin n)) x x)))

/-- The chart at `x`, centred at `0 ∈ ℂⁿ`. -/
noncomputable def chartFwd (x : M) (y : M) : Fin n → ℂ :=
  coordEquiv n (chartAt (EuclideanSpace ℂ (Fin n)) x y) -
    coordEquiv n (chartAt (EuclideanSpace ℂ (Fin n)) x x)

/-- The domain of `chartInv x`. -/
def chartDom (x : M) : Set (Fin n → ℂ) :=
  {z | (coordEquiv n).symm (z + coordEquiv n (chartAt (EuclideanSpace ℂ (Fin n)) x x)) ∈
    (chartAt (EuclideanSpace ℂ (Fin n)) x).target}

/-- The domain of `chartInv x` is open. -/
theorem isOpen_chartDom (x : M) : IsOpen (chartDom (n := n) x) :=
  (chartAt (EuclideanSpace ℂ (Fin n)) x).open_target.preimage
    ((coordEquiv n).symm.continuous.comp (continuous_id.add continuous_const))

/-- `0` lies in the domain of `chartInv x`. -/
theorem zero_mem_chartDom (x : M) : (0 : Fin n → ℂ) ∈ chartDom (n := n) x := by
  simp only [chartDom, Set.mem_setOf_eq, zero_add, ContinuousLinearEquiv.symm_apply_apply]
  exact (chartAt _ x).map_source (mem_chart_source _ x)

/-- `chartInv x` sends `0` to `x`. -/
theorem chartInv_zero (x : M) : chartInv (n := n) x 0 = x := by
  simp only [chartInv, zero_add, ContinuousLinearEquiv.symm_apply_apply]
  exact (chartAt _ x).left_inv (mem_chart_source _ x)

/-- `chartInv x` is a left inverse of `chartFwd x` on the source of the chart at `x`. -/
theorem chartInv_chartFwd (x : M) {y : M} (hy : y ∈ (chartAt (EuclideanSpace ℂ (Fin n)) x).source) :
    chartInv (n := n) x (chartFwd x y) = y := by
  simp only [chartInv, chartFwd, sub_add_cancel, ContinuousLinearEquiv.symm_apply_apply]
  exact (chartAt _ x).left_inv hy

/-- `chartFwd x` sends `x` to `0`. -/
theorem chartFwd_self (x : M) : chartFwd (n := n) x x = 0 := sub_self _

/-- `chartInv x` is continuous on its domain. -/
theorem continuousOn_chartInv (x : M) : ContinuousOn (chartInv (n := n) x) (chartDom x) :=
  (chartAt (EuclideanSpace ℂ (Fin n)) x).continuousOn_symm.comp
    ((coordEquiv n).symm.continuous.comp (continuous_id.add continuous_const)).continuousOn
    fun _ hz => hz

/-- `chartFwd x` is continuous on the source of the chart at `x`. -/
theorem continuousOn_chartFwd (x : M) :
    ContinuousOn (chartFwd (n := n) x) (chartAt (EuclideanSpace ℂ (Fin n)) x).source :=
  (((coordEquiv n).continuous.comp_continuousOn
    (chartAt (EuclideanSpace ℂ (Fin n)) x).continuousOn).sub continuousOn_const)

/-- A function on an open set `U ⊆ M`, read in the centred chart at `x`. -/
noncomputable def pull (x : M) {U : Opens M} (g : U → ℂ) : (Fin n → ℂ) → ℂ :=
  fun z => Function.extend (Subtype.val : U → M) g 0 (chartInv x z)

/-- At a point `z` with `chartInv x z ∈ U`, `pull x g` takes the value `g (chartInv x z)`. -/
theorem pull_apply (x : M) {U : Opens M} (g : U → ℂ) {z : Fin n → ℂ} (hz : chartInv x z ∈ U) :
    pull x g z = g ⟨chartInv x z, hz⟩ :=
  Subtype.val_injective.extend_apply g 0 ⟨chartInv x z, hz⟩

/-- The open set of points of `chartDom x` sent into `U`. -/
def chartDomIn (x : M) (U : Opens M) : Set (Fin n → ℂ) := {z | z ∈ chartDom x ∧ chartInv x z ∈ U}

/-- `chartDomIn x U` is open. -/
theorem isOpen_chartDomIn (x : M) (U : Opens M) : IsOpen (chartDomIn (n := n) x U) :=
  (continuousOn_chartInv x).isOpen_inter_preimage (isOpen_chartDom x) U.isOpen

/-- `0` lies in `chartDomIn x U` when `x ∈ U`. -/
theorem zero_mem_chartDomIn (x : M) {U : Opens M} (hx : x ∈ U) :
    (0 : Fin n → ℂ) ∈ chartDomIn (n := n) x U :=
  ⟨zero_mem_chartDom x, by rw [chartInv_zero]; exact hx⟩

/-- A holomorphic function on `U ⊆ M` read in the centred chart is complex differentiable. -/
theorem differentiableOn_pull (x : M) {U : Opens M} (g : U → ℂ)
    (hg : ContMDiff 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ g) :
    DifferentiableOn ℂ (pull (n := n) x g) (chartDomIn x U) := by
  set e := chartAt (EuclideanSpace ℂ (Fin n)) x
  set g' : M → ℂ := Function.extend (Subtype.val : U → M) g 0
  have hg' : ContMDiffOn 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ g' U := by
    intro m hm
    have : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (fun w : U => g' w) ⟨m, hm⟩ := by
      have h1 : (fun w : U => g' w) = g :=
        funext fun w => Subtype.val_injective.extend_apply g 0 w
      rw [h1]; exact hg _
    exact (contMDiffAt_subtype_iff.1 this).contMDiffWithinAt
  have h2 : ContMDiffOn 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (g' ∘ e.symm)
      (e.target ∩ e.symm ⁻¹' U) :=
    hg'.comp ((contMDiffOn_chart_symm (x := x)).mono Set.inter_subset_left) (fun z hz => hz.2)
  have h3 : DifferentiableOn ℂ (g' ∘ e.symm) (e.target ∩ e.symm ⁻¹' U) :=
    (contMDiffOn_iff_contDiffOn.1 h2).differentiableOn (by simp)
  have haff : Differentiable ℂ (fun z : Fin n → ℂ =>
      (coordEquiv n).symm (z + coordEquiv n (e x))) :=
    (coordEquiv n).symm.differentiable.comp (differentiable_id.add_const _)
  exact h3.comp haff.differentiableOn fun z hz => ⟨hz.1, hz.2⟩

/-- A complex differentiable function near the image, composed with the centred chart, is
holomorphic. -/
theorem contMDiff_push (x : M) (U : Opens M)
    (hU : (U : Set M) ⊆ (chartAt (EuclideanSpace ℂ (Fin n)) x).source)
    {S : Set (Fin n → ℂ)} (G : (Fin n → ℂ) → ℂ) (hG : DifferentiableOn ℂ G S)
    (hmaps : ∀ w ∈ U, chartFwd x w ∈ S) :
    ContMDiff 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (fun w : U => G (chartFwd x w)) := by
  set e := chartAt (EuclideanSpace ℂ (Fin n)) x
  let G' : EuclideanSpace ℂ (Fin n) → ℂ := fun v => G (coordEquiv n v - coordEquiv n (e x))
  have hS : IsOpen (e.target ∩ e.symm ⁻¹' U) := e.isOpen_inter_preimage_symm U.isOpen
  have hG' : DifferentiableOn ℂ G' (e.target ∩ e.symm ⁻¹' U) := by
    refine hG.comp (((coordEquiv n).differentiable.sub_const _).differentiableOn) fun v hv => ?_
    have := hmaps _ hv.2
    simp only [chartFwd] at this
    rwa [e.right_inv hv.1] at this
  have hGa := analyticOnNhd_of_differentiableOn hS hG'
  have hG'' : ContMDiffOn 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ G' (e.target ∩ e.symm ⁻¹' U) :=
    contMDiffOn_iff_contDiffOn.2 (hGa.contDiffOn hS.uniqueDiffOn)
  have h2 : ContMDiffOn 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (G' ∘ e) U :=
    hG''.comp ((contMDiffOn_chart (x := x)).mono hU) (fun m hm =>
      ⟨e.map_source (hU hm), by simpa [e.left_inv (hU hm)] using hm⟩)
  intro w
  exact contMDiffAt_subtype_iff.2 (h2.contMDiffAt (U.isOpen.mem_nhds w.2))

end Chart

section LocalClosure

open TopologicalSpace CategoryTheory Opposite

variable {M : Type} [TopologicalSpace M] [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
  [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M]

/-- The function of a holomorphic section, read in the centred chart at `x`. -/
noncomputable abbrev pullS (x : M) {U : Opens (TopCat.of M)}
    (g : (holomorphicRingCatSheaf n M).obj.obj (op U)) : (Fin n → ℂ) → ℂ :=
  pull (n := n) x (U := U) (fun w => holEval n U w g)

/-- At a point `z` with `chartInv x z ∈ U`, `pullS x g` is the value of `g` at `chartInv x z`. -/
theorem pullS_apply (x : M) {U : Opens (TopCat.of M)}
    (g : (holomorphicRingCatSheaf n M).obj.obj (op U)) {z : Fin n → ℂ} (hz : chartInv x z ∈ U) :
    pullS x g z = holEval n U ⟨chartInv x z, hz⟩ g :=
  pull_apply x _ hz

/-- A holomorphic function on a neighbourhood `U` of `x`, read in the centred chart at `x`, is
complex differentiable near `0`. -/
theorem eventually_differentiableAt_pullS (x : M) {U : Opens (TopCat.of M)} (hx : x ∈ U)
    (g : (holomorphicRingCatSheaf n M).obj.obj (op U)) :
    ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), DifferentiableAt ℂ (pullS x g) z :=
  Filter.eventually_of_mem ((isOpen_chartDomIn x U).mem_nhds (zero_mem_chartDomIn x hx))
    fun z hz => (differentiableOn_pull x _ (contMDiff_holEval U g)).differentiableAt
      ((isOpen_chartDomIn x U).mem_nhds hz)

/-- **The closure theorem near a point of `M`.** -/
theorem local_closure {V W : Opens (TopCat.of M)} {x : M} (hxV : x ∈ V) (hxW : x ∈ W)
    {p s : ℕ} (a : Fin s → Fin p → (holomorphicRingCatSheaf n M).obj.obj (op W))
    (F : ℕ → Fin p → (holomorphicRingCatSheaf n M).obj.obj (op V))
    (f : Fin p → (holomorphicRingCatSheaf n M).obj.obj (op V))
    (hconv : ∀ j (K : Set V), IsCompact K →
      TendstoUniformlyOn (fun k (y : V) => holEval n V y (F k j))
        (fun y => holEval n V y (f j)) atTop K)
    (hmem : ∀ k, ∃ (U : Opens (TopCat.of M)) (hU : U ≤ V ⊓ W), x ∈ U ∧
      ∃ c : Fin s → (holomorphicRingCatSheaf n M).obj.obj (op U),
        ∀ j, resA (hU.trans inf_le_left) (F k j) =
          ∑ l, c l * resA (hU.trans inf_le_right) (a l j)) :
    ∃ (U : Opens (TopCat.of M)) (hU : U ≤ V ⊓ W), x ∈ U ∧
      ∃ c : Fin s → (holomorphicRingCatSheaf n M).obj.obj (op U),
        ∀ j, resA (hU.trans inf_le_left) (f j) =
          ∑ l, c l * resA (hU.trans inf_le_right) (a l j) := by
  set e := chartAt (EuclideanSpace ℂ (Fin n)) x
  obtain ⟨ε, hε, hεV⟩ := Metric.mem_nhds_iff.1
    ((isOpen_chartDomIn x V).mem_nhds (zero_mem_chartDomIn (n := n) x hxV))
  set ρ := ε / 2 with hρ_def
  have hρ : 0 < ρ := half_pos hε
  have hDV : polydisc (n := n) ρ ⊆ chartDomIn x V := by
    intro z hz
    refine hεV ?_
    have hz' : z ∈ Metric.closedBall (0 : Fin n → ℂ) ρ := by
      rw [closedBall_pi _ hρ.le]; exact hz
    exact Metric.closedBall_subset_ball (half_lt_self hε) hz'
  have hconv' : ∀ j, TendstoUniformlyOn (fun k => pullS x (F k j)) (pullS x (f j)) atTop
      (polydisc (n := n) ρ) := by
    intro j
    classical
    let g : (Fin n → ℂ) → V := fun z =>
      if h : chartInv (n := n) x z ∈ V then ⟨chartInv (n := n) x z, h⟩ else ⟨x, hxV⟩
    let K : Set V := Subtype.val ⁻¹' (chartInv (n := n) x '' polydisc ρ)
    have hK : IsCompact K := by
      rw [Subtype.isCompact_iff]
      have himg : Subtype.val '' K = chartInv (n := n) x '' polydisc ρ := by
        refine Set.image_preimage_eq_of_subset ?_
        rintro _ ⟨z, hz, rfl⟩
        exact ⟨⟨_, (hDV hz).2⟩, rfl⟩
      rw [himg]
      exact (isCompact_univ_pi fun _ => isCompact_closedBall _ _).image_of_continuousOn
        ((continuousOn_chartInv (n := n) x).mono fun z hz => (hDV hz).1)
    have h1 := ((hconv j K hK).comp g).mono (s' := polydisc ρ) (fun z hz => by
      have hzV := (hDV hz).2
      simp only [g, dif_pos hzV, Set.mem_preimage, K]
      exact ⟨z, hz, rfl⟩)
    refine (h1.congr (Eventually.of_forall fun k z hz => ?_)).congr_right fun z hz => ?_
    · have hzV := (hDV hz).2
      simp only [Function.comp, g, dif_pos hzV]
      exact (pullS_apply x (F k j) hzV).symm
    · have hzV := (hDV hz).2
      simp only [Function.comp, g, dif_pos hzV]
      exact (pullS_apply x (f j) hzV).symm
  have hmem' : ∀ k, ∃ c : Fin s → (Fin n → ℂ) → ℂ,
      (∀ l, ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ (c l) z) ∧
      ∀ j, pullS x (F k j) =ᶠ[𝓝 0] fun z => ∑ l, c l z * pullS x (a l j) z := by
    intro k
    obtain ⟨U, hU, hxU, c, hc⟩ := hmem k
    refine ⟨fun l => pullS x (c l), fun l => eventually_differentiableAt_pullS x hxU (c l),
      fun j => ?_⟩
    filter_upwards [(isOpen_chartDomIn x U).mem_nhds (zero_mem_chartDomIn (n := n) x hxU)]
      with z hz
    have hzU := hz.2
    have h2 := congrArg (holEval n U ⟨chartInv (n := n) x z, hzU⟩) (hc j)
    rw [holEval_resA, map_sum] at h2
    simp only [map_mul, holEval_resA] at h2
    rw [pullS_apply x _ ((hU hzU).1), h2]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [pullS_apply x _ hzU, pullS_apply x _ ((hU hzU).2)]
    rfl
  obtain ⟨c, hcd, hceq⟩ := exists_eventuallyEq_sum_of_tendstoUniformlyOn
    (fun l j => pullS x (a l j)) (fun l j => eventually_differentiableAt_pullS x hxW (a l j))
    (fun k j => pullS x (F k j)) (fun j => pullS x (f j)) (isOpen_chartDomIn x V) hρ hDV
    (fun k j => differentiableOn_pull x _ (contMDiff_holEval V (F k j)))
    (fun j => differentiableOn_pull x _ (contMDiff_holEval V (f j))) hconv' hmem'
  have hall : ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), (∀ l, DifferentiableAt ℂ (c l) z) ∧
      (∀ j, pullS x (f j) z = ∑ l, c l z * pullS x (a l j) z) :=
    (Filter.eventually_all.2 hcd).and (Filter.eventually_all.2 hceq)
  obtain ⟨T, hT, hTo, h0T⟩ := eventually_nhds_iff.1 hall
  let U' : Opens (TopCat.of M) :=
    ⟨(e.source ∩ chartFwd (n := n) x ⁻¹' T) ∩ (V ⊓ W : Opens (TopCat.of M)),
      ((continuousOn_chartFwd (n := n) x).isOpen_inter_preimage e.open_source hTo).inter
        (V ⊓ W).isOpen⟩
  have hU'src : (U' : Set M) ⊆ e.source := fun w hw => hw.1.1
  have hU'VW : U' ≤ V ⊓ W := fun w hw => hw.2
  have hxU' : x ∈ U' := ⟨⟨mem_chart_source _ x, by
    simp only [Set.mem_preimage, chartFwd_self]; exact h0T⟩, hxV, hxW⟩
  let cU : Fin s → (holomorphicRingCatSheaf n M).obj.obj (op U') := fun l =>
    (⟨fun w : U' => c l (chartFwd (n := n) x w), contMDiff_push x U' hU'src (c l)
      (S := T) (fun z hz => ((hT z hz).1 l).differentiableWithinAt)
      (fun w hw => hw.1.2)⟩ : C^∞⟮𝓘(ℂ, EuclideanSpace ℂ (Fin n)), U'; 𝓘(ℂ), ℂ⟯)
  refine ⟨U', hU'VW, hxU', cU, fun j => holEval_ext fun w => ?_⟩
  have hwT : chartFwd (n := n) x w.1 ∈ T := w.2.1.2
  have hinv : chartInv (n := n) x (chartFwd (n := n) x w.1) = w.1 :=
    chartInv_chartFwd (n := n) x (hU'src w.2)
  have h3 := (hT _ hwT).2 j
  rw [holEval_resA, map_sum]
  simp only [map_mul, holEval_resA]
  rw [pullS_apply x _ (by rw [hinv]; exact (hU'VW w.2).1)] at h3
  simp only [hinv] at h3
  refine h3.trans (Finset.sum_congr rfl fun l _ => ?_)
  rw [pullS_apply x _ (by rw [hinv]; exact (hU'VW w.2).2)]
  simp only [hinv]
  rfl

end LocalClosure

end ClosureTheorem

section ClosureAssembly

open TopologicalSpace MMP.Analytic Limits
open scoped Manifold ContDiff

variable {T : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- An element of a sheaf of modules which lies locally in the image of a monomorphism lies in
its image. -/
theorem exists_app_eq_of_locally {R P : SheafOfModules.{0} A} (i : R ⟶ P) [Mono i]
    {V : Opens T} (t : P.val.obj (op V))
    (h : ∀ y ∈ V, ∃ (U : Opens T) (hU : U ≤ V), y ∈ U ∧ ∃ r : R.val.obj (op U),
      i.val.app (op U) r = resM P hU t) :
    ∃ r : R.val.obj (op V), i.val.app (op V) r = t := by
  have hπ : (cokernel.π i).val.app (op V) t = 0 := by
    refine eq_zero_of_locally_eq_zero _ _ fun y hy => ?_
    obtain ⟨U, hU, hyU, r, hr⟩ := h y hy
    refine ⟨U, hU, hyU, ?_⟩
    rw [← hom_resM, ← hr, cokernel_π_app_hom_app]
  obtain ⟨k, hk⟩ := exists_kernel_ι_app_eq (cokernel.π i) _ t hπ
  have hfac : Abelian.factorThruImage i ≫ Abelian.image.ι i = i := Abelian.image.fac i
  haveI : Mono (Abelian.factorThruImage i) := mono_of_mono_fac hfac
  haveI : IsIso (Abelian.factorThruImage i) := isIso_of_mono_of_epi _
  let r := (inv (Abelian.factorThruImage i)).val.app (op V) k
  refine ⟨r, (congrArg (fun φ : R ⟶ P => φ.val.app (op V) r) hfac.symm).trans ?_⟩
  rw [← hk]
  change (Abelian.image.ι i).val.app (op V) ((inv (Abelian.factorThruImage i) ≫
    Abelian.factorThruImage i).val.app (op V) k) = _
  rw [IsIso.inv_hom_id]
  rfl

end ClosureAssembly

section GermMap

open TopologicalSpace MMP.Analytic Limits Topology
open scoped Manifold ContDiff

variable {n : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
  [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M]

variable (n M) in
/-- The sheaf of rings `𝒪_M`, as a sheaf on the site of opens. -/
noncomputable abbrev holSheaf : Sheaf (Opens.grothendieckTopology (TopCat.of M)) RingCat.{0} :=
  holomorphicRingCatSheaf n M

/-- `chartFwd x` is a left inverse of `chartInv x` on the domain of `chartInv x`. -/
theorem chartFwd_chartInv (x : M) {z : Fin n → ℂ} (hz : z ∈ chartDom (n := n) x) :
    chartFwd (n := n) x (chartInv x z) = z := by
  simp only [chartFwd, chartInv]
  rw [(chartAt (EuclideanSpace ℂ (Fin n)) x).right_inv hz, ContinuousLinearEquiv.apply_symm_apply,
    add_sub_cancel_right]

/-- Every point near `0` lies in `chartDomIn x U` when `x ∈ U`. -/
theorem eventually_chartInv_mem (x : M) {U : Opens (TopCat.of M)} (hx : x ∈ U) :
    ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), z ∈ chartDomIn (n := n) x U :=
  (isOpen_chartDomIn x U).mem_nhds (zero_mem_chartDomIn x hx)

/-- The germ at `x`, read in the centred chart, of a holomorphic function near `x`. -/
noncomputable def germHom (x : M) {U : Opens (TopCat.of M)} (hx : x ∈ U) :
    (holSheaf n M).obj.obj (op U) →+* holGerms (0 : Fin n → ℂ) where
  toFun a := germOf (pullS x a) (eventually_differentiableAt_pullS x hx a)
  map_one' := by
    apply Subtype.ext
    refine Germ.coe_eq.2 ?_
    filter_upwards [eventually_chartInv_mem x hx] with z hz
    rw [pullS_apply x _ hz.2, map_one]
  map_mul' a b := by
    apply Subtype.ext
    change _ = Germ.coeRingHom _ (pullS x a) * Germ.coeRingHom _ (pullS x b)
    rw [← map_mul]
    refine Germ.coe_eq.2 ?_
    filter_upwards [eventually_chartInv_mem x hx] with z hz
    rw [pullS_apply x _ hz.2, map_mul, Pi.mul_apply, pullS_apply x _ hz.2, pullS_apply x _ hz.2]
  map_zero' := by
    apply Subtype.ext
    refine Germ.coe_eq.2 ?_
    filter_upwards [eventually_chartInv_mem x hx] with z hz
    rw [pullS_apply x _ hz.2, map_zero]
  map_add' a b := by
    apply Subtype.ext
    change _ = Germ.coeRingHom _ (pullS x a) + Germ.coeRingHom _ (pullS x b)
    rw [← map_add]
    refine Germ.coe_eq.2 ?_
    filter_upwards [eventually_chartInv_mem x hx] with z hz
    rw [pullS_apply x _ hz.2, map_add, Pi.add_apply, pullS_apply x _ hz.2, pullS_apply x _ hz.2]

/-- The germ at `x` of the restriction of a holomorphic function is the germ of the function. -/
theorem germHom_resA (x : M) {U U' : Opens (TopCat.of M)} (h : U' ≤ U) (hx : x ∈ U')
    (a : (holSheaf n M).obj.obj (op U)) :
    germHom x hx (resA h a) = germHom x (h hx) a := by
  apply Subtype.ext
  refine Germ.coe_eq.2 ?_
  filter_upwards [eventually_chartInv_mem x hx] with z hz
  change pullS x (resA h a) z = pullS x a z
  rw [pullS_apply x _ hz.2, pullS_apply x _ (h hz.2), holEval_resA]

/-- A holomorphic function with zero germ vanishes near `x`. -/
theorem exists_resA_eq_zero_of_germHom (x : M) {U : Opens (TopCat.of M)} (hx : x ∈ U)
    (a : (holSheaf n M).obj.obj (op U)) (ha : germHom x hx a = 0) :
    ∃ (U' : Opens (TopCat.of M)) (h : U' ≤ U), x ∈ U' ∧ resA h a = 0 := by
  have hev : ∀ᶠ z in 𝓝 (0 : Fin n → ℂ), pullS x a z = 0 := by
    have := congrArg (fun g : holGerms (0 : Fin n → ℂ) => (g : Germ (𝓝 (0 : Fin n → ℂ)) ℂ)) ha
    exact Germ.coe_eq.1 this
  obtain ⟨T0, hT0, hT0o, h0T0⟩ := eventually_nhds_iff.1 hev
  set e := chartAt (EuclideanSpace ℂ (Fin n)) x
  let U' : Opens (TopCat.of M) :=
    ⟨(e.source ∩ chartFwd (n := n) x ⁻¹' T0) ∩ U,
      ((continuousOn_chartFwd x).isOpen_inter_preimage e.open_source hT0o).inter U.isOpen⟩
  refine ⟨U', fun w hw => hw.2, ⟨⟨mem_chart_source _ x, by
    simp only [Set.mem_preimage, chartFwd_self]; exact h0T0⟩, hx⟩, holEval_ext fun w => ?_⟩
  rw [holEval_resA, map_zero]
  have hinv : chartInv (n := n) x (chartFwd x w.1) = w.1 := chartInv_chartFwd x w.2.1.1
  have := hT0 _ w.2.1.2
  rw [pullS_apply x _ (by rw [hinv]; exact w.2.2)] at this
  simpa only [hinv] using this

/-- Every holomorphic germ is the germ of a holomorphic function on a neighbourhood of `x`. -/
theorem exists_germHom_eq (x : M) (g : holGerms (0 : Fin n → ℂ)) :
    ∃ (U : Opens (TopCat.of M)) (hx : x ∈ U) (a : (holSheaf n M).obj.obj (op U)),
      germHom x hx a = g := by
  obtain ⟨T0, hT0, hT0o, h0T0⟩ := eventually_nhds_iff.1
    ((rep_differentiable g).and (eventually_chartInv_mem (n := n) x (U := ⊤) trivial))
  set e := chartAt (EuclideanSpace ℂ (Fin n)) x
  let U : Opens (TopCat.of M) :=
    ⟨e.source ∩ chartFwd (n := n) x ⁻¹' T0,
      (continuousOn_chartFwd x).isOpen_inter_preimage e.open_source hT0o⟩
  have hxU : x ∈ U := ⟨mem_chart_source _ x, by
    simp only [Set.mem_preimage, chartFwd_self]; exact h0T0⟩
  let a : (holSheaf n M).obj.obj (op U) :=
    (⟨fun w : U => rep g (chartFwd x w), contMDiff_push x U (fun w hw => hw.1) (rep g)
      (S := T0) (fun z hz => ((hT0 z hz).1).differentiableWithinAt)
      (fun w hw => hw.2)⟩ : C^∞⟮𝓘(ℂ, EuclideanSpace ℂ (Fin n)), U; 𝓘(ℂ), ℂ⟯)
  refine ⟨U, hxU, a, Subtype.ext ?_⟩
  rw [← coe_rep g]
  refine Germ.coe_eq.2 ?_
  filter_upwards [hT0o.mem_nhds h0T0] with z hz
  have hzd : z ∈ chartDom (n := n) x := ((hT0 z hz).2).1
  have hzU : chartInv (n := n) x z ∈ U := by
    refine ⟨?_, ?_⟩
    · exact (chartAt (EuclideanSpace ℂ (Fin n)) x).map_target hzd
    · simp only [Set.mem_preimage, chartFwd_chartInv x hzd]; exact hz
  change pullS x a z = rep g z
  rw [pullS_apply x _ hzU]
  change rep g (chartFwd x (chartInv x z)) = rep g z
  rw [chartFwd_chartInv x hzd]

end GermMap

section GermRelations

open TopologicalSpace MMP.Analytic Limits Topology
open scoped Manifold ContDiff

variable {n : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
  [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M]

local notation "𝒜" => holSheaf n M
local notation "𝒪₀" => holGerms (0 : Fin n → ℂ)

/-- Finitely many germs are the germs of functions on a common neighbourhood of `x`. -/
theorem exists_germHom_eq_fun (x : M) {ι : Type} [Finite ι] (g : ι → 𝒪₀) :
    ∃ (U : Opens (TopCat.of M)) (hx : x ∈ U) (a : ι → (𝒜).obj.obj (op U)),
      ∀ k, germHom x hx (a k) = g k := by
  choose U hx a ha using fun k => exists_germHom_eq (n := n) x (g k)
  obtain ⟨W, hxW, hW⟩ := exists_le_of_forall_mem U hx
  exact ⟨W, hxW, fun k => resA (hW k) (a k), fun k => by rw [germHom_resA, ha]⟩

/-- Finitely many functions with zero germs vanish on a common neighbourhood of `x`. -/
theorem exists_resA_eq_zero_fun (x : M) {U : Opens (TopCat.of M)} (hx : x ∈ U)
    {ι : Type} [Finite ι] (a : ι → (𝒜).obj.obj (op U)) (ha : ∀ k, germHom x hx (a k) = 0) :
    ∃ (U' : Opens (TopCat.of M)) (h : U' ≤ U), x ∈ U' ∧ ∀ k, resA h (a k) = 0 := by
  choose V hV hxV hVa using fun k => exists_resA_eq_zero_of_germHom (n := n) x hx (a k) (ha k)
  obtain ⟨W, hxW, hW⟩ := exists_le_of_forall_mem V hxV
  refine ⟨W ⊓ U, inf_le_right, ⟨hxW, hx⟩, fun k => ?_⟩
  have e := congrArg (resA (A := 𝒜) (inf_le_left.trans (hW k) : W ⊓ U ≤ V k)) (hVa k)
  rw [resA_resA] at e
  rw [e]; simp [resA]

/-- The germs at `x` of the relations among finitely many elements `g` of `Q` near `x`. -/
def krel (Q : SheafOfModules.{0} 𝒜) {W : Opens (TopCat.of M)} {x : M} (hxW : x ∈ W)
    {r : ℕ} (g : Fin r → Q.val.obj (op W)) : Submodule 𝒪₀ (Fin r → 𝒪₀) where
  carrier := {ā | ∃ (U : Opens (TopCat.of M)) (hU : U ≤ W) (hx : x ∈ U)
    (a : Fin r → (𝒜).obj.obj (op U)), (∀ k, germHom x hx (a k) = ā k) ∧
      ∑ k, a k • resM Q hU (g k) = 0}
  zero_mem' := ⟨W, le_rfl, hxW, 0, fun k => map_zero _, by simp⟩
  add_mem' := by
    rintro ā bb ⟨U1, h1, hx1, a1, ha1, hr1⟩ ⟨U2, h2, hx2, a2, ha2, hr2⟩
    refine ⟨U1 ⊓ U2, inf_le_left.trans h1, ⟨hx1, hx2⟩,
      fun k => resA inf_le_left (a1 k) + resA inf_le_right (a2 k), fun k => ?_, ?_⟩
    · rw [map_add, germHom_resA x (inf_le_left : U1 ⊓ U2 ≤ U1) ⟨hx1, hx2⟩ (a1 k),
        germHom_resA x (inf_le_right : U1 ⊓ U2 ≤ U2) ⟨hx1, hx2⟩ (a2 k), ha1, ha2]; rfl
    · simp only [add_smul, Finset.sum_add_distrib]
      have e1 : ∑ k, resA (inf_le_left : U1 ⊓ U2 ≤ U1) (a1 k) •
          resM Q ((inf_le_left : U1 ⊓ U2 ≤ U1).trans h1) (g k) =
            resM Q inf_le_left (∑ k, a1 k • resM Q h1 (g k)) :=
        (resM_sum_smul_resM Q inf_le_left h1 a1 g).symm
      have e2 : ∑ k, resA (inf_le_right : U1 ⊓ U2 ≤ U2) (a2 k) •
          resM Q ((inf_le_left : U1 ⊓ U2 ≤ U1).trans h1) (g k) =
            resM Q inf_le_right (∑ k, a2 k • resM Q h2 (g k)) :=
        (resM_sum_smul_resM Q inf_le_right h2 a2 g).symm
      rw [e1, e2, hr1, hr2, resM_zero, resM_zero, add_zero]
  smul_mem' := by
    rintro cc ā ⟨U1, h1, hx1, a1, ha1, hr1⟩
    obtain ⟨U2, hx2, c, hc⟩ := exists_germHom_eq (n := n) x cc
    refine ⟨U1 ⊓ U2, inf_le_left.trans h1, ⟨hx1, hx2⟩,
      fun k => resA inf_le_right c * resA inf_le_left (a1 k), fun k => ?_, ?_⟩
    · rw [map_mul, germHom_resA x (inf_le_left : U1 ⊓ U2 ≤ U1) ⟨hx1, hx2⟩ (a1 k),
        germHom_resA x (inf_le_right : U1 ⊓ U2 ≤ U2) ⟨hx1, hx2⟩ c, ha1, hc]; rfl
    · simp only [mul_smul]
      rw [← Finset.smul_sum]
      have e1 : ∑ k, resA (inf_le_left : U1 ⊓ U2 ≤ U1) (a1 k) •
          resM Q ((inf_le_left : U1 ⊓ U2 ≤ U1).trans h1) (g k) =
            resM Q inf_le_left (∑ k, a1 k • resM Q h1 (g k)) :=
        (resM_sum_smul_resM Q inf_le_left h1 a1 g).symm
      rw [e1, hr1, resM_zero, smul_zero]

/-- The rows `E` are relations among the `g` which locally generate all relations. -/
def RelGen (Q : SheafOfModules.{0} 𝒜) {W : Opens (TopCat.of M)} {r s : ℕ}
    (g : Fin r → Q.val.obj (op W)) (E : Fin s → Fin r → (𝒜).obj.obj (op W)) : Prop :=
  (∀ l, ∑ k, E l k • g k = 0) ∧
    ∀ (U : Opens (TopCat.of M)) (hU : U ≤ W) (a : Fin r → (𝒜).obj.obj (op U)),
      ∑ k, a k • resM Q hU (g k) = 0 → ∀ y ∈ U,
        ∃ (U' : Opens (TopCat.of M)) (h : U' ≤ U), y ∈ U' ∧ ∃ c : Fin s → (𝒜).obj.obj (op U'),
          ∀ k, resA h (a k) = ∑ l, c l * resA (h.trans hU) (E l k)

/-- Generating relations restrict to generating relations on a smaller open. -/
theorem RelGen.restrict {Q : SheafOfModules.{0} 𝒜} {W W' : Opens (TopCat.of M)}
    (h : W' ≤ W) {r s : ℕ} {g : Fin r → Q.val.obj (op W)} {E : Fin s → Fin r → (𝒜).obj.obj (op W)}
    (hE : RelGen Q g E) :
    RelGen Q (fun k => resM Q h (g k)) (fun l k => resA h (E l k)) := by
  refine ⟨fun l => ?_, fun U hU a ha y hy => ?_⟩
  · rw [← resM_sum_smul, hE.1 l, resM_zero]
  · simp only [resM_resM] at ha
    obtain ⟨U', h', hy', c, hc⟩ := hE.2 U (hU.trans h) a ha y hy
    exact ⟨U', h', hy', c, fun k => by rw [hc k]; simp only [resA_resA]⟩

/-- Finitely many elements of a sheaf with locally finitely generated relations have, near `x`,
finitely many generating relations. -/
theorem exists_relGen {Q : SheafOfModules.{0} 𝒜} (hQ : RelFin Q)
    {V : Opens (TopCat.of M)} {x : M} (hx : x ∈ V) {r : ℕ} (g : Fin r → Q.val.obj (op V)) :
    ∃ (W : Opens (TopCat.of M)) (hWV : W ≤ V), x ∈ W ∧
      ∃ (s : ℕ) (E : Fin s → Fin r → (𝒜).obj.obj (op W)),
        RelGen Q (fun k => resM Q hWV (g k)) E := by
  obtain ⟨W, hWV, hxW, s, E, hE, hgen⟩ := hQ V r g x hx
  refine ⟨W, hWV, hxW, s, E, hE, fun U hU a ha y hy => ?_⟩
  simp only [resM_resM] at ha
  exact hgen U hU a ha y hy

/-- The elements `∑ₘ D k m • eₘ` of a free module. -/
noncomputable def rowsF {W : Opens (TopCat.of M)} {r r' : ℕ}
    (D : Fin r → Fin r' → (𝒜).obj.obj (op W)) (k : Fin r) :
    (SheafOfModules.free (R := 𝒜) (Fin r')).val.obj (op W) :=
  ∑ m, D k m • freeElt m (op W)

/-- The restrictions of the rows `rowsF D` are the rows of the restricted matrix. -/
theorem resM_rowsF {W W' : Opens (TopCat.of M)} (h : W' ≤ W) {r r' : ℕ}
    (D : Fin r → Fin r' → (𝒜).obj.obj (op W)) (k : Fin r) :
    resM (SheafOfModules.free (R := 𝒜) (Fin r')) h (rowsF D k) =
      rowsF (fun k m => resA h (D k m)) k :=
  free_map_sum_smul (R := 𝒜) _ _

/-- The combination of the rows `rowsF D` with coefficients `a` has coefficients
`∑ k, a k * D k m`. -/
theorem sum_smul_rowsF {W : Opens (TopCat.of M)} {r r' : ℕ}
    (D : Fin r → Fin r' → (𝒜).obj.obj (op W)) (a : Fin r → (𝒜).obj.obj (op W)) :
    ∑ k, a k • rowsF D k = ∑ m, (∑ k, a k * D k m) • freeElt m (op W) := by
  simp only [rowsF]
  exact sum_smul_sum_smul _ _ _

/-- The matrix of germs at `x` of a matrix of holomorphic functions. -/
noncomputable abbrev germMat (x : M) {W : Opens (TopCat.of M)} (hx : x ∈ W) {r s : ℕ}
    (E : Fin s → Fin r → (𝒜).obj.obj (op W)) : Matrix (Fin s) (Fin r) 𝒪₀ :=
  Matrix.of fun l k => germHom x hx (E l k)

/-- **The germs of relations are generated by the germs of generating relations.** -/
theorem krel_eq_range {Q : SheafOfModules.{0} 𝒜} {W : Opens (TopCat.of M)} {x : M}
    (hxW : x ∈ W) {r s : ℕ} {g : Fin r → Q.val.obj (op W)} {E : Fin s → Fin r → (𝒜).obj.obj (op W)}
    (hE : RelGen Q g E) :
    krel Q hxW g = LinearMap.range (germMat x hxW E).vecMulLinear := by
  rw [range_vecMulLinear]
  apply le_antisymm
  · rintro ā ⟨U, hU, hx, a, ha, hrel⟩
    obtain ⟨U', h, hy, c, hc⟩ := hE.2 U hU a hrel x hx
    have : ā = ∑ l, germHom x hy (c l) • (germMat x hxW E).row l := by
      funext k
      rw [← ha k, ← germHom_resA x h hy (a k), hc k, map_sum, Finset.sum_apply]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [map_mul, germHom_resA x (h.trans hU) hy (E l k)]
      rfl
    rw [this]
    exact Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
  · rw [Submodule.span_le]
    rintro _ ⟨l, rfl⟩
    refine ⟨W, le_rfl, hxW, E l, fun k => rfl, ?_⟩
    simp only [resM_refl]
    exact hE.1 l

/-- **The germs of relations among rows of a matrix are the kernel of the germ matrix.** -/
theorem krel_rowsF_eq_ker {W : Opens (TopCat.of M)} {x : M} (hxW : x ∈ W) {r r' : ℕ}
    (D : Fin r → Fin r' → (𝒜).obj.obj (op W)) :
    krel (SheafOfModules.free (R := 𝒜) (Fin r')) hxW (rowsF D) =
      LinearMap.ker (germMat x hxW D).vecMulLinear := by
  ext ā
  rw [LinearMap.mem_ker]
  constructor
  · rintro ⟨U, hU, hx, a, ha, hrel⟩
    have e : ∀ k, resM (SheafOfModules.free (R := 𝒜) (Fin r')) hU (rowsF D k) =
        rowsF (fun k m => resA hU (D k m)) k := fun k => resM_rowsF hU D k
    simp only [e] at hrel
    rw [sum_smul_rowsF] at hrel
    have h0 := free_sum_smul_injective (b := fun _ => 0) (hrel.trans (by simp))
    funext m
    have := congrArg (germHom x hx) (congrFun h0 m)
    rw [map_sum, map_zero] at this
    rw [Matrix.vecMulLinear_apply, Matrix.vecMul, dotProduct, Pi.zero_apply]
    refine Eq.trans ?_ this
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_mul, germHom_resA x hU hx (D k m), ha k]
    rfl
  · intro hā
    obtain ⟨U0, hx0, a0, ha0⟩ := exists_germHom_eq_fun (n := n) x ā
    have hx1 : x ∈ U0 ⊓ W := ⟨hx0, hxW⟩
    let a1 : Fin r → (𝒜).obj.obj (op (U0 ⊓ W)) := fun k => resA inf_le_left (a0 k)
    let φ : Fin r' → (𝒜).obj.obj (op (U0 ⊓ W)) := fun m =>
      ∑ k, a1 k * resA inf_le_right (D k m)
    have hφ : ∀ m, germHom x hx1 (φ m) = 0 := by
      intro m
      have := congrFun hā m
      rw [Matrix.vecMulLinear_apply, Matrix.vecMul, dotProduct, Pi.zero_apply] at this
      rw [map_sum]
      refine Eq.trans ?_ this
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul, germHom_resA x inf_le_left hx1 (a0 k),
        germHom_resA x inf_le_right hx1 (D k m), ha0 k]
      rfl
    obtain ⟨U', h', hx', hφ0⟩ := exists_resA_eq_zero_fun (n := n) x hx1 φ hφ
    refine ⟨U', h'.trans inf_le_right, hx', fun k => resA h' (a1 k), fun k => ?_, ?_⟩
    · rw [germHom_resA x h' hx' (a1 k), germHom_resA x inf_le_left hx1 (a0 k), ha0 k]
    · have e : ∀ k, resM (SheafOfModules.free (R := 𝒜) (Fin r')) (h'.trans inf_le_right)
          (rowsF D k) = rowsF (fun k m => resA (h'.trans inf_le_right) (D k m)) k :=
        fun k => resM_rowsF _ D k
      simp only [e]
      rw [sum_smul_rowsF]
      refine Finset.sum_eq_zero fun m _ => ?_
      have e := (resA_sum (A := 𝒜) h' (fun k => a1 k * resA inf_le_right (D k m))).symm.trans
        (hφ0 m)
      have e2 : ∀ k, resA (A := 𝒜) h' (a1 k * resA inf_le_right (D k m)) =
          resA h' (a1 k) * resA (h'.trans inf_le_right) (D k m) := by
        intro k
        rw [resA_mul (A := 𝒜), resA_resA (A := 𝒜), resA_resA (A := 𝒜)]
      simp only [e2] at e
      rw [e, zero_smul]

end GermRelations

section Resolutions

open TopologicalSpace MMP.Analytic Limits Topology IsLocalRing
open scoped Manifold ContDiff

variable {n : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
  [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M]

local notation "𝒜" => holSheaf n M
local notation "𝒪₀" => holGerms (0 : Fin n → ℂ)

attribute [local instance] instRegular

/-- The germs of relations do not change under restriction to a smaller neighbourhood. -/
theorem krel_restrict {Q : SheafOfModules.{0} 𝒜} {W W' : Opens (TopCat.of M)}
    (h : W' ≤ W) {x : M} (hx' : x ∈ W') {r : ℕ} (g : Fin r → Q.val.obj (op W)) :
    krel Q hx' (fun k => resM Q h (g k)) = krel Q (h hx') g := by
  ext ā
  constructor
  · rintro ⟨U, hU, hx, a, ha, hrel⟩
    refine ⟨U, hU.trans h, hx, a, ha, ?_⟩
    simpa only [resM_resM] using hrel
  · rintro ⟨U, hU, hx, a, ha, hrel⟩
    refine ⟨U ⊓ W', inf_le_right, ⟨hx, hx'⟩, fun k => resA inf_le_left (a k), fun k => ?_, ?_⟩
    · rw [germHom_resA x inf_le_left (show x ∈ U ⊓ W' from ⟨hx, hx'⟩) (a k), ha k]
    · have e := congrArg (resM Q (inf_le_left : U ⊓ W' ≤ U)) hrel
      rw [resM_sum_smul, resM_zero] at e
      simpa only [resM_resM] using e

/-- Dimension shifting: the kernel of a surjection from a projective module onto a module of
projective dimension `≤ k + 1` has projective dimension `≤ k`. -/
theorem hasProjectiveDimensionLE_ker' {R : Type} [Ring R] {B C : Type}
    [AddCommGroup B] [Module R B] [AddCommGroup C] [Module R C] [Module.Projective R B]
    (f : B →ₗ[R] C) (hf : Function.Surjective f) (k : ℕ)
    (hC : HasProjectiveDimensionLE (ModuleCat.of R C) (k + 1)) :
    HasProjectiveDimensionLE (ModuleCat.of R (LinearMap.ker f)) k := by
  have hS := LinearMap.shortExact_shortComplexKer hf
  have : HasProjectiveDimensionLT (ModuleCat.of R B) (k + 1) :=
    hasProjectiveDimensionLT_of_ge _ 1 _ (by omega)
  exact hS.hasProjectiveDimensionLT_X₁ (k + 1) this hC

/-- Projective dimension `≤ k` is invariant under equality of submodules. -/
theorem hasProjectiveDimensionLE_of_eq {R : Type} [Ring R] {B : Type}
    [AddCommGroup B] [Module R B] {N N' : Submodule R B} (h : N = N') (k : ℕ)
    (hN : HasProjectiveDimensionLE (ModuleCat.of R N) k) :
    HasProjectiveDimensionLE (ModuleCat.of R N') k :=
  hasProjectiveDimensionLT_of_iso (LinearEquiv.ofEq N N' h).toModuleIso (k + 1)

/-- The data of a finite free resolution, near `x`, of the module of germs of relations among
finitely many elements `g`. -/
def IsRelResolution (Q : SheafOfModules.{0} 𝒜) {W : Opens (TopCat.of M)} {r : ℕ}
    (g : Fin r → Q.val.obj (op W)) (k : ℕ) (ρ : ℕ → ℕ)
    (D0 : Fin (ρ 0) → Fin r → (𝒜).obj.obj (op W))
    (D : ∀ i, Fin (ρ (i + 1)) → Fin (ρ i) → (𝒜).obj.obj (op W)) : Prop :=
  RelGen Q g D0 ∧ RelGen (SheafOfModules.free (R := 𝒜) (Fin r)) (rowsF D0) (D 0) ∧
    (∀ i, RelGen (SheafOfModules.free (R := 𝒜) (Fin (ρ i))) (rowsF (D i)) (D (i + 1))) ∧
    ∀ i, k < i → ρ i = 0

/-- The germ at `x` of a relation among the `g` lies in `krel`. -/
theorem germ_row_mem_krel {Q : SheafOfModules.{0} 𝒜} {W : Opens (TopCat.of M)} {x : M}
    (hxW : x ∈ W) {r s : ℕ} {g : Fin r → Q.val.obj (op W)} {E : Fin s → Fin r → (𝒜).obj.obj (op W)}
    (hE : ∀ l, ∑ k, E l k • g k = 0) (l : Fin s) :
    (fun k => germHom x hxW (E l k)) ∈ krel Q hxW g :=
  ⟨W, le_rfl, hxW, E l, fun k => rfl, by simpa only [resM_refl] using hE l⟩

/-- **Base case**: if the germs of relations form a projective module, a lift of a basis
generates the relations near `x`, freely. -/
theorem exists_relResolution_zero (x : M)
    (hFree : ∀ q, RelFin (SheafOfModules.free (R := 𝒜) (Fin q)))
    (Q : SheafOfModules.{0} 𝒜) (hQ : RelFin Q) {W : Opens (TopCat.of M)} (hxW : x ∈ W) {r : ℕ}
    (g : Fin r → Q.val.obj (op W))
    (hpd : HasProjectiveDimensionLE (ModuleCat.of 𝒪₀ (krel Q hxW g)) 0) :
    ∃ (W' : Opens (TopCat.of M)) (h : W' ≤ W) (hx : x ∈ W') (ρ : ℕ → ℕ)
      (D0 : Fin (ρ 0) → Fin r → (𝒜).obj.obj (op W'))
      (D : ∀ i, Fin (ρ (i + 1)) → Fin (ρ i) → (𝒜).obj.obj (op W')),
      IsRelResolution Q (fun k => resM Q h (g k)) 0 ρ D0 D := by
  obtain ⟨W₁, hW₁, hx₁, s, E, hE⟩ := exists_relGen hQ hxW g
  have hK : krel Q hxW g = LinearMap.range (germMat x hx₁ E).vecMulLinear := by
    rw [← krel_restrict hW₁ hx₁ g]; exact krel_eq_range hx₁ hE
  set K := krel Q hxW g
  have hfin : Module.Finite 𝒪₀ K := by rw [hK]; exact Module.Finite.range _
  have hproj : Module.Projective 𝒪₀ K :=
    (IsProjective.iff_projective K).2 ((projective_iff_hasProjectiveDimensionLE_zero _).2 hpd)
  have hfree : Module.Free 𝒪₀ K := Module.free_of_flat_of_isLocalRing
  let bB := Module.finBasis 𝒪₀ K
  set m := Module.finrank 𝒪₀ K
  have hErow : ∀ l, (fun k => germHom x hx₁ (E l k)) ∈ K := fun l => by
    have e : K = krel Q hx₁ (fun k => resM Q hW₁ (g k)) := (krel_restrict hW₁ hx₁ g).symm
    rw [e]; exact germ_row_mem_krel hx₁ hE.1 l
  choose U hU hxU a ha hrel using fun j : Fin m => (bB j).2
  obtain ⟨W₂', hx₂', hW₂'⟩ := exists_le_of_forall_mem U hxU
  let W₂ := W₂' ⊓ W₁
  have hx₂ : x ∈ W₂ := ⟨hx₂', hx₁⟩
  have h21 : W₂ ≤ W₁ := inf_le_right
  have h2U : ∀ j, W₂ ≤ U j := fun j => inf_le_left.trans (hW₂' j)
  let b : Fin m → Fin r → (𝒜).obj.obj (op W₂) := fun j k => resA (h2U j) (a j k)
  have hb_germ : ∀ j k, germHom x hx₂ (b j k) = (bB j : Fin r → 𝒪₀) k := fun j k => by
    rw [germHom_resA x (h2U j) hx₂ (a j k), ha j k]
  let cc : Fin s × Fin m → 𝒪₀ := fun p =>
    bB.repr ⟨fun k => germHom x hx₁ (E p.1 k), hErow p.1⟩ p.2
  obtain ⟨U₃, hx₃', c, hc⟩ := exists_germHom_eq_fun (n := n) x cc
  let W₄ := U₃ ⊓ W₂
  have hx₄ : x ∈ W₄ := ⟨hx₃', hx₂⟩
  let φ : Fin s × Fin r → (𝒜).obj.obj (op W₄) := fun p =>
    resA (inf_le_right.trans h21) (E p.1 p.2) -
      ∑ j, resA inf_le_left (c (p.1, j)) * resA inf_le_right (b j p.2)
  have hφ : ∀ p, germHom x hx₄ (φ p) = 0 := by
    rintro ⟨l, k⟩
    simp only [φ, map_sub, map_sum, map_mul]
    rw [germHom_resA x (inf_le_right.trans h21) hx₄ (E l k), sub_eq_zero]
    have hrepr := bB.sum_repr ⟨fun k => germHom x hx₁ (E l k), hErow l⟩
    have := congrArg (fun v : K => (v : Fin r → 𝒪₀) k) hrepr
    simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul] at this
    rw [← this]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [germHom_resA x inf_le_left hx₄ (c (l, j)), germHom_resA x inf_le_right hx₄ (b j k),
      hc (l, j), hb_germ j k]
  obtain ⟨W₅, h54, hx₅, hφ0⟩ := exists_resA_eq_zero_fun (n := n) x hx₄ φ hφ
  have h52 : W₅ ≤ W₂ := h54.trans inf_le_right
  have hEcb : ∀ l k, resA (h52.trans h21) (E l k) =
      ∑ j, resA (h54.trans inf_le_left) (c (l, j)) * resA h52 (b j k) := by
    intro l k
    have e := hφ0 (l, k)
    simp only [φ] at e
    rw [resA_sub (A := 𝒜), sub_eq_zero, resA_resA (A := 𝒜), resA_sum (A := 𝒜)] at e
    rw [e]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [resA_mul (A := 𝒜), resA_resA (A := 𝒜), resA_resA (A := 𝒜)]
  let b5 : Fin m → Fin r → (𝒜).obj.obj (op W₅) := fun j k => resA h52 (b j k)
  obtain ⟨W₆, h65, hx₆, t, F, hF⟩ := exists_relGen (hFree r) hx₅ (rowsF b5)
  have hFrel : ∀ l k, ∑ j, F l j * resA h65 (b5 j k) = 0 := by
    intro l k
    have e := hF.1 l
    have e2 : ∀ j, resM (SheafOfModules.free (R := 𝒜) (Fin r)) h65 (rowsF b5 j) =
        rowsF (fun j k => resA h65 (b5 j k)) j := fun j => resM_rowsF h65 b5 j
    simp only [e2] at e
    rw [sum_smul_rowsF] at e
    exact congrFun (free_sum_smul_injective (b := fun _ => 0) (e.trans (by simp))) k
  have hFgerm : ∀ l j, germHom x hx₆ (F l j) = 0 := by
    intro l
    refine Fintype.linearIndependent_iff.1 bB.linearIndependent
      (fun j => germHom x hx₆ (F l j)) (Subtype.ext (funext fun k => ?_))
    have := congrArg (germHom x hx₆) (hFrel l k)
    rw [map_sum, map_zero] at this
    simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul, Submodule.coe_zero, Pi.zero_apply]
    refine Eq.trans ?_ this
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, germHom_resA x h65 hx₆ (b5 j k), germHom_resA x h52 hx₅ (b j k), hb_germ]
  obtain ⟨W₇, h76, hx₇, hF0⟩ := exists_resA_eq_zero_fun (n := n) x hx₆
    (fun p : Fin t × Fin m => F p.1 p.2) fun p => hFgerm p.1 p.2
  have h72 : W₇ ≤ W₂ := (h76.trans h65).trans h52
  have h7 : W₇ ≤ W := (h72.trans h21).trans hW₁
  let ρ : ℕ → ℕ := fun i => match i with | 0 => m | _ + 1 => 0
  let D0 : Fin (ρ 0) → Fin r → (𝒜).obj.obj (op W₇) := fun j k => resA h72 (b j k)
  let D : ∀ i, Fin (ρ (i + 1)) → Fin (ρ i) → (𝒜).obj.obj (op W₇) := fun _ => Fin.elim0
  refine ⟨W₇, h7, hx₇, ρ, D0, D, ⟨fun j => ?_, fun U hU a ha y hy => ?_⟩,
    ⟨fun l => Fin.elim0 l, fun U hU a ha y hy => ?_⟩,
    fun i => ⟨fun l => Fin.elim0 l, fun U hU a ha y hy => ⟨U, le_rfl, hy, fun l => Fin.elim0 l,
      fun k => Fin.elim0 k⟩⟩, fun i hi => ?_⟩
  · have e := congrArg (resM Q (h72.trans (h2U j))) (hrel j)
    rw [resM_sum_smul, resM_zero] at e
    refine Eq.trans ?_ e
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [D0, b, resA_resA, resM_resM]
  · have ha' : ∑ k, a k • resM Q (hU.trans (h72.trans h21)) (resM Q hW₁ (g k)) = 0 := by
      simpa only [resM_resM] using ha
    obtain ⟨U', h', hy', c', hc'⟩ := hE.2 U (hU.trans (h72.trans h21)) a ha' y hy
    refine ⟨U', h', hy', fun j => ∑ l, c' l * resA (h'.trans (hU.trans (h76.trans h65 |>.trans
      h54 |>.trans inf_le_left))) (c (l, j)), fun k => ?_⟩
    rw [hc' k]
    have e : ∀ l, resA (h'.trans (hU.trans (h72.trans h21))) (E l k) =
        ∑ j, resA (h'.trans (hU.trans (h76.trans h65 |>.trans h54 |>.trans inf_le_left)))
          (c (l, j)) * resA (h'.trans hU) (D0 j k) := by
      intro l
      have e1 := congrArg (resA (A := 𝒜) (h'.trans (hU.trans (h76.trans h65)))) (hEcb l k)
      rw [resA_resA (A := 𝒜), resA_sum (A := 𝒜)] at e1
      rw [e1]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [resA_mul (A := 𝒜), resA_resA (A := 𝒜), resA_resA (A := 𝒜)]
      simp only [D0, resA_resA]
    simp only [e, Finset.mul_sum, Finset.sum_mul, mul_assoc]
    exact Finset.sum_comm
  · have e2 : ∀ j, resM (SheafOfModules.free (R := 𝒜) (Fin r)) hU (rowsF D0 j) =
        resM (SheafOfModules.free (R := 𝒜) (Fin r)) (hU.trans h76) (resM _ h65 (rowsF b5 j)) := by
      intro j
      rw [resM_rowsF, resM_rowsF, resM_rowsF]
      congr 1
    simp only [e2] at ha
    obtain ⟨U', h', hy', c', hc'⟩ := hF.2 U (hU.trans h76) a ha y hy
    refine ⟨U', h', hy', fun l => Fin.elim0 l, fun j => ?_⟩
    rw [hc' j]
    refine (Finset.sum_eq_zero fun l _ => ?_).trans (Fintype.sum_empty _).symm
    have e3 := hF0 (l, j)
    have e4 : resA (A := 𝒜) (h'.trans (hU.trans h76)) (F l j) =
        resA (A := 𝒜) (h'.trans hU) (resA h76 (F l j)) := by rw [resA_resA (A := 𝒜)]
    rw [e4]
    simp only at e3
    rw [e3]
    simp [resA]
  · cases i with
    | zero => exact absurd hi (lt_irrefl 0)
    | succ i => rfl

/-- **Finite free resolutions of relation modules.** If the germs at `x` of the relations among
finitely many elements have projective dimension `≤ k`, the relations have, near `x`, a finite
free resolution of length `≤ k`. -/
theorem exists_relResolution (x : M)
    (hFree : ∀ q, RelFin (SheafOfModules.free (R := 𝒜) (Fin q))) :
    ∀ (k : ℕ) (Q : SheafOfModules.{0} 𝒜), RelFin Q → ∀ {W : Opens (TopCat.of M)} (hxW : x ∈ W)
      {r : ℕ} (g : Fin r → Q.val.obj (op W)),
      HasProjectiveDimensionLE (ModuleCat.of 𝒪₀ (krel Q hxW g)) k →
      ∃ (W' : Opens (TopCat.of M)) (h : W' ≤ W) (hx : x ∈ W') (ρ : ℕ → ℕ)
        (D0 : Fin (ρ 0) → Fin r → (𝒜).obj.obj (op W'))
        (D : ∀ i, Fin (ρ (i + 1)) → Fin (ρ i) → (𝒜).obj.obj (op W')),
        IsRelResolution Q (fun k => resM Q h (g k)) k ρ D0 D
  | 0, Q, hQ, _, hxW, _, g, hpd => exists_relResolution_zero x hFree Q hQ hxW g hpd
  | k + 1, Q, hQ, W, hxW, r, g, hpd => by
    obtain ⟨W₁, hW₁, hx₁, s, E, hE⟩ := exists_relGen hQ hxW g
    have hK : krel Q hxW g = LinearMap.range (germMat x hx₁ E).vecMulLinear := by
      rw [← krel_restrict hW₁ hx₁ g]; exact krel_eq_range hx₁ hE
    have hK2 := krel_rowsF_eq_ker hx₁ E
    let f := (germMat x hx₁ E).vecMulLinear.rangeRestrict
    have hpd1 : HasProjectiveDimensionLE
        (ModuleCat.of 𝒪₀ (LinearMap.range (germMat x hx₁ E).vecMulLinear)) (k + 1) :=
      hasProjectiveDimensionLE_of_eq hK (k + 1) hpd
    have hpd2 := hasProjectiveDimensionLE_ker' f (LinearMap.surjective_rangeRestrict _) k hpd1
    have hpd3 : HasProjectiveDimensionLE (ModuleCat.of 𝒪₀
        (krel (SheafOfModules.free (R := 𝒜) (Fin r)) hx₁ (rowsF E))) k := by
      refine hasProjectiveDimensionLE_of_eq ?_ k hpd2
      rw [hK2]; exact LinearMap.ker_rangeRestrict _
    obtain ⟨W₂, h21, hx₂, ρ', D0', D', hres⟩ :=
      exists_relResolution x hFree k _ (hFree r) hx₁ (rowsF E) hpd3
    let ρ : ℕ → ℕ := fun i => match i with | 0 => s | i + 1 => ρ' i
    let D0 : Fin (ρ 0) → Fin r → (𝒜).obj.obj (op W₂) := fun l k => resA h21 (E l k)
    let D : ∀ i, Fin (ρ (i + 1)) → Fin (ρ i) → (𝒜).obj.obj (op W₂) := fun i =>
      match i with
      | 0 => D0'
      | i + 1 => D' i
    refine ⟨W₂, h21.trans hW₁, hx₂, ρ, D0, D, ?_, ?_, ?_, ?_⟩
    · have := hE.restrict h21
      convert this using 2
      rw [resM_resM]
    · have := hres.1
      convert this using 2
      rw [resM_rowsF]
    · intro i
      cases i with
      | zero => exact hres.2.1
      | succ i => exact hres.2.2.1 i
    · intro i hi
      cases i with
      | zero => exact absurd hi (Nat.not_lt_zero _)
      | succ i => exact hres.2.2.2 i (by omega)

end Resolutions

section ExactSite

open Limits

variable {C : Type} [SmallCategory C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{0}}
  [HasSheafify J AddCommGrpCat.{0}] [J.WEqualsLocallyBijective AddCommGrpCat.{0}]

/-- A short complex of sheaves of modules is exact if every section of the middle term killed by
the second map is locally in the image of the first. -/
theorem shortComplex_exact_of_locally (S : ShortComplex (SheafOfModules.{0} R))
    (h : ∀ (X : C) (b : S.X₂.val.obj (op X)), S.g.val.app (op X) b = 0 →
      ∃ T ∈ J X, ∀ (Y : C) (f : Y ⟶ X), T f →
        ∃ a : S.X₁.val.obj (op Y), S.f.val.app (op Y) a = S.X₂.val.map f.op b) :
    S.Exact := by
  rw [ShortComplex.exact_iff_epi_kernel_lift]
  refine epi_of_locally_surjective _ fun X k => ?_
  obtain ⟨T, hT, hTc⟩ := h X ((kernel.ι S.g).val.app _ k) (kernel_condition_app S.g _ k)
  refine ⟨T, hT, fun Y f hf => ?_⟩
  obtain ⟨a, ha⟩ := hTc Y f hf
  refine ⟨a, kernel_ι_app_injective S.g _ ?_⟩
  change (kernel.lift S.g S.f S.zero ≫ kernel.ι S.g).val.app (op Y) a = _
  rw [kernel.lift_ι, ha, PresheafOfModules.naturality_apply]

end ExactSite

