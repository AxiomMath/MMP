section Helpers

variable {X : TopCat.{0}} {A : Sheaf (Opens.grothendieckTopology X) RingCat.{0}}

/-- Restriction to an open preserves monomorphisms of sheaves of modules. -/
theorem mono_hom_over {S T : SheafOfModules.{0} A} (i : S ⟶ T) [Mono i]
    (V : Opens X) : Mono (i.over V) := by
  have : Mono i.val := inferInstanceAs (Mono ((SheafOfModules.forget _).map i))
  have hinj := PresheafOfModules.injective_of_mono i.val
  exact (SheafOfModules.forget _).mono_of_mono_map
    (PresheafOfModules.mono_of_injective (fun W => hinj (op W.unop.left)))

section Site

variable {C : Type} [Category.{0} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{0}}
  [∀ Y : C, HasWeakSheafify (J.over Y) AddCommGrpCat.{0}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{0}]

/-- Being of finite type is invariant under isomorphism. -/
theorem isFiniteType_of_iso {S T : SheafOfModules.{0} R} (e : S ≅ T)
    (hS : SheafOfModules.IsFiniteType.{0} S) : SheafOfModules.IsFiniteType.{0} T := by
  obtain ⟨σ, hσ⟩ := hS.1
  refine ⟨⟨⟨σ.I, σ.X, σ.coversTop, fun j => (σ.generators j).ofEpi (e.hom.over (σ.X j))⟩,
    ⟨fun j => ?_⟩⟩⟩
  have := hσ.isFiniteType j
  dsimp
  infer_instance

end Site

/-- A subsheaf of finite type of a coherent sheaf of modules is coherent. -/
theorem isCoherentModule_of_mono {S T : SheafOfModules.{0} A} (i : S ⟶ T) [Mono i]
    (hT : IsCoherentModule T) (hS : SheafOfModules.IsFiniteType.{0} S) : IsCoherentModule S := by
  refine ⟨hS, fun V p s => ?_⟩
  have := mono_hom_over i V
  have h := hT.2 V p (fun j => SheafOfModules.sectionsMap (i.over V) (s j))
  refine isFiniteType_of_iso ?_ h
  exact Limits.kernelIsoOfEq (SheafOfModules.freeHomEquiv_symm_comp s (i.over V)).symm ≪≫
    Limits.kernelCompMono _ _

/-- A quotient of a sheaf of modules of finite type is of finite type. -/
theorem isFiniteType_of_epi {S T : SheafOfModules.{0} A} (p : S ⟶ T) [Epi p]
    (hS : SheafOfModules.IsFiniteType.{0} S) : SheafOfModules.IsFiniteType.{0} T := by
  obtain ⟨σ, hσ⟩ := hS.1
  have (Y : Opens X) : Epi (p.over Y) :=
    have : (SheafOfModules.overFunctor.{0} A Y).IsLeftAdjoint :=
      ⟨_, ⟨SheafOfModules.overPushforwardOverAdj Y⟩⟩
    (SheafOfModules.overFunctor.{0} A Y).map_epi p
  refine ⟨⟨⟨σ.I, σ.X, σ.coversTop, fun j => (σ.generators j).ofEpi (p.over (σ.X j))⟩,
    ⟨fun j => ?_⟩⟩⟩
  have := hσ.isFiniteType j
  dsimp
  infer_instance

/-- The image of a map of coherent sheaves of modules is coherent. -/
theorem isCoherentModule_image {S T : SheafOfModules.{0} A} (f : S ⟶ T)
    (hS : IsCoherentModule S) (hT : IsCoherentModule T) : IsCoherentModule (Limits.image f) :=
  isCoherentModule_of_mono (Limits.image.ι f) hT
    (isFiniteType_of_epi (Limits.factorThruImage f) hS.1)

end Helpers

