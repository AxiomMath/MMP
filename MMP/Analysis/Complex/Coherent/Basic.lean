/-- Part (3): local finite free resolutions of length at most `n`. -/
private theorem exists_local_free_resolution
    {n : ℕ} {M : Type} [TopologicalSpace M] [T2Space M] [SecondCountableTopology M]
    [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
    [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M] :
    (∀ S : SheafOfModules.{0} (holomorphicRingCatSheaf n M), IsCoherentModule S →
      ∀ x : M, ∃ W : Opens (TopCat.of M), x ∈ W ∧
        ∃ (C : ChainComplex (SheafOfModules.{0} ((holomorphicRingCatSheaf n M).over W)) ℕ)
          (ε : C.X 0 ⟶ S.over W),
          (∀ i, ∃ r : ℕ, Nonempty (C.X i ≅ SheafOfModules.free (Fin r))) ∧
          (∀ i, n < i → Limits.IsZero (C.X i)) ∧ (∀ i, 0 < i → C.ExactAt i) ∧ Epi ε ∧
          ∃ h : C.d 1 0 ≫ ε = 0, (ShortComplex.mk _ _ h).Exact) := by
  intro S hS x
  let : IsRegularLocalRing (holGerms (0 : Fin n → ℂ)) := instRegular n
  have hOka : IsCoherentRing (holomorphicRingCatSheaf n M) :=
    OkaCoherence.isCoherentRing_holomorphicRingCatSheaf n M
  have hFree : ∀ q, RelFin (SheafOfModules.free (R := holSheaf n M) (Fin q)) := fun q =>
    relFin_free_of_vecRel (vecRel_of_one (vecRel_one_of_relFin (relFin_of_isCoherentModule hOka)) q)
  have hRelS : RelFin (A := holSheaf n M) S := relFin_of_isCoherentModule hS
  obtain ⟨W0, hxW0, r, s, hs⟩ := (isFiniteType_iff_finGen S).1 hS.1 x
  obtain ⟨_, hdim, -, -⟩ := isRegularLocalRing_holGerms n
  have hglob := (IsRegularLocalRing.exists_leftResolution_free_finite_and_hasProjectiveDimensionLE
    (R := holGerms (0 : Fin n → ℂ)) (d := n) hdim.le).2
  have hN := hglob (ModuleCat.of _ ((Fin r → holGerms (0 : Fin n → ℂ)) ⧸
    krel S hxW0 s))
  cases n with
  | zero =>
    obtain ⟨W', -, hx', m, t, ht, hind⟩ := exists_free_generators x S hRelS hxW0 s hs hN
    have hres : IsRelResolution S t 0 (fun _ => 0) (fun l => Fin.elim0 l)
        (fun _ l => Fin.elim0 l) :=
      ⟨hind, ⟨fun l => Fin.elim0 l, fun U _ _ _ y hy => ⟨U, le_rfl, hy, fun l => Fin.elim0 l,
        fun k => Fin.elim0 k⟩⟩, fun _ => ⟨fun l => Fin.elim0 l, fun U _ _ _ y hy =>
        ⟨U, le_rfl, hy, fun l => Fin.elim0 l, fun k => Fin.elim0 k⟩⟩, fun _ _ => rfl⟩
    obtain ⟨C, ε, hiso, hzero, hexact, hepi, h0⟩ := exists_complex_of_relResolution S t ht hres
    refine ⟨W', hx', C, ε, hiso, fun i hi => ?_, hexact, hepi, h0⟩
    obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
    exact hzero j rfl
  | succ k =>
    have hK := hasProjectiveDimensionLE_ker' (krel S hxW0 s).mkQ
      (Submodule.mkQ_surjective _) k hN
    have hK' : HasProjectiveDimensionLE (ModuleCat.of (holGerms (0 : Fin (k + 1) → ℂ))
        (krel S hxW0 s)) k :=
      hasProjectiveDimensionLE_of_eq (Submodule.ker_mkQ _) k hK
    obtain ⟨W', hW', hx', ρ, D0, D, hres⟩ := exists_relResolution x hFree k S hRelS hxW0 s hK'
    obtain ⟨C, ε, hiso, hzero, hexact, hepi, h0⟩ :=
      exists_complex_of_relResolution S _ (hs.restrict hW') hres
    refine ⟨W', hx', C, ε, hiso, fun i hi => ?_, hexact, hepi, h0⟩
    obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
    exact hzero j (hres.2.2.2 j (by omega))

/-- Part (4): the closed-submanifold package (ideal generators, local model, `ι_*` and its
converse). -/
private theorem closed_submanifold_package
    {n : ℕ} {M : Type} [TopologicalSpace M] [T2Space M] [SecondCountableTopology M]
    [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
    [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M] :
    (∀ Z : Set M, IsClosedComplexSubmanifold n Z →
      (∀ φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M, ∀ k : ℕ,
          φ '' (Z ∩ φ.source) = φ.target ∩ {y | ∀ i : Fin n, k ≤ (i : ℕ) → y i = 0} →
          ∃ y : {i : Fin n // k ≤ (i : ℕ)} →
              ((vanishingIdealSheaf n Z).over ⟨φ.source, φ.open_source⟩).sections,
            (∀ i (q : (⟨φ.source, φ.open_source⟩ : Opens (TopCat.of M))),
              (show vanishingIdeal n Z ⟨φ.source, φ.open_source⟩ from
                (y i).1 (op (Over.mk (𝟙 _)))).1 q = φ q i) ∧
            Epi (((vanishingIdealSheaf n Z).over ⟨φ.source, φ.open_source⟩).freeHomEquiv.symm
              y)) ∧
      (∀ z : Z, ∃ (U : Opens (TopCat.of Z)) (_ : z ∈ U) (k : ℕ)
          (V : Opens (EuclideanSpace ℂ (Fin k))),
        Nonempty (SheafedSpace.restrict (C := CommRingCat.{0})
            { carrier := TopCat.of Z, presheaf := (submanifoldStructureSheaf n Z).presheaf
              IsSheaf := (submanifoldStructureSheaf n Z).property } U.isOpenEmbedding ≅
          { carrier := TopCat.of V, presheaf := 𝒪[k, V].presheaf, IsSheaf := 𝒪[k, V].property })) ∧
      haveI : (Opens.map (submanifoldInclusion Z)).IsContinuous
          (Opens.grothendieckTopology (TopCat.of M)) (Opens.grothendieckTopology (TopCat.of Z)) :=
        Functor.isContinuous_of_coverPreserving (compatiblePreserving_opens_map _)
          (coverPreserving_opens_map _)
      let OZ := (sheafCompose _ (forget₂ CommRingCat RingCat.{0})).obj
        (submanifoldStructureSheaf n Z)
      let φZ : holomorphicRingCatSheaf n M ⟶
          ((Opens.map (submanifoldInclusion Z)).sheafPushforwardContinuous RingCat.{0}
            (Opens.grothendieckTopology (TopCat.of M))
            (Opens.grothendieckTopology (TopCat.of Z))).obj OZ :=
        { hom := Functor.whiskerRight (toQuotientVanishingIdealSheaf n Z ≫
            (TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{0}
              (submanifoldInclusion Z)).unit.app (quotientVanishingIdealSheaf n Z)).hom
            (forget₂ CommRingCat RingCat.{0}) }
      haveI : (PresheafOfModules.pushforward.{0} φZ.hom).IsRightAdjoint :=
        Functor.isRightAdjoint_of_leftAdjointObjIsDefined_eq_top
          (PresheafOfModules.pullbackObjIsDefined_eq_top φZ.hom)
      haveI : (SheafOfModules.pushforward.{0} φZ).IsRightAdjoint :=
        (SheafOfModules.PullbackConstruction.adjunction.{0} φZ).isRightAdjoint
      (∀ S : SheafOfModules.{0} OZ, IsCoherentModule S →
        IsCoherentModule ((SheafOfModules.pushforward.{0} φZ).obj S) ∧
        ∀ q : ℤ, IsIso (sheafCohomologyPullback (submanifoldInclusion Z)
            ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} (submanifoldInclusion Z)).obj
              ((SheafOfModules.toSheaf _).obj S)) q ≫
          (sheafCohomology (TopCat.of Z) q).map
            ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
              (submanifoldInclusion Z)).counit.app ((SheafOfModules.toSheaf _).obj S)))) ∧
      (∀ T : SheafOfModules.{0} (holomorphicRingCatSheaf n M), IsCoherentModule T →
        (∀ (U : Opens (TopCat.of M)) (g : 𝒪[n, M].presheaf.obj (op U)),
          g ∈ vanishingIdeal n Z U → ∀ t : T.val.obj (op U),
            (show (holomorphicRingCatSheaf n M).obj.obj (op U) from g) • t = 0) →
        IsCoherentModule ((SheafOfModules.pullback.{0} φZ).obj T) ∧
          IsIso ((SheafOfModules.pullbackPushforwardAdjunction.{0} φZ).unit.app T))) := by
  intro Z hZ
  refine ⟨fun φ hφ k hflat => vanishingIdeal_generated_by_coords hφ k hflat,
    exists_local_model hZ, ?_⟩
  · intro OZ φZ
    have hZc : IsClosed Z := hZ.1
    have hemb : Topology.IsClosedEmbedding (submanifoldInclusion Z) :=
      hZc.isClosedEmbedding_subtypeVal
    have hrange : Set.range (submanifoldInclusion Z) = Z := Subtype.range_coe
    refine ⟨fun S hS => ⟨?_, fun q => ?_⟩, fun T hT hI => pullback_package hZc T hT hI⟩
    · exact isCoherentModule_pushZ hZ S hS
    · have i1 := isIso_sheafCohomologyPullback_of_isClosedEmbedding hemb
        ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} (submanifoldInclusion Z)).obj
          ((SheafOfModules.toSheaf _).obj S))
        (fun x hx => subsingleton_stalk_pushforward _ (by rw [hrange]; exact hZc) _ hx) q
      have i2 := isIso_pullbackPushforwardAdjunction_counit hemb.isInducing
        ((SheafOfModules.toSheaf _).obj S)
      exact IsIso.comp_isIso

/-- Part (5): sections of a coherent subsheaf of `𝒪ᵖ` are closed under locally uniform limits. -/
private theorem closure_of_submodule_sections
    {n : ℕ} {M : Type} [TopologicalSpace M] [T2Space M] [SecondCountableTopology M]
    [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
    [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M] :
    (∀ (p : ℕ) (R : SheafOfModules.{0} (holomorphicRingCatSheaf n M))
        (i : R ⟶ SheafOfModules.free (Fin p)) [Mono i], IsCoherentModule R →
      ∀ (V : Opens (TopCat.of M)) (F : ℕ → Fin p → 𝒪[n, M].presheaf.obj (op V))
        (f : Fin p → 𝒪[n, M].presheaf.obj (op V)),
        (∀ k, ∃ r : R.val.obj (op V), (i.val.app (op V)).hom r =
          ∑ j, (show (holomorphicRingCatSheaf n M).obj.obj (op V) from F k j) •
            (show (SheafOfModules.free (R := holomorphicRingCatSheaf n M) (Fin p)).val.obj (op V)
              from (SheafOfModules.freeSection j).1 (op V))) →
        (∀ j (K : Set V), IsCompact K →
          TendstoUniformlyOn (fun k (y : V) => F k j y) (fun y => f j y) atTop K) →
        ∃ r : R.val.obj (op V), (i.val.app (op V)).hom r =
          ∑ j, (show (holomorphicRingCatSheaf n M).obj.obj (op V) from f j) •
            (show (SheafOfModules.free (R := holomorphicRingCatSheaf n M) (Fin p)).val.obj (op V)
              from (SheafOfModules.freeSection j).1 (op V))) := by
  intro p R i _ hR V F0 f0 hF hconv
  let P := SheafOfModules.free (R := holomorphicRingCatSheaf n M) (Fin p)
  let F : ℕ → Fin p → (holomorphicRingCatSheaf n M).obj.obj (op V) := F0
  let f : Fin p → (holomorphicRingCatSheaf n M).obj.obj (op V) := f0
  change ∃ r : R.val.obj (op V), i.val.app (op V) r = ∑ j, f j • freeElt j (op V)
  replace hF : ∀ k, ∃ r : R.val.obj (op V), i.val.app (op V) r =
      ∑ j, F k j • freeElt j (op V) := hF
  choose rk hrk using hF
  refine exists_app_eq_of_locally i _ fun y hyV => ?_
  obtain ⟨W, hyW, s, g, hg⟩ := (isFiniteType_iff_finGen R).1 hR.1 y
  choose a ha using fun l => MMP.exists_eq_sum_smul_freeSection
    (R := holomorphicRingCatSheaf n M) (op W) (i.val.app (op W) (g l))
  have hiW : ∀ {U : Opens (TopCat.of M)} (hU : U ≤ W)
      (c : Fin s → (holomorphicRingCatSheaf n M).obj.obj (op U)),
      i.val.app (op U) (∑ l, c l • resM R hU (g l)) =
        ∑ j, (∑ l, c l * resA hU (a l j)) • freeElt j (op U) := by
    intro U hU c
    rw [hom_sum_smul]
    have e : ∀ l, i.val.app (op U) (resM R hU (g l)) =
        ∑ j, resA hU (a l j) • freeElt j (op U) := by
      intro l
      rw [hom_resM i hU (g l), ha l]
      exact free_map_sum_smul (R := holomorphicRingCatSheaf n M) _ _
    simp only [e]
    exact sum_smul_sum_smul _ _ _
  have hmem : ∀ k, ∃ (U : Opens (TopCat.of M)) (hU : U ≤ V ⊓ W), y ∈ U ∧
      ∃ c : Fin s → (holomorphicRingCatSheaf n M).obj.obj (op U),
        ∀ j, resA (hU.trans inf_le_left) (F k j) =
          ∑ l, c l * resA (hU.trans inf_le_right) (a l j) := by
    intro k
    obtain ⟨U1, h1, hy1, c, hc⟩ := hg.exists_nhds (inf_le_right : V ⊓ W ≤ W)
      (resM R (inf_le_left : V ⊓ W ≤ V) (rk k)) ⟨hyV, hyW⟩
    refine ⟨U1, h1, hy1, c, fun j => ?_⟩
    have e1 : i.val.app (op U1) (resM R (h1.trans inf_le_left) (rk k)) =
        ∑ j, resA (h1.trans inf_le_left) (F k j) • freeElt j (op U1) := by
      rw [hom_resM i _ (rk k), hrk k]
      exact free_map_sum_smul (R := holomorphicRingCatSheaf n M) _ _
    have e2 := congrArg (i.val.app (op U1)) hc
    rw [resM_resM] at e2
    rw [e1, hiW] at e2
    exact congrFun (free_sum_smul_injective e2) j
  obtain ⟨U, hU, hyU, c, hc⟩ := local_closure hyV hyW a F f hconv hmem
  refine ⟨U, hU.trans inf_le_left, hyU, ∑ l, c l • resM R (hU.trans inf_le_right) (g l), ?_⟩
  rw [hiW]
  have e4 : resM P (hU.trans inf_le_left) (∑ j, f j • freeElt j (op V)) =
      ∑ j, resA (hU.trans inf_le_left) (f j) • freeElt j (op U) :=
    free_map_sum_smul (R := holomorphicRingCatSheaf n M) _ _
  refine Eq.trans ?_ e4.symm
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hc j]

/-- **The coherent analytic toolkit.** On a complex manifold `M` of dimension `n`:
(1) kernels, cokernels and images of maps of coherent modules are coherent, and finitely
generated subsheaves of coherent sheaves are coherent; (2) sections generating
`𝒮_x / 𝔪_x 𝒮_x` generate `𝒮` near `x`, and a coherent sheaf with zero stalk at `x` vanishes
near `x`; (3) a coherent sheaf has, near every point, a finite free resolution of length `≤ n`;
(4) for a closed complex submanifold `Z` with inclusion `ι`: in a flattening chart `ℐ_Z` is
generated by the coordinates `y_i`, `i ≥ k`; `(Z, 𝒪_Z)` is locally isomorphic to an open subset
of some `ℂᵏ` with its sheaf of holomorphic functions; `ι_*` preserves coherence and cohomology;
and a coherent `𝒯` with `ℐ_Z 𝒯 = 0` is `ι_*` of the coherent `𝒪_Z`-module `𝒯|_Z`;
(5) for a coherent `𝓡 ⊆ 𝒪_Mᵖ`, `𝓡(V)` is closed under uniform convergence on compact subsets
of `V`. -/
@[mmp "lem_mmp_gaga_coherent_analytic_package"]
public theorem coherent_analytic_toolkit
    {n : ℕ} {M : Type} [TopologicalSpace M] [T2Space M] [SecondCountableTopology M]
    [ChartedSpace (EuclideanSpace ℂ (Fin n)) M]
    [IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M] :
    -- (1)
    (∀ {S T : SheafOfModules.{0} (holomorphicRingCatSheaf n M)} (f : S ⟶ T),
        IsCoherentModule S → IsCoherentModule T →
          IsCoherentModule (Limits.kernel f) ∧ IsCoherentModule (Limits.cokernel f) ∧
            IsCoherentModule (Limits.image f)) ∧
    (∀ {S T : SheafOfModules.{0} (holomorphicRingCatSheaf n M)} (i : S ⟶ T) [Mono i],
        IsCoherentModule T → SheafOfModules.IsFiniteType.{0} S → IsCoherentModule S) ∧
    -- (2)
    (∀ S : SheafOfModules.{0} (holomorphicRingCatSheaf n M), IsCoherentModule S →
      ∀ (V : Opens (TopCat.of M)) (x : M) (r : ℕ) (s : Fin r → (S.over V).sections),
        (∀ (U : Opens (TopCat.of M)) (t : S.val.obj (op U)), x ∈ U →
          ∃ (U' : Opens (TopCat.of M)) (hU' : U' ≤ U ⊓ V) (hx : x ∈ U')
            (a : Fin r → (holomorphicRingCatSheaf n M).obj.obj (op U')) (m : ℕ)
            (b : Fin m → 𝒪[n, M].presheaf.obj (op U')) (u : Fin m → S.val.obj (op U')),
            (∀ j, b j ⟨x, hx⟩ = 0) ∧
            (show S.val.obj (op U') from
                S.val.presheaf.map (homOfLE (hU'.trans inf_le_left)).op t) =
              ∑ i, a i • (show S.val.obj (op U') from
                S.val.presheaf.map (homOfLE (hU'.trans inf_le_right)).op
                  ((s i).1 (op (Over.mk (𝟙 V))))) +
              ∑ j, (show (holomorphicRingCatSheaf n M).obj.obj (op U') from b j) • u j) →
        ∃ (W : Opens (TopCat.of M)) (hWV : W ≤ V), x ∈ W ∧
          Epi (SheafOfModules.Hom.over ((S.over V).freeHomEquiv.symm s)
            (Over.mk (homOfLE hWV)))) ∧
    (∀ S : SheafOfModules.{0} (holomorphicRingCatSheaf n M), IsCoherentModule S →
      ∀ x : M, Limits.IsZero (TopCat.Presheaf.stalk (X := TopCat.of M) S.val.presheaf x) →
        ∃ W : Opens (TopCat.of M), x ∈ W ∧ Limits.IsZero (S.over W)) ∧
    -- (3)
    (∀ S : SheafOfModules.{0} (holomorphicRingCatSheaf n M), IsCoherentModule S →
      ∀ x : M, ∃ W : Opens (TopCat.of M), x ∈ W ∧
        ∃ (C : ChainComplex (SheafOfModules.{0} ((holomorphicRingCatSheaf n M).over W)) ℕ)
          (ε : C.X 0 ⟶ S.over W),
          (∀ i, ∃ r : ℕ, Nonempty (C.X i ≅ SheafOfModules.free (Fin r))) ∧
          (∀ i, n < i → Limits.IsZero (C.X i)) ∧ (∀ i, 0 < i → C.ExactAt i) ∧ Epi ε ∧
          ∃ h : C.d 1 0 ≫ ε = 0, (ShortComplex.mk _ _ h).Exact) ∧
    -- (4)
    (∀ Z : Set M, IsClosedComplexSubmanifold n Z →
      (∀ φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ M, ∀ k : ℕ,
          φ '' (Z ∩ φ.source) = φ.target ∩ {y | ∀ i : Fin n, k ≤ (i : ℕ) → y i = 0} →
          ∃ y : {i : Fin n // k ≤ (i : ℕ)} →
              ((vanishingIdealSheaf n Z).over ⟨φ.source, φ.open_source⟩).sections,
            (∀ i (q : (⟨φ.source, φ.open_source⟩ : Opens (TopCat.of M))),
              (show vanishingIdeal n Z ⟨φ.source, φ.open_source⟩ from
                (y i).1 (op (Over.mk (𝟙 _)))).1 q = φ q i) ∧
            Epi (((vanishingIdealSheaf n Z).over ⟨φ.source, φ.open_source⟩).freeHomEquiv.symm
              y)) ∧
      (∀ z : Z, ∃ (U : Opens (TopCat.of Z)) (_ : z ∈ U) (k : ℕ)
          (V : Opens (EuclideanSpace ℂ (Fin k))),
        Nonempty (SheafedSpace.restrict (C := CommRingCat.{0})
            { carrier := TopCat.of Z, presheaf := (submanifoldStructureSheaf n Z).presheaf
              IsSheaf := (submanifoldStructureSheaf n Z).property } U.isOpenEmbedding ≅
          { carrier := TopCat.of V, presheaf := 𝒪[k, V].presheaf, IsSheaf := 𝒪[k, V].property })) ∧
      haveI : (Opens.map (submanifoldInclusion Z)).IsContinuous
          (Opens.grothendieckTopology (TopCat.of M)) (Opens.grothendieckTopology (TopCat.of Z)) :=
        Functor.isContinuous_of_coverPreserving (compatiblePreserving_opens_map _)
          (coverPreserving_opens_map _)
      let OZ := (sheafCompose _ (forget₂ CommRingCat RingCat.{0})).obj
        (submanifoldStructureSheaf n Z)
      let φZ : holomorphicRingCatSheaf n M ⟶
          ((Opens.map (submanifoldInclusion Z)).sheafPushforwardContinuous RingCat.{0}
            (Opens.grothendieckTopology (TopCat.of M))
            (Opens.grothendieckTopology (TopCat.of Z))).obj OZ :=
        { hom := Functor.whiskerRight (toQuotientVanishingIdealSheaf n Z ≫
            (TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{0}
              (submanifoldInclusion Z)).unit.app (quotientVanishingIdealSheaf n Z)).hom
            (forget₂ CommRingCat RingCat.{0}) }
      haveI : (PresheafOfModules.pushforward.{0} φZ.hom).IsRightAdjoint :=
        Functor.isRightAdjoint_of_leftAdjointObjIsDefined_eq_top
          (PresheafOfModules.pullbackObjIsDefined_eq_top φZ.hom)
      haveI : (SheafOfModules.pushforward.{0} φZ).IsRightAdjoint :=
        (SheafOfModules.PullbackConstruction.adjunction.{0} φZ).isRightAdjoint
      (∀ S : SheafOfModules.{0} OZ, IsCoherentModule S →
        IsCoherentModule ((SheafOfModules.pushforward.{0} φZ).obj S) ∧
        ∀ q : ℤ, IsIso (sheafCohomologyPullback (submanifoldInclusion Z)
            ((TopCat.Sheaf.pushforward AddCommGrpCat.{0} (submanifoldInclusion Z)).obj
              ((SheafOfModules.toSheaf _).obj S)) q ≫
          (sheafCohomology (TopCat.of Z) q).map
            ((TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0}
              (submanifoldInclusion Z)).counit.app ((SheafOfModules.toSheaf _).obj S)))) ∧
      (∀ T : SheafOfModules.{0} (holomorphicRingCatSheaf n M), IsCoherentModule T →
        (∀ (U : Opens (TopCat.of M)) (g : 𝒪[n, M].presheaf.obj (op U)),
          g ∈ vanishingIdeal n Z U → ∀ t : T.val.obj (op U),
            (show (holomorphicRingCatSheaf n M).obj.obj (op U) from g) • t = 0) →
        IsCoherentModule ((SheafOfModules.pullback.{0} φZ).obj T) ∧
          IsIso ((SheafOfModules.pullbackPushforwardAdjunction.{0} φZ).unit.app T))) ∧
    -- (5)
    (∀ (p : ℕ) (R : SheafOfModules.{0} (holomorphicRingCatSheaf n M))
        (i : R ⟶ SheafOfModules.free (Fin p)) [Mono i], IsCoherentModule R →
      ∀ (V : Opens (TopCat.of M)) (F : ℕ → Fin p → 𝒪[n, M].presheaf.obj (op V))
        (f : Fin p → 𝒪[n, M].presheaf.obj (op V)),
        (∀ k, ∃ r : R.val.obj (op V), (i.val.app (op V)).hom r =
          ∑ j, (show (holomorphicRingCatSheaf n M).obj.obj (op V) from F k j) •
            (show (SheafOfModules.free (R := holomorphicRingCatSheaf n M) (Fin p)).val.obj (op V)
              from (SheafOfModules.freeSection j).1 (op V))) →
        (∀ j (K : Set V), IsCompact K →
          TendstoUniformlyOn (fun k (y : V) => F k j y) (fun y => f j y) atTop K) →
        ∃ r : R.val.obj (op V), (i.val.app (op V)).hom r =
          ∑ j, (show (holomorphicRingCatSheaf n M).obj.obj (op V) from f j) •
            (show (SheafOfModules.free (R := holomorphicRingCatSheaf n M) (Fin p)).val.obj (op V)
              from (SheafOfModules.freeSection j).1 (op V))) :=
  ⟨fun f hS hT => ⟨isCoherentModule_kernel f hS hT, isCoherentModule_cokernel f hS.1 hT,
      isCoherentModule_image f hS hT⟩,
    fun i _ hT hS => isCoherentModule_of_mono i hT hS, generation_near_point,
    fun S hS x hx => exists_isZero_over_of_isZero_stalk S hS.1 x hx, exists_local_free_resolution,
    closed_submanifold_package, closure_of_submodule_sections⟩

end MMP.Analytic
