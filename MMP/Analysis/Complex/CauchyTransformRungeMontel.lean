/-!
# Foundations for the MMP and GAGA: section 2.1, part 3

This file collects eight independent foundational results, one per section below; each section
opens with its own docstring giving the mathematics, implementation notes and references.

## Main results

* `MMP.Mori.exists_epi_counit_tensorPow_of_isRelativelyAmple`: for a projective morphism of
  Noetherian schemes and a relatively ample `H`, `f^* f_* (ℱ ⊗ H^{⊗ r}) → ℱ ⊗ H^{⊗ r}` is
  surjective for `r ≫ 0`.
* `MMP.exists_isAffineOpen_smooth_zeroLocus_of_mem_maximalIdeal_notMem_sq`: a local parameter
  at a smooth point cuts out a smooth hypersurface near that point.
* `MMP.Mori.ProperCurve.exists_image_closure_eq_of_surjective`: under a proper surjection
  every proper curve of the target is the image of a proper curve of the source.
* `MMP.Flips.exists_pos_isRelativelyAmple_add_sum_smul`: small real perturbations of a
  relatively ample divisor stay relatively ample.
* `MMP.adicCompletionEquivMvPowerSeries_spec`: the completion at a smooth rational
  point is a power series ring in a system of parameters.
* `MMP.Foundations.isNoetherianRing_strictHenselization_adicCompletion`: completed strict
  henselisations of Noetherian normal local rings.
* `MMP.finiteDimensional_quotient_range_add_of_surjective_of_isCompactOperator`: the
  Banach–Schwartz lemma.
* `MMP.Gaga.cauchyTransform_runge_montel`: the Cauchy transform, Runge's theorem and Montel's
  theorem in one variable.
-/

@[expose] public section

/-!
## Relative global generation of twists by a relatively ample sheaf

Let `f : Y ⟶ X` be a projective morphism of Noetherian schemes, `H` an `f`-ample invertible
sheaf on `Y` and `ℱ` a coherent `𝒪_Y`-module (spelled as quasi-coherent of finite type). Then
there is `r₀` such that for every `r ≥ r₀` the natural map
`f^* f_* (ℱ ⊗ H^{⊗ r}) → ℱ ⊗ H^{⊗ r}`, the counit of the adjunction `f^* ⊣ f_*`, is surjective.

### Implementation notes

A projective morphism is `AlgebraicGeometry.IsProjectiveMorphism`. A coherent sheaf on the
Noetherian scheme `Y` is the same as a quasi-coherent `𝒪_Y`-module of finite type, which is how
the hypothesis on `ℱ` is spelled. Surjectivity of a map of sheaves of modules is expressed as
`Epi`. The tensor product is the monoidal structure
`MMP.Intersection.Scheme.Modules.monoidalCategory` on `Y.Modules` and `H^{⊗ r}` is
`MMP.Intersection.Scheme.Modules.tensorPow H r`.

### References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*, Theorem 1.42]
* [R. Hartshorne, *Algebraic geometry*, Theorem II.7.6]
* [Stacks Project, Tag 01Q3]
-/

section

universe u

open CategoryTheory MonoidalCategory AlgebraicGeometry RingedSpaceModuleAdjunction

namespace MMP.Mori.Internal.NoetherianRelativeCoherentGeneration

open Stacks.Ample in
/-- The tensor power `MMP.Intersection.Scheme.Modules.tensorPow` is Stacks'
`tensorPowModule` in nonnegative degrees. -/
private theorem nonempty_tensorPow_iso (Y : Scheme.{u}) (L : Y.Modules) [IsInvertibleModule Y L]
    (n : ℕ) :
    Nonempty (MMP.Intersection.Scheme.Modules.tensorPow L n ≅ tensorPowModule Y L (n : ℤ)) := by
  induction n with
  | zero =>
    have e : unitModule Y ≅ 𝟙_ Y.Modules := Iso.refl _
    exact ⟨e.symm ≪≫ (tensorPowModuleZeroIso Y L).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    have h1 := tensorPowModuleAddIso Y L (n : ℤ) 1
    have h2 := tensorPowModuleOneIso Y L
    refine ⟨?_⟩
    refine ?_ ≪≫ (eqToIso (by push_cast; rfl) :
      tensorPowModule Y L ((n : ℤ) + 1) ≅ tensorPowModule Y L ((n + 1 : ℕ) : ℤ))
    refine (Iso.refl _ : MMP.Intersection.Scheme.Modules.tensorPow L (n + 1) ≅
      MMP.Intersection.Scheme.Modules.tensorPow L n ⊗ L) ≪≫ ?_ ≪≫ h1
    exact (tensorIso e h2.symm : MMP.Intersection.Scheme.Modules.tensorPow L n ⊗ L ≅
      tensorPowModule Y L n ⊗ tensorPowModule Y L 1)

/-- A map of `𝒪_Z`-modules is an epimorphism as soon as a generating family of sections of its
target lies in the image of the induced map on sections. -/
private theorem epi_of_forall_exists_sectionsMap {Z : Scheme.{u}} {A B : Z.Modules} (φ : A ⟶ B)
    (σ : B.GeneratingSections) (h : ∀ i, ∃ t, SheafOfModules.sectionsMap φ t = σ.s i) :
    Epi φ := by
  choose t ht using h
  have hfac : A.freeHomEquiv.symm t ≫ φ = B.freeHomEquiv.symm σ.s :=
    (SheafOfModules.freeHomEquiv_symm_comp t φ).trans (congrArg _ (funext ht))
  have : Epi (A.freeHomEquiv.symm t ≫ φ) := hfac ▸ σ.epi
  exact epi_of_epi (A.freeHomEquiv.symm t) φ

/-- Every section over `f⁻¹(V)` of an `𝒪_Y`-module `G` lies in the image of the restriction of
the counit `f^* f_* G ⟶ G` to `f⁻¹(V)`. -/
private theorem exists_sectionsMap_restrict_counit {X Y : Scheme.{u}} (f : Y ⟶ X) (V : X.Opens)
    (G : Y.Modules) (s : ((Scheme.Modules.restrictFunctor (f ⁻¹ᵁ V).ι).obj G).sections) :
    ∃ t, SheafOfModules.sectionsMap ((Scheme.Modules.restrictFunctor (f ⁻¹ᵁ V).ι).map
      ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app G)) t = s := by
  set adj := Scheme.Modules.pullbackPushforwardAdjunction f
  let x : Γ(G, f ⁻¹ᵁ V) :=
    G.presheaf.map (eqToHom (f ⁻¹ᵁ V).ι_image_top.symm).op (s.1 (Opposite.op ⊤))
  let y : Γ((Scheme.Modules.pullback f).obj ((Scheme.Modules.pushforward f).obj G), f ⁻¹ᵁ V) :=
    (adj.unit.app ((Scheme.Modules.pushforward f).obj G)).app V x
  have hy : (adj.counit.app G).app (f ⁻¹ᵁ V) y = x :=
    congrArg (fun φ => (Scheme.Modules.Hom.app φ V).hom x) (adj.right_triangle_components G)
  let P := (Scheme.Modules.pullback f).obj ((Scheme.Modules.pushforward f).obj G)
  have hle : ∀ U : (f ⁻¹ᵁ V).toScheme.Opens, (f ⁻¹ᵁ V).ι ''ᵁ U ≤ f ⁻¹ᵁ V :=
    (f ⁻¹ᵁ V).ι_image_le
  refine ⟨⟨fun U => P.presheaf.map (homOfLE (hle U.unop)).op y, fun {U U'} g => ?_⟩, ?_⟩
  · exact (ConcreteCategory.congr_hom (P.presheaf.map_comp (homOfLE (hle U.unop)).op
      ((Scheme.Hom.opensFunctor (f ⁻¹ᵁ V).ι).map g.unop).op) y).symm
  · apply Subtype.ext
    funext U
    have e1 := ConcreteCategory.congr_hom
      ((adj.counit.app G).mapPresheaf.naturality (homOfLE (hle U.unop)).op) y
    refine e1.trans ?_
    rw [ConcreteCategory.comp_apply]
    erw [hy, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
      ← s.2 (homOfLE le_top : U.unop ⟶ ⊤).op]
    rfl

open Stacks.Ample Stacks.RelativeVeryAmple in
/-- The restriction of `ℱ ⊗ H^{⊗ r}` to an open `U` is `ℱ|_U ⊗ (H|_U)^{⊗ r}`, with the tensor power
of Stacks' `tensorPowModule` and `H|_U` the ringed-space pullback in which ampleness is stated. -/
private theorem nonempty_restrict_tensor_tensorPow_iso {Y : Scheme.{u}} (U : Y.Opens)
    (F H : Y.Modules) [IsInvertibleModule Y H] (r : ℕ) :
    Nonempty ((Scheme.Modules.restrictFunctor U.ι).obj
        (F ⊗ MMP.Intersection.Scheme.Modules.tensorPow H r) ≅
      tensorModules U ((Scheme.Modules.pullback U.ι).obj F)
        (tensorPowModule U ((modulePullback U.ι.toLRSHom.toShHom).obj H) (r : ℤ))) := by
  obtain ⟨e⟩ := nonempty_tensorPow_iso Y H r
  let p : Scheme.Modules.pullback U.ι ≅ modulePullback U.ι.toLRSHom.toShHom :=
    (Scheme.Modules.pullbackPushforwardAdjunction U.ι).leftAdjointUniq
      (modulePullbackPushforwardAdjunction U.ι.toLRSHom.toShHom)
  exact ⟨(Scheme.Modules.restrictFunctorIsoPullback U.ι).app _ ≪≫ p.app _ ≪≫
    (modulePullback U.ι.toLRSHom.toShHom).mapIso (tensorModulesMapIso Y (Iso.refl F) e) ≪≫
    pullbackTensorModulesIso U.ι F (tensorPowModule Y H (r : ℤ)) ≪≫
    tensorModulesMapIso U (p.app F).symm (pullbackTensorPowModuleIso U.ι H r)⟩

end MMP.Mori.Internal.NoetherianRelativeCoherentGeneration

namespace MMP.Mori

open MMP.Mori.Internal.NoetherianRelativeCoherentGeneration in
/-- **Relative global generation.** Let `f : Y ⟶ X` be a projective morphism of Noetherian
schemes, `H` an invertible `𝒪_Y`-module that is `f`-ample, and `ℱ` a coherent (quasi-coherent,
finite type) `𝒪_Y`-module. Then there is `r₀` such that for all `r ≥ r₀` the counit
`f^* f_* (ℱ ⊗ H^{⊗ r}) ⟶ ℱ ⊗ H^{⊗ r}` of the adjunction `f^* ⊣ f_*` is an epimorphism. -/
@[mmp "lem_mmp_foundation_noetherian_relative_coherent_generation"]
public theorem exists_epi_counit_tensorPow_of_isRelativelyAmple {X Y : Scheme.{u}}
    (f : Y ⟶ X) (hf : IsProjectiveMorphism f) [IsNoetherian X] [IsNoetherian Y]
    (H : Y.Modules) [Stacks.Ample.IsInvertibleModule Y H]
    (hH : IsRelativelyAmple f H) (F : Y.Modules) [F.IsQuasicoherent]
    [SheafOfModules.IsFiniteType.{u, u, u} F] :
    ∃ r₀ : ℕ, ∀ r : ℕ, r₀ ≤ r →
      Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app
        (F ⊗ MMP.Intersection.Scheme.Modules.tensorPow H r)) := by
  choose V _ hxV hamp using hH
  have key := fun x =>
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ (hamp x)).2 ((Scheme.Modules.pullback (f ⁻¹ᵁ V x).ι).obj F) inferInstance
      inferInstance
  choose n₀ hn₀ using key
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (V x : Set X))
    (fun x => (V x).isOpen) (fun x _ => Set.mem_iUnion.2 ⟨x, hxV x⟩)
  refine ⟨t.sup fun x => (n₀ x).toNat, fun r hr => ?_⟩
  refine Stacks.Descent.epi_of_restrictFunctor_map_epi_opens (U := fun i : t => f ⁻¹ᵁ V i)
    ?_ _ fun i => ?_
  · refine eq_top_iff.2 fun y _ => ?_
    obtain ⟨x, hx, hy⟩ := Set.mem_iUnion₂.1 (ht (Set.mem_univ (f y)))
    exact TopologicalSpace.Opens.mem_iSup.2 ⟨⟨x, hx⟩, hy⟩
  · have hle : n₀ i ≤ (r : ℤ) := by
      have := Finset.le_sup (f := fun x => (n₀ x).toNat) i.2
      omega
    obtain ⟨σ, -⟩ := hn₀ i r hle
    obtain ⟨e⟩ := nonempty_restrict_tensor_tensorPow_iso (f ⁻¹ᵁ V i) F H r
    let c := (Stacks.SheafInternalHom.tensorLeftIso _
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf (f ⁻¹ᵁ V i))
      ((Scheme.Modules.pullback (f ⁻¹ᵁ V i).ι).obj F)).app
        (Stacks.Ample.tensorPowModule (f ⁻¹ᵁ V i)
          ((modulePullback (f ⁻¹ᵁ V i).ι.toLRSHom.toShHom).obj H) r)
    exact epi_of_forall_exists_sectionsMap _
      (SheafOfModules.GeneratingSections.equivOfIso (c ≪≫ e.symm) σ)
      fun _ => exists_sectionsMap_restrict_counit f (V i) _ _

end MMP.Mori

end

/-!
## A parameter cuts out a smooth hypersurface

Let `X` be a smooth scheme over a perfect field `k` (for instance a field of characteristic
zero), `x ∈ X` a point and `f ∈ 𝒪_{X,x}` an element of `𝔪_x \ 𝔪_x²`. Then `f` is the germ of a
section `g` on an affine open neighbourhood `V` of `x` such that `g` is a nonzerodivisor on `V`,
the closed subscheme `(g = 0) ⊆ V` is smooth over `k`, and `(g = 0)` has pure codimension one
in `V`: every prime of `Γ(X, V)` minimal over `(g)` has height one.

### Main results

* `MMP.exists_isAffineOpen_smooth_zeroLocus_of_mem_maximalIdeal_notMem_sq`.

### Implementation notes

The neighbourhood is taken affine, so that the hypersurface is the spectrum of
`Γ(X, V) ⧸ (g)`, embedded in `X` through `V ≅ Spec Γ(X, V)`; any open neighbourhood contains
such a `V`. Regularity of `g` on the affine `V` is that `g` is a nonzerodivisor of `Γ(X, V)`,
equivalently of every stalk at points of `V`. The base field is only required to be perfect,
which includes characteristic zero; over an imperfect field the statement fails
(`k = 𝔽_p(a)`, `X = 𝔸¹_k`, `f = t^p - a`). Finite type is replaced by smoothness of the
structure morphism, which already includes local finite presentation.

### References

* [J. Kollár, *Lectures on resolution of singularities*, §3]
-/

section

universe u

open CategoryTheory AlgebraicGeometry IsLocalRing

namespace MMP.Internal.ParameterHypersurfaceSmooth

/-- Smoothness of a hypersurface quotient near a prime where its localization is regular. -/
private theorem smooth_part {k A : Type u} [Field k] [PerfectField k] [CommRing A] [Algebra k A]
    [Algebra.FiniteType k A] (p : Ideal A) [p.IsPrime] (g₀ : A) (hg : g₀ ∈ p)
    (hreg : IsRegularLocalRing
      (Localization.AtPrime p ⧸ (Ideal.span {g₀}).map (algebraMap A (Localization.AtPrime p)))) :
    ∃ t ∉ p, ∀ s : A, t ∣ s →
      Algebra.Smooth k (Localization.Away (Ideal.Quotient.mk (Ideal.span {g₀}) s)) := by
  set I := Ideal.span {g₀}
  have hIp : I ≤ p := (Ideal.span_singleton_le_iff_mem p).mpr hg
  have hpq : ∀ r : A, Ideal.Quotient.mk I r ∈ p.map (Ideal.Quotient.mk I) ↔ r ∈ p := by
    intro r
    rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective]
    constructor
    · rintro ⟨a, ha, he⟩
      rw [Ideal.Quotient.eq] at he
      simpa using p.sub_mem ha (hIp he)
    · exact fun h => ⟨r, h, rfl⟩
  have hqp : (p.map (Ideal.Quotient.mk I)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by simpa using hIp)
  have := Stacks.isLocalization_quotient_atPrime_of_mem_iff g₀ hpq
  have := Algebra.isSeparableExtension_of_perfectField k (p.map (Ideal.Quotient.mk I)).ResidueField
  have hsm : Algebra.IsSmoothAt k (p.map (Ideal.Quotient.mk I)) :=
    (Algebra.isSmoothAt_iff_isRegularLocalRing (k := k) _
      (Localization.AtPrime p ⧸ (Ideal.span {g₀}).map (algebraMap A (Localization.AtPrime p)))).mpr
      hreg
  have : Algebra.FinitePresentation k (A ⧸ I) :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  obtain ⟨t', ht', hsmt⟩ := Algebra.IsSmoothAt.exists_notMem_smooth k (p.map (Ideal.Quotient.mk I))
  obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective t'
  refine ⟨t, fun h => ht' ((hpq t).mpr h), fun s hts => ?_⟩
  have h1 := Algebra.basicOpen_subset_smoothLocus_iff_smooth.mpr hsmt
  refine Algebra.basicOpen_subset_smoothLocus_iff_smooth.mp (subset_trans ?_ h1)
  intro P hP
  simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hP ⊢
  exact fun h => hP (P.asIdeal.mem_of_dvd (map_dvd _ hts) h)

/-- If `A_𝔭` is a domain and `g₀` is nonzero in it, the annihilator of `g₀` is killed by some
`s₁ ∉ 𝔭`. -/
private theorem exists_notMem_mul_eq_zero {A : Type u} [CommRing A] [IsNoetherianRing A]
    (p : Ideal A) [p.IsPrime] [IsDomain (Localization.AtPrime p)] (g₀ : A)
    (hne : algebraMap A (Localization.AtPrime p) g₀ ≠ 0) :
    ∃ s₁ ∉ p, ∀ c : A, c * g₀ = 0 → s₁ * c = 0 := by
  let K : Submodule A A := LinearMap.ker (LinearMap.mulLeft A g₀)
  have hsub : Subsingleton (LocalizedModule p.primeCompl K) := by
    rw [LocalizedModule.subsingleton_iff]
    rintro ⟨c, hc⟩
    have h0 : algebraMap A (Localization.AtPrime p) c = 0 :=
      (mul_eq_zero.mp (by rw [← map_mul, show g₀ * c = 0 from hc, map_zero])).resolve_left hne
    obtain ⟨⟨m, hm⟩, hmc⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ c).mp h0
    exact ⟨m, hm, Subtype.ext hmc⟩
  have hns : (⟨p, inferInstance⟩ : PrimeSpectrum A) ∉ Module.support A K :=
    Module.notMem_support_iff.mpr hsub
  rw [Module.mem_support_iff_of_finite, SetLike.not_le_iff_exists] at hns
  obtain ⟨s₁, hs₁, hs₁p⟩ := hns
  refine ⟨s₁, hs₁p, fun c hc => ?_⟩
  exact congrArg Subtype.val
    (Module.mem_annihilator.mp hs₁ ⟨c, show g₀ * c = 0 by rwa [mul_comm]⟩)

/-- After inverting a multiple of `s₁`, where `s₁` kills the annihilator of `g₀`, the image of
`g₀` is a nonzerodivisor. -/
private theorem mem_nonZeroDivisors_algebraMap {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B]
    (s s₁ g₀ : A) [IsLocalization.Away s B] (hs : s₁ ∣ s)
    (h : ∀ c : A, c * g₀ = 0 → s₁ * c = 0) : algebraMap A B g₀ ∈ nonZeroDivisors B := by
  rw [mem_nonZeroDivisors_iff_right]
  intro b hb
  obtain ⟨⟨c, ⟨m, hm⟩⟩, hbc⟩ := IsLocalization.surj (Submonoid.powers s) b
  simp only at hbc
  have hb' : algebraMap A B (c * g₀) = 0 := by
    rw [map_mul, ← hbc, mul_right_comm, hb, zero_mul]
  obtain ⟨⟨n, hn⟩, hnc⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers s) B _).mp hb'
  have h2 : s₁ * (n * c) = 0 := h _ (by rw [mul_assoc]; exact hnc)
  have hs1u : IsUnit (algebraMap A B s₁) := by
    obtain ⟨d, rfl⟩ := hs
    exact isUnit_of_mul_isUnit_left (y := algebraMap A B d)
      (map_mul (algebraMap A B) s₁ d ▸ IsLocalization.Away.algebraMap_isUnit (s₁ * d))
  have hnu : IsUnit (algebraMap A B n) := IsLocalization.map_units B ⟨n, hn⟩
  have hmu : IsUnit (algebraMap A B m) := IsLocalization.map_units B ⟨m, hm⟩
  have hc0 : algebraMap A B c = 0 := by
    have h3 := congrArg (algebraMap A B) h2
    rw [map_mul, map_mul, map_zero] at h3
    exact (hnu.mul_right_eq_zero).mp ((hs1u.mul_right_eq_zero).mp h3)
  rw [hc0] at hbc
  exact (hmu.mul_left_eq_zero).mp hbc

/-- Krull: every minimal prime over a nonzerodivisor of a Noetherian ring has height one. -/
private theorem height_eq_one {B : Type u} [CommRing B] [IsNoetherianRing B] (g : B)
    (hg : g ∈ nonZeroDivisors B) : ∀ P ∈ (Ideal.span {g}).minimalPrimes, P.height = 1 :=
  fun P hP =>
    have : P.IsPrime := hP.1.1
    le_antisymm (Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ P hP)
      ((Ideal.one_le_height_span_singleton_of_mem_nonZeroDivisors hg).trans
        (Ideal.height_mono hP.1.2))

/-- Smoothness of `(A ⧸ (g₀))[1/s]` transports to `B ⧸ (g₀)` for `B = A[1/s]`. -/
private theorem smooth_quotient_of_away {k A B : Type u} [Field k] [CommRing A] [Algebra k A]
    [CommRing B] [Algebra A B] [Algebra k B] [IsScalarTower k A B] (s g₀ : A)
    [IsLocalization.Away s B]
    (h : Algebra.Smooth k (Localization.Away (Ideal.Quotient.mk (Ideal.span {g₀}) s))) :
    Algebra.Smooth k (B ⧸ Ideal.span {algebraMap A B g₀}) := by
  set I := Ideal.span {g₀}
  have hJ : Ideal.span {algebraMap A B g₀} = I.map (algebraMap A B) := by
    simp [I, Ideal.map_span]
  rw [hJ]
  have hloc : IsLocalization (Algebra.algebraMapSubmonoid (A ⧸ I) (Submonoid.powers s))
      (B ⧸ I.map (algebraMap A B)) := inferInstance
  have : IsLocalization.Away (Ideal.Quotient.mk I s) (B ⧸ I.map (algebraMap A B)) := by
    rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers] at hloc
    exact hloc
  have : IsScalarTower k (A ⧸ I) (B ⧸ I.map (algebraMap A B)) := by
    refine IsScalarTower.of_algebraMap_eq fun x => ?_
    show Ideal.Quotient.mk _ (algebraMap k B x) = _
    rw [IsScalarTower.algebraMap_apply k A B]
    rfl
  have : Algebra.Smooth k (Localization.Away (Ideal.Quotient.mk I s)) := h
  exact Algebra.Smooth.of_equiv
    ((IsLocalization.algEquiv (Submonoid.powers (Ideal.Quotient.mk I s))
      (Localization.Away (Ideal.Quotient.mk I s)) (B ⧸ I.map (algebraMap A B))).restrictScalars k)

/-- Membership in the square of the maximal ideal is reflected by ring isomorphisms. -/
private theorem mem_sq_of_ringEquiv {R S : Type u} [CommRing R] [IsLocalRing R] [CommRing S]
    [IsLocalRing S] (e : R ≃+* S) {r : R} (h : e r ∈ maximalIdeal S ^ 2) :
    r ∈ maximalIdeal R ^ 2 := by
  have := Ideal.mem_map_of_mem e.symm h
  rwa [Ideal.map_pow, IsLocalRing.map_ringEquiv_maximalIdeal, e.symm_apply_apply] at this

end MMP.Internal.ParameterHypersurfaceSmooth

namespace MMP

open MMP.Internal.ParameterHypersurfaceSmooth in
/-- **A parameter cuts out a smooth hypersurface.** If `X` is smooth over a perfect field `k` and
`f ∈ 𝔪_x \ 𝔪_x²` in the local ring at `x`, then on some affine open `V ∋ x` the element `f` is
the germ of a nonzerodivisor `g ∈ Γ(X, V)` whose zero scheme `Spec (Γ(X, V) ⧸ (g))` is smooth
over `k` and has pure codimension one in `V`. -/
@[mmp "lem_mmp_foundation_parameter_hypersurface_smooth"]
public theorem exists_isAffineOpen_smooth_zeroLocus_of_mem_maximalIdeal_notMem_sq
    {k : Type u} [Field k] [PerfectField k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
    [Smooth sX] (x : X) (f : X.presheaf.stalk x)
    (hf : f ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
    (hf2 : f ∉ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 2) :
    ∃ (V : X.affineOpens) (hxV : x ∈ V.1) (g : Γ(X, V.1)),
      X.presheaf.germ V.1 x hxV g = f ∧
      g ∈ nonZeroDivisors Γ(X, V.1) ∧
      Smooth (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {g}))) ≫
        V.2.isoSpec.inv ≫ V.1.ι ≫ sX) ∧
      ∀ p ∈ (Ideal.span {g}).minimalPrimes, p.height = 1 := by
  obtain ⟨U₀, hxU₀, f₀, hf₀⟩ := X.presheaf.germ_exist f
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUU₀⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxU₀ U₀.2
  replace hU : IsAffineOpen U := hU
  set g₀ : Γ(X, U) := X.presheaf.map (homOfLE hUU₀).op f₀
  have hg₀ : X.presheaf.germ U x hxU g₀ = f :=
    (X.presheaf.germ_res_apply (homOfLE hUU₀) x hxU f₀).trans hf₀
  let φ : CommRingCat.of k ⟶ Γ(X, U) := Spec.preimage (hU.fromSpec ≫ sX)
  letI : Algebra k Γ(X, U) := φ.hom.toAlgebra
  have hφ : Spec.map φ = hU.fromSpec ≫ sX := Spec.map_preimage _
  have : Algebra.FiniteType k Γ(X, U) := by
    have : LocallyOfFinitePresentation (Spec.map φ) := by
      rw [hφ]
      infer_instance
    have : Algebra.FinitePresentation k Γ(X, U) :=
      HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation).mp this
    infer_instance
  set p := (hU.primeIdealOf ⟨x, hxU⟩).asIdeal
  letI := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x) p := hU.isLocalization_stalk ⟨x, hxU⟩
  have hregS : IsRegularLocalRing (X.presheaf.stalk x) :=
    ((MMP.mem_smoothLocus_iff_isRegularLocalRing_of_perfectField sX).1 x).mp
      (by rw [sX.smoothLocus_eq_top]; trivial)
  let e : X.presheaf.stalk x ≃ₐ[Γ(X, U)] Localization.AtPrime p :=
    IsLocalization.algEquiv p.primeCompl _ _
  have hreg : IsRegularLocalRing (Localization.AtPrime p) := .of_ringEquiv e.toRingEquiv
  have he : e f = algebraMap Γ(X, U) (Localization.AtPrime p) g₀ := by
    rw [← hg₀]; exact e.commutes g₀
  have hm : algebraMap Γ(X, U) (Localization.AtPrime p) g₀ ∈
      maximalIdeal (Localization.AtPrime p) := by
    rw [← he]
    simp only [mem_maximalIdeal, mem_nonunits_iff] at hf ⊢
    exact (isUnit_map_iff e f).not.mpr hf
  have hm2 : algebraMap Γ(X, U) (Localization.AtPrime p) g₀ ∉
      maximalIdeal (Localization.AtPrime p) ^ 2 := by
    rw [← he]
    exact fun h => hf2 (mem_sq_of_ringEquiv e.toRingEquiv h)
  have hg₀p : g₀ ∈ p := (IsLocalization.AtPrime.to_map_mem_maximal_iff _ p g₀).mp hm
  have hQ : IsRegularLocalRing (Localization.AtPrime p ⧸
      (Ideal.span {g₀}).map (algebraMap Γ(X, U) (Localization.AtPrime p))) := by
    rw [Ideal.map_span, Set.image_singleton]
    exact Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton hm hm2
  obtain ⟨t, htp, ht⟩ := smooth_part (k := k) p g₀ hg₀p hQ
  have : IsDomain (Localization.AtPrime p) := IsRegularLocalRing.isDomain _
  have : IsNoetherianRing Γ(X, U) := Algebra.FiniteType.isNoetherianRing k Γ(X, U)
  obtain ⟨s₁, hs₁p, hs₁⟩ := exists_notMem_mul_eq_zero p g₀ (fun h => hm2 (h ▸ Submodule.zero_mem _))
  set s := s₁ * t
  have hsp : s ∉ p := fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hs₁p htp
  have hxV : x ∈ X.basicOpen s := by
    rw [Scheme.mem_basicOpen _ _ _ hxU]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff _ p s).mpr hsp
  have hVU : X.basicOpen s ≤ U := X.basicOpen_le s
  have : IsLocalization.Away s Γ(X, X.basicOpen s) := hU.isLocalization_basicOpen s
  letI : Algebra k Γ(X, X.basicOpen s) :=
    (φ ≫ X.presheaf.map (homOfLE hVU).op).hom.toAlgebra
  have : IsScalarTower k Γ(X, U) Γ(X, X.basicOpen s) := IsScalarTower.of_algebraMap_eq' rfl
  have hnzd : algebraMap Γ(X, U) Γ(X, X.basicOpen s) g₀ ∈ nonZeroDivisors Γ(X, X.basicOpen s) :=
    mem_nonZeroDivisors_algebraMap (B := Γ(X, X.basicOpen s)) s s₁ g₀ (dvd_mul_right s₁ t) hs₁
  have : IsNoetherianRing Γ(X, X.basicOpen s) :=
    IsLocalization.isNoetherianRing (Submonoid.powers s) _ inferInstance
  refine ⟨⟨X.basicOpen s, hU.basicOpen s⟩, hxV, algebraMap Γ(X, U) Γ(X, X.basicOpen s) g₀,
    ?_, hnzd, ?_, height_eq_one _ hnzd⟩
  · change X.presheaf.germ _ x hxV (X.presheaf.map (homOfLE hVU).op g₀) = f
    rw [TopCat.Presheaf.germ_res_apply]; exact hg₀
  · have hsm := smooth_quotient_of_away (k := k) (B := Γ(X, X.basicOpen s)) s g₀
      (ht s (dvd_mul_left t s₁))
    change Smooth (Spec.map _ ≫ (hU.basicOpen s).isoSpec.inv ≫ (X.basicOpen s).ι ≫ sX)
    rw [← Category.assoc (hU.basicOpen s).isoSpec.inv, IsAffineOpen.isoSpec_inv_ι,
      ← hU.map_fromSpec (hU.basicOpen s) (homOfLE hVU).op, Category.assoc, ← hφ,
      ← Spec.map_comp, ← Spec.map_comp, HasRingHomProperty.Spec_iff (P := @Smooth)]
    rwa [← RingHom.smooth_algebraMap] at hsm

end MMP

end

/-!
## Proper surjections lift proper curves

Let `u : V ⟶ W` be a surjective proper morphism of varieties over a field `k`. Every proper
curve `C' ⊆ W` is the image of a proper curve `C ⊆ V`: the closure of a closed point of the
generic fibre `V_η` over the generic point `η` of `C'` is such a curve, since its function field
is finite over `κ(η)`.

### Main results

* `MMP.Mori.ProperCurve.exists_image_closure_eq_of_surjective`: for `u` proper and surjective
  over `k`, every `C' : MMP.Mori.ProperCurve sW` has a `C : MMP.Mori.ProperCurve sV` with
  `u '' {C}⁻ = {C'}⁻`.

### Implementation notes

A proper curve is recorded, as in `MMP.Mori.ProperCurve`, by its generic point; the curve as a
subset is the closure of that point, and `u(C) = C'` is the equality of the set-theoretic image of
the closure of the generic point of `C` with the closure of the generic point of `C'`.
-/

section

universe u

open CategoryTheory AlgebraicGeometry Topology TopologicalSpace
open MMP.Mori

namespace MMP.Mori.Internal.ProperSurjectionCurveLift

/-- The reduced closure of a point is homeomorphic to the closure as a subspace, so the two
have the same dimension. -/
private theorem topologicalKrullDim_curveSubschemeAt {X : Scheme} (x : X) :
    topologicalKrullDim (curveSubschemeAt x) = topologicalKrullDim (closure ({x} : Set X)) := by
  have hmem (t) : curveSubschemeAtι x t ∈ closure ({x} : Set X) :=
    range_curveSubschemeAtι x ▸ ⟨t, rfl⟩
  refine IsHomeomorph.topologicalKrullDim_eq (Set.codRestrict _ _ hmem) <|
    isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨(curveSubschemeAtι x).isClosedEmbedding.isEmbedding.codRestrict _ hmem, ?_⟩
  rintro ⟨y, hy⟩
  obtain ⟨t, rfl⟩ := (range_curveSubschemeAtι x).symm ▸ hy
  exact ⟨t, rfl⟩

/-- The image of `{v}⁻` under any morphism `u` has closure `{u v}⁻`. -/
private theorem closure_range_curveSubschemeAtι_comp {V W : Scheme} (u : V ⟶ W) (v : V) :
    closure (Set.range (curveSubschemeAtι v ≫ u)) = closure {u v} := by
  have : Set.range (curveSubschemeAtι v ≫ u) = u '' Set.range (curveSubschemeAtι v) := by
    rw [← Set.range_comp]; rfl
  rw [this, range_curveSubschemeAtι, closure_image_closure u.continuous, Set.image_singleton]

/-- A nonempty space with at most one point has dimension zero. -/
private theorem topologicalKrullDim_eq_zero_of_subsingleton (T : Type*) [TopologicalSpace T]
    [Nonempty T] [Subsingleton T] : topologicalKrullDim T = 0 := by
  refine le_antisymm (topologicalKrullDim_zero_of_discreteTopology T) ?_
  obtain ⟨x⟩ := ‹Nonempty T›
  have : Nonempty (IrreducibleCloseds T) :=
    ⟨⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
  exact Order.krullDim_nonneg

/-- Over every point `η` of its image, a quasi-compact morphism has a point `v` closed in the
fibre: the fibre is quasi-compact, so it has a closed point. -/
private theorem exists_eq_of_specializes_of_mem_fiber {V W : Scheme} (u : V ⟶ W)
    [QuasiCompact u] {η : W} (hη : η ∈ Set.range u) :
    ∃ v, u v = η ∧ ∀ w, v ⤳ w → u w = u v → w = v := by
  have : CompactSpace (u ⁻¹' {η}) := (u.fiberHomeo η).compactSpace
  obtain ⟨x, hx⟩ := hη
  obtain ⟨p, -, hp⟩ := IsClosed.exists_closed_singleton (X := u ⁻¹' {η}) isClosed_univ
    ⟨⟨x, hx⟩, trivial⟩
  refine ⟨p.1, p.2, fun w hvw hw => congrArg Subtype.val
    (?_ : (⟨w, hw.trans p.2⟩ : u ⁻¹' {η}) = p)⟩
  have := specializes_iff_mem_closure.mp
    (IsInducing.subtypeVal.specializes_iff.mp hvw : p ⤳ ⟨w, hw.trans p.2⟩)
  rwa [hp.closure_eq] at this

/-- **Dimension of a lift.** Let `u : V ⟶ W` be a morphism of `k`-schemes locally of finite type
and `v ∈ V` a point closed in its fibre. Then `{v}⁻` and `{u v}⁻` have the same dimension: the
fibre of `{v}⁻ ⟶ W` over `u v` is the single point `v`, so the generic-fibre dimension formula
`MMP.Flips.topologicalKrullDim_eq_fiber_add_closure_range` gives `dim {v}⁻ = 0 + dim {u v}⁻`. -/
private theorem topologicalKrullDim_curveSubschemeAt_eq (k : Type u) [Field k]
    {V W : Scheme.{u}} (u : V ⟶ W) (sV : V ⟶ Spec (.of k)) (sW : W ⟶ Spec (.of k))
    (hu : u ≫ sW = sV) [LocallyOfFiniteType sV] [LocallyOfFiniteType sW] {v : V}
    (hv : ∀ w, v ⤳ w → u w = u v → w = v) :
    topologicalKrullDim (curveSubschemeAt v) = topologicalKrullDim (curveSubschemeAt (u v)) := by
  set ι := curveSubschemeAtι v
  have : IsIntegral (curveSubschemeAt v) :=
    Scheme.IdealSheafData.isIntegral_subscheme_vanishingIdeal_closure v
  have hgen : ι (genericPoint _) = v :=
    Scheme.IdealSheafData.subschemeι_genericPoint_vanishingIdeal_closure v
  rw [MMP.Flips.topologicalKrullDim_eq_fiber_add_closure_range (ι ≫ u) k (ι ≫ sV) sW
    (by rw [Category.assoc, hu]), closure_range_curveSubschemeAtι_comp,
    topologicalKrullDim_curveSubschemeAt]
  have hfib : (ι ≫ u) ⁻¹' {(ι ≫ u) (genericPoint _)} ⊆ {genericPoint _} := fun c hc =>
    ι.isClosedEmbedding.injective <| (hv _
      (by have := (genericPoint_specializes c).map ι.continuous; rwa [hgen] at this)
      ((hc : u (ι c) = u (ι (genericPoint _))).trans (congrArg u hgen))).trans hgen.symm
  have e := (ι ≫ u).fiberHomeo ((ι ≫ u) (genericPoint _))
  have := (Set.subsingleton_singleton.anti hfib).coe_sort
  have : Subsingleton ((ι ≫ u).fiber ((ι ≫ u) (genericPoint _))) := e.injective.subsingleton
  have : Nonempty ((ι ≫ u).fiber ((ι ≫ u) (genericPoint _))) := ⟨e.symm ⟨genericPoint _, rfl⟩⟩
  rw [topologicalKrullDim_eq_zero_of_subsingleton, zero_add]

/-- **Properness of a lift.** For `u : V ⟶ W` proper over `S` and `v ∈ V`, if `{u v}⁻` is proper
over `S` then so is `{v}⁻`: `{v}⁻ ⟶ W` is proper and factors through its scheme-theoretic image,
which is `{u v}⁻`. -/
private theorem isProper_curveSubschemeAtι_comp {S V W : Scheme.{u}} (u : V ⟶ W) (sV : V ⟶ S)
    (sW : W ⟶ S) (hu : u ≫ sW = sV) [IsProper u] (v : V)
    [IsProper (curveSubschemeAtι (u v) ≫ sW)] : IsProper (curveSubschemeAtι v ≫ sV) := by
  set φ := curveSubschemeAtι v ≫ u
  have hker : φ.ker = Scheme.IdealSheafData.vanishingIdeal (Closeds.closure {u v}) := by
    rw [Scheme.Hom.ker_eq_vanishingIdeal_closure_range]
    exact congrArg _ (Closeds.ext (by
      rw [Closeds.coe_closure, Closeds.coe_closure, closure_range_curveSubschemeAtι_comp]))
  have : IsProper (φ.toImage ≫ φ.imageι) := by rw [Scheme.Hom.toImage_imageι]; infer_instance
  have : IsProper φ.toImage := IsProper.of_comp _ φ.imageι
  have : IsProper (φ.imageι ≫ sW) := by
    change IsProper (φ.ker.subschemeι ≫ sW)
    rwa [hker]
  rw [← hu, ← Category.assoc]
  change IsProper (φ ≫ sW)
  rw [← φ.toImage_imageι, Category.assoc]
  infer_instance

end MMP.Mori.Internal.ProperSurjectionCurveLift

namespace MMP.Mori

open MMP.Mori.Internal.ProperSurjectionCurveLift in
/-- A surjective proper morphism `u : V ⟶ W` of varieties over `k` lifts every proper curve
`C' ⊆ W` to a proper curve `C ⊆ V` with `u(C) = C'`. -/
@[mmp "lem_mmp_foundation_proper_surjection_curve_lift"]
public theorem ProperCurve.exists_image_closure_eq_of_surjective {k : Type u} [Field k]
    {V W : Scheme.{u}} {sV : V ⟶ Spec (.of k)} {sW : W ⟶ Spec (.of k)}
    (hV : IsVariety k sV) (hW : IsVariety k sW) (u : V ⟶ W) (hu : u ≫ sW = sV)
    [IsProper u] [Surjective u] (C' : ProperCurve sW) :
    ∃ C : ProperCurve sV, u '' closure {C.point} = closure {C'.point} := by
  have : LocallyOfFiniteType sV := hV.toLocallyOfFiniteType
  have : LocallyOfFiniteType sW := hW.toLocallyOfFiniteType
  obtain ⟨η, hη⟩ := C'
  obtain ⟨v, rfl, hv⟩ := exists_eq_of_specializes_of_mem_fiber u (u.surjective η)
  have := hη.isProper
  refine ⟨⟨v, (topologicalKrullDim_curveSubschemeAt_eq k u sV sW hu hv).trans hη.dim_eq,
    isProper_curveSubschemeAtι_comp u sV sW hu v⟩, ?_⟩
  change u '' closure {v} = closure {u v}
  rw [← Set.image_singleton, u.isClosedMap.closure_image_eq_of_continuous u.continuous]

end MMP.Mori

end

/-!
## Relative ampleness of `ℝ`-Cartier divisors is open in finitely many directions

Let `g : Y ⟶ Z` be a proper morphism of normal varieties over a field `k`, let `A` be a
`g`-ample `ℝ`-Cartier divisor on `Y` and let `B_i` (`i ∈ ι`, `ι` finite) be `ℝ`-Cartier divisors
on `Y`. Then there is `δ > 0` such that `A + ∑ i, t_i B_i` is `g`-ample whenever `|t_i| < δ` for
every `i`. Writing `A = ∑ a_j H_j` with `a_j > 0` and `H_j` `g`-ample Cartier, and expanding the
`B_i` in finitely many Cartier divisors `F_l`, one chooses `m` with every `m H_1 ± F_l` `g`-ample;
then a small perturbation of `a_1 H_1` by the `F_l` is again a positive combination of `g`-ample
Cartier divisors.

### Main results

* `MMP.Flips.exists_pos_isRelativelyAmple_add_sum_smul`: the openness statement above, for
  `MMP.Flips.IsRelativelyAmple`.

### Implementation notes

The finite family `B_1, …, B_k` is indexed by an arbitrary finite type `ι`. That the `B_i` are
`ℝ`-Cartier is `MMP.Flips.IsCartierCombination`; that `A` is `ℝ`-Cartier is part of
`MMP.Flips.IsRelativelyAmple`. The instances `IsLocallyNoetherian Y`, `IsNormal Y` and
`CompactSpace Y` are those under which `MMP.Flips.IsRelativelyAmple` is defined; they follow from
`Y` being a normal variety.

### References

* [J. Kollár et al., *Flips and abundance for algebraic threefolds*][KollarFlips], 2.13.4
-/

section

universe u

open AlgebraicGeometry CategoryTheory
open Stacks.Ample Stacks.RelativeVeryAmple
open MMP.Mori MMP.Flips

namespace MMP.Flips.Internal.RelativeRealAmplePerturbation

private theorem exists_affine_nonvanishing_tensor {X : Scheme.{u}} (G P N : X.Modules)
    [IsInvertibleModule X G] [IsInvertibleModule X P] [IsInvertibleModule X N]
    (e : tensorModules X G P ≅ N)
    (t : G.sections) (s : Γ(P, ⊤)) (U : X.Opens)
    (hUs : (U : Set X) = nonvanishingLocus _ s) (hU : IsAffineOpen U) {x : X}
    (hxt : x ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ t)
    (hxU : x ∈ U) :
    ∃ f : Γ(N, ⊤), x ∈ nonvanishingLocus _ f ∧
        IsAffineOpen (Stacks.NonvanishingOpen.nonvanishingOpen X _ f) := by
  set s₀ := Stacks.SheafOfModules.sectionsOfTop _ s
  set v := SheafOfModules.sectionsMap e.hom (tensorSections G _ t s₀)
  have h2 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) G t ↔
      z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := fun z =>
    Set.ext_iff.1 (Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X G t) z
  have h1 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ s₀ ↔
      z ∈ U := fun z => by
    rw [Stacks.AmpleBridge.nonvanishingLocus_sectionsOfTop, ← hUs]
    rfl
  have hmem : ∀ z : X,
      z ∈ nonvanishingLocus N (v.eval (Opposite.op ⊤)) ↔
      z ∈ U ∧ z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := by
    intro z
    rw [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval]
    exact (nonvanishingLocus_iso e (tensorSections G _ t s₀) z).trans
      ((tensorSections_nonvanishing_iff t s₀ z).trans (and_comm.trans (and_congr (h1 z) (h2 z))))
  refine ⟨v.eval (Opposite.op ⊤), (hmem x).2 ⟨hxU, (h2 x).1 hxt⟩, ?_⟩
  convert Stacks.NonvanishingAffineIntersection.isAffineOpen_inf_nonvanishingOpen
    (M := G) (s := t.eval (Opposite.op ⊤)) hU using 1
  ext z
  exact hmem z

/-- `(M ⊗ L^{⊗ j}) ⊗ L^{⊗ k} ≅ M ⊗ L^{⊗ (j + k)}`. -/
private noncomputable def splitIso {X : Scheme.{u}} (L M : X.Modules) [IsInvertibleModule X L]
    (j k : ℕ) :
    tensorModules X (tensorModules X M (tensorPowModule X L (j : ℤ)))
      (tensorPowModule X L (k : ℤ)) ≅ tensorModules X M (tensorPowModule X L ((j + k : ℕ) : ℤ)) :=
  Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
    tensorModulesMapIso X (Iso.refl _)
      (tensorPowModuleAddIso X _ (j : ℤ) (k : ℤ) ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))

/-- If `L` is ample and `M` is invertible, then `M ⊗ L^{⊗ m}` is ample for `m ≫ 0`. -/
private theorem eventually_isAmple_tensorModules_tensorPowModule {X : Scheme.{u}}
    (L M : X.Modules) [IsInvertibleModule X L] [IsInvertibleModule X M] (hL : IsAmple X L) :
    ∀ᶠ m : ℕ in Filter.atTop, IsAmple X (tensorModules X M (tensorPowModule X L (m : ℤ))) := by
  have : SheafOfModules.IsFiniteType.{u, u, u} M :=
    Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule M
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hL).2 M inferInstance inferInstance
  haveI : CompactSpace X := hL.1
  choose k hk s U hUs hxU hUaff using hL.2
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x : X ↦ ((U x : X.Opens) : Set X))
    (fun x ↦ (U x).isOpen) (fun x _ ↦ Set.mem_iUnion.2 ⟨x, hxU x⟩)
  refine Filter.eventually_atTop.2 ⟨T.sup k + n₀.toNat, fun m hm => ?_⟩
  refine Stacks.Ample.isAmple_of_forall_exists_affine_nonvanishingLocus _ fun x => ?_
  obtain ⟨y, hyT, hxy⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ x))
  have hsup : k y ≤ T.sup k := Finset.le_sup hyT
  obtain ⟨j, rfl⟩ : ∃ j, m = j + k y := ⟨m - k y, by omega⟩
  obtain ⟨σ, -⟩ := hn₀ j (by omega)
  set G := tensorModules X M (tensorPowModule X L (j : ℤ))
  haveI : SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property G :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) _ _
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X M
    (tensorPowModule X L (j : ℤ))
  haveI : @Epi (SheafOfModules.{u} X.ringCatSheaf) _ _ _ i.hom :=
    @IsIso.epi_of_iso _ _ _ _ i.hom i.isIso_hom
  obtain ⟨a, ha⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing G (σ.ofEpi i.hom) x
  exact exists_affine_nonvanishing_tensor G _ _ (splitIso L M j (k y)) _ (s y) (U y) (hUs y)
    (hUaff y) ha hxy

/-- The pull-back of `𝒪_Y(nH + F)` along `f : X ⟶ Y` is `f^*𝒪_Y(F) ⊗ (f^*𝒪_Y(H))^{⊗ n}`, for
Cartier divisors `H` and `F`. -/
private theorem nonempty_modulePullback_divisorialSheaf_nsmul_add_iso {X Y : Scheme.{u}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (f : X ⟶ Y) {H F : Divisor Y}
    (hH : H.IsCartier) (hF : F.IsCartier) (n : ℕ) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
        (n • H + F).divisorialSheaf ≅
      tensorModules X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          F.divisorialSheaf)
        (tensorPowModule X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          H.divisorialSheaf) (n : ℤ))) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  set P := RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom
  induction n with
  | zero =>
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X _).symm ≪≫
      tensorModulesMapIso X (Iso.refl _) (tensorPowModuleZeroIso X _).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      P.mapIso (((hH.nsmul n).add hF).divisorialSheafTensorIso hH).symm ≪≫
      pullbackTensorModulesIso f _ _ ≪≫
      tensorModulesMapIso X e (tensorPowModuleOneIso X _).symm ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
      tensorModulesMapIso X (Iso.refl _)
        (tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))⟩

/-- If `H` is a `g`-ample Cartier divisor and `F` is any Cartier divisor, then `mH + F` is
`g`-ample for `m ≫ 0`, provided the base is quasi-compact. -/
public theorem eventually_isRelativelyAmpleCartier_nsmul_add {Y Z : Scheme.{u}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [CompactSpace Z] (g : Y ⟶ Z)
    [QuasiCompact g] {H F : Divisor Y} (hH : IsRelativelyAmpleCartier g H) (hF : F.IsCartier) :
    ∀ᶠ m : ℕ in Filter.atTop, IsRelativelyAmpleCartier g (m • H + F) := by
  obtain ⟨hHc, hHa⟩ := hH
  haveI := hHc.isInvertibleModule_divisorialSheaf
  haveI := hF.isInvertibleModule_divisorialSheaf
  choose V' hVa hzV _ using fun z : Z =>
    exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun z : Z ↦ ((V' z : Z.Opens) : Set Z))
    (fun z ↦ (V' z).isOpen) (fun z _ ↦ Set.mem_iUnion.2 ⟨z, hzV z⟩)
  have hev : ∀ v ∈ T, ∀ᶠ m : ℕ in Filter.atTop,
      haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
      IsAmple (g ⁻¹ᵁ V' v).toScheme
        ((RingedSpaceModuleAdjunction.modulePullback
          (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom).obj (m • H + F).divisorialSheaf) := by
    intro v _
    let W := (g ⁻¹ᵁ V' v).toScheme
    let P := RingedSpaceModuleAdjunction.modulePullback (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom
    haveI hPF : IsInvertibleModule W (P.obj F.divisorialSheaf) := inferInstance
    haveI hPH : IsInvertibleModule W (P.obj H.divisorialSheaf) := inferInstance
    filter_upwards [eventually_isAmple_tensorModules_tensorPowModule (P.obj H.divisorialSheaf)
      (P.obj F.divisorialSheaf) (hHa _ (hVa v))]
      with m hm
    haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
    obtain ⟨e⟩ := nonempty_modulePullback_divisorialSheaf_nsmul_add_iso (g ⁻¹ᵁ V' v).ι hHc hF m
    exact (@isAmple_congr _ _ _ inferInstance
      (@Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules _ _ _ inferInstance
        (isInvertibleModule_tensorPowModule _ _ _)) e).2 hm
  filter_upwards [(Filter.eventually_all_finset T).2 hev] with m hm
  have hc := (hHc.nsmul m).add hF
  haveI := hc.isInvertibleModule_divisorialSheaf
  refine ⟨hc, ((Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_iff_exists_affine_isAmple_cover
    g _ inferInstance).2 fun z => ?_).2⟩
  obtain ⟨v, hvT, hzv⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ z))
  exact ⟨V' v, hVa v, hzv, hm v hvT⟩

section RealDivisors

variable {Y Z : Scheme.{u}} [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] {g : Y ⟶ Z}

/-- A sum of two `g`-ample `ℝ`-divisors is `g`-ample. -/
private theorem isRelativelyAmple_add {A A' : RDivisor Y} (hA : MMP.Flips.IsRelativelyAmple g A)
    (hA' : MMP.Flips.IsRelativelyAmple g A') : MMP.Flips.IsRelativelyAmple g (A + A') := by
  obtain ⟨m, r, L, hm, hr, hL, rfl⟩ := hA
  obtain ⟨m', r', L', -, hr', hL', rfl⟩ := hA'
  refine ⟨m + m', Fin.append r r', Fin.append L L', by omega, fun j => ?_, fun j => ?_, ?_⟩
  · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hr j
    · simpa using hr' j
  · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hL j
    · simpa using hL' j
  · rw [Fin.sum_univ_add]; simp

/-- A positive multiple of a `g`-ample Cartier divisor is `g`-ample. -/
private theorem isRelativelyAmple_smul_toRDivisor {r : ℝ} (hr : 0 < r) {L : Divisor Y}
    (hL : IsRelativelyAmpleCartier g L) :
    MMP.Flips.IsRelativelyAmple g (r • Divisor.toRDivisor L) :=
  ⟨1, fun _ => r, fun _ => L, le_rfl, fun _ => hr, fun _ => hL, by simp⟩

/-- Adding finitely many `g`-ample `ℝ`-divisors to a `g`-ample one keeps it `g`-ample. -/
private theorem isRelativelyAmple_add_sum {ι : Type*} (s : Finset ι) {A : RDivisor Y}
    {X : ι → RDivisor Y} (hA : MMP.Flips.IsRelativelyAmple g A)
    (hX : ∀ i ∈ s, MMP.Flips.IsRelativelyAmple g (X i)) :
    MMP.Flips.IsRelativelyAmple g (A + ∑ i ∈ s, X i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using hA
  | insert j s hj ih =>
    rw [Finset.sum_insert hj, add_left_comm]
    exact isRelativelyAmple_add (hX j (Finset.mem_insert_self j s))
      (ih fun i hi => hX i (Finset.mem_insert_of_mem hi))

/-- If `mH + F` and `mH - F` are `g`-ample Cartier divisors and `|u| < 2K`, then
`(2Km)H + uF = (K + u/2)(mH + F) + (K - u/2)(mH - F)` is `g`-ample. -/
private theorem isRelativelyAmple_smul_add_smul {H F : Divisor Y} {m : ℕ}
    (hp : IsRelativelyAmpleCartier g (m • H + F)) (hn : IsRelativelyAmpleCartier g (m • H + -F))
    {K u : ℝ} (hu : |u| < 2 * K) :
    MMP.Flips.IsRelativelyAmple g
      ((2 * K * m) • Divisor.toRDivisor H + u • Divisor.toRDivisor F) := by
  have h : (2 * K * m) • Divisor.toRDivisor H + u • Divisor.toRDivisor F =
      (K + u / 2) • Divisor.toRDivisor (m • H + F) +
        (K - u / 2) • Divisor.toRDivisor (m • H + -F) := by
    simp only [map_add, map_neg, map_nsmul, ← Nat.cast_smul_eq_nsmul ℝ]
    module
  rw [h]
  exact isRelativelyAmple_add
    (isRelativelyAmple_smul_toRDivisor (by linarith [neg_abs_le u]) hp)
    (isRelativelyAmple_smul_toRDivisor (by linarith [le_abs_self u]) hn)

end RealDivisors

end MMP.Flips.Internal.RelativeRealAmplePerturbation

namespace MMP.Flips

open MMP.Flips.Internal.RelativeRealAmplePerturbation in
/-- Relative ampleness of `ℝ`-Cartier divisors is open in every finite set of `ℝ`-Cartier
directions: if `A` is `g`-ample for a proper morphism `g : Y ⟶ Z` of normal varieties and the
`B i` are `ℝ`-Cartier, then for some `δ > 0` every `A + ∑ i, t i • B i` with all `|t i| < δ` is
`g`-ample. -/
@[mmp "lem_mmp_foundation_relative_real_ample_perturbation"]
public theorem exists_pos_isRelativelyAmple_add_sum_smul (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (sY : Y ⟶ Spec (.of k)) (sZ : Z ⟶ Spec (.of k))
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    (hY : Mori.IsNormalVariety k sY) (hZ : Mori.IsNormalVariety k sZ)
    (g : Y ⟶ Z) [IsProper g] (hg : g ≫ sZ = sY)
    {A : Mori.RDivisor Y} (hA : MMP.Flips.IsRelativelyAmple g A)
    {ι : Type*} [Fintype ι] (B : ι → Mori.RDivisor Y) (hB : ∀ i, IsCartierCombination (B i)) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ t : ι → ℝ, (∀ i, |t i| < δ) →
      MMP.Flips.IsRelativelyAmple g (A + ∑ i, t i • B i) := by
  haveI : QuasiCompact sZ := hZ.1.toQuasiCompact
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace sZ
  obtain ⟨M, a, H, hM, ha, hH, rfl⟩ := hA
  choose n b F hFc hBeq using hB
  let i₀ : Fin M := ⟨0, hM⟩
  let Λ := Σ i, Fin (n i)
  -- one multiple `m` of `H i₀` absorbing every direction `± F`
  have hev : ∀ᶠ m : ℕ in Filter.atTop, 0 < m ∧ ∀ l : Λ,
      IsRelativelyAmpleCartier g (m • H i₀ + F l.1 l.2) ∧
        IsRelativelyAmpleCartier g (m • H i₀ + -F l.1 l.2) :=
    (Filter.eventually_gt_atTop 0).and <| Filter.eventually_all.2 fun l =>
      (eventually_isRelativelyAmpleCartier_nsmul_add g (hH i₀) (hFc l.1 l.2)).and
        (eventually_isRelativelyAmpleCartier_nsmul_add g (hH i₀) (hFc l.1 l.2).neg)
  obtain ⟨m, hm0, hmF⟩ := hev.exists
  set C : ℝ := ∑ l : Λ, (|b l.1 l.2| + 1) with hC
  have hC0 : 0 ≤ C := Finset.sum_nonneg fun l _ => by positivity
  have hm : (0 : ℝ) < m := by exact_mod_cast hm0
  set δ : ℝ := a i₀ / (m * (C + 1)) with hδ
  have hδ0 : 0 < δ := div_pos (ha i₀) (by positivity)
  refine ⟨δ, hδ0, fun t ht => ?_⟩
  set u : Λ → ℝ := fun l => t l.1 * b l.1 l.2
  set K : Λ → ℝ := fun l => δ * (|b l.1 l.2| + 1) / 2
  have hu : ∀ l, |u l| < 2 * K l := fun l => by
    simp only [u, K, abs_mul]
    nlinarith [ht l.1, abs_nonneg (b l.1 l.2), abs_nonneg (t l.1)]
  set c : ℝ := ∑ l, 2 * K l * m
  have hcδ : c = δ * m * C := by
    simp only [c, K, hC, Finset.mul_sum]; exact Finset.sum_congr rfl fun l _ => by ring
  have hca : c < a i₀ := by
    have h1 : δ * m * (C + 1) = a i₀ := by
      rw [hδ]; field_simp
    rw [hcδ]; nlinarith [mul_pos hδ0 hm]
  set a' : Fin M → ℝ := fun j => a j - if j = i₀ then c else 0
  have ha' : ∀ j, 0 < a' j := fun j => by
    simp only [a']; split_ifs with h
    · subst h; linarith
    · simpa using ha j
  let F' : Λ → RDivisor Y := fun l => Divisor.toRDivisor (F l.1 l.2)
  let H' : RDivisor Y := Divisor.toRDivisor (H i₀)
  have hBsum : ∑ i, t i • B i = ∑ l : Λ, u l • F' l := by
    simp only [hBeq, Finset.smul_sum, smul_smul, u, F', Λ]
    rw [Fintype.sum_sigma]
    rfl
  have hA' : ∑ j, a' j • Divisor.toRDivisor (H j) =
      ∑ j, a j • Divisor.toRDivisor (H j) - c • H' := by
    simp only [a', sub_smul, Finset.sum_sub_distrib, ite_smul, zero_smul, Finset.sum_ite_eq',
      Finset.mem_univ, if_true, H']
  have heq : ∑ j, a j • Divisor.toRDivisor (H j) + ∑ i, t i • B i =
      ∑ j, a' j • Divisor.toRDivisor (H j) + ∑ l : Λ, ((2 * K l * m) • H' + u l • F' l) := by
    rw [hA', hBsum, Finset.sum_add_distrib, ← Finset.sum_smul]
    abel
  rw [heq]
  exact isRelativelyAmple_add_sum _ ⟨M, a', H, hM, ha', hH, rfl⟩ fun l _ =>
    isRelativelyAmple_smul_add_smul (hmF l).1 (hmF l).2 (hu l)

end MMP.Flips

end

/-!
## Completion of a smooth algebra at a section with prescribed parameters

Let `S` be a smooth `R`-algebra and `σ : S →ₐ[R] R` a section, with kernel `I`. Suppose
`t : ι → S` (with `ι` finite) are elements of `I` whose classes form a basis of the conormal
module `I / I²`. Then for every `n`, evaluation `Xᵢ ↦ tᵢ` induces an `R`-algebra isomorphism
`R[X] ⧸ (X)ⁿ ≃ S ⧸ Iⁿ`. Since all of these are induced by the single map `aeval t`, they are
compatible with the transition maps, and passing to the limit gives an `R`-algebra isomorphism
`Ŝ_I ≃ R⟦X⟧` of the `I`-adic completion with the power series ring, sending `tᵢ` to `Xᵢ` and
under which the constant coefficient is evaluation by `σ`.

For `R = ℂ` and `S` a smooth finite type `ℂ`-algebra with a `ℂ`-point `σ`, this is the
description of the completed local ring at a smooth `ℂ`-point in terms of chosen parameters.

### Main results

* `MMP.quotientPowAevalEquiv`: the truncated isomorphisms `R[X] ⧸ (X)ⁿ ≃ S ⧸ Iⁿ`.
* `MMP.adicCompletionEquivMvPowerSeries`: the completed isomorphism `Ŝ_I ≃ R⟦X⟧`.
* `MMP.adicCompletionEquivMvPowerSeries_spec`: the truncated isomorphisms are induced
  by `Xᵢ ↦ tᵢ`, and the completed one sends `tᵢ` to `Xᵢ` with constant coefficient `σ`.

### Implementation notes

The completion is the `I`-adic completion `AdicCompletion I S` of `S` itself. It agrees with the
completion of the local ring `S_I` at its maximal ideal, since `S ⧸ Iⁿ ≃ S_I ⧸ (I S_I)ⁿ` for every
`n` (`IsLocalization.AtPrime.equivQuotMaximalIdealPow`).
-/

section

open MvPolynomial

namespace MMP.Internal.SmoothPointCompletion

/-- Evaluating polynomials at elements of an ideal `I` carries the `n`-th power of the ideal of
the variables into `Iⁿ`. -/
public theorem MvPolynomial.map_aeval_pow_idealOfVars_le {R S ι : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (I : Ideal S) (t : ι → S) (ht : ∀ i, t i ∈ I) (n : ℕ) :
    (idealOfVars ι R ^ n).map (aeval t) ≤ I ^ n := by
  rw [Ideal.map_pow]
  refine Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr (Ideal.span_le.mpr ?_)) n
  rintro _ ⟨i, rfl⟩
  simpa using ht i

/-- Let `φ` be a ring endomorphism preserving an ideal `J` and congruent to the identity modulo
`Jⁿ`, with `n ≥ 2`. Then `φ` is congruent to the identity modulo `Jⁿ⁺¹` on `Jⁿ`. -/
private theorem Ideal.sub_mem_pow_succ_of_forall_sub_mem_pow {P : Type*} [CommRing P] (J : Ideal P)
    (φ : P →+* P) (hφJ : ∀ x ∈ J, φ x ∈ J) {n : ℕ} (hn : 2 ≤ n)
    (hφ : ∀ x, φ x - x ∈ J ^ n) : ∀ f ∈ J ^ n, φ f - f ∈ J ^ (n + 1) := by
  have hpow : ∀ k, ∀ y ∈ J ^ k, φ y ∈ J ^ k := by
    intro k y hy
    have hle : (J ^ k).map φ ≤ J ^ k := by
      rw [Ideal.map_pow]
      exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr hφJ) k
    exact hle (Ideal.mem_map_of_mem φ hy)
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  intro f hf
  rw [pow_succ'] at hf
  refine Submodule.mul_induction_on hf ?_ ?_
  · intro x hx y hy
    have h1 : (φ x - x) * φ y ∈ J ^ (m + 1 + 1) := by
      have := Ideal.mul_mem_mul (hφ x) (hpow m y hy)
      rw [← pow_add] at this
      exact Ideal.pow_le_pow_right (by omega) this
    have h2 : x * (φ y - y) ∈ J ^ (m + 1 + 1) := by
      have := Ideal.mul_mem_mul hx (hφ y)
      rwa [← pow_succ'] at this
    have : φ (x * y) - x * y = (φ x - x) * φ y + x * (φ y - y) := by
      rw [map_mul]; ring
    rw [this]
    exact Ideal.add_mem _ h1 h2
  · intro a b ha hb
    rw [map_add, add_sub_add_comm]
    exact Ideal.add_mem _ ha hb

section

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (σ : S →ₐ[R] R)
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- If the classes of `t_i ∈ I = Ker(σ)` form a basis of `I/I²`, every element of `I` is an
`R`-linear combination of the `t_i` modulo `I²`. -/
private theorem exists_mem_idealOfVars_sub_aeval_mem_ker_sq
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (x : S) (hx : x ∈ RingHom.ker σ) :
    ∃ q ∈ idealOfVars ι R, x - aeval t q ∈ RingHom.ker σ ^ 2 := by
  let I := RingHom.ker σ
  have hti : ∀ i, t i ∈ I := fun i => (ht i).1
  let c := b.repr (I.toCotangent ⟨x, hx⟩)
  let z : I := ∑ i, c i • (⟨t i, hti i⟩ : I)
  have hz : I.toCotangent z = I.toCotangent ⟨x, hx⟩ := by
    simp only [z, map_sum, LinearMap.map_smul_of_tower]
    conv_rhs => rw [← b.sum_repr (I.toCotangent ⟨x, hx⟩)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [(ht i).2]
  refine ⟨∑ i, c i • (X i : MvPolynomial ι R), Ideal.sum_mem _ fun i _ =>
    Submodule.smul_of_tower_mem _ (c i) (Ideal.subset_span ⟨i, rfl⟩), ?_⟩
  have hzval : ((z : I) : S) = aeval t (∑ i, c i • (X i : MvPolynomial ι R)) := by
    simp [z, map_sum, Submodule.coe_sum]
  rw [← hzval]
  exact (Ideal.toCotangent_eq I).mp hz.symm

/-- If the classes of `t_i ∈ I = Ker(σ)` form a basis of `I/I²`, then every element of `Iⁿ` is,
modulo `Iⁿ⁺¹`, the value at `t` of a polynomial in the `n`-th power of the ideal of variables. -/
private theorem exists_mem_pow_idealOfVars_sub_aeval_mem_ker_pow_succ
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i) :
    ∀ (n : ℕ) (x : S), x ∈ RingHom.ker σ ^ n →
      ∃ q ∈ idealOfVars ι R ^ n, x - aeval t q ∈ RingHom.ker σ ^ (n + 1) := by
  let I := RingHom.ker σ
  have hti : ∀ i, t i ∈ I := fun i => (ht i).1
  intro n
  induction n with
  | zero =>
    intro x _
    refine ⟨C (σ x), by simp, ?_⟩
    rw [zero_add, pow_one, aeval_C, RingHom.mem_ker, map_sub, AlgHom.commutes,
      Algebra.algebraMap_self, RingHom.id_apply, sub_self]
  | succ n ih =>
    intro x hx
    rw [pow_succ] at hx
    refine Submodule.mul_induction_on hx ?_ ?_
    · intro m hm m' hm'
      obtain ⟨q, hq, hmq⟩ := ih m hm
      obtain ⟨q', hq', hmq'⟩ := exists_mem_idealOfVars_sub_aeval_mem_ker_sq σ b t ht m' hm'
      refine ⟨q * q', by rw [pow_succ]; exact Ideal.mul_mem_mul hq hq', ?_⟩
      have haq : aeval t q ∈ I ^ n :=
        MvPolynomial.map_aeval_pow_idealOfVars_le I t hti n (Ideal.mem_map_of_mem _ hq)
      have h1 : (m - aeval t q) * m' ∈ I ^ (n + 1 + 1) := by
        have := Ideal.mul_mem_mul hmq hm'
        rwa [← pow_succ] at this
      have h2 : aeval t q * (m' - aeval t q') ∈ I ^ (n + 1 + 1) := by
        have := Ideal.mul_mem_mul haq hmq'
        rwa [← pow_add] at this
      have : m * m' - aeval t (q * q') = (m - aeval t q) * m' + aeval t q * (m' - aeval t q') := by
        rw [map_mul]; ring
      rw [this]
      exact Ideal.add_mem _ h1 h2
    · rintro a b ⟨qa, hqa, ha⟩ ⟨qb, hqb, hb⟩
      refine ⟨qa + qb, Ideal.add_mem _ hqa hqb, ?_⟩
      rw [map_add, add_sub_add_comm]
      exact Ideal.add_mem _ ha hb

/-- If the classes of `t_i ∈ I = Ker(σ)` span `I/I²`, then `S` is generated by the `t_i` modulo
every power of `I`. -/
private theorem exists_sub_aeval_mem_ker_pow
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (n : ℕ) (x : S) : ∃ p : MvPolynomial ι R, x - aeval t p ∈ RingHom.ker σ ^ n := by
  induction n with
  | zero => exact ⟨0, by simp⟩
  | succ n ih =>
    obtain ⟨p, hp⟩ := ih
    obtain ⟨q, -, hq⟩ := exists_mem_pow_idealOfVars_sub_aeval_mem_ker_pow_succ σ b t ht n _ hp
    refine ⟨p + q, ?_⟩
    rw [map_add, ← sub_sub]
    exact hq

/-- If the classes of `t_i ∈ I = Ker(σ)` are linearly independent in `I/I²` and a polynomial `p`
has value at `t` in `I²`, then `p` lies in the square of the ideal of variables. -/
private theorem mem_idealOfVars_sq_of_aeval_mem_ker_sq
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (p : MvPolynomial ι R) (hp : aeval t p ∈ RingHom.ker σ ^ 2) :
    p ∈ idealOfVars ι R ^ 2 := by
  classical
  let I := RingHom.ker σ
  have hti : ∀ i, t i ∈ I := fun i => (ht i).1
  have hσ : ∀ q : MvPolynomial ι R, σ (aeval t q) = constantCoeff q := by
    intro q
    rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval]
    have : (fun i => σ (t i)) = 0 := funext hti
    rw [this, aeval_zero, Algebra.algebraMap_self, RingHom.id_apply]
  have hp0 : constantCoeff p = 0 := by
    rw [← hσ]
    exact Ideal.pow_le_self two_ne_zero hp
  let c : ι → R := fun i => p.coeff (Finsupp.single i 1)
  let q := p - ∑ i, c i • (X i : MvPolynomial ι R)
  have hdeg : ∀ x : ι →₀ ℕ, x.degree < 2 → x = 0 ∨ ∃ i, x = Finsupp.single i 1 := by
    intro x hx
    rcases Nat.lt_succ_iff_lt_or_eq.mp hx with h | h
    · left
      exact (Finsupp.degree_eq_zero_iff x).mp (by omega)
    · right
      have hmem : x ∈ {d : ι →₀ ℕ | d.degree = 1} := h
      rw [← Finsupp.range_single_one] at hmem
      obtain ⟨i, rfl⟩ := hmem
      exact ⟨i, rfl⟩
  have hq : q ∈ idealOfVars ι R ^ 2 := by
    rw [mem_pow_idealOfVars_iff']
    intro x hx
    rcases hdeg x hx with rfl | ⟨j, rfl⟩
    · have h0 : p.coeff 0 = 0 := (constantCoeff_eq p).symm.trans hp0
      simp [q, coeff_sum, coeff_X', h0]
    · simp only [q, coeff_sub, coeff_sum, coeff_smul, coeff_X', smul_eq_mul, mul_ite, mul_one,
        mul_zero, Finsupp.single_left_inj one_ne_zero, Finset.sum_ite_eq', Finset.mem_univ,
        if_true, c, sub_self]
  have hlin : aeval t (∑ i, c i • (X i : MvPolynomial ι R)) ∈ I ^ 2 := by
    have hq2 : aeval t q ∈ I ^ 2 :=
      MvPolynomial.map_aeval_pow_idealOfVars_le I t hti 2 (Ideal.mem_map_of_mem _ hq)
    have : aeval t (∑ i, c i • (X i : MvPolynomial ι R)) = aeval t p - aeval t q := by
      simp only [q, map_sub, sub_sub_cancel]
    rw [this]
    exact Ideal.sub_mem _ hp hq2
  let z : I := ∑ i, c i • (⟨t i, hti i⟩ : I)
  have hz0 : I.toCotangent z = 0 := by
    rw [Ideal.toCotangent_eq_zero]
    simpa [z, map_sum, Submodule.coe_sum] using hlin
  have hsum : ∑ i, c i • b i = 0 := by
    rw [← hz0]
    simp only [z, map_sum, LinearMap.map_smul_of_tower]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [(ht i).2]
  have hc : ∀ i, c i = 0 := (Fintype.linearIndependent_iff.mp b.linearIndependent) c hsum
  have hqp : q = p := by
    simp [q, hc]
  rw [← hqp]
  exact hq

/-- **Inverse of the truncated comparison maps.** Let `S` be formally smooth over `R`, with a
section `σ` whose kernel `I` has conormal module with basis the classes of `t_i ∈ I`. For every
`n` there is an `R`-algebra map `S → R[X] ⧸ (X)ⁿ⁺²` sending `t_i` to `X_i` and `I` into `(X)`. -/
private theorem exists_algHom_quotient_pow_idealOfVars [Algebra.FormallySmooth R S]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (n : ℕ) :
    ∃ h : S →ₐ[R] MvPolynomial ι R ⧸ idealOfVars ι R ^ (n + 2),
      (∀ i, h (t i) = Ideal.Quotient.mk _ (X i)) ∧
      ∀ s ∈ RingHom.ker σ,
        h s ∈ (idealOfVars ι R).map (Ideal.Quotient.mk (idealOfVars ι R ^ (n + 2))) := by
  have hti : ∀ i, t i ∈ RingHom.ker σ := fun i => (ht i).1
  induction n with
  | zero =>
    let Ψ : MvPolynomial ι R ⧸ idealOfVars ι R ^ 2 →ₐ[R] S ⧸ RingHom.ker σ ^ 2 :=
      Ideal.quotientMapₐ (RingHom.ker σ ^ 2) (aeval t)
        (Ideal.map_le_iff_le_comap.mp
          (MvPolynomial.map_aeval_pow_idealOfVars_le (RingHom.ker σ) t hti 2))
    have hΨ : ∀ p, Ψ (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (aeval t p) := fun _ => rfl
    have hinj : Function.Injective Ψ := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
      rw [hΨ, Ideal.Quotient.eq_zero_iff_mem] at ha
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (mem_idealOfVars_sq_of_aeval_mem_ker_sq σ b t ht p ha)
    have hsurj : Function.Surjective Ψ := by
      intro a
      obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective a
      obtain ⟨p, hp⟩ := exists_sub_aeval_mem_ker_pow σ b t ht 2 s
      exact ⟨Ideal.Quotient.mk _ p, by rw [hΨ]; exact (Ideal.Quotient.eq.mpr hp).symm⟩
    let e := AlgEquiv.ofBijective Ψ ⟨hinj, hsurj⟩
    refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ R (RingHom.ker σ ^ 2)), fun i => ?_,
      fun s hs => ?_⟩
    · change e.symm (Ideal.Quotient.mk _ (t i)) = _
      rw [AlgEquiv.symm_apply_eq]
      change _ = Ψ (Ideal.Quotient.mk _ (X i))
      rw [hΨ, aeval_X]
    · obtain ⟨q, hq, hsq⟩ := exists_mem_idealOfVars_sub_aeval_mem_ker_sq σ b t ht s hs
      have : e.symm (Ideal.Quotient.mk _ s) = Ideal.Quotient.mk _ q := by
        rw [AlgEquiv.symm_apply_eq]
        change _ = Ψ (Ideal.Quotient.mk _ q)
        rw [hΨ]
        exact Ideal.Quotient.eq.mpr hsq
      change e.symm (Ideal.Quotient.mk _ s) ∈ _
      rw [this]
      exact Ideal.mem_map_of_mem _ hq
  | succ n ih =>
    obtain ⟨h, hht, hhI⟩ := ih
    have hle : idealOfVars ι R ^ (n + 2 + 1) ≤ idealOfVars ι R ^ (n + 2) :=
      Ideal.pow_le_pow_right (Nat.le_succ _)
    let K : Ideal (MvPolynomial ι R ⧸ idealOfVars ι R ^ (n + 2 + 1)) :=
      (idealOfVars ι R ^ (n + 2)).map (Ideal.Quotient.mkₐ R (idealOfVars ι R ^ (n + 2 + 1)))
    have hK : IsNilpotent K := by
      refine ⟨2, ?_⟩
      change K ^ 2 = ⊥
      rw [← Ideal.map_pow, ← pow_mul, Ideal.map_eq_bot_iff_le_ker]
      intro x hx
      show Ideal.Quotient.mkₐ R (idealOfVars ι R ^ (n + 2 + 1)) x = 0
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.pow_le_pow_right (by omega) hx
    let δ := DoubleQuot.quotQuotEquivQuotOfLEₐ R hle
    let g : S →ₐ[R] (MvPolynomial ι R ⧸ idealOfVars ι R ^ (n + 2 + 1)) ⧸ K :=
      δ.symm.toAlgHom.comp h
    let h' := Algebra.FormallySmooth.lift K hK g
    have hh' : ∀ s, Ideal.Quotient.mk K (h' s) = δ.symm (h s) := fun s =>
      AlgHom.congr_fun (Algebra.FormallySmooth.comp_lift K hK g) s
    have hδ : ∀ p, δ.symm (Ideal.Quotient.mk _ p) =
        Ideal.Quotient.mk K (Ideal.Quotient.mk _ p) := fun p =>
      DoubleQuot.quotQuotEquivQuotOfLE_symm_mk p hle
    have hε : ∀ i, h' (t i) - Ideal.Quotient.mk _ (X i) ∈ K := by
      intro i
      rw [← Ideal.Quotient.eq_zero_iff_mem, RingHom.map_sub (Ideal.Quotient.mk K), hh', hht i, hδ, sub_self]
    have hmkK : Function.Surjective (Ideal.Quotient.mkₐ R (idealOfVars ι R ^ (n + 2 + 1))) :=
      Ideal.Quotient.mkₐ_surjective R _
    choose ε hεJ hεmk using fun i => (Ideal.mem_map_iff_of_surjective _ hmkK).mp (hε i)
    have hεJ1 : ∀ i, ε i ∈ idealOfVars ι R := fun i => Ideal.pow_le_self (by omega) (hεJ i)
    let β : MvPolynomial ι R →ₐ[R] MvPolynomial ι R := aeval fun i => X i - ε i
    have hβX : ∀ i, β (X i) = X i - ε i := fun i => aeval_X _ i
    have hXε : ∀ i, X i - ε i ∈ idealOfVars ι R := fun i =>
      Ideal.sub_mem _ (Ideal.subset_span ⟨i, rfl⟩) (hεJ1 i)
    have hβJ : ∀ k, (idealOfVars ι R ^ k).map β ≤ idealOfVars ι R ^ k := fun k =>
      MvPolynomial.map_aeval_pow_idealOfVars_le (idealOfVars ι R) _ hXε k
    have hβJ1 : ∀ x ∈ idealOfVars ι R, β x ∈ idealOfVars ι R := fun x hx => by
      simpa using hβJ 1 (by simpa using Ideal.mem_map_of_mem β hx)
    have hβN : ∀ x, β x - x ∈ idealOfVars ι R ^ (n + 2) := by
      intro x
      rw [← Ideal.Quotient.eq]
      have : (Ideal.Quotient.mkₐ R (idealOfVars ι R ^ (n + 2))).comp β =
          Ideal.Quotient.mkₐ R (idealOfVars ι R ^ (n + 2)) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [AlgHom.comp_apply, hβX, Ideal.Quotient.mkₐ_eq_mk, map_sub,
          Ideal.Quotient.eq_zero_iff_mem.mpr (hεJ i), sub_zero]
      exact AlgHom.congr_fun this x
    have hβε : ∀ i, β (ε i) - ε i ∈ idealOfVars ι R ^ (n + 2 + 1) :=
      fun i => Ideal.sub_mem_pow_succ_of_forall_sub_mem_pow (idealOfVars ι R) β.toRingHom
        hβJ1 (by omega) hβN (ε i) (hεJ i)
    let βbar : MvPolynomial ι R ⧸ idealOfVars ι R ^ (n + 2 + 1) →ₐ[R]
        MvPolynomial ι R ⧸ idealOfVars ι R ^ (n + 2 + 1) :=
      Ideal.quotientMapₐ (idealOfVars ι R ^ (n + 2 + 1)) β
        (Ideal.map_le_iff_le_comap.mp (hβJ (n + 2 + 1)))
    have hβbar : ∀ p, βbar (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (β p) := fun _ => rfl
    refine ⟨βbar.comp h', fun i => ?_, fun s hs => ?_⟩
    · have hti' : h' (t i) = Ideal.Quotient.mk _ (X i) + Ideal.Quotient.mk _ (ε i) := by
        have := hεmk i
        rw [Ideal.Quotient.mkₐ_eq_mk] at this
        rw [this, add_sub_cancel]
      have h1 : Ideal.Quotient.mk (idealOfVars ι R ^ (n + 2 + 1)) (β (ε i)) =
          Ideal.Quotient.mk _ (ε i) := Ideal.Quotient.eq.mpr (hβε i)
      rw [AlgHom.comp_apply, hti', map_add, hβbar, hβbar, h1, hβX, map_sub, sub_add_cancel]
    · obtain ⟨p, hpJ, hp⟩ := (Ideal.mem_map_iff_of_surjective _
        Ideal.Quotient.mk_surjective).mp (hhI s hs)
      have hdiff : h' s - Ideal.Quotient.mk _ p ∈ K := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, RingHom.map_sub (Ideal.Quotient.mk K), hh', ← hp, hδ, sub_self]
      have hKJ : K ≤ (idealOfVars ι R).map
          (Ideal.Quotient.mkₐ R (idealOfVars ι R ^ (n + 2 + 1))) :=
        Ideal.map_mono (Ideal.pow_le_self (by omega))
      have hs' : h' s ∈ (idealOfVars ι R).map
          (Ideal.Quotient.mkₐ R (idealOfVars ι R ^ (n + 2 + 1))) := by
        have := Ideal.add_mem _ (hKJ hdiff)
          (Ideal.mem_map_of_mem (Ideal.Quotient.mkₐ R (idealOfVars ι R ^ (n + 2 + 1))) hpJ)
        rwa [Ideal.Quotient.mkₐ_eq_mk, sub_add_cancel] at this
      obtain ⟨r, hrJ, hr⟩ := (Ideal.mem_map_iff_of_surjective _ hmkK).mp hs'
      rw [AlgHom.comp_apply, ← hr, Ideal.Quotient.mkₐ_eq_mk, hβbar]
      exact Ideal.mem_map_of_mem _ (hβJ1 r hrJ)

/-- The `n`-th truncation of an element of the `J`-adic completion, pushed to `P ⧸ Jᵐ` for
`m ≤ n`, is its `m`-th truncation. -/
public theorem AdicCompletion.factorₐ_evalₐ {P : Type*} [CommRing P] [Algebra R P]
    (J : Ideal P) {m n : ℕ} (hmn : m ≤ n) (x : AdicCompletion J P) :
    (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn : J ^ n ≤ J ^ m))
        ((AdicCompletion.evalₐ J n) x)
      = (AdicCompletion.evalₐ J m) x := by
  obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective J P x
  rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
  change (Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn)) _ = _
  rw [Ideal.Quotient.factor_mk]
  exact AdicCompletion.Ideal.mk_eq_mk J hmn a

/-- The truncations `P̂_J → P ⧸ Jⁿ ≃ S ⧸ Iⁿ` of a family of isomorphisms compatible with the
transition maps are compatible with the transition maps. -/
public theorem AdicCompletion.factorₐ_comp_comp_evalₐ
    {P S : Type*} [CommRing P] [CommRing S] [Algebra R P] [Algebra R S]
    (J : Ideal P) (I : Ideal S)
    (e : ∀ n, (P ⧸ J ^ n) ≃ₐ[R] (S ⧸ I ^ n))
    (hcompat : ∀ {m n : ℕ} (hmn : m ≤ n),
        (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp (e n).toAlgHom
        = (e m).toAlgHom.comp (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)))
    {m n : ℕ} (hmn : m ≤ n) :
    (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp
        ((e n).toAlgHom.comp ((AdicCompletion.evalₐ J n).restrictScalars R))
      = (e m).toAlgHom.comp ((AdicCompletion.evalₐ J m).restrictScalars R) := by
  ext x
  simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply, AlgEquiv.coe_toAlgHom]
  have h1 := AlgHom.congr_fun (hcompat hmn) ((AdicCompletion.evalₐ J n) x)
  simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom] at h1
  rw [h1]
  exact congrArg (e m) (AdicCompletion.factorₐ_evalₐ J hmn x)

/-- The truncations `Ŝ_I → S ⧸ Iⁿ ≃ P ⧸ Jⁿ` of the inverses of a family of isomorphisms
compatible with the transition maps are compatible with the transition maps. -/
public theorem AdicCompletion.factorₐ_comp_comp_evalₐ_symm
    {P S : Type*} [CommRing P] [CommRing S] [Algebra R P] [Algebra R S]
    (J : Ideal P) (I : Ideal S)
    (e : ∀ n, (P ⧸ J ^ n) ≃ₐ[R] (S ⧸ I ^ n))
    (hcompat : ∀ {m n : ℕ} (hmn : m ≤ n),
        (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp (e n).toAlgHom
        = (e m).toAlgHom.comp (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)))
    {m n : ℕ} (hmn : m ≤ n) :
    (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp
        ((e n).symm.toAlgHom.comp ((AdicCompletion.evalₐ I n).restrictScalars R))
      = (e m).symm.toAlgHom.comp ((AdicCompletion.evalₐ I m).restrictScalars R) := by
  ext x
  simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply, AlgEquiv.coe_toAlgHom]
  have h1 := AlgHom.congr_fun (hcompat hmn) ((e n).symm ((AdicCompletion.evalₐ I n) x))
  simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply] at h1
  rw [AdicCompletion.factorₐ_evalₐ I hmn x] at h1
  apply (e m).injective
  rw [AlgEquiv.apply_symm_apply, ← h1]

/-- A family of `R`-algebra isomorphisms `P ⧸ Jⁿ ≃ₐ[R] S ⧸ Iⁿ` compatible with the transition
maps of the two towers of quotients assembles into an `R`-algebra isomorphism of the `J`-adic and
the `I`-adic completion: the inverse limit of the family. -/
public noncomputable def AdicCompletion.algEquivOfQuotientPow
    {P S : Type*} [CommRing P] [CommRing S] [Algebra R P] [Algebra R S]
    (J : Ideal P) (I : Ideal S)
    (e : ∀ n, (P ⧸ J ^ n) ≃ₐ[R] (S ⧸ I ^ n))
    (hcompat : ∀ {m n : ℕ} (hmn : m ≤ n),
        (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp (e n).toAlgHom
        = (e m).toAlgHom.comp (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn))) :
    AdicCompletion J P ≃ₐ[R] AdicCompletion I S :=
  AlgEquiv.ofAlgHom
    (AdicCompletion.liftAlgHom I
      (fun n => (e n).toAlgHom.comp ((AdicCompletion.evalₐ J n).restrictScalars R))
      (AdicCompletion.factorₐ_comp_comp_evalₐ J I e hcompat))
    (AdicCompletion.liftAlgHom J
      (fun n => (e n).symm.toAlgHom.comp ((AdicCompletion.evalₐ I n).restrictScalars R))
      (AdicCompletion.factorₐ_comp_comp_evalₐ_symm J I e hcompat))
    (by
      apply AlgHom.ext
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [AlgHom.comp_apply, AlgHom.id_apply,
        AdicCompletion.evalₐ_liftAlgHom, AlgHom.restrictScalars_apply, AlgEquiv.coe_toAlgHom,
        AlgEquiv.apply_symm_apply])
    (by
      apply AlgHom.ext
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [AlgHom.comp_apply, AlgHom.id_apply,
        AdicCompletion.evalₐ_liftAlgHom, AlgHom.restrictScalars_apply, AlgEquiv.coe_toAlgHom,
        AlgEquiv.symm_apply_apply])

/-- The inverse limit `AdicCompletion.algEquivOfQuotientPow` of a compatible family of
isomorphisms induces the given isomorphisms on the truncations. -/
public theorem AdicCompletion.evalₐ_algEquivOfQuotientPow
    {P S : Type*} [CommRing P] [CommRing S] [Algebra R P] [Algebra R S]
    (J : Ideal P) (I : Ideal S)
    (e : ∀ n, (P ⧸ J ^ n) ≃ₐ[R] (S ⧸ I ^ n))
    (hcompat : ∀ {m n : ℕ} (hmn : m ≤ n),
        (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp (e n).toAlgHom
        = (e m).toAlgHom.comp (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)))
    (n : ℕ) (x : AdicCompletion J P) :
    AdicCompletion.evalₐ I n (AdicCompletion.algEquivOfQuotientPow J I e hcompat x)
      = e n (AdicCompletion.evalₐ J n x) :=
  AdicCompletion.evalₐ_liftAlgHom I _ (AdicCompletion.factorₐ_comp_comp_evalₐ J I e hcompat) n x

/-- The truncated comparison isomorphisms `R[X] ⧸ (X)ⁿ ≃ S ⧸ Iⁿ` induced by `aeval t` are
compatible with the transition maps of the two towers. -/
public theorem factorₐ_comp_eq_comp_factorₐ (t : ι → S)
    (e : ∀ n, (MvPolynomial ι R ⧸ idealOfVars ι R ^ n) ≃ₐ[R] (S ⧸ RingHom.ker σ ^ n))
    (he : ∀ n p, e n (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (aeval t p))
    {m n : ℕ} (hmn : m ≤ n) :
    (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp (e n).toAlgHom
      = (e m).toAlgHom.comp (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)) := by
  refine Ideal.Quotient.algHom_ext R (MvPolynomial.algHom_ext fun i => ?_)
  change Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn) (e n (Ideal.Quotient.mk _ (X i))) =
    e m (Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn) (Ideal.Quotient.mk _ (X i)))
  rw [he, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk, he]

/-- A ring map `S → R` that is `R`-linear on scalars and kills the kernel of a section `σ`
is `σ`. -/
private theorem apply_eq_of_forall_mem_ker (φ : S →+* R) (hφ : ∀ r, φ (algebraMap R S r) = r)
    (h : ∀ x ∈ RingHom.ker σ, φ x = 0) (x : S) : φ x = σ x := by
  have hx : x - algebraMap R S (σ x) ∈ RingHom.ker σ := by simp [RingHom.mem_ker]
  simpa [hφ, sub_eq_zero] using h _ hx

end

/-- The `n`-th truncation of the image of a power series in the adic completion of the polynomial
ring is the class of its truncation in total degree `< n`. -/
private theorem evalₐ_toAdicCompletion {ι R : Type*} [Finite ι] [CommRing R] (n : ℕ)
    (p : MvPowerSeries ι R) :
    AdicCompletion.evalₐ (idealOfVars ι R) n (MvPowerSeries.toAdicCompletion ι R p) =
      Ideal.Quotient.mk _ (MvPowerSeries.truncTotal n p) :=
  AdicCompletion.evalₐ_liftAlgHom _ _ (fun h ↦ AlgHom.ext fun _ ↦ by
    simpa [Ideal.Quotient.mk_eq_mk_iff_sub_mem] using
      MvPowerSeries.truncTotal_sub_truncTotal_mem_pow_idealOfVars h (le_refl _) _) n p

/-- A power series whose image in `R[X] ⧸ (X)` vanishes has zero constant coefficient. -/
private theorem constantCoeff_eq_zero_of_evalₐ_one {ι R : Type*} [Finite ι] [CommRing R]
    (p : MvPowerSeries ι R)
    (hp : AdicCompletion.evalₐ (idealOfVars ι R) 1 (MvPowerSeries.toAdicCompletion ι R p) = 0) :
    MvPowerSeries.constantCoeff p = 0 := by
  rw [evalₐ_toAdicCompletion, Ideal.Quotient.eq_zero_iff_mem] at hp
  have h := (MvPolynomial.mem_pow_idealOfVars_iff' 1 _).mp hp 0 (by simp)
  rw [MvPowerSeries.coeff_truncTotal _ (by simp)] at h
  simpa using h

end MMP.Internal.SmoothPointCompletion

namespace MMP

open MMP.Internal.SmoothPointCompletion

section

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (σ : S →ₐ[R] R) {ι : Type*}

/-- **The truncated comparison map.** For elements `t_i` of the kernel of a section
`σ : S →ₐ[R] R`, evaluation `X_i ↦ t_i` induces the `R`-algebra map
`R[X] ⧸ (X)ⁿ → S ⧸ (ker σ)ⁿ`, `mk f ↦ mk (aeval t f)`. -/
public noncomputable def quotientPowAevalHom (t : ι → S) (ht : ∀ i, t i ∈ RingHom.ker σ)
    (n : ℕ) : (MvPolynomial ι R ⧸ idealOfVars ι R ^ n) →ₐ[R] (S ⧸ RingHom.ker σ ^ n) :=
  Ideal.quotientMapₐ (RingHom.ker σ ^ n) (aeval t)
    (Ideal.map_le_iff_le_comap.mp
      (MvPolynomial.map_aeval_pow_idealOfVars_le (RingHom.ker σ) t ht n))

/-- `quotientPowAevalHom σ t ht n` sends the class of `f` to the class of `aeval t f`. -/
@[simp]
public theorem quotientPowAevalHom_mk (t : ι → S) (ht : ∀ i, t i ∈ RingHom.ker σ) (n : ℕ)
    (f : MvPolynomial ι R) :
    quotientPowAevalHom σ t ht n (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ (aeval t f) :=
  rfl

/-- **The truncated comparison maps are bijective.** Let `S` be formally smooth over `R`, with
a section `σ` whose kernel `I` has conormal module with basis the classes of `t_i ∈ I`. Then
the map `R[X] ⧸ (X)ⁿ → S ⧸ Iⁿ` induced by `X_i ↦ t_i` is bijective for every `n`. -/
public theorem bijective_quotientPowAevalHom [Algebra.FormallySmooth R S] [Fintype ι]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (n : ℕ) : Function.Bijective (quotientPowAevalHom σ t (fun i => (ht i).1) n) := by
  classical
  set Ψ := quotientPowAevalHom σ t (fun i => (ht i).1) n
  have hΨ : ∀ p, Ψ (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (aeval t p) := fun _ => rfl
  have hinj : Function.Injective Ψ := by
    obtain ⟨h, hht, hhI⟩ := exists_algHom_quotient_pow_idealOfVars σ b t ht n
    have hle : idealOfVars ι R ^ (n + 2) ≤ idealOfVars ι R ^ n :=
      Ideal.pow_le_pow_right (by omega)
    let h₀ : S →ₐ[R] MvPolynomial ι R ⧸ idealOfVars ι R ^ n :=
      (Ideal.Quotient.factorₐ R hle).comp h
    have hkill : ∀ s ∈ RingHom.ker σ ^ n, h₀ s = 0 := by
      intro s hs
      have hmap : (RingHom.ker σ ^ n).map h ≤
          (idealOfVars ι R ^ n).map (Ideal.Quotient.mk (idealOfVars ι R ^ (n + 2))) := by
        rw [Ideal.map_pow, Ideal.map_pow]
        exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr hhI) n
      obtain ⟨p, hpJ, hp⟩ := (Ideal.mem_map_iff_of_surjective _
        Ideal.Quotient.mk_surjective).mp (hmap (Ideal.mem_map_of_mem h hs))
      change Ideal.Quotient.factor hle (h s) = 0
      rw [← hp, Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact hpJ
    let hbar : S ⧸ RingHom.ker σ ^ n →ₐ[R] MvPolynomial ι R ⧸ idealOfVars ι R ^ n :=
      Ideal.Quotient.liftₐ (RingHom.ker σ ^ n) h₀ hkill
    have hleft : hbar.comp Ψ = AlgHom.id R _ := by
      apply Ideal.Quotient.algHom_ext R
      apply MvPolynomial.algHom_ext
      intro i
      change hbar (Ψ (Ideal.Quotient.mk _ (X i))) = Ideal.Quotient.mk _ (X i)
      rw [hΨ, aeval_X]
      change Ideal.Quotient.factor hle (h (t i)) = _
      rw [hht, Ideal.Quotient.factor_mk]
    exact Function.LeftInverse.injective (g := hbar) fun a => AlgHom.congr_fun hleft a
  have hsurj : Function.Surjective Ψ := by
    intro a
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨p, hp⟩ := exists_sub_aeval_mem_ker_pow σ b t ht n s
    exact ⟨Ideal.Quotient.mk _ p, by rw [hΨ]; exact (Ideal.Quotient.eq.mpr hp).symm⟩
  exact ⟨hinj, hsurj⟩

/-- **The truncated comparison isomorphisms.** Let `S` be formally smooth over `R`, with a
section `σ` whose kernel `I` has conormal module with basis `b`, the classes of `t_i ∈ I`. Then
evaluation `X_i ↦ t_i` induces an `R`-algebra isomorphism `R[X] ⧸ (X)ⁿ ≃ S ⧸ Iⁿ`
(`quotientPowAevalHom`, which is bijective by `bijective_quotientPowAevalHom`). -/
public noncomputable def quotientPowAevalEquiv [Algebra.FormallySmooth R S] [Fintype ι]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (n : ℕ) : (MvPolynomial ι R ⧸ idealOfVars ι R ^ n) ≃ₐ[R] (S ⧸ RingHom.ker σ ^ n) :=
  AlgEquiv.ofBijective _ (bijective_quotientPowAevalHom σ b t ht n)

/-- `quotientPowAevalEquiv σ b t ht n` sends the class of `f` to the class of `aeval t f`. -/
@[simp]
public theorem quotientPowAevalEquiv_mk [Algebra.FormallySmooth R S] [Fintype ι]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (n : ℕ) (f : MvPolynomial ι R) :
    quotientPowAevalEquiv σ b t ht n (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ (aeval t f) :=
  rfl

/-- The inverse limit of the truncated comparison isomorphisms `quotientPowAevalEquiv`: the
`R`-algebra isomorphism from the `(X)`-adic completion of `R[X]` to the `ker σ`-adic completion
of `S`. -/
public noncomputable def adicCompletionQuotientPowEquiv [Algebra.FormallySmooth R S] [Fintype ι]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i) :
    AdicCompletion (idealOfVars ι R) (MvPolynomial ι R) ≃ₐ[R]
      AdicCompletion (RingHom.ker σ) S :=
  AdicCompletion.algEquivOfQuotientPow _ _ (quotientPowAevalEquiv σ b t ht)
    (by classical exact fun hmn =>
      factorₐ_comp_eq_comp_factorₐ σ t _ (quotientPowAevalEquiv_mk σ b t ht) hmn)

/-- The `n`-th truncation of `adicCompletionQuotientPowEquiv` is `quotientPowAevalEquiv … n`. -/
public theorem evalₐ_adicCompletionQuotientPowEquiv [Algebra.FormallySmooth R S] [Fintype ι]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (n : ℕ) (x : AdicCompletion (idealOfVars ι R) (MvPolynomial ι R)) :
    AdicCompletion.evalₐ _ n (adicCompletionQuotientPowEquiv σ b t ht x) =
      quotientPowAevalEquiv σ b t ht n (AdicCompletion.evalₐ _ n x) :=
  AdicCompletion.evalₐ_algEquivOfQuotientPow _ _ _
    (by classical exact fun hmn =>
      factorₐ_comp_eq_comp_factorₐ σ t _ (quotientPowAevalEquiv_mk σ b t ht) hmn) n x

/-- `adicCompletionQuotientPowEquiv` sends `of p` to `of (aeval t p)`. -/
@[simp]
public theorem adicCompletionQuotientPowEquiv_of [Algebra.FormallySmooth R S] [Fintype ι]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (p : MvPolynomial ι R) :
    adicCompletionQuotientPowEquiv σ b t ht (AdicCompletion.of _ _ p) =
      AdicCompletion.of _ _ (aeval t p) := by
  refine AdicCompletion.ext_evalₐ fun n => ?_
  rw [evalₐ_adicCompletionQuotientPowEquiv, AdicCompletion.evalₐ_of, AdicCompletion.evalₐ_of,
    quotientPowAevalEquiv_mk]

/-- **The completed comparison isomorphism.** Let `S` be formally smooth over `R`, with a
section `σ` whose kernel `I` has conormal module with basis `b`, the classes of `t_i ∈ I`. The
`R`-algebra isomorphism `Ŝ_I ≃ R⟦X⟧` from the `I`-adic completion of `S` to the power series
ring: the inverse of the inverse limit of the truncated isomorphisms `quotientPowAevalEquiv`,
followed by the identification of `R⟦X⟧` with the `(X)`-adic completion of `R[X]`. -/
public noncomputable def adicCompletionEquivMvPowerSeries [Algebra.FormallySmooth R S]
    [Fintype ι] (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i) :
    AdicCompletion (RingHom.ker σ) S ≃ₐ[R] MvPowerSeries ι R :=
  (adicCompletionQuotientPowEquiv σ b t ht).symm.trans
    ((MvPowerSeries.toAdicCompletionAlgEquiv ι R).restrictScalars R).symm

private theorem adicCompletionEquivMvPowerSeries_apply [Algebra.FormallySmooth R S] [Fintype ι]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (x : AdicCompletion (RingHom.ker σ) S) :
    adicCompletionEquivMvPowerSeries σ b t ht x =
      ((MvPowerSeries.toAdicCompletionAlgEquiv ι R).restrictScalars R).symm
        ((adicCompletionQuotientPowEquiv σ b t ht).symm x) :=
  rfl

/-- The completed comparison isomorphism sends the parameter `t i` to the variable `X i`. -/
@[simp]
public theorem adicCompletionEquivMvPowerSeries_of_parameter [Algebra.FormallySmooth R S]
    [Fintype ι] (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (i : ι) :
    adicCompletionEquivMvPowerSeries σ b t ht (AdicCompletion.of (RingHom.ker σ) S (t i)) =
      MvPowerSeries.X i := by
  rw [adicCompletionEquivMvPowerSeries_apply, AlgEquiv.symm_apply_eq, AlgEquiv.symm_apply_eq]
  change _ = adicCompletionQuotientPowEquiv σ b t ht
    (MvPowerSeries.toAdicCompletion ι R (MvPowerSeries.X i))
  rw [← MvPolynomial.coe_X, MvPowerSeries.toAdicCompletion_coe,
    adicCompletionQuotientPowEquiv_of, aeval_X]

/-- The constant coefficient of the completed comparison isomorphism is evaluation by `σ`. -/
@[simp]
public theorem constantCoeff_adicCompletionEquivMvPowerSeries_of [Algebra.FormallySmooth R S]
    [Fintype ι] (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i)
    (x : S) :
    MvPowerSeries.constantCoeff
      (adicCompletionEquivMvPowerSeries σ b t ht (AdicCompletion.of (RingHom.ker σ) S x)) =
      σ x := by
  classical
  let E := adicCompletionEquivMvPowerSeries σ b t ht
  refine apply_eq_of_forall_mem_ker σ (MvPowerSeries.constantCoeff.comp
    (E.toAlgHom.toRingHom.comp (algebraMap S (AdicCompletion (RingHom.ker σ) S)))) ?_ ?_ x
  · intro r
    change MvPowerSeries.constantCoeff (E (algebraMap S _ (algebraMap R S r))) = r
    rw [← IsScalarTower.algebraMap_apply, AlgEquiv.commutes, MvPowerSeries.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply, MvPowerSeries.constantCoeff_C]
  · intro y hy
    change MvPowerSeries.constantCoeff (E (AdicCompletion.of _ _ y)) = 0
    refine constantCoeff_eq_zero_of_evalₐ_one _ ((quotientPowAevalEquiv σ b t ht 1).injective ?_)
    rw [adicCompletionEquivMvPowerSeries_apply,
      show ∀ z, MvPowerSeries.toAdicCompletion ι R
        (((MvPowerSeries.toAdicCompletionAlgEquiv ι R).restrictScalars R).symm z) = z from
        ((MvPowerSeries.toAdicCompletionAlgEquiv ι R).restrictScalars R).apply_symm_apply,
      ← evalₐ_adicCompletionQuotientPowEquiv, AlgEquiv.apply_symm_apply, map_zero,
      AdicCompletion.evalₐ_of, Ideal.Quotient.eq_zero_iff_mem, pow_one]
    exact hy

end

/-- Let `S` be a smooth `R`-algebra with a section `σ : S →ₐ[R] R`, and let `t : ι → S` be
elements of `ker σ` whose classes form the basis `b` of the conormal module `(ker σ).Cotangent`.
Then the `R`-algebra isomorphisms `quotientPowAevalEquiv : R[X] ⧸ (X)ⁿ ≃ S ⧸ (ker σ)ⁿ` are induced
by evaluation `Xᵢ ↦ tᵢ`, and the `R`-algebra isomorphism `adicCompletionEquivMvPowerSeries` from
the `ker σ`-adic completion of `S` to `R⟦X⟧` built from them sends `tᵢ` to `Xᵢ` and has constant
coefficient evaluation by `σ`. -/
@[mmp "lem_mmp_foundation_smooth_point_completion"]
public theorem adicCompletionEquivMvPowerSeries_spec
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Algebra.Smooth R S]
    (σ : S →ₐ[R] R) {ι : Type*} [Fintype ι]
    (b : Module.Basis ι R (RingHom.ker σ).Cotangent) (t : ι → S)
    (ht : ∀ i, ∃ hi : t i ∈ RingHom.ker σ, (RingHom.ker σ).toCotangent ⟨t i, hi⟩ = b i) :
    (∀ (n : ℕ) (f : MvPolynomial ι R),
      quotientPowAevalEquiv σ b t ht n (Ideal.Quotient.mk _ f) =
        Ideal.Quotient.mk _ (aeval t f)) ∧
    (∀ i, adicCompletionEquivMvPowerSeries σ b t ht (AdicCompletion.of (RingHom.ker σ) S (t i)) =
      MvPowerSeries.X i) ∧
    ∀ x : S, MvPowerSeries.constantCoeff
      (adicCompletionEquivMvPowerSeries σ b t ht (AdicCompletion.of (RingHom.ker σ) S x)) = σ x :=
  ⟨quotientPowAevalEquiv_mk σ b t ht, adicCompletionEquivMvPowerSeries_of_parameter σ b t ht,
    constantCoeff_adicCompletionEquivMvPowerSeries_of σ b t ht⟩

end MMP

end

/-!
## The completed strict henselization of a normal local ring

Let `A` be a normal local ring essentially of finite type over a field `k`, let `κ^sep` be a
separable closure of its residue field, let `H = A^{sh}` be the strict henselization of `A` with
respect to `κ ⊆ κ^sep`, and let `R = Ĥ` be the completion of `H` at its maximal ideal. Then `H`
and `R` are Noetherian normal local domains, the local maps `A → H → R` are faithfully flat and
carry the maximal ideal onto the maximal ideal by extension, and `A` is regular if and only if `R`
is regular.

### Main results

* `MMP.Foundations.isNoetherianRing_strictHenselization_adicCompletion`: the statement above.

### Implementation notes

The strict henselization is any local `A`-algebra `H` with
`IsLocalRing.IsHenselization A κsep H`, for `κsep` a separable closure (`IsSepClosure`) of the
residue field of `A`; it is unique up to unique isomorphism, so nothing depends on the choice.
The completion is `AdicCompletion (maximalIdeal H) H`. Since locality of the completion is part of
the conclusion rather than an instance available in the statement, the maximal-ideal clause for
`H → R` is stated under an existential over the (proof-irrelevant) `IsLocalRing R` witness.

### References

* [Stacks Project, Tags 04GQ, 06LJ, 07NZ]
-/

section

universe u v w

open IsLocalRing

namespace MMP.Foundations.Internal.StrictHenselCompletedNormalLocal

/-- Noetherianity, normality and regularity pass from a Noetherian local ring to a strict
henselization in an arbitrary universe, by lifting both rings to a common universe. -/
private theorem strictHenselization_facts
    (R : Type u) (L : Type v) (H : Type w)
    [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [Field L] [Algebra (ResidueField R) L] [IsSepClosure (ResidueField R) L]
    [CommRing H] [IsLocalRing H] [Algebra R H] [IsHenselization R L H] :
    IsNoetherianRing H ∧
      (IsDomain R ∧ IsIntegrallyClosed R → IsDomain H ∧ IsIntegrallyClosed H) ∧
      (IsRegularLocalRing R ↔ IsRegularLocalRing H) := by
  let R' := ULift.{w} R
  let H' := ULift.{u} H
  let eR : R' ≃+* R := ULift.ringEquiv
  let eH : H' ≃+* H := ULift.ringEquiv
  let : IsLocalRing R' := eR.symm.isLocalRing
  let : IsLocalRing H' := eH.symm.isLocalRing
  let : IsNoetherianRing R' := isNoetherianRing_of_ringEquiv R eR.symm
  let : Algebra R' H' := ((algebraMap R H').comp eR.toRingHom).toAlgebra
  let : Algebra (ResidueField R') L :=
    ((algebraMap (ResidueField R) L).comp (ResidueField.mapEquiv eR).toRingHom).toAlgebra
  let : IsHenselization R' L H' := Stacks.Henselization.Shared.isHenselization_ulift R L H
  let : IsSepClosure (ResidueField R') L :=
    { sep_closed := IsSepClosure.sep_closed (ResidueField R)
      separable := Algebra.IsSeparable.of_equiv_equiv
        (ResidueField.mapEquiv eR).symm (RingEquiv.refl L) (by
          ext a
          change algebraMap (ResidueField R) L
            ((ResidueField.mapEquiv eR) ((ResidueField.mapEquiv eR).symm a)) = _
          rw [RingEquiv.apply_symm_apply]
          rfl) }
  obtain ⟨Rh, _, _, _, hh⟩ := IsLocalRing.exists_isHenselization_residueField R'
  let := hh
  have hN : IsNoetherianRing H' :=
    (isNoetherianRing_iff_henselizations R' Rh H' L).2.mp inferInstance
  have hNorm := (isNormalDomain_tfae_henselization_strictHenselization R' Rh H' L).out 1 3
  have hReg := (isRegularLocalRing_iff_henselizations R' Rh H' L).2
  refine ⟨isNoetherianRing_of_ringEquiv H' eH, fun ⟨_, _⟩ => ?_,
    ⟨fun _ => have := hReg.mp (.of_ringEquiv eR.symm); .of_ringEquiv eH,
      fun _ => have := hReg.mpr (.of_ringEquiv eH.symm); .of_ringEquiv eR⟩⟩
  obtain ⟨_, _⟩ := hNorm.mp
    ⟨eR.injective.isDomain eR.toRingHom, IsIntegrallyClosed.of_equiv eR.symm⟩
  exact ⟨eH.symm.injective.isDomain eH.symm.toRingHom, IsIntegrallyClosed.of_equiv eH⟩

end MMP.Foundations.Internal.StrictHenselCompletedNormalLocal

namespace MMP.Foundations

open MMP.Foundations.Internal.StrictHenselCompletedNormalLocal in
/-- Let `A` be a normal local ring essentially of finite type over a field `k`, `H` a strict
henselization of `A` for a separable closure `κsep` of its residue field, and `R` the
`𝔪_H`-adic completion of `H`. Then `H` and `R` are Noetherian normal local domains, the local
maps `A → H → R` are faithfully flat with `𝔪_A H = 𝔪_H` and `𝔪_H R = 𝔪_R`, and `A` is a regular
local ring if and only if `R` is. -/
@[mmp "lem_mmp_foundation_strict_hensel_completed_normal_local"]
public theorem isNoetherianRing_strictHenselization_adicCompletion
    (k : Type*) [Field k] (A : Type*) [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsIntegrallyClosed A] [Algebra k A] [Algebra.EssFiniteType k A]
    (κsep : Type*) [Field κsep] [Algebra (ResidueField A) κsep]
    [IsSepClosure (ResidueField A) κsep]
    (H : Type*) [CommRing H] [IsLocalRing H] [Algebra A H] [IsHenselization A κsep H] :
    (IsNoetherianRing H ∧ IsDomain H ∧ IsIntegrallyClosed H) ∧
    (IsLocalHom (algebraMap A H) ∧ Module.FaithfullyFlat A H ∧
      (maximalIdeal A).map (algebraMap A H) = maximalIdeal H) ∧
    ∃ _ : IsLocalRing (AdicCompletion (maximalIdeal H) H),
      (IsNoetherianRing (AdicCompletion (maximalIdeal H) H) ∧
        IsDomain (AdicCompletion (maximalIdeal H) H) ∧
        IsIntegrallyClosed (AdicCompletion (maximalIdeal H) H)) ∧
      (IsLocalHom (algebraMap H (AdicCompletion (maximalIdeal H) H)) ∧
        Module.FaithfullyFlat H (AdicCompletion (maximalIdeal H) H) ∧
        (maximalIdeal H).map (algebraMap H (AdicCompletion (maximalIdeal H) H)) =
          maximalIdeal (AdicCompletion (maximalIdeal H) H)) ∧
      (IsRegularLocalRing A ↔ IsRegularLocalRing (AdicCompletion (maximalIdeal H) H)) := by
  -- `A` is a Noetherian local G-ring.
  have : IsNoetherianRing A := Algebra.EssFiniteType.isNoetherianRing k A
  have hGA : IsGRing A := isGRing_of_essFiniteType (isGRing_basic_examples.{_, 0}.1 k)
  obtain ⟨hNH, hnormH, hregAH⟩ := strictHenselization_facts A κsep H
  obtain ⟨_, _⟩ := hnormH ⟨inferInstance, inferInstance⟩
  have hlocAH : IsLocalHom (algebraMap A H) := IsHenselization.isLocalHom (L := κsep)
  -- The completion `R = Ĥ`.
  let R := AdicCompletion (maximalIdeal H) H
  have : Module.Flat H R := AdicCompletion.flat_of_isNoetherian _
  -- `H` is a G-ring, so `H → Ĥ` is a regular ring map and `Ĥ` is normal.
  obtain ⟨Ah, _, _, _, _⟩ := IsLocalRing.exists_isHenselization_residueField A
  have hGH : IsGRing H := (isGRing_henselization_and_strictHenselization A Ah H κsep hGA).2
  have hreg :=
    isRegularRingHom_algebraMap_iff.mp ((isGRing_iff_isRegularRingHom_completion H).mp hGH)
  have hnormR : IsNormalRing R :=
    isNormalRing_of_flat_of_isGeometricallyRegular_fiber H R
      (IsNormalRing.of_isIntegrallyClosed H) (fun p _ => (hreg.2 p).2)
  obtain ⟨_, _⟩ := hnormR.of_isLocalRing
  refine ⟨⟨hNH, inferInstance, inferInstance⟩,
    ⟨hlocAH, IsHenselization.faithfullyFlat (L := κsep),
      IsHenselization.map_maximalIdeal (L := κsep)⟩,
    inferInstance, ⟨inferInstance, inferInstance, inferInstance⟩,
    ⟨inferInstance, Module.FaithfullyFlat.of_flat_of_isLocalHom,
      (AdicCompletion.maximalIdeal_eq_map (R := H)).symm⟩,
    hregAH.trans isRegularLocalRing_iff_adicCompletion_maximalIdeal⟩

end MMP.Foundations

end

/-!
## Compact perturbations of surjections have finite-dimensional cokernel

Let `E` and `F` be Banach spaces over `ℝ` or `ℂ`. Let `u : E →L[𝕜] F` be a surjective
continuous linear map and `v : E →L[𝕜] F` a compact operator. Then the image of `u + v`
has finite codimension, i.e. `F ⧸ range (u + v)` is finite dimensional. This is the
lemma of L. Schwartz used in Cartan–Serre's proof that cohomology of coherent sheaves
on compact complex spaces is finite dimensional.

### Main results

* `MMP.finiteDimensional_quotient_range_add_of_surjective_of_isCompactOperator`

### Implementation notes

The source states the result over `ℂ`. Here the scalars are any `RCLike` field, which
covers both `ℝ` and `ℂ`. The proof is the same over both.

### References

* [L. Schwartz, *Homomorphismes et applications complètement continues*][Schwartz1953]
* [J.-P. Serre, *Géométrie algébrique et géométrie analytique*][Serre1956]
-/

section

open Filter Topology Metric Function

namespace MMP.Internal.GagaBanachSchwartz

/-- A continuous linear map out of a Banach space whose every `y` has an approximate
preimage of norm `≤ C‖y‖` with error `≤ ‖y‖ / 2` is surjective. This is the iteration
step of the proof of `ContinuousLinearMap.exists_preimage_norm_le`. -/
private theorem surjective_of_exists_approx_preimage_norm_le
    {𝕜 X Y : Type*} [NontriviallyNormedField 𝕜]
    [NormedAddCommGroup X] [NormedSpace 𝕜 X] [CompleteSpace X]
    [NormedAddCommGroup Y] [NormedSpace 𝕜 Y]
    (f : X →L[𝕜] Y) (C : ℝ) (hC : ∀ y, ∃ x, dist (f x) y ≤ 1 / 2 * ‖y‖ ∧ ‖x‖ ≤ C * ‖y‖) :
    Surjective f := by
  choose g hg using hC
  let h y := y - f (g y)
  have hle : ∀ y, ‖h y‖ ≤ 1 / 2 * ‖y‖ := by
    intro y
    rw [← dist_eq_norm, dist_comm]
    exact (hg y).1
  intro y
  have hnle : ∀ n : ℕ, ‖h^[n] y‖ ≤ (1 / 2) ^ n * ‖y‖ := by
    intro n
    induction n with
    | zero => simp
    | succ n IH =>
      rw [iterate_succ']
      apply le_trans (hle _) _
      rw [pow_succ', mul_assoc]
      gcongr
  let w n := g (h^[n] y)
  have wle : ∀ n, ‖w n‖ ≤ (1 / 2) ^ n * (|C| * ‖y‖) := fun n ↦ by
    apply le_trans (hg _).2
    calc
      C * ‖h^[n] y‖ ≤ |C| * ‖h^[n] y‖ := by gcongr; exact le_abs_self C
      _ ≤ |C| * ((1 / 2) ^ n * ‖y‖) := by gcongr; exact hnle n
      _ = (1 / 2) ^ n * (|C| * ‖y‖) := by ring
  have sNw : Summable fun n => ‖w n‖ :=
    .of_nonneg_of_le (fun n => norm_nonneg _) wle
      (Summable.mul_right _ (summable_geometric_of_lt_one (by norm_num) (by norm_num)))
  have sw : Summable w := sNw.of_norm
  have fsumeq : ∀ n : ℕ, f (∑ i ∈ Finset.range n, w i) = y - h^[n] y := by
    intro n
    induction n with
    | zero => simp
    | succ n IH => rw [Finset.sum_range_succ, f.map_add, IH, iterate_succ_apply', sub_add]
  have L₁ : Tendsto (fun n => f (∑ i ∈ Finset.range n, w i)) atTop (𝓝 (f (∑' n, w n))) :=
    (f.continuous.tendsto _).comp sw.hasSum.tendsto_sum_nat
  simp only [fsumeq] at L₁
  have L₂ : Tendsto (fun n => y - h^[n] y) atTop (𝓝 (y - 0)) := by
    refine tendsto_const_nhds.sub ?_
    rw [tendsto_iff_norm_sub_tendsto_zero]
    simp only [sub_zero]
    refine squeeze_zero (fun _ => norm_nonneg _) hnle ?_
    rw [← zero_mul ‖y‖]
    exact (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)).mul
      tendsto_const_nhds
  exact ⟨_, by simpa using tendsto_nhds_unique L₁ L₂⟩

/-- The heart of Schwartz's lemma: the range of a compact perturbation `u + v` of a
surjection `u` between Banach spaces is supplemented by the span of a finite set. -/
private theorem exists_finite_range_add_sup_span_eq_top
    {𝕜 E F : Type*} [RCLike 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E] [CompleteSpace E]
    [NormedAddCommGroup F] [NormedSpace 𝕜 F] [CompleteSpace F]
    {u v : E →L[𝕜] F} (hu : Surjective u) (hv : IsCompactOperator v) :
    ∃ t : Set F, t.Finite ∧ LinearMap.range (u + v).toLinearMap ⊔ Submodule.span 𝕜 t = ⊤ := by
  classical
  obtain ⟨c, hc, hpre⟩ := u.exists_preimage_norm_le hu
  obtain ⟨K, hK, hvK⟩ := hv.image_closedBall_subset_compact 1
  obtain ⟨t, -, htf, hKt⟩ :=
    finite_cover_balls_of_compact hK (show (0 : ℝ) < 1 / (2 * c) by positivity)
  have := htf.fintype
  let L : (t → 𝕜) →L[𝕜] F :=
    LinearMap.toContinuousLinearMap (Fintype.linearCombination 𝕜 (fun i : t => (i : F)))
  let T : E × (t → 𝕜) →L[𝕜] F :=
    (u + v).comp (ContinuousLinearMap.fst 𝕜 E (t → 𝕜)) -
      L.comp (ContinuousLinearMap.snd 𝕜 E (t → 𝕜))
  have hT : ∀ p, T p = (u + v) p.1 - L p.2 := fun p => rfl
  have hTsurj : Surjective T := by
    refine surjective_of_exists_approx_preimage_norm_le T (c + 1) fun y => ?_
    rcases eq_or_ne y 0 with rfl | hy
    · exact ⟨0, by simp⟩
    obtain ⟨x, hux, hx⟩ := hpre y
    set s : ℝ := c * ‖y‖ with hs
    have spos : 0 < s := by positivity
    have hmem : v ((s : 𝕜)⁻¹ • x) ∈ K := by
      refine hvK ⟨_, ?_, rfl⟩
      rw [mem_closedBall_zero_iff, norm_smul, norm_inv, RCLike.norm_ofReal, abs_of_pos spos]
      exact inv_mul_le_one_of_le₀ hx spos.le
    obtain ⟨b, hbt, hb⟩ := Set.mem_iUnion₂.1 (hKt hmem)
    rw [mem_ball, dist_eq_norm] at hb
    refine ⟨(x, Pi.single ⟨b, hbt⟩ (s : 𝕜)), ?_, ?_⟩
    · have hL : L (Pi.single ⟨b, hbt⟩ (s : 𝕜)) = (s : 𝕜) • b := by
        simp [L, Fintype.linearCombination_apply, Pi.single_apply]
      rw [hT, hL, dist_eq_norm, ContinuousLinearMap.add_apply, hux,
        show y + v x - (s : 𝕜) • b - y = (s : 𝕜) • (v ((s : 𝕜)⁻¹ • x) - b) by
          rw [map_smul, smul_sub, smul_inv_smul₀ (by exact_mod_cast spos.ne')]; abel,
        norm_smul, RCLike.norm_ofReal, abs_of_pos spos]
      calc s * ‖v ((s : 𝕜)⁻¹ • x) - b‖ ≤ s * (1 / (2 * c)) := by gcongr
        _ = 1 / 2 * ‖y‖ := by rw [hs]; field_simp
    · rw [Prod.norm_def, max_le_iff, Pi.norm_single, RCLike.norm_ofReal, abs_of_pos spos]
      constructor <;> nlinarith [norm_nonneg y]
  refine ⟨t, htf, eq_top_iff.2 fun y _ => ?_⟩
  obtain ⟨p, rfl⟩ := hTsurj y
  rw [hT]
  refine Submodule.sub_mem_sup ⟨p.1, rfl⟩ ?_
  have : L p.2 ∈ LinearMap.range (Fintype.linearCombination 𝕜 (fun i : t => (i : F))) :=
    ⟨p.2, rfl⟩
  rwa [Fintype.range_linearCombination, Subtype.range_coe] at this

end MMP.Internal.GagaBanachSchwartz

namespace MMP

open MMP.Internal.GagaBanachSchwartz in
/-- **Schwartz's lemma.** A compact perturbation of a surjective continuous linear map
between Banach spaces has finite-dimensional cokernel. -/
@[mmp "lem_mmp_gaga_banach_schwartz"]
public theorem finiteDimensional_quotient_range_add_of_surjective_of_isCompactOperator
    {𝕜 E F : Type*} [RCLike 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E] [CompleteSpace E]
    [NormedAddCommGroup F] [NormedSpace 𝕜 F] [CompleteSpace F]
    (u v : E →L[𝕜] F) (hu : Function.Surjective u) (hv : IsCompactOperator v) :
    FiniteDimensional 𝕜 (F ⧸ LinearMap.range (u + v).toLinearMap) := by
  obtain ⟨t, ht, htop⟩ := exists_finite_range_add_sup_span_eq_top hu hv
  rw [← Submodule.map_mkQ_eq_top] at htop
  exact Module.finite_def.2 (htop ▸ (Submodule.fg_span ht).map _)

end MMP

end

/-!
## The Cauchy transform, Runge approximation on polyrectangles, and Montel's theorem

Three one-variable tools used in the proof of analytic GAGA.

1. The *Cauchy transform* `u(z, y) = -π⁻¹ ∫_ℂ g(ζ, y) / (ζ - z) dA(ζ)` of a smooth function
   `g` on `ℂ × P`, `P ⊆ ℂ^m` open, whose support in `ζ` lies in a fixed compact set `L`,
   is smooth, solves `∂u/∂z̄ = g`, and is holomorphic in each parameter `y_j` in which `g` is.
   Here `∂/∂z̄ = ½ (∂/∂x + i ∂/∂y)`, written through the real Fréchet derivative in `z`.
2. (*Runge*) On a product `K = K₁ × ⋯ × Kₙ` of standard compacts — closed rectangles,
   closed discs, and closed annuli `{r ≤ |z - c| ≤ R}` with `0 < r < R` — every function
   holomorphic near `K` is a uniform limit on `K` of finite sums `∑ a_β ∏ⱼ (zⱼ - cⱼ)^{βⱼ}`
   with `β ∈ ℤⁿ` and `βⱼ ≥ 0` unless `Kⱼ` is an annulus centred at `cⱼ`.
3. (*Montel*) A sequence of holomorphic functions on an open `Ω ⊆ ℂⁿ`, uniformly bounded
   on each compact subset, has a subsequence converging uniformly on compact subsets to a
   holomorphic function.

### Main results

* `MMP.Gaga.cauchyTransform_runge_montel`: the conjunction of the three statements.

### Implementation notes

The area measure `dA` on `ℂ` is the Lebesgue measure `volume`. Partial holomorphy of a
function `φ` of `y ∈ ℂ^m` in the variable `y_j` at `y` is complex differentiability of
`t ↦ φ (Function.update y j t)` at `t = y j`. In the Runge statement the centres `cⱼ`
of the non-annulus factors are arbitrary: polynomials in `zⱼ - cⱼ` are exactly the
polynomials in `zⱼ`.
-/

section

open MeasureTheory Set Metric Filter Topology
open scoped ContDiff Convolution

namespace MMP.Gaga.Internal.GagaOneVariableTools

/-- The Cauchy kernel `t ↦ -1/t` is locally integrable on `ℂ`. -/
private theorem locallyIntegrable_neg_one_div :
    LocallyIntegrable (fun t : ℂ => -(1 / t)) volume := by
  refine locallyIntegrable_of_norm_le_rpow (C := 1) (α := 1) (by simp) (by simp)
    (Eventually.of_forall fun t => ?_) (by fun_prop)
  simp [Real.rpow_neg_one]

/-- The Cauchy integral `∫ h ζ / (ζ - z)` is the convolution of `h` with the kernel `-1/t`. -/
private theorem integral_div_sub_eq_convolution (h : ℂ → ℂ) (z : ℂ) :
    ∫ ζ : ℂ, h ζ / (ζ - z) =
      ((fun t : ℂ => -(1 / t)) ⋆[ContinuousLinearMap.mul ℝ ℂ, volume] h) z := by
  rw [convolution_def, ← integral_sub_left_eq_self _ volume z]
  congr 1; ext t
  simp only [ContinuousLinearMap.mul_apply']
  rw [sub_sub_cancel_left, div_neg]
  ring

/-- Smoothness of the Cauchy transform with parameters. -/
private theorem cauchyTransform_contDiffOn (m : ℕ) (P : Set (Fin m → ℂ)) (L : Set ℂ)
    (g : ℂ × (Fin m → ℂ) → ℂ) (hP : IsOpen P) (hL : IsCompact L)
    (hg : ContDiffOn ℝ ∞ g (univ ×ˢ P)) (hg0 : ∀ ζ ∉ L, ∀ y ∈ P, g (ζ, y) = 0) :
    ContDiffOn ℝ ∞ (fun p : ℂ × (Fin m → ℂ) =>
      -(1 / (Real.pi : ℂ)) * ∫ ζ : ℂ, g (ζ, p.2) / (ζ - p.1)) (univ ×ˢ P) := by
  let G : (Fin m → ℂ) → ℂ → ℂ := fun y ζ => g (ζ, y)
  have hG : ContDiffOn ℝ (⊤ : ℕ∞) (↿G) (P ×ˢ univ) := by
    have hmap : MapsTo (fun q : (Fin m → ℂ) × ℂ => (q.2, q.1)) (P ×ˢ univ) (univ ×ˢ P) :=
      fun q hq => ⟨mem_univ _, hq.1⟩
    exact hg.comp ((contDiff_snd.prodMk contDiff_fst :
      ContDiff ℝ ∞ fun q : (Fin m → ℂ) × ℂ => (q.2, q.1)).contDiffOn) hmap
  have h1 := contDiffOn_convolution_right_with_param (μ := volume) (n := ⊤)
    (ContinuousLinearMap.mul ℝ ℂ) (g := G) hP hL (fun p x hp hx => hg0 x hx p hp)
    locallyIntegrable_neg_one_div hG
  have hmap : MapsTo (fun q : ℂ × (Fin m → ℂ) => (q.2, q.1)) (univ ×ˢ P) (P ×ˢ univ) :=
    fun q hq => ⟨hq.2, mem_univ _⟩
  refine ((contDiffOn_const (c := -(1 / (Real.pi : ℂ)))).mul
    (h1.comp ((contDiff_snd.prodMk contDiff_fst :
      ContDiff ℝ ∞ fun q : ℂ × (Fin m → ℂ) => (q.2, q.1)).contDiffOn) hmap)).congr
    fun q _ => ?_
  simp only [Function.comp]
  rw [integral_div_sub_eq_convolution]

/-- A continuous function vanishing off a compact set, times the Cauchy kernel, is integrable. -/
private theorem integrable_neg_one_div_mul {K : Set ℂ} (hK : IsCompact K) {φ : ℂ → ℂ}
    (hφ : ContinuousOn φ K) (h0 : ∀ τ ∉ K, φ τ = 0) :
    Integrable (fun τ : ℂ => -(1 / τ) * φ τ) := by
  refine ((locallyIntegrable_neg_one_div.integrableOn_isCompact hK).mul_continuousOn hφ
    hK).integrable_of_forall_notMem_eq_zero fun τ hτ => ?_
  simp [h0 τ hτ]

/-- The complex partial derivative in `y j` of a smooth function holomorphic in `y j` is given
by its real derivative in the direction `(0, Pi.single j 1)`. -/
private theorem hasDerivAt_update_of_contDiffOn {m : ℕ} {P : Set (Fin m → ℂ)}
    {g : ℂ × (Fin m → ℂ) → ℂ} (hP : IsOpen P) (hg : ContDiffOn ℝ ∞ g (univ ×ˢ P)) (j : Fin m)
    (hj : ∀ ζ : ℂ, ∀ y ∈ P, DifferentiableAt ℂ (fun t : ℂ => g (ζ, Function.update y j t)) (y j))
    (ζ : ℂ) (y : Fin m → ℂ) (s : ℂ) (hs : Function.update y j s ∈ P) :
    HasDerivAt (fun t : ℂ => g (ζ, Function.update y j t))
      (fderiv ℝ g (ζ, Function.update y j s) ((0 : ℂ), Pi.single j (1 : ℂ))) s := by
  have hd := hj ζ _ hs
  simp only [Function.update_idem, Function.update_self] at hd
  have hC := hd.hasDerivAt
  have hR : HasFDerivAt (fun t : ℂ => g (ζ, Function.update y j t))
      ((fderiv ℝ g (ζ, Function.update y j s)).comp
        ((0 : ℂ →L[ℝ] ℂ).prod (ContinuousLinearMap.pi
          (Pi.single j (ContinuousLinearMap.id ℝ ℂ))))) s := by
    have hgd : DifferentiableAt ℝ g (ζ, Function.update y j s) :=
      (hg.contDiffAt ((isOpen_univ.prod hP).mem_nhds ⟨mem_univ _, hs⟩)).differentiableAt
        (by simp)
    exact hgd.hasFDerivAt.comp s ((hasFDerivAt_const ζ s).prodMk (hasFDerivAt_update y s))
  have hu := (hC.hasFDerivAt.restrictScalars ℝ).unique hR
  have h1 := congrArg (fun T : ℂ →L[ℝ] ℂ => T 1) hu
  simp only [ContinuousLinearMap.coe_restrictScalars', ContinuousLinearMap.smulRight_apply,
    ContinuousLinearMap.one_apply, one_smul, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.prod_apply, ContinuousLinearMap.zero_apply] at h1
  have h2 : (ContinuousLinearMap.pi (Pi.single j (ContinuousLinearMap.id ℝ ℂ) :
      Fin m → ℂ →L[ℝ] ℂ)) (1 : ℂ) = (Pi.single j (1 : ℂ) : Fin m → ℂ) := by
    ext i
    by_cases hi : i = j
    · subst hi; simp
    · simp [Pi.single_apply, hi]
  rw [h2, ContinuousLinearMap.toSpanSingleton_apply, one_smul] at h1
  rw [← h1]
  exact hC

/-- The real derivative of `g` vanishes at points `(ζ, y)` with `ζ ∉ L`, `y ∈ P`. -/
private theorem fderiv_eq_zero_of_notMem {m : ℕ} {P : Set (Fin m → ℂ)} {L : Set ℂ}
    {g : ℂ × (Fin m → ℂ) → ℂ} (hP : IsOpen P) (hL : IsCompact L)
    (hg0 : ∀ ζ ∉ L, ∀ y ∈ P, g (ζ, y) = 0) (ζ : ℂ) (hζ : ζ ∉ L) (y : Fin m → ℂ) (hy : y ∈ P) :
    fderiv ℝ g (ζ, y) = 0 := by
  refine (hasFDerivAt_zero_of_eventually_const 0 ?_).fderiv
  filter_upwards [(hL.isClosed.isOpen_compl.prod hP).mem_nhds (show (ζ, y) ∈ Lᶜ ×ˢ P from
    ⟨hζ, hy⟩)] with q hq
  exact hg0 q.1 hq.1 q.2 hq.2

/-- Holomorphy of the Cauchy transform in each parameter in which `g` is holomorphic. -/
private theorem cauchyTransform_differentiableAt (m : ℕ) (P : Set (Fin m → ℂ)) (L : Set ℂ)
    (g : ℂ × (Fin m → ℂ) → ℂ) (hP : IsOpen P) (hL : IsCompact L)
    (hg : ContDiffOn ℝ ∞ g (univ ×ˢ P)) (hg0 : ∀ ζ ∉ L, ∀ y ∈ P, g (ζ, y) = 0) (j : Fin m)
    (hj : ∀ ζ : ℂ, ∀ y ∈ P, DifferentiableAt ℂ (fun t : ℂ => g (ζ, Function.update y j t)) (y j))
    (z : ℂ) (y : Fin m → ℂ) (hy : y ∈ P) :
    DifferentiableAt ℂ (fun t : ℂ =>
      -(1 / (Real.pi : ℂ)) * ∫ ζ : ℂ, g (ζ, Function.update y j t) / (ζ - z)) (y j) := by
  have hconv : ∀ t : ℂ, ∫ ζ : ℂ, g (ζ, Function.update y j t) / (ζ - z) =
      ∫ τ : ℂ, -(1 / τ) * g (z - τ, Function.update y j t) := fun t => by
    rw [integral_div_sub_eq_convolution, convolution_def]
    simp only [ContinuousLinearMap.mul_apply']
  simp_rw [hconv]
  refine DifferentiableAt.const_mul ?_ _
  -- the parameter neighbourhood
  have hV : IsOpen {s : ℂ | Function.update y j s ∈ P} :=
    hP.preimage (continuous_const.update j continuous_id)
  obtain ⟨δ, hδ, hδV⟩ := Metric.isOpen_iff.mp hV (y j) (by simpa using hy)
  have hδV' : closedBall (y j) (δ / 2) ⊆ {s : ℂ | Function.update y j s ∈ P} :=
    (closedBall_subset_ball (by linarith)).trans hδV
  -- the compact support in `τ`
  set Kt : Set ℂ := (fun ζ => z - ζ) '' L
  have hKt : IsCompact Kt := hL.image (by fun_prop)
  have hKt' : ∀ τ, z - τ ∈ L → τ ∈ Kt := fun τ hτ => ⟨z - τ, hτ, by ring⟩
  -- a bound for the derivative of `g`
  set Kd : Set (ℂ × (Fin m → ℂ)) :=
    L ×ˢ ((fun s => Function.update y j s) '' closedBall (y j) (δ / 2))
  have hKd : IsCompact Kd :=
    hL.prod ((isCompact_closedBall _ _).image (continuous_const.update j continuous_id))
  have hKdP : Kd ⊆ univ ×ˢ P := by
    rintro ⟨ζ, w⟩ ⟨-, s, hs, rfl⟩
    exact ⟨mem_univ _, hδV' hs⟩
  obtain ⟨C, hC⟩ := hKd.exists_bound_of_continuousOn
    ((hg.continuousOn_fderiv_of_isOpen (isOpen_univ.prod hP) (by simp)).mono hKdP)
  set v : ℂ × (Fin m → ℂ) := ((0 : ℂ), Pi.single j (1 : ℂ))
  have hcont : ∀ w ∈ P, Continuous fun τ : ℂ => g (z - τ, w) := fun w hw =>
    hg.continuousOn.comp_continuous (by fun_prop) fun τ => ⟨mem_univ _, hw⟩
  have hcont' : ∀ w ∈ P, Continuous fun τ : ℂ => fderiv ℝ g (z - τ, w) v := fun w hw =>
    ((hg.continuousOn_fderiv_of_isOpen (isOpen_univ.prod hP) (by simp)).comp_continuous
      (by fun_prop) fun τ => ⟨mem_univ _, hw⟩).clm_apply continuous_const
  have hmeas := locallyIntegrable_neg_one_div.aestronglyMeasurable
  have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
    (F := fun (t : ℂ) (τ : ℂ) => -(1 / τ) * g (z - τ, Function.update y j t))
    (F' := fun (t : ℂ) (τ : ℂ) => -(1 / τ) * fderiv ℝ g (z - τ, Function.update y j t) v)
    (x₀ := y j) (s := ball (y j) (δ / 2))
    (bound := Kt.indicator fun τ => ‖-(1 / τ)‖ * (C * ‖v‖))
    (ball_mem_nhds _ (by positivity))
    (by
      filter_upwards [ball_mem_nhds (y j) hδ] with t ht
      exact hmeas.mul (hcont _ (hδV ht)).aestronglyMeasurable)
    (by
      simp only [Function.update_eq_self]
      exact integrable_neg_one_div_mul hKt (hcont y hy).continuousOn fun τ hτ =>
        hg0 _ (fun h => hτ (hKt' τ h)) y hy)
    (by
      simp only [Function.update_eq_self]
      exact hmeas.mul (hcont' y hy).aestronglyMeasurable)
    (Eventually.of_forall fun τ t ht => by
      have htP : Function.update y j t ∈ P := hδV' (ball_subset_closedBall ht)
      by_cases hτ : τ ∈ Kt
      · rw [indicator_of_mem hτ, norm_mul]
        refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
        obtain ⟨ζ, hζ, rfl⟩ := hτ
        refine (ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (hC _ ⟨by simpa using hζ, t,
            ball_subset_closedBall ht, rfl⟩) (norm_nonneg _))
      · rw [indicator_of_notMem hτ, fderiv_eq_zero_of_notMem hP hL hg0 _
          (fun h => hτ (hKt' τ h)) _ htP]
        simp)
    ((integrable_indicator_iff hKt.isClosed.measurableSet).mpr
      ((locallyIntegrable_neg_one_div.integrableOn_isCompact hKt).norm.mul_const _))
    (Eventually.of_forall fun τ t ht => by
      have htP : Function.update y j t ∈ P := hδV' (ball_subset_closedBall ht)
      exact (hasDerivAt_update_of_contDiffOn hP hg j hj (z - τ) y t htP).const_mul _)
  exact key.2.differentiableAt

/-- A continuous function on `ℝ × ℝ` vanishing for large first coordinate is integrable on the
target of polar coordinates. -/
private theorem integrableOn_polarTarget {F : ℝ × ℝ → ℂ} (hF : Continuous F) (R : ℝ)
    (hR : ∀ p : ℝ × ℝ, R < p.1 → F p = 0) :
    IntegrableOn F (Ioi 0 ×ˢ Ioo (-Real.pi) Real.pi) := by
  refine (hF.continuousOn.integrableOn_compact
    ((isCompact_Icc (a := (0 : ℝ)) (b := R)).prod (isCompact_Icc (a := -Real.pi)
      (b := Real.pi)))).of_forall_diff_eq_zero
    (measurableSet_Ioi.prod measurableSet_Ioo) fun p hp => hR p ?_
  obtain ⟨⟨h1, h2⟩, h3⟩ := hp
  by_contra h
  exact h3 ⟨⟨le_of_lt h1, not_lt.mp h⟩, Ioo_subset_Icc_self h2⟩

private theorem hasDerivAt_cos_add_sin_mul_I (θ : ℝ) :
    HasDerivAt (fun t : ℝ => ((Real.cos t : ℂ) + (Real.sin t : ℂ) * Complex.I))
      (Complex.I * ((Real.cos θ : ℂ) + (Real.sin θ : ℂ) * Complex.I)) θ := by
  have h := ((Real.hasDerivAt_cos θ).ofReal_comp).add
    (((Real.hasDerivAt_sin θ).ofReal_comp).mul_const Complex.I)
  refine h.congr_deriv ?_
  rw [mul_add, mul_comm (Real.sin θ : ℂ) Complex.I, ← mul_assoc, Complex.I_mul_I]
  push_cast
  ring

/-- The derivative of `G` along a line. -/
private theorem hasDerivAt_comp_line {G : ℂ → ℂ} (hG : ContDiff ℝ 1 G) (z c : ℂ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => G (z + s * c)) (fderiv ℝ G (z + t * c) c) t := by
  have h1 : HasDerivAt (fun s : ℝ => z + (s : ℂ) * c) c t := by
    simpa using (((hasDerivAt_id t).ofReal_comp).mul_const c).const_add z
  exact ((hG.differentiable one_ne_zero) _).hasFDerivAt.comp_hasDerivAt t h1

/-- `fderiv` of a function vanishes off its topological support. -/
private theorem fderiv_eq_zero_of_norm_gt {G : ℂ → ℂ} {R : ℝ}
    (hR : tsupport G ⊆ closedBall 0 R) (q : ℂ) (hq : R < ‖q‖) : fderiv ℝ G q = 0 := by
  by_contra h
  have := hR (support_fderiv_subset ℝ h)
  rw [mem_closedBall, dist_zero_right] at this
  linarith

/-- The Cauchy–Pompeiu formula for a compactly supported `C¹` function. -/
private theorem integral_dbar_div_eq {G : ℂ → ℂ} (hG : ContDiff ℝ 1 G) (hcs : HasCompactSupport G)
    (z : ℂ) :
    ∫ w : ℂ, (1 / 2 : ℂ) * (fderiv ℝ G (z + w) 1 + Complex.I * fderiv ℝ G (z + w) Complex.I) / w =
      -(Real.pi : ℂ) * G z := by
  set e : ℝ → ℂ := fun θ => (Real.cos θ : ℂ) + (Real.sin θ : ℂ) * Complex.I
  have he : ∀ θ, ‖e θ‖ = 1 := fun θ => by simpa [e] using Complex.norm_cos_add_sin_mul_I θ
  set D := fderiv ℝ G
  have hDc : Continuous D := hG.continuous_fderiv one_ne_zero
  obtain ⟨R1, hR1⟩ := hcs.isCompact.isBounded.subset_closedBall 0
  set R0 := max R1 0
  have hR0 : tsupport G ⊆ closedBall 0 R0 :=
    hR1.trans (closedBall_subset_closedBall (le_max_left _ _))
  have hR0pos : 0 ≤ R0 := le_max_right _ _
  set A : ℝ × ℝ → ℂ := fun p => (1 / 2 : ℂ) * D (z + p.1 * e p.2) (e p.2)
  set B : ℝ × ℝ → ℂ := fun p => (Complex.I / 2) * D (z + p.1 * e p.2) (Complex.I * e p.2)
  have hec : Continuous e := by fun_prop
  have hvan : ∀ p : ℝ × ℝ, R0 + ‖z‖ < p.1 → D (z + p.1 * e p.2) = 0 := fun p hp =>
    fderiv_eq_zero_of_norm_gt hR0 _ (by
      have h1 : ‖(p.1 : ℂ) * e p.2‖ = p.1 := by
        rw [norm_mul, he, mul_one, Complex.norm_real, Real.norm_eq_abs, abs_of_pos]
        linarith [norm_nonneg z]
      have h2 := norm_sub_norm_le ((p.1 : ℂ) * e p.2) (-z)
      rw [sub_neg_eq_add, norm_neg, add_comm] at h2
      linarith)
  have hA : IntegrableOn A (Ioi 0 ×ˢ Ioo (-Real.pi) Real.pi) :=
    integrableOn_polarTarget (by fun_prop) (R0 + ‖z‖) fun p hp => by simp [A, hvan p hp]
  have hB : IntegrableOn B (Ioi 0 ×ˢ Ioo (-Real.pi) Real.pi) :=
    integrableOn_polarTarget (by fun_prop) (R0 + ‖z‖) fun p hp => by simp [B, hvan p hp]
  rw [← Complex.integral_comp_polarCoord_symm, polarCoord_target]
  have hpt : ∀ p ∈ Ioi (0 : ℝ) ×ˢ Ioo (-Real.pi) Real.pi,
      p.1 • ((1 / 2 : ℂ) * (D (z + Complex.polarCoord.symm p) 1 +
        Complex.I * D (z + Complex.polarCoord.symm p) Complex.I) /
        Complex.polarCoord.symm p) = A p + B p := by
    rintro ⟨ρ, θ⟩ ⟨hρ, -⟩
    simp only [Complex.polarCoord_symm_apply, A, B]
    change (ρ : ℝ) • ((1 / 2 : ℂ) * (D (z + ρ * e θ) 1 + Complex.I * D (z + ρ * e θ) Complex.I) /
      (ρ * e θ)) = _
    set q := z + (ρ : ℂ) * e θ
    have hDe : D q (e θ) = (Real.cos θ : ℂ) * D q 1 + (Real.sin θ : ℂ) * D q Complex.I := by
      have : e θ = (Real.cos θ : ℝ) • (1 : ℂ) + (Real.sin θ : ℝ) • Complex.I := by
        simp [e, Complex.real_smul]
      rw [this, map_add, map_smul, map_smul, Complex.real_smul, Complex.real_smul]
    have hDie : D q (Complex.I * e θ) =
        -(Real.sin θ : ℂ) * D q 1 + (Real.cos θ : ℂ) * D q Complex.I := by
      have : Complex.I * e θ = (-Real.sin θ : ℝ) • (1 : ℂ) + (Real.cos θ : ℝ) • Complex.I := by
        simp only [e, Complex.real_smul]
        rw [mul_add, mul_comm (Real.sin θ : ℂ) Complex.I, ← mul_assoc, Complex.I_mul_I]
        push_cast; ring
      rw [this, map_add, map_smul, map_smul, Complex.real_smul, Complex.real_smul]
      push_cast; ring
    have hne : e θ ≠ 0 := fun h => by simpa [h] using he θ
    have hcs2 : (Real.cos θ : ℂ) ^ 2 + (Real.sin θ : ℂ) ^ 2 = 1 := by
      exact_mod_cast Real.cos_sq_add_sin_sq θ
    have hρ' : (ρ : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hρ)
    rw [hDe, hDie, Complex.real_smul]
    rw [mul_div_assoc', mul_div_mul_comm, div_self hρ', one_mul]
    rw [div_eq_iff hne]
    simp only [e]
    have hI2 : Complex.I ^ 2 = -1 := Complex.I_sq
    linear_combination (-(1 / 2 : ℂ) * (D q 1 + Complex.I * D q Complex.I)) * hcs2 +
      ((D q 1) * (Real.sin θ : ℂ) ^ 2 / 2 - D q Complex.I * (Real.cos θ : ℂ) *
        (Real.sin θ : ℂ) / 2) * hI2
  rw [setIntegral_congr_fun (measurableSet_Ioi.prod measurableSet_Ioo) hpt,
    integral_add hA hB]
  have hAval : ∫ p in Ioi (0 : ℝ) ×ˢ Ioo (-Real.pi) Real.pi, A p = -(Real.pi : ℂ) * G z := by
    rw [Measure.volume_eq_prod, ← Measure.prod_restrict, integral_prod_symm _
      (by rw [Measure.prod_restrict, ← Measure.volume_eq_prod]; exact hA)]
    have hin : ∀ θ : ℝ, ∫ ρ in Ioi (0 : ℝ), A (ρ, θ) = -(1 / 2 : ℂ) * G z := fun θ => by
      have hl : ContDiff ℝ 1 (fun s : ℝ => z + (s : ℂ) * e θ) :=
        contDiff_const.add ((Complex.ofRealCLM.contDiff).mul contDiff_const)
      have hf : ContDiff ℝ 1 (fun s : ℝ => G (z + s * e θ)) := hG.comp hl
      have hiso : Isometry (fun s : ℝ => z + s * e θ) := Isometry.of_dist_eq fun a b => by
        rw [dist_eq_norm, dist_eq_norm, add_sub_add_left_eq_sub, ← sub_mul, norm_mul, he,
          mul_one, ← Complex.ofReal_sub, Complex.norm_real]
      have hcsf : HasCompactSupport (fun s : ℝ => G (z + s * e θ)) :=
        hcs.comp_isClosedEmbedding hiso.isClosedEmbedding
      have hI := HasCompactSupport.integral_Ioi_deriv_eq hf hcsf 0
      have hd : ∀ s : ℝ, deriv (fun s : ℝ => G (z + s * e θ)) s = D (z + s * e θ) (e θ) :=
        fun s => (hasDerivAt_comp_line hG z (e θ) s).deriv
      simp only [hd] at hI
      simp only [A]
      rw [integral_const_mul, hI]
      simp
    simp_rw [hin]
    rw [setIntegral_const, Real.volume_real_Ioo_of_le (by linarith [Real.pi_pos]),
      Complex.real_smul]
    push_cast; ring
  have hBval : ∫ p in Ioi (0 : ℝ) ×ˢ Ioo (-Real.pi) Real.pi, B p = 0 := by
    rw [Measure.volume_eq_prod, ← Measure.prod_restrict, integral_prod _
      (by rw [Measure.prod_restrict, ← Measure.volume_eq_prod]; exact hB)]
    refine (setIntegral_congr_fun measurableSet_Ioi fun ρ hρ => ?_).trans (integral_zero _ _)
    have hρ' : (ρ : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt (show (0 : ℝ) < ρ from hρ))
    have hd : ∀ θ : ℝ, HasDerivAt (fun t : ℝ => G (z + ρ * e t))
        ((ρ : ℂ) * D (z + ρ * e θ) (Complex.I * e θ)) θ := fun θ => by
      have h1 := ((hasDerivAt_cos_add_sin_mul_I θ).const_mul (ρ : ℂ)).const_add z
      have h2 := ((hG.differentiable one_ne_zero) (z + ρ * e θ)).hasFDerivAt.comp_hasDerivAt θ h1
      refine h2.congr_deriv ?_
      rw [show ((ρ : ℂ) * (Complex.I * ((Real.cos θ : ℂ) + (Real.sin θ : ℂ) * Complex.I))) =
        ρ • (Complex.I * e θ) from Complex.real_smul.symm, map_smul, Complex.real_smul]
    have hcont : Continuous fun θ : ℝ => (ρ : ℂ) * D (z + ρ * e θ) (Complex.I * e θ) := by
      fun_prop
    have hpt : ∀ θ : ℝ, B (ρ, θ) =
        (Complex.I / (2 * ρ)) * ((ρ : ℂ) * D (z + ρ * e θ) (Complex.I * e θ)) := fun θ => by
      simp only [B]; field_simp
    simp only [hpt]
    rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le
      (by linarith [Real.pi_pos]), intervalIntegral.integral_const_mul,
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun θ _ => hd θ)
        (hcont.intervalIntegrable _ _)]
    have hpi : e Real.pi = e (-Real.pi) := by simp [e]
    rw [hpi, sub_self, mul_zero]
  rw [hAval, hBval, add_zero]

/-- The Cauchy transform solves `∂u/∂z̄ = g`. -/
private theorem cauchyTransform_dbar (m : ℕ) (P : Set (Fin m → ℂ)) (L : Set ℂ)
    (g : ℂ × (Fin m → ℂ) → ℂ) (hP : IsOpen P) (hL : IsCompact L)
    (hg : ContDiffOn ℝ ∞ g (univ ×ˢ P)) (hg0 : ∀ ζ ∉ L, ∀ y ∈ P, g (ζ, y) = 0)
    (z : ℂ) (y : Fin m → ℂ) (hy : y ∈ P) :
    (1 / 2 : ℂ) * (fderiv ℝ (fun w : ℂ => -(1 / (Real.pi : ℂ)) * ∫ ζ : ℂ, g (ζ, y) / (ζ - w)) z 1 +
      Complex.I * fderiv ℝ (fun w : ℂ => -(1 / (Real.pi : ℂ)) * ∫ ζ : ℂ, g (ζ, y) / (ζ - w)) z
        Complex.I) = g (z, y) := by
  set G : ℂ → ℂ := fun ζ => g (ζ, y)
  have hGc : ContDiff ℝ ∞ G := contDiffOn_univ.mp
    (hg.comp (contDiff_id.prodMk contDiff_const).contDiffOn fun ζ _ => ⟨mem_univ _, hy⟩)
  have hG1 : ContDiff ℝ 1 G := hGc.of_le (by simp)
  have hcs : HasCompactSupport G := HasCompactSupport.intro hL fun ζ hζ => hg0 ζ hζ y hy
  have hfun : (fun w : ℂ => -(1 / (Real.pi : ℂ)) * ∫ ζ : ℂ, g (ζ, y) / (ζ - w)) =
      fun w => -(1 / (Real.pi : ℂ)) *
        ((fun t : ℂ => -(1 / t)) ⋆[ContinuousLinearMap.mul ℝ ℂ, volume] G) w :=
    funext fun w => by rw [integral_div_sub_eq_convolution]
  have hD := hcs.hasFDerivAt_convolution_right (ContinuousLinearMap.mul ℝ ℂ)
    locallyIntegrable_neg_one_div hG1 z
  have hfd : ∀ v : ℂ, fderiv ℝ (fun w => -(1 / (Real.pi : ℂ)) *
      ((fun t : ℂ => -(1 / t)) ⋆[ContinuousLinearMap.mul ℝ ℂ, volume] G) w) z v =
      -(1 / (Real.pi : ℂ)) * ∫ τ : ℂ, -(1 / τ) * fderiv ℝ G (z - τ) v := by
    intro v
    rw [(hD.const_mul _).fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [convolution_precompR_apply _ locallyIntegrable_neg_one_div (hcs.fderiv ℝ)
      (hG1.continuous_fderiv one_ne_zero), convolution_def]
    simp only [ContinuousLinearMap.mul_apply']
  have hint : ∀ v : ℂ, Integrable fun τ : ℂ => -(1 / τ) * fderiv ℝ G (z - τ) v := fun v =>
    integrable_neg_one_div_mul (K := (fun q => z - q) '' tsupport G)
      (hcs.isCompact.image (by fun_prop))
      ((((hG1.continuous_fderiv one_ne_zero).comp (by fun_prop :
        Continuous fun τ : ℂ => z - τ)).clm_apply continuous_const).continuousOn)
      fun τ hτ => by
        have hn : z - τ ∉ tsupport G := fun h => hτ ⟨z - τ, h, by ring⟩
        have h0 : fderiv ℝ G (z - τ) = 0 := by
          by_contra h
          exact hn (support_fderiv_subset ℝ h)
        simp [h0]
  rw [hfun, hfd, hfd]
  calc (1 / 2 : ℂ) * (-(1 / (Real.pi : ℂ)) * (∫ τ : ℂ, -(1 / τ) * fderiv ℝ G (z - τ) 1) +
        Complex.I * (-(1 / (Real.pi : ℂ)) *
          ∫ τ : ℂ, -(1 / τ) * fderiv ℝ G (z - τ) Complex.I))
      = -(1 / (Real.pi : ℂ)) * ((1 / 2 : ℂ) * ((∫ τ : ℂ, -(1 / τ) * fderiv ℝ G (z - τ) 1) +
          ∫ τ : ℂ, Complex.I * (-(1 / τ) * fderiv ℝ G (z - τ) Complex.I))) := by
        rw [integral_const_mul]; ring
    _ = -(1 / (Real.pi : ℂ)) * ∫ τ : ℂ, (1 / 2 : ℂ) * (-(1 / τ) * fderiv ℝ G (z - τ) 1 +
          Complex.I * (-(1 / τ) * fderiv ℝ G (z - τ) Complex.I)) := by
        rw [← integral_add (hint 1) ((hint Complex.I).const_mul Complex.I), integral_const_mul]
    _ = -(1 / (Real.pi : ℂ)) * ∫ w : ℂ, (1 / 2 : ℂ) *
          (fderiv ℝ G (z + w) 1 + Complex.I * fderiv ℝ G (z + w) Complex.I) / w := by
        rw [← integral_neg_eq_self]
        congr 1
        refine integral_congr_ae (Eventually.of_forall fun w => ?_)
        simp only [one_div, inv_neg, sub_neg_eq_add, neg_neg]
        ring
    _ = G z := by
        rw [integral_dbar_div_eq hG1 hcs z]
        have : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
        field_simp

/-- The finite geometric expansion of the Cauchy kernel. -/
private theorem inv_sub_sub_sum_geom (A B : ℂ) (hA : A ≠ 0) (hAB : A - B ≠ 0) (N : ℕ) :
    (A - B)⁻¹ - ∑ k ∈ Finset.range N, B ^ k / A ^ (k + 1) = (B / A) ^ N / (A - B) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, ← sub_sub, ih, div_pow, div_pow]
    field_simp
    ring

/-- A uniform truncation of the geometric expansion of the Cauchy kernel. -/
private theorem exists_geom_trunc (q κ δ : ℝ) (hq0 : 0 ≤ q) (hq : q < 1) (hκ : 0 < κ)
    (hδ : 0 < δ) : ∃ N : ℕ, ∀ A B : ℂ, A ≠ 0 → ‖B‖ ≤ q * ‖A‖ → κ ≤ ‖A - B‖ →
      ‖(A - B)⁻¹ - ∑ k ∈ Finset.range N, B ^ k / A ^ (k + 1)‖ < δ := by
  obtain ⟨N, hN⟩ := ((tendsto_pow_atTop_nhds_zero_of_lt_one hq0 hq).eventually
    (gt_mem_nhds (show (0 : ℝ) < δ * κ by positivity))).exists
  refine ⟨N, fun A B hA hB hAB => ?_⟩
  have hAB' : A - B ≠ 0 := fun h => by rw [h, norm_zero] at hAB; linarith
  rw [inv_sub_sub_sum_geom A B hA hAB', norm_div, norm_pow, norm_div]
  have h1 : ‖B‖ / ‖A‖ ≤ q := (div_le_iff₀ (norm_pos_iff.mpr hA)).mpr hB
  rw [div_lt_iff₀ (by linarith)]
  calc (‖B‖ / ‖A‖) ^ N ≤ q ^ N := pow_le_pow_left₀ (by positivity) h1 N
    _ < δ * κ := hN
    _ ≤ δ * ‖A - B‖ := by gcongr

/-- Reindexing a sum over `range N` along `ℕ ↪ ℤ`. -/
private theorem sum_range_eq_sum_map_cast (N : ℕ) (a : ℕ → ℂ) (w : ℂ) :
    ∑ k ∈ Finset.range N, a k * w ^ k =
      ∑ k ∈ (Finset.range N).map (Nat.castEmbedding : ℕ ↪ ℤ), a (Int.toNat k) * w ^ k := by
  rw [Finset.sum_map]
  simp [zpow_natCast]

/-- Uniform approximability on `K` by polynomials. -/
private theorem pa_mul {K : Set ℂ} {φ ψ : ℂ → ℂ} {B₁ B₂ : ℝ} (h₁ : ∀ z ∈ K, ‖φ z‖ ≤ B₁)
    (h₂ : ∀ z ∈ K, ‖ψ z‖ ≤ B₂)
    (hφ : ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖φ z - p.eval z‖ < δ)
    (hψ : ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖ψ z - p.eval z‖ < δ) :
    ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖φ z * ψ z - p.eval z‖ < δ := by
  intro δ hδ
  set B := |B₁| + |B₂| + 1
  have hB : 0 < B := by positivity
  set δ₁ := min 1 (δ / (2 * B))
  have hδ₁ : 0 < δ₁ := lt_min one_pos (by positivity)
  obtain ⟨p, hp⟩ := hφ δ₁ hδ₁
  obtain ⟨q, hq⟩ := hψ δ₁ hδ₁
  refine ⟨p * q, fun z hz => ?_⟩
  rw [Polynomial.eval_mul]
  have hq' : ‖q.eval z‖ ≤ |B₂| + 1 := by
    have h3 := norm_sub_norm_le (q.eval z) (ψ z)
    rw [norm_sub_rev] at h3
    have := (h₂ z hz).trans (le_abs_self B₂)
    have := hq z hz
    have : δ₁ ≤ 1 := min_le_left _ _
    linarith
  have hδ₁' : δ₁ ≤ δ / (2 * B) := min_le_right _ _
  calc ‖φ z * ψ z - p.eval z * q.eval z‖
      = ‖φ z * (ψ z - q.eval z) + q.eval z * (φ z - p.eval z)‖ := by ring_nf
    _ ≤ ‖φ z‖ * ‖ψ z - q.eval z‖ + ‖q.eval z‖ * ‖φ z - p.eval z‖ := by
        refine (norm_add_le _ _).trans ?_; rw [norm_mul, norm_mul]
    _ ≤ |B₁| * δ₁ + (|B₂| + 1) * δ₁ := by
        gcongr
        · exact (h₁ z hz).trans (le_abs_self _)
        · exact (hq z hz).le
        · exact (hp z hz).le
    _ = B * δ₁ := by ring
    _ ≤ B * (δ / (2 * B)) := by gcongr
    _ < δ := by field_simp; linarith

private theorem pa_pow {K : Set ℂ} {φ : ℂ → ℂ} {B : ℝ} (hB : 0 ≤ B) (h₁ : ∀ z ∈ K, ‖φ z‖ ≤ B)
    (hφ : ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖φ z - p.eval z‖ < δ) (m : ℕ) :
    ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖φ z ^ m - p.eval z‖ < δ := by
  induction m with
  | zero => intro δ hδ; exact ⟨1, fun z _ => by simpa using hδ⟩
  | succ m ih =>
    have hb : ∀ z ∈ K, ‖φ z ^ m‖ ≤ B ^ m := fun z hz => by
      rw [norm_pow]; exact pow_le_pow_left₀ (norm_nonneg _) (h₁ z hz) m
    simpa [pow_succ] using pa_mul hb h₁ ih hφ

private theorem pa_sum {K : Set ℂ} {ι : Type*} (s : Finset ι) (φ : ι → ℂ → ℂ)
    (hφ : ∀ i ∈ s, ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖φ i z - p.eval z‖ < δ) :
    ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖∑ i ∈ s, φ i z - p.eval z‖ < δ := by
  classical
  induction s using Finset.induction_on with
  | empty => intro δ hδ; exact ⟨0, fun z _ => by simpa using hδ⟩
  | insert i s hi ih =>
    intro δ hδ
    obtain ⟨p, hp⟩ := hφ i (Finset.mem_insert_self _ _) (δ / 2) (by positivity)
    obtain ⟨q, hq⟩ := ih (fun j hj => hφ j (Finset.mem_insert_of_mem hj)) (δ / 2) (by positivity)
    refine ⟨p + q, fun z hz => ?_⟩
    rw [Finset.sum_insert hi, Polynomial.eval_add]
    calc ‖φ i z + ∑ j ∈ s, φ j z - (p.eval z + q.eval z)‖
        = ‖(φ i z - p.eval z) + (∑ j ∈ s, φ j z - q.eval z)‖ := by ring_nf
      _ ≤ ‖φ i z - p.eval z‖ + ‖∑ j ∈ s, φ j z - q.eval z‖ := norm_add_le _ _
      _ < δ / 2 + δ / 2 := add_lt_add (hp z hz) (hq z hz)
      _ = δ := by ring

/-- Pushing a pole: if `(ζ - ·)⁻¹` is uniformly approximable by polynomials on `K`, so is
`(ζ' - ·)⁻¹` for `ζ'` close to `ζ` compared with the distance from `ζ` to `K`. -/
private theorem pa_inv_sub_of_dist_lt {K : Set ℂ} {ζ ζ' : ℂ}
    (hζ : ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖(ζ - z)⁻¹ - p.eval z‖ < δ)
    (hd : dist ζ' ζ < infDist ζ K / 2) :
    ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖(ζ' - z)⁻¹ - p.eval z‖ < δ := by
  intro δ hδ
  set D := infDist ζ K
  have hD : 0 < D := by linarith [dist_nonneg (x := ζ') (y := ζ)]
  have hDz : ∀ z ∈ K, D ≤ ‖ζ - z‖ := fun z hz => by
    rw [← dist_eq_norm]; exact infDist_le_dist_of_mem hz
  obtain ⟨N, hN⟩ := exists_geom_trunc (1 / 2) (D / 2) (δ / 2) (by norm_num) (by norm_num)
    (by positivity) (by positivity)
  have hu : ∀ z ∈ K, ‖(ζ - z)⁻¹‖ ≤ 1 / D := fun z hz => by
    rw [norm_inv, one_div]; exact inv_anti₀ hD (hDz z hz)
  have hS := pa_sum (K := K) (Finset.range N)
    (fun k z => (ζ - ζ') ^ k * ((ζ - z)⁻¹) ^ (k + 1)) (fun k _ => by
      intro δ' hδ'
      have hk := pa_pow (by positivity) hu hζ (k + 1)
      rcases eq_or_ne ((ζ - ζ') ^ k) 0 with h0 | h0
      · exact ⟨0, fun z _ => by simpa [h0] using hδ'⟩
      obtain ⟨p, hp⟩ := hk (δ' / ‖(ζ - ζ') ^ k‖) (by positivity)
      refine ⟨Polynomial.C ((ζ - ζ') ^ k) * p, fun z hz => ?_⟩
      rw [Polynomial.eval_mul, Polynomial.eval_C, ← mul_sub, norm_mul]
      have := hp z hz
      rwa [lt_div_iff₀ (norm_pos_iff.mpr h0), mul_comm] at this)
  obtain ⟨p, hp⟩ := hS (δ / 2) (by positivity)
  refine ⟨p, fun z hz => ?_⟩
  have hA : ζ - z ≠ 0 := fun h => by have := hDz z hz; rw [h, norm_zero] at this; linarith
  have hB : ‖ζ - ζ'‖ ≤ 1 / 2 * ‖ζ - z‖ := by
    rw [← dist_eq_norm, dist_comm]; linarith [hDz z hz]
  have hAB : D / 2 ≤ ‖ζ - z - (ζ - ζ')‖ := by
    have h1 := norm_sub_norm_le (ζ - z) (ζ - ζ')
    rw [← dist_eq_norm ζ ζ', dist_comm] at h1
    have := hDz z hz
    linarith
  have key := hN (ζ - z) (ζ - ζ') hA hB hAB
  have he : ζ - z - (ζ - ζ') = ζ' - z := by ring
  rw [he] at key
  have hsum : ∑ k ∈ Finset.range N, (ζ - ζ') ^ k / (ζ - z) ^ (k + 1) =
      ∑ k ∈ Finset.range N, (ζ - ζ') ^ k * ((ζ - z)⁻¹) ^ (k + 1) := by
    simp [div_eq_mul_inv, inv_pow]
  rw [hsum] at key
  calc ‖(ζ' - z)⁻¹ - p.eval z‖
      ≤ ‖(ζ' - z)⁻¹ - ∑ k ∈ Finset.range N, (ζ - ζ') ^ k * ((ζ - z)⁻¹) ^ (k + 1)‖ +
        ‖∑ k ∈ Finset.range N, (ζ - ζ') ^ k * ((ζ - z)⁻¹) ^ (k + 1) - p.eval z‖ :=
        norm_sub_le_norm_sub_add_norm_sub _ _ _
    _ < δ / 2 + δ / 2 := add_lt_add key (hp z hz)
    _ = δ := by ring

/-- A pole far from `K` is uniformly approximable by polynomials. -/
private theorem pa_inv_sub_of_far {K : Set ℂ} {m ζ : ℂ} {ρ : ℝ} (hρ0 : 0 ≤ ρ)
    (hK : ∀ z ∈ K, ‖z - m‖ ≤ ρ) (hζ : ρ < ‖ζ - m‖) :
    ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖(ζ - z)⁻¹ - p.eval z‖ < δ := by
  intro δ hδ
  have hA0 : 0 < ‖ζ - m‖ := by linarith
  obtain ⟨N, hN⟩ := exists_geom_trunc (ρ / ‖ζ - m‖) (‖ζ - m‖ - ρ) δ (by positivity)
    ((div_lt_one hA0).mpr hζ) (by linarith) hδ
  refine ⟨∑ k ∈ Finset.range N, Polynomial.C (1 / (ζ - m) ^ (k + 1)) *
    (Polynomial.X - Polynomial.C m) ^ k, fun z hz => ?_⟩
  have key := hN (ζ - m) (z - m) (norm_pos_iff.mp hA0)
    (by rw [div_mul_cancel₀ _ hA0.ne']; exact hK z hz)
    (by have := norm_sub_norm_le (ζ - m) (z - m); linarith [hK z hz])
  rw [show ζ - m - (z - m) = ζ - z by ring] at key
  convert key using 2
  simp [Polynomial.eval_finset_sum, div_eq_inv_mul]

/-- On a compact convex set, every Cauchy kernel with pole off the set is uniformly
approximable by polynomials. -/
private theorem pa_inv_sub_of_convex {K : Set ℂ} (hK : IsCompact K) (hKc : Convex ℝ K)
    {m : ℂ} (hm : m ∈ K) {ζ : ℂ} (hζ : ζ ∉ K) :
    ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖(ζ - z)⁻¹ - p.eval z‖ < δ := by
  classical
  let PA : ℂ → Prop := fun ξ => ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖(ξ - z)⁻¹ - p.eval z‖ < δ
  have hne : K.Nonempty := ⟨m, hm⟩
  have hpos : ∀ ξ ∉ K, 0 < infDist ξ K := fun ξ hξ => (hK.isClosed.notMem_iff_infDist_pos hne).mp hξ
  have hnot : ∀ ξ ξ', ξ ∉ K → dist ξ' ξ < infDist ξ K → ξ' ∉ K := fun ξ ξ' _ h h' => by
    have := infDist_le_dist_of_mem (x := ξ) h'; rw [dist_comm] at this; linarith
  set u : Set ℂ := {ξ | ξ ∉ K ∧ PA ξ}
  set v : Set ℂ := {ξ | ξ ∉ K ∧ ¬ PA ξ}
  have hu : IsOpen u := by
    refine Metric.isOpen_iff.mpr fun ξ hξ => ⟨infDist ξ K / 2, by linarith [hpos ξ hξ.1],
      fun ξ' hξ' => ⟨hnot ξ ξ' hξ.1 (by rw [mem_ball] at hξ'; linarith [hpos ξ hξ.1]),
        pa_inv_sub_of_dist_lt hξ.2 hξ'⟩⟩
  have hv : IsOpen v := by
    refine Metric.isOpen_iff.mpr fun ξ hξ => ⟨infDist ξ K / 3, by linarith [hpos ξ hξ.1],
      fun ξ' hξ' => ?_⟩
    rw [mem_ball] at hξ'
    have hξ'K := hnot ξ ξ' hξ.1 (by linarith [hpos ξ hξ.1])
    refine ⟨hξ'K, fun hP => hξ.2 (pa_inv_sub_of_dist_lt hP ?_)⟩
    have := infDist_le_infDist_add_dist (s := K) (x := ξ) (y := ξ')
    rw [dist_comm] at hξ'
    linarith
  have huv : Disjoint u v := Set.disjoint_left.mpr fun ξ h1 h2 => h2.2 h1.2
  obtain ⟨ρ, hρ⟩ := hK.isBounded.subset_closedBall m
  have hρm : ∀ z ∈ K, ‖z - m‖ ≤ ρ := fun z hz => by
    have := hρ hz; rwa [mem_closedBall, dist_eq_norm] at this
  have hρ0 : 0 ≤ ρ := by simpa using hρm m hm
  have hζm : 0 < ‖ζ - m‖ := norm_pos_iff.mpr (sub_ne_zero.mpr fun h => hζ (h ▸ hm))
  let r : ℝ → ℂ := fun t => m + (t : ℂ) * (ζ - m)
  have hray : r '' Ici 1 ⊆ u ∪ v := by
    rintro _ ⟨t, ht, rfl⟩
    have hout : r t ∉ K := by
      intro hrt
      apply hζ
      have ht0 : (0 : ℝ) < t := by linarith [Set.mem_Ici.mp ht]
      have := hKc hm hrt (a := 1 - 1 / t) (b := 1 / t)
        (by rw [sub_nonneg]; exact (div_le_one ht0).mpr (Set.mem_Ici.mp ht)) (by positivity)
        (by ring)
      convert this using 1
      have htc : (t : ℂ) ≠ 0 := by exact_mod_cast ht0.ne'
      simp only [r, Complex.real_smul]
      push_cast
      field_simp
      ring
    by_cases h : PA (r t)
    · exact Or.inl ⟨hout, h⟩
    · exact Or.inr ⟨hout, h⟩
  have hsub := (isPreconnected_Ici.image r (by fun_prop)).subset_left_of_subset_union hu hv huv
    hray (by
      set t := max 1 ((ρ + 1) / ‖ζ - m‖)
      have ht : (ρ + 1) / ‖ζ - m‖ ≤ t := le_max_right _ _
      have hfar : ρ < ‖r t - m‖ := by
        have ht0 : 0 ≤ t := le_trans zero_le_one (le_max_left _ _)
        simp only [r, add_sub_cancel_left, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg ht0]
        rw [div_le_iff₀ hζm] at ht
        linarith
      refine ⟨r t, ⟨t, mem_Ici.mpr (le_max_left _ _), rfl⟩, ?_, pa_inv_sub_of_far hρ0 hρm hfar⟩
      intro hK'
      have := hρm _ hK'
      linarith)
  have h1 : r 1 = ζ := by simp [r]
  have := hsub ⟨1, mem_Ici.mpr le_rfl, h1⟩
  exact this.2

/-- A polynomial approximation, rewritten in powers of `z - c`. -/
private theorem kernel_of_pa {K : Set ℂ} {φ : ℂ → ℂ} (c : ℂ)
    (hφ : ∀ δ > 0, ∃ p : Polynomial ℂ, ∀ z ∈ K, ‖φ z - p.eval z‖ < δ) (δ : ℝ) (hδ : 0 < δ) :
    ∃ (s : Finset ℤ) (a : ℤ → ℂ), (∀ k ∈ s, 0 ≤ k) ∧
      ∀ z ∈ K, ‖φ z - ∑ k ∈ s, a k * (z - c) ^ k‖ < δ := by
  obtain ⟨p, hp⟩ := hφ δ hδ
  set q := p.comp (Polynomial.X + Polynomial.C c)
  refine ⟨(Finset.range (q.natDegree + 1)).map Nat.castEmbedding, fun k => q.coeff k.toNat,
    fun k hk => ?_, fun z hz => ?_⟩
  · obtain ⟨k, -, rfl⟩ := Finset.mem_map.mp hk; simp
  · rw [← sum_range_eq_sum_map_cast (q.natDegree + 1) q.coeff (z - c),
      ← Polynomial.eval_eq_sum_range]
    simpa [q] using hp z hz

/-- Kernel approximation on a closed annulus, by Laurent polynomials in `z - c`. -/
private theorem kernel_approx_annulus {c : ℂ} {r R : ℝ} (hr : 0 < r) {ζ : ℂ}
    (hζ : ζ ∉ closedBall c R \ ball c r) (δ : ℝ) (hδ : 0 < δ) :
    ∃ (s : Finset ℤ) (a : ℤ → ℂ),
      ∀ z ∈ closedBall c R \ ball c r, ‖(ζ - z)⁻¹ - ∑ k ∈ s, a k * (z - c) ^ k‖ < δ := by
  have hmem : ∀ z ∈ closedBall c R \ ball c r, r ≤ ‖z - c‖ ∧ ‖z - c‖ ≤ R := fun z hz => by
    obtain ⟨h1, h2⟩ := hz
    rw [mem_closedBall, dist_eq_norm] at h1
    rw [mem_ball, dist_eq_norm, not_lt] at h2
    exact ⟨h2, h1⟩
  by_cases hout : R < ‖ζ - c‖
  · have hR0 : 0 ≤ R ∨ closedBall c R \ ball c r = ∅ := by
      by_cases h : 0 ≤ R
      · exact Or.inl h
      · right; ext z; simp only [mem_empty_iff_false, iff_false]
        intro hz; have := hmem z hz; linarith [norm_nonneg (z - c)]
    rcases hR0 with hR0 | hE
    · obtain ⟨s, a, -, h⟩ := kernel_of_pa c
        (pa_inv_sub_of_far hR0 (fun z hz => (hmem z hz).2) hout) δ hδ
      exact ⟨s, a, h⟩
    · exact ⟨∅, 0, fun z hz => by simp [hE] at hz⟩
  · have hin : ‖ζ - c‖ < r := by
      by_contra h
      apply hζ
      refine ⟨?_, ?_⟩
      · rw [mem_closedBall, dist_eq_norm]; linarith
      · rw [mem_ball, dist_eq_norm]; linarith
    have hB0 : 0 ≤ ‖ζ - c‖ := norm_nonneg _
    obtain ⟨N, hN⟩ := exists_geom_trunc (‖ζ - c‖ / r) (r - ‖ζ - c‖) δ (by positivity)
      ((div_lt_one hr).mpr hin) (by linarith) hδ
    refine ⟨(Finset.range N).map ⟨fun k : ℕ => -((k : ℤ) + 1), fun a b h => by simpa using h⟩,
      fun k => -((ζ - c) ^ (-k - 1).toNat), fun z hz => ?_⟩
    obtain ⟨h1, -⟩ := hmem z hz
    have hA : z - c ≠ 0 := fun h => by rw [h, norm_zero] at h1; linarith
    have key := hN (z - c) (ζ - c) hA
      (by rw [div_mul_eq_mul_div, le_div_iff₀ hr]; exact mul_le_mul_of_nonneg_left h1 hB0)
      (by have := norm_sub_norm_le (z - c) (ζ - c); linarith)
    rw [show z - c - (ζ - c) = -(ζ - z) by ring, inv_neg] at key
    have hs : ∑ k ∈ (Finset.range N).map ⟨fun k : ℕ => -((k : ℤ) + 1), fun a b h => by
        simpa using h⟩, -((ζ - c) ^ (-k - 1).toNat) * (z - c) ^ k =
        -∑ k ∈ Finset.range N, (ζ - c) ^ k / (z - c) ^ (k + 1) := by
      rw [Finset.sum_map, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun k _ => ?_
      have hk : (-(-((k : ℤ) + 1)) - 1).toNat = k := by omega
      show -((ζ - c) ^ (-(-((k : ℤ) + 1)) - 1).toNat) * (z - c) ^ (-((k : ℤ) + 1)) = _
      rw [hk, zpow_neg, show ((k : ℤ) + 1) = ((k + 1 : ℕ) : ℤ) by push_cast; ring, zpow_natCast,
        div_eq_mul_inv, neg_mul]
    rw [hs, sub_neg_eq_add,
      show ∀ x y : ℂ, x + y = -(-x - y) from fun x y => by ring, norm_neg]
    exact key

/-- Approximation of a product of two functions of separate variables from approximations of
the factors. -/
private theorem exists_mul_approx {X Y : Type*} {S : Set X} {T : Set Y} {u : Y → ℂ} {v : X → ℂ}
    {H B : ℝ} (hu : ∀ y ∈ T, ‖u y‖ ≤ H) (hv : ∀ x ∈ S, ‖v x‖ ≤ B)
    {PL : (X → ℂ) → Prop} {PR : (Y → ℂ) → Prop}
    (hL : ∀ δ > 0, ∃ L, PL L ∧ ∀ x ∈ S, ‖v x - L x‖ < δ)
    (hR : ∀ δ > 0, ∃ R, PR R ∧ ∀ y ∈ T, ‖u y - R y‖ < δ) (η : ℝ) (hη : 0 < η) :
    ∃ L R, PL L ∧ PR R ∧ ∀ x ∈ S, ∀ y ∈ T, ‖u y * v x - R y * L x‖ < η := by
  set δ₁ := min 1 (η / (2 * (|H| + 1)))
  have hδ₁ : 0 < δ₁ := lt_min one_pos (by positivity)
  obtain ⟨L, hPL, hLv⟩ := hL δ₁ hδ₁
  obtain ⟨R, hPR, hRu⟩ := hR (η / (2 * (|B| + 2))) (by positivity)
  refine ⟨L, R, hPL, hPR, fun x hx y hy => ?_⟩
  have hLb : ‖L x‖ ≤ |B| + 1 := by
    have h3 := norm_sub_norm_le (L x) (v x)
    rw [norm_sub_rev] at h3
    have := (hv x hx).trans (le_abs_self B)
    have := hLv x hx
    have : δ₁ ≤ 1 := min_le_left _ _
    linarith
  have h1 : |H| * δ₁ ≤ η / 2 := by
    have : δ₁ ≤ η / (2 * (|H| + 1)) := min_le_right _ _
    calc |H| * δ₁ ≤ (|H| + 1) * (η / (2 * (|H| + 1))) := by gcongr <;> linarith [abs_nonneg H]
      _ = η / 2 := by field_simp
  have h2 : (|B| + 1) * ‖u y - R y‖ < η / 2 := by
    calc (|B| + 1) * ‖u y - R y‖ < (|B| + 2) * (η / (2 * (|B| + 2))) := by
          have := hRu y hy
          have : 0 ≤ ‖u y - R y‖ := norm_nonneg _
          nlinarith [abs_nonneg B]
      _ = η / 2 := by field_simp
  calc ‖u y * v x - R y * L x‖ = ‖u y * (v x - L x) + L x * (u y - R y)‖ := by ring_nf
    _ ≤ ‖u y‖ * ‖v x - L x‖ + ‖L x‖ * ‖u y - R y‖ := by
        refine (norm_add_le _ _).trans ?_; rw [norm_mul, norm_mul]
    _ ≤ |H| * δ₁ + (|B| + 1) * ‖u y - R y‖ := by
        gcongr
        · exact (hu y hy).trans (le_abs_self _)
        · exact (hLv x hx).le
    _ < η := by linarith

/-- The product of a Laurent polynomial in the first variable and one in the remaining
variables is a Laurent polynomial in all variables. -/
private theorem exists_sum_eq_mul_cons {n : ℕ} (Adm : Fin (n + 1) → ℤ → Prop) (c : Fin (n + 1) → ℂ)
    (sL : Finset ℤ) (aL : ℤ → ℂ) (hL : ∀ k ∈ sL, Adm 0 k) (sR : Finset (Fin n → ℤ))
    (aR : (Fin n → ℤ) → ℂ) (hR : ∀ β ∈ sR, ∀ j, Adm j.succ (β j)) :
    ∃ (s : Finset (Fin (n + 1) → ℤ)) (a : (Fin (n + 1) → ℤ) → ℂ), (∀ β ∈ s, ∀ j, Adm j (β j)) ∧
      ∀ z : Fin (n + 1) → ℂ, (∑ β ∈ sR, aR β * ∏ j, (Fin.tail z j - c j.succ) ^ β j) *
        (∑ k ∈ sL, aL k * (z 0 - c 0) ^ k) = ∑ β ∈ s, a β * ∏ j, (z j - c j) ^ β j := by
  classical
  refine ⟨(sL ×ˢ sR).image (fun p => Fin.cons p.1 p.2), fun γ => aL (γ 0) * aR (Fin.tail γ),
    fun β hβ j => ?_, fun z => ?_⟩
  · obtain ⟨⟨k, β'⟩, hp, rfl⟩ := Finset.mem_image.mp hβ
    rw [Finset.mem_product] at hp
    refine Fin.cases ?_ (fun j => ?_) j
    · simpa using hL k hp.1
    · simpa using hR β' hp.2 j
  · rw [Finset.sum_image (fun p _ q _ h => by
        obtain ⟨h1, h2⟩ := Fin.cons_injective2 h
        exact Prod.ext h1 h2),
      Finset.sum_product, Finset.sum_mul_sum, Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun β _ => ?_
    simp only [Fin.tail_cons, Fin.cons_zero]
    simp only [Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ, Fin.tail]
    ring

/-- A compact set is covered by finitely many pairwise disjoint measurable pieces, each inside a
ball of radius `η` centred at a point of the set. -/
private theorem exists_measurable_partition {T : Set ℂ} (hT : IsCompact T) (hne : T.Nonempty)
    {η : ℝ} (hη : 0 < η) : ∃ (N : ℕ) (x : ℕ → ℂ) (Q : ℕ → Set ℂ), (∀ i, x i ∈ T) ∧
      (∀ i, MeasurableSet (Q i)) ∧ (∀ i, Q i ⊆ ball (x i) η) ∧
      (Pairwise fun i j => Disjoint (Q i) (Q j)) ∧ ∀ ζ ∈ T, ∃ i < N, ζ ∈ Q i := by
  classical
  obtain ⟨t, htT, htf, hcov⟩ := finite_cover_balls_of_compact hT hη
  set l := htf.toFinset.toList
  let x : ℕ → ℂ := fun i => if h : i < l.length then l[i] else hne.some
  let B : ℕ → Set ℂ := fun i => if i < l.length then ball (x i) η else ∅
  have hBsub : ∀ i, B i ⊆ ball (x i) η := fun i => by
    simp only [B]; split_ifs
    · exact subset_rfl
    · exact empty_subset _
  refine ⟨l.length, x, disjointed B, fun i => ?_, MeasurableSet.disjointed fun i => ?_,
    fun i => (disjointed_subset B i).trans (hBsub i), disjoint_disjointed B, fun ζ hζ => ?_⟩
  · simp only [x]; split_ifs with h
    · exact htT (htf.mem_toFinset.mp (Finset.mem_toList.mp (List.getElem_mem h)))
    · exact hne.some_mem
  · simp only [B]; split_ifs
    · exact measurableSet_ball
    · exact MeasurableSet.empty
  · obtain ⟨y, hy, hζy⟩ := mem_iUnion₂.mp (hcov hζ)
    have hyl : y ∈ l := Finset.mem_toList.mpr (htf.mem_toFinset.mpr hy)
    obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.mp hyl
    have hζB : ζ ∈ ⋃ i, B i := mem_iUnion.mpr ⟨k, by simp [B, x, hk, hζy]⟩
    rw [← iUnion_disjointed] at hζB
    obtain ⟨i, hi⟩ := mem_iUnion.mp hζB
    refine ⟨i, ?_, hi⟩
    by_contra h
    have := disjointed_subset B i hi
    simp [B, h] at this

/-- A parametric integral of a holomorphic function against a bounded measurable weight with
compact support is holomorphic in the parameter. -/
private theorem differentiableOn_integral_mul_cons {n : ℕ} {U : Set (Fin (n + 1) → ℂ)}
    {f : (Fin (n + 1) → ℂ) → ℂ} (hU : IsOpen U) (hf : DifferentiableOn ℂ f U) {T : Set ℂ}
    (hT : IsCompact T) {W : Set (Fin n → ℂ)} (hW : IsOpen W)
    (hTW : ∀ ζ ∈ T, ∀ y ∈ W, (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U) {ψ : ℂ → ℂ}
    (hψm : AEStronglyMeasurable ψ volume) {C : ℝ} (hψC : ∀ ζ, ‖ψ ζ‖ ≤ C)
    (hψ0 : ∀ ζ ∉ T, ψ ζ = 0) :
    DifferentiableOn ℂ (fun y => ∫ ζ, ψ ζ * f (Fin.cons ζ y)) W := by
  intro y₀ hy₀
  obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.mp hW y₀ hy₀
  have hcb : closedBall y₀ (r / 2) ⊆ W := (closedBall_subset_ball (by linarith)).trans hrW
  have hsep : ∀ ζ ∈ U, ∀ j, DifferentiableAt ℂ (fun w => f (Function.update ζ j w)) (ζ j) :=
    fun ζ hζ j => DifferentiableAt.comp (ζ j)
      (by rw [Function.update_eq_self]; exact hf.differentiableAt (hU.mem_nhds hζ))
      (hasFDerivAt_update ζ (ζ j)).differentiableAt
  have hfC : ContDiffOn ℂ 1 f U :=
    ((MMP.SeveralComplex.cauchy_osgood_laurent.{0, 0} ℂ).2.2.1 (n + 1) U f hU hf.continuousOn
      hsep).2.1.contDiffOn hU.uniqueDiffOn
  have hfd : ContinuousOn (fderiv ℂ f) U := hfC.continuousOn_fderiv_of_isOpen hU le_rfl
  let ι : (Fin n → ℂ) →L[ℂ] (Fin (n + 1) → ℂ) := ContinuousLinearMap.pi fun i =>
    Fin.cases (motive := fun _ => (Fin n → ℂ) →L[ℂ] ℂ) 0 ContinuousLinearMap.proj i
  have hι : ∀ (ζ : ℂ) (y : Fin n → ℂ),
      HasFDerivAt (fun y : Fin n → ℂ => (Fin.cons ζ y : Fin (n + 1) → ℂ)) ι y := by
    intro ζ y
    rw [hasFDerivAt_pi']
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [ι] using hasFDerivAt_const ζ y
    · simpa [ι] using hasFDerivAt_apply j y
  have hcc : Continuous fun p : ℂ × (Fin n → ℂ) => (Fin.cons p.1 p.2 : Fin (n + 1) → ℂ) := by
    fun_prop
  have hKc : (fun p : ℂ × (Fin n → ℂ) => (Fin.cons p.1 p.2 : Fin (n + 1) → ℂ)) ''
      (T ×ˢ closedBall y₀ (r / 2)) ⊆ U := by
    rintro _ ⟨p, hp, rfl⟩
    exact hTW p.1 hp.1 p.2 (hcb hp.2)
  have hKcc := (hT.prod (isCompact_closedBall y₀ (r / 2))).image hcc
  obtain ⟨Cd, hCd⟩ := hKcc.exists_bound_of_continuousOn (hfd.mono hKc)
  obtain ⟨Cf, hCf⟩ := hKcc.exists_bound_of_continuousOn (hf.continuousOn.mono hKc)
  -- measurability of products with `ψ`
  have hmeas : ∀ y ∈ W, ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℂ E] (G : ℂ → E),
      ContinuousOn G {ζ | (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U} →
      AEStronglyMeasurable (fun ζ => ψ ζ • G ζ) volume := by
    intro y hy E _ _ G hG
    have hO : IsOpen {ζ : ℂ | (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U} :=
      hU.preimage (by fun_prop)
    have heq : (fun ζ => ψ ζ • G ζ) =
        {ζ : ℂ | (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U}.indicator (fun ζ => ψ ζ • G ζ) := by
      funext ζ
      by_cases hζ : (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U
      · rw [indicator_of_mem (s := {ζ : ℂ | (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U}) hζ]
      · rw [indicator_of_notMem (s := {ζ : ℂ | (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U}) hζ,
          hψ0 ζ (fun h => hζ (hTW ζ h y hy)), zero_smul]
    rw [heq]
    exact (aestronglyMeasurable_indicator_iff hO.measurableSet).mpr
      (hψm.restrict.smul (hG.aestronglyMeasurable hO.measurableSet))
  have hfcont : ∀ y, ContinuousOn (fun ζ : ℂ => f (Fin.cons ζ y))
      {ζ | (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U} := fun y =>
    hf.continuousOn.comp (by fun_prop) fun _ h => h
  have hball : ball y₀ (r / 2) ∈ 𝓝 y₀ := ball_mem_nhds _ (by positivity)
  have key := hasFDerivAt_integral_of_dominated_of_fderiv_le (μ := volume) (𝕜 := ℂ)
    (F := fun y ζ => ψ ζ * f (Fin.cons ζ y))
    (F' := fun y ζ => ψ ζ • (fderiv ℂ f (Fin.cons ζ y)).comp ι) (x₀ := y₀)
    (bound := T.indicator fun _ => |C| * (|Cd| * ‖ι‖)) hball
    (by
      filter_upwards [hW.mem_nhds hy₀] with y hy
      simpa [smul_eq_mul] using hmeas y hy _ (hfcont y))
    (by
      refine Integrable.mono' ((integrable_indicator_iff hT.measurableSet).mpr
        (integrableOn_const (C := |C| * |Cf|) hT.measure_lt_top.ne))
        (by simpa [smul_eq_mul] using hmeas y₀ hy₀ _ (hfcont y₀)) (Eventually.of_forall
          fun ζ => ?_)
      by_cases hζ : ζ ∈ T
      · rw [indicator_of_mem hζ, norm_mul]
        exact mul_le_mul ((hψC ζ).trans (le_abs_self _))
          ((hCf _ ⟨(ζ, y₀), ⟨hζ, mem_closedBall_self (by positivity)⟩, rfl⟩).trans
            (le_abs_self _)) (norm_nonneg _) (abs_nonneg _)
      · simp [hψ0 ζ hζ, indicator_of_notMem hζ])
    (hmeas y₀ hy₀ _ ((hfd.comp (by fun_prop : Continuous fun ζ : ℂ =>
      (Fin.cons ζ y₀ : Fin (n + 1) → ℂ)).continuousOn fun _ h => h).clm_comp continuousOn_const))
    (Eventually.of_forall fun ζ y hy => by
      by_cases hζ : ζ ∈ T
      · rw [indicator_of_mem hζ, norm_smul]
        refine mul_le_mul ((hψC ζ).trans (le_abs_self _)) ?_ (norm_nonneg _) (abs_nonneg _)
        refine (ContinuousLinearMap.opNorm_comp_le _ _).trans
          (mul_le_mul_of_nonneg_right ?_ (norm_nonneg _))
        exact (hCd _ ⟨(ζ, y), ⟨hζ, ball_subset_closedBall hy⟩, rfl⟩).trans (le_abs_self _)
      · simp [hψ0 ζ hζ, indicator_of_notMem hζ])
    ((integrable_indicator_iff hT.measurableSet).mpr
      (integrableOn_const hT.measure_lt_top.ne))
    (Eventually.of_forall fun ζ y hy => by
      by_cases hζ : ζ ∈ T
      · have hyW := hcb (ball_subset_closedBall hy)
        exact (((hf.differentiableAt (hU.mem_nhds (hTW ζ hζ y hyW))).hasFDerivAt).comp y
          (hι ζ y)).const_mul (ψ ζ)
      · rw [hψ0 ζ hζ, zero_smul]
        simpa using hasFDerivAt_const (𝕜 := ℂ) (0 : ℂ) y)
  exact key.differentiableAt.differentiableWithinAt

/-- The Cauchy–Pompeiu representation with a cutoff: a holomorphic function near `K₀ × Kₚ` is,
on `K₀ × Kₚ`, the Cauchy transform in the first variable of `φ(ζ) f(ζ, y)`, where `φ` is
continuous and supported in a compact set `T` disjoint from `K₀`. -/
private theorem exists_cutoff_repr :
    ∀ (n : ℕ) (K₀ : Set ℂ) (Kp : Set (Fin n → ℂ)), IsCompact K₀ → IsCompact Kp →
      ∀ (U : Set (Fin (n + 1) → ℂ)) (f : (Fin (n + 1) → ℂ) → ℂ), IsOpen U →
        (∀ z₀ ∈ K₀, ∀ y ∈ Kp, (Fin.cons z₀ y : Fin (n + 1) → ℂ) ∈ U) →
        DifferentiableOn ℂ f U →
        ∃ (W : Set (Fin n → ℂ)) (φ : ℂ → ℂ) (T : Set ℂ), IsOpen W ∧ Kp ⊆ W ∧ Continuous φ ∧
          IsCompact T ∧ (∀ ζ ∉ T, φ ζ = 0) ∧ (∀ ζ ∈ T, ζ ∉ K₀) ∧
          (∀ ζ ∈ T, ∀ y ∈ W, (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U) ∧
          ∀ z₀ ∈ K₀, ∀ y ∈ Kp,
            f (Fin.cons z₀ y) = ∫ ζ, φ ζ * f (Fin.cons ζ y) * (ζ - z₀)⁻¹ := by
  intro n K₀ Kp hK₀ hKp U f hU hcons hf
  have hcc : Continuous fun p : ℂ × (Fin n → ℂ) => (Fin.cons p.1 p.2 : Fin (n + 1) → ℂ) := by
    fun_prop
  obtain ⟨u, v, hu, hv, hKu, hKv, huv⟩ := generalized_tube_lemma hK₀ hKp (hU.preimage hcc)
    (fun p hp => hcons p.1 hp.1 p.2 hp.2)
  have huvU : ∀ ζ ∈ u, ∀ y ∈ v, (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U :=
    fun ζ hζ y hy => huv (show (ζ, y) ∈ u ×ˢ v from ⟨hζ, hy⟩)
  obtain ⟨V, hVo, hKV, hVu, hVc⟩ := exists_open_between_and_isCompact_closure hK₀ hu hKu
  obtain ⟨χ, hχ0, hχ1, -⟩ :=
    exists_contMDiffMap_zero_one_nhds_of_isClosed (modelWithCornersSelf ℝ ℂ) (n := 1)
    hVo.isClosed_compl hK₀.isClosed (disjoint_compl_left_iff_subset.mpr hKV)
  obtain ⟨O₀, hO₀o, hVO₀, hO₀⟩ := mem_nhdsSet_iff_exists.mp hχ0
  obtain ⟨N₀, hN₀o, hKN₀, hN₀⟩ := mem_nhdsSet_iff_exists.mp hχ1
  set χc : ℂ → ℂ := fun ζ => ((χ ζ : ℝ) : ℂ)
  have hχd : ContDiff ℝ 1 χc :=
    Complex.ofRealCLM.contDiff.comp (contMDiff_iff_contDiff.mp χ.contMDiff)
  set D := fderiv ℝ χc
  have hO₀V : O₀ᶜ ⊆ V := fun ζ hζ => by
    by_contra h; exact hζ (hVO₀ h)
  have hO₀c : IsCompact O₀ᶜ :=
    hVc.of_isClosed_subset hO₀o.isClosed_compl (hO₀V.trans subset_closure)
  have hD0 : ∀ ζ, ζ ∈ O₀ ∨ ζ ∈ N₀ → D ζ = 0 := by
    rintro ζ (hζ | hζ)
    · have : χc =ᶠ[𝓝 ζ] fun _ => (0 : ℂ) := by
        filter_upwards [hO₀o.mem_nhds hζ] with ζ' h'
        simp [χc, show χ ζ' = 0 from hO₀ h']
      rw [show D ζ = fderiv ℝ χc ζ from rfl, this.fderiv_eq, fderiv_const_apply]
    · have : χc =ᶠ[𝓝 ζ] fun _ => (1 : ℂ) := by
        filter_upwards [hN₀o.mem_nhds hζ] with ζ' h'
        simp [χc, show χ ζ' = 1 from hN₀ h']
      rw [show D ζ = fderiv ℝ χc ζ from rfl, this.fderiv_eq, fderiv_const_apply]
  set φ : ℂ → ℂ := fun ζ =>
    -(1 / (Real.pi : ℂ)) * ((1 / 2 : ℂ) * (D ζ 1 + Complex.I * D ζ Complex.I))
  have hDc : Continuous D := hχd.continuous_fderiv one_ne_zero
  refine ⟨v, φ, O₀ᶜ ∩ N₀ᶜ, hv, hKv, by fun_prop,
    hO₀c.of_isClosed_subset (hO₀o.isClosed_compl.inter hN₀o.isClosed_compl) inter_subset_left,
    fun ζ hζ => ?_, fun ζ hζ hK => hζ.2 (hKN₀ hK),
    fun ζ hζ y hy => huvU ζ (hVu (subset_closure (hO₀V hζ.1))) y hy, fun z₀ hz₀ y hy => ?_⟩
  · have : ζ ∈ O₀ ∨ ζ ∈ N₀ := by
      by_contra! h; exact hζ ⟨h.1, h.2⟩
    simp [φ, hD0 ζ this]
  have hyv := hKv hy
  set g : ℂ → ℂ := fun ζ => f (Fin.cons ζ y)
  set Ou : Set ℂ := {ζ | (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U}
  have hOu : IsOpen Ou := hU.preimage (by fun_prop)
  have hgd : DifferentiableOn ℂ g Ou := hf.comp (by fun_prop : Differentiable ℂ
    fun ζ : ℂ => (Fin.cons ζ y : Fin (n + 1) → ℂ)).differentiableOn fun _ h => h
  have huO : ∀ ζ, ζ ∉ u → ζ ∈ O₀ := fun ζ hζ => by
    by_contra h; exact hζ (hVu (subset_closure (hO₀V h)))
  have hG0 : ∀ ζ ∈ O₀, (fun ζ => χc ζ * g ζ) =ᶠ[𝓝 ζ] fun _ => (0 : ℂ) := fun ζ hζ => by
    filter_upwards [hO₀o.mem_nhds hζ] with ζ' h'
    simp [χc, show χ ζ' = 0 from hO₀ h']
  have hG : ContDiff ℝ 1 fun ζ => χc ζ * g ζ := by
    refine contDiff_iff_contDiffAt.mpr fun ζ => ?_
    by_cases hζ : ζ ∈ u
    · have hgc : ContDiffAt ℝ 1 g ζ :=
        ((hgd.contDiffOn hOu).restrict_scalars ℝ).contDiffAt
          (hOu.mem_nhds (huvU ζ hζ y hyv))
      exact hχd.contDiffAt.mul hgc
    · exact contDiffAt_const.congr_of_eventuallyEq (hG0 ζ (huO ζ hζ))
  have hcs : HasCompactSupport fun ζ => χc ζ * g ζ :=
    HasCompactSupport.intro hO₀c fun ζ hζ => by
      simp [χc, show χ ζ = 0 from hO₀ (not_not.mp hζ)]
  have hcp := integral_dbar_div_eq hG hcs z₀
  have hpi : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
  have hpt : ∀ ζ, (1 / 2 : ℂ) * (fderiv ℝ (fun ζ => χc ζ * g ζ) ζ 1 +
      Complex.I * fderiv ℝ (fun ζ => χc ζ * g ζ) ζ Complex.I) =
      -(Real.pi : ℂ) * (φ ζ * g ζ) := by
    intro ζ
    by_cases hζ : ζ ∈ u
    · have hgζ : DifferentiableAt ℂ g ζ := hgd.differentiableAt
        (hOu.mem_nhds (huvU ζ hζ y hyv))
      rw [show (fun ζ => χc ζ * g ζ) = χc * g from rfl,
        ((hχd.differentiable one_ne_zero ζ).hasFDerivAt.mul
        (hgζ.restrictScalars ℝ).hasFDerivAt).fderiv, hgζ.fderiv_restrictScalars ℝ]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.coe_restrictScalars', smul_eq_mul]
      have hI : fderiv ℂ g ζ Complex.I = Complex.I * fderiv ℂ g ζ 1 := by
        rw [← smul_eq_mul, ← map_smul, smul_eq_mul, mul_one]
      rw [hI]
      simp only [φ]
      field_simp
      linear_combination (χc ζ * fderiv ℂ g ζ 1) * Complex.I_sq
    · have h1 : fderiv ℝ (fun ζ => χc ζ * g ζ) ζ = 0 := by
        rw [(hG0 ζ (huO ζ hζ)).fderiv_eq, fderiv_const_apply]
      simp [h1, φ, hD0 ζ (Or.inl (huO ζ hζ))]
  simp only [hpt] at hcp
  have hχz : χc z₀ = 1 := by simp [χc, show χ z₀ = 1 from hN₀ (hKN₀ hz₀)]
  rw [hχz, one_mul] at hcp
  have hcv : ∫ w : ℂ, -(Real.pi : ℂ) * (φ (z₀ + w) * g (z₀ + w)) / w =
      -(Real.pi : ℂ) * ∫ ζ, φ ζ * g ζ * (ζ - z₀)⁻¹ := by
    rw [← integral_const_mul, ← integral_add_left_eq_self
      (fun ζ => -(Real.pi : ℂ) * (φ ζ * g ζ * (ζ - z₀)⁻¹)) z₀]
    congr 1; ext w
    rw [add_sub_cancel_left, div_eq_mul_inv]; ring
  rw [hcv] at hcp
  exact (mul_left_cancel₀ (neg_ne_zero.mpr hpi) hcp).symm

/-- The Cauchy–Pompeiu step: a holomorphic function near `K₀ × Kₚ` is, uniformly on `K₀ × Kₚ`,
close to a finite sum of Cauchy kernels in the first variable with poles off `K₀`, whose
coefficients are holomorphic in the remaining variables. -/
private theorem exists_sum_inv_sub_approx :
    ∀ (n : ℕ) (K₀ : Set ℂ) (Kp : Set (Fin n → ℂ)), IsCompact K₀ → IsCompact Kp →
      ∀ (U : Set (Fin (n + 1) → ℂ)) (f : (Fin (n + 1) → ℂ) → ℂ), IsOpen U →
        (∀ z₀ ∈ K₀, ∀ y ∈ Kp, (Fin.cons z₀ y : Fin (n + 1) → ℂ) ∈ U) →
        DifferentiableOn ℂ f U → ∀ ε : ℝ, 0 < ε →
        ∃ (N : ℕ) (x : ℕ → ℂ) (h : ℕ → (Fin n → ℂ) → ℂ) (W : Set (Fin n → ℂ)),
          IsOpen W ∧ Kp ⊆ W ∧ (∀ i, x i ∉ K₀) ∧ (∀ i, DifferentiableOn ℂ (h i) W) ∧
          ∀ z₀ ∈ K₀, ∀ y ∈ Kp,
            ‖f (Fin.cons z₀ y) - ∑ i ∈ Finset.range N, h i y * (x i - z₀)⁻¹‖ < ε := by
  intro n K₀ Kp hK₀ hKp U f hU hcons hf ε hε
  obtain ⟨W, φ, T, hW, hKW, hφc, hT, hφ0, hTK, hTW, hrep⟩ :=
    exists_cutoff_repr n K₀ Kp hK₀ hKp U f hU hcons hf
  rcases T.eq_empty_or_nonempty with hTe | hTne
  · obtain ⟨p, hp⟩ := (ne_univ_iff_exists_notMem _).mp hK₀.ne_univ
    refine ⟨0, fun _ => p, fun _ _ => 0, W, hW, hKW, fun _ => hp,
      fun _ => differentiableOn_const _, fun z₀ hz₀ y hy => ?_⟩
    have h0 : ∀ ζ, φ ζ = 0 := fun ζ => hφ0 ζ (by simp [hTe])
    simpa [hrep z₀ hz₀ y hy, h0] using hε
  -- separation of `T` from `K₀`
  obtain ⟨d, hd, hdist⟩ : ∃ d > 0, ∀ ζ ∈ T, ∀ z ∈ K₀, d ≤ ‖ζ - z‖ := by
    rcases K₀.eq_empty_or_nonempty with hKe | hKne
    · exact ⟨1, one_pos, fun _ _ z hz => by simp [hKe] at hz⟩
    obtain ⟨ζm, hζm, hmin⟩ := hT.exists_isMinOn hTne (continuous_infDist_pt K₀).continuousOn
    refine ⟨infDist ζm K₀, (hK₀.isClosed.notMem_iff_infDist_pos hKne).mp (hTK ζm hζm),
      fun ζ hζ z hz => ?_⟩
    rw [← dist_eq_norm]
    exact (hmin hζ).trans (infDist_le_dist_of_mem hz)
  -- bounds
  obtain ⟨Cφ, hCφ⟩ := hT.exists_bound_of_continuousOn hφc.continuousOn
  have hCφ' : ∀ ζ, ‖φ ζ‖ ≤ |Cφ| := fun ζ => by
    by_cases hζ : ζ ∈ T
    · exact (hCφ ζ hζ).trans (le_abs_self _)
    · rw [hφ0 ζ hζ, norm_zero]; exact abs_nonneg _
  have hcc : Continuous fun p : ℂ × (Fin n → ℂ) => (Fin.cons p.1 p.2 : Fin (n + 1) → ℂ) := by
    fun_prop
  obtain ⟨Cf, hCf⟩ := (hT.prod hKp).image hcc |>.exists_bound_of_continuousOn
    (hf.continuousOn.mono (by
      rintro _ ⟨p, hp, rfl⟩
      exact hTW p.1 hp.1 p.2 (hKW hp.2)))
  set g : (Fin n → ℂ) → ℂ → ℂ := fun y ζ => φ ζ * f (Fin.cons ζ y)
  have hgb : ∀ y ∈ Kp, ∀ ζ, ‖g y ζ‖ ≤ T.indicator (fun _ => |Cφ| * |Cf|) ζ := by
    intro y hy ζ
    by_cases hζ : ζ ∈ T
    · rw [indicator_of_mem hζ, norm_mul]
      exact mul_le_mul (hCφ' ζ) ((hCf _ ⟨(ζ, y), ⟨hζ, hy⟩, rfl⟩).trans (le_abs_self _))
        (norm_nonneg _) (abs_nonneg _)
    · simp [g, hφ0 ζ hζ, indicator_of_notMem hζ]
  have hgc : ∀ y ∈ W, Continuous (g y) := by
    intro y hy
    refine continuous_iff_continuousAt.mpr fun ζ => ?_
    by_cases hζ : (Fin.cons ζ y : Fin (n + 1) → ℂ) ∈ U
    · exact hφc.continuousAt.mul (ContinuousAt.comp
        (f := fun ζ' : ℂ => (Fin.cons ζ' y : Fin (n + 1) → ℂ)) (x := ζ)
        (hf.continuousOn.continuousAt (hU.mem_nhds hζ))
        (by fun_prop : Continuous fun ζ' : ℂ => (Fin.cons ζ' y : Fin (n + 1) → ℂ)).continuousAt)
    · have hζT : ζ ∉ T := fun h => hζ (hTW ζ h y hy)
      refine continuousAt_const.congr (f := fun _ => (0 : ℂ)) ?_
      filter_upwards [hT.isClosed.isOpen_compl.mem_nhds hζT] with ζ' hζ'
      simp [g, hφ0 ζ' hζ']
  have hgi : ∀ y ∈ W, Integrable (g y) := fun y hy =>
    (hgc y hy).integrable_of_hasCompactSupport
      (HasCompactSupport.intro hT fun ζ hζ => by simp [g, hφ0 ζ hζ])
  -- the partition
  set M := |Cφ| * |Cf| * volume.real T
  have hM : 0 ≤ M := by positivity
  set η := min (d / 2) (ε * d ^ 2 / (2 * (M + 1)))
  have hη : 0 < η := lt_min (by positivity) (by positivity)
  obtain ⟨N, x, Q, hxT, hQm, hQb, hQd, hQc⟩ := exists_measurable_partition hT hTne hη
  refine ⟨N, x, fun i y => ∫ ζ, (Q i).indicator φ ζ * f (Fin.cons ζ y), W, hW, hKW,
    fun i => hTK _ (hxT i), fun i => differentiableOn_integral_mul_cons hU hf hT hW hTW
      (hφc.aestronglyMeasurable.indicator (hQm i)) (C := |Cφ|)
      (fun ζ => (norm_indicator_le_norm_self _ _).trans (hCφ' ζ))
      (fun ζ hζ => by simp [hφ0 ζ hζ]), fun z₀ hz₀ y hy => ?_⟩
  have hyW := hKW hy
  have hk : ∀ ζ ∈ T, ‖(ζ - z₀)⁻¹‖ ≤ 1 / d := fun ζ hζ => by
    rw [norm_inv, one_div]; exact inv_anti₀ hd (hdist ζ hζ z₀ hz₀)
  have hind : ∀ i, (fun ζ => (Q i).indicator φ ζ * f (Fin.cons ζ y)) = (Q i).indicator (g y) :=
    fun i => funext fun ζ => by
      by_cases h : ζ ∈ Q i <;> simp [g, h]
  have hint1 : Integrable fun ζ => g y ζ * (ζ - z₀)⁻¹ := by
    refine Integrable.mono' ((integrable_indicator_iff hT.measurableSet).mpr
      (integrableOn_const (C := |Cφ| * |Cf| * (1 / d)) hT.measure_lt_top.ne))
      ((hgc y hyW).aestronglyMeasurable.mul
        ((measurable_id.sub_const z₀).inv.aestronglyMeasurable)) (Eventually.of_forall
      fun ζ => ?_)
    by_cases hζ : ζ ∈ T
    · rw [indicator_of_mem hζ, norm_mul]
      have := hgb y hy ζ
      rw [indicator_of_mem hζ] at this
      exact mul_le_mul this (hk ζ hζ) (norm_nonneg _) (by positivity)
    · simp [g, hφ0 ζ hζ, indicator_of_notMem hζ]
  have hint2 : ∀ i, Integrable fun ζ => (Q i).indicator (g y) ζ * (x i - z₀)⁻¹ := fun i =>
    ((hgi y hyW).indicator (hQm i)).mul_const _
  have hsum : ∑ i ∈ Finset.range N, (∫ ζ, (Q i).indicator φ ζ * f (Fin.cons ζ y)) *
      (x i - z₀)⁻¹ = ∫ ζ, ∑ i ∈ Finset.range N, (Q i).indicator (g y) ζ * (x i - z₀)⁻¹ := by
    rw [integral_finset_sum _ fun i _ => hint2 i]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hind i, integral_mul_const]
  rw [hrep z₀ hz₀ y hy, hsum, ← integral_sub hint1 (integrable_finset_sum _ fun i _ => hint2 i)]
  have hpt : ∀ ζ, ‖g y ζ * (ζ - z₀)⁻¹ -
      ∑ i ∈ Finset.range N, (Q i).indicator (g y) ζ * (x i - z₀)⁻¹‖ ≤
      T.indicator (fun _ => |Cφ| * |Cf| * (η / d ^ 2)) ζ := by
    intro ζ
    by_cases hζ : ζ ∈ T
    · obtain ⟨i₀, hi₀, hζi₀⟩ := hQc ζ hζ
      rw [Finset.sum_eq_single_of_mem i₀ (Finset.mem_range.mpr hi₀) (fun i _ hi => by
        rw [indicator_of_notMem (fun h => (hQd hi).le_bot ⟨h, hζi₀⟩), zero_mul]),
        indicator_of_mem hζi₀, ← mul_sub, norm_mul, indicator_of_mem hζ]
      have hg := hgb y hy ζ
      rw [indicator_of_mem hζ] at hg
      refine mul_le_mul hg ?_ (norm_nonneg _) (by positivity)
      have h1 := hdist ζ hζ z₀ hz₀
      have h2 := hdist _ (hxT i₀) z₀ hz₀
      have h3 : ‖x i₀ - ζ‖ < η := by
        have := hQb i₀ hζi₀; rw [mem_ball, dist_eq_norm, ← norm_neg, neg_sub] at this; exact this
      have hne1 : ζ - z₀ ≠ 0 := fun h => by rw [h, norm_zero] at h1; linarith
      have hne2 : x i₀ - z₀ ≠ 0 := fun h => by rw [h, norm_zero] at h2; linarith
      rw [inv_sub_inv hne1 hne2, show x i₀ - z₀ - (ζ - z₀) = x i₀ - ζ by ring, norm_div,
        norm_mul, div_le_div_iff₀ (by positivity) (by positivity)]
      rw [sq]
      exact mul_le_mul h3.le (mul_le_mul h1 h2 hd.le (norm_nonneg _)) (by positivity) hη.le
    · have : ∀ i, (Q i).indicator (g y) ζ = 0 := fun i => by
        by_cases h : ζ ∈ Q i
        · simp [indicator_of_mem h, g, hφ0 ζ hζ]
        · exact indicator_of_notMem h _
      simp [this, g, hφ0 ζ hζ, indicator_of_notMem hζ]
  refine (norm_integral_le_of_norm_le ((integrable_indicator_iff hT.measurableSet).mpr
    (integrableOn_const hT.measure_lt_top.ne)) (Eventually.of_forall hpt)).trans_lt ?_
  rw [integral_indicator_const _ hT.measurableSet, smul_eq_mul]
  have hη' : η ≤ ε * d ^ 2 / (2 * (M + 1)) := min_le_right _ _
  calc volume.real T * (|Cφ| * |Cf| * (η / d ^ 2)) = M * η / d ^ 2 := by ring
    _ ≤ M * (ε * d ^ 2 / (2 * (M + 1))) / d ^ 2 := by gcongr
    _ = ε * (M / (2 * (M + 1))) := by field_simp
    _ < ε * 1 := by
        gcongr
        rw [div_lt_one (by positivity)]; linarith
    _ = ε := mul_one ε

/-- Runge approximation on a product of compact sets, given the approximation of every Cauchy
kernel in each factor by Laurent polynomials with exponents in a prescribed set. -/
private theorem runge_core :
    ∀ (n : ℕ) (K : Fin n → Set ℂ) (Adm : Fin n → ℤ → Prop) (c : Fin n → ℂ),
      (∀ j, IsCompact (K j)) →
      (∀ j, ∀ ζ ∉ K j, ∀ δ > 0, ∃ (s : Finset ℤ) (a : ℤ → ℂ), (∀ k ∈ s, Adm j k) ∧
        ∀ z ∈ K j, ‖(ζ - z)⁻¹ - ∑ k ∈ s, a k * (z - c j) ^ k‖ < δ) →
      ∀ (U : Set (Fin n → ℂ)) (f : (Fin n → ℂ) → ℂ),
        IsOpen U → univ.pi K ⊆ U → DifferentiableOn ℂ f U →
        ∀ ε : ℝ, 0 < ε → ∃ (s : Finset (Fin n → ℤ)) (a : (Fin n → ℤ) → ℂ),
          (∀ β ∈ s, ∀ j, Adm j (β j)) ∧
          ∀ z ∈ univ.pi K, ‖f z - ∑ β ∈ s, a β * ∏ j, (z j - c j) ^ β j‖ < ε := by
  intro n
  induction n with
  | zero =>
    intro K Adm c _ _ U f _ _ _ ε hε
    refine ⟨{0}, fun _ => f 0, fun _ _ j => j.elim0, fun z _ => ?_⟩
    rw [Subsingleton.elim z 0]
    simpa using hε
  | succ n ih =>
    intro K Adm c hK hker U f hU hKU hf ε hε
    classical
    set Kp : Set (Fin n → ℂ) := univ.pi fun j => K j.succ
    have hKp : IsCompact Kp := isCompact_univ_pi fun j => hK j.succ
    have hcons : ∀ z₀ ∈ K 0, ∀ y ∈ Kp, (Fin.cons z₀ y : Fin (n + 1) → ℂ) ∈ U :=
      fun z₀ hz₀ y hy => hKU (by
        rw [mem_univ_pi]
        refine Fin.cases ?_ (fun j => ?_)
        · simpa using hz₀
        · simpa using hy j (mem_univ _))
    obtain ⟨N, x, h, W, hW, hKW, hx, hh, happ⟩ :=
      exists_sum_inv_sub_approx n (K 0) Kp (hK 0) hKp U f hU hcons hf (ε / 2) (by positivity)
    have hH : ∀ i, ∃ H : ℝ, ∀ y ∈ Kp, ‖h i y‖ ≤ H := fun i =>
      hKp.exists_bound_of_continuousOn ((hh i).continuousOn.mono hKW)
    choose H hH using hH
    have hB : ∀ i, ∃ B : ℝ, ∀ z ∈ K 0, ‖(x i - z)⁻¹‖ ≤ B := fun i =>
      (hK 0).exists_bound_of_continuousOn (ContinuousOn.inv₀ (continuousOn_const.sub
        continuousOn_id) fun z hz => sub_ne_zero.mpr fun h' => hx i (h' ▸ hz))
    choose B hB using hB
    have hpair := fun i => exists_mul_approx (hH i) (hB i)
      (PL := fun L => ∃ (s : Finset ℤ) (a : ℤ → ℂ), (∀ k ∈ s, Adm 0 k) ∧
        L = fun z₀ => ∑ k ∈ s, a k * (z₀ - c 0) ^ k)
      (PR := fun R => ∃ (s : Finset (Fin n → ℤ)) (a : (Fin n → ℤ) → ℂ),
        (∀ β ∈ s, ∀ j, Adm j.succ (β j)) ∧
        R = fun y => ∑ β ∈ s, a β * ∏ j, (y j - c j.succ) ^ β j)
      (fun δ hδ => by
        obtain ⟨s, a, hs, hsa⟩ := hker 0 (x i) (hx i) δ hδ
        exact ⟨_, ⟨s, a, hs, rfl⟩, hsa⟩)
      (fun δ hδ => by
        obtain ⟨s, a, hs, hsa⟩ := ih (fun j => K j.succ) (fun j => Adm j.succ)
          (fun j => c j.succ) (fun j => hK j.succ) (fun j => hker j.succ) W (h i) hW hKW (hh i)
          δ hδ
        exact ⟨_, ⟨s, a, hs, rfl⟩, hsa⟩)
      (ε / (2 * (N + 1))) (by positivity)
    choose L R hPL hPR hLR using hpair
    -- the approximant is a Laurent polynomial
    have hpoly : ∀ M : ℕ, ∃ (s : Finset (Fin (n + 1) → ℤ)) (a : (Fin (n + 1) → ℤ) → ℂ),
        (∀ β ∈ s, ∀ j, Adm j (β j)) ∧ ∀ z : Fin (n + 1) → ℂ,
          ∑ i ∈ Finset.range M, R i (Fin.tail z) * L i (z 0) =
            ∑ β ∈ s, a β * ∏ j, (z j - c j) ^ β j := by
      intro M
      induction M with
      | zero => exact ⟨∅, 0, by simp, fun z => by simp⟩
      | succ M ihM =>
        obtain ⟨s, a, hs, hsa⟩ := ihM
        obtain ⟨sL, aL, hsL, hLM⟩ := hPL M
        obtain ⟨sR, aR, hsR, hRM⟩ := hPR M
        obtain ⟨t, b, ht, htb⟩ := exists_sum_eq_mul_cons Adm c sL aL hsL sR aR hsR
        refine ⟨s ∪ t, fun β => (if β ∈ s then a β else 0) + (if β ∈ t then b β else 0),
          fun β hβ => ?_, fun z => ?_⟩
        · rcases Finset.mem_union.mp hβ with h' | h'
          · exact hs β h'
          · exact ht β h'
        · rw [Finset.sum_range_succ, hsa z]
          simp only [hLM, hRM]
          rw [htb z]
          simp only [add_mul, Finset.sum_add_distrib, ite_mul, zero_mul]
          rw [Finset.sum_ite_mem, Finset.sum_ite_mem, Finset.union_inter_cancel_left,
            Finset.union_inter_cancel_right]
    obtain ⟨s, a, hs, hsa⟩ := hpoly N
    refine ⟨s, a, hs, fun z hz => ?_⟩
    rw [mem_univ_pi] at hz
    have hz0 : z 0 ∈ K 0 := hz 0
    have hzt : Fin.tail z ∈ Kp := by
      rw [mem_univ_pi]; exact fun j => hz j.succ
    rw [← hsa z]
    have h1 := happ (z 0) hz0 (Fin.tail z) hzt
    rw [Fin.cons_self_tail] at h1
    have h2 : ‖∑ i ∈ Finset.range N, h i (Fin.tail z) * (x i - z 0)⁻¹ -
        ∑ i ∈ Finset.range N, R i (Fin.tail z) * L i (z 0)‖ ≤ N * (ε / (2 * (N + 1))) := by
      rw [← Finset.sum_sub_distrib]
      refine (norm_sum_le _ _).trans ?_
      refine (Finset.sum_le_sum fun i _ => (hLR i (z 0) hz0 (Fin.tail z) hzt).le).trans ?_
      simp
    have h3 : (N : ℝ) * (ε / (2 * (N + 1))) < ε / 2 := by
      rw [mul_div_assoc', div_lt_div_iff₀ (by positivity) (by norm_num)]
      nlinarith
    calc ‖f z - ∑ i ∈ Finset.range N, R i (Fin.tail z) * L i (z 0)‖
        ≤ ‖f z - ∑ i ∈ Finset.range N, h i (Fin.tail z) * (x i - z 0)⁻¹‖ +
          ‖∑ i ∈ Finset.range N, h i (Fin.tail z) * (x i - z 0)⁻¹ -
            ∑ i ∈ Finset.range N, R i (Fin.tail z) * L i (z 0)‖ :=
          norm_sub_le_norm_sub_add_norm_sub _ _ _
      _ < ε / 2 + ε / 2 := add_lt_add_of_lt_of_le h1 (h2.trans h3.le)
      _ = ε := by ring

/-- Runge approximation on a product of rectangles, discs and annuli. -/
private theorem runge :
    ∀ (n : ℕ) (K : Fin n → Set ℂ) (A : Set (Fin n)) (c : Fin n → ℂ),
      (∀ j ∈ A, ∃ r R : ℝ, 0 < r ∧ r < R ∧ K j = closedBall (c j) R \ ball (c j) r) →
      (∀ j ∉ A, (∃ a b a' b' : ℝ, a < b ∧ a' < b' ∧
          K j = Complex.re ⁻¹' Icc a b ∩ Complex.im ⁻¹' Icc a' b') ∨
        (∃ (w : ℂ) (r : ℝ), 0 < r ∧ K j = closedBall w r)) →
      ∀ (U : Set (Fin n → ℂ)) (f : (Fin n → ℂ) → ℂ),
        IsOpen U → univ.pi K ⊆ U → DifferentiableOn ℂ f U →
        ∀ ε : ℝ, 0 < ε → ∃ (s : Finset (Fin n → ℤ)) (a : (Fin n → ℤ) → ℂ),
          (∀ β ∈ s, ∀ j ∉ A, 0 ≤ β j) ∧
          ∀ z ∈ univ.pi K, ‖f z - ∑ β ∈ s, a β * ∏ j, (z j - c j) ^ β j‖ < ε := by
  intro n K A c hA hnA U f hU hKU hf ε hε
  have hcpt : ∀ j, IsCompact (K j) := fun j => by
    by_cases hj : j ∈ A
    · obtain ⟨r, R, -, -, hK⟩ := hA j hj
      rw [hK]; exact (isCompact_closedBall _ _).diff isOpen_ball
    · rcases hnA j hj with ⟨a, b, a', b', -, -, hK⟩ | ⟨w, r, -, hK⟩
      · rw [hK]; exact isCompact_Icc.reProdIm isCompact_Icc
      · rw [hK]; exact isCompact_closedBall _ _
  have hker : ∀ j, ∀ ζ ∉ K j, ∀ δ > 0, ∃ (s : Finset ℤ) (a : ℤ → ℂ),
      (∀ k ∈ s, j ∉ A → 0 ≤ k) ∧
      ∀ z ∈ K j, ‖(ζ - z)⁻¹ - ∑ k ∈ s, a k * (z - c j) ^ k‖ < δ := by
    intro j ζ hζ δ hδ
    by_cases hj : j ∈ A
    · obtain ⟨r, R, hr, -, hK⟩ := hA j hj
      rw [hK] at hζ ⊢
      obtain ⟨s, a, h⟩ := kernel_approx_annulus hr hζ δ hδ
      exact ⟨s, a, fun k _ hj' => absurd hj hj', h⟩
    · have hconv : Convex ℝ (K j) ∧ (K j).Nonempty := by
        rcases hnA j hj with ⟨a, b, a', b', hab, hab', hK⟩ | ⟨w, r, hr, hK⟩
        · rw [hK]
          refine ⟨((convex_Icc a b).linear_preimage Complex.reLm).inter
            ((convex_Icc a' b').linear_preimage Complex.imLm), (a : ℂ) + a' * Complex.I, ?_, ?_⟩
          · simp [hab.le]
          · simp [hab'.le]
        · rw [hK]; exact ⟨convex_closedBall _ _, w, mem_closedBall_self hr.le⟩
      obtain ⟨m, hm⟩ := hconv.2
      obtain ⟨s, a, hs, h⟩ := kernel_of_pa (c j)
        (pa_inv_sub_of_convex (hcpt j) hconv.1 hm hζ) δ hδ
      exact ⟨s, a, fun k hk _ => hs k hk, h⟩
  exact runge_core n K (fun j k => j ∉ A → 0 ≤ k) c hcpt hker U f hU hKU hf ε hε

/-- Locally uniform Lipschitz bound for a locally bounded family of holomorphic functions,
from the Cauchy estimates. -/
private theorem exists_lipschitz_ball (n : ℕ) (Ω : Set (Fin n → ℂ)) (f : ℕ → (Fin n → ℂ) → ℂ)
    (hΩ : IsOpen Ω) (hf : ∀ k, DifferentiableOn ℂ (f k) Ω)
    (hb : ∀ Q ⊆ Ω, IsCompact Q → ∃ M : ℝ, ∀ k, ∀ z ∈ Q, ‖f k z‖ ≤ M) (x : Fin n → ℂ)
    (hx : x ∈ Ω) : ∃ r > 0, ∃ C : ℝ, ∀ k, ∀ y ∈ ball x r, ∀ y' ∈ ball x r,
      ‖f k y - f k y'‖ ≤ C * ‖y - y'‖ := by
  obtain ⟨ρ, hρ, hρΩ⟩ := Metric.isOpen_iff.mp hΩ x hx
  have hρ' : closedBall x (ρ / 2) ⊆ Ω := (closedBall_subset_ball (by linarith)).trans hρΩ
  obtain ⟨M, hM⟩ := hb _ hρ' (isCompact_closedBall _ _)
  have hcb : ∀ r : ℝ, 0 < r → closedBall x r = univ.pi (fun j => closedBall (x j) r) :=
    fun r hr => closedBall_pi x hr.le
  refine ⟨ρ / 4, by positivity, n * (2 ^ (n + 1) * M / ⨅ _i : Fin n, ρ / 2), ?_⟩
  intro k
  have hest := ((MMP.SeveralComplex.cauchy_osgood_laurent.{0, 0} ℂ).2.2.2.1 n x (fun _ => ρ / 2) M Ω
    (f k) (fun _ => by positivity) hΩ (by rw [← hcb _ (by positivity)]; exact hρ') (hf k)
    (fun z hz => hM k z (by rw [hcb _ (by positivity)]; exact hz))).2
  have hsub : ball x (ρ / 4) ⊆ Ω :=
    ball_subset_closedBall.trans ((closedBall_subset_closedBall (by linarith)).trans hρ')
  have hD : ∀ z ∈ ball x (ρ / 4), ‖fderiv ℂ (f k) z‖ ≤
      n * (2 ^ (n + 1) * M / ⨅ _i : Fin n, ρ / 2) := by
    intro z hz
    have hz' : z ∈ univ.pi (fun j => closedBall (x j) (ρ / 2 / 2)) := by
      rw [← hcb _ (by positivity)]
      exact ball_subset_closedBall (ball_subset_ball (by linarith) hz)
    have hj := hest z hz'
    have hC : 0 ≤ 2 ^ (n + 1) * M / ⨅ _i : Fin n, ρ / 2 := by
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · simp
      · haveI : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
        exact (norm_nonneg _).trans (hj ⟨0, hn⟩)
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun v => ?_
    have hv : v = ∑ j, v j • Pi.single j (1 : ℂ) := by
      ext i; simp [Finset.sum_apply, Pi.single_apply]
    rw [hv, map_sum]
    refine (norm_sum_le _ _).trans ?_
    calc ∑ j, ‖fderiv ℂ (f k) z (v j • Pi.single j 1)‖
        ≤ ∑ _j : Fin n, (2 ^ (n + 1) * M / ⨅ _i : Fin n, ρ / 2) * ‖v‖ := by
          refine Finset.sum_le_sum fun j _ => ?_
          rw [map_smul, norm_smul, mul_comm]
          exact mul_le_mul (hj j) (norm_le_pi_norm v j) (norm_nonneg _) hC
      _ = _ := by
          rw [← hv]; simp [Finset.sum_const, Finset.card_univ]; ring
  intro y hy y' hy'
  exact (convex_ball x (ρ / 4)).norm_image_sub_le_of_norm_fderiv_le
    (fun z hz => ((hf k).differentiableAt (hΩ.mem_nhds (hsub hz)))) hD hy' hy

/-- Montel's theorem on an open subset of `ℂⁿ`. -/
private theorem montel :
    ∀ (n : ℕ) (Ω : Set (Fin n → ℂ)) (f : ℕ → (Fin n → ℂ) → ℂ),
      IsOpen Ω → (∀ k, DifferentiableOn ℂ (f k) Ω) →
      (∀ Q ⊆ Ω, IsCompact Q → ∃ M : ℝ, ∀ k, ∀ z ∈ Q, ‖f k z‖ ≤ M) →
      ∃ (φ : ℕ → ℕ) (h : (Fin n → ℂ) → ℂ), StrictMono φ ∧ DifferentiableOn ℂ h Ω ∧
        ∀ Q ⊆ Ω, IsCompact Q → TendstoUniformlyOn (fun k => f (φ k)) h atTop Q := by
  classical
  intro n Ω f hΩ hf hb
  haveI : LocallyCompactSpace Ω := hΩ.locallyCompactSpace
  have hL : ∀ x : Ω, ∃ r > 0, ∃ C : ℝ, ∀ k, ∀ y ∈ ball x.1 r, ∀ y' ∈ ball x.1 r,
      ‖f k y - f k y'‖ ≤ C * ‖y - y'‖ :=
    fun x => exists_lipschitz_ball n Ω f hΩ hf hb x.1 x.2
  choose r hr C hC using hL
  have hB : ∀ x : Ω, ∃ M : ℝ, ∀ k, ‖f k x‖ ≤ M := fun x => by
    obtain ⟨M, hM⟩ := hb {x.1} (by simpa using x.2) isCompact_singleton
    exact ⟨M, fun k => hM k x.1 rfl⟩
  choose B hB using hB
  let T : Set (Ω → ℂ) := {g | (∀ x, ‖g x‖ ≤ B x) ∧
    ∀ x y : Ω, y.1 ∈ ball x.1 (r x) → ‖g y - g x‖ ≤ C x * ‖y.1 - x.1‖}
  let S : Set C(Ω, ℂ) := {G | ⇑G ∈ T}
  let G : ℕ → C(Ω, ℂ) := fun k => ⟨Ω.restrict (f k), (hf k).continuousOn.restrict⟩
  have hGS : ∀ k, G k ∈ S := fun k =>
    ⟨fun x => hB x k, fun x y hy => hC x k y.1 hy x.1 (mem_ball_self (hr x))⟩
  have hTc : ∀ g ∈ T, Continuous g := by
    intro g hg
    refine continuous_iff_continuousAt.mpr fun x => ?_
    rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) ?_
      (?_ : Tendsto (fun y : Ω => C x * ‖y.1 - x.1‖) (𝓝 x) (𝓝 0))
    · have : {y : Ω | y.1 ∈ ball x.1 (r x)} ∈ 𝓝 x :=
        (isOpen_ball.preimage continuous_subtype_val).mem_nhds (mem_ball_self (hr x))
      filter_upwards [this] with y hy using hg.2 x y hy
    · have : Tendsto (fun y : Ω => ‖y.1 - x.1‖) (𝓝 x) (𝓝 0) := by
        have h1 := (((continuous_subtype_val (p := (· ∈ Ω))).sub
          (continuous_const (y := x.1))).norm.tendsto x)
        simpa using h1
      simpa using this.const_mul (C x)
  have himg : ContinuousMap.toFun '' S = T := by
    ext g
    refine ⟨?_, fun hg => ⟨⟨g, hTc g hg⟩, hg, rfl⟩⟩
    rintro ⟨G', hG', rfl⟩
    exact hG'
  have hTcl : IsClosed T := by
    simp only [T, setOf_and, setOf_forall]
    refine IsClosed.inter (isClosed_iInter fun x => isClosed_le (by fun_prop) continuous_const)
      (isClosed_iInter fun x => isClosed_iInter fun y => isClosed_iInter fun _ =>
        isClosed_le (by fun_prop) continuous_const)
  have hTk : IsCompact T := by
    refine (isCompact_univ_pi fun x => isCompact_closedBall (0 : ℂ) (B x)).of_isClosed_subset
      hTcl fun g hg x _ => ?_
    simpa using hg.1 x
  have heq : Equicontinuous ((↑) : S → Ω → ℂ) := by
    intro x
    rw [Metric.equicontinuousAt_iff_right]
    intro ε hε
    have hpos : 0 < |C x| + 1 := by positivity
    have : {y : Ω | dist y.1 x.1 < min (r x) (ε / (|C x| + 1))} ∈ 𝓝 x :=
      (isOpen_ball.preimage continuous_subtype_val).mem_nhds
        (mem_ball_self (lt_min (hr x) (by positivity)))
    filter_upwards [this] with y hy
    rintro ⟨G', hG'⟩
    have hy1 : y.1 ∈ ball x.1 (r x) := lt_of_lt_of_le hy (min_le_left _ _)
    have hy2 : dist y.1 x.1 < ε / (|C x| + 1) := lt_of_lt_of_le hy (min_le_right _ _)
    rw [dist_comm, dist_eq_norm]
    calc ‖G' y - G' x‖ ≤ C x * ‖y.1 - x.1‖ := hG'.2 x y hy1
      _ ≤ (|C x| + 1) * dist y.1 x.1 := by
          rw [dist_eq_norm]
          exact mul_le_mul_of_nonneg_right (by linarith [le_abs_self (C x)]) (norm_nonneg _)
      _ < (|C x| + 1) * (ε / (|C x| + 1)) := mul_lt_mul_of_pos_left hy2 hpos
      _ = ε := by field_simp
  have hSk : IsCompact S := ArzelaAscoli.isCompact_of_equicontinuous S (himg ▸ hTk) heq
  obtain ⟨g, -, φ, hφ, hlim⟩ := hSk.tendsto_subseq hGS
  let h : (Fin n → ℂ) → ℂ := fun z => if hz : z ∈ Ω then g ⟨z, hz⟩ else 0
  have hunif : ∀ Q ⊆ Ω, IsCompact Q → TendstoUniformlyOn (fun k => f (φ k)) h atTop Q := by
    intro Q hQ hQc
    have hQ' : IsCompact (Subtype.val ⁻¹' Q : Set Ω) := by
      rw [Subtype.isCompact_iff, Subtype.image_preimage_coe, inter_eq_right.mpr hQ]
      exact hQc
    have := ContinuousMap.tendsto_iff_forall_isCompact_tendstoUniformlyOn.mp hlim _ hQ'
    rw [Metric.tendstoUniformlyOn_iff] at this ⊢
    intro ε hε
    filter_upwards [this ε hε] with k hk z hz
    have := hk ⟨z, hQ hz⟩ hz
    simpa [h, hQ hz, G, Set.restrict] using this
  refine ⟨φ, h, hφ, ?_, hunif⟩
  exact (MMP.SeveralComplex.cauchy_osgood_laurent.{0, 0} ℂ).2.2.2.2.2 n atTop Ω
    (fun k => f (φ k)) h hΩ (Eventually.of_forall fun k => hf (φ k))
    ((tendstoLocallyUniformlyOn_iff_forall_isCompact hΩ).mpr hunif)

end MMP.Gaga.Internal.GagaOneVariableTools

namespace MMP.Gaga

open MMP.Gaga.Internal.GagaOneVariableTools in
/-- The three one-variable tools: smoothness and the `∂̄`-equation for the Cauchy transform
with holomorphic dependence on parameters, Runge approximation on products of rectangles,
discs and annuli, and Montel's theorem on open subsets of `ℂⁿ`. -/
@[mmp "lem_mmp_gaga_one_variable_tools"]
public theorem cauchyTransform_runge_montel :
    -- (1) the Cauchy transform
    (∀ (m : ℕ) (P : Set (Fin m → ℂ)) (L : Set ℂ) (g : ℂ × (Fin m → ℂ) → ℂ),
      IsOpen P → IsCompact L → ContDiffOn ℝ ∞ g (univ ×ˢ P) →
      (∀ ζ ∉ L, ∀ y ∈ P, g (ζ, y) = 0) →
      let u : ℂ × (Fin m → ℂ) → ℂ :=
        fun p => -(1 / (Real.pi : ℂ)) * ∫ ζ : ℂ, g (ζ, p.2) / (ζ - p.1)
      ContDiffOn ℝ ∞ u (univ ×ˢ P) ∧
      (∀ z : ℂ, ∀ y ∈ P,
        (1 / 2 : ℂ) * (fderiv ℝ (fun w : ℂ => u (w, y)) z 1 +
          Complex.I * fderiv ℝ (fun w : ℂ => u (w, y)) z Complex.I) = g (z, y)) ∧
      (∀ j : Fin m,
        (∀ ζ : ℂ, ∀ y ∈ P, DifferentiableAt ℂ (fun t : ℂ => g (ζ, Function.update y j t)) (y j)) →
        ∀ z : ℂ, ∀ y ∈ P, DifferentiableAt ℂ (fun t : ℂ => u (z, Function.update y j t)) (y j))) ∧
    -- (2) Runge approximation on products of standard compacts
    (∀ (n : ℕ) (K : Fin n → Set ℂ) (A : Set (Fin n)) (c : Fin n → ℂ),
      (∀ j ∈ A, ∃ r R : ℝ, 0 < r ∧ r < R ∧ K j = closedBall (c j) R \ ball (c j) r) →
      (∀ j ∉ A, (∃ a b a' b' : ℝ, a < b ∧ a' < b' ∧
          K j = Complex.re ⁻¹' Icc a b ∩ Complex.im ⁻¹' Icc a' b') ∨
        (∃ (w : ℂ) (r : ℝ), 0 < r ∧ K j = closedBall w r)) →
      ∀ (U : Set (Fin n → ℂ)) (f : (Fin n → ℂ) → ℂ),
        IsOpen U → univ.pi K ⊆ U → DifferentiableOn ℂ f U →
        ∀ ε : ℝ, 0 < ε → ∃ (s : Finset (Fin n → ℤ)) (a : (Fin n → ℤ) → ℂ),
          (∀ β ∈ s, ∀ j ∉ A, 0 ≤ β j) ∧
          ∀ z ∈ univ.pi K, ‖f z - ∑ β ∈ s, a β * ∏ j, (z j - c j) ^ β j‖ < ε) ∧
    -- (3) Montel's theorem
    (∀ (n : ℕ) (Ω : Set (Fin n → ℂ)) (f : ℕ → (Fin n → ℂ) → ℂ),
      IsOpen Ω → (∀ k, DifferentiableOn ℂ (f k) Ω) →
      (∀ Q ⊆ Ω, IsCompact Q → ∃ M : ℝ, ∀ k, ∀ z ∈ Q, ‖f k z‖ ≤ M) →
      ∃ (φ : ℕ → ℕ) (h : (Fin n → ℂ) → ℂ), StrictMono φ ∧ DifferentiableOn ℂ h Ω ∧
        ∀ Q ⊆ Ω, IsCompact Q → TendstoUniformlyOn (fun k => f (φ k)) h atTop Q) :=
  ⟨fun m P L g hP hL hg hg0 =>
      ⟨cauchyTransform_contDiffOn m P L g hP hL hg hg0,
        cauchyTransform_dbar m P L g hP hL hg hg0,
        cauchyTransform_differentiableAt m P L g hP hL hg hg0⟩,
    runge, montel⟩

end MMP.Gaga

